@const RPC_EMIT_RPC_KEY_JSONRPC = utf8:"jsonrpc"
@const RPC_EMIT_RPC_VALUE_2_0 = utf8:"2.0"
@const RPC_EMIT_RPC_KEY_ID = utf8:"id"
@const RPC_EMIT_RPC_KEY_RESULT = utf8:"result"
@const RPC_EMIT_RPC_KEY_ERROR = utf8:"error"
@const RPC_EMIT_JSON_KEY_ERROR = utf8:"error"
