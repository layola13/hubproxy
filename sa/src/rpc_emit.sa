@const RPC_EMIT_JSON_KEY_ALLOWED_APPROVALS_REVIEWERS = utf8:"allowedApprovalsReviewers"
@const RPC_EMIT_JSON_KEY_ALLOWED_SANDBOX_MODES = utf8:"allowedSandboxModes"
@const RPC_EMIT_JSON_KEY_ALLOWED_WEB_SEARCH_MODES = utf8:"allowedWebSearchModes"
@const RPC_EMIT_JSON_KEY_ALLOW_MANAGED_HOOKS_ONLY = utf8:"allowManagedHooksOnly"
@const RPC_EMIT_JSON_KEY_FEATURE_REQUIREMENTS = utf8:"featureRequirements"
@const RPC_EMIT_JSON_KEY_ENFORCE_RESIDENCY = utf8:"enforceResidency"
@const RPC_EMIT_JSON_KEY_NETWORK = utf8:"network"
@const RPC_EMIT_JSON_KEY_FEATURED_PLUGIN_IDS = utf8:"featuredPluginIds"
@const RPC_EMIT_JSON_KEY_MARKETPLACE_LOAD_ERRORS = utf8:"marketplaceLoadErrors"
@const RPC_EMIT_JSON_KEY_MARKETPLACES = utf8:"marketplaces"
@const RPC_EMIT_JSON_KEY_APPS_NEEDING_AUTH = utf8:"appsNeedingAuth"
@const RPC_EMIT_JSON_KEY_AUTH_POLICY = utf8:"authPolicy"
@const RPC_EMIT_JSON_KEY_STAGE = utf8:"stage"
@const RPC_EMIT_JSON_KEY_DISPLAY_NAME = utf8:"displayName"
@const RPC_EMIT_JSON_KEY_ANNOUNCEMENT = utf8:"announcement"
@const RPC_EMIT_JSON_KEY_ENABLED = utf8:"enabled"
@const RPC_EMIT_JSON_KEY_DEFAULT_ENABLED = utf8:"defaultEnabled"
@const RPC_EMIT_JSON_KEY_CANCELED = utf8:"canceled"
@const RPC_EMIT_JSON_KEY_LOGGED_OUT = utf8:"loggedOut"
@const RPC_EMIT_JSON_KEY_DECISION = utf8:"decision"
@const RPC_EMIT_JSON_KEY_ACTION = utf8:"action"
@const RPC_EMIT_JSON_KEY_PERMISSIONS = utf8:"permissions"
@const RPC_EMIT_JSON_KEY_SCOPE = utf8:"scope"
@const RPC_EMIT_JSON_KEY_STRICT_AUTO_REVIEW = utf8:"strictAutoReview"
@const RPC_EMIT_JSON_KEY_ANSWERS = utf8:"answers"
@const RPC_EMIT_JSON_KEY_VOICES = utf8:"voices"
@const RPC_EMIT_JSON_VALUE_HTTP_400 = utf8:"http_400"
@const RPC_EMIT_JSON_VALUE_EMPTY_BODY_MESSAGE = utf8:"Request body must be a non-empty JSON document."
@const RPC_EMIT_JSON_VALUE_BAD_REQUEST = utf8:"bad_request"
@const RPC_EMIT_JSON_VALUE_NOT_AVAILABLE = utf8:"NOT_AVAILABLE"
@const RPC_EMIT_JSON_VALUE_STABLE = utf8:"stable"
@const RPC_EMIT_JSON_VALUE_REASONING_TITLE = utf8:"Reasoning"
@const RPC_EMIT_JSON_VALUE_REASONING_DESCRIPTION = utf8:"Reasoning item formatting."
@const RPC_EMIT_JSON_VALUE_ACCEPT = utf8:"accept"
@const RPC_EMIT_JSON_VALUE_TURN = utf8:"turn"
@const RPC_EMIT_JSON_VALUE_DEFAULT = utf8:"default"
@const RPC_EMIT_JSON_VALUE_CONTINUE_LOWER = utf8:"continue"
@const RPC_EMIT_JSON_VALUE_ALLOY = utf8:"alloy"
@const RPC_EMIT_JSON_VALUE_ALLOY_NAME = utf8:"Alloy"
@const RPC_EMIT_JSON_VALUE_ECHO = utf8:"echo"
@const RPC_EMIT_JSON_VALUE_ECHO_NAME = utf8:"Echo"
@const RPC_EMIT_JSON_VALUE_FABLE = utf8:"fable"
@const RPC_EMIT_JSON_VALUE_FABLE_NAME = utf8:"Fable"
@const RPC_EMIT_JSON_VALUE_ONYX = utf8:"onyx"
@const RPC_EMIT_JSON_VALUE_ONYX_NAME = utf8:"Onyx"
@const RPC_EMIT_JSON_VALUE_NOVA = utf8:"nova"
@const RPC_EMIT_JSON_VALUE_NOVA_NAME = utf8:"Nova"
@const RPC_EMIT_JSON_VALUE_SHIMMER = utf8:"shimmer"
@const RPC_EMIT_JSON_VALUE_SHIMMER_NAME = utf8:"Shimmer"
@const RPC_EMIT_FB_KEY_TYPE = utf8:"type"
@const RPC_EMIT_CHAT_DROP_REASONING = utf8:"reasoning"
@const RPC_EMIT_ERR_NOT_FOUND = utf8:"method not found"
@const RPC_EMIT_ERR_MCP_RESOURCE_LIST_UNSUPPORTED = utf8:"unsupported method: mcpServer/resource/list"
@const RPC_EMIT_ERR_MCP_RESOURCE_TEMPLATES_UNSUPPORTED = utf8:"unsupported method: mcpServer/resource/templates"

#def RPC_EMIT_MIME_JSON_LEN = 16
#def RPC_EMIT_RPC_KEY_JSONRPC_LEN = 7
#def RPC_EMIT_RPC_VALUE_2_0_LEN = 3
#def RPC_EMIT_RPC_KEY_ID_LEN = 2
#def RPC_EMIT_RPC_KEY_RESULT_LEN = 6
#def RPC_EMIT_RPC_KEY_ERROR_LEN = 5
#def RPC_EMIT_JSON_KEY_ERROR_LEN = 5
#def RPC_EMIT_JSON_KEY_NAME_LEN = 4
#def RPC_EMIT_JSON_KEY_CODE_LEN = 4
#def RPC_EMIT_JSON_KEY_MESSAGE_LEN = 7
#def RPC_EMIT_JSON_KEY_DATA_LEN = 4
#def RPC_EMIT_JSON_KEY_NEXT_CURSOR_LEN = 10
#def RPC_EMIT_JSON_KEY_CONTENTS_LEN = 8
#def RPC_EMIT_JSON_KEY_CONTENT_LEN = 7
#def RPC_EMIT_JSON_KEY_META_LEN = 4
#def RPC_EMIT_JSON_KEY_DESCRIPTION_LEN = 11
#def RPC_EMIT_JSON_KEY_HOOKS_LEN = 5
#def RPC_EMIT_JSON_KEY_REQUIREMENTS_LEN = 12
#def RPC_EMIT_JSON_KEY_ALLOWED_APPROVAL_POLICIES_LEN = 23
#def RPC_EMIT_JSON_KEY_ALLOWED_APPROVALS_REVIEWERS_LEN = 25
#def RPC_EMIT_JSON_KEY_ALLOWED_SANDBOX_MODES_LEN = 19
#def RPC_EMIT_JSON_KEY_ALLOWED_WEB_SEARCH_MODES_LEN = 21
#def RPC_EMIT_JSON_KEY_ALLOW_MANAGED_HOOKS_ONLY_LEN = 21
#def RPC_EMIT_JSON_KEY_FEATURE_REQUIREMENTS_LEN = 19
#def RPC_EMIT_JSON_KEY_ENFORCE_RESIDENCY_LEN = 16
#def RPC_EMIT_JSON_KEY_NETWORK_LEN = 7
#def RPC_EMIT_JSON_KEY_FEATURED_PLUGIN_IDS_LEN = 17
#def RPC_EMIT_JSON_KEY_MARKETPLACE_LOAD_ERRORS_LEN = 21
#def RPC_EMIT_JSON_KEY_MARKETPLACES_LEN = 12
#def RPC_EMIT_JSON_KEY_APPS_NEEDING_AUTH_LEN = 15
#def RPC_EMIT_JSON_KEY_AUTH_POLICY_LEN = 10
#def RPC_EMIT_JSON_KEY_STAGE_LEN = 5
#def RPC_EMIT_JSON_KEY_DISPLAY_NAME_LEN = 11
#def RPC_EMIT_JSON_KEY_ANNOUNCEMENT_LEN = 12
#def RPC_EMIT_JSON_KEY_ENABLED_LEN = 7
#def RPC_EMIT_JSON_KEY_DEFAULT_ENABLED_LEN = 14
#def RPC_EMIT_JSON_KEY_CANCELED_LEN = 8
#def RPC_EMIT_JSON_KEY_LOGGED_OUT_LEN = 9
#def RPC_EMIT_JSON_KEY_DECISION_LEN = 8
#def RPC_EMIT_JSON_KEY_ACTION_LEN = 6
#def RPC_EMIT_JSON_KEY_PERMISSIONS_LEN = 11
#def RPC_EMIT_JSON_KEY_SCOPE_LEN = 5
#def RPC_EMIT_JSON_KEY_STRICT_AUTO_REVIEW_LEN = 16
#def RPC_EMIT_JSON_KEY_ANSWERS_LEN = 7
#def RPC_EMIT_JSON_KEY_VOICES_LEN = 6
#def RPC_EMIT_JSON_VALUE_HTTP_400_LEN = 8
#def RPC_EMIT_JSON_VALUE_EMPTY_BODY_MESSAGE_LEN = 47
#def RPC_EMIT_JSON_VALUE_BAD_REQUEST_LEN = 11
#def RPC_EMIT_JSON_VALUE_NOT_AVAILABLE_LEN = 13
#def RPC_EMIT_JSON_VALUE_STABLE_LEN = 6
#def RPC_EMIT_JSON_VALUE_REASONING_TITLE_LEN = 9
#def RPC_EMIT_JSON_VALUE_REASONING_DESCRIPTION_LEN = 26
#def RPC_EMIT_JSON_VALUE_ACCEPT_LEN = 6
#def RPC_EMIT_JSON_VALUE_TURN_LEN = 4
#def RPC_EMIT_JSON_VALUE_DEFAULT_LEN = 7
#def RPC_EMIT_JSON_VALUE_CONTINUE_LOWER_LEN = 8
#def RPC_EMIT_JSON_VALUE_ALLOY_LEN = 5
#def RPC_EMIT_JSON_VALUE_ALLOY_NAME_LEN = 5
#def RPC_EMIT_JSON_VALUE_ECHO_LEN = 4
#def RPC_EMIT_JSON_VALUE_ECHO_NAME_LEN = 4
#def RPC_EMIT_JSON_VALUE_FABLE_LEN = 5
#def RPC_EMIT_JSON_VALUE_FABLE_NAME_LEN = 5
#def RPC_EMIT_JSON_VALUE_ONYX_LEN = 4
#def RPC_EMIT_JSON_VALUE_ONYX_NAME_LEN = 4
#def RPC_EMIT_JSON_VALUE_NOVA_LEN = 4
#def RPC_EMIT_JSON_VALUE_NOVA_NAME_LEN = 4
#def RPC_EMIT_JSON_VALUE_SHIMMER_LEN = 7
#def RPC_EMIT_JSON_VALUE_SHIMMER_NAME_LEN = 7
#def RPC_EMIT_FB_KEY_TYPE_LEN = 4
#def RPC_EMIT_CHAT_DROP_REASONING_LEN = 9
#def RPC_EMIT_ERR_NOT_FOUND_LEN = 16
#def RPC_EMIT_ERR_MCP_RESOURCE_LIST_UNSUPPORTED_LEN = 43
#def RPC_EMIT_ERR_MCP_RESOURCE_TEMPLATES_UNSUPPORTED_LEN = 48

@ffi_wrapper rpc_emit_begin_field_object(writer: ptr, &key: ptr, key_len: u64) -> u32:
L_ENTRY:
    field_status = call @sa_json_writer_object_field(writer, &key, key_len)
    begin_status = call @sa_json_writer_begin_object(writer)
    !begin_status
    !field_status
    !writer
    !key
    !key_len
    return 0

@ffi_wrapper send_rpc_json(&req: ptr, status: u16, &json_ptr: ptr, json_len: u64) -> u32:
L_ENTRY:
    resp_slot = stack_alloc 8
    s = call @sa_http_server_resp_new(req, status, &resp_slot)
    resp = load resp_slot+0 as ptr
    send_s = call @sa_http_server_resp_send(resp, &json_ptr, json_len)
    !send_s
    !s
    call @sa_http_server_resp_free(^resp)
    return 0

@ffi_wrapper send_json_response(&req: ptr, status: u16, &json_ptr: ptr, json_len: u64) -> u32:
L_ENTRY:
    resp_slot = stack_alloc 8
    s = call @sa_http_server_resp_new(req, status, &resp_slot)
    resp = load resp_slot+0 as ptr
    ct_s = call @sa_http_server_resp_set_content_type(resp, &RPC_EMIT_MIME_JSON, RPC_EMIT_MIME_JSON_LEN)
    send_s = call @sa_http_server_resp_send(resp, &json_ptr, json_len)
    !send_s
    !ct_s
    !s
    call @sa_http_server_resp_free(^resp)
    return 0

@ffi_wrapper send_jsonrpc_envelope_with_id(&req: ptr, status: u16, &id_ptr: ptr, id_len: u64, &payload_ptr: ptr, payload_len: u64, is_error: u8) -> u32:
L_ENTRY:
    buffer_slot = stack_alloc 8
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    EXPAND JSON_WRITER_FIELD_STRING jsonrpc_status, writer, RPC_EMIT_RPC_KEY_JSONRPC, RPC_EMIT_RPC_KEY_JSONRPC_LEN, RPC_EMIT_RPC_VALUE_2_0, RPC_EMIT_RPC_VALUE_2_0_LEN
    !jsonrpc_status
    id_node = call @sa_json_parse(&id_ptr, id_len)
    id_has_node = ne id_node, 0
    br id_has_node -> L_JSONRPC_ID_NODE, L_JSONRPC_ID_NULL

L_JSONRPC_ID_NODE:
    !id_has_node
    id_field_status = call @sa_json_writer_field_node(writer, &RPC_EMIT_RPC_KEY_ID, RPC_EMIT_RPC_KEY_ID_LEN, id_node)
    id_free_status = call @sa_json_free(^id_node)
    !id_free_status
    !id_field_status
    jmp L_JSONRPC_PAYLOAD_PARSE

L_JSONRPC_ID_NULL:
    !id_has_node
    !id_node
    EXPAND JSON_WRITER_FIELD_NULL id_null_status, writer, RPC_EMIT_RPC_KEY_ID, RPC_EMIT_RPC_KEY_ID_LEN
    !id_null_status
    jmp L_JSONRPC_PAYLOAD_PARSE

L_JSONRPC_PAYLOAD_PARSE:
    payload_node = call @sa_json_parse(&payload_ptr, payload_len)
    payload_has_node = ne payload_node, 0
    br payload_has_node -> L_JSONRPC_PAYLOAD_NODE, L_JSONRPC_PAYLOAD_NULL

L_JSONRPC_PAYLOAD_NODE:
    !payload_has_node
    is_error_flag = eq is_error, 1
    br is_error_flag -> L_JSONRPC_ERROR_NODE, L_JSONRPC_RESULT_NODE

L_JSONRPC_RESULT_NODE:
    !is_error_flag
    payload_field_status = call @sa_json_writer_field_node(writer, &RPC_EMIT_RPC_KEY_RESULT, RPC_EMIT_RPC_KEY_RESULT_LEN, payload_node)
    payload_free_status = call @sa_json_free(^payload_node)
    !payload_free_status
    !payload_field_status
    jmp L_JSONRPC_FINISH

L_JSONRPC_ERROR_NODE:
    !is_error_flag
    payload_error_status = call @sa_json_writer_field_node(writer, &RPC_EMIT_RPC_KEY_ERROR, RPC_EMIT_RPC_KEY_ERROR_LEN, payload_node)
    payload_error_free_status = call @sa_json_free(^payload_node)
    !payload_error_free_status
    !payload_error_status
    jmp L_JSONRPC_FINISH

L_JSONRPC_PAYLOAD_NULL:
    !payload_has_node
    !payload_node
    is_error_null = eq is_error, 1
    br is_error_null -> L_JSONRPC_ERROR_NULL, L_JSONRPC_RESULT_NULL

L_JSONRPC_RESULT_NULL:
    !is_error_null
    EXPAND JSON_WRITER_FIELD_NULL payload_null_status, writer, RPC_EMIT_RPC_KEY_RESULT, RPC_EMIT_RPC_KEY_RESULT_LEN
    !payload_null_status
    jmp L_JSONRPC_FINISH

L_JSONRPC_ERROR_NULL:
    !is_error_null
    EXPAND JSON_WRITER_FIELD_NULL payload_error_null_status, writer, RPC_EMIT_RPC_KEY_ERROR, RPC_EMIT_RPC_KEY_ERROR_LEN
    !payload_error_null_status
    jmp L_JSONRPC_FINISH

L_JSONRPC_FINISH:
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    json_ptr_slot = stack_alloc 8
    json_len_slot = stack_alloc 8
    finish_status = call @json_writer_finish_view(writer, &buffer_slot, &json_ptr_slot, &json_len_slot)
    buffer = load buffer_slot+0 as ptr
    json_ptr = load json_ptr_slot+0 as ptr
    json_len = load json_len_slot+0 as u64
    send_status = call @send_rpc_json(&req, status, &json_ptr, json_len)
    dispose_status = call @json_writer_dispose_finished(buffer, writer)
    !dispose_status
    !send_status
    !json_ptr
    !json_len
    !finish_status
    !end_status
    !begin_status
    !writer_status
    !id_ptr
    !id_len
    !payload_ptr
    !payload_len
    !is_error
    !status
    !req
    return 0

@ffi_wrapper send_wrapped_writer_with_id(&req: ptr, &id_ptr: ptr, id_len: u64, writer: ptr) -> u32:
L_ENTRY:
    buffer_slot = stack_alloc 8
    result_ptr_slot = stack_alloc 8
    result_len_slot = stack_alloc 8
    finish_status = call @json_writer_finish_view(writer, &buffer_slot, &result_ptr_slot, &result_len_slot)
    buffer = load buffer_slot+0 as ptr
    result_ptr = load result_ptr_slot+0 as ptr
    result_len = load result_len_slot+0 as u64
    send_status = call @send_jsonrpc_envelope_with_id(&req, 200, &id_ptr, id_len, &result_ptr, result_len, 0)
    dispose_status = call @json_writer_dispose_finished(buffer, writer)
    !dispose_status
    !send_status
    !result_ptr
    !result_len
    !finish_status
    !id_ptr
    !id_len
    !req
    return 0

@ffi_wrapper send_json_writer_response(&req: ptr, status: u16, writer: ptr) -> u32:
L_ENTRY:
    buffer_slot = stack_alloc 8
    json_ptr_slot = stack_alloc 8
    json_len_slot = stack_alloc 8
    finish_status = call @json_writer_finish_view(writer, &buffer_slot, &json_ptr_slot, &json_len_slot)
    buffer = load buffer_slot+0 as ptr
    json_ptr = load json_ptr_slot+0 as ptr
    json_len = load json_len_slot+0 as u64
    send_status = call @send_json_response(&req, status, &json_ptr, json_len)
    dispose_status = call @json_writer_dispose_finished(buffer, writer)
    !dispose_status
    !send_status
    !json_ptr
    !json_len
    !finish_status
    !status
    !req
    return 0

@ffi_wrapper send_wrapped_raw_json_with_id(&req: ptr, &id_ptr: ptr, id_len: u64, &result_ptr: ptr, result_len: u64) -> u32:
L_ENTRY:
    send_status = call @send_jsonrpc_envelope_with_id(&req, 200, &id_ptr, id_len, &result_ptr, result_len, 0)
    !send_status
    !id_ptr
    !id_len
    !result_ptr
    !result_len
    !req
    return 0

@ffi_wrapper send_json_bool_field_response(&req: ptr, status: u16, &key: ptr, key_len: u64, value: u8) -> u32:
L_ENTRY:
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    EXPAND JSON_WRITER_FIELD_BOOL field_status, writer, key, key_len, value
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    call @send_json_writer_response(&req, status, writer)
    !end_status
    !field_status
    !begin_status
    !writer_status
    !key
    !key_len
    !value
    !status
    !req
    return 0

@ffi_wrapper send_json_error_string_response(&req: ptr, status: u16, &msg_ptr: ptr, msg_len: u64) -> u32:
L_ENTRY:
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    EXPAND JSON_WRITER_FIELD_STRING error_status, writer, RPC_EMIT_JSON_KEY_ERROR, RPC_EMIT_JSON_KEY_ERROR_LEN, msg_ptr, msg_len
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    call @send_json_writer_response(&req, status, writer)
    !end_status
    !error_status
    !begin_status
    !writer_status
    !msg_ptr
    !msg_len
    !status
    !req
    return 0

@ffi_wrapper send_empty_body_error_response(&req: ptr) -> u32:
L_ENTRY:
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    error_begin = call @rpc_emit_begin_field_object(writer, &RPC_EMIT_JSON_KEY_ERROR, RPC_EMIT_JSON_KEY_ERROR_LEN)
    EXPAND JSON_WRITER_FIELD_STRING code_status, writer, RPC_EMIT_JSON_KEY_CODE, RPC_EMIT_JSON_KEY_CODE_LEN, RPC_EMIT_JSON_VALUE_HTTP_400, RPC_EMIT_JSON_VALUE_HTTP_400_LEN
    EXPAND JSON_WRITER_FIELD_STRING message_status, writer, RPC_EMIT_JSON_KEY_MESSAGE, RPC_EMIT_JSON_KEY_MESSAGE_LEN, RPC_EMIT_JSON_VALUE_EMPTY_BODY_MESSAGE, RPC_EMIT_JSON_VALUE_EMPTY_BODY_MESSAGE_LEN
    EXPAND JSON_WRITER_FIELD_STRING type_status, writer, RPC_EMIT_FB_KEY_TYPE, RPC_EMIT_FB_KEY_TYPE_LEN, RPC_EMIT_JSON_VALUE_BAD_REQUEST, RPC_EMIT_JSON_VALUE_BAD_REQUEST_LEN
    EXPAND JSON_WRITER_END_OBJECT error_end, writer
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    call @send_json_writer_response(&req, 400, writer)
    !end_status
    !error_end
    !type_status
    !message_status
    !code_status
    !error_begin
    !begin_status
    !writer_status
    !req
    return 0

@ffi_wrapper send_error_with_id(&req: ptr, status: u16, &id_ptr: ptr, id_len: u64, &error_ptr: ptr, error_len: u64) -> u32:
L_ENTRY:
    code_slot = stack_alloc 8
    method_raw = call @sa_bytes_eq(&error_ptr, error_len, &RPC_EMIT_ERR_NOT_FOUND, RPC_EMIT_ERR_NOT_FOUND_LEN)
    method_ok = eq method_raw, 1
    br method_ok -> L_ERR_CODE_METHOD_DIRECT, L_ERR_CODE_CHECK_MCP_LIST

L_ERR_CODE_METHOD_DIRECT:
    !method_ok
    !method_raw
    jmp L_ERR_CODE_METHOD_SET

L_ERR_CODE_CHECK_MCP_LIST:
    !method_ok
    !method_raw
    mcp_list_raw = call @sa_bytes_eq(&error_ptr, error_len, &RPC_EMIT_ERR_MCP_RESOURCE_LIST_UNSUPPORTED, RPC_EMIT_ERR_MCP_RESOURCE_LIST_UNSUPPORTED_LEN)
    mcp_list_ok = eq mcp_list_raw, 1
    br mcp_list_ok -> L_ERR_CODE_METHOD_FROM_LIST, L_ERR_CODE_CHECK_MCP_TEMPLATES

L_ERR_CODE_METHOD_FROM_LIST:
    !mcp_list_ok
    !mcp_list_raw
    jmp L_ERR_CODE_METHOD_SET

L_ERR_CODE_CHECK_MCP_TEMPLATES:
    !mcp_list_ok
    !mcp_list_raw
    mcp_templates_raw = call @sa_bytes_eq(&error_ptr, error_len, &RPC_EMIT_ERR_MCP_RESOURCE_TEMPLATES_UNSUPPORTED, RPC_EMIT_ERR_MCP_RESOURCE_TEMPLATES_UNSUPPORTED_LEN)
    mcp_templates_ok = eq mcp_templates_raw, 1
    br mcp_templates_ok -> L_ERR_CODE_METHOD_FROM_TEMPLATES, L_ERR_CODE_CHECK_INVALID

L_ERR_CODE_METHOD_FROM_TEMPLATES:
    !mcp_templates_ok
    !mcp_templates_raw
    jmp L_ERR_CODE_METHOD_SET

L_ERR_CODE_CHECK_INVALID:
    !mcp_templates_ok
    !mcp_templates_raw
    is_bad_params = eq status, 400
    br is_bad_params -> L_ERR_CODE_INVALID, L_ERR_CODE_INTERNAL

L_ERR_CODE_METHOD_SET:
    method_code_u = sub 0, 32601
    method_code_i = bitcast method_code_u as i64
    store code_slot+0, method_code_i as i64
    !method_code_i
    !method_code_u
    jmp L_ERR_WRITE

L_ERR_CODE_INVALID:
    !is_bad_params
    invalid_code_u = sub 0, 32602
    invalid_code_i = bitcast invalid_code_u as i64
    store code_slot+0, invalid_code_i as i64
    !invalid_code_i
    !invalid_code_u
    jmp L_ERR_WRITE

L_ERR_CODE_INTERNAL:
    !is_bad_params
    internal_code_u = sub 0, 32000
    internal_code_i = bitcast internal_code_u as i64
    store code_slot+0, internal_code_i as i64
    !internal_code_i
    !internal_code_u
    jmp L_ERR_WRITE

L_ERR_WRITE:
