@const RPC_EMIT_JSON_KEY_CODE = utf8:"code"
@const RPC_EMIT_JSON_KEY_MESSAGE = utf8:"message"
@const RPC_EMIT_JSON_KEY_DATA = utf8:"data"
@const RPC_EMIT_JSON_KEY_NEXT_CURSOR = utf8:"nextCursor"
@const RPC_EMIT_JSON_KEY_CONTENTS = utf8:"contents"
@const RPC_EMIT_JSON_KEY_CONTENT = utf8:"content"
@const RPC_EMIT_JSON_KEY_META = utf8:"meta"
@const RPC_EMIT_JSON_KEY_DESCRIPTION = utf8:"description"
@const RPC_EMIT_JSON_KEY_HOOKS = utf8:"hooks"
