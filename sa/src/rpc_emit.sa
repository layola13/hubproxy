    buffer_slot = stack_alloc 8
    payload_ptr_slot = stack_alloc 8
    payload_len_slot = stack_alloc 8
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    code_status = call @sa_json_writer_field_i64(writer, &RPC_EMIT_JSON_KEY_CODE, RPC_EMIT_JSON_KEY_CODE_LEN, code)
    EXPAND JSON_WRITER_FIELD_STRING message_status, writer, RPC_EMIT_JSON_KEY_MESSAGE, RPC_EMIT_JSON_KEY_MESSAGE_LEN, error_ptr, error_len
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    finish_status = call @json_writer_finish_view(writer, &buffer_slot, &payload_ptr_slot, &payload_len_slot)
    buffer = load buffer_slot+0 as ptr
    payload_ptr = load payload_ptr_slot+0 as ptr
    payload_len = load payload_len_slot+0 as u64
    send_status = call @send_jsonrpc_envelope_with_id(&req, status, &id_ptr, id_len, &payload_ptr, payload_len, 1)
    dispose_status = call @json_writer_dispose_finished(buffer, writer)
    !dispose_status
    !payload_ptr
    !payload_len
    !finish_status
    !end_status
    !message_status
    !code_status
    !begin_status
    !writer_status
    !code
    !send_status
    !id_ptr
    !id_len
    !error_ptr
    !error_len
    !status
    !req
    return 0

