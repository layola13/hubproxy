@ffi_wrapper json_writer_field_default_or_null(writer: ptr, &field_key: ptr, field_key_len: u64, &fallback: ptr, fallback_len: u64, emit_null_if_missing: u8) -> u32:
L_ENTRY:
    emit_null = eq emit_null_if_missing, 1
    br emit_null -> L_JW_DEFAULT_NULL, L_JW_DEFAULT_STRING

L_JW_DEFAULT_NULL:
