    value_free = call @sa_json_free(^value_node)
    !value_free
    !field_status
    !value_status
    !lookup_ptr
    !lookup_len
    !writer
    !field_key
    !field_key_len
    !params_node
    !lookup_key
    !lookup_key_len
    !fallback
    !fallback_len
    !emit_null_if_missing
    return 0

L_JW_PARAM_FROM_PARAMS_MISSING:
    !value_ok
    !value_status
    !lookup_ptr
    !lookup_len
    fallback_status_missing = call @json_writer_field_default_or_null(writer, &field_key, field_key_len, &fallback, fallback_len, emit_null_if_missing)
    !fallback_status_missing
    !writer
    !field_key
    !field_key_len
