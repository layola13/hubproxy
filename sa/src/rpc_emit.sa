L_ENTRY:
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    write_status = call @json_writer_write_user_input_continue_result(writer)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !write_status
    !writer_status
    !id_ptr
    !id_len
    !req
    return 0

@ffi_wrapper send_rpc_realtime_voices_with_id(&req: ptr, &id_ptr: ptr, id_len: u64) -> u32:
L_ENTRY:
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    voices_begin = call @json_writer_begin_field_array(writer, &RPC_EMIT_JSON_KEY_VOICES, RPC_EMIT_JSON_KEY_VOICES_LEN)
    alloy_status = call @json_writer_write_voice(writer, &RPC_EMIT_JSON_VALUE_ALLOY, RPC_EMIT_JSON_VALUE_ALLOY_LEN, &RPC_EMIT_JSON_VALUE_ALLOY_NAME, RPC_EMIT_JSON_VALUE_ALLOY_NAME_LEN)
    echo_status = call @json_writer_write_voice(writer, &RPC_EMIT_JSON_VALUE_ECHO, RPC_EMIT_JSON_VALUE_ECHO_LEN, &RPC_EMIT_JSON_VALUE_ECHO_NAME, RPC_EMIT_JSON_VALUE_ECHO_NAME_LEN)
    fable_status = call @json_writer_write_voice(writer, &RPC_EMIT_JSON_VALUE_FABLE, RPC_EMIT_JSON_VALUE_FABLE_LEN, &RPC_EMIT_JSON_VALUE_FABLE_NAME, RPC_EMIT_JSON_VALUE_FABLE_NAME_LEN)
    onyx_status = call @json_writer_write_voice(writer, &RPC_EMIT_JSON_VALUE_ONYX, RPC_EMIT_JSON_VALUE_ONYX_LEN, &RPC_EMIT_JSON_VALUE_ONYX_NAME, RPC_EMIT_JSON_VALUE_ONYX_NAME_LEN)
    nova_status = call @json_writer_write_voice(writer, &RPC_EMIT_JSON_VALUE_NOVA, RPC_EMIT_JSON_VALUE_NOVA_LEN, &RPC_EMIT_JSON_VALUE_NOVA_NAME, RPC_EMIT_JSON_VALUE_NOVA_NAME_LEN)
    shimmer_status = call @json_writer_write_voice(writer, &RPC_EMIT_JSON_VALUE_SHIMMER, RPC_EMIT_JSON_VALUE_SHIMMER_LEN, &RPC_EMIT_JSON_VALUE_SHIMMER_NAME, RPC_EMIT_JSON_VALUE_SHIMMER_NAME_LEN)
    EXPAND JSON_WRITER_END_ARRAY voices_end, writer
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !end_status
    !voices_end
    !shimmer_status
    !nova_status
    !onyx_status
    !fable_status
    !echo_status
    !alloy_status
    !voices_begin
    !begin_status
    !writer_status
    !id_ptr
    !id_len
    !req
    return 0
