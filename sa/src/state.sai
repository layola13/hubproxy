// state.sai — In-memory state management for HubProxy

// Thread slot layout (416 bytes each)
#def THR_SLOT_SIZE   = 416
#def THR_ID          = +0     // u64 thread number
#def THR_ACTIVE      = +8     // u8: 1=active, 0=free
#def THR_STATUS      = +9     // u8: 0=idle, 1=active, 2=error
#def THR_NAME_SET    = +10    // u8: 1=name is a JSON string, 0=null
#def THR_MODEL_PTR   = +16    // ptr to model string
#def THR_MODEL_LEN   = +24    // u64 model string length
#def THR_DIR_PTR     = +32    // ptr to data dir string
#def THR_DIR_LEN     = +40    // u64 data dir length
#def THR_CREATED     = +48    // u64 unix timestamp
#def THR_ELICITATION = +56    // u64 active elicitation count
#def THR_PREVIEW_LEN = +64    // u64 preview byte length
#def THR_NAME_LEN    = +72    // u64 name byte length
#def THR_PREVIEW     = +80    // inline preview bytes
#def THR_NAME        = +144   // inline name bytes
#def THR_FORKED_FROM_ID = +208 // u64 parent thread id (0 = null)
#def THR_PROVIDER_PTR = +216  // ptr to model provider string
#def THR_PROVIDER_LEN = +224  // u64 model provider string length
#def THR_EPHEMERAL  = +232   // u8: 1=true, 0=false
#def THR_KEY_LEN    = +240   // u64 caller-provided thread id byte length
#def THR_KEY        = +248   // inline caller-provided thread id bytes
#def THR_GIT_PTR    = +376   // ptr to raw gitInfo JSON, 0=null
#def THR_GIT_LEN    = +384   // u64 raw gitInfo JSON length
#def THR_GIT_SET    = +392   // u8: 1=gitInfo set, 0=null
#def THR_PREVIEW_CAP = 64
#def THR_NAME_CAP    = 64
#def THR_KEY_CAP     = 128

// Turn slot layout (304 bytes each)
#def TURN_SLOT_SIZE  = 304
#def TURN_ID         = +0     // u64 turn number
#def TURN_THR_ID     = +8     // u64 owning thread number
#def TURN_ACTIVE     = +16    // u8: 1=active, 0=free
#def TURN_STATUS     = +17    // u8: 0=completed, 1=inProgress, 2=failed
#def TURN_MODE       = +18    // u8: 0=null, 1=plan, 2=goal, 3=code
#def TURN_CREATED    = +24    // u64 unix timestamp
#def TURN_ITEMS_LEN  = +32    // u64 raw JSON array payload length
#def TURN_ITEMS      = +40    // inline raw JSON array bytes
#def TURN_ITEMS_CAP  = 256

// Goal slot layout (176 bytes each)
#def GOAL_SLOT_SIZE  = 176
#def GOAL_THR_ID     = +0     // u64 thread number
#def GOAL_ACTIVE     = +8     // u8: 1=active, 0=free
#def GOAL_STATUS     = +9     // u8: 0=active, 1=complete, 2=budgetLimited
#def GOAL_BUDGET     = +16    // u64 token budget (0 = unlimited)
#def GOAL_USED       = +24    // u64 tokens consumed
#def GOAL_OBJ_LEN    = +32    // u64 objective length
#def GOAL_OBJ        = +40    // inline objective bytes
#def GOAL_OBJ_CAP    = 128

// Limits
#def MAX_THREADS     = 256
#def MAX_TURNS       = 1024
#def MAX_GOALS       = 256
#def ST_NEXT_ID      = +0
#def ST_THR_COUNT    = +8
#def ST_TURN_COUNT   = +16
#def ST_GOAL_COUNT   = +24
#def ST_NOTIFY_HEAD  = +32
#def ST_NOTIFY_TAIL  = +40
#def ST_PROC_COUNT   = +48
#def ST_WATCH_COUNT  = +56
#def ST_THREADS      = 64
#def ST_TURNS        = 106560
#def ST_GOALS        = 417856
#def ST_PROCESSES    = 462912
#def ST_WATCHES      = 468032
#def ST_NOTIFY_DATA  = 477248
#def STATE_MEM_SIZE  = 542784

// Process handle slot layout (80 bytes each)
#def PROC_SLOT_SIZE  = 80
#def PROC_ACTIVE     = +0
#def PROC_HANDLE_LEN = +8
#def PROC_HANDLE     = +16
#def PROC_HANDLE_CAP = 64
#def MAX_PROCESSES   = 64

// File watch slot layout (144 bytes each)
#def WATCH_SLOT_SIZE = 144
#def WATCH_ACTIVE    = +0
#def WATCH_ID_LEN    = +8
#def WATCH_ID        = +16
#def WATCH_ID_CAP    = 128
#def MAX_WATCHES     = 64

// Notification slot (ring buffer, 64 entries)
#def NOTIFY_LEN       = +0
#def NOTIFY_READY     = +8
#def NOTIFY_DATA      = +16
#def NOTIFY_SLOT_SIZE = 1024
#def NOTIFY_CAP       = 1008
#def MAX_NOTIFIES    = 64
#def ST_TOTAL         = 542784

// --- State API ---
@extern state_init(&state: ptr) -> u32
@extern state_reset_runtime(&state: ptr) -> u32
@extern state_thread_create(&state: ptr, &model_ptr: ptr, model_len: u64, &dir_ptr: ptr, dir_len: u64) -> u64
@extern state_thread_create_with_key(&state: ptr, &key_ptr: ptr, key_len: u64, &model_ptr: ptr, model_len: u64, &dir_ptr: ptr, dir_len: u64) -> u64
@extern state_thread_find(&state: ptr, thread_id: u64) -> ptr
@extern state_thread_find_by_key(&state: ptr, &key_ptr: ptr, key_len: u64) -> ptr
@extern state_thread_list_active(&state: ptr, &out_ids: ptr, &out_count: ptr) -> u32
@extern state_thread_archive(&state: ptr, thread_id: u64) -> u32
@extern state_thread_unarchive(&state: ptr, thread_id: u64) -> u32
@extern state_thread_set_name(&state: ptr, thread_id: u64, &name_ptr: ptr, name_len: u64) -> u32
@extern state_thread_clear_name(&state: ptr, thread_id: u64) -> u32
@extern state_thread_set_preview(&state: ptr, thread_id: u64, &preview_ptr: ptr, preview_len: u64) -> u32
@extern state_thread_clear_preview(&state: ptr, thread_id: u64) -> u32
@extern state_thread_set_git_info(&state: ptr, thread_id: u64, &git_ptr: ptr, git_len: u64) -> u32
@extern state_thread_clear_git_info(&state: ptr, thread_id: u64) -> u32
@extern state_thread_copy_git_info(&state: ptr, source_thread_id: u64, target_thread_id: u64) -> u32
@extern state_thread_set_model_provider(&state: ptr, thread_id: u64, &provider_ptr: ptr, provider_len: u64) -> u32
@extern state_thread_set_ephemeral(&state: ptr, thread_id: u64, ephemeral: u8) -> u32
@extern state_thread_increment_elicitation(&state: ptr, thread_id: u64) -> u64
@extern state_thread_decrement_elicitation(&state: ptr, thread_id: u64) -> u64
@extern state_turn_create(&state: ptr, thread_id: u64) -> u64
@extern state_turn_find(&state: ptr, thread_id: u64, turn_id: u64) -> ptr
@extern state_turn_set_mode(&state: ptr, thread_id: u64, turn_id: u64, mode: u8) -> u32
@extern state_turn_set_items(&state: ptr, thread_id: u64, turn_id: u64, &items_ptr: ptr, items_len: u64) -> u32
@extern state_turn_append_items(&state: ptr, thread_id: u64, turn_id: u64, &items_ptr: ptr, items_len: u64) -> u32
@extern state_turn_interrupt(&state: ptr, thread_id: u64, turn_id: u64) -> u32
@extern state_turn_list(&state: ptr, thread_id: u64, &out_ids: ptr, &out_count: ptr) -> u32
@extern state_turn_rollback(&state: ptr, thread_id: u64, remove_count: u64) -> u32
@extern state_goal_set(&state: ptr, thread_id: u64, budget: u64, &obj_ptr: ptr, obj_len: u64) -> u32
@extern state_goal_get(&state: ptr, thread_id: u64, &out_budget: ptr, &out_used: ptr) -> i32
@extern state_goal_get_full(&state: ptr, thread_id: u64, &out_budget: ptr, &out_used: ptr, &out_obj_ptr: ptr, &out_obj_len: ptr) -> i32
@extern state_goal_clear(&state: ptr, thread_id: u64) -> u32
@extern state_goal_add_tokens(&state: ptr, thread_id: u64, tokens: u64) -> u32
@extern state_process_put(&state: ptr, &handle_ptr: ptr, handle_len: u64) -> u32
@extern state_process_delete(&state: ptr, &handle_ptr: ptr, handle_len: u64) -> u32
@extern state_watch_put(&state: ptr, &watch_ptr: ptr, watch_len: u64) -> u32
@extern state_watch_delete(&state: ptr, &watch_ptr: ptr, watch_len: u64) -> u32
@extern state_next_id(&state: ptr) -> u64
@extern state_notify_push(&state: ptr, &frame: ptr, frame_len: u64) -> u32
@extern state_notify_pop(&state: ptr, &out_frame: ptr, out_cap: u64, &out_len: ptr) -> u32
@extern state_notify_cursor(&state: ptr) -> u64
@extern state_notify_read(&state: ptr, &cursor: ptr, &out_frame: ptr, out_cap: u64, &out_len: ptr) -> u32
