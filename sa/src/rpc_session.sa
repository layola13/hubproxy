@ffi_wrapper json_writer_write_turn_status_string(writer: ptr, status: u8) -> u32:
L_ENTRY:
    is_interrupted = eq status, 2
    br is_interrupted -> L_JW_TURN_STATUS_INTERRUPTED, L_JW_TURN_STATUS_DONE_CHECK

L_JW_TURN_STATUS_INTERRUPTED:
    !is_interrupted
    write_interrupted = call @sa_json_writer_write_string(writer, &RPC_SESSION_J_TURN_STATUS_INTERRUPTED, RPC_SESSION_J_TURN_STATUS_INTERRUPTED_LEN)
    !write_interrupted
    !writer
    !status
    return 0

L_JW_TURN_STATUS_DONE_CHECK:
    !is_interrupted
    is_done = eq status, 0
    br is_done -> L_JW_TURN_STATUS_COMPLETED, L_JW_TURN_STATUS_IN_PROGRESS

L_JW_TURN_STATUS_COMPLETED:
    !is_done
    write_completed = call @sa_json_writer_write_string(writer, &RPC_SESSION_J_TURN_STATUS_COMPLETED, RPC_SESSION_J_TURN_STATUS_COMPLETED_LEN)
    !write_completed
    !writer
    !status
    return 0

L_JW_TURN_STATUS_IN_PROGRESS:
    !is_done
    write_progress = call @sa_json_writer_write_string(writer, &RPC_SESSION_J_TURN_STATUS_IN_PROGRESS, RPC_SESSION_J_TURN_STATUS_IN_PROGRESS_LEN)
    !write_progress
    !writer
    !status
    return 0

@ffi_wrapper json_writer_write_turn_status_field(writer: ptr, &key: ptr, key_len: u64, status: u8) -> u32:
L_ENTRY:
    field_status = call @sa_json_writer_object_field(writer, &key, key_len)
    phase_status = call @json_writer_write_turn_status_string(writer, status)
    !phase_status
    !field_status
    !writer
    !key
    !key_len
    !status
    return 0

@ffi_wrapper json_writer_write_turn_completion_fields(writer: ptr, status: u8, completed_ts: u64) -> u32:
L_ENTRY:
    is_open = eq status, 1
    br is_open -> L_JW_TURN_OPEN_FIELDS, L_JW_TURN_DONE_FIELDS

L_JW_TURN_OPEN_FIELDS:
    !is_open
    EXPAND JSON_WRITER_FIELD_NULL completed_null, writer, RPC_SESSION_JSON_KEY_COMPLETED_AT, RPC_SESSION_JSON_KEY_COMPLETED_AT_LEN
    EXPAND JSON_WRITER_FIELD_NULL duration_null, writer, RPC_SESSION_JSON_KEY_DURATION_MS, RPC_SESSION_JSON_KEY_DURATION_MS_LEN
    EXPAND JSON_WRITER_FIELD_NULL error_null, writer, RPC_SESSION_JSON_KEY_ERROR, RPC_SESSION_JSON_KEY_ERROR_LEN
    !error_null
    !duration_null
    !completed_null
    !writer
    !status
    !completed_ts
    return 0

L_JW_TURN_DONE_FIELDS:
    !is_open
    completed_i = bitcast completed_ts as i64
    completed_value = call @sa_json_writer_field_i64(writer, &RPC_SESSION_JSON_KEY_COMPLETED_AT, RPC_SESSION_JSON_KEY_COMPLETED_AT_LEN, completed_i)
    is_completed = eq status, 0
    br is_completed -> L_JW_TURN_DONE_DURATION_ZERO, L_JW_TURN_DONE_DURATION_NULL

L_JW_TURN_DONE_DURATION_ZERO:
    !is_completed
    duration_value = call @sa_json_writer_field_i64(writer, &RPC_SESSION_JSON_KEY_DURATION_MS, RPC_SESSION_JSON_KEY_DURATION_MS_LEN, 0)
    jmp L_JW_TURN_DONE_ERROR

L_JW_TURN_DONE_DURATION_NULL:
    !is_completed
    EXPAND JSON_WRITER_FIELD_NULL duration_value, writer, RPC_SESSION_JSON_KEY_DURATION_MS, RPC_SESSION_JSON_KEY_DURATION_MS_LEN
    jmp L_JW_TURN_DONE_ERROR

L_JW_TURN_DONE_ERROR:
    EXPAND JSON_WRITER_FIELD_NULL error_null_done, writer, RPC_SESSION_JSON_KEY_ERROR, RPC_SESSION_JSON_KEY_ERROR_LEN
    !error_null_done
    !duration_value
    !completed_value
    !completed_i
    !writer
    !status
    !completed_ts
    return 0

@ffi_wrapper json_writer_write_turn_object(writer: ptr, turn_id: u64, status: u8, mode: u8, created_ts: u64, updated_ts: u64, completed_ts: u64, &mode_ptr: ptr, mode_len: u64, &items_ptr: ptr, items_len: u64) -> u32:
L_ENTRY:
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    id_status = call @json_writer_field_u64_string(writer, &RPC_SESSION_RPC_KEY_ID, RPC_SESSION_RPC_KEY_ID_LEN, turn_id)
    items_status = call @json_writer_field_items_or_empty(writer, &RPC_SESSION_JSON_KEY_ITEMS, RPC_SESSION_JSON_KEY_ITEMS_LEN, &items_ptr, items_len)
    status_write = call @json_writer_write_turn_status_field(writer, &RPC_SESSION_JSON_KEY_STATUS, RPC_SESSION_JSON_KEY_STATUS_LEN, status)
    created_i = bitcast created_ts as i64
    updated_i = bitcast updated_ts as i64
    created_status = call @sa_json_writer_field_i64(writer, &RPC_SESSION_JSON_KEY_CREATED_AT, RPC_SESSION_JSON_KEY_CREATED_AT_LEN, created_i)
    updated_status = call @sa_json_writer_field_i64(writer, &RPC_SESSION_JSON_KEY_UPDATED_AT, RPC_SESSION_JSON_KEY_UPDATED_AT_LEN, updated_i)
    mode_status = call @json_writer_field_mode_text_or_value(writer, &RPC_SESSION_FB_KEY_COLLAB_MODE_KIND, RPC_SESSION_FB_KEY_COLLAB_MODE_KIND_LEN, mode, &mode_ptr, mode_len)
    EXPAND JSON_WRITER_FIELD_STRING view_status, writer, RPC_SESSION_JSON_KEY_ITEMS_VIEW, RPC_SESSION_JSON_KEY_ITEMS_VIEW_LEN, RPC_SESSION_JSON_VALUE_FULL, RPC_SESSION_JSON_VALUE_FULL_LEN
    started_status = call @sa_json_writer_field_i64(writer, &RPC_SESSION_JSON_KEY_STARTED_AT, RPC_SESSION_JSON_KEY_STARTED_AT_LEN, created_i)
    completion_status = call @json_writer_write_turn_completion_fields(writer, status, completed_ts)
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    !end_status
    !completion_status
    !started_status
    !view_status
    !mode_status
    !updated_status
    !created_status
    !updated_i
    !created_i
    !status_write
    !items_status
    !id_status
    !begin_status
    !writer
    !turn_id
    !status
    !mode
    !created_ts
    !updated_ts
    !completed_ts
    !mode_ptr
    !mode_len
    !items_ptr
    !items_len
    return 0

@ffi_wrapper json_writer_write_turn_object_field(writer: ptr, &key: ptr, key_len: u64, turn_id: u64, status: u8, mode: u8, created_ts: u64, updated_ts: u64, completed_ts: u64, &mode_ptr: ptr, mode_len: u64, &items_ptr: ptr, items_len: u64) -> u32:
L_ENTRY:
    field_status = call @sa_json_writer_object_field(writer, &key, key_len)
    turn_write = call @json_writer_write_turn_object(writer, turn_id, status, mode, created_ts, updated_ts, completed_ts, &mode_ptr, mode_len, &items_ptr, items_len)
    !turn_write
    !field_status
    !writer
    !key
    !key_len
    !turn_id
    !status
    !mode
    !created_ts
    !updated_ts
    !completed_ts
    !mode_ptr
    !mode_len
    !items_ptr
    !items_len
    return 0

@ffi_wrapper json_writer_write_turn_object_mode(writer: ptr, turn_id: u64, mode: u8) -> u32:
L_ENTRY:
    empty_ptr = &RPC_SESSION_EMPTY_TEXT
    now_i = call @sa_time_unix_s()
    now_u = bitcast now_i as u64
    status = call @json_writer_write_turn_object(writer, turn_id, 1, mode, now_u, now_u, 0, &empty_ptr, 0, &empty_ptr, 0)
    !status
    !now_u
    !now_i
    !empty_ptr
    !writer
    !turn_id
    !mode
    return 0

