@ffi_wrapper json_writer_field_thread_id_string(writer: ptr, &key: ptr, key_len: u64, &state_ptr: ptr, thread_id: u64) -> u32:
L_ENTRY:
    slot = call @state_thread_find(&state_ptr, thread_id)
    missing = eq slot, 0
    br missing -> L_JW_TID_NUMERIC_MISSING, L_JW_TID_SLOT

L_JW_TID_SLOT:
    !missing
    stored_key_len = load slot+THR_KEY_LEN as u64
    has_key = ugt stored_key_len, 0
    br has_key -> L_JW_TID_KEY, L_JW_TID_NUMERIC_SLOT

L_JW_TID_KEY:
    !has_key
    stored_key_ptr = ptr_add slot, THR_KEY
    EXPAND JSON_WRITER_FIELD_STRING field_status, writer, key, key_len, stored_key_ptr, stored_key_len
    !field_status
    !stored_key_ptr
    !stored_key_len
    !slot
    !writer
    !key
    !key_len
    !state_ptr
    !thread_id
    return 0

L_JW_TID_NUMERIC_SLOT:
    !has_key
    !stored_key_len
    !slot
    jmp L_JW_TID_NUMERIC

L_JW_TID_NUMERIC_MISSING:
    !missing
    !slot
    jmp L_JW_TID_NUMERIC

L_JW_TID_NUMERIC:
    len_slot = stack_alloc 8
    tmp = call @u64_to_owned(thread_id, &len_slot)
    fmt_len = load len_slot+0 as u64
    EXPAND JSON_WRITER_FIELD_STRING field_status2, writer, key, key_len, tmp, fmt_len
    !field_status2
    !fmt_len
    !tmp
    !writer
    !key
    !key_len
    !state_ptr
    !thread_id
    return 0

@ffi_wrapper json_writer_field_thread_id_goal_key(writer: ptr, &key: ptr, key_len: u64, &state_ptr: ptr, thread_id: u64, &goal_key_ptr: ptr, goal_key_len: u64) -> u32:
L_ENTRY:
    has_goal_key = ugt goal_key_len, 0
    br has_goal_key -> L_JW_TID_GOAL_KEY, L_JW_TID_GOAL_FALLBACK

L_JW_TID_GOAL_KEY:
    !has_goal_key
    EXPAND JSON_WRITER_FIELD_STRING field_status, writer, key, key_len, goal_key_ptr, goal_key_len
    !field_status
    !writer
    !key
    !key_len
    !state_ptr
    !thread_id
    !goal_key_ptr
    !goal_key_len
    return 0

L_JW_TID_GOAL_FALLBACK:
    !has_goal_key
    fallback_status = call @json_writer_field_thread_id_string(writer, &key, key_len, &state_ptr, thread_id)
    !fallback_status
    !writer
    !key
    !key_len
    !state_ptr
    !thread_id
    !goal_key_ptr
    !goal_key_len
    return 0

@ffi_wrapper json_writer_field_goal_status(writer: ptr, status: u8) -> u32:
L_ENTRY:
    is_paused = eq status, 1
    br is_paused -> L_JW_GOAL_STATUS_PAUSED, L_JW_GOAL_STATUS_BLOCKED_CHECK

L_JW_GOAL_STATUS_PAUSED:
    !is_paused
    EXPAND JSON_WRITER_FIELD_STRING field_paused, writer, RPC_SESSION_JSON_KEY_STATUS, RPC_SESSION_JSON_KEY_STATUS_LEN, RPC_SESSION_J_GOAL_STATUS_PAUSED, RPC_SESSION_J_GOAL_STATUS_PAUSED_LEN
    !field_paused
    !writer
    !status
    return 0

L_JW_GOAL_STATUS_BLOCKED_CHECK:
    !is_paused
    is_blocked = eq status, 2
    br is_blocked -> L_JW_GOAL_STATUS_BLOCKED, L_JW_GOAL_STATUS_USAGE_CHECK

L_JW_GOAL_STATUS_BLOCKED:
    !is_blocked
    EXPAND JSON_WRITER_FIELD_STRING field_blocked, writer, RPC_SESSION_JSON_KEY_STATUS, RPC_SESSION_JSON_KEY_STATUS_LEN, RPC_SESSION_J_GOAL_STATUS_BLOCKED, RPC_SESSION_J_GOAL_STATUS_BLOCKED_LEN
    !field_blocked
    !writer
    !status
    return 0

L_JW_GOAL_STATUS_USAGE_CHECK:
    !is_blocked
    is_usage = eq status, 3
    br is_usage -> L_JW_GOAL_STATUS_USAGE, L_JW_GOAL_STATUS_BUDGET_CHECK

L_JW_GOAL_STATUS_USAGE:
    !is_usage
    EXPAND JSON_WRITER_FIELD_STRING field_usage, writer, RPC_SESSION_JSON_KEY_STATUS, RPC_SESSION_JSON_KEY_STATUS_LEN, RPC_SESSION_J_GOAL_STATUS_USAGE_LIMITED, RPC_SESSION_J_GOAL_STATUS_USAGE_LIMITED_LEN
    !field_usage
    !writer
    !status
    return 0

L_JW_GOAL_STATUS_BUDGET_CHECK:
    !is_usage
    is_budget = eq status, 4
    br is_budget -> L_JW_GOAL_STATUS_BUDGET, L_JW_GOAL_STATUS_COMPLETE_CHECK

L_JW_GOAL_STATUS_BUDGET:
    !is_budget
    EXPAND JSON_WRITER_FIELD_STRING field_budget, writer, RPC_SESSION_JSON_KEY_STATUS, RPC_SESSION_JSON_KEY_STATUS_LEN, RPC_SESSION_J_GOAL_STATUS_BUDGET_LIMITED, RPC_SESSION_J_GOAL_STATUS_BUDGET_LIMITED_LEN
    !field_budget
    !writer
    !status
    return 0

L_JW_GOAL_STATUS_COMPLETE_CHECK:
    !is_budget
    is_complete = eq status, 5
    br is_complete -> L_JW_GOAL_STATUS_COMPLETE, L_JW_GOAL_STATUS_ACTIVE

L_JW_GOAL_STATUS_COMPLETE:
    !is_complete
    EXPAND JSON_WRITER_FIELD_STRING field_complete, writer, RPC_SESSION_JSON_KEY_STATUS, RPC_SESSION_JSON_KEY_STATUS_LEN, RPC_SESSION_J_GOAL_STATUS_COMPLETE, RPC_SESSION_J_GOAL_STATUS_COMPLETE_LEN
    !field_complete
    !writer
    !status
    return 0

L_JW_GOAL_STATUS_ACTIVE:
    !is_complete
    EXPAND JSON_WRITER_FIELD_STRING field_active, writer, RPC_SESSION_JSON_KEY_STATUS, RPC_SESSION_JSON_KEY_STATUS_LEN, RPC_SESSION_J_GOAL_STATUS_ACTIVE, RPC_SESSION_J_GOAL_STATUS_ACTIVE_LEN
    !field_active
    !writer
    !status
    return 0

@ffi_wrapper json_writer_field_goal_status_text(writer: ptr, status: u8, &status_ptr: ptr, status_len: u64) -> u32:
L_ENTRY:
    is_custom = eq status, 255
    br is_custom -> L_JW_GOAL_STATUS_TEXT_CUSTOM, L_JW_GOAL_STATUS_TEXT_KNOWN_DIRECT

L_JW_GOAL_STATUS_TEXT_CUSTOM:
    has_text = ugt status_len, 0
    br has_text -> L_JW_GOAL_STATUS_TEXT_WRITE, L_JW_GOAL_STATUS_TEXT_KNOWN_EMPTY

L_JW_GOAL_STATUS_TEXT_WRITE:
    !has_text
    !is_custom
    EXPAND JSON_WRITER_FIELD_STRING field_custom, writer, RPC_SESSION_JSON_KEY_STATUS, RPC_SESSION_JSON_KEY_STATUS_LEN, status_ptr, status_len
    !field_custom
    !writer
    !status
    !status_ptr
    !status_len
    return 0

L_JW_GOAL_STATUS_TEXT_KNOWN_EMPTY:
    !is_custom
    !has_text
    known_status_empty = call @json_writer_field_goal_status(writer, status)
    !known_status_empty
    !writer
    !status
    !status_ptr
    !status_len
    return 0

L_JW_GOAL_STATUS_TEXT_KNOWN_DIRECT:
    !is_custom
    known_status = call @json_writer_field_goal_status(writer, status)
    !known_status
    !writer
    !status
    !status_ptr
    !status_len
    return 0

@ffi_wrapper json_writer_field_goal_budget(writer: ptr, budget_null: u8, budget: i64) -> u32:
L_ENTRY:
    is_null = eq budget_null, 1
    br is_null -> L_JW_GOAL_BUDGET_NULL, L_JW_GOAL_BUDGET_VALUE

L_JW_GOAL_BUDGET_NULL:
    !is_null
    EXPAND JSON_WRITER_FIELD_NULL null_status, writer, RPC_SESSION_JSON_KEY_TOKEN_BUDGET, RPC_SESSION_JSON_KEY_TOKEN_BUDGET_LEN
    !null_status
    !writer
    !budget_null
    !budget
    return 0

L_JW_GOAL_BUDGET_VALUE:
    !is_null
    budget_status = call @sa_json_writer_field_i64(writer, &RPC_SESSION_JSON_KEY_TOKEN_BUDGET, RPC_SESSION_JSON_KEY_TOKEN_BUDGET_LEN, budget)
    !budget_status
    !writer
    !budget_null
    !budget
    return 0

@ffi_wrapper json_writer_field_u64_string(writer: ptr, &key: ptr, key_len: u64, value: u64) -> u32:
L_ENTRY:
    len_slot = stack_alloc 8
    tmp = call @u64_to_owned(value, &len_slot)
    fmt_len = load len_slot+0 as u64
    EXPAND JSON_WRITER_FIELD_STRING field_status, writer, key, key_len, tmp, fmt_len
    !field_status
    !fmt_len
    !tmp
    !writer
    !key
    !key_len
    !value
    return 0

@ffi_wrapper json_writer_write_u64_string(writer: ptr, value: u64) -> u32:
L_ENTRY:
    len_slot = stack_alloc 8
    tmp = call @u64_to_owned(value, &len_slot)
    fmt_len = load len_slot+0 as u64
    write_status = call @sa_json_writer_write_string(writer, &tmp, fmt_len)
    !write_status
    !fmt_len
    !tmp
    !writer
    !value
    return 0

@ffi_wrapper json_writer_field_nullable_string(writer: ptr, &key: ptr, key_len: u64, &value_ptr: ptr, value_len: u64, is_set: u8) -> u32:
L_ENTRY:
    has_value = eq is_set, 1
    br has_value -> L_JW_NULLABLE_STRING_VALUE, L_JW_NULLABLE_STRING_NULL

L_JW_NULLABLE_STRING_VALUE:
    !has_value
    EXPAND JSON_WRITER_FIELD_STRING field_status, writer, key, key_len, value_ptr, value_len
    !field_status
    !writer
    !key
    !key_len
    !value_ptr
    !value_len
    !is_set
    return 0

L_JW_NULLABLE_STRING_NULL:
    !has_value
    EXPAND JSON_WRITER_FIELD_NULL null_status, writer, key, key_len
    !null_status
    !writer
    !key
    !key_len
    !value_ptr
    !value_len
    !is_set
    return 0

@ffi_wrapper json_writer_field_nullable_thread_id_string(writer: ptr, &key: ptr, key_len: u64, &state_ptr: ptr, thread_id: u64) -> u32:
L_ENTRY:
    has_value = ne thread_id, 0
    br has_value -> L_JW_NULLABLE_TID_VALUE, L_JW_NULLABLE_TID_NULL

L_JW_NULLABLE_TID_VALUE:
    !has_value
    field_status = call @json_writer_field_thread_id_string(writer, &key, key_len, &state_ptr, thread_id)
    !field_status
    !writer
    !key
    !key_len
    !state_ptr
    !thread_id
    return 0

L_JW_NULLABLE_TID_NULL:
    !has_value
    EXPAND JSON_WRITER_FIELD_NULL null_status, writer, key, key_len
    !null_status
    !writer
    !key
    !key_len
    !state_ptr
    !thread_id
    return 0

@ffi_wrapper json_writer_write_thread_id_string(writer: ptr, &state_ptr: ptr, thread_id: u64) -> u32:
L_ENTRY:
    slot = call @state_thread_find(&state_ptr, thread_id)
    missing = eq slot, 0
    br missing -> L_JW_WRITE_TID_NUMERIC_MISSING, L_JW_WRITE_TID_SLOT

L_JW_WRITE_TID_SLOT:
    !missing
    stored_key_len = load slot+THR_KEY_LEN as u64
    has_key = ugt stored_key_len, 0
    br has_key -> L_JW_WRITE_TID_KEY, L_JW_WRITE_TID_NUMERIC_SLOT

L_JW_WRITE_TID_KEY:
    !has_key
    stored_key_ptr = ptr_add slot, THR_KEY
    write_status = call @sa_json_writer_write_string(writer, &stored_key_ptr, stored_key_len)
    !write_status
    !stored_key_ptr
    !stored_key_len
    !slot
    !writer
    !state_ptr
    !thread_id
    return 0

L_JW_WRITE_TID_NUMERIC_SLOT:
    !has_key
    !stored_key_len
    !slot
    jmp L_JW_WRITE_TID_NUMERIC

L_JW_WRITE_TID_NUMERIC_MISSING:
    !missing
    !slot
    jmp L_JW_WRITE_TID_NUMERIC

L_JW_WRITE_TID_NUMERIC:
    write_status2 = call @json_writer_write_u64_string(writer, thread_id)
    !write_status2
    !writer
    !state_ptr
    !thread_id
    return 0

@ffi_wrapper json_writer_field_mode_value(writer: ptr, &key: ptr, key_len: u64, mode: u8) -> u32:
L_ENTRY:
    is_plan = eq mode, 1
    br is_plan -> L_JW_MODE_PLAN, L_JW_MODE_GOAL_CHECK

L_JW_MODE_PLAN:
    !is_plan
    EXPAND JSON_WRITER_FIELD_STRING field_plan, writer, key, key_len, RPC_SESSION_FB_VALUE_PLAN, RPC_SESSION_FB_VALUE_PLAN_LEN
    !field_plan
    !writer
    !key
    !key_len
    !mode
    return 0

L_JW_MODE_GOAL_CHECK:
    !is_plan
    is_goal = eq mode, 2
    br is_goal -> L_JW_MODE_GOAL, L_JW_MODE_CODE_CHECK

L_JW_MODE_GOAL:
    !is_goal
    EXPAND JSON_WRITER_FIELD_STRING field_goal, writer, key, key_len, RPC_SESSION_FB_VALUE_GOAL, RPC_SESSION_FB_VALUE_GOAL_LEN
    !field_goal
    !writer
    !key
    !key_len
    !mode
    return 0

L_JW_MODE_CODE_CHECK:
    !is_goal
    is_code = eq mode, 3
    br is_code -> L_JW_MODE_CODE, L_JW_MODE_NULL

L_JW_MODE_CODE:
    !is_code
    EXPAND JSON_WRITER_FIELD_STRING field_code, writer, key, key_len, RPC_SESSION_FB_VALUE_CODE, RPC_SESSION_FB_VALUE_CODE_LEN
    !field_code
    !writer
    !key
    !key_len
    !mode
    return 0

L_JW_MODE_NULL:
    !is_code
    EXPAND JSON_WRITER_FIELD_NULL field_null, writer, key, key_len
    !field_null
    !writer
    !key
    !key_len
    !mode
    return 0

@ffi_wrapper json_writer_field_mode_text_or_value(writer: ptr, &key: ptr, key_len: u64, mode: u8, &mode_ptr: ptr, mode_len: u64) -> u32:
L_ENTRY:
    has_mode_text = ugt mode_len, 0
    br has_mode_text -> L_JW_MODE_TEXT, L_JW_MODE_VALUE

L_JW_MODE_TEXT:
    !has_mode_text
    EXPAND JSON_WRITER_FIELD_STRING field_text, writer, key, key_len, mode_ptr, mode_len
    !field_text
    !writer
    !key
    !key_len
    !mode
    !mode_ptr
    !mode_len
    return 0

L_JW_MODE_VALUE:
    !has_mode_text
    field_value = call @json_writer_field_mode_value(writer, &key, key_len, mode)
    !field_value
    !writer
    !key
    !key_len
    !mode
    !mode_ptr
    !mode_len
    return 0

@ffi_wrapper json_writer_field_thread_git_info(writer: ptr, &state_ptr: ptr, thread_id: u64) -> u32:
L_ENTRY:
    slot = call @state_thread_find(&state_ptr, thread_id)
    missing = eq slot, 0
    br missing -> L_JW_GITINFO_NULL_MISSING, L_JW_GITINFO_SLOT

L_JW_GITINFO_SLOT:
    !missing
    git_set = load slot+THR_GIT_SET as u8
    has_git = eq git_set, 1
    br has_git -> L_JW_GITINFO_VALUE, L_JW_GITINFO_NULL_SLOT

L_JW_GITINFO_VALUE:
    !has_git
    git_ptr = load slot+THR_GIT_PTR as ptr
    git_len = load slot+THR_GIT_LEN as u64
    has_len = ugt git_len, 0
    br has_len -> L_JW_GITINFO_PARSE, L_JW_GITINFO_VALUE_NULL

L_JW_GITINFO_PARSE:
    !has_len
    git_node = call @sa_json_parse(&git_ptr, git_len)
    has_node = ne git_node, 0
    br has_node -> L_JW_GITINFO_NODE, L_JW_GITINFO_BAD

L_JW_GITINFO_NODE:
    !has_node
    field_status = call @sa_json_writer_field_node(writer, &RPC_SESSION_JSON_KEY_GIT_INFO, RPC_SESSION_JSON_KEY_GIT_INFO_LEN, git_node)
    node_free = call @sa_json_free(^git_node)
    !node_free
    !field_status
    !git_ptr
    !git_len
    !git_set
    !slot
    !writer
    !state_ptr
    !thread_id
    return 0

L_JW_GITINFO_BAD:
    !has_node
    !git_node
    jmp L_JW_GITINFO_VALUE_NULL_AFTER

L_JW_GITINFO_VALUE_NULL:
    !has_len
    jmp L_JW_GITINFO_VALUE_NULL_AFTER

L_JW_GITINFO_VALUE_NULL_AFTER:
    EXPAND JSON_WRITER_FIELD_NULL null_status_value, writer, RPC_SESSION_JSON_KEY_GIT_INFO, RPC_SESSION_JSON_KEY_GIT_INFO_LEN
    !null_status_value
    !git_ptr
    !git_len
    !git_set
    !slot
    !writer
    !state_ptr
    !thread_id
    return 0

L_JW_GITINFO_NULL_SLOT:
    !has_git
    EXPAND JSON_WRITER_FIELD_NULL null_status_slot, writer, RPC_SESSION_JSON_KEY_GIT_INFO, RPC_SESSION_JSON_KEY_GIT_INFO_LEN
    !null_status_slot
    !git_set
    !slot
    !writer
    !state_ptr
    !thread_id
    return 0

L_JW_GITINFO_NULL_MISSING:
    !missing
    !slot
    EXPAND JSON_WRITER_FIELD_NULL null_status_missing, writer, RPC_SESSION_JSON_KEY_GIT_INFO, RPC_SESSION_JSON_KEY_GIT_INFO_LEN
    !null_status_missing
    !writer
    !state_ptr
    !thread_id
    return 0

@ffi_wrapper json_writer_field_items_or_empty(writer: ptr, &key: ptr, key_len: u64, &items_ptr: ptr, items_len: u64) -> u32:
L_ENTRY:
    has_items = ugt items_len, 0
    br has_items -> L_JW_ITEMS_PARSE, L_JW_ITEMS_EMPTY

L_JW_ITEMS_PARSE:
    !has_items
    items_node = call @sa_json_parse(&items_ptr, items_len)
    has_node = ne items_node, 0
    br has_node -> L_JW_ITEMS_NODE, L_JW_ITEMS_BAD

L_JW_ITEMS_NODE:
    !has_node
    field_status = call @sa_json_writer_field_node(writer, &key, key_len, items_node)
    node_free = call @sa_json_free(^items_node)
    !node_free
    !field_status
    !items_ptr
    !items_len
    !writer
    !key
    !key_len
    return 0

L_JW_ITEMS_BAD:
    !has_node
    !items_node
    jmp L_JW_ITEMS_EMPTY_AFTER

L_JW_ITEMS_EMPTY:
    !has_items
    jmp L_JW_ITEMS_EMPTY_AFTER

L_JW_ITEMS_EMPTY_AFTER:
    field_status_empty = call @json_writer_field_empty_array(writer, &key, key_len)
    !field_status_empty
    !items_ptr
    !items_len
    !writer
    !key
    !key_len
    return 0

@ffi_wrapper json_writer_write_thread_object(writer: ptr, &state_ptr: ptr, tid: u64, forked_from_id: u64, &preview_ptr: ptr, preview_len: u64, &provider_ptr: ptr, provider_len: u64, ephemeral: u8, &model_ptr: ptr, model_len: u64, &dir_ptr: ptr, dir_len: u64, &name_ptr: ptr, name_len: u64, name_set: u8, include_empty_turns: u8) -> u32:
L_ENTRY:
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    id_status = call @json_writer_field_thread_id_string(writer, &RPC_SESSION_RPC_KEY_ID, RPC_SESSION_RPC_KEY_ID_LEN, &state_ptr, tid)
    session_status = call @json_writer_field_thread_id_string(writer, &RPC_SESSION_JSON_KEY_SESSION_ID, RPC_SESSION_JSON_KEY_SESSION_ID_LEN, &state_ptr, tid)
    fork_status = call @json_writer_field_nullable_thread_id_string(writer, &RPC_SESSION_JSON_KEY_FORKED_FROM_ID, RPC_SESSION_JSON_KEY_FORKED_FROM_ID_LEN, &state_ptr, forked_from_id)
    EXPAND JSON_WRITER_FIELD_STRING preview_status, writer, RPC_SESSION_JSON_KEY_PREVIEW, RPC_SESSION_JSON_KEY_PREVIEW_LEN, preview_ptr, preview_len
    EXPAND JSON_WRITER_FIELD_BOOL ephemeral_status, writer, RPC_SESSION_JSON_KEY_EPHEMERAL, RPC_SESSION_JSON_KEY_EPHEMERAL_LEN, ephemeral
    EXPAND JSON_WRITER_FIELD_STRING provider_status, writer, RPC_SESSION_JSON_KEY_MODEL_PROVIDER, RPC_SESSION_JSON_KEY_MODEL_PROVIDER_LEN, provider_ptr, provider_len
    EXPAND JSON_WRITER_FIELD_STRING model_status, writer, RPC_SESSION_JSON_KEY_MODEL, RPC_SESSION_JSON_KEY_MODEL_LEN, model_ptr, model_len
    now_i = call @sa_time_unix_s()
    created_status = call @sa_json_writer_field_i64(writer, &RPC_SESSION_JSON_KEY_CREATED_AT, RPC_SESSION_JSON_KEY_CREATED_AT_LEN, now_i)
    updated_status = call @sa_json_writer_field_i64(writer, &RPC_SESSION_JSON_KEY_UPDATED_AT, RPC_SESSION_JSON_KEY_UPDATED_AT_LEN, now_i)
    status_begin = call @json_writer_begin_field_object(writer, &RPC_SESSION_JSON_KEY_STATUS, RPC_SESSION_JSON_KEY_STATUS_LEN)
    EXPAND JSON_WRITER_FIELD_STRING type_status, writer, RPC_SESSION_FB_KEY_TYPE, RPC_SESSION_FB_KEY_TYPE_LEN, RPC_SESSION_JSON_VALUE_IDLE, RPC_SESSION_JSON_VALUE_IDLE_LEN
    EXPAND JSON_WRITER_END_OBJECT status_end, writer
    EXPAND JSON_WRITER_FIELD_NULL path_status, writer, RPC_SESSION_JSON_KEY_PATH, RPC_SESSION_JSON_KEY_PATH_LEN
    EXPAND JSON_WRITER_FIELD_STRING cwd_status, writer, RPC_SESSION_JSON_KEY_CWD, RPC_SESSION_JSON_KEY_CWD_LEN, dir_ptr, dir_len
    EXPAND JSON_WRITER_FIELD_STRING cli_status, writer, RPC_SESSION_JSON_KEY_CLI_VERSION, RPC_SESSION_JSON_KEY_CLI_VERSION_LEN, RPC_SESSION_JSON_VALUE_HUBPROXY_CLI, RPC_SESSION_JSON_VALUE_HUBPROXY_CLI_LEN
    EXPAND JSON_WRITER_FIELD_STRING source_status, writer, RPC_SESSION_JSON_KEY_SOURCE, RPC_SESSION_JSON_KEY_SOURCE_LEN, RPC_SESSION_JSON_VALUE_APP_SERVER, RPC_SESSION_JSON_VALUE_APP_SERVER_LEN
    EXPAND JSON_WRITER_FIELD_NULL thread_source_status, writer, RPC_SESSION_JSON_KEY_THREAD_SOURCE, RPC_SESSION_JSON_KEY_THREAD_SOURCE_LEN
    EXPAND JSON_WRITER_FIELD_NULL nickname_status, writer, RPC_SESSION_JSON_KEY_AGENT_NICKNAME, RPC_SESSION_JSON_KEY_AGENT_NICKNAME_LEN
    EXPAND JSON_WRITER_FIELD_NULL role_status, writer, RPC_SESSION_JSON_KEY_AGENT_ROLE, RPC_SESSION_JSON_KEY_AGENT_ROLE_LEN
    git_status = call @json_writer_field_thread_git_info(writer, &state_ptr, tid)
    name_status = call @json_writer_field_nullable_string(writer, &RPC_SESSION_JSON_KEY_NAME, RPC_SESSION_JSON_KEY_NAME_LEN, &name_ptr, name_len, name_set)
    include_turns = eq include_empty_turns, 1
    br include_turns -> L_JW_THREAD_WITH_EMPTY_TURNS, L_JW_THREAD_DYNAMIC_CHECK

L_JW_THREAD_WITH_EMPTY_TURNS:
    !include_turns
    turns_status = call @json_writer_field_empty_array(writer, &RPC_SESSION_JSON_KEY_TURNS, RPC_SESSION_JSON_KEY_TURNS_LEN)
    !turns_status
    jmp L_JW_THREAD_CLOSE_AFTER_TURNS

L_JW_THREAD_DYNAMIC_CHECK:
    !include_turns
    dynamic_turns = eq include_empty_turns, 2
    br dynamic_turns -> L_JW_THREAD_WITH_DYNAMIC_TURNS, L_JW_THREAD_CLOSE

L_JW_THREAD_WITH_DYNAMIC_TURNS:
    !dynamic_turns
    dynamic_status = call @json_writer_write_thread_turns_array(writer, &state_ptr, tid)
    !dynamic_status
    jmp L_JW_THREAD_CLOSE_AFTER_TURNS

L_JW_THREAD_CLOSE:
    !dynamic_turns
    jmp L_JW_THREAD_CLOSE_AFTER_TURNS

L_JW_THREAD_CLOSE_AFTER_TURNS:
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    !end_status
    !name_status
    !git_status
    !role_status
    !nickname_status
    !thread_source_status
    !source_status
    !cli_status
    !cwd_status
    !path_status
    !status_end
    !type_status
    !status_begin
    !updated_status
    !created_status
    !now_i
    !model_status
    !provider_status
    !ephemeral_status
    !preview_status
    !fork_status
    !session_status
    !id_status
    !begin_status
    !writer
    !state_ptr
    !tid
    !forked_from_id
    !preview_ptr
    !preview_len
    !provider_ptr
    !provider_len
    !ephemeral
    !model_ptr
    !model_len
    !dir_ptr
    !dir_len
    !name_ptr
    !name_len
    !name_set
    !include_empty_turns
    return 0

@ffi_wrapper json_writer_write_thread_object_field(writer: ptr, &key: ptr, key_len: u64, &state_ptr: ptr, tid: u64, forked_from_id: u64, &preview_ptr: ptr, preview_len: u64, &provider_ptr: ptr, provider_len: u64, ephemeral: u8, &model_ptr: ptr, model_len: u64, &dir_ptr: ptr, dir_len: u64, &name_ptr: ptr, name_len: u64, name_set: u8, include_empty_turns: u8) -> u32:
L_ENTRY:
    field_status = call @sa_json_writer_object_field(writer, &key, key_len)
    thread_status = call @json_writer_write_thread_object(writer, &state_ptr, tid, forked_from_id, &preview_ptr, preview_len, &provider_ptr, provider_len, ephemeral, &model_ptr, model_len, &dir_ptr, dir_len, &name_ptr, name_len, name_set, include_empty_turns)
