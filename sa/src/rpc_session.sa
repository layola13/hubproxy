    return 0

@ffi_wrapper notify_turn_started(&state_ptr: ptr, thread_id: u64, turn_id: u64) -> u32:
L_ENTRY:
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    thread_status = call @json_writer_field_thread_id_string(writer, &RPC_SESSION_JSON_KEY_THREAD_ID, RPC_SESSION_JSON_KEY_THREAD_ID_LEN, &state_ptr, thread_id)
    slot = call @state_turn_find(&state_ptr, thread_id, turn_id)
    missing = eq slot, 0
    br missing -> L_NOTIFY_TURN_STARTED_APPEND_NULL_MODE, L_NOTIFY_TURN_STARTED_APPEND_MODE

L_NOTIFY_TURN_STARTED_APPEND_MODE:
    !missing
    mode = load slot+TURN_MODE as u8
    turn_status = load slot+TURN_STATUS as u8
    mode_ptr = ptr_add slot, TURN_MODE_TEXT
    mode_len = load slot+TURN_MODE_LEN as u64
    items_ptr = ptr_add slot, TURN_ITEMS
    items_len = load slot+TURN_ITEMS_LEN as u64
    created = load slot+TURN_CREATED as u64
    updated = load slot+TURN_UPDATED as u64
    completed = load slot+TURN_COMPLETED as u64
    write_status = call @json_writer_write_turn_object_field(writer, &RPC_SESSION_JSON_KEY_TURN, RPC_SESSION_JSON_KEY_TURN_LEN, turn_id, turn_status, mode, created, updated, completed, &mode_ptr, mode_len, &items_ptr, items_len)
    !write_status
    !completed
    !updated
    !created
    !items_ptr
    !items_len
    !mode_ptr
    !mode_len
    !turn_status
    !mode
    !slot
    jmp L_NOTIFY_TURN_STARTED_CLOSE

L_NOTIFY_TURN_STARTED_APPEND_NULL_MODE:
    !missing
    !slot
    empty_ptr2 = &RPC_SESSION_EMPTY_TEXT
    now_empty_i = call @sa_time_unix_s()
    now_empty_u = bitcast now_empty_i as u64
    write_status2 = call @json_writer_write_turn_object_field(writer, &RPC_SESSION_JSON_KEY_TURN, RPC_SESSION_JSON_KEY_TURN_LEN, turn_id, 1, 0, now_empty_u, now_empty_u, 0, &empty_ptr2, 0, &empty_ptr2, 0)
    !write_status2
    !now_empty_u
    !now_empty_i
    !empty_ptr2
    jmp L_NOTIFY_TURN_STARTED_CLOSE

L_NOTIFY_TURN_STARTED_CLOSE:
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    call @notify_writer_params(&state_ptr, &RPC_SESSION_EV_TURN_STARTED, RPC_SESSION_EV_TURN_STARTED_LEN, writer)
    !end_status
    !thread_status
    !begin_status
    !writer_status
    !thread_id
    !turn_id
    !state_ptr
    return 0

@ffi_wrapper notify_turn_completed(&state_ptr: ptr, thread_id: u64, turn_id: u64) -> u32:
L_ENTRY:
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    thread_status = call @json_writer_field_thread_id_string(writer, &RPC_SESSION_JSON_KEY_THREAD_ID, RPC_SESSION_JSON_KEY_THREAD_ID_LEN, &state_ptr, thread_id)
    slot = call @state_turn_find(&state_ptr, thread_id, turn_id)
    missing = eq slot, 0
    br missing -> L_NOTIFY_TURN_COMPLETED_EMPTY, L_NOTIFY_TURN_COMPLETED_SLOT

L_NOTIFY_TURN_COMPLETED_SLOT:
    !missing
    mode = load slot+TURN_MODE as u8
    mode_ptr = ptr_add slot, TURN_MODE_TEXT
    mode_len = load slot+TURN_MODE_LEN as u64
    items_ptr = ptr_add slot, TURN_ITEMS
    items_len = load slot+TURN_ITEMS_LEN as u64
    created = load slot+TURN_CREATED as u64
    updated = load slot+TURN_UPDATED as u64
    completed = load slot+TURN_COMPLETED as u64
    turn_status = call @json_writer_write_turn_object_field(writer, &RPC_SESSION_JSON_KEY_TURN, RPC_SESSION_JSON_KEY_TURN_LEN, turn_id, 2, mode, created, updated, completed, &mode_ptr, mode_len, &items_ptr, items_len)
    !turn_status
    !completed
    !updated
    !created
    !items_ptr
    !items_len
    !mode_ptr
    !mode_len
    !mode
    !slot
    jmp L_NOTIFY_TURN_COMPLETED_CLOSE

L_NOTIFY_TURN_COMPLETED_EMPTY:
    !missing
    !slot
    empty_ptr = &RPC_SESSION_EMPTY_TEXT
    now_empty_i = call @sa_time_unix_s()
    now_empty_u = bitcast now_empty_i as u64
    turn_status_empty = call @json_writer_write_turn_object_field(writer, &RPC_SESSION_JSON_KEY_TURN, RPC_SESSION_JSON_KEY_TURN_LEN, turn_id, 2, 0, now_empty_u, now_empty_u, now_empty_u, &empty_ptr, 0, &empty_ptr, 0)
    !turn_status_empty
    !now_empty_u
    !now_empty_i
    !empty_ptr
    jmp L_NOTIFY_TURN_COMPLETED_CLOSE

L_NOTIFY_TURN_COMPLETED_CLOSE:
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    call @notify_writer_params(&state_ptr, &RPC_SESSION_EV_TURN_COMPLETED, RPC_SESSION_EV_TURN_COMPLETED_LEN, writer)
    !end_status
    !thread_status
    !begin_status
    !writer_status
    !thread_id
    !turn_id
    !state_ptr
    return 0

@ffi_wrapper notify_turn_diff(&state_ptr: ptr, thread_id: u64, turn_id: u64) -> u32:
L_ENTRY:
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    thread_status = call @json_writer_field_thread_id_string(writer, &RPC_SESSION_JSON_KEY_THREAD_ID, RPC_SESSION_JSON_KEY_THREAD_ID_LEN, &state_ptr, thread_id)
    turn_status = call @json_writer_field_u64_string(writer, &RPC_SESSION_JSON_KEY_TURN_ID, RPC_SESSION_JSON_KEY_TURN_ID_LEN, turn_id)
    EXPAND JSON_WRITER_FIELD_STRING diff_status, writer, RPC_SESSION_JSON_KEY_DIFF, RPC_SESSION_JSON_KEY_DIFF_LEN, RPC_SESSION_EMPTY_TEXT, RPC_SESSION_EMPTY_TEXT_LEN
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    call @notify_writer_params(&state_ptr, &RPC_SESSION_EV_TURN_DIFF, RPC_SESSION_EV_TURN_DIFF_LEN, writer)
