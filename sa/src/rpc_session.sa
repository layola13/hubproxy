L_ENTRY:
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    thread_status = call @json_writer_field_thread_id_goal_key(writer, &RPC_SESSION_JSON_KEY_THREAD_ID, RPC_SESSION_JSON_KEY_THREAD_ID_LEN, &state_ptr, thread_id, &goal_key_ptr, goal_key_len)
    goal_begin_status = call @json_writer_begin_field_object(writer, &RPC_SESSION_JSON_KEY_GOAL, RPC_SESSION_JSON_KEY_GOAL_LEN)
    goal_thread_status = call @json_writer_field_thread_id_goal_key(writer, &RPC_SESSION_JSON_KEY_THREAD_ID, RPC_SESSION_JSON_KEY_THREAD_ID_LEN, &state_ptr, thread_id, &goal_key_ptr, goal_key_len)
    EXPAND JSON_WRITER_FIELD_STRING objective_status, writer, RPC_SESSION_JSON_KEY_OBJECTIVE, RPC_SESSION_JSON_KEY_OBJECTIVE_LEN, obj_ptr, obj_len
    status_field = call @json_writer_field_goal_status_text(writer, status, &status_ptr, status_len)
    budget_status = call @json_writer_field_goal_budget(writer, budget_null, budget)
    used_i64 = bitcast used as i64
    EXPAND JSON_WRITER_FIELD_I64 used_status, writer, RPC_SESSION_JSON_KEY_TOKENS_USED, RPC_SESSION_JSON_KEY_TOKENS_USED_LEN, used_i64
    EXPAND JSON_WRITER_FIELD_I64 time_status, writer, RPC_SESSION_JSON_KEY_TIME_USED_SECONDS, RPC_SESSION_JSON_KEY_TIME_USED_SECONDS_LEN, 0
    created_i = bitcast created as i64
    updated_i = bitcast updated as i64
    EXPAND JSON_WRITER_FIELD_I64 created_status, writer, RPC_SESSION_JSON_KEY_CREATED_AT, RPC_SESSION_JSON_KEY_CREATED_AT_LEN, created_i
    EXPAND JSON_WRITER_FIELD_I64 updated_status, writer, RPC_SESSION_JSON_KEY_UPDATED_AT, RPC_SESSION_JSON_KEY_UPDATED_AT_LEN, updated_i
    EXPAND JSON_WRITER_END_OBJECT goal_end_status, writer
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
