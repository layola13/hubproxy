    r_sse_body_status = call @http_response_read_all(r_out_resp, &r_sse_body_ptr_slot, &r_sse_body_len_slot)
    r_sse_body_ptr = load r_sse_body_ptr_slot+0 as ptr
    r_sse_body_len = load r_sse_body_len_slot+0 as u64
    r_norm_len_slot = stack_alloc 8
    r_ctx_len_slot = stack_alloc 8
    r_ctx_body = call @build_response_request_context_body(&req, &state_ptr, &r_body_ptr, r_body_len, &r_ctx_len_slot)
    r_ctx_len = load r_ctx_len_slot+0 as u64
    r_norm_body = call @normalize_responses_client_sse_body(&r_sse_body_ptr, r_sse_body_len, &r_ctx_body, r_ctx_len, &r_norm_len_slot)
    r_norm_len = load r_norm_len_slot+0 as u64
    r_write_status = call @sa_http_server_resp_stream_write(r_stream, &r_norm_body, r_norm_len)
    r_flush_status = call @sa_http_server_resp_stream_flush(r_stream)
    !r_write_status
    !r_flush_status
    r_end_status = call @sa_http_server_resp_stream_end(r_stream)
    !r_end_status
    call @sa_http_client_resp_free(^r_out_resp)
    call @sa_http_client_req_free(^r_out_req)
    call @sa_http_client_free(^r_client)
    call @sa_http_server_resp_stream_free(^r_stream)
    !r_norm_body
    !r_norm_len
    !r_ctx_body
    !r_ctx_len
    !r_sse_body_status
    !r_sse_body_ptr
    !r_sse_body_len
    !r_proxy_body_ptr
    !r_proxy_body_len
    !r_upstream_ptr
    !r_base_ptr
    !r_base_len
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    call @sa_http_server_req_free(^req)
    !state_ptr
    !cfg_ptr
    return 0
@accept_and_handle_http_request(server: ptr, &req_slot: ptr, &state_ptr: ptr, &cfg_ptr: ptr) -> u32:
L_ENTRY:
    accept_status = call @sa_http_server_accept(server, &req_slot)
    accept_ok = eq accept_status, 0
    !accept_status
    br accept_ok -> L_ACCEPT_OK, L_ACCEPT_SKIP

L_ACCEPT_SKIP:
    return 0

L_ACCEPT_OK:
    req = load req_slot+0 as ptr
    has_req = ne req, 0
    br has_req -> L_HANDLE, L_NO_REQ

L_NO_REQ:
    return 0

L_HANDLE:
    handle_status = call @handle_http_request(^req, &state_ptr, &cfg_ptr)
    !handle_status
    return 0

// ============================================================
// @main — Entry point
// ============================================================
@handle_http_request(^req: ptr, &state_ptr: ptr, &cfg_ptr: ptr) -> u32:
L_ENTRY:
    method_ptr_slot = stack_alloc 8
    method_len_slot = stack_alloc 8
    path_ptr_slot = stack_alloc 8
    path_len_slot = stack_alloc 8

    method_status = call @sa_http_server_req_get_method(req, &method_ptr_slot, &method_len_slot)
    method_ptr = load method_ptr_slot+0 as ptr
    method_len = load method_len_slot+0 as u64
    !method_status

    // Extract request path before auth so health endpoints stay public.
    path_status = call @sa_http_server_req_get_path(req, &path_ptr_slot, &path_len_slot)
    path_ptr = load path_ptr_slot+0 as ptr
    path_len = load path_len_slot+0 as u64
    !path_status

    is_get_raw = call @sa_bytes_eq(&method_ptr, method_len, &HTTPD_METHOD_GET, HTTPD_METHOD_GET_LEN)
    is_get = eq is_get_raw, 1
    !is_get_raw
    is_post_raw = call @sa_bytes_eq(&method_ptr, method_len, &HTTPD_METHOD_POST, HTTPD_METHOD_POST_LEN)
    is_post = eq is_post_raw, 1
    !is_post_raw

    // --- Route: /healthz ---
    is_health = call @sa_bytes_eq(&path_ptr, path_len, &HTTPD_ROUTE_HEALTH, HTTPD_ROUTE_HEALTH_LEN)
    is_health_path = eq is_health, 1
    is_health_ok = and is_health_path, is_get
    !is_health
    !is_health_path
    br is_health_ok -> L_HEALTH, L_CHECK_READY

L_CHECK_READY:
    !is_health_ok
    is_ready = call @sa_bytes_eq(&path_ptr, path_len, &HTTPD_ROUTE_READY, HTTPD_ROUTE_READY_LEN)
    is_ready_path = eq is_ready, 1
    is_ready_ok = and is_ready_path, is_get
    !is_ready
    !is_ready_path
    br is_ready_ok -> L_READY, L_CHECK_PUBLIC_MODELS

L_CHECK_PUBLIC_MODELS:
    !is_ready_ok
    is_models_public = call @sa_bytes_eq(&path_ptr, path_len, &HTTPD_ROUTE_MODELS, HTTPD_ROUTE_MODELS_LEN)
    is_models_public_path = eq is_models_public, 1
    is_models_public_ok = and is_models_public_path, is_get
    !is_models_public
    !is_models_public_path
    br is_models_public_ok -> L_PROXY_MODELS_PUBLIC, L_AUTH_PREP

L_AUTH_PREP:
    !is_models_public_ok
    // --- Auth interceptor (for all non-health routes) ---
    auth_token_ptr = load cfg_ptr+CFG_AUTH_PTR as ptr
    auth_token_len = load cfg_ptr+CFG_AUTH_LEN as u64
    auth_ok = call @check_auth(&req, &auth_token_ptr, auth_token_len)
    is_authed = eq auth_ok, 1
    !auth_ok
    br is_authed -> L_AUTHED, L_NO_AUTH

L_NO_AUTH:
    !is_authed
    noauth_chat_raw = call @sa_bytes_eq(&path_ptr, path_len, &HTTPD_ROUTE_CHAT, HTTPD_ROUTE_CHAT_LEN)
    noauth_chat = eq noauth_chat_raw, 1
    !noauth_chat_raw
    noauth_resp_raw = call @sa_bytes_eq(&path_ptr, path_len, &HTTPD_ROUTE_RESP, HTTPD_ROUTE_RESP_LEN)
    noauth_resp = eq noauth_resp_raw, 1
    !noauth_resp_raw
    noauth_v1 = or noauth_chat, noauth_resp
    !noauth_chat
    !noauth_resp
    noauth_rpc_raw = call @sa_bytes_eq(&path_ptr, path_len, &HTTPD_ROUTE_RPC, HTTPD_ROUTE_RPC_LEN)
    noauth_rpc = eq noauth_rpc_raw, 1
    !noauth_rpc_raw
    noauth_api = or noauth_v1, noauth_rpc
    !noauth_v1
    !noauth_rpc
    noauth_body_ptr_slot = stack_alloc 8
    noauth_body_len_slot = stack_alloc 8
    br noauth_api -> L_NO_AUTH_API_LOG, L_NO_AUTH_SKIP_API_LOG

L_NO_AUTH_API_LOG:
    !noauth_api
    noauth_body_status = call @sa_http_server_req_get_body(req, &noauth_body_ptr_slot, &noauth_body_len_slot)
    noauth_body_ptr = load noauth_body_ptr_slot+0 as ptr
    noauth_body_len = load noauth_body_len_slot+0 as u64
    noauth_req_log_status = call @write_api_request_log(&req, &cfg_ptr, &path_ptr, path_len, &method_ptr, method_len, &noauth_body_ptr, noauth_body_len)
    !noauth_req_log_status
    !noauth_body_status
    !noauth_body_ptr
    !noauth_body_len
    jmp L_NO_AUTH_WRITE_AUTH_LOG

L_NO_AUTH_SKIP_API_LOG:
    !noauth_api
    jmp L_NO_AUTH_WRITE_AUTH_LOG

L_NO_AUTH_WRITE_AUTH_LOG:
    auth_log_status = call @write_auth_failure_log(&req, &cfg_ptr, &path_ptr, path_len, &auth_token_ptr, auth_token_len)
    !auth_log_status
    !auth_token_ptr
    !auth_token_len
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    call @send_json_error_string_response(&req, 401, &HTTPD_JSON_VALUE_UNAUTHORIZED, HTTPD_JSON_VALUE_UNAUTHORIZED_LEN)
    call @sa_http_server_req_free(^req)
    !state_ptr
    !cfg_ptr
    return 0

L_AUTHED:
    !is_authed
    !auth_token_ptr
    !auth_token_len

L_CHECK_CHAT:
    is_chat = call @sa_bytes_eq(&path_ptr, path_len, &HTTPD_ROUTE_CHAT, HTTPD_ROUTE_CHAT_LEN)
    is_chat_path = eq is_chat, 1
    is_chat_ok = and is_chat_path, is_post
    !is_chat
    !is_chat_path
    br is_chat_ok -> L_PROXY_CHAT, L_CHECK_RESP

L_CHECK_RESP:
    !is_chat_ok
    is_resp = call @sa_bytes_eq(&path_ptr, path_len, &HTTPD_ROUTE_RESP, HTTPD_ROUTE_RESP_LEN)
    is_resp_path = eq is_resp, 1
    is_resp_ok = and is_resp_path, is_post
    !is_resp
    !is_resp_path
    br is_resp_ok -> L_PROXY_RESP, L_CHECK_MODELS

L_CHECK_MODELS:
    !is_resp_ok
    is_models = call @sa_bytes_eq(&path_ptr, path_len, &HTTPD_ROUTE_MODELS, HTTPD_ROUTE_MODELS_LEN)
    is_models_path = eq is_models, 1
    is_models_ok = and is_models_path, is_get
    !is_models
    !is_models_path
    br is_models_ok -> L_PROXY_MODELS, L_CHECK_RPC

L_CHECK_RPC:
    !is_models_ok
    is_rpc = call @sa_bytes_eq(&path_ptr, path_len, &HTTPD_ROUTE_RPC, HTTPD_ROUTE_RPC_LEN)
    is_rpc_path = eq is_rpc, 1
    is_rpc_ok = and is_rpc_path, is_post
    !is_rpc
    !is_rpc_path
    br is_rpc_ok -> L_HANDLE_RPC, L_CHECK_EVENTS

L_CHECK_EVENTS:
    !is_rpc_ok
    is_events = call @sa_bytes_eq(&path_ptr, path_len, &HTTPD_ROUTE_EVENTS, HTTPD_ROUTE_EVENTS_LEN)
    is_events_path = eq is_events, 1
    is_events_ok = and is_events_path, is_get
    !is_events
    !is_events_path
    br is_events_ok -> L_HANDLE_EVENTS, L_NOT_FOUND

L_PROXY_MODELS_PUBLIC:
    is_models_ok = eq is_models_public_ok, 1
    !is_models_public_ok
    jmp L_PROXY_MODELS

// ============================================================
// /healthz and /readyz — Simple 200 OK
// ============================================================
L_HEALTH:
    !is_health_ok
    call @sa_print_bytes(&HTTPD_LOG_HEALTH, HTTPD_LOG_HEALTH_LEN)
    h_send = call @send_json_bool_field_response(&req, 200, &HTTPD_JSON_KEY_OK, HTTPD_JSON_KEY_OK_LEN, 1)
    !h_send
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    call @sa_http_server_req_free(^req)
    !state_ptr
    !cfg_ptr
    return 0

L_READY:
    !is_ready_ok
    call @sa_print_bytes(&HTTPD_LOG_HEALTH, HTTPD_LOG_HEALTH_LEN)
    rdy_send = call @send_json_bool_field_response(&req, 200, &HTTPD_JSON_KEY_OK, HTTPD_JSON_KEY_OK_LEN, 1)
    !rdy_send
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    call @sa_http_server_req_free(^req)
    !state_ptr
    !cfg_ptr
    return 0

// ============================================================
// /v1/chat/completions — Reverse proxy with SSE streaming
// + Token metering from SSE chunks
// ============================================================
L_PROXY_CHAT:
    !is_chat_ok
    chat_status = call @handle_chat_proxy(&req, &state_ptr, &cfg_ptr, &path_ptr, path_len, &method_ptr, method_len, is_get, is_post)
    !chat_status
    return 0

// ============================================================
// /v1/responses — Reverse proxy with streaming
// ============================================================
L_PROXY_RESP:
    !is_resp_ok
    resp_status = call @handle_responses_proxy(&req, &state_ptr, &cfg_ptr, &path_ptr, path_len, &method_ptr, method_len, is_get, is_post)
    !resp_status
    return 0

// ============================================================
// /v1/models — Proxy to upstream models endpoint
// ============================================================
L_PROXY_MODELS:
    !is_models_ok
    models_status = call @handle_models_proxy(&req, &cfg_ptr, &path_ptr, path_len, &method_ptr, method_len)
    !models_status
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    call @sa_http_server_req_free(^req)
    !state_ptr
    !cfg_ptr
    return 0

// ============================================================
// /rpc — JSON-RPC dispatch (20+ methods)
// ============================================================
L_HANDLE_RPC:
    !is_rpc_ok
    call @sa_print_bytes(&HTTPD_LOG_RPC, HTTPD_LOG_RPC_LEN)

    rpc_raw_ptr_slot = stack_alloc 8
    rpc_raw_len_slot = stack_alloc 8
    rpc_body_ptr_slot = stack_alloc 8
    rpc_body_len_slot = stack_alloc 8
    rpc_canon_buffer_slot = stack_alloc 8
    rpc_body_status = call @sa_http_server_req_get_body(req, &rpc_raw_ptr_slot, &rpc_raw_len_slot)
    rpc_raw_ptr = load rpc_raw_ptr_slot+0 as ptr
    rpc_raw_len = load rpc_raw_len_slot+0 as u64
    rpc_log_status = call @write_api_request_log(&req, &cfg_ptr, &path_ptr, path_len, &method_ptr, method_len, &rpc_raw_ptr, rpc_raw_len)
    !rpc_log_status
    rpc_canon_status = call @rpc_canonicalize_body(&rpc_raw_ptr, rpc_raw_len, &rpc_body_ptr_slot, &rpc_body_len_slot, &rpc_canon_buffer_slot)
    !rpc_canon_status
    rpc_body_ptr = load rpc_body_ptr_slot+0 as ptr
    rpc_body_len = load rpc_body_len_slot+0 as u64

    rpc_dispatch_status = call @handle_rpc_request(&req, &rpc_body_ptr, rpc_body_len, &state_ptr, &cfg_ptr)
    !rpc_dispatch_status
    rpc_canon_buffer = load rpc_canon_buffer_slot+0 as ptr
    has_rpc_canon_buffer = ne rpc_canon_buffer, 0
    br has_rpc_canon_buffer -> L_RPC_FREE_CANON_BODY, L_RPC_NO_CANON_BODY

L_RPC_FREE_CANON_BODY:
    !has_rpc_canon_buffer
    rpc_canon_dispose = call @json_buffer_dispose(rpc_canon_buffer)
    !rpc_canon_dispose
    !rpc_canon_buffer
    jmp L_RPC_AFTER_CANON_BODY

L_RPC_NO_CANON_BODY:
    !has_rpc_canon_buffer
    !rpc_canon_buffer
    jmp L_RPC_AFTER_CANON_BODY

L_RPC_AFTER_CANON_BODY:
    !rpc_body_status
    !rpc_raw_ptr
    !rpc_raw_len
    !rpc_body_ptr
    !rpc_body_len
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    call @sa_http_server_req_free(^req)
    !state_ptr
    !cfg_ptr
    return 0

// ============================================================
// /events — SSE notification stream
// ============================================================
L_HANDLE_EVENTS:
    !is_events_ok
    call @sa_print_bytes(&HTTPD_LOG_EVENTS, HTTPD_LOG_EVENTS_LEN)

    ev_ctx = alloc EVENT_CTX_SIZE
    store ev_ctx+EVENT_CTX_REQ, req as ptr
    store ev_ctx+EVENT_CTX_STATE, state_ptr as ptr
    call @spawn_event_stream(^ev_ctx)
    !req
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    !state_ptr
    !cfg_ptr
    return 0

// ============================================================
// 404 Not Found
// ============================================================
L_NOT_FOUND:
    !is_events_ok
    nf_send = call @send_json_error_string_response(&req, 404, &HTTPD_JSON_VALUE_NOT_FOUND, HTTPD_JSON_VALUE_NOT_FOUND_LEN)
    !nf_send
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    call @sa_http_server_req_free(^req)
    !state_ptr
    !cfg_ptr
    return 0
