L_ENTRY:
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    EXPAND JSON_WRITER_FIELD_BOOL refreshed_status, writer, RPC_SYS_JSON_KEY_REFRESHED, RPC_SYS_JSON_KEY_REFRESHED_LEN, 1
    EXPAND JSON_WRITER_FIELD_STRING refreshed_at_status, writer, RPC_SYS_JSON_KEY_REFRESHED_AT, RPC_SYS_JSON_KEY_REFRESHED_AT_LEN, iso_ptr, iso_len
