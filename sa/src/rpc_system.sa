@ffi_wrapper json_writer_write_account_read_result(writer: ptr, &plan_ptr: ptr, plan_len: u64, &email_ptr: ptr, email_len: u64) -> u32:
L_ENTRY:
    selected_plan_ptr_slot = stack_alloc 8
    selected_plan_len_slot = stack_alloc 8
    selected_email_ptr_slot = stack_alloc 8
    selected_email_len_slot = stack_alloc 8
    has_plan = ugt plan_len, 0
    br has_plan -> L_ACCOUNT_SELECT_PLAN_CFG, L_ACCOUNT_SELECT_PLAN_DEFAULT

L_ACCOUNT_SELECT_PLAN_CFG:
    !has_plan
    store selected_plan_ptr_slot+0, plan_ptr as ptr
    store selected_plan_len_slot+0, plan_len as u64
    jmp L_ACCOUNT_AFTER_PLAN

L_ACCOUNT_SELECT_PLAN_DEFAULT:
    !has_plan
    default_plan_ptr = &RPC_SYS_DEFAULT_PLAN_PLUS
    store selected_plan_ptr_slot+0, default_plan_ptr as ptr
    store selected_plan_len_slot+0, RPC_SYS_DEFAULT_PLAN_PLUS_LEN as u64
    !default_plan_ptr
    jmp L_ACCOUNT_AFTER_PLAN

L_ACCOUNT_AFTER_PLAN:
    has_email = ugt email_len, 0
    br has_email -> L_ACCOUNT_SELECT_EMAIL_CFG, L_ACCOUNT_SELECT_EMAIL_DEFAULT

L_ACCOUNT_SELECT_EMAIL_CFG:
    !has_email
    store selected_email_ptr_slot+0, email_ptr as ptr
    store selected_email_len_slot+0, email_len as u64
    jmp L_ACCOUNT_WRITE

L_ACCOUNT_SELECT_EMAIL_DEFAULT:
    !has_email
    default_email_ptr = &RPC_SYS_J_ACCOUNT_DEFAULT_EMAIL
    store selected_email_ptr_slot+0, default_email_ptr as ptr
    store selected_email_len_slot+0, RPC_SYS_J_ACCOUNT_DEFAULT_EMAIL_LEN as u64
    !default_email_ptr
    jmp L_ACCOUNT_WRITE

L_ACCOUNT_WRITE:
    selected_plan_ptr = load selected_plan_ptr_slot+0 as ptr
    selected_plan_len = load selected_plan_len_slot+0 as u64
    selected_email_ptr = load selected_email_ptr_slot+0 as ptr
    selected_email_len = load selected_email_len_slot+0 as u64
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    account_begin_status = call @json_writer_begin_field_object(writer, &RPC_SYS_JSON_KEY_ACCOUNT, RPC_SYS_JSON_KEY_ACCOUNT_LEN)
    EXPAND JSON_WRITER_FIELD_STRING type_field_status, writer, RPC_SYS_FB_KEY_TYPE, RPC_SYS_FB_KEY_TYPE_LEN, RPC_SYS_JSON_VALUE_CHATGPT, RPC_SYS_JSON_VALUE_CHATGPT_LEN
    EXPAND JSON_WRITER_FIELD_STRING email_field_status, writer, RPC_SYS_JSON_KEY_EMAIL, RPC_SYS_JSON_KEY_EMAIL_LEN, selected_email_ptr, selected_email_len
    EXPAND JSON_WRITER_FIELD_STRING plan_field_status, writer, RPC_SYS_JSON_KEY_PLAN_TYPE, RPC_SYS_JSON_KEY_PLAN_TYPE_LEN, selected_plan_ptr, selected_plan_len
    EXPAND JSON_WRITER_END_OBJECT account_end_status, writer
    EXPAND JSON_WRITER_FIELD_BOOL auth_field_status, writer, RPC_SYS_JSON_KEY_REQUIRES_OPENAI_AUTH, RPC_SYS_JSON_KEY_REQUIRES_OPENAI_AUTH_LEN, 0
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    !end_status
    !auth_field_status
    !account_end_status
    !plan_field_status
    !email_field_status
    !type_field_status
    !account_begin_status
    !begin_status
    !selected_email_ptr
    !selected_email_len
    !selected_plan_ptr
    !selected_plan_len
    !email_ptr
    !email_len
    !plan_ptr
    !plan_len
    !writer
    return 0

@ffi_wrapper send_rpc_account_read(&req: ptr, &id_ptr: ptr, id_len: u64, &cfg_ptr: ptr) -> u32:
L_ENTRY:
    plan_ptr = load cfg_ptr+CFG_PLAN_PTR as ptr
    plan_len = load cfg_ptr+CFG_PLAN_LEN as u64
    email_ptr = load cfg_ptr+CFG_EMAIL_PTR as ptr
    email_len = load cfg_ptr+CFG_EMAIL_LEN as u64
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    write_status = call @json_writer_write_account_read_result(writer, &plan_ptr, plan_len, &email_ptr, email_len)
    !write_status
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !writer_status
    !email_ptr
    !email_len
    !plan_ptr
    !plan_len
    !cfg_ptr
    !req
    return 0

@ffi_wrapper json_writer_write_rate_limits_result(writer: ptr, &plan_ptr: ptr, plan_len: u64) -> u32:
L_ENTRY:
    selected_plan_ptr_slot = stack_alloc 8
    selected_plan_len_slot = stack_alloc 8
    has_plan = ugt plan_len, 0
    br has_plan -> L_RATE_SELECT_CFG, L_RATE_SELECT_DEFAULT

L_RATE_SELECT_CFG:
    !has_plan
    store selected_plan_ptr_slot+0, plan_ptr as ptr
    store selected_plan_len_slot+0, plan_len as u64
    jmp L_RATE_WRITE

L_RATE_SELECT_DEFAULT:
    !has_plan
    default_plan_ptr = &RPC_SYS_DEFAULT_PLAN_PLUS
    store selected_plan_ptr_slot+0, default_plan_ptr as ptr
    store selected_plan_len_slot+0, RPC_SYS_DEFAULT_PLAN_PLUS_LEN as u64
    !default_plan_ptr
    jmp L_RATE_WRITE

L_RATE_WRITE:
    selected_plan_ptr = load selected_plan_ptr_slot+0 as ptr
    selected_plan_len = load selected_plan_len_slot+0 as u64
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    rate_begin_status = call @json_writer_begin_field_object(writer, &RPC_SYS_JSON_KEY_RATE_LIMITS, RPC_SYS_JSON_KEY_RATE_LIMITS_LEN)
    EXPAND JSON_WRITER_FIELD_I64 used_field_status, writer, RPC_SYS_JSON_KEY_USED_PERCENT, RPC_SYS_JSON_KEY_USED_PERCENT_LEN, 0
    EXPAND JSON_WRITER_FIELD_NULL credits_field_status, writer, RPC_SYS_JSON_KEY_CREDITS, RPC_SYS_JSON_KEY_CREDITS_LEN
    EXPAND JSON_WRITER_FIELD_NULL limit_id_field_status, writer, RPC_SYS_JSON_KEY_LIMIT_ID, RPC_SYS_JSON_KEY_LIMIT_ID_LEN
    EXPAND JSON_WRITER_FIELD_NULL limit_name_field_status, writer, RPC_SYS_JSON_KEY_LIMIT_NAME, RPC_SYS_JSON_KEY_LIMIT_NAME_LEN
    EXPAND JSON_WRITER_FIELD_STRING plan_field_status, writer, RPC_SYS_JSON_KEY_PLAN_TYPE, RPC_SYS_JSON_KEY_PLAN_TYPE_LEN, selected_plan_ptr, selected_plan_len
    EXPAND JSON_WRITER_FIELD_NULL primary_field_status, writer, RPC_SYS_JSON_KEY_PRIMARY, RPC_SYS_JSON_KEY_PRIMARY_LEN
    EXPAND JSON_WRITER_FIELD_NULL reached_field_status, writer, RPC_SYS_JSON_KEY_RATE_LIMIT_REACHED_TYPE, RPC_SYS_JSON_KEY_RATE_LIMIT_REACHED_TYPE_LEN
    EXPAND JSON_WRITER_FIELD_NULL secondary_field_status, writer, RPC_SYS_JSON_KEY_SECONDARY, RPC_SYS_JSON_KEY_SECONDARY_LEN
    EXPAND JSON_WRITER_END_OBJECT rate_end_status, writer
    EXPAND JSON_WRITER_FIELD_NULL by_limit_field_status, writer, RPC_SYS_JSON_KEY_RATE_LIMITS_BY_LIMIT_ID, RPC_SYS_JSON_KEY_RATE_LIMITS_BY_LIMIT_ID_LEN
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    !end_status
    !by_limit_field_status
    !rate_end_status
    !secondary_field_status
    !reached_field_status
    !primary_field_status
    !plan_field_status
    !limit_name_field_status
    !limit_id_field_status
    !credits_field_status
    !used_field_status
    !rate_begin_status
    !begin_status
    !selected_plan_ptr
    !selected_plan_len
    !plan_ptr
    !plan_len
    !writer
    return 0

