@ffi_wrapper mcp_oauth_login_has_required_name(&body: ptr, body_len: u64) -> u8:
L_ENTRY:
    root = call @sa_json_parse(&body, body_len)
    has_root = ne root, 0
    br has_root -> L_OAUTH_CHECK_ROOT, L_OAUTH_CHECK_BAD

L_OAUTH_CHECK_ROOT:
    !has_root
    params_slot = stack_alloc 8
    params_status = call @sa_json_object_get(root, &RPC_SYS_FB_KEY_PARAMS, RPC_SYS_FB_KEY_PARAMS_LEN, &params_slot)
    params_ok = eq params_status, 0
    br params_ok -> L_OAUTH_CHECK_PARAMS, L_OAUTH_CHECK_NO_PARAMS

L_OAUTH_CHECK_PARAMS:
    !params_ok
    params_node = load params_slot+0 as ptr
    name_ptr_slot = stack_alloc 8
    name_len_slot = stack_alloc 8
    name_status = call @sa_json_object_get_string(params_node, &RPC_SYS_FB_KEY_NAME, RPC_SYS_FB_KEY_NAME_LEN, &name_ptr_slot, &name_len_slot)
    name_ok = eq name_status, 0
    br name_ok -> L_OAUTH_CHECK_NAME, L_OAUTH_CHECK_NO_NAME

L_OAUTH_CHECK_NAME:
    !name_ok
    name_len = load name_len_slot+0 as u64
    name_nonempty = ugt name_len, 0
    params_free = call @sa_json_free(^params_node)
    root_free = call @sa_json_free(^root)
    !root_free
    !params_free
    !name_status
    !name_len
    br name_nonempty -> L_OAUTH_CHECK_OK, L_OAUTH_CHECK_EMPTY_NAME

L_OAUTH_CHECK_OK:
    !name_nonempty
    !body
    !body_len
    return 1

L_OAUTH_CHECK_NO_NAME:
    !name_ok
    params_free_no_name = call @sa_json_free(^params_node)
    root_free_no_name = call @sa_json_free(^root)
    !root_free_no_name
    !params_free_no_name
    !name_status
    !body
    !body_len
    return 0

L_OAUTH_CHECK_NO_PARAMS:
    !params_ok
    root_free_no_params = call @sa_json_free(^root)
    !root_free_no_params
    !params_status
    !body
    !body_len
    return 0

L_OAUTH_CHECK_EMPTY_NAME:
    !name_nonempty
    !body
    !body_len
    return 0

L_OAUTH_CHECK_BAD:
    !body
    !body_len
    return 0

@ffi_wrapper json_writer_write_oauth_login_result(writer: ptr, &url_ptr: ptr, url_len: u64) -> u32:
L_ENTRY:
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    EXPAND JSON_WRITER_FIELD_STRING auth_status, writer, RPC_SYS_JSON_KEY_AUTHORIZATION_URL, RPC_SYS_JSON_KEY_AUTHORIZATION_URL_LEN, url_ptr, url_len
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    !end_status
    !auth_status
    !begin_status
    !url_ptr
    !url_len
    !writer
    return 0

@ffi_wrapper send_rpc_oauth_login(&req: ptr, &id_ptr: ptr, id_len: u64, &cfg_ptr: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    has_name = call @mcp_oauth_login_has_required_name(&body, body_len)
    br has_name -> L_OAUTH_VALID, L_OAUTH_BAD_PARAMS

L_OAUTH_VALID:
    !has_name
    host_ptr = load cfg_ptr+CFG_HOST_PTR as ptr
    host_len = load cfg_ptr+CFG_HOST_LEN as u64
    port = load cfg_ptr+CFG_PORT as u16
    port_u64 = zext port
    url_len_slot = stack_alloc 8
    url_ptr = call @http_url_owned(&host_ptr, host_len, port_u64, &RPC_SYS_STRING_OAUTH_SUFFIX, RPC_SYS_STRING_OAUTH_SUFFIX_LEN, &url_len_slot)
    url_len = load url_len_slot+0 as u64
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    write_status = call @json_writer_write_oauth_login_result(writer, &url_ptr, url_len)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !write_status
    !writer_status
    !url_ptr
    !url_len
    !host_ptr
    !host_len
    !port
    !port_u64
    !cfg_ptr
    !body
    !body_len
    !req
    return 0

L_OAUTH_BAD_PARAMS:
    !has_name
    call @send_error_with_id(&req, 400, &id_ptr, id_len, &RPC_SYS_J_ERR_INVALID_PARAMS, RPC_SYS_J_ERR_INVALID_PARAMS_LEN)
    !body
    !body_len
    !cfg_ptr
    !req
    return 0

@ffi_wrapper json_writer_write_mock_experimental_result(writer: ptr, value_node: ptr) -> u32:
L_ENTRY:
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    has_value = ne value_node, 0
    br has_value -> L_MOCK_WRITE_VALUE, L_MOCK_WRITE_NULL

L_MOCK_WRITE_VALUE:
    !has_value
    echoed_status = call @sa_json_writer_field_node(writer, &RPC_SYS_JSON_KEY_ECHOED, RPC_SYS_JSON_KEY_ECHOED_LEN, value_node)
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    !end_status
    !echoed_status
    !begin_status
    !value_node
    !writer
    return 0

L_MOCK_WRITE_NULL:
    !has_value
    EXPAND JSON_WRITER_FIELD_NULL echoed_status_null, writer, RPC_SYS_JSON_KEY_ECHOED, RPC_SYS_JSON_KEY_ECHOED_LEN
    EXPAND JSON_WRITER_END_OBJECT end_status_null, writer
    !end_status_null
    !echoed_status_null
    !begin_status
    !value_node
    !writer
    return 0

@ffi_wrapper send_rpc_mock_experimental(&req: ptr, &id_ptr: ptr, id_len: u64, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    root = call @sa_json_parse(&body, body_len)
    has_root = ne root, 0
    br has_root -> L_MOCK_ROOT, L_MOCK_DEFAULT_NO_ROOT

L_MOCK_ROOT:
    !has_root
    params_slot = stack_alloc 8
    params_status = call @sa_json_object_get(root, &RPC_SYS_FB_KEY_PARAMS, RPC_SYS_FB_KEY_PARAMS_LEN, &params_slot)
    params_ok = eq params_status, 0
    br params_ok -> L_MOCK_PARAMS, L_MOCK_NO_PARAMS

L_MOCK_PARAMS:
    !params_ok
    params_node = load params_slot+0 as ptr
    value_slot = stack_alloc 8
    value_status = call @sa_json_object_get(params_node, &RPC_SYS_FB_KEY_VALUE, RPC_SYS_FB_KEY_VALUE_LEN, &value_slot)
    value_ok = eq value_status, 0
    br value_ok -> L_MOCK_VALUE, L_MOCK_NO_VALUE

L_MOCK_VALUE:
    !value_ok
    value_node = load value_slot+0 as ptr
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    write_status = call @json_writer_write_mock_experimental_result(writer, value_node)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !write_status
    !writer_status
    value_free = call @sa_json_free(^value_node)
    !value_free
    params_free = call @sa_json_free(^params_node)
    !params_free
    root_free = call @sa_json_free(^root)
    !root_free
    !value_status
    !params_status
    !body
    !body_len
    !req
    return 0

L_MOCK_NO_VALUE:
    !value_ok
    params_free_no_value = call @sa_json_free(^params_node)
    !params_free_no_value
    root_free_no_value = call @sa_json_free(^root)
    !root_free_no_value
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status_default, writer_default
    write_status_default = call @json_writer_write_mock_experimental_result(writer_default, 0)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer_default)
    !write_status_default
    !writer_status_default
    !value_status
    !params_status
    !body
    !body_len
    !req
    return 0

L_MOCK_NO_PARAMS:
    !params_ok
    root_free_no_params = call @sa_json_free(^root)
    !root_free_no_params
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status_no_params, writer_no_params
    write_status_no_params = call @json_writer_write_mock_experimental_result(writer_no_params, 0)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer_no_params)
    !write_status_no_params
    !writer_status_no_params
    !params_status
    !body
    !body_len
    !req
    return 0

L_MOCK_DEFAULT_NO_ROOT:
    !has_root
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status_no_root, writer_no_root
    write_status_no_root = call @json_writer_write_mock_experimental_result(writer_no_root, 0)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer_no_root)
    !write_status_no_root
    !writer_status_no_root
    !body
    !body_len
    !req
    return 0

@ffi_wrapper json_writer_write_plugin_share_save_result(writer: ptr, &remote_ptr: ptr, remote_len: u64, &url_ptr: ptr, url_len: u64) -> u32:
L_ENTRY:
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    EXPAND JSON_WRITER_FIELD_STRING remote_status, writer, RPC_SYS_JSON_KEY_REMOTE_PLUGIN_ID, RPC_SYS_JSON_KEY_REMOTE_PLUGIN_ID_LEN, remote_ptr, remote_len
    EXPAND JSON_WRITER_FIELD_STRING share_status, writer, RPC_SYS_JSON_KEY_SHARE_URL, RPC_SYS_JSON_KEY_SHARE_URL_LEN, url_ptr, url_len
    EXPAND JSON_WRITER_FIELD_STRING disc_status, writer, RPC_SYS_JSON_KEY_DISCOVERABILITY, RPC_SYS_JSON_KEY_DISCOVERABILITY_LEN, RPC_SYS_JSON_VALUE_UNLISTED, RPC_SYS_JSON_VALUE_UNLISTED_LEN
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    !end_status
    !disc_status
    !share_status
    !remote_status
