@ffi_wrapper notify_rt_role_value(&state_ptr: ptr, &event_ptr: ptr, event_len: u64, &body: ptr, body_len: u64, &value_key: ptr, value_key_len: u64, &mid: ptr, mid_len: u64) -> u32:
L_ENTRY:
    thread_ptr_slot = stack_alloc 8
    thread_len_slot = stack_alloc 8
