    thread_ptr = load thread_ptr_slot+0 as ptr
    thread_len = load thread_len_slot+0 as u64
    role_ptr = load role_ptr_slot+0 as ptr
    role_len = load role_len_slot+0 as u64
    value_ptr = load value_ptr_slot+0 as ptr
    value_len = load value_len_slot+0 as u64
    delta_match = call @sa_bytes_eq(&mid, mid_len, &RPC_SYS_J_EVT_RT_DELTA_B2, RPC_SYS_J_EVT_RT_DELTA_B2_LEN)
    is_delta = eq delta_match, 1
    !delta_match
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    EXPAND JSON_WRITER_FIELD_STRING thread_status, writer, RPC_SYS_JSON_KEY_THREAD_ID, RPC_SYS_JSON_KEY_THREAD_ID_LEN, thread_ptr, thread_len
    EXPAND JSON_WRITER_FIELD_STRING role_status, writer, RPC_SYS_JSON_KEY_ROLE, RPC_SYS_JSON_KEY_ROLE_LEN, role_ptr, role_len
    br is_delta -> L_NOTIFY_RT_ROLE_DELTA, L_NOTIFY_RT_ROLE_TEXT

L_NOTIFY_RT_ROLE_DELTA:
    !is_delta
    EXPAND JSON_WRITER_FIELD_STRING value_status_delta, writer, RPC_SYS_JSON_KEY_DELTA, RPC_SYS_JSON_KEY_DELTA_LEN, value_ptr, value_len
    EXPAND JSON_WRITER_END_OBJECT end_status_delta, writer
    call @notify_writer_params(&state_ptr, &event_ptr, event_len, writer)
    !end_status_delta
    !value_status_delta
    !role_status
    !thread_status
    !begin_status
