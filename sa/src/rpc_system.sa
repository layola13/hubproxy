@ffi_wrapper send_rpc_bool_field_with_id(&req: ptr, &id_ptr: ptr, id_len: u64, &key: ptr, key_len: u64, value: u8) -> u32:
L_ENTRY:
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    write_status = call @json_writer_write_bool_field_result(writer, &key, key_len, value)
    !write_status
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !writer_status
    !key
    !key_len
    !value
    !id_ptr
    !id_len
    !req
    return 0

@ffi_wrapper json_writer_write_bool_field_result(writer: ptr, &key: ptr, key_len: u64, value: u8) -> u32:
L_ENTRY:
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    EXPAND JSON_WRITER_FIELD_BOOL field_status, writer, key, key_len, value
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    !end_status
    !field_status
    !begin_status
    !key
    !key_len
    !value
    !writer
    return 0

@ffi_wrapper send_rpc_status_with_id(&req: ptr, &id_ptr: ptr, id_len: u64, &status_ptr: ptr, status_len: u64) -> u32:
L_ENTRY:
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    EXPAND JSON_WRITER_FIELD_STRING status_field, writer, RPC_SYS_JSON_KEY_STATUS, RPC_SYS_JSON_KEY_STATUS_LEN, status_ptr, status_len
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !end_status
    !status_field
    !begin_status
    !writer_status
    !status_ptr
    !status_len
    !id_ptr
    !id_len
    !req
    return 0

@ffi_wrapper rpc_system_send_rpc_thread_elicitation_result(&req: ptr, &id_ptr: ptr, id_len: u64, count: u64) -> u32:
L_ENTRY:
    paused = ugt count, 0
    count_i64 = bitcast count as i64
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    count_status = call @sa_json_writer_field_i64(writer, &RPC_SYS_JSON_KEY_COUNT, RPC_SYS_JSON_KEY_COUNT_LEN, count_i64)
    EXPAND JSON_WRITER_FIELD_BOOL paused_status, writer, RPC_SYS_JSON_KEY_PAUSED, RPC_SYS_JSON_KEY_PAUSED_LEN, paused
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !end_status
    !paused_status
    !count_status
    !begin_status
    !writer_status
    !count_i64
    !paused
    !count
    !req
    return 0

@ffi_wrapper notify_fs_changed(&state_ptr: ptr, &watch_id_ptr: ptr, watch_id_len: u64, &path_ptr: ptr, path_len: u64) -> u32:
L_ENTRY:
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    EXPAND JSON_WRITER_FIELD_STRING watch_status, writer, RPC_SYS_JSON_KEY_WATCH_ID, RPC_SYS_JSON_KEY_WATCH_ID_LEN, watch_id_ptr, watch_id_len
    changed_begin_status = call @json_writer_begin_field_array(writer, &RPC_SYS_JSON_KEY_CHANGED_PATHS, RPC_SYS_JSON_KEY_CHANGED_PATHS_LEN)
    path_status = call @sa_json_writer_write_string(writer, &path_ptr, path_len)
    EXPAND JSON_WRITER_END_ARRAY changed_end_status, writer
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    call @notify_writer_params(&state_ptr, &RPC_SYS_EV_FS_CHANGED, RPC_SYS_EV_FS_CHANGED_LEN, writer)
    !end_status
    !changed_end_status
    !path_status
    !changed_begin_status
    !watch_status
    !begin_status
    !writer_status
    !state_ptr
    !watch_id_ptr
    !watch_id_len
    !path_ptr
    !path_len
    return 0

@ffi_wrapper notify_thread_string(&state_ptr: ptr, &event_ptr: ptr, event_len: u64, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    thread_ptr_slot = stack_alloc 8
    thread_len_slot = stack_alloc 8
    thread_extract_status = call @rpc_extract_string_or_default(&body, body_len, &RPC_SYS_J_THREADID_KEY, RPC_SYS_J_THREADID_KEY_LEN, &RPC_SYS_EMPTY_TEXT, RPC_SYS_EMPTY_TEXT_LEN, &thread_ptr_slot, &thread_len_slot)
    thread_ptr = load thread_ptr_slot+0 as ptr
    thread_len = load thread_len_slot+0 as u64
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    EXPAND JSON_WRITER_FIELD_STRING thread_status, writer, RPC_SYS_JSON_KEY_THREAD_ID, RPC_SYS_JSON_KEY_THREAD_ID_LEN, thread_ptr, thread_len
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    call @notify_writer_params(&state_ptr, &event_ptr, event_len, writer)
    !end_status
    !thread_status
    !begin_status
    !writer_status
    !thread_extract_status
    !thread_ptr
    !thread_len
    !state_ptr
    !event_ptr
    !event_len
    !body
    !body_len
    return 0

@ffi_wrapper json_writer_write_realtime_started_params(writer: ptr, &thread_ptr: ptr, thread_len: u64, &session_ptr: ptr, session_len: u64) -> u32:
L_ENTRY:
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    EXPAND JSON_WRITER_FIELD_STRING thread_status, writer, RPC_SYS_JSON_KEY_THREAD_ID, RPC_SYS_JSON_KEY_THREAD_ID_LEN, thread_ptr, thread_len
    EXPAND JSON_WRITER_FIELD_STRING version_status, writer, RPC_SYS_JSON_KEY_VERSION, RPC_SYS_JSON_KEY_VERSION_LEN, RPC_SYS_JSON_VALUE_V2, RPC_SYS_JSON_VALUE_V2_LEN
    EXPAND JSON_WRITER_FIELD_STRING session_status, writer, RPC_SYS_JSON_KEY_REALTIME_SESSION_ID, RPC_SYS_JSON_KEY_REALTIME_SESSION_ID_LEN, session_ptr, session_len
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    !end_status
    !session_status
    !version_status
    !thread_status
    !begin_status
    !writer
    !thread_ptr
    !thread_len
    !session_ptr
    !session_len
    return 0

@ffi_wrapper notify_realtime_started(&state_ptr: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    thread_ptr_slot = stack_alloc 8
    thread_len_slot = stack_alloc 8
    thread_extract_status = call @rpc_extract_string_or_default(&body, body_len, &RPC_SYS_J_THREADID_KEY, RPC_SYS_J_THREADID_KEY_LEN, &RPC_SYS_EMPTY_TEXT, RPC_SYS_EMPTY_TEXT_LEN, &thread_ptr_slot, &thread_len_slot)
    thread_ptr = load thread_ptr_slot+0 as ptr
    thread_len = load thread_len_slot+0 as u64
    uuid_ptr_slot = stack_alloc 8
    uuid_len_slot = stack_alloc 8
    uuid_status = call @plugin_random_uuid(&uuid_ptr_slot, &uuid_len_slot)
    uuid_ptr = load uuid_ptr_slot+0 as ptr
    uuid_len = load uuid_len_slot+0 as u64
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    params_status = call @json_writer_write_realtime_started_params(writer, &thread_ptr, thread_len, &uuid_ptr, uuid_len)
    call @notify_writer_params(&state_ptr, &RPC_SYS_EV_RT_STARTED, RPC_SYS_EV_RT_STARTED_LEN, writer)
    uuid_free_status = call @plugin_free_buffer(uuid_ptr, uuid_len)
    !uuid_free_status
    !params_status
    !writer_status
    !thread_extract_status
    !uuid_status
    !thread_ptr
    !thread_len
    !uuid_ptr
    !uuid_len
    !state_ptr
    !body
    !body_len
    return 0

@ffi_wrapper notify_rt_item_value(&state_ptr: ptr, &event_ptr: ptr, event_len: u64, &body: ptr, body_len: u64, &key: ptr, key_len: u64) -> u32:
L_ENTRY:
    thread_ptr_slot = stack_alloc 8
    thread_len_slot = stack_alloc 8
    value_ptr_slot = stack_alloc 8
    value_len_slot = stack_alloc 8
    thread_extract_status = call @rpc_extract_string_or_default(&body, body_len, &RPC_SYS_J_THREADID_KEY, RPC_SYS_J_THREADID_KEY_LEN, &RPC_SYS_EMPTY_TEXT, RPC_SYS_EMPTY_TEXT_LEN, &thread_ptr_slot, &thread_len_slot)
    value_extract_status = call @rpc_extract_param_string(&body, body_len, &key, key_len, &value_ptr_slot, &value_len_slot)
    thread_ptr = load thread_ptr_slot+0 as ptr
    thread_len = load thread_len_slot+0 as u64
    value_ptr = load value_ptr_slot+0 as ptr
    value_len = load value_len_slot+0 as u64
    audio_delta_match = call @sa_bytes_eq(&event_ptr, event_len, &RPC_SYS_EV_RT_AUDIO_DELTA, RPC_SYS_EV_RT_AUDIO_DELTA_LEN)
    is_audio_delta = eq audio_delta_match, 1
    !audio_delta_match
    br is_audio_delta -> L_NOTIFY_RT_AUDIO_DELTA, L_NOTIFY_RT_ITEM

L_NOTIFY_RT_AUDIO_DELTA:
    !is_audio_delta
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status_delta, writer_delta
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status_delta, writer_delta
    EXPAND JSON_WRITER_FIELD_STRING thread_status_delta, writer_delta, RPC_SYS_JSON_KEY_THREAD_ID, RPC_SYS_JSON_KEY_THREAD_ID_LEN, thread_ptr, thread_len
    has_value_delta = eq value_extract_status, 1
    br has_value_delta -> L_NOTIFY_RT_AUDIO_DELTA_VALUE, L_NOTIFY_RT_AUDIO_DELTA_NULL

L_NOTIFY_RT_AUDIO_DELTA_VALUE:
    !has_value_delta
    EXPAND JSON_WRITER_FIELD_STRING audio_status_delta, writer_delta, RPC_SYS_JSON_KEY_AUDIO, RPC_SYS_JSON_KEY_AUDIO_LEN, value_ptr, value_len
    jmp L_NOTIFY_RT_AUDIO_DELTA_DONE

L_NOTIFY_RT_AUDIO_DELTA_NULL:
