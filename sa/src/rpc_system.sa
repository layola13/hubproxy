@ffi_wrapper json_writer_write_remote_status_params(writer: ptr, &body: ptr, body_len: u64, &status_ptr: ptr, status_len: u64) -> u32:
L_ENTRY:
    server_ptr_slot = stack_alloc 8
    server_len_slot = stack_alloc 8
    install_ptr_slot = stack_alloc 8
    install_len_slot = stack_alloc 8
    env_ptr_slot = stack_alloc 8
    env_len_slot = stack_alloc 8
    server_extract_status = call @rpc_extract_string_or_default(&body, body_len, &RPC_SYS_J_SERVER_NAME_KEY, RPC_SYS_J_SERVER_NAME_KEY_LEN, &RPC_SYS_DEFAULT_LOCAL, RPC_SYS_DEFAULT_LOCAL_LEN, &server_ptr_slot, &server_len_slot)
    install_extract_status = call @rpc_extract_string_or_default(&body, body_len, &RPC_SYS_J_INSTALLATION_ID_KEY, RPC_SYS_J_INSTALLATION_ID_KEY_LEN, &RPC_SYS_DEFAULT_INSTALLATION, RPC_SYS_DEFAULT_INSTALLATION_LEN, &install_ptr_slot, &install_len_slot)
    env_extract_status = call @rpc_extract_param_string(&body, body_len, &RPC_SYS_J_ENVIRONMENT_ID_KEY, RPC_SYS_J_ENVIRONMENT_ID_KEY_LEN, &env_ptr_slot, &env_len_slot)
    server_ptr = load server_ptr_slot+0 as ptr
    server_len = load server_len_slot+0 as u64
    install_ptr = load install_ptr_slot+0 as ptr
    install_len = load install_len_slot+0 as u64
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    EXPAND JSON_WRITER_FIELD_STRING status_field_status, writer, RPC_SYS_JSON_KEY_STATUS, RPC_SYS_JSON_KEY_STATUS_LEN, status_ptr, status_len
    EXPAND JSON_WRITER_FIELD_STRING server_status, writer, RPC_SYS_JSON_KEY_SERVER_NAME, RPC_SYS_JSON_KEY_SERVER_NAME_LEN, server_ptr, server_len
    EXPAND JSON_WRITER_FIELD_STRING install_status, writer, RPC_SYS_JSON_KEY_INSTALLATION_ID, RPC_SYS_JSON_KEY_INSTALLATION_ID_LEN, install_ptr, install_len
    env_found = eq env_extract_status, 1
    br env_found -> L_REMOTE_STATUS_ENV_VALUE, L_REMOTE_STATUS_ENV_NULL

L_REMOTE_STATUS_ENV_VALUE:
    !env_found
    env_ptr = load env_ptr_slot+0 as ptr
    env_len = load env_len_slot+0 as u64
    EXPAND JSON_WRITER_FIELD_STRING env_status, writer, RPC_SYS_JSON_KEY_ENVIRONMENT_ID, RPC_SYS_JSON_KEY_ENVIRONMENT_ID_LEN, env_ptr, env_len
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    !end_status
    !env_status
    !env_ptr
    !env_len
    !install_status
    !server_status
    !status_field_status
    !begin_status
    !server_extract_status
    !install_extract_status
    !env_extract_status
    !server_ptr
    !server_len
    !install_ptr
    !install_len
    !writer
    !body
    !body_len
    !status_ptr
    !status_len
    return 0

L_REMOTE_STATUS_ENV_NULL:
    !env_found
    EXPAND JSON_WRITER_FIELD_NULL env_status_null, writer, RPC_SYS_JSON_KEY_ENVIRONMENT_ID, RPC_SYS_JSON_KEY_ENVIRONMENT_ID_LEN
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    !end_status
    !env_status_null
    !install_status
    !server_status
    !status_field_status
    !begin_status
    !server_extract_status
    !install_extract_status
    !env_extract_status
    !server_ptr
    !server_len
    !install_ptr
    !install_len
    !writer
    !body
    !body_len
    !status_ptr
    !status_len
    return 0

@ffi_wrapper notify_remote_status(&state_ptr: ptr, &body: ptr, body_len: u64, &status_ptr: ptr, status_len: u64) -> u32:
L_ENTRY:
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    write_status = call @json_writer_write_remote_status_params(writer, &body, body_len, &status_ptr, status_len)
    call @notify_writer_params(&state_ptr, &RPC_SYS_EV_REMOTE_STATUS, RPC_SYS_EV_REMOTE_STATUS_LEN, writer)
    !write_status
    !writer_status
    !state_ptr
    !body
    !body_len
    !status_ptr
    !status_len
    return 0

@ffi_wrapper send_rpc_remote_status(&req: ptr, &id_ptr: ptr, id_len: u64, &body: ptr, body_len: u64, &status_ptr: ptr, status_len: u64) -> u32:
L_ENTRY:
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    write_status = call @json_writer_write_remote_status_params(writer, &body, body_len, &status_ptr, status_len)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !write_status
    !writer_status
    !body
    !body_len
    !status_ptr
    !status_len
    !req
    return 0

@ffi_wrapper send_rpc_mcp_status_list(&req: ptr, &id_ptr: ptr, id_len: u64, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    mcp_status_ptr_slot = stack_alloc 8
    mcp_status_len_slot = stack_alloc 8
    mcp_status = call @sa_deno_plugin_mcp_server_status_list(&body, body_len, &mcp_status_ptr_slot, &mcp_status_len_slot)
    mcp_ok = eq mcp_status, 0
    br mcp_ok -> L_MCP_STATUS_PLUGIN_LOAD, L_MCP_STATUS_CHECK

L_MCP_STATUS_CHECK:
    mcp_invalid_params = eq mcp_status, 3
    br mcp_invalid_params -> L_MCP_STATUS_BAD_PARAMS, L_MCP_STATUS_FAILED

L_MCP_STATUS_BAD_PARAMS:
    !mcp_invalid_params
    !mcp_ok
    !mcp_status
    call @send_error_with_id(&req, 400, &id_ptr, id_len, &RPC_SYS_J_ERR_INVALID_PARAMS, RPC_SYS_J_ERR_INVALID_PARAMS_LEN)
    !body
    !body_len
    !req
    return 0

L_MCP_STATUS_PLUGIN_LOAD:
    !mcp_ok
    mcp_status_ptr = load mcp_status_ptr_slot+0 as ptr
    mcp_status_len = load mcp_status_len_slot+0 as u64
    call @send_wrapped_raw_json_with_id(&req, &id_ptr, id_len, &mcp_status_ptr, mcp_status_len)
    mcp_free_status = call @plugin_free_buffer(mcp_status_ptr, mcp_status_len)
    !mcp_free_status
    !mcp_status_ptr
    !mcp_status_len
    !mcp_status
    !body
    !body_len
    !req
    return 0

L_MCP_STATUS_FAILED:
    !mcp_invalid_params
    !mcp_ok
    !mcp_status
    call @sa_print_bytes(&RPC_SYS_LOG_MCP_STATUS_FAILED, RPC_SYS_LOG_MCP_STATUS_FAILED_LEN)
    call @send_error_with_id(&req, 500, &id_ptr, id_len, &RPC_SYS_J_ERR_MCP_FAILED, RPC_SYS_J_ERR_MCP_FAILED_LEN)
    !body
    !body_len
    !req
    return 0

@ffi_wrapper send_rpc_mcp_resource_read(&req: ptr, &id_ptr: ptr, id_len: u64, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    mcp_res_ptr_slot = stack_alloc 8
    mcp_res_len_slot = stack_alloc 8
    mcp_res_status = call @sa_deno_plugin_mcp_resource_read(&body, body_len, &mcp_res_ptr_slot, &mcp_res_len_slot)
    mcp_res_ok = eq mcp_res_status, 0
    br mcp_res_ok -> L_MCP_RESOURCE_READ_PLUGIN_SEND, L_MCP_RESOURCE_READ_STATUS_CHECK

L_MCP_RESOURCE_READ_STATUS_CHECK:
    mcp_res_invalid_params = eq mcp_res_status, 3
    br mcp_res_invalid_params -> L_MCP_RESOURCE_READ_BAD_PARAMS, L_MCP_RESOURCE_READ_STATUS_CHECK_FAILED

L_MCP_RESOURCE_READ_BAD_PARAMS:
    !mcp_res_invalid_params
    call @send_error_with_id(&req, 400, &id_ptr, id_len, &RPC_SYS_J_ERR_INVALID_PARAMS, RPC_SYS_J_ERR_INVALID_PARAMS_LEN)
    !body
    !body_len
    !req
    return 0

L_MCP_RESOURCE_READ_STATUS_CHECK_FAILED:
    !mcp_res_invalid_params
    jmp L_MCP_RESOURCE_READ_FAILED

L_MCP_RESOURCE_READ_FAILED:
    call @sa_print_bytes(&RPC_SYS_LOG_MCP_RESOURCE_FAILED, RPC_SYS_LOG_MCP_RESOURCE_FAILED_LEN)
    call @send_error_with_id(&req, 500, &id_ptr, id_len, &RPC_SYS_J_ERR_MCP_FAILED, RPC_SYS_J_ERR_MCP_FAILED_LEN)
    !body
    !body_len
    !req
    return 0

L_MCP_RESOURCE_READ_PLUGIN_SEND:
    mcp_res_ptr = load mcp_res_ptr_slot+0 as ptr
    mcp_res_len = load mcp_res_len_slot+0 as u64
    call @send_wrapped_raw_json_with_id(&req, &id_ptr, id_len, &mcp_res_ptr, mcp_res_len)
    mcp_res_free_status = call @plugin_free_buffer(mcp_res_ptr, mcp_res_len)
    !mcp_res_free_status
    !mcp_res_ptr
    !mcp_res_len
    !body
    !body_len
    !req
    return 0

// ============================================================
// Helper: check_auth(req, auth_token_ptr, auth_token_len) -> u8
// Returns 1 if auth is valid or no auth required, 0 if unauthorized.
// ============================================================
