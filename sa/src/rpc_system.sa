    !count
    !thread_id
    !body
    !body_len
    !state_ptr
    !req
    return 0

@ffi_wrapper send_rpc_fs_watch(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    path_ptr_slot = stack_alloc 8
    path_len_slot = stack_alloc 8
    watch_ptr_slot = stack_alloc 8
    watch_len_slot = stack_alloc 8
    path_status = call @rpc_extract_param_string(&body, body_len, &RPC_SYS_J_PATH_KEY, RPC_SYS_J_PATH_KEY_LEN, &path_ptr_slot, &path_len_slot)
    has_path = eq path_status, 1
    !path_status
    br has_path -> L_WATCH_ID, L_WATCH_BAD_PARAMS

L_WATCH_ID:
    !has_path
    watch_status = call @rpc_extract_param_string(&body, body_len, &RPC_SYS_J_WATCH_ID_KEY, RPC_SYS_J_WATCH_ID_KEY_LEN, &watch_ptr_slot, &watch_len_slot)
    has_watch = eq watch_status, 1
    !watch_status
    br has_watch -> L_WATCH_DO, L_WATCH_BAD_PARAMS2

L_WATCH_BAD_PARAMS:
    !has_path
    call @send_error_with_id(&req, 400, &id_ptr, id_len, &RPC_SYS_J_ERR_INVALID_PARAMS, RPC_SYS_J_ERR_INVALID_PARAMS_LEN)
    !body
    !body_len
    !state_ptr
    !req
    return 0

L_WATCH_BAD_PARAMS2:
    !has_watch
    call @send_error_with_id(&req, 400, &id_ptr, id_len, &RPC_SYS_J_ERR_INVALID_PARAMS, RPC_SYS_J_ERR_INVALID_PARAMS_LEN)
    !body
    !body_len
    !state_ptr
    !req
    return 0

L_WATCH_DO:
    !has_watch
    path_ptr = load path_ptr_slot+0 as ptr
    path_len = load path_len_slot+0 as u64
    watch_ptr = load watch_ptr_slot+0 as ptr
    watch_len = load watch_len_slot+0 as u64
    put_status = call @state_watch_put(&state_ptr, &watch_ptr, watch_len)
    put_ok = eq put_status, 0
    !put_status
    br put_ok -> L_WATCH_RESP, L_WATCH_ERR

L_WATCH_ERR:
    !put_ok
    !path_ptr
    !path_len
    !watch_ptr
    !watch_len
    call @send_error_with_id(&req, 500, &id_ptr, id_len, &RPC_SYS_J_ERR_FS, RPC_SYS_J_ERR_FS_LEN)
    !body
    !body_len
    !state_ptr
    !req
    return 0

L_WATCH_RESP:
    !put_ok
    call @notify_fs_changed(&state_ptr, &watch_ptr, watch_len, &path_ptr, path_len)
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    EXPAND JSON_WRITER_FIELD_STRING path_status2, writer, RPC_SYS_JSON_KEY_PATH, RPC_SYS_JSON_KEY_PATH_LEN, path_ptr, path_len
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !end_status
    !path_status2
    !begin_status
    !writer_status
    !path_ptr
    !path_len
    !watch_ptr
    !watch_len
    !body
    !body_len
    !state_ptr
    !req
    return 0

@ffi_wrapper send_rpc_fs_unwatch(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    watch_ptr_slot = stack_alloc 8
    watch_len_slot = stack_alloc 8
    watch_status = call @rpc_extract_param_string(&body, body_len, &RPC_SYS_J_WATCH_ID_KEY, RPC_SYS_J_WATCH_ID_KEY_LEN, &watch_ptr_slot, &watch_len_slot)
    has_watch = eq watch_status, 1
    !watch_status
    br has_watch -> L_UNWATCH_DO, L_UNWATCH_FALSE

L_UNWATCH_DO:
    !has_watch
    watch_ptr = load watch_ptr_slot+0 as ptr
    watch_len = load watch_len_slot+0 as u64
    deleted = call @state_watch_delete(&state_ptr, &watch_ptr, watch_len)
    found = eq deleted, 1
    !deleted
    br found -> L_UNWATCH_TRUE, L_UNWATCH_FALSE2

L_UNWATCH_TRUE:
    !found
    call @send_rpc_bool_field_with_id(&req, &id_ptr, id_len, &RPC_SYS_JSON_KEY_OK, RPC_SYS_JSON_KEY_OK_LEN, 1)
    !watch_ptr
    !watch_len
    !body
    !body_len
    !state_ptr
    !req
    return 0

L_UNWATCH_FALSE2:
    !found
    call @send_rpc_bool_field_with_id(&req, &id_ptr, id_len, &RPC_SYS_JSON_KEY_OK, RPC_SYS_JSON_KEY_OK_LEN, 0)
    !watch_ptr
    !watch_len
    !body
    !body_len
    !state_ptr
    !req
    return 0

L_UNWATCH_FALSE:
    !has_watch
    call @send_rpc_bool_field_with_id(&req, &id_ptr, id_len, &RPC_SYS_JSON_KEY_OK, RPC_SYS_JSON_KEY_OK_LEN, 0)
    !body
    !body_len
    !state_ptr
    !req
    return 0

@ffi_wrapper json_writer_write_external_import_result(writer: ptr, &iso_ptr: ptr, iso_len: u64) -> u32:
L_ENTRY:
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    EXPAND JSON_WRITER_FIELD_BOOL imported_status, writer, RPC_SYS_JSON_KEY_IMPORTED, RPC_SYS_JSON_KEY_IMPORTED_LEN, 1
    EXPAND JSON_WRITER_FIELD_STRING imported_at_status, writer, RPC_SYS_JSON_KEY_IMPORTED_AT, RPC_SYS_JSON_KEY_IMPORTED_AT_LEN, iso_ptr, iso_len
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    !end_status
    !imported_at_status
    !imported_status
    !begin_status
    !iso_ptr
    !iso_len
    !writer
    return 0

@ffi_wrapper send_rpc_external_import(&req: ptr, &id_ptr: ptr, id_len: u64) -> u32:
L_ENTRY:
    iso_ptr_slot = stack_alloc 8
    iso_len_slot = stack_alloc 8
    iso_status = call @plugin_date_now_iso(&iso_ptr_slot, &iso_len_slot)
    iso_ptr = load iso_ptr_slot+0 as ptr
    iso_len = load iso_len_slot+0 as u64
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    write_status = call @json_writer_write_external_import_result(writer, &iso_ptr, iso_len)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    iso_free = call @plugin_free_buffer(iso_ptr, iso_len)
    !iso_free
    !write_status
    !writer_status
    !iso_status
    !iso_ptr
    !iso_len
    !req
    return 0

@ffi_wrapper send_rpc_experimental_enablement_empty(&req: ptr, &id_ptr: ptr, id_len: u64) -> u32:
L_ENTRY:
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    enable_status = call @json_writer_field_empty_object(writer, &RPC_SYS_JSON_KEY_ENABLEMENT, RPC_SYS_JSON_KEY_ENABLEMENT_LEN)
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !end_status
    !enable_status
    !begin_status
    !writer_status
    !req
    return 0

@ffi_wrapper send_rpc_experimental_enablement_set(&req: ptr, &id_ptr: ptr, id_len: u64, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    root = call @sa_json_parse(&body, body_len)
    has_root = ne root, 0
    br has_root -> L_EXP_ENABLE_ROOT, L_EXP_ENABLE_DEFAULT_NO_ROOT

L_EXP_ENABLE_ROOT:
    !has_root
    params_slot = stack_alloc 8
    params_status = call @sa_json_object_get(root, &RPC_SYS_FB_KEY_PARAMS, RPC_SYS_FB_KEY_PARAMS_LEN, &params_slot)
    params_ok = eq params_status, 0
    br params_ok -> L_EXP_ENABLE_PARAMS, L_EXP_ENABLE_NO_PARAMS

L_EXP_ENABLE_PARAMS:
    !params_ok
    params_node = load params_slot+0 as ptr
    enable_slot = stack_alloc 8
    enable_status = call @sa_json_object_get(params_node, &RPC_SYS_JSON_KEY_ENABLEMENT, RPC_SYS_JSON_KEY_ENABLEMENT_LEN, &enable_slot)
    enable_ok = eq enable_status, 0
    br enable_ok -> L_EXP_ENABLE_VALUE, L_EXP_ENABLE_NO_VALUE

L_EXP_ENABLE_VALUE:
    !enable_ok
    enable_node = load enable_slot+0 as ptr
    enable_kind = call @sa_json_kind(enable_node)
    enable_is_null = eq enable_kind, SA_JSON_KIND_NULL
    !enable_kind
    br enable_is_null -> L_EXP_ENABLE_NULL, L_EXP_ENABLE_RAW

L_EXP_ENABLE_RAW:
    !enable_is_null
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    enable_field_status = call @sa_json_writer_field_node(writer, &RPC_SYS_JSON_KEY_ENABLEMENT, RPC_SYS_JSON_KEY_ENABLEMENT_LEN, enable_node)
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !end_status
    !enable_field_status
    !begin_status
    !writer_status
    enable_free = call @sa_json_free(^enable_node)
    !enable_free
    params_free = call @sa_json_free(^params_node)
    !params_free
    root_free = call @sa_json_free(^root)
    !root_free
    !enable_status
    !params_status
    !body
    !body_len
    !req
    return 0

L_EXP_ENABLE_NULL:
    !enable_is_null
    enable_free_null = call @sa_json_free(^enable_node)
    !enable_free_null
    params_free_null = call @sa_json_free(^params_node)
    !params_free_null
    root_free_null = call @sa_json_free(^root)
    !root_free_null
    call @send_rpc_experimental_enablement_empty(&req, &id_ptr, id_len)
    !enable_status
    !params_status
    !body
    !body_len
    !req
    return 0

L_EXP_ENABLE_NO_VALUE:
    !enable_ok
    params_free_no_value = call @sa_json_free(^params_node)
    !params_free_no_value
    root_free_no_value = call @sa_json_free(^root)
    !root_free_no_value
    call @send_rpc_experimental_enablement_empty(&req, &id_ptr, id_len)
    !enable_status
    !params_status
    !body
    !body_len
    !req
    return 0

L_EXP_ENABLE_NO_PARAMS:
    !params_ok
    root_free_no_params = call @sa_json_free(^root)
    !root_free_no_params
    call @send_rpc_experimental_enablement_empty(&req, &id_ptr, id_len)
    !params_status
    !body
    !body_len
    !req
    return 0

L_EXP_ENABLE_DEFAULT_NO_ROOT:
    !has_root
    call @send_rpc_experimental_enablement_empty(&req, &id_ptr, id_len)
    !body
    !body_len
    !req
    return 0

@ffi_wrapper json_writer_write_realtime_start_result(writer: ptr, &uuid_ptr: ptr, uuid_len: u64, now_i: i64) -> u32:
L_ENTRY:
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    turn_begin_status = call @json_writer_begin_field_object(writer, &RPC_SYS_JSON_KEY_TURN, RPC_SYS_JSON_KEY_TURN_LEN)
    EXPAND JSON_WRITER_FIELD_STRING id_status, writer, RPC_SYS_RPC_KEY_ID, RPC_SYS_RPC_KEY_ID_LEN, uuid_ptr, uuid_len
    items_status = call @json_writer_field_empty_array(writer, &RPC_SYS_JSON_KEY_ITEMS, RPC_SYS_JSON_KEY_ITEMS_LEN)
    EXPAND JSON_WRITER_FIELD_STRING status_field_status, writer, RPC_SYS_JSON_KEY_STATUS, RPC_SYS_JSON_KEY_STATUS_LEN, RPC_SYS_JSON_VALUE_COMPLETED, RPC_SYS_JSON_VALUE_COMPLETED_LEN
    created_status = call @sa_json_writer_field_i64(writer, &RPC_SYS_JSON_KEY_CREATED_AT, RPC_SYS_JSON_KEY_CREATED_AT_LEN, now_i)
    updated_status = call @sa_json_writer_field_i64(writer, &RPC_SYS_JSON_KEY_UPDATED_AT, RPC_SYS_JSON_KEY_UPDATED_AT_LEN, now_i)
    EXPAND JSON_WRITER_FIELD_STRING items_view_status, writer, RPC_SYS_JSON_KEY_ITEMS_VIEW, RPC_SYS_JSON_KEY_ITEMS_VIEW_LEN, RPC_SYS_JSON_VALUE_FULL, RPC_SYS_JSON_VALUE_FULL_LEN
    started_status = call @sa_json_writer_field_i64(writer, &RPC_SYS_JSON_KEY_STARTED_AT, RPC_SYS_JSON_KEY_STARTED_AT_LEN, now_i)
    completed_status = call @sa_json_writer_field_i64(writer, &RPC_SYS_JSON_KEY_COMPLETED_AT, RPC_SYS_JSON_KEY_COMPLETED_AT_LEN, now_i)
    duration_status = call @sa_json_writer_field_i64(writer, &RPC_SYS_JSON_KEY_DURATION_MS, RPC_SYS_JSON_KEY_DURATION_MS_LEN, 0)
    EXPAND JSON_WRITER_FIELD_NULL error_status, writer, RPC_SYS_JSON_KEY_ERROR, RPC_SYS_JSON_KEY_ERROR_LEN
    EXPAND JSON_WRITER_END_OBJECT turn_end_status, writer
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    !end_status
    !turn_end_status
    !error_status
    !duration_status
    !completed_status
    !started_status
    !items_view_status
    !updated_status
    !created_status
    !status_field_status
    !items_status
    !id_status
    !turn_begin_status
    !begin_status
    !writer
    !uuid_ptr
    !uuid_len
    !now_i
    return 0

@ffi_wrapper send_rpc_realtime_start(&req: ptr, &id_ptr: ptr, id_len: u64) -> u32:
L_ENTRY:
    now_i = call @sa_time_unix_s()
    uuid_ptr_slot = stack_alloc 8
    uuid_len_slot = stack_alloc 8
    uuid_status = call @plugin_random_uuid(&uuid_ptr_slot, &uuid_len_slot)
    uuid_ptr = load uuid_ptr_slot+0 as ptr
    uuid_len = load uuid_len_slot+0 as u64
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    write_status = call @json_writer_write_realtime_start_result(writer, &uuid_ptr, uuid_len, now_i)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    uuid_free_status = call @plugin_free_buffer(uuid_ptr, uuid_len)
    !uuid_free_status
    !write_status
    !writer_status
    !uuid_status
    !uuid_ptr
    !uuid_len
    !now_i
    !req
    return 0

@ffi_wrapper json_writer_write_realtime_thread_result(writer: ptr, &thread_ptr: ptr, thread_len: u64, kind: u8) -> u32:
L_ENTRY:
    is_stop = eq kind, 3
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    br is_stop -> L_REALTIME_THREAD_RESULT_STOP, L_REALTIME_THREAD_RESULT_APPEND

L_REALTIME_THREAD_RESULT_APPEND:
    !is_stop
    is_audio = eq kind, 1
    EXPAND JSON_WRITER_FIELD_BOOL appended_status, writer, RPC_SYS_JSON_KEY_APPENDED, RPC_SYS_JSON_KEY_APPENDED_LEN, 1
    EXPAND JSON_WRITER_FIELD_STRING thread_status, writer, RPC_SYS_JSON_KEY_THREAD_ID, RPC_SYS_JSON_KEY_THREAD_ID_LEN, thread_ptr, thread_len
    br is_audio -> L_REALTIME_THREAD_RESULT_AUDIO, L_REALTIME_THREAD_RESULT_TEXT

L_REALTIME_THREAD_RESULT_AUDIO:
    !is_audio
    EXPAND JSON_WRITER_FIELD_STRING kind_status_audio, writer, RPC_SYS_JSON_KEY_KIND, RPC_SYS_JSON_KEY_KIND_LEN, RPC_SYS_JSON_VALUE_AUDIO, RPC_SYS_JSON_VALUE_AUDIO_LEN
    EXPAND JSON_WRITER_END_OBJECT end_status_audio, writer
    !end_status_audio
    !kind_status_audio
    !thread_status
    !appended_status
    !begin_status
    !writer
    !thread_ptr
    !thread_len
    !kind
    return 0

L_REALTIME_THREAD_RESULT_TEXT:
    !is_audio
    EXPAND JSON_WRITER_FIELD_STRING kind_status_text, writer, RPC_SYS_JSON_KEY_KIND, RPC_SYS_JSON_KEY_KIND_LEN, RPC_SYS_JSON_VALUE_TEXT, RPC_SYS_JSON_VALUE_TEXT_LEN
    EXPAND JSON_WRITER_END_OBJECT end_status_text, writer
    !end_status_text
    !kind_status_text
    !thread_status
    !appended_status
    !begin_status
    !writer
    !thread_ptr
    !thread_len
    !kind
    return 0

L_REALTIME_THREAD_RESULT_STOP:
    !is_stop
    EXPAND JSON_WRITER_FIELD_BOOL stopped_status, writer, RPC_SYS_JSON_KEY_STOPPED, RPC_SYS_JSON_KEY_STOPPED_LEN, 1
    EXPAND JSON_WRITER_FIELD_STRING thread_status_stop, writer, RPC_SYS_JSON_KEY_THREAD_ID, RPC_SYS_JSON_KEY_THREAD_ID_LEN, thread_ptr, thread_len
    EXPAND JSON_WRITER_END_OBJECT end_status_stop, writer
    !end_status_stop
    !thread_status_stop
    !stopped_status
    !begin_status
    !writer
    !thread_ptr
    !thread_len
    !kind
    return 0

@ffi_wrapper send_rpc_realtime_thread(&req: ptr, &id_ptr: ptr, id_len: u64, &body: ptr, body_len: u64, kind: u8) -> u32:
L_ENTRY:
    thread_ptr_slot = stack_alloc 8
    thread_len_slot = stack_alloc 8
    thread_extract_status = call @rpc_extract_string_or_default(&body, body_len, &RPC_SYS_J_THREADID_KEY, RPC_SYS_J_THREADID_KEY_LEN, &RPC_SYS_EMPTY_TEXT, RPC_SYS_EMPTY_TEXT_LEN, &thread_ptr_slot, &thread_len_slot)
    thread_ptr = load thread_ptr_slot+0 as ptr
    thread_len = load thread_len_slot+0 as u64
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    write_status = call @json_writer_write_realtime_thread_result(writer, &thread_ptr, thread_len, kind)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !write_status
    !writer_status
    !thread_extract_status
    !thread_ptr
    !thread_len
    !body
    !body_len
    !kind
    !req
    return 0

@ffi_wrapper json_writer_write_sandbox_setup_result(writer: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    mode_ptr_slot = stack_alloc 8
    mode_len_slot = stack_alloc 8
    mode_extract_status = call @rpc_extract_string_or_default(&body, body_len, &RPC_SYS_J_MODE_KEY, RPC_SYS_J_MODE_KEY_LEN, &RPC_SYS_JSON_VALUE_UNELEVATED, RPC_SYS_JSON_VALUE_UNELEVATED_LEN, &mode_ptr_slot, &mode_len_slot)
    mode_ptr = load mode_ptr_slot+0 as ptr
    mode_len = load mode_len_slot+0 as u64
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    EXPAND JSON_WRITER_FIELD_BOOL started_status, writer, RPC_SYS_JSON_KEY_STARTED, RPC_SYS_JSON_KEY_STARTED_LEN, 1
    EXPAND JSON_WRITER_FIELD_STRING mode_status, writer, RPC_SYS_JSON_KEY_MODE, RPC_SYS_JSON_KEY_MODE_LEN, mode_ptr, mode_len
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    !end_status
    !mode_status
    !started_status
    !begin_status
    !mode_extract_status
    !mode_ptr
    !mode_len
    !body
    !body_len
    !writer
    return 0

@ffi_wrapper send_rpc_sandbox_setup(&req: ptr, &id_ptr: ptr, id_len: u64, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    write_status = call @json_writer_write_sandbox_setup_result(writer, &body, body_len)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !write_status
    !writer_status
    !body
    !body_len
    !req
    return 0

@ffi_wrapper json_writer_write_fuzzy_search_result(writer: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    query_ptr_slot = stack_alloc 8
    query_len_slot = stack_alloc 8
    query_status = call @rpc_extract_param_string(&body, body_len, &RPC_SYS_J_QUERY_KEY, RPC_SYS_J_QUERY_KEY_LEN, &query_ptr_slot, &query_len_slot)
    query_found = eq query_status, 1
    br query_found -> L_FUZZY_QUERY_FOUND, L_FUZZY_EMPTY

L_FUZZY_QUERY_FOUND:
    !query_found
    query_ptr = load query_ptr_slot+0 as ptr
    query_len = load query_len_slot+0 as u64
    has_query = ugt query_len, 0
    br has_query -> L_FUZZY_HIT, L_FUZZY_EMPTY_FOUND

L_FUZZY_HIT:
    !has_query
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status_hit, writer
    files_begin_status_hit = call @json_writer_begin_field_array(writer, &RPC_SYS_JSON_KEY_FILES, RPC_SYS_JSON_KEY_FILES_LEN)
    EXPAND JSON_WRITER_BEGIN_OBJECT file_begin_status_hit, writer
    EXPAND JSON_WRITER_FIELD_STRING path_status_hit, writer, RPC_SYS_JSON_KEY_PATH, RPC_SYS_JSON_KEY_PATH_LEN, query_ptr, query_len
    score_status_hit = call @sa_json_writer_field_i64(writer, &RPC_SYS_JSON_KEY_SCORE, RPC_SYS_JSON_KEY_SCORE_LEN, 1)
    EXPAND JSON_WRITER_END_OBJECT file_end_status_hit, writer
    EXPAND JSON_WRITER_END_ARRAY files_end_status_hit, writer
    EXPAND JSON_WRITER_FIELD_STRING query_status_hit, writer, RPC_SYS_JSON_KEY_QUERY, RPC_SYS_JSON_KEY_QUERY_LEN, query_ptr, query_len
    EXPAND JSON_WRITER_END_OBJECT end_status_hit, writer
    !end_status_hit
    !query_status_hit
    !files_end_status_hit
    !file_end_status_hit
    !score_status_hit
    !path_status_hit
    !file_begin_status_hit
    !files_begin_status_hit
    !begin_status_hit
    !query_ptr
    !query_len
    !query_status
    !body
    !body_len
    !writer
    return 0

L_FUZZY_EMPTY_FOUND:
    !has_query
    !query_ptr
    !query_len
    jmp L_FUZZY_EMPTY_FROM_FOUND

L_FUZZY_EMPTY:
    !query_found

L_FUZZY_EMPTY_FROM_FOUND:
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    files_status = call @json_writer_field_empty_array(writer, &RPC_SYS_JSON_KEY_FILES, RPC_SYS_JSON_KEY_FILES_LEN)
    EXPAND JSON_WRITER_FIELD_STRING query_field_status, writer, RPC_SYS_JSON_KEY_QUERY, RPC_SYS_JSON_KEY_QUERY_LEN, RPC_SYS_EMPTY_TEXT, RPC_SYS_EMPTY_TEXT_LEN
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    !end_status
    !query_field_status
    !files_status
    !begin_status
    !query_status
    !body
    !body_len
    !writer
    return 0

@ffi_wrapper send_rpc_fuzzy_search(&req: ptr, &id_ptr: ptr, id_len: u64, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    write_status = call @json_writer_write_fuzzy_search_result(writer, &body, body_len)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !write_status
    !writer_status
    !body
    !body_len
    !req
    return 0

@ffi_wrapper json_writer_write_fuzzy_session_result(writer: ptr, &body: ptr, body_len: u64, is_stop: u8) -> u32:
L_ENTRY:
    session_ptr_slot = stack_alloc 8
    session_len_slot = stack_alloc 8
    session_extract_status = call @rpc_extract_string_or_default(&body, body_len, &RPC_SYS_J_SESSION_ID_KEY, RPC_SYS_J_SESSION_ID_KEY_LEN, &RPC_SYS_EMPTY_TEXT, RPC_SYS_EMPTY_TEXT_LEN, &session_ptr_slot, &session_len_slot)
    session_ptr = load session_ptr_slot+0 as ptr
    session_len = load session_len_slot+0 as u64
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    EXPAND JSON_WRITER_FIELD_STRING session_status, writer, RPC_SYS_JSON_KEY_SESSION_ID, RPC_SYS_JSON_KEY_SESSION_ID_LEN, session_ptr, session_len
    stop = eq is_stop, 1
    br stop -> L_FUZZY_STOP, L_FUZZY_OK

L_FUZZY_OK:
    !stop
    EXPAND JSON_WRITER_FIELD_STRING status_ok, writer, RPC_SYS_JSON_KEY_STATUS, RPC_SYS_JSON_KEY_STATUS_LEN, RPC_SYS_JSON_VALUE_OK, RPC_SYS_JSON_VALUE_OK_LEN
    EXPAND JSON_WRITER_END_OBJECT end_ok, writer
    !end_ok
    !status_ok
    !session_status
    !begin_status
    !session_extract_status
    !session_ptr
    !session_len
    !body
    !body_len
    !is_stop
    !writer
    return 0

L_FUZZY_STOP:
    !stop
    EXPAND JSON_WRITER_FIELD_STRING status_stop, writer, RPC_SYS_JSON_KEY_STATUS, RPC_SYS_JSON_KEY_STATUS_LEN, RPC_SYS_JSON_VALUE_STOPPED, RPC_SYS_JSON_VALUE_STOPPED_LEN
    EXPAND JSON_WRITER_END_OBJECT end_stop, writer
    !end_stop
    !status_stop
    !session_status
    !begin_status
    !session_extract_status
    !session_ptr
    !session_len
    !body
    !body_len
    !is_stop
    !writer
    return 0

@ffi_wrapper send_rpc_fuzzy_session(&req: ptr, &id_ptr: ptr, id_len: u64, &body: ptr, body_len: u64, is_stop: u8) -> u32:
L_ENTRY:
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    write_status = call @json_writer_write_fuzzy_session_result(writer, &body, body_len, is_stop)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !write_status
    !writer_status
    !body
    !body_len
    !is_stop
    !req
    return 0

@ffi_wrapper json_writer_write_server_resolved_result(writer: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    thread_ptr_slot = stack_alloc 8
    thread_len_slot = stack_alloc 8
    request_ptr_slot = stack_alloc 8
    request_len_slot = stack_alloc 8
    thread_extract_status = call @rpc_extract_string_or_default(&body, body_len, &RPC_SYS_J_THREADID_KEY, RPC_SYS_J_THREADID_KEY_LEN, &RPC_SYS_EMPTY_TEXT, RPC_SYS_EMPTY_TEXT_LEN, &thread_ptr_slot, &thread_len_slot)
    request_extract_status = call @rpc_extract_string_or_default(&body, body_len, &RPC_SYS_J_REQUEST_ID_KEY, RPC_SYS_J_REQUEST_ID_KEY_LEN, &RPC_SYS_EMPTY_TEXT, RPC_SYS_EMPTY_TEXT_LEN, &request_ptr_slot, &request_len_slot)
    thread_ptr = load thread_ptr_slot+0 as ptr
    thread_len = load thread_len_slot+0 as u64
    request_ptr = load request_ptr_slot+0 as ptr
    request_len = load request_len_slot+0 as u64
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    EXPAND JSON_WRITER_FIELD_STRING thread_status, writer, RPC_SYS_JSON_KEY_THREAD_ID, RPC_SYS_JSON_KEY_THREAD_ID_LEN, thread_ptr, thread_len
    EXPAND JSON_WRITER_FIELD_STRING request_status, writer, RPC_SYS_JSON_KEY_REQUEST_ID, RPC_SYS_JSON_KEY_REQUEST_ID_LEN, request_ptr, request_len
    EXPAND JSON_WRITER_FIELD_BOOL resolved_status, writer, RPC_SYS_JSON_KEY_RESOLVED, RPC_SYS_JSON_KEY_RESOLVED_LEN, 1
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    !writer
    !end_status
    !resolved_status
    !request_status
    !thread_status
    !begin_status
    !thread_extract_status
    !request_extract_status
    !thread_ptr
    !thread_len
    !request_ptr
    !request_len
    !body
    !body_len
    return 0

@ffi_wrapper send_rpc_server_resolved(&req: ptr, &id_ptr: ptr, id_len: u64, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    write_status = call @json_writer_write_server_resolved_result(writer, &body, body_len)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !write_status
    !writer_status
    !body
    !body_len
    !id_ptr
    !id_len
    !req
    return 0

