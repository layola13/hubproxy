    !remote_len
    !writer
    return 0

@ffi_wrapper send_rpc_plugin_share_save(&req: ptr, &id_ptr: ptr, id_len: u64, &cfg_ptr: ptr) -> u32:
L_ENTRY:
    host_ptr = load cfg_ptr+CFG_HOST_PTR as ptr
    host_len = load cfg_ptr+CFG_HOST_LEN as u64
    port = load cfg_ptr+CFG_PORT as u16
    port_u64 = zext port
    uuid_ptr_slot = stack_alloc 8
    uuid_len_slot = stack_alloc 8
    uuid_status = call @plugin_random_uuid(&uuid_ptr_slot, &uuid_len_slot)
    uuid_ptr = load uuid_ptr_slot+0 as ptr
    uuid_len = load uuid_len_slot+0 as u64
    remote_len_slot = stack_alloc 8
    remote_ptr = call @prefix_with_owned(&RPC_SYS_STRING_REMOTE_PREFIX, RPC_SYS_STRING_REMOTE_PREFIX_LEN, &uuid_ptr, uuid_len, &remote_len_slot)
    remote_len = load remote_len_slot+0 as u64
    url_len_slot = stack_alloc 8
    url_ptr = call @http_url_owned(&host_ptr, host_len, port_u64, &RPC_SYS_STRING_SHARE_SUFFIX, RPC_SYS_STRING_SHARE_SUFFIX_LEN, &url_len_slot)
    url_len = load url_len_slot+0 as u64
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    write_status = call @json_writer_write_plugin_share_save_result(writer, &remote_ptr, remote_len, &url_ptr, url_len)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    uuid_free_status = call @plugin_free_buffer(uuid_ptr, uuid_len)
    !uuid_free_status
    !write_status
    !writer_status
    !url_ptr
    !url_len
    !port_u64
    !remote_ptr
    !remote_len
    !uuid_status
    !uuid_ptr
    !uuid_len
    !host_ptr
    !host_len
    !port
    !cfg_ptr
    !req
    return 0

