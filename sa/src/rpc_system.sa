@ffi_wrapper send_rpc_thread_unsubscribe(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    thread_id = call @rpc_resolve_thread_id(&state_ptr, &body, body_len, 0)
    slot = call @state_thread_find(&state_ptr, thread_id)
    missing = eq slot, 0
    br missing -> L_UNSUB_NOT_LOADED, L_UNSUB_NOT_SUBSCRIBED

L_UNSUB_NOT_SUBSCRIBED:
    !missing
    !slot
    call @send_rpc_status_with_id(&req, &id_ptr, id_len, &RPC_SYS_JSON_VALUE_NOT_SUBSCRIBED, RPC_SYS_JSON_VALUE_NOT_SUBSCRIBED_LEN)
    !thread_id
    !state_ptr
    !body
    !body_len
    !req
    return 0
L_UNSUB_NOT_LOADED:
    !missing
    !slot
    call @send_rpc_status_with_id(&req, &id_ptr, id_len, &RPC_SYS_JSON_VALUE_NOT_LOADED, RPC_SYS_JSON_VALUE_NOT_LOADED_LEN)
    !thread_id
    !state_ptr
    !body
    !body_len
    !req
    return 0

