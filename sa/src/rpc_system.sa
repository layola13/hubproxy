@ffi_wrapper send_rpc_chatgpt_tokens_refresh(&req: ptr, &id_ptr: ptr, id_len: u64) -> u32:
L_ENTRY:
    iso_ptr_slot = stack_alloc 8
    iso_len_slot = stack_alloc 8
    iso_status = call @plugin_date_now_iso(&iso_ptr_slot, &iso_len_slot)
    iso_ptr = load iso_ptr_slot+0 as ptr
    iso_len = load iso_len_slot+0 as u64
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    write_status = call @json_writer_write_chatgpt_tokens_refresh_result(writer, &iso_ptr, iso_len)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    iso_free = call @plugin_free_buffer(iso_ptr, iso_len)
    !iso_free
    !write_status
    !writer_status
    !iso_status
    !iso_ptr
    !iso_len
    !req
    return 0

@ffi_wrapper json_writer_write_config_read_result(writer: ptr, &cfg_ptr: ptr) -> u32:
L_ENTRY:
    host_ptr = load cfg_ptr+CFG_HOST_PTR as ptr
    host_len = load cfg_ptr+CFG_HOST_LEN as u64
    port = load cfg_ptr+CFG_PORT as u16
    port_u64 = zext port
    rbase_ptr = load cfg_ptr+CFG_RBASE_PTR as ptr
    rbase_len = load cfg_ptr+CFG_RBASE_LEN as u64
    chat_ptr = load cfg_ptr+CFG_CHAT_PTR as ptr
    chat_len = load cfg_ptr+CFG_CHAT_LEN as u64
    model_ptr = load cfg_ptr+CFG_MODEL_PTR as ptr
    model_len = load cfg_ptr+CFG_MODEL_LEN as u64
    auth_ptr = load cfg_ptr+CFG_AUTH_PTR as ptr
    auth_len = load cfg_ptr+CFG_AUTH_LEN as u64
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    config_begin_status = call @json_writer_begin_field_object(writer, &RPC_SYS_JSON_KEY_CONFIG, RPC_SYS_JSON_KEY_CONFIG_LEN)
    host_field_status = call @json_writer_field_string_or_empty(writer, &RPC_SYS_JSON_KEY_HOST, RPC_SYS_JSON_KEY_HOST_LEN, &host_ptr, host_len)
    port_i64 = bitcast port_u64 as i64
    EXPAND JSON_WRITER_FIELD_I64 port_field_status, writer, RPC_SYS_JSON_KEY_PORT, RPC_SYS_JSON_KEY_PORT_LEN, port_i64
    rbase_field_status = call @json_writer_field_default_or_null(writer, &RPC_SYS_JSON_KEY_RESPONSES_BASE_URL, RPC_SYS_JSON_KEY_RESPONSES_BASE_URL_LEN, &rbase_ptr, rbase_len, 1)
    chat_field_status = call @json_writer_field_string_or_empty(writer, &RPC_SYS_JSON_KEY_CHAT_BASE_URL, RPC_SYS_JSON_KEY_CHAT_BASE_URL_LEN, &chat_ptr, chat_len)
    model_field_status = call @json_writer_field_string_or_empty(writer, &RPC_SYS_JSON_KEY_DEFAULT_MODEL, RPC_SYS_JSON_KEY_DEFAULT_MODEL_LEN, &model_ptr, model_len)
    auth_field_status = call @json_writer_field_default_or_null(writer, &RPC_SYS_JSON_KEY_AUTH_TOKEN, RPC_SYS_JSON_KEY_AUTH_TOKEN_LEN, &auth_ptr, auth_len, 1)
    EXPAND JSON_WRITER_END_OBJECT config_end_status, writer
    layers_field_status = call @json_writer_field_empty_array(writer, &RPC_SYS_JSON_KEY_LAYERS, RPC_SYS_JSON_KEY_LAYERS_LEN)
    origins_field_status = call @json_writer_field_empty_object(writer, &RPC_SYS_JSON_KEY_ORIGINS, RPC_SYS_JSON_KEY_ORIGINS_LEN)
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    !end_status
    !origins_field_status
    !layers_field_status
    !config_end_status
    !auth_field_status
    !model_field_status
    !chat_field_status
    !rbase_field_status
    !port_field_status
    !port_i64
    !host_field_status
    !config_begin_status
    !begin_status
    !host_ptr
    !host_len
    !port
    !port_u64
    !rbase_ptr
    !rbase_len
    !chat_ptr
    !chat_len
    !model_ptr
    !model_len
    !auth_ptr
    !auth_len
    !cfg_ptr
    !writer
    return 0

@ffi_wrapper send_rpc_config_read(&req: ptr, &id_ptr: ptr, id_len: u64, &cfg_ptr: ptr) -> u32:
L_ENTRY:
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    write_status = call @json_writer_write_config_read_result(writer, &cfg_ptr)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !write_status
    !writer_status
    !cfg_ptr
    !req
    return 0
@ffi_wrapper json_writer_write_plugin_read_result(writer: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    marketplace_ptr_slot = stack_alloc 8
    marketplace_len_slot = stack_alloc 8
    marketplace_path_ptr_slot = stack_alloc 8
    marketplace_path_len_slot = stack_alloc 8
    name_ptr_slot = stack_alloc 8
    name_len_slot = stack_alloc 8
    marketplace_extract_status = call @rpc_extract_string_or_default(&body, body_len, &RPC_SYS_J_REMOTE_MARKETPLACE_KEY, RPC_SYS_J_REMOTE_MARKETPLACE_KEY_LEN, &RPC_SYS_DEFAULT_LOCAL, RPC_SYS_DEFAULT_LOCAL_LEN, &marketplace_ptr_slot, &marketplace_len_slot)
    marketplace_path_extract_status = call @rpc_extract_param_string(&body, body_len, &RPC_SYS_J_MARKETPLACE_PATH_KEY, RPC_SYS_J_MARKETPLACE_PATH_KEY_LEN, &marketplace_path_ptr_slot, &marketplace_path_len_slot)
    name_extract_status = call @rpc_extract_string_or_default(&body, body_len, &RPC_SYS_J_PLUGIN_NAME_KEY, RPC_SYS_J_PLUGIN_NAME_KEY_LEN, &RPC_SYS_EMPTY_TEXT, RPC_SYS_EMPTY_TEXT_LEN, &name_ptr_slot, &name_len_slot)
    marketplace_ptr = load marketplace_ptr_slot+0 as ptr
    marketplace_len = load marketplace_len_slot+0 as u64
    name_ptr = load name_ptr_slot+0 as ptr
    name_len = load name_len_slot+0 as u64
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    plugin_begin_status = call @json_writer_begin_field_object(writer, &RPC_SYS_JSON_KEY_PLUGIN, RPC_SYS_JSON_KEY_PLUGIN_LEN)
    apps_status = call @json_writer_field_empty_array(writer, &RPC_SYS_JSON_KEY_APPS, RPC_SYS_JSON_KEY_APPS_LEN)
    EXPAND JSON_WRITER_FIELD_NULL description_status, writer, RPC_SYS_JSON_KEY_DESCRIPTION, RPC_SYS_JSON_KEY_DESCRIPTION_LEN
    hooks_status = call @json_writer_field_empty_array(writer, &RPC_SYS_JSON_KEY_HOOKS, RPC_SYS_JSON_KEY_HOOKS_LEN)
    EXPAND JSON_WRITER_FIELD_STRING marketplace_status, writer, RPC_SYS_JSON_KEY_MARKETPLACE_NAME, RPC_SYS_JSON_KEY_MARKETPLACE_NAME_LEN, marketplace_ptr, marketplace_len
    marketplace_path_found = eq marketplace_path_extract_status, 1
    br marketplace_path_found -> L_PLUGIN_READ_PATH_VALUE, L_PLUGIN_READ_PATH_NULL

L_PLUGIN_READ_PATH_VALUE:
    !marketplace_path_found
    marketplace_path_ptr = load marketplace_path_ptr_slot+0 as ptr
    marketplace_path_len = load marketplace_path_len_slot+0 as u64
    EXPAND JSON_WRITER_FIELD_STRING marketplace_path_status, writer, RPC_SYS_JSON_KEY_MARKETPLACE_PATH, RPC_SYS_JSON_KEY_MARKETPLACE_PATH_LEN, marketplace_path_ptr, marketplace_path_len
    mcp_status = call @json_writer_field_empty_array(writer, &RPC_SYS_JSON_KEY_MCP_SERVERS, RPC_SYS_JSON_KEY_MCP_SERVERS_LEN)
