    !value_extract_status
    !role_extract_status
    !thread_extract_status
    !thread_ptr
    !thread_len
    !role_ptr
    !role_len
    !value_ptr
    !value_len
    !state_ptr
    !event_ptr
    !event_len
    !body
    !body_len
    !value_key
    !value_key_len
    !mid
    !mid_len
    return 0

L_NOTIFY_RT_ROLE_TEXT:
    !is_delta
    EXPAND JSON_WRITER_FIELD_STRING value_status_text, writer, RPC_SYS_JSON_KEY_TEXT, RPC_SYS_JSON_KEY_TEXT_LEN, value_ptr, value_len
    EXPAND JSON_WRITER_END_OBJECT end_status_text, writer
