L_ENTRY:
    name_ptr_slot = stack_alloc 8
    name_len_slot = stack_alloc 8
    name_extract_status = call @rpc_extract_string_or_default(&body, body_len, &RPC_SYS_J_NAME_KEY, RPC_SYS_J_NAME_KEY_LEN, &RPC_SYS_DEFAULT_LOCAL, RPC_SYS_DEFAULT_LOCAL_LEN, &name_ptr_slot, &name_len_slot)
    name_ptr = load name_ptr_slot+0 as ptr
    name_len = load name_len_slot+0 as u64
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    EXPAND JSON_WRITER_FIELD_STRING name_status, writer, RPC_SYS_JSON_KEY_NAME, RPC_SYS_JSON_KEY_NAME_LEN, name_ptr, name_len
    EXPAND JSON_WRITER_FIELD_BOOL reloaded_status, writer, RPC_SYS_JSON_KEY_RELOADED, RPC_SYS_JSON_KEY_RELOADED_LEN, 1
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    !end_status
    !reloaded_status
    !name_status
    !begin_status
    !name_extract_status
    !name_ptr
    !name_len
