    os_len_slot = stack_alloc 8
    version_status = call @sa_deno_plugin_version_deno(&version_ptr_slot, &version_len_slot)
    cwd_status = call @sa_deno_plugin_cwd(&cwd_ptr_slot, &cwd_len_slot)
    family_status = call @sa_deno_plugin_build_platform_family(&family_ptr_slot, &family_len_slot)
    os_status = call @sa_deno_plugin_build_os(&os_ptr_slot, &os_len_slot)
    version_ptr = load version_ptr_slot+0 as ptr
