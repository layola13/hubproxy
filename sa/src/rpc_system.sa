@ffi_wrapper json_writer_write_plugin_share_delete_result(writer: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    remote_ptr_slot = stack_alloc 8
    remote_len_slot = stack_alloc 8
    remote_extract_status = call @rpc_extract_param_string(&body, body_len, &RPC_SYS_J_REMOTE_PLUGIN_ID_KEY, RPC_SYS_J_REMOTE_PLUGIN_ID_KEY_LEN, &remote_ptr_slot, &remote_len_slot)
