    EXPAND JSON_WRITER_FIELD_BOOL success_status, writer, RPC_SYS_JSON_KEY_SUCCESS, RPC_SYS_JSON_KEY_SUCCESS_LEN, 1
    EXPAND JSON_WRITER_FIELD_NULL error_status, writer, RPC_SYS_JSON_KEY_ERROR, RPC_SYS_JSON_KEY_ERROR_LEN
