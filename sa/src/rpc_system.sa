    !req
    return 0

@ffi_wrapper json_writer_write_environment_add_result(writer: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    name_ptr_slot = stack_alloc 8
    name_len_slot = stack_alloc 8
    path_ptr_slot = stack_alloc 8
    path_len_slot = stack_alloc 8
    name_extract_status = call @rpc_extract_string_or_default(&body, body_len, &RPC_SYS_FB_KEY_NAME, RPC_SYS_FB_KEY_NAME_LEN, &RPC_SYS_EMPTY_TEXT, RPC_SYS_EMPTY_TEXT_LEN, &name_ptr_slot, &name_len_slot)
    path_extract_status = call @rpc_extract_param_string(&body, body_len, &RPC_SYS_FB_KEY_PATH, RPC_SYS_FB_KEY_PATH_LEN, &path_ptr_slot, &path_len_slot)
    name_ptr = load name_ptr_slot+0 as ptr
    name_len = load name_len_slot+0 as u64
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    EXPAND JSON_WRITER_FIELD_BOOL added_status, writer, RPC_SYS_JSON_KEY_ADDED, RPC_SYS_JSON_KEY_ADDED_LEN, 1
    EXPAND JSON_WRITER_FIELD_STRING name_status, writer, RPC_SYS_JSON_KEY_NAME, RPC_SYS_JSON_KEY_NAME_LEN, name_ptr, name_len
    path_found = eq path_extract_status, 1
    br path_found -> L_ENV_ADD_PATH_VALUE, L_ENV_ADD_PATH_NULL

L_ENV_ADD_PATH_VALUE:
    !path_found
    path_ptr = load path_ptr_slot+0 as ptr
    path_len = load path_len_slot+0 as u64
    EXPAND JSON_WRITER_FIELD_STRING path_status, writer, RPC_SYS_JSON_KEY_PATH, RPC_SYS_JSON_KEY_PATH_LEN, path_ptr, path_len
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    !end_status
    !path_status
    !path_ptr
    !path_len
    !name_status
    !added_status
    !begin_status
    !name_extract_status
    !path_extract_status
    !name_ptr
    !name_len
    !body
    !body_len
    !writer
    return 0

L_ENV_ADD_PATH_NULL:
    !path_found
    EXPAND JSON_WRITER_FIELD_NULL path_status_null, writer, RPC_SYS_JSON_KEY_PATH, RPC_SYS_JSON_KEY_PATH_LEN
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    !end_status
    !path_status_null
    !name_status
    !added_status
    !begin_status
    !name_extract_status
    !path_extract_status
    !name_ptr
    !name_len
    !body
    !body_len
    !writer
    return 0

@ffi_wrapper send_rpc_environment_add(&req: ptr, &id_ptr: ptr, id_len: u64, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    write_status = call @json_writer_write_environment_add_result(writer, &body, body_len)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !write_status
    !writer_status
    !body
    !body_len
    !req
    return 0

@ffi_wrapper json_writer_write_review_start_result(writer: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    thread_ptr_slot = stack_alloc 8
    thread_len_slot = stack_alloc 8
    thread_extract_status = call @rpc_extract_string_or_default(&body, body_len, &RPC_SYS_FB_KEY_THREADID, RPC_SYS_FB_KEY_THREADID_LEN, &RPC_SYS_EMPTY_TEXT, RPC_SYS_EMPTY_TEXT_LEN, &thread_ptr_slot, &thread_len_slot)
    thread_ptr = load thread_ptr_slot+0 as ptr
    thread_len = load thread_len_slot+0 as u64
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    EXPAND JSON_WRITER_FIELD_STRING review_status, writer, RPC_SYS_JSON_KEY_REVIEW_THREAD_ID, RPC_SYS_JSON_KEY_REVIEW_THREAD_ID_LEN, thread_ptr, thread_len
    EXPAND JSON_WRITER_FIELD_STRING thread_status, writer, RPC_SYS_JSON_KEY_THREAD_ID, RPC_SYS_JSON_KEY_THREAD_ID_LEN, thread_ptr, thread_len
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    !end_status
    !thread_status
    !review_status
    !begin_status
    !thread_extract_status
    !thread_ptr
    !thread_len
    !body
    !body_len
    !writer
    return 0

@ffi_wrapper send_rpc_review_start(&req: ptr, &id_ptr: ptr, id_len: u64, &body: ptr, body_len: u64) -> u32:
