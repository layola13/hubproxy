@ffi_wrapper rpc_system_min_u64(a: u64, b: u64) -> u64:
L_ENTRY:
    a_le_b = ule a, b
    br a_le_b -> L_RPC_SYS_MIN_U64_A, L_RPC_SYS_MIN_U64_B

L_RPC_SYS_MIN_U64_A:
    !a_le_b
    !b
    return a

L_RPC_SYS_MIN_U64_B:
    !a_le_b
    !a
    return b

@ffi_wrapper b64_emit_char(&out: ptr, &out_i_slot: ptr, idx: u64) -> u32:
L_ENTRY:
    alphabet = &RPC_SYS_B64_ALPHABET
    char_ptr = ptr_add alphabet, idx
    ch = load char_ptr+0 as u8
    out_i = load out_i_slot+0 as u64
    dst = ptr_add out, out_i
    store dst+0, ch as u8
    next = add out_i, 1
    store out_i_slot+0, next as u64
    !next
    !dst
    !out_i
    !ch
    !char_ptr
    !alphabet
    !idx
    !out_i_slot
    !out
    return 0

@ffi_wrapper base64_encode_into(&src: ptr, src_len: u64, &out: ptr, &out_len_slot: ptr) -> u32:
L_ENTRY:
    i_slot = stack_alloc 8
    out_i_slot = stack_alloc 8
    has_b1_slot = stack_alloc 1
    has_b2_slot = stack_alloc 1
    store i_slot+0, 0 as u64
    store out_i_slot+0, 0 as u64
    jmp L_B64_COND

L_B64_COND:
    i = load i_slot+0 as u64
    done = uge i, src_len
    br done -> L_B64_DONE, L_B64_BODY

L_B64_BODY:
    !done
    p0 = ptr_add src, i
    b0u8 = load p0+0 as u8
    b0 = bitcast b0u8 as u64
    i1 = add i, 1
    has_b1 = ult i1, src_len
    store has_b1_slot+0, has_b1 as u8
    br has_b1 -> L_B64_LOAD_B1, L_B64_NO_B1

L_B64_LOAD_B1:
    !has_b1
    p1 = ptr_add src, i1
    b1u8 = load p1+0 as u8
    b1 = bitcast b1u8 as u64
    !b1u8
    !p1
    jmp L_B64_HAVE_B1

L_B64_NO_B1:
    !has_b1
    b1 = add 0, 0
    jmp L_B64_HAVE_B1

L_B64_HAVE_B1:
    i2 = add i, 2
    has_b2 = ult i2, src_len
    store has_b2_slot+0, has_b2 as u8
    br has_b2 -> L_B64_LOAD_B2, L_B64_NO_B2

L_B64_LOAD_B2:
    !has_b2
    p2 = ptr_add src, i2
    b2u8 = load p2+0 as u8
    b2 = bitcast b2u8 as u64
    !b2u8
    !p2
    jmp L_B64_ENCODE

L_B64_NO_B2:
    !has_b2
    b2 = add 0, 0
    jmp L_B64_ENCODE

L_B64_ENCODE:
    idx0 = udiv b0, 4
    b0_low = urem b0, 4
    b0_low_shift = mul b0_low, 16
    b1_hi = udiv b1, 16
    idx1 = add b0_low_shift, b1_hi
    b1_low = urem b1, 16
    b1_low_shift = mul b1_low, 4
    b2_hi = udiv b2, 64
    idx2 = add b1_low_shift, b2_hi
    idx3 = urem b2, 64
    call @b64_emit_char(&out, &out_i_slot, idx0)
    call @b64_emit_char(&out, &out_i_slot, idx1)
    has_b1_again = load has_b1_slot+0 as u8
    br has_b1_again -> L_B64_EMIT_2, L_B64_PAD_2

L_B64_EMIT_2:
    !has_b1_again
    call @b64_emit_char(&out, &out_i_slot, idx2)
    has_b2_again = load has_b2_slot+0 as u8
    br has_b2_again -> L_B64_EMIT_3, L_B64_PAD_3

L_B64_PAD_2:
    !has_b1_again
    out_i_a = load out_i_slot+0 as u64
    dst_a = ptr_add out, out_i_a
    store dst_a+0, 61 as u8
    next_a = add out_i_a, 1
    store out_i_slot+0, next_a as u64
    !next_a
    !dst_a
    !out_i_a
    out_i_b = load out_i_slot+0 as u64
    dst_b = ptr_add out, out_i_b
    store dst_b+0, 61 as u8
    next_b = add out_i_b, 1
    store out_i_slot+0, next_b as u64
    !next_b
    !dst_b
    !out_i_b
    jmp L_B64_NEXT

L_B64_EMIT_3:
    !has_b2_again
    call @b64_emit_char(&out, &out_i_slot, idx3)
    jmp L_B64_NEXT

L_B64_PAD_3:
    !has_b2_again
    out_i_c = load out_i_slot+0 as u64
    dst_c = ptr_add out, out_i_c
    store dst_c+0, 61 as u8
    next_c = add out_i_c, 1
    store out_i_slot+0, next_c as u64
    !next_c
    !dst_c
    !out_i_c
    jmp L_B64_NEXT

L_B64_NEXT:
    !idx0
    !b0_low
    !b0_low_shift
    !b1_hi
    !idx1
    !b1_low
    !b1_low_shift
    !b2_hi
    !idx2
    !idx3
    !b0u8
    !b0
    !b1
    !b2
    !p0
    !i1
    !i2
    next_i = add i, 3
    store i_slot+0, next_i as u64
    !next_i
    !i
    jmp L_B64_COND

L_B64_DONE:
    !done
    !i
    final_len = load out_i_slot+0 as u64
    store out_len_slot+0, final_len as u64
    !final_len
    !src
    !src_len
    !out
    !out_len_slot
    return 0

@ffi_wrapper rpc_extract_command_argv(&body: ptr, body_len: u64, &argv: ptr, &arg_storage: ptr, &out_count: ptr) -> u32:
L_ENTRY:
    store out_count+0, 0 as u64
    root = call @sa_json_parse(&body, body_len)
    has_root = ne root, 0
    br has_root -> L_CMD_DOM_ROOT, L_CMD_DOM_NO_ROOT

L_CMD_DOM_ROOT:
    !has_root
    params_slot = stack_alloc 8
    params_status = call @sa_json_object_get(root, &RPC_SYS_FB_KEY_PARAMS, RPC_SYS_FB_KEY_PARAMS_LEN, &params_slot)
    params_ok = eq params_status, 0
    br params_ok -> L_CMD_DOM_PARAMS, L_CMD_DOM_NO_PARAMS

L_CMD_DOM_PARAMS:
    !params_ok
    params_node = load params_slot+0 as ptr
    command_slot = stack_alloc 8
    command_status = call @sa_json_object_get(params_node, &RPC_SYS_JSON_KEY_COMMAND, RPC_SYS_JSON_KEY_COMMAND_LEN, &command_slot)
    command_ok = eq command_status, 0
    br command_ok -> L_CMD_DOM_COMMAND, L_CMD_DOM_NO_COMMAND

L_CMD_DOM_COMMAND:
    !command_ok
    command_node = load command_slot+0 as ptr
    command_kind = call @sa_json_kind(command_node)
    is_array = eq command_kind, SA_JSON_KIND_ARRAY
    br is_array -> L_CMD_DOM_COUNT, L_CMD_DOM_NOT_ARRAY

L_CMD_DOM_COUNT:
    !is_array
    array_count_slot = stack_alloc 8
    count_status = call @sa_json_value_count(command_node, &array_count_slot)
    count_ok = eq count_status, 0
    br count_ok -> L_CMD_DOM_LOOP_INIT, L_CMD_DOM_BAD_COUNT

L_CMD_DOM_LOOP_INIT:
    !count_ok
    array_count = load array_count_slot+0 as u64
    has_args = ugt array_count, 0
    br has_args -> L_CMD_DOM_LOOP_PREP, L_CMD_DOM_EMPTY

L_CMD_DOM_LOOP_PREP:
    !has_args
    index_slot = stack_alloc 8
    item_slot = stack_alloc 8
    store index_slot+0, 0 as u64
    jmp L_CMD_DOM_LOOP_COND

L_CMD_DOM_LOOP_COND:
    index = load index_slot+0 as u64
    at_array_end = uge index, array_count
    at_max = uge index, RPC_SYS_CMD_ARGV_MAX
    stop_any = or at_array_end, at_max
    br stop_any -> L_CMD_DOM_DONE, L_CMD_DOM_ITEM

L_CMD_DOM_ITEM:
    !stop_any
    item_status = call @sa_json_array_get(command_node, index, &item_slot)
    item_ok = eq item_status, 0
    br item_ok -> L_CMD_DOM_ITEM_KIND, L_CMD_DOM_BAD_ITEM

L_CMD_DOM_ITEM_KIND:
    !item_ok
    item_node = load item_slot+0 as ptr
    item_kind = call @sa_json_kind(item_node)
    is_string = eq item_kind, SA_JSON_KIND_STRING
    br is_string -> L_CMD_DOM_STORE_ITEM, L_CMD_DOM_BAD_ITEM_KIND

L_CMD_DOM_STORE_ITEM:
    !is_string
    arg_ptr = call @sa_json_string_ptr(item_node)
    arg_len = call @sa_json_string_len(item_node)
    copy_len = call @rpc_system_min_u64(arg_len, RPC_SYS_CMD_ARG_MAX_LEN)
    storage_off = mul index, RPC_SYS_CMD_ARG_MAX_LEN
    dst_ptr = ptr_add arg_storage, storage_off
    copied = call @copy_bytes_into(&dst_ptr, &arg_ptr, copy_len)
    argv_off = mul index, SaProcessArgv_SIZE
    argv_entry = ptr_add argv, argv_off
    store argv_entry+SaProcessArgv_data, dst_ptr as ptr
    store argv_entry+SaProcessArgv_len, copy_len as u64
    item_free = call @sa_json_free(^item_node)
    !item_free
    next_index = add index, 1
    store index_slot+0, next_index as u64
    !next_index
    !argv_entry
    !argv_off
    !copied
    !dst_ptr
    !storage_off
    !copy_len
    !arg_len
    !arg_ptr
    !item_kind
    !item_status
    !at_max
    !at_array_end
    !index
    jmp L_CMD_DOM_LOOP_COND

L_CMD_DOM_DONE:
    !stop_any
    !at_max
    !at_array_end
    final_count = load index_slot+0 as u64
    store out_count+0, final_count as u64
    command_free_done = call @sa_json_free(^command_node)
    params_free_done = call @sa_json_free(^params_node)
    root_free_done = call @sa_json_free(^root)
    !root_free_done
    !params_free_done
    !command_free_done
    !final_count
    !array_count
    !count_status
    !command_kind
    !command_status
    !params_status
    !body
    !body_len
    !argv
    !arg_storage
    !out_count
    return 1

L_CMD_DOM_BAD_ITEM_KIND:
    !is_string
    bad_item_free = call @sa_json_free(^item_node)
    !bad_item_free
    !item_kind
    !item_status
    jmp L_CMD_DOM_FAIL_LOOP

L_CMD_DOM_BAD_ITEM:
    !item_ok
    !item_status
    jmp L_CMD_DOM_FAIL_LOOP

L_CMD_DOM_FAIL_LOOP:
    command_free_fail = call @sa_json_free(^command_node)
    params_free_fail = call @sa_json_free(^params_node)
    root_free_fail = call @sa_json_free(^root)
    !root_free_fail
    !params_free_fail
    !command_free_fail
    !at_max
    !at_array_end
    !index
    !array_count
    !count_status
    !command_kind
    !command_status
    !params_status
    !body
    !body_len
    !argv
    !arg_storage
    !out_count
    return 0

L_CMD_DOM_EMPTY:
    !has_args
    command_free_empty = call @sa_json_free(^command_node)
    params_free_empty = call @sa_json_free(^params_node)
    root_free_empty = call @sa_json_free(^root)
    !root_free_empty
    !params_free_empty
    !command_free_empty
    !array_count
    !count_status
    !command_kind
    !command_status
    !params_status
    !body
    !body_len
    !argv
    !arg_storage
    !out_count
    return 0

L_CMD_DOM_BAD_COUNT:
    !count_ok
    command_free_count = call @sa_json_free(^command_node)
    params_free_count = call @sa_json_free(^params_node)
    root_free_count = call @sa_json_free(^root)
    !root_free_count
    !params_free_count
    !command_free_count
    !count_status
    !command_kind
    !command_status
    !params_status
    !body
    !body_len
    !argv
    !arg_storage
    !out_count
    return 0

L_CMD_DOM_NOT_ARRAY:
    !is_array
    command_free_bad = call @sa_json_free(^command_node)
    params_free_bad = call @sa_json_free(^params_node)
    root_free_bad = call @sa_json_free(^root)
    !root_free_bad
    !params_free_bad
    !command_free_bad
    !command_kind
    !command_status
    !params_status
    !body
    !body_len
    !argv
    !arg_storage
    !out_count
    return 0

L_CMD_DOM_NO_COMMAND:
    !command_ok
    params_free_no_command = call @sa_json_free(^params_node)
    root_free_no_command = call @sa_json_free(^root)
    !root_free_no_command
    !params_free_no_command
    !command_status
    !params_status
    !body
    !body_len
    !argv
    !arg_storage
    !out_count
    return 0

L_CMD_DOM_NO_PARAMS:
    !params_ok
    root_free_no_params = call @sa_json_free(^root)
    !root_free_no_params
    !params_status
    !body
    !body_len
    !argv
    !arg_storage
    !out_count
    return 0

L_CMD_DOM_NO_ROOT:
    !has_root
    !root
    !body
    !body_len
    !argv
    !arg_storage
    !out_count
    return 0

@ffi_wrapper notify_command_output(&state_ptr: ptr, &process_id_ptr: ptr, process_id_len: u64, &stream_ptr: ptr, stream_len: u64, &data_ptr: ptr, data_len: u64) -> u32:
L_ENTRY:
    has_data = ugt data_len, 0
    br has_data -> L_CMD_NOTIFY_DO, L_CMD_NOTIFY_SKIP

L_CMD_NOTIFY_DO:
    !has_data
    b64_buf = stack_alloc RPC_SYS_CMD_OUTPUT_BUF_SIZE
    b64_len_slot = stack_alloc 8
    b64_status = call @base64_encode_into(&data_ptr, data_len, &b64_buf, &b64_len_slot)
    !b64_status
    b64_len = load b64_len_slot+0 as u64
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    EXPAND JSON_WRITER_FIELD_STRING pid_status, writer, RPC_SYS_JSON_KEY_PROCESS_ID, RPC_SYS_JSON_KEY_PROCESS_ID_LEN, process_id_ptr, process_id_len
    EXPAND JSON_WRITER_FIELD_STRING stream_status, writer, RPC_SYS_JSON_KEY_STREAM, RPC_SYS_JSON_KEY_STREAM_LEN, stream_ptr, stream_len
    EXPAND JSON_WRITER_FIELD_STRING delta_status, writer, RPC_SYS_JSON_KEY_DELTA_BASE64, RPC_SYS_JSON_KEY_DELTA_BASE64_LEN, b64_buf, b64_len
    EXPAND JSON_WRITER_FIELD_BOOL cap_status, writer, RPC_SYS_JSON_KEY_CAP_REACHED, RPC_SYS_JSON_KEY_CAP_REACHED_LEN, 0
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    call @notify_writer_params(&state_ptr, &RPC_SYS_EV_CMD_OUTPUT, RPC_SYS_EV_CMD_OUTPUT_LEN, writer)
    !end_status
    !cap_status
    !delta_status
    !stream_status
    !pid_status
    !begin_status
    !writer_status
    !b64_len
    !state_ptr
    !process_id_ptr
    !process_id_len
    !stream_ptr
    !stream_len
    !data_ptr
    !data_len
    return 0

L_CMD_NOTIFY_SKIP:
    !has_data
    !state_ptr
    !process_id_ptr
    !process_id_len
    !stream_ptr
    !stream_len
    !data_ptr
    !data_len
    return 0

@ffi_wrapper json_writer_write_command_exec_result(writer: ptr, exit_code: u64, &stdout_ptr: ptr, stdout_len: u64, &stderr_ptr: ptr, stderr_len: u64) -> u32:
L_ENTRY:
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    exit_i64 = bitcast exit_code as i64
    EXPAND JSON_WRITER_FIELD_I64 exit_field, writer, RPC_SYS_JSON_KEY_EXIT_CODE, RPC_SYS_JSON_KEY_EXIT_CODE_LEN, exit_i64
    EXPAND JSON_WRITER_FIELD_STRING stdout_field, writer, RPC_SYS_JSON_KEY_STDOUT, RPC_SYS_JSON_KEY_STDOUT_LEN, stdout_ptr, stdout_len
    EXPAND JSON_WRITER_FIELD_STRING stderr_field, writer, RPC_SYS_JSON_KEY_STDERR, RPC_SYS_JSON_KEY_STDERR_LEN, stderr_ptr, stderr_len
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    !end_status
    !stderr_field
    !stdout_field
    !exit_field
    !exit_i64
    !begin_status
    !exit_code
    !stdout_ptr
    !stdout_len
    !stderr_ptr
    !stderr_len
    !writer
    return 0

@ffi_wrapper send_rpc_command_exec(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    argv = stack_alloc RPC_SYS_CMD_ARGV_BUF_SIZE
    arg_storage = stack_alloc RPC_SYS_CMD_ARG_STORAGE_SIZE
    count_slot = stack_alloc 8
    parse_ok = call @rpc_extract_command_argv(&body, body_len, &argv, &arg_storage, &count_slot)
    has_command = eq parse_ok, 1
    !parse_ok
    br has_command -> L_CMD_EXEC_PROCESS_ID, L_CMD_EXEC_DEFAULT_COMMAND

L_CMD_EXEC_DEFAULT_COMMAND:
    !has_command
    default_arg_ptr = &RPC_SYS_DEFAULT_TRUE
    store argv+SaProcessArgv_data, default_arg_ptr as ptr
    store argv+SaProcessArgv_len, RPC_SYS_DEFAULT_TRUE_LEN as u64
    store count_slot+0, 1 as u64
    !default_arg_ptr
    jmp L_CMD_EXEC_PROCESS_ID_FROM_DEFAULT

L_CMD_EXEC_PROCESS_ID:
    !has_command

L_CMD_EXEC_PROCESS_ID_FROM_DEFAULT:
    process_id_ptr_slot = stack_alloc 8
    process_id_len_slot = stack_alloc 8
    pid_status = call @rpc_extract_param_string(&body, body_len, &RPC_SYS_J_PROCESS_ID_KEY, RPC_SYS_J_PROCESS_ID_KEY_LEN, &process_id_ptr_slot, &process_id_len_slot)
    has_pid = eq pid_status, 1
    !pid_status
    br has_pid -> L_CMD_EXEC_WITH_PID, L_CMD_EXEC_DEFAULT_PID

L_CMD_EXEC_WITH_PID:
    !has_pid
    jmp L_CMD_EXEC_RUN

L_CMD_EXEC_DEFAULT_PID:
    !has_pid
    default_pid_ptr = &RPC_SYS_DEFAULT_PROCESS_ID
    store process_id_ptr_slot+0, default_pid_ptr as ptr
    store process_id_len_slot+0, RPC_SYS_DEFAULT_PROCESS_ID_LEN as u64
    !default_pid_ptr
    jmp L_CMD_EXEC_RUN

L_CMD_EXEC_RUN:
    process_id_ptr = load process_id_ptr_slot+0 as ptr
    process_id_len = load process_id_len_slot+0 as u64
    cwd_ptr_slot = stack_alloc 8
    cwd_len_slot = stack_alloc 8
    cwd_status = call @rpc_extract_param_string(&body, body_len, &RPC_SYS_J_CWD_KEY, RPC_SYS_J_CWD_KEY_LEN, &cwd_ptr_slot, &cwd_len_slot)
    has_cwd = eq cwd_status, 1
    !cwd_status
    br has_cwd -> L_CMD_EXEC_RUN_WITH_CWD_DIRECT, L_CMD_EXEC_DEFAULT_CWD

L_CMD_EXEC_DEFAULT_CWD:
    !has_cwd
    default_cwd_ptr = &RPC_SYS_DEFAULT_CWD
    store cwd_ptr_slot+0, default_cwd_ptr as ptr
    store cwd_len_slot+0, RPC_SYS_DEFAULT_CWD_LEN as u64
    !default_cwd_ptr
    jmp L_CMD_EXEC_RUN_AFTER_CWD

L_CMD_EXEC_RUN_WITH_CWD_DIRECT:
    !has_cwd
    jmp L_CMD_EXEC_RUN_AFTER_CWD

L_CMD_EXEC_RUN_AFTER_CWD:
    cwd_ptr = load cwd_ptr_slot+0 as ptr
    cwd_len = load cwd_len_slot+0 as u64
    count = load count_slot+0 as u64
    EXPAND DENO_COMMAND_RUN_CWD run_status, process_handle, argv, count, cwd_ptr, cwd_len
    run_ok = eq run_status, 0
    !run_status
    br run_ok -> L_CMD_EXEC_WAIT, L_CMD_EXEC_RUN_ERR

L_CMD_EXEC_WAIT:
    !run_ok
    EXPAND DENO_COMMAND_WAIT wait_status, exit_code_u32, process_handle
    wait_ok = eq wait_status, 0
    !wait_status
    br wait_ok -> L_CMD_EXEC_READ, L_CMD_EXEC_WAIT_ERR

L_CMD_EXEC_READ:
    !wait_ok
    stdout_buf = stack_alloc RPC_SYS_CMD_OUTPUT_BUF_SIZE
    stderr_buf = stack_alloc RPC_SYS_CMD_OUTPUT_BUF_SIZE
    EXPAND DENO_COMMAND_READ_STDOUT stdout_status, stdout_len, process_handle, stdout_buf, RPC_SYS_CMD_OUTPUT_BUF_SIZE
    EXPAND DENO_COMMAND_READ_STDERR stderr_status, stderr_len, process_handle, stderr_buf, RPC_SYS_CMD_OUTPUT_BUF_SIZE
    !stdout_status
    !stderr_status
    exit_code = zext exit_code_u32
    call @notify_command_output(&state_ptr, &process_id_ptr, process_id_len, &RPC_SYS_STREAM_STDOUT, RPC_SYS_STREAM_STDOUT_LEN, &stdout_buf, stdout_len)
    call @notify_command_output(&state_ptr, &process_id_ptr, process_id_len, &RPC_SYS_STREAM_STDERR, RPC_SYS_STREAM_STDERR_LEN, &stderr_buf, stderr_len)
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    write_status = call @json_writer_write_command_exec_result(writer, exit_code, &stdout_buf, stdout_len, &stderr_buf, stderr_len)
    !write_status
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !writer_status
    EXPAND DENO_COMMAND_CLOSE close_status, process_handle
    !close_status
    !exit_code_u32
    !exit_code
    !stdout_len
    !stderr_len
    !process_handle
    !count
    !cwd_ptr
    !cwd_len
    !process_id_ptr
    !process_id_len
    !body
    !body_len
    !state_ptr
    !req
    return 0

L_CMD_EXEC_RUN_ERR:
    !run_ok
    !process_handle
    !count
    !cwd_ptr
    !cwd_len
    !process_id_ptr
    !process_id_len
    call @send_error_with_id(&req, 500, &id_ptr, id_len, &RPC_SYS_J_ERR_FS, RPC_SYS_J_ERR_FS_LEN)
    !body
    !body_len
    !state_ptr
    !req
    return 0

L_CMD_EXEC_WAIT_ERR:
    !wait_ok
    !exit_code_u32
    EXPAND DENO_COMMAND_CLOSE close_status_err, process_handle
    !close_status_err
    !process_handle
    !count
    !cwd_ptr
    !cwd_len
    !process_id_ptr
    !process_id_len
    call @send_error_with_id(&req, 500, &id_ptr, id_len, &RPC_SYS_J_ERR_FS, RPC_SYS_J_ERR_FS_LEN)
    !body
    !body_len
    !state_ptr
    !req
    return 0

@ffi_wrapper notify_process_output(&state_ptr: ptr, &handle_ptr: ptr, handle_len: u64, &stream_ptr: ptr, stream_len: u64, &data_ptr: ptr, data_len: u64) -> u32:
L_ENTRY:
    has_data = ugt data_len, 0
    br has_data -> L_PROC_NOTIFY_DO, L_PROC_NOTIFY_SKIP

L_PROC_NOTIFY_DO:
    !has_data
    b64_buf = stack_alloc RPC_SYS_CMD_OUTPUT_BUF_SIZE
    b64_len_slot = stack_alloc 8
    b64_status = call @base64_encode_into(&data_ptr, data_len, &b64_buf, &b64_len_slot)
    !b64_status
    b64_len = load b64_len_slot+0 as u64
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    EXPAND JSON_WRITER_FIELD_STRING handle_status, writer, RPC_SYS_JSON_KEY_PROCESS_HANDLE, RPC_SYS_JSON_KEY_PROCESS_HANDLE_LEN, handle_ptr, handle_len
    EXPAND JSON_WRITER_FIELD_STRING stream_status, writer, RPC_SYS_JSON_KEY_STREAM, RPC_SYS_JSON_KEY_STREAM_LEN, stream_ptr, stream_len
    EXPAND JSON_WRITER_FIELD_STRING delta_status, writer, RPC_SYS_JSON_KEY_DELTA_BASE64, RPC_SYS_JSON_KEY_DELTA_BASE64_LEN, b64_buf, b64_len
    EXPAND JSON_WRITER_FIELD_BOOL cap_status, writer, RPC_SYS_JSON_KEY_CAP_REACHED, RPC_SYS_JSON_KEY_CAP_REACHED_LEN, 0
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    call @notify_writer_params(&state_ptr, &RPC_SYS_EV_PROCESS_OUTPUT, RPC_SYS_EV_PROCESS_OUTPUT_LEN, writer)
    !end_status
    !cap_status
    !delta_status
    !stream_status
    !handle_status
    !begin_status
    !writer_status
    !b64_len
    !state_ptr
    !handle_ptr
    !handle_len
    !stream_ptr
    !stream_len
    !data_ptr
    !data_len
    return 0

L_PROC_NOTIFY_SKIP:
    !has_data
    !state_ptr
    !handle_ptr
    !handle_len
    !stream_ptr
    !stream_len
    !data_ptr
    !data_len
    return 0

@ffi_wrapper notify_process_exited(&state_ptr: ptr, &handle_ptr: ptr, handle_len: u64, exit_code: u64, &stdout_ptr: ptr, stdout_len: u64, &stderr_ptr: ptr, stderr_len: u64) -> u32:
L_ENTRY:
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    EXPAND JSON_WRITER_FIELD_STRING handle_field, writer, RPC_SYS_JSON_KEY_PROCESS_HANDLE, RPC_SYS_JSON_KEY_PROCESS_HANDLE_LEN, handle_ptr, handle_len
    exit_i64 = bitcast exit_code as i64
    EXPAND JSON_WRITER_FIELD_I64 exit_field, writer, RPC_SYS_JSON_KEY_EXIT_CODE, RPC_SYS_JSON_KEY_EXIT_CODE_LEN, exit_i64
    EXPAND JSON_WRITER_FIELD_STRING stdout_field, writer, RPC_SYS_JSON_KEY_STDOUT, RPC_SYS_JSON_KEY_STDOUT_LEN, stdout_ptr, stdout_len
    EXPAND JSON_WRITER_FIELD_BOOL stdout_cap_field, writer, RPC_SYS_JSON_KEY_STDOUT_CAP, RPC_SYS_JSON_KEY_STDOUT_CAP_LEN, 0
    EXPAND JSON_WRITER_FIELD_STRING stderr_field, writer, RPC_SYS_JSON_KEY_STDERR, RPC_SYS_JSON_KEY_STDERR_LEN, stderr_ptr, stderr_len
    EXPAND JSON_WRITER_FIELD_BOOL stderr_cap_field, writer, RPC_SYS_JSON_KEY_STDERR_CAP, RPC_SYS_JSON_KEY_STDERR_CAP_LEN, 0
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    notify_status = call @notify_writer_params(&state_ptr, &RPC_SYS_EV_PROCESS_EXITED, RPC_SYS_EV_PROCESS_EXITED_LEN, writer)
    !notify_status
    !end_status
    !stderr_cap_field
    !stderr_field
    !stdout_cap_field
    !stdout_field
    !exit_field
    !exit_i64
    !handle_field
    !begin_status
    !writer_status
    !state_ptr
    !handle_ptr
    !handle_len
    !exit_code
    !stdout_ptr
    !stdout_len
    !stderr_ptr
    !stderr_len
    return 0

@ffi_wrapper json_writer_write_process_spawn_result(writer: ptr, &handle_ptr: ptr, handle_len: u64) -> u32:
L_ENTRY:
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    EXPAND JSON_WRITER_FIELD_STRING handle_field, writer, RPC_SYS_JSON_KEY_PROCESS_HANDLE, RPC_SYS_JSON_KEY_PROCESS_HANDLE_LEN, handle_ptr, handle_len
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    !end_status
    !handle_field
    !begin_status
    !handle_ptr
    !handle_len
    !writer
    return 0

@ffi_wrapper send_rpc_process_spawn(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    argv = stack_alloc RPC_SYS_CMD_ARGV_BUF_SIZE
    arg_storage = stack_alloc RPC_SYS_CMD_ARG_STORAGE_SIZE
    count_slot = stack_alloc 8
    parse_ok = call @rpc_extract_command_argv(&body, body_len, &argv, &arg_storage, &count_slot)
    has_command = eq parse_ok, 1
    !parse_ok
    br has_command -> L_PROC_HANDLE, L_PROC_DEFAULT_COMMAND

L_PROC_DEFAULT_COMMAND:
    !has_command
    default_arg_ptr = &RPC_SYS_DEFAULT_TRUE
    store argv+SaProcessArgv_data, default_arg_ptr as ptr
    store argv+SaProcessArgv_len, RPC_SYS_DEFAULT_TRUE_LEN as u64
    store count_slot+0, 1 as u64
    !default_arg_ptr
    jmp L_PROC_HANDLE_FROM_DEFAULT

L_PROC_HANDLE:
    !has_command

L_PROC_HANDLE_FROM_DEFAULT:
    handle_ptr_slot = stack_alloc 8
    handle_len_slot = stack_alloc 8
    handle_status = call @rpc_extract_param_string(&body, body_len, &RPC_SYS_J_PROCESS_HANDLE_KEY, RPC_SYS_J_PROCESS_HANDLE_KEY_LEN, &handle_ptr_slot, &handle_len_slot)
    has_handle = eq handle_status, 1
    !handle_status
    br has_handle -> L_PROC_RUN, L_PROC_DEFAULT_HANDLE

L_PROC_DEFAULT_HANDLE:
    !has_handle
    default_handle_ptr = &RPC_SYS_DEFAULT_PROCESS_HANDLE
    store handle_ptr_slot+0, default_handle_ptr as ptr
    store handle_len_slot+0, RPC_SYS_DEFAULT_PROCESS_HANDLE_LEN as u64
    !default_handle_ptr
    jmp L_PROC_RUN_FROM_DEFAULT

L_PROC_RUN:
    !has_handle

L_PROC_RUN_FROM_DEFAULT:
    handle_ptr = load handle_ptr_slot+0 as ptr
    handle_len = load handle_len_slot+0 as u64
    cwd_ptr_slot = stack_alloc 8
    cwd_len_slot = stack_alloc 8
    cwd_status = call @rpc_extract_param_string(&body, body_len, &RPC_SYS_J_CWD_KEY, RPC_SYS_J_CWD_KEY_LEN, &cwd_ptr_slot, &cwd_len_slot)
    has_cwd = eq cwd_status, 1
    !cwd_status
    br has_cwd -> L_PROC_RUN_WITH_CWD_DIRECT, L_PROC_DEFAULT_CWD

L_PROC_DEFAULT_CWD:
    !has_cwd
    default_cwd_ptr = &RPC_SYS_DEFAULT_CWD
    store cwd_ptr_slot+0, default_cwd_ptr as ptr
    store cwd_len_slot+0, RPC_SYS_DEFAULT_CWD_LEN as u64
    !default_cwd_ptr
    jmp L_PROC_RUN_AFTER_CWD

L_PROC_RUN_WITH_CWD_DIRECT:
    !has_cwd
    jmp L_PROC_RUN_AFTER_CWD

L_PROC_RUN_AFTER_CWD:
    cwd_ptr = load cwd_ptr_slot+0 as ptr
    cwd_len = load cwd_len_slot+0 as u64
    count = load count_slot+0 as u64
    EXPAND DENO_COMMAND_RUN_CWD run_status, process_handle, argv, count, cwd_ptr, cwd_len
    run_ok = eq run_status, 0
    !run_status
    br run_ok -> L_PROC_WAIT, L_PROC_RUN_ERR

L_PROC_WAIT:
    !run_ok
    EXPAND DENO_COMMAND_WAIT wait_status, exit_code_u32, process_handle
    wait_ok = eq wait_status, 0
    !wait_status
    br wait_ok -> L_PROC_READ, L_PROC_WAIT_ERR

L_PROC_READ:
    !wait_ok
    stdout_buf = stack_alloc RPC_SYS_CMD_OUTPUT_BUF_SIZE
    stderr_buf = stack_alloc RPC_SYS_CMD_OUTPUT_BUF_SIZE
    EXPAND DENO_COMMAND_READ_STDOUT stdout_status, stdout_len, process_handle, stdout_buf, RPC_SYS_CMD_OUTPUT_BUF_SIZE
    EXPAND DENO_COMMAND_READ_STDERR stderr_status, stderr_len, process_handle, stderr_buf, RPC_SYS_CMD_OUTPUT_BUF_SIZE
    !stdout_status
    !stderr_status
    exit_code = zext exit_code_u32
    proc_put_status = call @state_process_put(&state_ptr, &handle_ptr, handle_len)
    !proc_put_status
    call @notify_process_output(&state_ptr, &handle_ptr, handle_len, &RPC_SYS_STREAM_STDOUT, RPC_SYS_STREAM_STDOUT_LEN, &stdout_buf, stdout_len)
    call @notify_process_output(&state_ptr, &handle_ptr, handle_len, &RPC_SYS_STREAM_STDERR, RPC_SYS_STREAM_STDERR_LEN, &stderr_buf, stderr_len)
    call @notify_process_exited(&state_ptr, &handle_ptr, handle_len, exit_code, &stdout_buf, stdout_len, &stderr_buf, stderr_len)
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    write_status = call @json_writer_write_process_spawn_result(writer, &handle_ptr, handle_len)
    !write_status
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !writer_status
    EXPAND DENO_COMMAND_CLOSE close_status, process_handle
    !close_status
    !exit_code_u32
    !exit_code
    !stdout_len
    !stderr_len
    !process_handle
    !count
    !cwd_ptr
    !cwd_len
    !handle_ptr
    !handle_len
    !body
    !body_len
    !state_ptr
    !req
    return 0

L_PROC_RUN_ERR:
    !run_ok
    !process_handle
    !count
    !cwd_ptr
    !cwd_len
    !handle_ptr
    !handle_len
    call @send_error_with_id(&req, 500, &id_ptr, id_len, &RPC_SYS_J_ERR_FS, RPC_SYS_J_ERR_FS_LEN)
    !body
    !body_len
    !state_ptr
    !req
    return 0

L_PROC_WAIT_ERR:
    !wait_ok
    !exit_code_u32
    EXPAND DENO_COMMAND_CLOSE close_status_err, process_handle
    !close_status_err
    !process_handle
    !count
    !cwd_ptr
    !cwd_len
    !handle_ptr
    !handle_len
    call @send_error_with_id(&req, 500, &id_ptr, id_len, &RPC_SYS_J_ERR_FS, RPC_SYS_J_ERR_FS_LEN)
    !body
    !body_len
    !state_ptr
    !req
    return 0

@ffi_wrapper send_rpc_process_kill(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    handle_ptr_slot = stack_alloc 8
    handle_len_slot = stack_alloc 8
    handle_status = call @rpc_extract_param_string(&body, body_len, &RPC_SYS_J_PROCESS_HANDLE_KEY, RPC_SYS_J_PROCESS_HANDLE_KEY_LEN, &handle_ptr_slot, &handle_len_slot)
    has_handle = eq handle_status, 1
    !handle_status
    br has_handle -> L_PK_DELETE, L_PK_FALSE

L_PK_DELETE:
    !has_handle
    handle_ptr = load handle_ptr_slot+0 as ptr
    handle_len = load handle_len_slot+0 as u64
    deleted = call @state_process_delete(&state_ptr, &handle_ptr, handle_len)
    is_deleted = eq deleted, 1
    !deleted
    br is_deleted -> L_PK_TRUE, L_PK_FALSE_WITH_HANDLE

L_PK_TRUE:
    !is_deleted
    call @send_rpc_bool_field_with_id(&req, &id_ptr, id_len, &RPC_SYS_JSON_KEY_OK, RPC_SYS_JSON_KEY_OK_LEN, 1)
    !handle_ptr
    !handle_len
    !body
    !body_len
    !state_ptr
    !req
    return 0

L_PK_FALSE_WITH_HANDLE:
    !is_deleted
    !handle_ptr
    !handle_len
    jmp L_PK_FALSE_FROM_HANDLE

L_PK_FALSE:
    !has_handle
    jmp L_PK_FALSE_FROM_HANDLE

L_PK_FALSE_FROM_HANDLE:
    call @send_rpc_bool_field_with_id(&req, &id_ptr, id_len, &RPC_SYS_JSON_KEY_OK, RPC_SYS_JSON_KEY_OK_LEN, 0)
    !body
    !body_len
    !state_ptr
    !req
    return 0


@ffi_wrapper json_writer_write_send_credits_result(writer: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    email_ptr_slot = stack_alloc 8
    email_len_slot = stack_alloc 8
    email_extract_status = call @rpc_extract_param_string(&body, body_len, &RPC_SYS_J_EMAIL_KEY, RPC_SYS_J_EMAIL_KEY_LEN, &email_ptr_slot, &email_len_slot)
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    EXPAND JSON_WRITER_FIELD_STRING status_field_status, writer, RPC_SYS_JSON_KEY_STATUS, RPC_SYS_JSON_KEY_STATUS_LEN, RPC_SYS_JSON_VALUE_SENT, RPC_SYS_JSON_VALUE_SENT_LEN
    email_found = eq email_extract_status, 1
    br email_found -> L_SEND_CREDITS_EMAIL_FOUND, L_SEND_CREDITS_EMAIL_NULL

L_SEND_CREDITS_EMAIL_FOUND:
    !email_found
    email_ptr = load email_ptr_slot+0 as ptr
    email_len = load email_len_slot+0 as u64
    EXPAND JSON_WRITER_FIELD_STRING email_status, writer, RPC_SYS_JSON_KEY_EMAIL, RPC_SYS_JSON_KEY_EMAIL_LEN, email_ptr, email_len
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    !end_status
    !email_status
    !status_field_status
    !begin_status
    !email_extract_status
    !email_ptr
    !email_len
    !body
    !body_len
    !writer
    return 0

L_SEND_CREDITS_EMAIL_NULL:
    !email_found
    EXPAND JSON_WRITER_FIELD_NULL email_status_null, writer, RPC_SYS_JSON_KEY_EMAIL, RPC_SYS_JSON_KEY_EMAIL_LEN
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    !end_status
    !email_status_null
    !status_field_status
    !begin_status
    !email_extract_status
    !body
    !body_len
    !writer
    return 0

@ffi_wrapper send_rpc_send_credits(&req: ptr, &id_ptr: ptr, id_len: u64, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    write_status = call @json_writer_write_send_credits_result(writer, &body, body_len)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !write_status
    !writer_status
    !body
    !body_len
    !req
    return 0

@ffi_wrapper json_writer_write_attestation_result(writer: ptr, &token_ptr: ptr, token_len: u64) -> u32:
L_ENTRY:
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    EXPAND JSON_WRITER_FIELD_STRING token_status, writer, RPC_SYS_JSON_KEY_TOKEN, RPC_SYS_JSON_KEY_TOKEN_LEN, token_ptr, token_len
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    !end_status
    !token_status
    !begin_status
    !writer
    !token_ptr
    !token_len
    return 0

@ffi_wrapper send_rpc_attestation_generate(&req: ptr, &id_ptr: ptr, id_len: u64) -> u32:
L_ENTRY:
    uuid_ptr_slot = stack_alloc 8
    uuid_len_slot = stack_alloc 8
    uuid_status = call @plugin_random_uuid(&uuid_ptr_slot, &uuid_len_slot)
    uuid_ptr = load uuid_ptr_slot+0 as ptr
    uuid_len = load uuid_len_slot+0 as u64
    token_len_slot = stack_alloc 8
    token_ptr = call @prefix_with_owned(&RPC_SYS_STRING_ATTEST_PREFIX, RPC_SYS_STRING_ATTEST_PREFIX_LEN, &uuid_ptr, uuid_len, &token_len_slot)
    token_len = load token_len_slot+0 as u64
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    write_status = call @json_writer_write_attestation_result(writer, &token_ptr, token_len)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    uuid_free_status = call @plugin_free_buffer(uuid_ptr, uuid_len)
    !uuid_free_status
    !write_status
    !writer_status
    !token_ptr
    !token_len
    !uuid_status
    !uuid_ptr
    !uuid_len
    !req
    return 0

@ffi_wrapper json_writer_write_external_detect_result(writer: ptr, &cwd_ptr: ptr, cwd_len: u64) -> u32:
L_ENTRY:
    agents_path_len_slot = stack_alloc 8
    agents_path = call @path_join_owned(&cwd_ptr, cwd_len, &RPC_SYS_STRING_AGENTS_PATH_SUFFIX, RPC_SYS_STRING_AGENTS_PATH_SUFFIX_LEN, &agents_path_len_slot)
    agents_path_len = load agents_path_len_slot+0 as u64
    env_path_len_slot = stack_alloc 8
    env_path = call @path_join_owned(&cwd_ptr, cwd_len, &RPC_SYS_STRING_ENV_PATH_SUFFIX, RPC_SYS_STRING_ENV_PATH_SUFFIX_LEN, &env_path_len_slot)
    env_path_len = load env_path_len_slot+0 as u64
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    items_begin_status = call @json_writer_begin_field_array(writer, &RPC_SYS_JSON_KEY_ITEMS, RPC_SYS_JSON_KEY_ITEMS_LEN)
    EXPAND JSON_WRITER_BEGIN_OBJECT agents_begin_status, writer
    EXPAND JSON_WRITER_FIELD_STRING agents_type_status, writer, RPC_SYS_JSON_KEY_ITEM_TYPE, RPC_SYS_JSON_KEY_ITEM_TYPE_LEN, RPC_SYS_JSON_VALUE_AGENTS_MD, RPC_SYS_JSON_VALUE_AGENTS_MD_LEN
    EXPAND JSON_WRITER_FIELD_STRING agents_desc_status, writer, RPC_SYS_JSON_KEY_DESCRIPTION, RPC_SYS_JSON_KEY_DESCRIPTION_LEN, RPC_SYS_STRING_AGENTS_DESC, RPC_SYS_STRING_AGENTS_DESC_LEN
    EXPAND JSON_WRITER_FIELD_STRING agents_cwd_status, writer, RPC_SYS_JSON_KEY_CWD, RPC_SYS_JSON_KEY_CWD_LEN, cwd_ptr, cwd_len
    agents_details_begin_status = call @json_writer_begin_field_object(writer, &RPC_SYS_JSON_KEY_DETAILS, RPC_SYS_JSON_KEY_DETAILS_LEN)
    EXPAND JSON_WRITER_FIELD_STRING agents_path_status, writer, RPC_SYS_JSON_KEY_PATH, RPC_SYS_JSON_KEY_PATH_LEN, agents_path, agents_path_len
    EXPAND JSON_WRITER_FIELD_BOOL agents_exists_status, writer, RPC_SYS_JSON_KEY_EXISTS, RPC_SYS_JSON_KEY_EXISTS_LEN, 1
    EXPAND JSON_WRITER_END_OBJECT agents_details_end_status, writer
    EXPAND JSON_WRITER_END_OBJECT agents_end_status, writer
    EXPAND JSON_WRITER_BEGIN_OBJECT env_begin_status, writer
    EXPAND JSON_WRITER_FIELD_STRING env_type_status, writer, RPC_SYS_JSON_KEY_ITEM_TYPE, RPC_SYS_JSON_KEY_ITEM_TYPE_LEN, RPC_SYS_JSON_VALUE_CONFIG, RPC_SYS_JSON_VALUE_CONFIG_LEN
    EXPAND JSON_WRITER_FIELD_STRING env_desc_status, writer, RPC_SYS_JSON_KEY_DESCRIPTION, RPC_SYS_JSON_KEY_DESCRIPTION_LEN, RPC_SYS_STRING_CONFIG_DESC, RPC_SYS_STRING_CONFIG_DESC_LEN
    EXPAND JSON_WRITER_FIELD_STRING env_cwd_status, writer, RPC_SYS_JSON_KEY_CWD, RPC_SYS_JSON_KEY_CWD_LEN, cwd_ptr, cwd_len
    env_details_begin_status = call @json_writer_begin_field_object(writer, &RPC_SYS_JSON_KEY_DETAILS, RPC_SYS_JSON_KEY_DETAILS_LEN)
    EXPAND JSON_WRITER_FIELD_STRING env_path_status, writer, RPC_SYS_JSON_KEY_PATH, RPC_SYS_JSON_KEY_PATH_LEN, env_path, env_path_len
    EXPAND JSON_WRITER_FIELD_BOOL env_exists_status, writer, RPC_SYS_JSON_KEY_EXISTS, RPC_SYS_JSON_KEY_EXISTS_LEN, 1
    EXPAND JSON_WRITER_END_OBJECT env_details_end_status, writer
    EXPAND JSON_WRITER_END_OBJECT env_end_status, writer
    EXPAND JSON_WRITER_END_ARRAY items_end_status, writer
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    !end_status
    !items_end_status
    !env_end_status
    !env_details_end_status
    !env_exists_status
    !env_path_status
    !env_details_begin_status
    !env_cwd_status
    !env_desc_status
    !env_type_status
    !env_begin_status
    !agents_end_status
    !agents_details_end_status
    !agents_exists_status
    !agents_path_status
    !agents_details_begin_status
    !agents_cwd_status
    !agents_desc_status
    !agents_type_status
    !agents_begin_status
    !items_begin_status
    !begin_status
    !env_path
    !env_path_len
    !agents_path
    !agents_path_len
    !cwd_ptr
    !cwd_len
    !writer
    return 0

@ffi_wrapper send_rpc_external_detect(&req: ptr, &id_ptr: ptr, id_len: u64, &cfg_ptr: ptr) -> u32:
L_ENTRY:
    cwd_ptr_slot = stack_alloc 8
    cwd_len_slot = stack_alloc 8
    cwd_status = call @sa_deno_plugin_cwd(&cwd_ptr_slot, &cwd_len_slot)
    cwd_ptr = load cwd_ptr_slot+0 as ptr
    cwd_len = load cwd_len_slot+0 as u64
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    write_status = call @json_writer_write_external_detect_result(writer, &cwd_ptr, cwd_len)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    free_status = call @plugin_free_buffer(cwd_ptr, cwd_len)
    !free_status
    !write_status
    !writer_status
    !cwd_status
    !cwd_ptr
    !cwd_len
    !cfg_ptr
    !req
    return 0

@ffi_wrapper json_writer_write_config_write_result(writer: ptr, &cwd_ptr: ptr, cwd_len: u64) -> u32:
L_ENTRY:
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    EXPAND JSON_WRITER_FIELD_STRING path_status, writer, RPC_SYS_JSON_KEY_FILE_PATH, RPC_SYS_JSON_KEY_FILE_PATH_LEN, cwd_ptr, cwd_len
    EXPAND JSON_WRITER_FIELD_STRING status_field_status, writer, RPC_SYS_JSON_KEY_STATUS, RPC_SYS_JSON_KEY_STATUS_LEN, RPC_SYS_JSON_VALUE_OK, RPC_SYS_JSON_VALUE_OK_LEN
    EXPAND JSON_WRITER_FIELD_STRING version_status, writer, RPC_SYS_JSON_KEY_VERSION, RPC_SYS_JSON_KEY_VERSION_LEN, RPC_SYS_JSON_VALUE_CONFIG_VERSION, RPC_SYS_JSON_VALUE_CONFIG_VERSION_LEN
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    !end_status
    !version_status
    !status_field_status
    !path_status
    !begin_status
    !cwd_ptr
    !cwd_len
    !writer
    return 0

@ffi_wrapper send_rpc_config_write(&req: ptr, &id_ptr: ptr, id_len: u64, &cfg_ptr: ptr) -> u32:
L_ENTRY:
