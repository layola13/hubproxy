@ffi_wrapper json_writer_write_marketplace_upgrade_result(writer: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    name_ptr_slot = stack_alloc 8
    name_len_slot = stack_alloc 8
    status = call @rpc_extract_param_string(&body, body_len, &RPC_SYS_J_MARKETPLACE_NAME_KEY, RPC_SYS_J_MARKETPLACE_NAME_KEY_LEN, &name_ptr_slot, &name_len_slot)
    has_name = eq status, 1
    br has_name -> L_UPGRADE_WITH_NAME, L_UPGRADE_EMPTY

L_UPGRADE_WITH_NAME:
    !has_name
    name_ptr = load name_ptr_slot+0 as ptr
    name_len = load name_len_slot+0 as u64
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    errors_status = call @json_writer_field_empty_array(writer, &RPC_SYS_JSON_KEY_ERRORS, RPC_SYS_JSON_KEY_ERRORS_LEN)
    selected_begin_status = call @json_writer_begin_field_array(writer, &RPC_SYS_JSON_KEY_SELECTED_MARKETPLACES, RPC_SYS_JSON_KEY_SELECTED_MARKETPLACES_LEN)
    selected_name_status = call @sa_json_writer_write_string(writer, &name_ptr, name_len)
    EXPAND JSON_WRITER_END_ARRAY selected_end_status, writer
    upgraded_status = call @json_writer_field_empty_array(writer, &RPC_SYS_JSON_KEY_UPGRADED_ROOTS, RPC_SYS_JSON_KEY_UPGRADED_ROOTS_LEN)
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    !end_status
    !upgraded_status
    !selected_end_status
    !selected_name_status
    !selected_begin_status
    !errors_status
    !begin_status
    !name_ptr
    !name_len
    !status
    !body
    !body_len
    !writer
    return 0

L_UPGRADE_EMPTY:
    !has_name
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status_empty, writer
    errors_status_empty = call @json_writer_field_empty_array(writer, &RPC_SYS_JSON_KEY_ERRORS, RPC_SYS_JSON_KEY_ERRORS_LEN)
    selected_status_empty = call @json_writer_field_empty_array(writer, &RPC_SYS_JSON_KEY_SELECTED_MARKETPLACES, RPC_SYS_JSON_KEY_SELECTED_MARKETPLACES_LEN)
    upgraded_status_empty = call @json_writer_field_empty_array(writer, &RPC_SYS_JSON_KEY_UPGRADED_ROOTS, RPC_SYS_JSON_KEY_UPGRADED_ROOTS_LEN)
    EXPAND JSON_WRITER_END_OBJECT end_status_empty, writer
    !end_status_empty
    !upgraded_status_empty
    !selected_status_empty
    !errors_status_empty
    !begin_status_empty
    !status
    !body
    !body_len
    !writer
    return 0

