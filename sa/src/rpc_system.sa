    !remote_len
    !deleted_status
    !begin_status
    !remote_extract_status
    !body
    !body_len
    !writer
    return 0

L_PLUGIN_SHARE_DELETE_NULL:
    !remote_found
    EXPAND JSON_WRITER_FIELD_NULL remote_status_null, writer, RPC_SYS_JSON_KEY_REMOTE_PLUGIN_ID, RPC_SYS_JSON_KEY_REMOTE_PLUGIN_ID_LEN
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    !end_status
    !remote_status_null
    !deleted_status
    !begin_status
    !remote_extract_status
    !body
    !body_len
    !writer
    return 0

