    cwd_len = load cwd_len_slot+0 as u64
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    write_status = call @json_writer_write_config_write_result(writer, &cwd_ptr, cwd_len)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    free_status = call @plugin_free_buffer(cwd_ptr, cwd_len)
