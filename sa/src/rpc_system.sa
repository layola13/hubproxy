    !body
    !body_len
    return 0

@ffi_wrapper send_rpc_mcp_reload(&req: ptr, &id_ptr: ptr, id_len: u64, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    reload_write_status = call @write_mcp_reload_response_object(writer, &body, body_len)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !reload_write_status
    !writer_status
    !body
    !body_len
    !req
    return 0

@ffi_wrapper send_rpc_item_tool_call(&req: ptr, &id_ptr: ptr, id_len: u64, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    text_ptr_slot = stack_alloc 8
    text_len_slot = stack_alloc 8
    text_extract_status = call @rpc_extract_string_or_default(&body, body_len, &RPC_SYS_J_MESSAGE_KEY, RPC_SYS_J_MESSAGE_KEY_LEN, &RPC_SYS_DEFAULT_CALLED, RPC_SYS_DEFAULT_CALLED_LEN, &text_ptr_slot, &text_len_slot)
    text_ptr = load text_ptr_slot+0 as ptr
    text_len = load text_len_slot+0 as u64
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    items_begin_status = call @json_writer_begin_field_array(writer, &RPC_SYS_JSON_KEY_CONTENT_ITEMS, RPC_SYS_JSON_KEY_CONTENT_ITEMS_LEN)
    EXPAND JSON_WRITER_BEGIN_OBJECT item_begin_status, writer
    EXPAND JSON_WRITER_FIELD_STRING type_status, writer, RPC_SYS_FB_KEY_TYPE, RPC_SYS_FB_KEY_TYPE_LEN, RPC_SYS_JSON_VALUE_TEXT, RPC_SYS_JSON_VALUE_TEXT_LEN
    EXPAND JSON_WRITER_FIELD_STRING text_status, writer, RPC_SYS_JSON_KEY_TEXT, RPC_SYS_JSON_KEY_TEXT_LEN, text_ptr, text_len
    EXPAND JSON_WRITER_END_OBJECT item_end_status, writer
    EXPAND JSON_WRITER_END_ARRAY items_end_status, writer
    EXPAND JSON_WRITER_FIELD_BOOL success_status, writer, RPC_SYS_JSON_KEY_SUCCESS, RPC_SYS_JSON_KEY_SUCCESS_LEN, 1
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !end_status
    !success_status
    !items_end_status
    !item_end_status
    !text_status
    !type_status
    !item_begin_status
    !items_begin_status
    !begin_status
    !writer_status
    !text_extract_status
    !text_ptr
    !text_len
    !body
    !body_len
    !req
    return 0

@ffi_wrapper send_rpc_mcp_tool_call(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    mcp_call_ptr_slot = stack_alloc 8
    mcp_call_len_slot = stack_alloc 8
    mcp_call_status = call @sa_deno_plugin_mcp_tool_call(&body, body_len, &mcp_call_ptr_slot, &mcp_call_len_slot)
    mcp_call_ok = eq mcp_call_status, 0
    br mcp_call_ok -> L_MCP_TOOL_CALL_PLUGIN_SEND, L_MCP_TOOL_CALL_STATUS_CHECK

L_MCP_TOOL_CALL_STATUS_CHECK:
    mcp_call_invalid_params = eq mcp_call_status, 3
    br mcp_call_invalid_params -> L_MCP_TOOL_CALL_BAD_PARAMS, L_MCP_TOOL_CALL_STATUS_CHECK_FAILED

L_MCP_TOOL_CALL_BAD_PARAMS:
    !mcp_call_invalid_params
    call @send_error_with_id(&req, 400, &id_ptr, id_len, &RPC_SYS_J_ERR_INVALID_PARAMS, RPC_SYS_J_ERR_INVALID_PARAMS_LEN)
    !state_ptr
    !body
    !body_len
    !req
    return 0

L_MCP_TOOL_CALL_STATUS_CHECK_FAILED:
    !mcp_call_invalid_params
    jmp L_MCP_TOOL_CALL_FAILED

L_MCP_TOOL_CALL_FAILED:
    call @sa_print_bytes(&RPC_SYS_LOG_MCP_TOOL_FAILED, RPC_SYS_LOG_MCP_TOOL_FAILED_LEN)
    call @send_error_with_id(&req, 500, &id_ptr, id_len, &RPC_SYS_J_ERR_MCP_FAILED, RPC_SYS_J_ERR_MCP_FAILED_LEN)
    !state_ptr
    !body
    !body_len
    !req
    return 0

L_MCP_TOOL_CALL_PLUGIN_SEND:
    mcp_call_ptr = load mcp_call_ptr_slot+0 as ptr
    mcp_call_len = load mcp_call_len_slot+0 as u64
    call @notify_mcp_tool_progress(&state_ptr, &body, body_len)
    call @send_wrapped_raw_json_with_id(&req, &id_ptr, id_len, &mcp_call_ptr, mcp_call_len)
    mcp_call_free_status = call @plugin_free_buffer(mcp_call_ptr, mcp_call_len)
    !mcp_call_free_status
    !mcp_call_ptr
    !mcp_call_len
    !state_ptr
    !body
    !body_len
    !req
    return 0

@ffi_wrapper send_rpc_fs_read(&req: ptr, &id_ptr: ptr, id_len: u64, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    path_ptr_slot = stack_alloc 8
    path_len_slot = stack_alloc 8
    path_status = call @rpc_extract_param_string(&body, body_len, &RPC_SYS_J_PATH_KEY, RPC_SYS_J_PATH_KEY_LEN, &path_ptr_slot, &path_len_slot)
    has_path = eq path_status, 1
    !path_status
    br has_path -> L_FS_READ_DO, L_FS_READ_BAD_PARAMS

L_FS_READ_BAD_PARAMS:
    !has_path
    call @send_error_with_id(&req, 400, &id_ptr, id_len, &RPC_SYS_J_ERR_INVALID_PARAMS, RPC_SYS_J_ERR_INVALID_PARAMS_LEN)
    !body
    !body_len
    !req
    return 0

L_FS_READ_DO:
    !has_path
    path_ptr = load path_ptr_slot+0 as ptr
    path_len = load path_len_slot+0 as u64
    EXPAND DENO_READ_FILE_BASE64 read_ptr, read_len, read_status, path_ptr, path_len
    read_ok = eq read_status, 0
    !read_status
    br read_ok -> L_FS_READ_OK, L_FS_READ_ERR

L_FS_READ_ERR:
    !read_ok
    !path_ptr
    !path_len
    call @send_error_with_id(&req, 500, &id_ptr, id_len, &RPC_SYS_J_ERR_FS, RPC_SYS_J_ERR_FS_LEN)
    !body
    !body_len
    !req
    return 0

L_FS_READ_OK:
    !read_ok
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    EXPAND JSON_WRITER_FIELD_STRING data_status, writer, RPC_SYS_JSON_KEY_DATA_BASE64, RPC_SYS_JSON_KEY_DATA_BASE64_LEN, read_ptr, read_len
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    free_status = call @plugin_free_buffer(read_ptr, read_len)
    !free_status
    !end_status
    !data_status
    !begin_status
    !writer_status
    !read_ptr
    !read_len
    !path_ptr
    !path_len
    !body
    !body_len
    !req
    return 0

@ffi_wrapper send_rpc_fs_write(&req: ptr, &id_ptr: ptr, id_len: u64, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    path_ptr_slot = stack_alloc 8
