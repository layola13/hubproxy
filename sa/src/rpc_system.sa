    query_extract_status = call @rpc_extract_string_or_default(&body, body_len, &RPC_SYS_J_QUERY_KEY, RPC_SYS_J_QUERY_KEY_LEN, &RPC_SYS_EMPTY_TEXT, RPC_SYS_EMPTY_TEXT_LEN, &query_ptr_slot, &query_len_slot)
    session_ptr = load session_ptr_slot+0 as ptr
    session_len = load session_len_slot+0 as u64
    query_ptr = load query_ptr_slot+0 as ptr
    query_len = load query_len_slot+0 as u64
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status_updated, writer_updated
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status_updated, writer_updated
    EXPAND JSON_WRITER_FIELD_STRING session_status_updated, writer_updated, RPC_SYS_JSON_KEY_SESSION_ID, RPC_SYS_JSON_KEY_SESSION_ID_LEN, session_ptr, session_len
    EXPAND JSON_WRITER_FIELD_STRING query_status_updated, writer_updated, RPC_SYS_JSON_KEY_QUERY, RPC_SYS_JSON_KEY_QUERY_LEN, query_ptr, query_len
    files_status_updated = call @json_writer_field_empty_array(writer_updated, &RPC_SYS_JSON_KEY_FILES, RPC_SYS_JSON_KEY_FILES_LEN)
    EXPAND JSON_WRITER_END_OBJECT end_status_updated, writer_updated
    call @notify_writer_params(&state_ptr, &RPC_SYS_EV_FUZZY_UPDATED, RPC_SYS_EV_FUZZY_UPDATED_LEN, writer_updated)
    !end_status_updated
    !files_status_updated
    !query_status_updated
    !session_status_updated
    !begin_status_updated
    !writer_status_updated

    EXPAND JSON_WRITER_NEW_MINIFIED writer_status_completed, writer_completed
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status_completed, writer_completed
    EXPAND JSON_WRITER_FIELD_STRING session_status_completed, writer_completed, RPC_SYS_JSON_KEY_SESSION_ID, RPC_SYS_JSON_KEY_SESSION_ID_LEN, session_ptr, session_len
    EXPAND JSON_WRITER_END_OBJECT end_status_completed, writer_completed
    call @notify_writer_params(&state_ptr, &RPC_SYS_EV_FUZZY_COMPLETED, RPC_SYS_EV_FUZZY_COMPLETED_LEN, writer_completed)
    !end_status_completed
    !session_status_completed
    !begin_status_completed
    !writer_status_completed
    !query_extract_status
    !session_extract_status
    !session_ptr
    !session_len
    !query_ptr
    !query_len
    !state_ptr
    !body
    !body_len
    return 0

