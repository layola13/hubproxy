@ffi_wrapper json_writer_write_hooks_list_result(writer: ptr, &cwd_ptr: ptr, cwd_len: u64) -> u32:
L_ENTRY:
    EXPAND JSON_WRITER_BEGIN_OBJECT begin_status, writer
    data_begin_status = call @json_writer_begin_field_array(writer, &RPC_SYS_JSON_KEY_DATA, RPC_SYS_JSON_KEY_DATA_LEN)
    EXPAND JSON_WRITER_BEGIN_OBJECT hook_begin_status, writer
    cwd_field_status = call @json_writer_field_string_or_empty(writer, &RPC_SYS_JSON_KEY_CWD, RPC_SYS_JSON_KEY_CWD_LEN, &cwd_ptr, cwd_len)
    errors_field_status = call @json_writer_field_empty_array(writer, &RPC_SYS_JSON_KEY_ERRORS, RPC_SYS_JSON_KEY_ERRORS_LEN)
    hooks_field_status = call @json_writer_field_empty_array(writer, &RPC_SYS_JSON_KEY_HOOKS, RPC_SYS_JSON_KEY_HOOKS_LEN)
    warnings_field_status = call @json_writer_field_empty_array(writer, &RPC_SYS_JSON_KEY_WARNINGS, RPC_SYS_JSON_KEY_WARNINGS_LEN)
    EXPAND JSON_WRITER_END_OBJECT hook_end_status, writer
    EXPAND JSON_WRITER_END_ARRAY data_end_status, writer
    EXPAND JSON_WRITER_END_OBJECT end_status, writer
    !end_status
    !data_end_status
    !hook_end_status
    !warnings_field_status
    !hooks_field_status
    !errors_field_status
    !cwd_field_status
    !hook_begin_status
    !data_begin_status
    !begin_status
    !cwd_ptr
    !cwd_len
    !writer
    return 0

@ffi_wrapper send_rpc_hooks_list(&req: ptr, &id_ptr: ptr, id_len: u64, &cfg_ptr: ptr) -> u32:
L_ENTRY:
    cwd_ptr_slot = stack_alloc 8
    cwd_len_slot = stack_alloc 8
    cwd_status = call @sa_deno_plugin_cwd(&cwd_ptr_slot, &cwd_len_slot)
    cwd_ptr = load cwd_ptr_slot+0 as ptr
    cwd_len = load cwd_len_slot+0 as u64
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    write_status = call @json_writer_write_hooks_list_result(writer, &cwd_ptr, cwd_len)
    !write_status
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !writer_status
    free_status = call @plugin_free_buffer(cwd_ptr, cwd_len)
    !free_status
    !cwd_status
    !cwd_ptr
    !cwd_len
    !cfg_ptr
    !req
    return 0

