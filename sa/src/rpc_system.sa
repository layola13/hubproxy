    EXPAND JSON_WRITER_FIELD_STRING plan_mode_status, writer, RPC_SYS_JSON_KEY_MODE, RPC_SYS_JSON_KEY_MODE_LEN, RPC_SYS_FB_VALUE_PLAN, RPC_SYS_FB_VALUE_PLAN_LEN
    EXPAND JSON_WRITER_FIELD_NULL plan_model_status, writer, RPC_SYS_JSON_KEY_MODEL, RPC_SYS_JSON_KEY_MODEL_LEN
