    os_len = load os_len_slot+0 as u64
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    write_status = call @json_writer_write_initialize_result(writer, &version_ptr, version_len, &cwd_ptr, cwd_len, &family_ptr, family_len, &os_ptr, os_len)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    version_free = call @plugin_free_buffer(version_ptr, version_len)
    cwd_free = call @plugin_free_buffer(cwd_ptr, cwd_len)
    family_free = call @plugin_free_buffer(family_ptr, family_len)
    os_free = call @plugin_free_buffer(os_ptr, os_len)
    !version_free
    !cwd_free
    !family_free
    !os_free
    !write_status
    !writer_status
    !version_status
