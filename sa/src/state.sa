@ffi_wrapper state_goal_get_full(&state: ptr, thread_id: u64, &key_ptr: ptr, key_len: u64, &out_status: ptr, &out_key_ptr: ptr, &out_key_len: ptr, &out_status_ptr: ptr, &out_status_len: ptr, &out_budget_null: ptr, &out_budget: ptr, &out_used: ptr, &out_created: ptr, &out_updated: ptr, &out_obj_ptr: ptr, &out_obj_len: ptr) -> i32:
L_ENTRY:
    count = load state+ST_GOAL_COUNT as u64
    i_ptr = stack_alloc 8
    store i_ptr+0, 0 as u64
    jmp L_GGF_COND

L_GGF_COND:
    i = load i_ptr+0 as u64
    done = uge i, count
    br done -> L_GGF_NOT_FOUND, L_GGF_BODY

L_GGF_BODY:
    slot_off = mul i, GOAL_SLOT_SIZE
    slot_abs = add slot_off, ST_GOALS
    slot = ptr_add state, slot_abs
    active = load slot+GOAL_ACTIVE as u8
    is_active = eq active, 1
    !active
    br is_active -> L_GGF_FIND_ACTIVE, L_GGF_FIND_INACTIVE

L_GGF_FIND_ACTIVE:
    !is_active
    has_key = ugt key_len, 0
    br has_key -> L_GGF_FIND_KEY, L_GGF_FIND_NUMERIC

L_GGF_FIND_INACTIVE:
    !is_active
    jmp L_GGF_NEXT

L_GGF_FIND_KEY:
    !has_key
    slot_key_len = load slot+GOAL_KEY_LEN as u64
    len_match = eq slot_key_len, key_len
    br len_match -> L_GGF_FIND_KEY_COMPARE, L_GGF_FIND_KEY_NO

L_GGF_FIND_KEY_COMPARE:
    !len_match
    slot_key = ptr_add slot, GOAL_KEY
    same = call @sa_bytes_eq(&slot_key, slot_key_len, &key_ptr, key_len)
    !slot_key
    !slot_key_len
    br same -> L_GGF_FIND_KEY_HIT, L_GGF_FIND_NEXT_SAME

L_GGF_FIND_KEY_HIT:
    !same
    jmp L_GGF_FOUND

L_GGF_FIND_KEY_NO:
    !len_match
    !slot_key_len
    jmp L_GGF_NEXT

L_GGF_FIND_NEXT_SAME:
    !same
    jmp L_GGF_NEXT

L_GGF_FIND_NUMERIC:
    !has_key
    gid = load slot+GOAL_THR_ID as u64
    found = eq gid, thread_id
    !gid
    br found -> L_GGF_FIND_NUMERIC_HIT, L_GGF_FIND_NUMERIC_NEXT

L_GGF_FIND_NUMERIC_HIT:
    !found
    jmp L_GGF_FOUND

L_GGF_FIND_NUMERIC_NEXT:
    !found
    jmp L_GGF_NEXT

L_GGF_FOUND:
    status = load slot+GOAL_STATUS as u8
    stored_key_len = load slot+GOAL_KEY_LEN as u64
    stored_key_ptr = ptr_add slot, GOAL_KEY
    status_len = load slot+GOAL_STATUS_LEN as u64
    status_ptr = ptr_add slot, GOAL_STATUS_TEXT
    budget_null = load slot+GOAL_BUDGET_NULL as u8
    budget = load slot+GOAL_BUDGET as i64
    used = load slot+GOAL_USED as u64
    created = load slot+GOAL_CREATED as u64
    updated = load slot+GOAL_UPDATED as u64
    obj_len = load slot+GOAL_OBJ_LEN as u64
    obj_ptr = ptr_add slot, GOAL_OBJ
    store out_status+0, status as u8
    store out_key_ptr+0, stored_key_ptr as ptr
    store out_key_len+0, stored_key_len as u64
    store out_status_ptr+0, status_ptr as ptr
    store out_status_len+0, status_len as u64
    store out_budget_null+0, budget_null as u8
    store out_budget+0, budget as i64
    store out_used+0, used as u64
    store out_created+0, created as u64
    store out_updated+0, updated as u64
    store out_obj_ptr+0, obj_ptr as ptr
    store out_obj_len+0, obj_len as u64
    !status
    !stored_key_len
    !stored_key_ptr
    !status_len
    !status_ptr
    !budget_null
    !budget
    !used
    !obj_len
    !obj_ptr
    !slot
    !slot_abs
    !slot_off
    !i
    !done
    !count
    !thread_id
    !key_ptr
    !key_len
    !state
    !out_status
    !out_key_ptr
    !out_key_len
    !out_status_ptr
    !out_status_len
    !out_budget_null
    !out_budget
    !out_used
    !out_obj_ptr
    !out_obj_len
    return 0

