L_GGF_NOT_FOUND:
    !done
    !i
    !count
    !thread_id
    !key_ptr
    !key_len
    !state
    !out_status
    !out_key_ptr
    !out_key_len
    !out_budget_null
    !out_budget
    !out_used
    !out_obj_ptr
    !out_obj_len
    return -1

@ffi_wrapper state_goal_get(&state: ptr, thread_id: u64, &out_budget: ptr, &out_used: ptr) -> i32:
L_ENTRY:
    count = load state+ST_GOAL_COUNT as u64
    i_ptr = stack_alloc 8
    store i_ptr+0, 0 as u64
    jmp L_GG_COND

L_GG_COND:
    i = load i_ptr+0 as u64
    done = uge i, count
    br done -> L_GG_NOT_FOUND, L_GG_BODY

L_GG_BODY:
    slot_off = mul i, GOAL_SLOT_SIZE
    slot_abs = add slot_off, ST_GOALS
    slot = ptr_add state, slot_abs
    gid = load slot+GOAL_THR_ID as u64
    found = eq gid, thread_id
    !gid
    active = load slot+GOAL_ACTIVE as u8
    is_active = eq active, 1
    !active
    want = and found, is_active
    !found
    !is_active
    br want -> L_GG_FOUND, L_GG_NEXT

L_GG_FOUND:
    !want
    budget = load slot+GOAL_BUDGET as i64
    used = load slot+GOAL_USED as u64
    store out_budget+0, budget as i64
    store out_used+0, used as u64
    !budget
    !used
    !slot
    !slot_abs
    !slot_off
    !i
    !done
    !count
    !thread_id
    !state
    !out_budget
    !out_used
    return 0

L_GG_NEXT:
    !want
    !slot
    !slot_abs
    !slot_off
    next_i = add i, 1
    store i_ptr+0, next_i as u64
    !next_i
    !i
    !done
    jmp L_GG_COND

L_GG_NOT_FOUND:
    !done
    !i
    !count
    !thread_id
    !state
    !out_budget
    !out_used
    return -1

