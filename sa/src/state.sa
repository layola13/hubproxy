    store slot+GOAL_USED, 0 as u64
    store slot+GOAL_CREATED, now_u4 as u64
    store slot+GOAL_UPDATED, now_u4 as u64
    copy_len2 = call @state_clamp_len(obj_len, GOAL_OBJ_CAP)
    obj_dst2 = ptr_add slot, GOAL_OBJ
    copied2 = call @sa_bytes_copy(&obj_dst2, &obj_ptr, copy_len2)
    store slot+GOAL_OBJ_LEN, copied2 as u64
    old_count = load state+ST_GOAL_COUNT as u64
    new_count = add old_count, 1
    store state+ST_GOAL_COUNT, new_count as u64
    !new_count
    !old_count
    !copied2
    !key_copied2
    !key_copy_len2
    !key_dst2
    !status_copied2
    !status_copy_len2
    !status_dst2
    !copy_len2
    !obj_dst2
    !slot
    !slot_abs
    !slot_off
    !count
    !thread_id
    !key_ptr
    !key_len
