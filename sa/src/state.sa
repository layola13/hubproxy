    !same
    store slot+WATCH_ACTIVE, 0 as u8
    store slot+WATCH_ID_LEN, 0 as u64
    !slot_watch
    !slot
    !slot_abs
    !slot_off
    !i
    !done
    !count
    !state
    !watch_ptr
    !watch_len
    return 1

L_WD_NEXT_CMP:
    !same
    !slot_watch
    jmp L_WD_NEXT

L_WD_NEXT_INACTIVE:
    !is_active
    jmp L_WD_NEXT

L_WD_NEXT:
    !slot
    !slot_abs
    !slot_off
    next_i = add i, 1
    store i_ptr+0, next_i as u64
    !next_i
    !i
    !done
    jmp L_WD_COND

L_WD_NOT_FOUND:
    !done
    !i
    !count
    !state
    !watch_ptr
    !watch_len
    return 0

@ffi_wrapper state_copy_bytes(&dst: ptr, &src: ptr, len: u64) -> u32:
L_NCOPY_ENTRY:
    i_ptr = stack_alloc 8
    store i_ptr+0, 0 as u64
    jmp L_NCOPY_COND

L_NCOPY_COND:
    i = load i_ptr+0 as u64
    done = uge i, len
    br done -> L_NCOPY_DONE, L_NCOPY_BODY

L_NCOPY_BODY:
    src_ptr = ptr_add src, i
    dst_ptr = ptr_add dst, i
    byte = load src_ptr+0 as u8
    store dst_ptr+0, byte as u8
    !byte
    !src_ptr
    !dst_ptr
    next = add i, 1
    store i_ptr+0, next as u64
    !next
    !i
    !done
    jmp L_NCOPY_COND

L_NCOPY_DONE:
    !i
    !done
    !dst
    !src
    !len
    return 0

@ffi_wrapper state_notify_push(&state: ptr, &frame: ptr, frame_len: u64) -> u32:
L_NP_ENTRY:
    too_big = ugt frame_len, NOTIFY_CAP
    br too_big -> L_NP_TOO_BIG, L_NP_LOAD

L_NP_TOO_BIG:
    !too_big
    !state
    !frame
    !frame_len
    return 1

L_NP_LOAD:
    !too_big
    head = atomic_load state+ST_NOTIFY_HEAD as u64 acquire
    tail = atomic_load state+ST_NOTIFY_TAIL as u64 acquire
    used = sub tail, head
    full = uge used, MAX_NOTIFIES
    br full -> L_NP_DROP_OLDEST, L_NP_WRITE

L_NP_DROP_OLDEST:
    new_head = add head, 1
    atomic_store state+ST_NOTIFY_HEAD, new_head as u64 release
    !new_head
    jmp L_NP_WRITE

L_NP_WRITE:
    slot_index = urem tail, MAX_NOTIFIES
    slot_off = mul slot_index, NOTIFY_SLOT_SIZE
    slot_abs = add slot_off, ST_NOTIFY_DATA
    slot = ptr_add state, slot_abs
    atomic_store slot+NOTIFY_READY, 0 as u64 release
    store slot+NOTIFY_LEN, frame_len as u64
    data = ptr_add slot, NOTIFY_DATA
    copy_status = call @state_copy_bytes(&data, &frame, frame_len)
    !copy_status
    atomic_store slot+NOTIFY_READY, 1 as u64 release
    next_tail = add tail, 1
    atomic_store state+ST_NOTIFY_TAIL, next_tail as u64 release
    !next_tail
    !data
    !slot
    !slot_abs
    !slot_off
    !slot_index
    !full
    !used
    !tail
    !head
    !state
    !frame
    !frame_len
    return 0

@ffi_wrapper state_emit_warning(&state: ptr, &message_ptr: ptr, message_len: u64, &thread_ptr: ptr, thread_len: u64) -> u32:
L_ENTRY:
    writer_slot = stack_alloc 8
    buffer_slot = stack_alloc 8
    writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot)
    writer = load writer_slot+0 as ptr
    begin_status = call @sa_json_writer_begin_object(writer)
    field_msg_status = call @sa_json_writer_field_string(writer, &WARN_KEY_MESSAGE, WARN_KEY_MESSAGE_LEN, &message_ptr, message_len)
    has_thread = ugt thread_len, 0
    br has_thread -> L_WARN_THREAD, L_WARN_NO_THREAD

L_WARN_THREAD:
    !has_thread
    field_thread_status = call @sa_json_writer_field_string(writer, &WARN_KEY_THREAD_ID, WARN_KEY_THREAD_ID_LEN, &thread_ptr, thread_len)
    !field_thread_status
    jmp L_WARN_END_OBJECT

L_WARN_NO_THREAD:
    !has_thread
    jmp L_WARN_END_OBJECT

L_WARN_END_OBJECT:
    end_status = call @sa_json_writer_end_object(writer)
    finish_status = call @sa_json_writer_finish(writer, &buffer_slot)
    buffer = load buffer_slot+0 as ptr
    frame_ptr = call @sa_json_buffer_data(&buffer)
    frame_len = call @sa_json_buffer_len(&buffer)
    frame_len_slot = stack_alloc 8
    frame = call @build_concat3_owned(&SSE_WARNING_PREFIX, SSE_WARNING_PREFIX_LEN, &frame_ptr, frame_len, &SSE_WARNING_SUFFIX, SSE_WARNING_SUFFIX_LEN, &frame_len_slot)
    frame_len_total = load frame_len_slot+0 as u64
    push_status = call @state_notify_push(&state, &frame, frame_len_total)
    buffer_free_status = call @sa_json_buffer_free(^buffer)
    writer_free_status = call @sa_json_writer_free(^writer)
    !push_status
    !buffer_free_status
    !writer_free_status
    !frame
    !frame_len_total
    !frame_ptr
    !frame_len
    !writer_status
    !begin_status
    !field_msg_status
    !end_status
    !finish_status
    !state
    !message_ptr
    !message_len
    !thread_ptr
    !thread_len
    return 0

@ffi_wrapper build_concat_owned(&left_ptr: ptr, left_len: u64, &right_ptr: ptr, right_len: u64, &out_len: ptr) -> ^ptr:
L_ENTRY:
    joined_str = call @sa_string_concat(left_ptr, left_len, right_ptr, right_len)
    joined_ptr = call @sa_fmt_buffer_data(joined_str)
    joined_len = call @sa_fmt_buffer_len(joined_str)
    out_ptr = alloc joined_len
    out_copy = call @sa_bytes_copy(&out_ptr, &joined_ptr, joined_len)
    joined_free = call @sa_fmt_buffer_free(^joined_str)
    store out_len+0, joined_len as u64
    !joined_free
    !out_copy
    !joined_len
    !joined_ptr
    !left_ptr
    !left_len
    !right_ptr
    !right_len
    !out_len
    return out_ptr

@ffi_wrapper build_concat3_owned(&left_ptr: ptr, left_len: u64, &mid_ptr: ptr, mid_len: u64, &right_ptr: ptr, right_len: u64, &out_len: ptr) -> ^ptr:
L_ENTRY:
    left_mid_len_slot = stack_alloc 8
    left_mid = call @build_concat_owned(&left_ptr, left_len, &mid_ptr, mid_len, &left_mid_len_slot)
    left_mid_len = load left_mid_len_slot+0 as u64
    final_len_slot = stack_alloc 8
    out_ptr = call @build_concat_owned(&left_mid, left_mid_len, &right_ptr, right_len, &final_len_slot)
    final_len = load final_len_slot+0 as u64
    store out_len+0, final_len as u64
    !final_len
    !left_mid
    !left_mid_len
    !left_ptr
    !left_len
    !mid_ptr
    !mid_len
    !right_ptr
    !right_len
    !out_len
    return out_ptr

@ffi_wrapper state_notify_pop(&state: ptr, &out_frame: ptr, out_cap: u64, &out_len: ptr) -> u32:
L_NPOP_ENTRY:
    head = atomic_load state+ST_NOTIFY_HEAD as u64 acquire
    tail = atomic_load state+ST_NOTIFY_TAIL as u64 acquire
    empty = eq head, tail
    br empty -> L_NPOP_EMPTY, L_NPOP_SLOT

L_NPOP_EMPTY:
    !empty
    store out_len+0, 0 as u64
    !tail
    !head
    !state
    !out_frame
    !out_cap
    !out_len
    return 0

L_NPOP_SLOT:
    !empty
    slot_index = urem head, MAX_NOTIFIES
    slot_off = mul slot_index, NOTIFY_SLOT_SIZE
    slot_abs = add slot_off, ST_NOTIFY_DATA
    slot = ptr_add state, slot_abs
    ready = atomic_load slot+NOTIFY_READY as u64 acquire
    is_ready = eq ready, 1
    br is_ready -> L_NPOP_COPY_PREP, L_NPOP_NOT_READY

L_NPOP_NOT_READY:
    !is_ready
    !ready
    store out_len+0, 0 as u64
    !slot
    !slot_abs
    !slot_off
    !slot_index
    !tail
    !head
    !state
    !out_frame
    !out_cap
    !out_len
    return 0

L_NPOP_COPY_PREP:
    !is_ready
    !ready
    len = load slot+NOTIFY_LEN as u64
    too_big = ugt len, out_cap
    br too_big -> L_NPOP_DROP_BAD, L_NPOP_COPY

L_NPOP_DROP_BAD:
    !too_big
    store out_len+0, 0 as u64
    atomic_store slot+NOTIFY_READY, 0 as u64 release
    next_head_bad = add head, 1
    atomic_store state+ST_NOTIFY_HEAD, next_head_bad as u64 release
    !next_head_bad
    !len
    !slot
    !slot_abs
    !slot_off
    !slot_index
    !tail
    !head
    !state
    !out_frame
    !out_cap
    !out_len
    return 0

L_NPOP_COPY:
    !too_big
    data = ptr_add slot, NOTIFY_DATA
    copy_status = call @state_copy_bytes(&out_frame, &data, len)
    !copy_status
    store out_len+0, len as u64
    atomic_store slot+NOTIFY_READY, 0 as u64 release
    next_head = add head, 1
    atomic_store state+ST_NOTIFY_HEAD, next_head as u64 release
    !next_head
    !data
    !len
    !slot
    !slot_abs
    !slot_off
    !slot_index
    !tail
    !head
    !state
    !out_frame
    !out_cap
    !out_len
    return 1

@ffi_wrapper state_notify_cursor(&state: ptr) -> u64:
L_NCUR_ENTRY:
    tail = atomic_load state+ST_NOTIFY_TAIL as u64 acquire
    !state
    return tail

@ffi_wrapper state_notify_read(&state: ptr, &cursor: ptr, &out_frame: ptr, out_cap: u64, &out_len: ptr) -> u32:
L_NREAD_ENTRY:
    cur_slot = stack_alloc 8
    cur = load cursor+0 as u64
    head = atomic_load state+ST_NOTIFY_HEAD as u64 acquire
    tail = atomic_load state+ST_NOTIFY_TAIL as u64 acquire
    before_head = ult cur, head
    br before_head -> L_NREAD_CLAMP, L_NREAD_CHECK

L_NREAD_CLAMP:
    !before_head
    store cursor+0, head as u64
    store cur_slot+0, head as u64
    !cur
    jmp L_NREAD_CHECK2

L_NREAD_CHECK:
    !before_head
    store cur_slot+0, cur as u64
    !cur
    jmp L_NREAD_CHECK2

L_NREAD_CHECK2:
    cur2 = load cur_slot+0 as u64
    empty = uge cur2, tail
    br empty -> L_NREAD_EMPTY, L_NREAD_SLOT

L_NREAD_EMPTY:
    !empty
    store out_len+0, 0 as u64
    !cur2
    !tail
    !head
    !state
    !cursor
    !out_frame
    !out_cap
    !out_len
    return 0

L_NREAD_SLOT:
    !empty
    slot_index = urem cur2, MAX_NOTIFIES
    slot_off = mul slot_index, NOTIFY_SLOT_SIZE
    slot_abs = add slot_off, ST_NOTIFY_DATA
    slot = ptr_add state, slot_abs
    ready = atomic_load slot+NOTIFY_READY as u64 acquire
    is_ready = eq ready, 1
    br is_ready -> L_NREAD_COPY_PREP, L_NREAD_NOT_READY

L_NREAD_NOT_READY:
    !is_ready
    !ready
    store out_len+0, 0 as u64
    !slot
    !slot_abs
    !slot_off
    !slot_index
    !cur2
    !tail
    !head
    !state
    !cursor
    !out_frame
    !out_cap
    !out_len
    return 0

L_NREAD_COPY_PREP:
    !is_ready
    !ready
    len = load slot+NOTIFY_LEN as u64
    too_big = ugt len, out_cap
    br too_big -> L_NREAD_SKIP_BAD, L_NREAD_COPY

L_NREAD_SKIP_BAD:
    !too_big
    next_bad = add cur2, 1
    store cursor+0, next_bad as u64
    store out_len+0, 0 as u64
    !next_bad
    !len
    !slot
    !slot_abs
    !slot_off
    !slot_index
    !cur2
    !tail
    !head
    !state
    !cursor
    !out_frame
    !out_cap
    !out_len
    return 0

L_NREAD_COPY:
    !too_big
    data = ptr_add slot, NOTIFY_DATA
    copy_status = call @state_copy_bytes(&out_frame, &data, len)
    !copy_status
    store out_len+0, len as u64
    next_cur = add cur2, 1
    store cursor+0, next_cur as u64
    !next_cur
    !data
    !len
    !slot
    !slot_abs
    !slot_off
    !slot_index
    !cur2
    !tail
    !head
    !state
    !cursor
    !out_frame
    !out_cap
    !out_len
    return 1
