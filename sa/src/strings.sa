// strings.sa — Byte-level string utilities for SA
@import "strings.sai"
@import "sa_std/fmt.sai"
@import "sa_std/string.sai"
@import "sa_std/path.sa"
@import "sa_std/encoding/json.sai"

@const STRINGS_HTTP_PREFIX = utf8:"http://"
@const STRINGS_HTTP_COLON = utf8:":"
@const STRINGS_DUNDER = utf8:"__"

#def STRINGS_HTTP_PREFIX_LEN = 7
#def STRINGS_HTTP_COLON_LEN = 1
#def STRINGS_DUNDER_LEN = 2

// sa_bytes_eq(a_ptr, a_len, b_ptr, b_len) -> u8
// Returns 1 if byte sequences are equal, 0 otherwise.
@ffi_wrapper sa_bytes_eq(&a: ptr, a_len: u64, &b: ptr, b_len: u64) -> u8:
L_ENTRY:
    len_diff = ne a_len, b_len
    br len_diff -> L_EQ_NOT_EQ, L_CMP_LOOP_INIT

L_CMP_LOOP_INIT:
    !len_diff
    i_ptr = stack_alloc 8
    store i_ptr+0, 0 as u64
    jmp L_CMP_COND

L_CMP_COND:
    i = load i_ptr+0 as u64
    done = uge i, a_len
    br done -> L_EQ, L_CMP_BODY

L_CMP_BODY:
    !done
    a_ptr = ptr_add a, i
    b_ptr = ptr_add b, i
    a_byte = load a_ptr+0 as u8
    b_byte = load b_ptr+0 as u8
    diff = ne a_byte, b_byte
    br diff -> L_EQ_BYTE_DIFF, L_CMP_NEXT

L_CMP_NEXT:
    !diff
    !a_byte
    !b_byte
    !a_ptr
    !b_ptr
    next = add i, 1
    store i_ptr+0, next as u64
    !next
    !i
    jmp L_CMP_COND

L_EQ_BYTE_DIFF:
    !diff
    !a_byte
    !b_byte
    !a_ptr
    !b_ptr
    !i
    !a_len
    !b_len
    !a
    !b
    return 0

L_EQ:
    !done
    !i
    !a_len
    !b_len
    !a
    !b
    return 1

L_EQ_NOT_EQ:
    !len_diff
    !a_len
    !b_len
    !a
    !b
    return 0

// sa_bytes_find(hay_ptr, hay_len, needle_ptr, needle_len) -> i64
// Returns index of first occurrence, or -1 if not found.
@ffi_wrapper sa_bytes_find(&hay: ptr, hay_len: u64, &needle: ptr, needle_len: u64) -> i64:
L_ENTRY:
    too_long = ugt needle_len, hay_len
    br too_long -> L_FIND_TOO_LONG, L_FIND_INIT

L_FIND_TOO_LONG:
    !too_long
    !hay
    !hay_len
    !needle
    !needle_len
    return -1

L_FIND_INIT:
    !too_long
    limit = sub hay_len, needle_len
    i_ptr = stack_alloc 8
    store i_ptr+0, 0 as u64
    jmp L_FIND_COND

L_FIND_COND:
    i = load i_ptr+0 as u64
    done = ugt i, limit
    br done -> L_NOT_FOUND, L_FIND_BODY

L_FIND_BODY:
    !done
    hay_offset = ptr_add hay, i
    match = call @sa_bytes_eq(&hay_offset, needle_len, &needle, needle_len)
    is_match = eq match, 1
    br is_match -> L_FOUND, L_FIND_NEXT

L_FIND_NEXT:
    !is_match
    !match
    !hay_offset
    next = add i, 1
    store i_ptr+0, next as u64
    !next
    !i
    jmp L_FIND_COND

L_FOUND:
    !is_match
    !match
    !hay_offset
    !limit
    !hay
    !hay_len
    !needle
    !needle_len
    return i

L_NOT_FOUND:
    !done
    !i
    !limit
    !hay
    !hay_len
    !needle
    !needle_len
    return -1

// sa_bytes_find_byte(hay_ptr, hay_len, needle_byte) -> i64
// Returns index of first occurrence of needle_byte, or -1.
@ffi_wrapper sa_bytes_find_byte(&hay: ptr, hay_len: u64, needle_byte: u8) -> i64:
L_ENTRY:
    i_ptr = stack_alloc 8
    store i_ptr+0, 0 as u64
    jmp L_BF_COND

L_BF_COND:
    i = load i_ptr+0 as u64
    done = uge i, hay_len
    br done -> L_BF_NOT_FOUND, L_BF_BODY

L_BF_BODY:
    !done
    cur_ptr = ptr_add hay, i
    cur = load cur_ptr+0 as u8
    found = eq cur, needle_byte
    br found -> L_BF_FOUND, L_BF_NEXT

L_BF_NEXT:
    !found
    !cur
    !cur_ptr
    next = add i, 1
    store i_ptr+0, next as u64
    !next
    !i
    jmp L_BF_COND

L_BF_FOUND:
    !found
    !cur
    !cur_ptr
    !hay
    !hay_len
    !needle_byte
    return i

L_BF_NOT_FOUND:
    !done
    !i
    !hay
    !hay_len
    !needle_byte
    return -1

// sa_bytes_copy(dst_ptr, src_ptr, len) -> u64
// Copies len bytes from src to dst. Returns number of bytes copied.
@ffi_wrapper sa_bytes_copy(&dst: ptr, &src: ptr, len: u64) -> u64:
L_ENTRY:
    i_ptr = stack_alloc 8
    store i_ptr+0, 0 as u64
    jmp L_CPY_COND

L_CPY_COND:
    i = load i_ptr+0 as u64
    done = uge i, len
    br done -> L_CPY_DONE, L_CPY_BODY

L_CPY_BODY:
    src_ptr = ptr_add src, i
    dst_ptr = ptr_add dst, i
    b = load src_ptr+0 as u8
    store dst_ptr+0, b as u8
    !b
    !src_ptr
    !dst_ptr
    next = add i, 1
    store i_ptr+0, next as u64
    !next
    !i
    !done
    jmp L_CPY_COND

L_CPY_DONE:
    !i
    !done
    !dst
    !src
    return len

@ffi_wrapper bytes_to_owned(&src: ptr, src_len: u64, &out_len: ptr) -> ^ptr:
L_ENTRY:
    out_ptr = alloc src_len
    copied = call @sa_bytes_copy(&out_ptr, &src, src_len)
    store out_len+0, src_len as u64
    !copied
    !src
    !src_len
    !out_len
    return out_ptr

@ffi_wrapper build_concat_owned(&left_ptr: ptr, left_len: u64, &right_ptr: ptr, right_len: u64, &out_len: ptr) -> ^ptr:
L_ENTRY:
    joined_str = call @sa_string_concat(left_ptr, left_len, right_ptr, right_len)
    joined_ptr = call @sa_fmt_buffer_data(joined_str)
    joined_len = call @sa_fmt_buffer_len(joined_str)
    out_ptr = call @bytes_to_owned(&joined_ptr, joined_len, &out_len)
    joined_free = call @sa_fmt_buffer_free(^joined_str)
    !joined_free
    !joined_len
    !joined_ptr
    !left_ptr
    !left_len
    !right_ptr
    !right_len
    !out_len
    return out_ptr

@ffi_wrapper build_concat3_owned(&left_ptr: ptr, left_len: u64, &mid_ptr: ptr, mid_len: u64, &right_ptr: ptr, right_len: u64, &out_len: ptr) -> ^ptr:
L_ENTRY:
    left_mid_len_slot = stack_alloc 8
    left_mid = call @build_concat_owned(&left_ptr, left_len, &mid_ptr, mid_len, &left_mid_len_slot)
    left_mid_len = load left_mid_len_slot+0 as u64
    final_len_slot = stack_alloc 8
    out_ptr = call @build_concat_owned(&left_mid, left_mid_len, &right_ptr, right_len, &final_len_slot)
    final_len = load final_len_slot+0 as u64
    store out_len+0, final_len as u64
    !final_len
    !left_mid
    !left_mid_len
    !left_ptr
    !left_len
    !mid_ptr
    !mid_len
    !right_ptr
    !right_len
    !out_len
    return out_ptr

@ffi_wrapper build_concat4_owned(&a_ptr: ptr, a_len: u64, &b_ptr: ptr, b_len: u64, &c_ptr: ptr, c_len: u64, &d_ptr: ptr, d_len: u64, &out_len: ptr) -> ^ptr:
L_ENTRY:
    ab_len_slot = stack_alloc 8
    ab = call @build_concat_owned(&a_ptr, a_len, &b_ptr, b_len, &ab_len_slot)
    ab_len = load ab_len_slot+0 as u64
    cd_len_slot = stack_alloc 8
    cd = call @build_concat_owned(&c_ptr, c_len, &d_ptr, d_len, &cd_len_slot)
    cd_len = load cd_len_slot+0 as u64
    out_ptr = call @build_concat_owned(&ab, ab_len, &cd, cd_len, &out_len)
    !cd
    !cd_len
    !ab
    !ab_len
    !a_ptr
    !a_len
    !b_ptr
    !b_len
    !c_ptr
    !c_len
    !d_ptr
    !d_len
    !out_len
    return out_ptr

@ffi_wrapper build_concat5_owned(&a_ptr: ptr, a_len: u64, &b_ptr: ptr, b_len: u64, &c_ptr: ptr, c_len: u64, &d_ptr: ptr, d_len: u64, &e_ptr: ptr, e_len: u64, &out_len: ptr) -> ^ptr:
L_ENTRY:
    abcd_len_slot = stack_alloc 8
    abcd = call @build_concat4_owned(&a_ptr, a_len, &b_ptr, b_len, &c_ptr, c_len, &d_ptr, d_len, &abcd_len_slot)
    abcd_len = load abcd_len_slot+0 as u64
    out_ptr = call @build_concat_owned(&abcd, abcd_len, &e_ptr, e_len, &out_len)
    !abcd
    !abcd_len
    !a_ptr
    !a_len
    !b_ptr
    !b_len
    !c_ptr
    !c_len
    !d_ptr
    !d_len
    !e_ptr
    !e_len
    !out_len
    return out_ptr

@ffi_wrapper build_concat6_owned(&a_ptr: ptr, a_len: u64, &b_ptr: ptr, b_len: u64, &c_ptr: ptr, c_len: u64, &d_ptr: ptr, d_len: u64, &e_ptr: ptr, e_len: u64, &f_ptr: ptr, f_len: u64, &out_len: ptr) -> ^ptr:
L_ENTRY:
    abcde_len_slot = stack_alloc 8
    abcde = call @build_concat5_owned(&a_ptr, a_len, &b_ptr, b_len, &c_ptr, c_len, &d_ptr, d_len, &e_ptr, e_len, &abcde_len_slot)
    abcde_len = load abcde_len_slot+0 as u64
    out_ptr = call @build_concat_owned(&abcde, abcde_len, &f_ptr, f_len, &out_len)
    !abcde
    !abcde_len
    !a_ptr
    !a_len
    !b_ptr
    !b_len
    !c_ptr
    !c_len
    !d_ptr
    !d_len
    !e_ptr
    !e_len
    !f_ptr
    !f_len
    !out_len
    return out_ptr

@ffi_wrapper token_preview_owned(&prefix_ptr: ptr, prefix_len: u64, &suffix_ptr: ptr, suffix_len: u64, token_len: u64, &mid_a_ptr: ptr, mid_a_len: u64, &mid_b_ptr: ptr, mid_b_len: u64, &ellipsis_ptr: ptr, ellipsis_len: u64, &out_len: ptr) -> ^ptr:
L_ENTRY:
    len_text_len_slot = stack_alloc 8
    len_text_ptr = call @u64_to_owned(token_len, &len_text_len_slot)
    len_text_len = load len_text_len_slot+0 as u64
    out_ptr = call @build_concat6_owned(&prefix_ptr, prefix_len, &ellipsis_ptr, ellipsis_len, &suffix_ptr, suffix_len, &mid_a_ptr, mid_a_len, &len_text_ptr, len_text_len, &mid_b_ptr, mid_b_len, &out_len)
    !len_text_ptr
    !len_text_len
    !prefix_ptr
    !prefix_len
    !suffix_ptr
    !suffix_len
    !token_len
    !mid_a_ptr
    !mid_a_len
    !mid_b_ptr
    !mid_b_len
    !ellipsis_ptr
    !ellipsis_len
    !out_len
    return out_ptr

@ffi_wrapper prefix_with_owned(&prefix_ptr: ptr, prefix_len: u64, &value_ptr: ptr, value_len: u64, &out_len: ptr) -> ^ptr:
L_ENTRY:
    out_ptr = call @build_concat_owned(&prefix_ptr, prefix_len, &value_ptr, value_len, &out_len)
    !prefix_ptr
    !prefix_len
    !value_ptr
    !value_len
    !out_len
    return out_ptr

@ffi_wrapper namespace_tool_name_owned(&prefix_ptr: ptr, prefix_len: u64, &value_ptr: ptr, value_len: u64, &out_len: ptr) -> ^ptr:
L_ENTRY:
    has_prefix = ugt prefix_len, 0
    br has_prefix -> L_NAMESPACE_TOOL_HAS_PREFIX, L_NAMESPACE_TOOL_NO_PREFIX

L_NAMESPACE_TOOL_NO_PREFIX:
    !has_prefix
    out_ptr_no_prefix = call @bytes_to_owned(&value_ptr, value_len, &out_len)
    !prefix_ptr
    !prefix_len
    !value_ptr
    !value_len
    !out_len
    return out_ptr_no_prefix

L_NAMESPACE_TOOL_HAS_PREFIX:
    !has_prefix
    can_suffix = uge prefix_len, STRINGS_DUNDER_LEN
    br can_suffix -> L_NAMESPACE_TOOL_SUFFIX_CHECK, L_NAMESPACE_TOOL_BUILD_DUNDER_SHORT

L_NAMESPACE_TOOL_SUFFIX_CHECK:
    !can_suffix
    suffix_off = sub prefix_len, STRINGS_DUNDER_LEN
    suffix_ptr = ptr_add prefix_ptr, suffix_off
    suffix_eq = call @sa_bytes_eq(&suffix_ptr, STRINGS_DUNDER_LEN, &STRINGS_DUNDER, STRINGS_DUNDER_LEN)
    has_dunder_suffix = eq suffix_eq, 1
    !suffix_eq
    br has_dunder_suffix -> L_NAMESPACE_TOOL_KEEP_PREFIX, L_NAMESPACE_TOOL_BUILD_DUNDER_LONG

L_NAMESPACE_TOOL_KEEP_PREFIX:
    !has_dunder_suffix
    out_ptr_keep = call @build_concat_owned(&prefix_ptr, prefix_len, &value_ptr, value_len, &out_len)
    !suffix_ptr
    !suffix_off
    !prefix_ptr
    !prefix_len
    !value_ptr
    !value_len
    !out_len
    return out_ptr_keep

L_NAMESPACE_TOOL_BUILD_DUNDER_LONG:
    !has_dunder_suffix
    !suffix_ptr
    !suffix_off
    out_ptr_long = call @build_concat3_owned(&prefix_ptr, prefix_len, &STRINGS_DUNDER, STRINGS_DUNDER_LEN, &value_ptr, value_len, &out_len)
    !prefix_ptr
    !prefix_len
    !value_ptr
    !value_len
    !out_len
    return out_ptr_long

L_NAMESPACE_TOOL_BUILD_DUNDER_SHORT:
    !can_suffix
    out_ptr_short = call @build_concat3_owned(&prefix_ptr, prefix_len, &STRINGS_DUNDER, STRINGS_DUNDER_LEN, &value_ptr, value_len, &out_len)
    !prefix_ptr
    !prefix_len
    !value_ptr
    !value_len
    !out_len
    return out_ptr_short

@ffi_wrapper path_join_owned(&base_ptr: ptr, base_len: u64, &child_ptr: ptr, child_len: u64, &out_len: ptr) -> ^ptr:
L_ENTRY:
    base_slice = alloc Slice_SIZE
    child_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW base_slice, base_ptr, base_len
    child_has_bytes = ugt child_len, 0
    br child_has_bytes -> L_PATH_JOIN_CHILD_CHECK, L_PATH_JOIN_CHILD_KEEP

L_PATH_JOIN_CHILD_CHECK:
    !child_has_bytes
    child_first = load child_ptr+0 as u8
    child_is_abs = eq child_first, 47
    br child_is_abs -> L_PATH_JOIN_CHILD_STRIP, L_PATH_JOIN_CHILD_KEEP_FROM_CHECK

L_PATH_JOIN_CHILD_STRIP:
    !child_is_abs
    rel_child_ptr = ptr_add child_ptr, 1
    rel_child_len = sub child_len, 1
    EXPAND SLICE_NEW child_slice, rel_child_ptr, rel_child_len
    !rel_child_ptr
    !rel_child_len
    !child_first
    jmp L_PATH_JOIN_HAVE_CHILD

L_PATH_JOIN_CHILD_KEEP_FROM_CHECK:
    !child_is_abs
    !child_first
    EXPAND SLICE_NEW child_slice, child_ptr, child_len
    jmp L_PATH_JOIN_HAVE_CHILD

L_PATH_JOIN_CHILD_KEEP:
    !child_has_bytes
    EXPAND SLICE_NEW child_slice, child_ptr, child_len
    jmp L_PATH_JOIN_HAVE_CHILD

L_PATH_JOIN_HAVE_CHILD:
    EXPAND PATH_JOIN joined_slice, base_slice, child_slice
    joined_ptr = load joined_slice+Slice_ptr as ptr
    joined_len = load joined_slice+Slice_len as u64
    out_ptr = call @bytes_to_owned(&joined_ptr, joined_len, &out_len)
    !joined_ptr
    !joined_len
    !joined_slice
    !child_slice
    !base_slice
    !base_ptr
    !base_len
    !child_ptr
    !child_len
    !out_len
    return out_ptr

@ffi_wrapper http_url_owned(&host_ptr: ptr, host_len: u64, port_u64: u64, &suffix_ptr: ptr, suffix_len: u64, &out_len: ptr) -> ^ptr:
L_ENTRY:
    port_len_slot = stack_alloc 8
    port_ptr = call @u64_to_owned(port_u64, &port_len_slot)
    port_len = load port_len_slot+0 as u64
    out_ptr = call @build_concat5_owned(&STRINGS_HTTP_PREFIX, STRINGS_HTTP_PREFIX_LEN, &host_ptr, host_len, &STRINGS_HTTP_COLON, STRINGS_HTTP_COLON_LEN, &port_ptr, port_len, &suffix_ptr, suffix_len, &out_len)
    !port_len
    !port_ptr
    !host_ptr
    !host_len
    !port_u64
    !suffix_ptr
    !suffix_len
    !out_len
    return out_ptr

@ffi_wrapper u64_to_owned(value: u64, &out_len: ptr) -> ^ptr:
L_ENTRY:
    tmp = stack_alloc 32
    len_slot = stack_alloc 8
    fmt_status = call @sa_fmt_u64_into(value, 10, tmp, 32, &len_slot)
    text_len = load len_slot+0 as u64
    out_ptr = call @bytes_to_owned(&tmp, text_len, &out_len)
    !fmt_status
    !text_len
    !value
    !out_len
    return out_ptr

@ffi_wrapper json_buffer_to_owned(buffer: ptr, &out_len: ptr) -> ^ptr:
L_ENTRY:
    data_ptr = call @sa_json_buffer_data(&buffer)
    data_len = call @sa_json_buffer_len(&buffer)
    out_ptr = call @bytes_to_owned(&data_ptr, data_len, &out_len)
    !data_ptr
    !data_len
    !buffer
    !out_len
    return out_ptr

// sa_bytes_to_u64(buf_ptr, buf_len) -> i64
// Parses an unsigned decimal integer from ASCII bytes.
// Returns -1 on overflow or invalid input.
@ffi_wrapper sa_bytes_to_u64(&buf: ptr, buf_len: u64) -> i64:
L_ENTRY:
    is_empty = eq buf_len, 0
    br is_empty -> L_ATO_INVALID, L_ATO_INIT

L_ATO_INVALID:
    !is_empty
    !buf
    !buf_len
    return -1

L_ATO_INIT:
    !is_empty
    result_ptr = stack_alloc 8
    store result_ptr+0, 0 as u64
    i_ptr = stack_alloc 8
    store i_ptr+0, 0 as u64
    jmp L_ATO_COND

L_ATO_COND:
    i = load i_ptr+0 as u64
    done = uge i, buf_len
    br done -> L_ATO_DONE, L_ATO_BODY

L_ATO_BODY:
    !done
    c_ptr = ptr_add buf, i
    c = load c_ptr+0 as u8
    is_digit = uge c, 48
    is_digit2 = ule c, 57
    valid = and is_digit, is_digit2
    !is_digit
    !is_digit2
    br valid -> L_ATO_DIGIT, L_ATO_BAD

L_ATO_DIGIT:
    !valid
    digit = sub c, 48
    result = load result_ptr+0 as u64
    new_result = mul result, 10
    sum = add new_result, digit
    store result_ptr+0, sum as u64
    !digit
    !result
    !new_result
    !sum
    !c
    !c_ptr
    next = add i, 1
    store i_ptr+0, next as u64
    !next
    !i
    jmp L_ATO_COND

L_ATO_BAD:
    !valid
    !c
    !c_ptr
    !i
    !buf
    !buf_len
    return -1

L_ATO_DONE:
    !done
    !i
    final = load result_ptr+0 as u64
    !buf
    !buf_len
    return final
