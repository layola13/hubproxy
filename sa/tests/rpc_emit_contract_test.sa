@test "server resolved writer preserves Deno request resolution shape"():
L_ENTRY:
    EXPAND JSON_WRITER_NEW_MINIFIED server_writer_status, server_writer
    server_write_status = call @json_writer_write_server_resolved_result(server_writer, &SERVER_RESOLVED_BODY, SERVER_RESOLVED_BODY_LEN)
    server_write_ok = eq server_write_status, 0
    call @assert_contract(server_write_ok, 1243)
    server_buffer_slot = stack_alloc 8
    server_ptr_slot = stack_alloc 8
    server_len_slot = stack_alloc 8
    server_finish_status = call @json_writer_finish_view(server_writer, &server_buffer_slot, &server_ptr_slot, &server_len_slot)
    server_finish_ok = eq server_finish_status, 0
    call @assert_contract(server_finish_ok, 1244)
    server_buffer = load server_buffer_slot+0 as ptr
    server_ptr = load server_ptr_slot+0 as ptr
    server_len = load server_len_slot+0 as u64
    call @assert_buffer_contains(&server_ptr, server_len, &EXPECTED_SERVER_RESOLVED, EXPECTED_SERVER_RESOLVED_LEN, 1245)
    server_free_status = call @json_writer_dispose_finished(server_buffer, server_writer)
    server_free_ok = eq server_free_status, 0
    call @assert_contract(server_free_ok, 1246)
    !server_free_ok
    !server_free_status
    !server_len
    !server_ptr
    !server_buffer
    !server_finish_ok
    !server_finish_status
    !server_write_ok
    !server_write_status
    !server_writer
    !server_writer_status
    return
