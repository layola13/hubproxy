    EXPAND JSON_WRITER_NEW_MINIFIED fuzzy_stop_writer_status, fuzzy_stop_writer
    fuzzy_stop_write_status = call @json_writer_write_fuzzy_session_result(fuzzy_stop_writer, &FUZZY_SESSION_STOP_BODY, FUZZY_SESSION_STOP_BODY_LEN, 1)
    fuzzy_stop_write_ok = eq fuzzy_stop_write_status, 0
    call @assert_contract(fuzzy_stop_write_ok, 1239)
