    EXPAND JSON_WRITER_NEW_MINIFIED fuzzy_session_writer_status, fuzzy_session_writer
    fuzzy_session_write_status = call @json_writer_write_fuzzy_session_result(fuzzy_session_writer, &FUZZY_SESSION_BODY, FUZZY_SESSION_BODY_LEN, 0)
