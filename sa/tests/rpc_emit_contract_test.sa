@test "send credits writer preserves Deno email and null fallback"():
L_ENTRY:
    EXPAND JSON_WRITER_NEW_MINIFIED email_writer_status, email_writer
    email_write_status = call @json_writer_write_send_credits_result(email_writer, &SEND_CREDITS_BODY, SEND_CREDITS_BODY_LEN)
    email_write_ok = eq email_write_status, 0
    call @assert_contract(email_write_ok, 1167)
    email_buffer_slot = stack_alloc 8
    email_ptr_slot = stack_alloc 8
    email_len_slot = stack_alloc 8
    email_finish_status = call @json_writer_finish_view(email_writer, &email_buffer_slot, &email_ptr_slot, &email_len_slot)
    email_finish_ok = eq email_finish_status, 0
    call @assert_contract(email_finish_ok, 1168)
    email_buffer = load email_buffer_slot+0 as ptr
    email_ptr = load email_ptr_slot+0 as ptr
    email_len = load email_len_slot+0 as u64
    call @assert_buffer_contains(&email_ptr, email_len, &NEEDLE_SENT_STATUS, NEEDLE_SENT_STATUS_LEN, 1169)
    call @assert_buffer_contains(&email_ptr, email_len, &NEEDLE_EMAIL_ALICE, NEEDLE_EMAIL_ALICE_LEN, 1170)
    email_free_status = call @json_writer_dispose_finished(email_buffer, email_writer)
    email_free_ok = eq email_free_status, 0
    call @assert_contract(email_free_ok, 1171)

    EXPAND JSON_WRITER_NEW_MINIFIED null_writer_status, null_writer
    null_write_status = call @json_writer_write_send_credits_result(null_writer, &SEND_CREDITS_EMPTY_BODY, SEND_CREDITS_EMPTY_BODY_LEN)
    null_write_ok = eq null_write_status, 0
    call @assert_contract(null_write_ok, 1172)
    null_buffer_slot = stack_alloc 8
    null_ptr_slot = stack_alloc 8
    null_len_slot = stack_alloc 8
    null_finish_status = call @json_writer_finish_view(null_writer, &null_buffer_slot, &null_ptr_slot, &null_len_slot)
    null_finish_ok = eq null_finish_status, 0
    call @assert_contract(null_finish_ok, 1173)
    null_buffer = load null_buffer_slot+0 as ptr
    null_ptr = load null_ptr_slot+0 as ptr
    null_len = load null_len_slot+0 as u64
    call @assert_buffer_contains(&null_ptr, null_len, &NEEDLE_SENT_STATUS, NEEDLE_SENT_STATUS_LEN, 1174)
    call @assert_buffer_contains(&null_ptr, null_len, &NEEDLE_EMAIL_NULL, NEEDLE_EMAIL_NULL_LEN, 1175)
    null_free_status = call @json_writer_dispose_finished(null_buffer, null_writer)
    null_free_ok = eq null_free_status, 0
    call @assert_contract(null_free_ok, 1176)

    !null_free_ok
    !null_free_status
    !null_len
    !null_ptr
    !null_buffer
    !null_finish_ok
    !null_finish_status
    !null_write_ok
    !null_write_status
    !null_writer
    !null_writer_status
    !email_free_ok
    !email_free_status
    !email_len
    !email_ptr
    !email_buffer
    !email_finish_ok
    !email_finish_status
    !email_write_ok
    !email_write_status
    !email_writer
    !email_writer_status
    return

