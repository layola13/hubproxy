    fuzzy_empty_len_slot = stack_alloc 8
    fuzzy_empty_finish_status = call @json_writer_finish_view(fuzzy_empty_writer, &fuzzy_empty_buffer_slot, &fuzzy_empty_ptr_slot, &fuzzy_empty_len_slot)
    fuzzy_empty_finish_ok = eq fuzzy_empty_finish_status, 0
    call @assert_contract(fuzzy_empty_finish_ok, 1232)
    fuzzy_empty_buffer = load fuzzy_empty_buffer_slot+0 as ptr
    fuzzy_empty_ptr = load fuzzy_empty_ptr_slot+0 as ptr
    fuzzy_empty_len = load fuzzy_empty_len_slot+0 as u64
