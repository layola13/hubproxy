#def NEEDLE_EMAIL_ALICE_LEN = 27
#def NEEDLE_EMAIL_NULL_LEN = 12

@assert_contract(ok: u8, code: i32):
L_ENTRY:
    br ok -> L_PASS, L_FAIL

L_PASS:
    !ok
    !code
    return

L_FAIL:
    !ok
    panic(code)

@assert_buffer_contains(&buf: ptr, len: u64, &needle: ptr, needle_len: u64, code: i32):
L_ENTRY:
    idx = call @sa_bytes_find(&buf, len, &needle, needle_len)
    ok = sge idx, 0
    call @assert_contract(ok, code)
    !ok
    !idx
    !buf
    !len
    !needle
    !needle_len
    !code
    return

@test "thin rpc empty array result writers cover plugin and skill list shapes"():
L_ENTRY:
    EXPAND JSON_WRITER_NEW_MINIFIED data_writer_status, data_writer
    data_write_status = call @json_writer_write_empty_array_field_result(data_writer, &THIN_KEY_DATA, THIN_KEY_DATA_LEN)
    data_write_ok = eq data_write_status, 0
    call @assert_contract(data_write_ok, 1030)
    data_buffer_slot = stack_alloc 8
    data_ptr_slot = stack_alloc 8
    data_len_slot = stack_alloc 8
    data_finish_status = call @json_writer_finish_view(data_writer, &data_buffer_slot, &data_ptr_slot, &data_len_slot)
    data_finish_ok = eq data_finish_status, 0
    call @assert_contract(data_finish_ok, 1031)
    data_buffer = load data_buffer_slot+0 as ptr
    data_ptr = load data_ptr_slot+0 as ptr
    data_len = load data_len_slot+0 as u64
    call @assert_buffer_contains(&data_ptr, data_len, &NEEDLE_DATA_EMPTY, NEEDLE_DATA_EMPTY_LEN, 1032)
    data_free_status = call @json_writer_dispose_finished(data_buffer, data_writer)
    data_free_ok = eq data_free_status, 0
    call @assert_contract(data_free_ok, 1033)

    EXPAND JSON_WRITER_NEW_MINIFIED contents_writer_status, contents_writer
    contents_write_status = call @json_writer_write_empty_array_field_result(contents_writer, &THIN_KEY_CONTENTS, THIN_KEY_CONTENTS_LEN)
    contents_write_ok = eq contents_write_status, 0
    call @assert_contract(contents_write_ok, 1034)
    contents_buffer_slot = stack_alloc 8
    contents_ptr_slot = stack_alloc 8
    contents_len_slot = stack_alloc 8
    contents_finish_status = call @json_writer_finish_view(contents_writer, &contents_buffer_slot, &contents_ptr_slot, &contents_len_slot)
    contents_finish_ok = eq contents_finish_status, 0
    call @assert_contract(contents_finish_ok, 1035)
    contents_buffer = load contents_buffer_slot+0 as ptr
    contents_ptr = load contents_ptr_slot+0 as ptr
    contents_len = load contents_len_slot+0 as u64
    call @assert_buffer_contains(&contents_ptr, contents_len, &NEEDLE_CONTENTS_EMPTY, NEEDLE_CONTENTS_EMPTY_LEN, 1036)
    contents_free_status = call @json_writer_dispose_finished(contents_buffer, contents_writer)
    contents_free_ok = eq contents_free_status, 0
    call @assert_contract(contents_free_ok, 1037)

    !contents_free_ok
    !contents_free_status
    !contents_len
    !contents_ptr
    !contents_buffer
    !contents_finish_ok
    !contents_finish_status
    !contents_write_ok
    !contents_write_status
    !contents_writer
    !contents_writer_status
    !data_free_ok
    !data_free_status
    !data_len
    !data_ptr
    !data_buffer
    !data_finish_ok
    !data_finish_status
    !data_write_ok
    !data_write_status
    !data_writer
    !data_writer_status
    return

