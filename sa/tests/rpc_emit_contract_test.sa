@test "remote status notification emits Deno status event frame"():
L_ENTRY:
    state = alloc ST_TOTAL
    init_status = call @state_init(&state)
    init_ok = eq init_status, 0
    call @assert_contract(init_ok, 1116)
    cursor = call @state_notify_cursor(&state)
    cursor_slot = stack_alloc 8
    store cursor_slot+0, cursor as u64
    notify_status = call @notify_remote_status(&state, &REMOTE_ENABLE_BODY, REMOTE_ENABLE_BODY_LEN, &REMOTE_STATUS_CONNECTED, REMOTE_STATUS_CONNECTED_LEN)
    notify_ok = eq notify_status, 0
    call @assert_contract(notify_ok, 1117)

    out_frame = stack_alloc 1024
    out_len_slot = stack_alloc 8
    read_status = call @state_notify_read(&state, &cursor_slot, &out_frame, 1024, &out_len_slot)
    read_ok = eq read_status, 1
    call @assert_contract(read_ok, 1118)
    frame_len = load out_len_slot+0 as u64
    call @assert_buffer_contains(&out_frame, frame_len, &NEEDLE_REMOTE_EVENT, NEEDLE_REMOTE_EVENT_LEN, 1119)
    call @assert_buffer_contains(&out_frame, frame_len, &NEEDLE_REMOTE_CONNECTED, NEEDLE_REMOTE_CONNECTED_LEN, 1120)
    call @assert_buffer_contains(&out_frame, frame_len, &NEEDLE_REMOTE_SERVER, NEEDLE_REMOTE_SERVER_LEN, 1121)
    call @assert_buffer_contains(&out_frame, frame_len, &NEEDLE_REMOTE_INSTALL, NEEDLE_REMOTE_INSTALL_LEN, 1122)
    call @assert_buffer_contains(&out_frame, frame_len, &NEEDLE_REMOTE_ENV, NEEDLE_REMOTE_ENV_LEN, 1123)

    !frame_len
    !read_status
    !read_ok
    !notify_status
    !notify_ok
    !cursor
    !init_status
    !init_ok
    !state
    return

