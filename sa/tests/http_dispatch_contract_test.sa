// SA native @test coverage for HTTP dispatch helper contracts.
@import "sa_std/fs.sai"
@import "../src/hub_modules.sa"

@const HTTPD_EMPTY = utf8:""
@const HTTPD_ASCII_WS = utf8:" \t\n\r"
@const HTTPD_JSON_OBJECT = utf8:"{}"
@const HTTPD_WS_JSON_OBJECT = utf8:" \n{}"
@const HTTPD_TOKEN_LONG = utf8:"abcdef123456789"
@const HTTPD_TOKEN_SHORT = utf8:"abc"
@const HTTPD_UPSTREAM_API_KEY = utf8:"sk-upstream"
@const HTTPD_CALLER_AUTH_TOKEN = utf8:"client-secret"
@const HTTPD_PREVIEW_NONE = utf8:"none"
@const HTTPD_PREVIEW_LONG = utf8:"abc...789 (len=15)"
@const HTTPD_PREVIEW_SHORT = utf8:"abc...abc (len=3)"
@const HTTPD_UPSTREAM_AUTH_EXPECTED = utf8:"Bearer sk-upstream"
@const HTTPD_UPSTREAM_BASE = utf8:"https://upstream.test/v1"
@const HTTPD_UPSTREAM_MODELS_EXPECTED = utf8:"https://upstream.test/v1/models"
@const HTTPD_UPSTREAM_CHAT_EXPECTED = utf8:"https://upstream.test/v1/chat/completions"
@const HTTPD_UPSTREAM_RESPONSES_EXPECTED = utf8:"https://upstream.test/v1/responses"
@const HTTPD_LOCAL_AUTH_TOKEN = utf8:"local-secret"
@const HTTPD_AUTH_BEARER_LOCAL = utf8:"Bearer local-secret"
@const HTTPD_AUTH_RAW_LOCAL = utf8:"local-secret"
@const HTTPD_AUTH_EMBEDDED_BEARER = utf8:"Token Bearer local-secret"
@const HTTPD_AUTH_BAD_BEARER = utf8:"Bearer wrong-secret"
@const HTTPD_AUTH_LOG_BEARER_LONG = utf8:"Bearer abcdef123456789"
@const HTTPD_AUTH_LOG_XKEY = utf8:"xkey987654321"
@const HTTPD_AUTH_LOG_EXPECTED = utf8:"zzz111222333444"
@const HTTPD_REQ_LOG_BODY = utf8:"payload"
@const HTTPD_REQ_LOG_RAW_BODY = utf8:"raw"
@const HTTPD_REQ_LOG_CONTENT_TYPE = utf8:"application/json"
@const HTTPD_LOG_DIR = utf8:"/tmp/hubproxy-native-log"
@const HTTPD_LOG_PATH_NEEDLE = utf8:"/request-"
@const HTTPD_LOG_SUFFIX_NEEDLE = utf8:".json"
@const HTTPD_ROUTE_MODELS_TEST = utf8:"/v1/models"
@const HTTPD_ROUTE_RPC_TEST = utf8:"/rpc"
@const HTTPD_METHOD_POST_TEST = utf8:"POST"
@const HTTPD_NEEDLE_AUTH_LOG_KIND = utf8:"\"kind\":\"auth_failure\""
@const HTTPD_NEEDLE_AUTH_LOG_PATH = utf8:"\"path\":\"/rpc\""
@const HTTPD_NEEDLE_AUTH_LOG_AUTH = utf8:"\"authorization\":\"abc...789 (len=15)\""
@const HTTPD_NEEDLE_AUTH_LOG_XAPIKEY = utf8:"\"xApiKey\":\"xke...321 (len=13)\""
@const HTTPD_NEEDLE_AUTH_LOG_EXPECTED = utf8:"\"expectedAuth\":\"zzz...444 (len=15)\""
@const HTTPD_NEEDLE_AUTH_LOG_DASH_XKEY = utf8:"\"x-api-key\""
@const HTTPD_NEEDLE_REQ_LOG_KIND = utf8:"\"kind\":\"request-log\""
@const HTTPD_NEEDLE_REQ_LOG_HEADERS = utf8:"\"headers\":{"
@const HTTPD_NEEDLE_REQ_LOG_METHOD = utf8:"\"method\":\"POST\""
@const HTTPD_NEEDLE_REQ_LOG_XKEY = utf8:"\"x-api-key\":\"xke...321 (len=13)\""
@const HTTPD_NEEDLE_REQ_LOG_CONTENT_TYPE = utf8:"\"content-type\":\"application/json\""
@const HTTPD_NEEDLE_REQ_LOG_BODY_BYTES = utf8:"\"bodyBytes\":7"
@const HTTPD_NEEDLE_REQ_LOG_BODY = utf8:"\"body\":\"payload\""
@const HTTPD_NEEDLE_REQ_LOG_RAW_BODY_BYTES = utf8:"\"rawBodyBytes\":3"
@const HTTPD_NEEDLE_REQ_LOG_RAW_BODY = utf8:"\"rawBody\":\"raw\""
@const HTTPD_NEEDLE_REQ_LOG_BODY_BYTES_ZERO = utf8:"\"bodyBytes\":0"
@const HTTPD_NEEDLE_REQ_LOG_BODY_NULL = utf8:"\"body\":null"
@const HTTPD_NEEDLE_REQ_LOG_RAW_BODY_BYTES_ZERO = utf8:"\"rawBodyBytes\":0"
@const HTTPD_NEEDLE_REQ_LOG_RAW_BODY_NULL = utf8:"\"rawBody\":null"
@const HTTPD_NEEDLE_REQ_LOG_CONTENT_TYPE_NONE = utf8:"\"content-type\":\"none\""
@const HTTPD_NEEDLE_REQ_LOG_EMBEDDED_AUTH = utf8:"\"authorization\":\"Tok...ret (len=25)\""
@const HTTPD_NEEDLE_REQ_LOG_CAMEL_XKEY = utf8:"\"xApiKey\""
@const HTTPD_NEEDLE_HEADER_PLAN_FORWARDED = utf8:"\"forwarded\":{"
@const HTTPD_NEEDLE_HEADER_PLAN_AUTH = utf8:"\"authorization\":\"Bearer sk-upstream\""
@const HTTPD_NEEDLE_HEADER_PLAN_XKEY = utf8:"\"x-api-key\":\"sk-upstream\""
@const HTTPD_NEEDLE_HEADER_PLAN_CONTENT_TYPE = utf8:"\"content-type\":\"application/json\""
@const HTTPD_NEEDLE_HEADER_PLAN_DROPPED = utf8:"\"dropped\":[\"authorization\",\"x-api-key\",\"api-key\",\"content-length\",\"connection\",\"host\"]"
@const HTTPD_NEEDLE_HEADER_PLAN_CLIENT_SECRET = utf8:"client-secret"
@const HTTPD_NEEDLE_HEADER_PLAN_API_KEY_FIELD = utf8:"\"api-key\":\""
@const HTTPD_NEEDLE_HEADER_PLAN_AUTH_FIELD = utf8:"\"authorization\":\""
@const HTTPD_NEEDLE_HEADER_PLAN_XKEY_FIELD = utf8:"\"x-api-key\":\""

