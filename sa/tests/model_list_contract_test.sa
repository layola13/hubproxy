@import "../src/config.sa"
@import "../src/strings.sa"
@import "sa_std/fmt.sai"
@import "sa_std/encoding/json.sai"
@import "sa_std/encoding/json.sal"

@const ENV_PATH = utf8:"/home/vscode/projects/hubproxy/.env"
@const URL_PREFIX = utf8:"http://127.0.0.1:"
@const URL_RPC_SUFFIX = utf8:"/rpc"
@const HDR_AUTH = utf8:"authorization"
@const HDR_CONTENT_TYPE = utf8:"content-type"
@const MIME_JSON = utf8:"application/json"
@const AUTH_PREFIX = utf8:"Bearer "
@const RPC_PLUGIN_INSTALLED_BODY = utf8:"{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"plugin/installed\",\"params\":{}}"
@const RPC_PLUGIN_SKILL_READ_BODY = utf8:"{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"plugin/skill/read\",\"params\":{\"pluginName\":\"codex-test-plugin\",\"skillName\":\"demo\"}}"
@const RPC_PLUGIN_INSTALL_BODY = utf8:"{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"plugin/install\",\"params\":{\"pluginName\":\"codex-test-plugin\"}}"
@const RPC_MODEL_LIST_BODY = utf8:"{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"model/list\",\"params\":{}}"
@const RPC_CONFIG_REQ_BODY = utf8:"{\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"configRequirements/read\",\"params\":{}}"
@const RPC_APP_LIST_BODY = utf8:"{\"jsonrpc\":\"2.0\",\"id\":6,\"method\":\"app/list\",\"params\":{}}"
@const RPC_WS_THREAD_START_BODY = utf8:"{\"jsonrpc\": \"2.0\", \"id\": 201, \"method\": \"thread/start\", \"params\": {\"threadId\": \"ws-thread-native\", \"model\": \"mimo-ws\", \"modelProvider\": \"ws-provider\", \"cwd\": \"/tmp/ws-cwd\", \"ephemeral\": false, \"approvalPolicy\": \"on-request\", \"approvalsReviewer\": \"auto\", \"sandbox\": \"workspace-write\"}}"
@const RPC_WS_THREAD_FORK_BODY = utf8:"{\"jsonrpc\": \"2.0\", \"id\": 206, \"method\": \"thread/fork\", \"params\": {\"threadId\": \"ws-thread-native\", \"model\": \"mimo-ws\", \"modelProvider\": \"ws-provider\", \"cwd\": \"/tmp/ws-cwd\", \"ephemeral\": false, \"approvalPolicy\": \"on-request\", \"approvalsReviewer\": \"auto\", \"sandbox\": \"workspace-write\"}}"
@const RPC_WS_THREAD_RESUME_BODY = utf8:"{\"jsonrpc\": \"2.0\", \"id\": 207, \"method\": \"thread/resume\", \"params\": {\"threadId\": \"ws-thread-native\"}}"
@const RPC_WS_THREAD_READ_BODY = utf8:"{\"jsonrpc\": \"2.0\", \"id\": 202, \"method\": \"thread/read\", \"params\": {\"threadId\": \"ws-thread-native\", \"includeTurns\": true}}"
@const RPC_WS_GOAL_SET_BODY = utf8:"{\"jsonrpc\": \"2.0\", \"id\": 203, \"method\": \"thread/goal/set\", \"params\": {\"threadId\": \"ws-thread-native\", \"objective\": \"ws objective\", \"tokenBudget\": 456}}"
@const RPC_ESC_ENV_BODY = utf8:"{\"jsonrpc\":\"2.0\",\"id\":204,\"method\":\"environment/add\",\"params\":{\"name\":\"env \\\"quoted\\\"\",\"path\":\"/tmp/a\\\\b\"}}"
@const RPC_ESC_REVIEW_BODY = utf8:"{\"jsonrpc\":\"2.0\",\"id\":205,\"method\":\"review/start\",\"params\":{\"threadId\":\"review \\\"quoted\\\"\"}}"
@const RPC_ESC_SHELL_BODY = utf8:"{\"jsonrpc\":\"2.0\",\"id\":208,\"method\":\"thread/shellCommand\",\"params\":{\"threadId\":\"shell \\\"thread\\\"\",\"command\":\"say \\\"hello\\\" \\\\ path\"}}"
@const RPC_ESC_MCP_TOOL_BODY = utf8:"{\"jsonrpc\":\"2.0\",\"id\":209,\"method\":\"mcpServer/tool/call\",\"params\":{\"threadId\":\"mcp \\\"thread\\\"\",\"turnId\":\"turn\\\\x\",\"itemId\":\"item \\\"quoted\\\"\",\"message\":\"tool \\\"called\\\" \\\\ path\",\"tool\":\"read \\\"file\\\"\",\"server\":\"srv\\\\name\"}}"
@const RPC_ESC_FUZZY_BODY = utf8:"{\"jsonrpc\":\"2.0\",\"id\":210,\"method\":\"fuzzyFileSearch\",\"params\":{\"sessionId\":\"sess \\\"quoted\\\"\",\"query\":\"src/\\\\quoted\\\"file\"}}"
@const RPC_ESC_SERVER_RES_BODY = utf8:"{\"jsonrpc\":\"2.0\",\"id\":211,\"method\":\"serverRequest/resolved\",\"params\":{\"threadId\":\"server \\\"thread\\\"\",\"requestId\":\"req\\\\id\\\"quoted\"}}"
@const KEY_OBJECT = utf8:"object"
@const KEY_ID = utf8:"id"
@const KEY_DATA = utf8:"data"
@const VAL_LIST = utf8:"list"
@const VAL_MODEL = utf8:"model"
@const NEEDLE_JSONRPC = utf8:"\"jsonrpc\""
@const NEEDLE_DATA_EMPTY = utf8:"\"data\":[]"
@const NEEDLE_CONTENTS_EMPTY = utf8:"\"contents\":[]"
@const NEEDLE_APPS_AUTH = utf8:"\"appsNeedingAuth\":[]"
@const NEEDLE_AUTH_POLICY = utf8:"\"authPolicy\":\"NOT_AVAILABLE\""
@const NEEDLE_REQUIREMENTS = utf8:"\"requirements\":"
@const NEEDLE_ALLOWED_APPROVAL = utf8:"\"allowedApprovalPolicies\":null"
@const NEEDLE_NEXT_CURSOR = utf8:"\"nextCursor\":null"
@const NEEDLE_ID_201 = utf8:"\"id\":201"
@const NEEDLE_ID_206 = utf8:"\"id\":206"
@const NEEDLE_ID_207 = utf8:"\"id\":207"
@const NEEDLE_ID_202 = utf8:"\"id\":202"
@const NEEDLE_ID_203 = utf8:"\"id\":203"
@const NEEDLE_WS_THREAD = utf8:"\"id\":\"ws-thread-native\""
@const NEEDLE_FORKED_FROM_WS_THREAD = utf8:"\"forkedFromId\":\"ws-thread-native\""
@const NEEDLE_WS_SESSION = utf8:"\"sessionId\":\"ws-thread-native\""
@const NEEDLE_WS_MODEL = utf8:"\"model\":\"mimo-ws\""
@const NEEDLE_WS_PROVIDER = utf8:"\"modelProvider\":\"ws-provider\""
@const NEEDLE_WS_CWD = utf8:"\"cwd\":\"/tmp/ws-cwd\""
@const NEEDLE_WS_EPHEMERAL_FALSE = utf8:"\"ephemeral\":false"
@const NEEDLE_WS_APPROVAL = utf8:"\"approvalPolicy\":\"on-request\""
@const NEEDLE_WS_APPROVAL_DEFAULT = utf8:"\"approvalPolicy\":\"never\""
@const NEEDLE_WS_REVIEWER = utf8:"\"approvalsReviewer\":\"auto\""
@const NEEDLE_WS_REVIEWER_DEFAULT = utf8:"\"approvalsReviewer\":\"user\""
@const NEEDLE_WS_SANDBOX = utf8:"\"sandbox\":\"workspace-write\""
@const NEEDLE_WS_SANDBOX_DEFAULT = utf8:"\"sandbox\":\"danger-full-access\""
@const NEEDLE_WS_GOAL_THREAD = utf8:"\"threadId\":\"ws-thread-native\""
@const NEEDLE_WS_OBJECTIVE = utf8:"\"objective\":\"ws objective\""
@const NEEDLE_WS_BUDGET = utf8:"\"tokenBudget\":456"
@const NEEDLE_ESC_ENV_NAME = utf8:"\"name\":\"env \\\"quoted\\\"\""
@const NEEDLE_ESC_ENV_PATH = utf8:"\"path\":\"/tmp/a\\\\b\""
@const NEEDLE_ESC_REVIEW_A = utf8:"\"reviewThreadId\":\"review \\\"quoted\\\"\""
@const NEEDLE_ESC_REVIEW_B = utf8:"\"threadId\":\"review \\\"quoted\\\"\""
@const NEEDLE_ESC_SHELL_THREAD = utf8:"\"threadId\":\"shell \\\"thread\\\"\""
@const NEEDLE_ESC_SHELL_COMMAND = utf8:"\"command\":\"say \\\"hello\\\" \\\\ path\""
@const NEEDLE_ESC_MCP_MESSAGE = utf8:"\"text\":\"tool \\\"called\\\" \\\\ path\""
@const NEEDLE_ESC_MCP_TOOL = utf8:"\"tool\":\"read \\\"file\\\"\""
@const NEEDLE_ESC_MCP_SERVER = utf8:"\"server\":\"srv\\\\name\""
@const NEEDLE_ESC_MCP_ITEM = utf8:"\"itemId\":\"item \\\"quoted\\\"\""
@const NEEDLE_ESC_FUZZY_PATH = utf8:"\"path\":\"src/\\\\quoted\\\"file\""
@const NEEDLE_ESC_FUZZY_QUERY = utf8:"\"query\":\"src/\\\\quoted\\\"file\""
@const NEEDLE_ESC_SERVER_THREAD = utf8:"\"threadId\":\"server \\\"thread\\\"\""
@const NEEDLE_ESC_SERVER_REQUEST = utf8:"\"requestId\":\"req\\\\id\\\"quoted\""

