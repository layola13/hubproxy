@assert_contract(ok: u8, code: i32):
L_ENTRY:
    br ok -> L_PASS, L_FAIL

L_PASS:
    !ok
    !code
    return

L_FAIL:
    !ok
    panic(code)


@build_rpc_context(&out_cfg: ptr, &out_url_buf: ptr, &out_url_len: ptr, &out_auth_buf: ptr, &out_auth_len: ptr) -> u32:
L_ENTRY:
    cfg = alloc CFG_SIZE
    load_status = call @cfg_load(&ENV_PATH, ENV_PATH_LEN, &cfg)
    load_ok = eq load_status, 0
    call @assert_contract(load_ok, 341)
    !load_status

    url_buf = alloc URL_BUF_SIZE
    url_prefix_dst = ptr_add url_buf, 0
    url_prefix_copy = call @sa_bytes_copy(&url_prefix_dst, &URL_PREFIX, URL_PREFIX_LEN)
    !url_prefix_copy
    !url_prefix_dst
    cfg_port = call @cfg_get_port(&cfg)
    port64 = zext cfg_port as u64
    port_len_slot = stack_alloc 8
    port_dst = ptr_add url_buf, URL_PREFIX_LEN
    port_status = call @sa_fmt_u64_into(port64, 10, port_dst, 8, &port_len_slot)
    port_ok = eq port_status, 0
    call @assert_contract(port_ok, 342)
    !port_status
    !port64
    !cfg_port
    !port_dst
    port_len = load port_len_slot+0 as u64
    suffix_off = add URL_PREFIX_LEN, port_len
    suffix_dst = ptr_add url_buf, suffix_off
    suffix_copy = call @sa_bytes_copy(&suffix_dst, &URL_RPC_SUFFIX, URL_RPC_SUFFIX_LEN)
    !suffix_copy
    !suffix_dst
    url_len = add suffix_off, URL_RPC_SUFFIX_LEN
    !suffix_off
    !port_len

    auth_buf = alloc AUTH_BUF_SIZE
    auth_prefix_dst = ptr_add auth_buf, 0
    auth_prefix_copy = call @sa_bytes_copy(&auth_prefix_dst, &AUTH_PREFIX, AUTH_PREFIX_LEN)
    !auth_prefix_copy
    !auth_prefix_dst
    auth_token_ptr = load cfg+CFG_AUTH_PTR as ptr
    auth_token_len = load cfg+CFG_AUTH_LEN as u64
    auth_token_dst = ptr_add auth_buf, AUTH_PREFIX_LEN
    auth_token_copy = call @sa_bytes_copy(&auth_token_dst, &auth_token_ptr, auth_token_len)
    !auth_token_copy
    !auth_token_dst
    auth_len = add AUTH_PREFIX_LEN, auth_token_len

    store out_cfg+0, cfg as ptr
    store out_url_buf+0, url_buf as ptr
    store out_url_len+0, url_len as u64
    store out_auth_buf+0, auth_buf as ptr
    store out_auth_len+0, auth_len as u64
    !auth_token_ptr
    !auth_token_len
    !auth_len
    !url_len
    !auth_buf
    !url_buf
    !cfg
    !out_cfg
    !out_url_buf
    !out_url_len
    !out_auth_buf
    !out_auth_len
    return 0


@rpc_post_contains(&url_buf: ptr, url_len: u64, &auth_buf: ptr, auth_len: u64, &body: ptr, body_len: u64, &needle: ptr, needle_len: u64) -> u8:
L_ENTRY:
    client_slot = stack_alloc 8
    req_slot = stack_alloc 8
    resp_slot = stack_alloc 8
    reader_slot = stack_alloc 8
    read_len_slot = stack_alloc 8
    resp_buf = stack_alloc RESP_BUF_SIZE
    client_status = call @sa_http_client_new(0, &client_slot)
    client = load client_slot+0 as ptr
    req_status = call @sa_http_client_req_new(client, 2, &url_buf, url_len, &req_slot)
    req = load req_slot+0 as ptr
    auth_hdr_status = call @sa_http_client_req_add_header(req, &HDR_AUTH, HDR_AUTH_LEN, &auth_buf, auth_len)
    ct_status = call @sa_http_client_req_add_header(req, &HDR_CONTENT_TYPE, HDR_CONTENT_TYPE_LEN, &MIME_JSON, MIME_JSON_LEN)
    body_status = call @sa_http_client_req_set_body(req, &body, body_len)
    send_status = call @sa_http_client_req_send(req, &resp_slot)
    resp = load resp_slot+0 as ptr
    code = call @sa_http_client_resp_status(resp)
    reader_status = call @sa_http_client_resp_body_reader(resp, &reader_slot)
    reader = load reader_slot+0 as ptr
    read_status = call @sa_http_client_resp_read_chunk(reader, &resp_buf, RESP_BUF_SIZE, &read_len_slot)
    read_len = load read_len_slot+0 as u64
    needle_idx = call @sa_bytes_find(&resp_buf, read_len, &needle, needle_len)

    client_ok = eq client_status, 0
    req_ok = eq req_status, 0
    auth_ok = eq auth_hdr_status, 0
    ct_ok = eq ct_status, 0
    body_ok = eq body_status, 0
    send_ok = eq send_status, 0
    code_ok = eq code, 200
    reader_ok = eq reader_status, 0
    read_ok = eq read_status, 0
    found = sge needle_idx, 0
    ok = and client_ok, req_ok
    ok = and ok, auth_ok
    ok = and ok, ct_ok
    ok = and ok, body_ok
    ok = and ok, send_ok
    ok = and ok, code_ok
    ok = and ok, reader_ok
    ok = and ok, read_ok
    ok = and ok, found

    call @sa_http_client_body_reader_free(^reader)
    call @sa_http_client_resp_free(^resp)
    call @sa_http_client_req_free(^req)
    call @sa_http_client_free(^client)

    !client_status
    !req_status
    !auth_hdr_status
    !ct_status
    !body_status
    !send_status
    !code
    !reader_status
    !read_status
    !read_len
    !needle_idx
    !client_ok
    !req_ok
    !auth_ok
    !ct_ok
    !body_ok
    !send_ok
    !code_ok
    !reader_ok
    !read_ok
    !found
    !url_buf
    !url_len
    !auth_buf
    !auth_len
    !body
    !body_len
    !needle
    !needle_len
    br ok -> L_RPC_POST_PASS, L_RPC_POST_FAIL

L_RPC_POST_PASS:
    !ok
    return 1

L_RPC_POST_FAIL:
    !ok
    return 0


@test "rpc model/list proxies upstream raw models list"():
L_ENTRY:
    cfg_slot = stack_alloc 8
    url_buf_slot = stack_alloc 8
    url_len_slot = stack_alloc 8
    auth_buf_slot = stack_alloc 8
    auth_len_slot = stack_alloc 8
    context_status = call @build_rpc_context(&cfg_slot, &url_buf_slot, &url_len_slot, &auth_buf_slot, &auth_len_slot)
    context_ok = eq context_status, 0
    call @assert_contract(context_ok, 350)
    !context_status
    cfg = load cfg_slot+0 as ptr
    url_buf = load url_buf_slot+0 as ptr
    url_len = load url_len_slot+0 as u64
    auth_buf = load auth_buf_slot+0 as ptr
    auth_len = load auth_len_slot+0 as u64

    client_slot = stack_alloc 8
    req_slot = stack_alloc 8
    resp_slot = stack_alloc 8
    reader_slot = stack_alloc 8
    read_len_slot = stack_alloc 8
    resp_buf = stack_alloc RESP_BUF_SIZE
    client_status = call @sa_http_client_new(0, &client_slot)
    client_ok = eq client_status, 0
    call @assert_contract(client_ok, 354)
    !client_status
    client = load client_slot+0 as ptr
    req_status = call @sa_http_client_req_new(client, 2, &url_buf, url_len, &req_slot)
    req_ok = eq req_status, 0
    call @assert_contract(req_ok, 355)
    !req_status
    req = load req_slot+0 as ptr
    auth_hdr_status = call @sa_http_client_req_add_header(req, &HDR_AUTH, HDR_AUTH_LEN, &auth_buf, auth_len)
    auth_hdr_ok = eq auth_hdr_status, 0
    call @assert_contract(auth_hdr_ok, 356)
    !auth_hdr_status
    ct_status = call @sa_http_client_req_add_header(req, &HDR_CONTENT_TYPE, HDR_CONTENT_TYPE_LEN, &MIME_JSON, MIME_JSON_LEN)
    ct_ok = eq ct_status, 0
    call @assert_contract(ct_ok, 357)
    !ct_status
    body_status = call @sa_http_client_req_set_body(req, &RPC_MODEL_LIST_BODY, RPC_MODEL_LIST_BODY_LEN)
    body_ok = eq body_status, 0
    call @assert_contract(body_ok, 358)
    !body_status
    send_status = call @sa_http_client_req_send(req, &resp_slot)
    send_ok = eq send_status, 0
    call @assert_contract(send_ok, 359)
    !send_status
    resp = load resp_slot+0 as ptr
    code = call @sa_http_client_resp_status(resp)
    code_ok = eq code, 200
    call @assert_contract(code_ok, 360)
    !code
    reader_status = call @sa_http_client_resp_body_reader(resp, &reader_slot)
    reader_ok = eq reader_status, 0
    call @assert_contract(reader_ok, 361)
    !reader_status
    reader = load reader_slot+0 as ptr
    read_status = call @sa_http_client_resp_read_chunk(reader, &resp_buf, RESP_BUF_SIZE, &read_len_slot)
    read_ok = eq read_status, 0
    call @assert_contract(read_ok, 362)
    !read_status
    read_len = load read_len_slot+0 as u64
    has_body = ugt read_len, 0
    call @assert_contract(has_body, 363)

    call @sa_http_client_body_reader_free(^reader)
    call @sa_http_client_resp_free(^resp)
    call @sa_http_client_req_free(^req)
    call @sa_http_client_free(^client)

    jsonrpc_idx = call @sa_bytes_find(&resp_buf, read_len, &NEEDLE_JSONRPC, NEEDLE_JSONRPC_LEN)
    no_jsonrpc = slt jsonrpc_idx, 0
    call @assert_contract(no_jsonrpc, 364)
    !jsonrpc_idx

    root = call @sa_json_parse(&resp_buf, read_len)
    root_ok = ne root, 0
    call @assert_contract(root_ok, 365)
    root_kind = call @sa_json_kind(root)
    root_is_object = eq root_kind, SA_JSON_KIND_OBJECT
    call @assert_contract(root_is_object, 366)
    !root_kind

    object_ptr_slot = stack_alloc 8
    object_len_slot = stack_alloc 8
    object_status = call @sa_json_object_get_string(root, &KEY_OBJECT, KEY_OBJECT_LEN, &object_ptr_slot, &object_len_slot)
    object_ok = eq object_status, 0
    call @assert_contract(object_ok, 367)
    !object_status
    object_ptr = load object_ptr_slot+0 as ptr
    object_len = load object_len_slot+0 as u64
    object_eq = call @sa_bytes_eq(&object_ptr, object_len, &VAL_LIST, VAL_LIST_LEN)
    object_eq_ok = eq object_eq, 1
    call @assert_contract(object_eq_ok, 368)
    !object_eq
    !object_ptr
    !object_len

    data_slot = stack_alloc 8
    data_status = call @sa_json_object_get(root, &KEY_DATA, KEY_DATA_LEN, &data_slot)
    data_ok = eq data_status, 0
    call @assert_contract(data_ok, 369)
    !data_status
    data_node = load data_slot+0 as ptr
    data_kind = call @sa_json_kind(data_node)
    data_is_array = eq data_kind, SA_JSON_KIND_ARRAY
    call @assert_contract(data_is_array, 370)
    !data_kind
    data_count_slot = stack_alloc 8
    data_count_status = call @sa_json_value_count(data_node, &data_count_slot)
    data_count_ok = eq data_count_status, 0
    call @assert_contract(data_count_ok, 371)
    !data_count_status
    data_count = load data_count_slot+0 as u64
    data_nonempty = ugt data_count, 0
    call @assert_contract(data_nonempty, 372)
    !data_count

    first_slot = stack_alloc 8
    first_status = call @sa_json_array_get(data_node, 0, &first_slot)
    first_ok = eq first_status, 0
    call @assert_contract(first_ok, 373)
    !first_status
    first_node = load first_slot+0 as ptr
    first_kind = call @sa_json_kind(first_node)
    first_is_object = eq first_kind, SA_JSON_KIND_OBJECT
    call @assert_contract(first_is_object, 374)
    !first_kind
    first_id_ptr_slot = stack_alloc 8
    first_id_len_slot = stack_alloc 8
    first_id_status = call @sa_json_object_get_string(first_node, &KEY_ID, KEY_ID_LEN, &first_id_ptr_slot, &first_id_len_slot)
    first_id_ok = eq first_id_status, 0
    call @assert_contract(first_id_ok, 375)
    !first_id_status
    first_id_len = load first_id_len_slot+0 as u64
