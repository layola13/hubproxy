@assert_contract(ok: u8, code: i32):
L_ENTRY:
    br ok -> L_PASS, L_FAIL

L_PASS:
    !ok
    !code
    return

L_FAIL:
    !ok
    panic(code)

@assert_buffer_contains(&buf: ptr, len: u64, &needle: ptr, needle_len: u64, code: i32):
L_ENTRY:
    idx = call @sa_bytes_find(&buf, len, &needle, needle_len)
    ok = sge idx, 0
    call @assert_contract(ok, code)
    !ok
    !idx
    !buf
    !len
    !needle
    !needle_len
    !code
    return

@assert_buffer_not_contains(&buf: ptr, len: u64, &needle: ptr, needle_len: u64, code: i32):
L_ENTRY:
    idx = call @sa_bytes_find(&buf, len, &needle, needle_len)
    ok = slt idx, 0
    call @assert_contract(ok, code)
    !ok
    !idx
    !buf
    !len
    !needle
    !needle_len
    !code
    return

@assert_uuid_v4_shape(&value: ptr, value_len: u64, code: i32):
L_ENTRY:
    len_ok = eq value_len, 36
    call @assert_contract(len_ok, code)
    p8 = ptr_add value, 8
    b8 = load p8+0 as u8
    dash8 = eq b8, 45
    call @assert_contract(dash8, code)
    p13 = ptr_add value, 13
    b13 = load p13+0 as u8
    dash13 = eq b13, 45
    call @assert_contract(dash13, code)
    p18 = ptr_add value, 18
    b18 = load p18+0 as u8
    dash18 = eq b18, 45
    call @assert_contract(dash18, code)
    p23 = ptr_add value, 23
    b23 = load p23+0 as u8
    dash23 = eq b23, 45
    call @assert_contract(dash23, code)
    p14 = ptr_add value, 14
    b14 = load p14+0 as u8
    version_ok = eq b14, 52
    call @assert_contract(version_ok, code)
    p19 = ptr_add value, 19
    b19 = load p19+0 as u8
    is8 = eq b19, 56
    is9 = eq b19, 57
    isa = eq b19, 97
    isb = eq b19, 98
    var_a = or is8, is9
    var_b = or isa, isb
    variant_ok = or var_a, var_b
    call @assert_contract(variant_ok, code)

    !variant_ok
    !var_b
    !var_a
    !isb
    !isa
    !is9
    !is8
    !b19
    !p19
    !version_ok
    !b14
    !p14
    !dash23
    !b23
    !p23
    !dash18
    !b18
    !p18
    !dash13
    !b13
    !p13
    !dash8
    !b8
    !p8
    !len_ok
    !value
    !value_len
    !code
    return

@test "mcp oauth login requires nonempty name like Codex protocol"():
L_ENTRY:
    valid = call @mcp_oauth_login_has_required_name(&OAUTH_LOGIN_VALID, OAUTH_LOGIN_VALID_LEN)
    valid_ok = eq valid, 1
    call @assert_contract(valid_ok, 1)

    missing = call @mcp_oauth_login_has_required_name(&OAUTH_LOGIN_MISSING_NAME, OAUTH_LOGIN_MISSING_NAME_LEN)
    missing_bad = eq missing, 0
    call @assert_contract(missing_bad, 2)

    empty = call @mcp_oauth_login_has_required_name(&OAUTH_LOGIN_EMPTY_NAME, OAUTH_LOGIN_EMPTY_NAME_LEN)
    empty_bad = eq empty, 0
    call @assert_contract(empty_bad, 3)

    numeric = call @mcp_oauth_login_has_required_name(&OAUTH_LOGIN_NUMERIC_NAME, OAUTH_LOGIN_NUMERIC_NAME_LEN)
    numeric_bad = eq numeric, 0
    call @assert_contract(numeric_bad, 4)

    !numeric
    !numeric_bad
    !empty
    !empty_bad
    !missing
    !missing_bad
    !valid
    !valid_ok
    return

@test "mcp tool call plugin rejects missing required protocol fields"():
L_ENTRY:
    out_ptr_slot = stack_alloc 8
    out_len_slot = stack_alloc 8
    missing_thread = call @sa_deno_plugin_mcp_tool_call(&MCP_TOOL_MISSING_THREAD, MCP_TOOL_MISSING_THREAD_LEN, &out_ptr_slot, &out_len_slot)
    missing_thread_bad = eq missing_thread, 3
    call @assert_contract(missing_thread_bad, 11)

    missing_server = call @sa_deno_plugin_mcp_tool_call(&MCP_TOOL_MISSING_SERVER, MCP_TOOL_MISSING_SERVER_LEN, &out_ptr_slot, &out_len_slot)
    missing_server_bad = eq missing_server, 3
    call @assert_contract(missing_server_bad, 12)

    missing_tool = call @sa_deno_plugin_mcp_tool_call(&MCP_TOOL_MISSING_TOOL, MCP_TOOL_MISSING_TOOL_LEN, &out_ptr_slot, &out_len_slot)
    missing_tool_bad = eq missing_tool, 3
    call @assert_contract(missing_tool_bad, 13)

    !missing_tool_bad
    !missing_tool
    !missing_server_bad
    !missing_server
    !missing_thread_bad
    !missing_thread
    return

@test "mcp tool progress event frame includes required protocol fields"():
L_ENTRY:
    state = alloc ST_TOTAL
    init_status = call @state_init(&state)
    init_ok = eq init_status, 0
    call @assert_contract(init_ok, 14)

    cursor = call @state_notify_cursor(&state)
    cursor_slot = stack_alloc 8
    store cursor_slot+0, cursor as u64
    notify_status = call @notify_mcp_tool_progress(&state, &MCP_TOOL_PROGRESS_BODY, MCP_TOOL_PROGRESS_BODY_LEN)
    notify_ok = eq notify_status, 0
    call @assert_contract(notify_ok, 15)

    out_frame = stack_alloc 1024
    out_len_slot = stack_alloc 8
    read_status = call @state_notify_read(&state, &cursor_slot, &out_frame, 1024, &out_len_slot)
    read_ok = eq read_status, 1
    call @assert_contract(read_ok, 16)
    frame_len = load out_len_slot+0 as u64

    event_idx = call @sa_bytes_find(&out_frame, frame_len, &NEEDLE_MCP_PROGRESS_EVENT, NEEDLE_MCP_PROGRESS_EVENT_LEN)
    event_ok = sge event_idx, 0
    call @assert_contract(event_ok, 17)

    thread_idx = call @sa_bytes_find(&out_frame, frame_len, &NEEDLE_MCP_PROGRESS_THREAD, NEEDLE_MCP_PROGRESS_THREAD_LEN)
    thread_ok = sge thread_idx, 0
    call @assert_contract(thread_ok, 18)

    turn_idx = call @sa_bytes_find(&out_frame, frame_len, &NEEDLE_MCP_PROGRESS_TURN, NEEDLE_MCP_PROGRESS_TURN_LEN)
    turn_ok = sge turn_idx, 0
    call @assert_contract(turn_ok, 19)

    item_idx = call @sa_bytes_find(&out_frame, frame_len, &NEEDLE_MCP_PROGRESS_ITEM, NEEDLE_MCP_PROGRESS_ITEM_LEN)
    item_ok = sge item_idx, 0
    call @assert_contract(item_ok, 20)

    message_idx = call @sa_bytes_find(&out_frame, frame_len, &NEEDLE_MCP_PROGRESS_MESSAGE, NEEDLE_MCP_PROGRESS_MESSAGE_LEN)
    message_ok = sge message_idx, 0
    call @assert_contract(message_ok, 21)

