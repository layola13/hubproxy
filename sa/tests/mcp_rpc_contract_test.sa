@test "attestation writer emits attest uuid token like Deno"():
L_ENTRY:
    uuid1_ptr_slot = stack_alloc 8
    uuid1_len_slot = stack_alloc 8
    uuid1_status = call @plugin_random_uuid(&uuid1_ptr_slot, &uuid1_len_slot)
    uuid1_ok = eq uuid1_status, 0
    call @assert_contract(uuid1_ok, 156)
    uuid1_ptr = load uuid1_ptr_slot+0 as ptr
    uuid1_len = load uuid1_len_slot+0 as u64
    call @assert_uuid_v4_shape(&uuid1_ptr, uuid1_len, 157)
    token1_len_slot = stack_alloc 8
    token1_ptr = call @prefix_with_owned(&RPC_SYS_STRING_ATTEST_PREFIX, RPC_SYS_STRING_ATTEST_PREFIX_LEN, &uuid1_ptr, uuid1_len, &token1_len_slot)
    token1_len = load token1_len_slot+0 as u64
    token1_len_ok = eq token1_len, 43
    call @assert_contract(token1_len_ok, 158)

    uuid2_ptr_slot = stack_alloc 8
    uuid2_len_slot = stack_alloc 8
    uuid2_status = call @plugin_random_uuid(&uuid2_ptr_slot, &uuid2_len_slot)
    uuid2_ok = eq uuid2_status, 0
    call @assert_contract(uuid2_ok, 159)
    uuid2_ptr = load uuid2_ptr_slot+0 as ptr
    uuid2_len = load uuid2_len_slot+0 as u64
    call @assert_uuid_v4_shape(&uuid2_ptr, uuid2_len, 160)
    token2_len_slot = stack_alloc 8
    token2_ptr = call @prefix_with_owned(&RPC_SYS_STRING_ATTEST_PREFIX, RPC_SYS_STRING_ATTEST_PREFIX_LEN, &uuid2_ptr, uuid2_len, &token2_len_slot)
    token2_len = load token2_len_slot+0 as u64
    token2_len_ok = eq token2_len, 43
    call @assert_contract(token2_len_ok, 161)
    token_eq_raw = call @sa_bytes_eq(&token1_ptr, token1_len, &token2_ptr, token2_len)
    token_unique = eq token_eq_raw, 0
    call @assert_contract(token_unique, 162)

    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    write_status = call @json_writer_write_attestation_result(writer, &token1_ptr, token1_len)
    buffer_slot = stack_alloc 8
    data_slot = stack_alloc 8
    len_slot = stack_alloc 8
    finish_status = call @json_writer_finish_view(writer, &buffer_slot, &data_slot, &len_slot)
    buffer = load buffer_slot+0 as ptr
    data = load data_slot+0 as ptr
    len = load len_slot+0 as u64
    call @assert_buffer_contains(&data, len, &NEEDLE_ATTEST_TOKEN, NEEDLE_ATTEST_TOKEN_LEN, 163)
    call @assert_buffer_not_contains(&data, len, &NEEDLE_ATTEST_FIXED, NEEDLE_ATTEST_FIXED_LEN, 164)
    free_status = call @json_buffer_dispose(buffer)
    free_ok = eq free_status, 0
    call @assert_contract(free_ok, 165)
    uuid1_free_status = call @plugin_free_buffer(uuid1_ptr, uuid1_len)
    uuid1_free_ok = eq uuid1_free_status, 0
    call @assert_contract(uuid1_free_ok, 166)
    uuid2_free_status = call @plugin_free_buffer(uuid2_ptr, uuid2_len)
    uuid2_free_ok = eq uuid2_free_status, 0
    call @assert_contract(uuid2_free_ok, 167)

    !uuid2_free_ok
    !uuid2_free_status
    !uuid1_free_ok
    !uuid1_free_status
    !free_ok
    !free_status
    !len
    !data
    !buffer
    !finish_status
    !write_status
    !writer
    !writer_status
    !token_unique
    !token_eq_raw
    !token2_len_ok
    !token2_len
    !token2_ptr
    !uuid2_len
    !uuid2_ptr
    !uuid2_ok
    !uuid2_status
    !token1_len_ok
    !token1_len
    !token1_ptr
    !uuid1_len
    !uuid1_ptr
    !uuid1_ok
    !uuid1_status
    return

@test "mcp reload response matches Deno facade name and reloaded fields"():
L_ENTRY:
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    write_status = call @write_mcp_reload_response_object(writer, &RELOAD_DEFAULT_BODY, RELOAD_DEFAULT_BODY_LEN)
    buffer_slot = stack_alloc 8
    data_slot = stack_alloc 8
    len_slot = stack_alloc 8
    finish_status = call @json_writer_finish_view(writer, &buffer_slot, &data_slot, &len_slot)
    buffer = load buffer_slot+0 as ptr
    data = load data_slot+0 as ptr
    len = load len_slot+0 as u64
    default_name_idx = call @sa_bytes_find(&data, len, &NEEDLE_RELOAD_DEFAULT_NAME, NEEDLE_RELOAD_DEFAULT_NAME_LEN)
    has_default_name = sge default_name_idx, 0
    call @assert_contract(has_default_name, 5)
    reloaded_idx = call @sa_bytes_find(&data, len, &NEEDLE_RELOADED_TRUE, NEEDLE_RELOADED_TRUE_LEN)
    has_reloaded = sge reloaded_idx, 0
    call @assert_contract(has_reloaded, 6)

    free_status = call @json_buffer_dispose(buffer)
    free_ok = eq free_status, 0
    call @assert_contract(free_ok, 7)

    EXPAND JSON_WRITER_NEW_MINIFIED writer2_status, writer2
    write2_status = call @write_mcp_reload_response_object(writer2, &RELOAD_NAMED_BODY, RELOAD_NAMED_BODY_LEN)
    buffer2_slot = stack_alloc 8
    data2_slot = stack_alloc 8
    len2_slot = stack_alloc 8
    finish2_status = call @json_writer_finish_view(writer2, &buffer2_slot, &data2_slot, &len2_slot)
    buffer2 = load buffer2_slot+0 as ptr
    data2 = load data2_slot+0 as ptr
    len2 = load len2_slot+0 as u64
    custom_name_idx = call @sa_bytes_find(&data2, len2, &NEEDLE_RELOAD_CUSTOM_NAME, NEEDLE_RELOAD_CUSTOM_NAME_LEN)
    has_custom_name = sge custom_name_idx, 0
    call @assert_contract(has_custom_name, 8)
    reloaded2_idx = call @sa_bytes_find(&data2, len2, &NEEDLE_RELOADED_TRUE, NEEDLE_RELOADED_TRUE_LEN)
    has_reloaded2 = sge reloaded2_idx, 0
    call @assert_contract(has_reloaded2, 9)

    free2_status = call @json_buffer_dispose(buffer2)
    free2_ok = eq free2_status, 0
    call @assert_contract(free2_ok, 10)

    !free2_status
    !free2_ok
    !has_reloaded2
    !reloaded2_idx
    !has_custom_name
    !custom_name_idx
    !len2
    !data2
    !buffer2
    !finish2_status
    !write2_status
    !writer2
    !writer2_status
    !free_status
    !free_ok
    !buffer
    !has_reloaded
    !reloaded_idx
    !has_default_name
    !default_name_idx
    !len
    !data
    !finish_status
    !write_status
    !writer
    !writer_status
    return

@test "mcp status list reaches configured stdio server through plugin"():
L_ENTRY:
    out_ptr_slot = stack_alloc 8
    out_len_slot = stack_alloc 8
    status = call @sa_deno_plugin_mcp_server_status_list(&STATUS_TOOLS_ONLY_BODY, STATUS_TOOLS_ONLY_BODY_LEN, &out_ptr_slot, &out_len_slot)
    status_ok = eq status, 0
    call @assert_contract(status_ok, 30)

    out_ptr = load out_ptr_slot+0 as ptr
    out_len = load out_len_slot+0 as u64

    data_idx = call @sa_bytes_find(&out_ptr, out_len, &NEEDLE_STATUS_DATA, NEEDLE_STATUS_DATA_LEN)
    has_data = sge data_idx, 0
    call @assert_contract(has_data, 31)

    name_idx = call @sa_bytes_find(&out_ptr, out_len, &NEEDLE_STATUS_NAME, NEEDLE_STATUS_NAME_LEN)
    has_name = sge name_idx, 0
    call @assert_contract(has_name, 32)

    tools_idx = call @sa_bytes_find(&out_ptr, out_len, &NEEDLE_STATUS_TOOLS, NEEDLE_STATUS_TOOLS_LEN)
    has_tools = sge tools_idx, 0
    call @assert_contract(has_tools, 33)

    auth_idx = call @sa_bytes_find(&out_ptr, out_len, &NEEDLE_STATUS_AUTH, NEEDLE_STATUS_AUTH_LEN)
    has_auth = sge auth_idx, 0
    call @assert_contract(has_auth, 34)

    free_status = call @plugin_free_buffer(out_ptr, out_len)
    free_ok = eq free_status, 0
    call @assert_contract(free_ok, 35)

    !free_ok
    !free_status
    !has_auth
    !auth_idx
    !has_tools
    !tools_idx
    !has_name
    !name_idx
    !has_data
    !data_idx
    !out_ptr
    !out_len
    !status_ok
    !status
    return
