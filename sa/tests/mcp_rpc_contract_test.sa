@test "realtime start native writers use dynamic UUIDs like Deno"():
L_ENTRY:
    uuid1_ptr_slot = stack_alloc 8
    uuid1_len_slot = stack_alloc 8
    uuid1_status = call @plugin_random_uuid(&uuid1_ptr_slot, &uuid1_len_slot)
    uuid1_ok = eq uuid1_status, 0
    call @assert_contract(uuid1_ok, 132)
    uuid1_ptr = load uuid1_ptr_slot+0 as ptr
    uuid1_len = load uuid1_len_slot+0 as u64
    call @assert_uuid_v4_shape(&uuid1_ptr, uuid1_len, 133)

    uuid2_ptr_slot = stack_alloc 8
    uuid2_len_slot = stack_alloc 8
    uuid2_status = call @plugin_random_uuid(&uuid2_ptr_slot, &uuid2_len_slot)
    uuid2_ok = eq uuid2_status, 0
    call @assert_contract(uuid2_ok, 134)
    uuid2_ptr = load uuid2_ptr_slot+0 as ptr
    uuid2_len = load uuid2_len_slot+0 as u64
    call @assert_uuid_v4_shape(&uuid2_ptr, uuid2_len, 135)
    uuid_eq_raw = call @sa_bytes_eq(&uuid1_ptr, uuid1_len, &uuid2_ptr, uuid2_len)
    uuid_unique = eq uuid_eq_raw, 0
    call @assert_contract(uuid_unique, 136)

    EXPAND JSON_WRITER_NEW_MINIFIED result_writer_status, result_writer
    result_write_status = call @json_writer_write_realtime_start_result(result_writer, &uuid1_ptr, uuid1_len, 1760000000)
    result_buffer_slot = stack_alloc 8
    result_data_slot = stack_alloc 8
    result_len_slot = stack_alloc 8
    result_finish_status = call @json_writer_finish_view(result_writer, &result_buffer_slot, &result_data_slot, &result_len_slot)
    result_buffer = load result_buffer_slot+0 as ptr
    result_data = load result_data_slot+0 as ptr
    result_len = load result_len_slot+0 as u64
    call @assert_buffer_contains(&result_data, result_len, &NEEDLE_RT_TURN_ID_KEY, NEEDLE_RT_TURN_ID_KEY_LEN, 137)
    call @assert_buffer_contains(&result_data, result_len, &NEEDLE_RT_STATUS_COMPLETED, NEEDLE_RT_STATUS_COMPLETED_LEN, 138)
    call @assert_buffer_contains(&result_data, result_len, &NEEDLE_RT_ITEMS_EMPTY, NEEDLE_RT_ITEMS_EMPTY_LEN, 139)
    call @assert_buffer_contains(&result_data, result_len, &NEEDLE_RT_ITEMS_VIEW, NEEDLE_RT_ITEMS_VIEW_LEN, 140)
    call @assert_buffer_contains(&result_data, result_len, &NEEDLE_RT_CREATED_AT, NEEDLE_RT_CREATED_AT_LEN, 141)
    call @assert_buffer_contains(&result_data, result_len, &NEEDLE_RT_UPDATED_AT, NEEDLE_RT_UPDATED_AT_LEN, 142)
    call @assert_buffer_contains(&result_data, result_len, &NEEDLE_RT_STARTED_AT, NEEDLE_RT_STARTED_AT_LEN, 143)
    call @assert_buffer_contains(&result_data, result_len, &NEEDLE_RT_COMPLETED_AT, NEEDLE_RT_COMPLETED_AT_LEN, 144)
    call @assert_buffer_contains(&result_data, result_len, &NEEDLE_RT_DURATION_ZERO, NEEDLE_RT_DURATION_ZERO_LEN, 145)
    call @assert_buffer_contains(&result_data, result_len, &NEEDLE_RT_ERROR_NULL, NEEDLE_RT_ERROR_NULL_LEN, 146)
    call @assert_buffer_not_contains(&result_data, result_len, &NEEDLE_RT_TURN_FIXED, NEEDLE_RT_TURN_FIXED_LEN, 147)
    result_free_status = call @json_buffer_dispose(result_buffer)
    result_free_ok = eq result_free_status, 0
    call @assert_contract(result_free_ok, 148)

    EXPAND JSON_WRITER_NEW_MINIFIED event_writer_status, event_writer
    event_write_status = call @json_writer_write_realtime_started_params(event_writer, &RT_THREAD_ID, RT_THREAD_ID_LEN, &uuid2_ptr, uuid2_len)
    event_buffer_slot = stack_alloc 8
    event_data_slot = stack_alloc 8
    event_len_slot = stack_alloc 8
    event_finish_status = call @json_writer_finish_view(event_writer, &event_buffer_slot, &event_data_slot, &event_len_slot)
    event_buffer = load event_buffer_slot+0 as ptr
    event_data = load event_data_slot+0 as ptr
    event_len = load event_len_slot+0 as u64
    call @assert_buffer_contains(&event_data, event_len, &NEEDLE_RT_THREAD, NEEDLE_RT_THREAD_LEN, 149)
    call @assert_buffer_contains(&event_data, event_len, &NEEDLE_RT_VERSION, NEEDLE_RT_VERSION_LEN, 150)
    call @assert_buffer_contains(&event_data, event_len, &NEEDLE_RT_SESSION, NEEDLE_RT_SESSION_LEN, 151)
    call @assert_buffer_not_contains(&event_data, event_len, &NEEDLE_RT_SESSION_FIXED, NEEDLE_RT_SESSION_FIXED_LEN, 152)
    event_free_status = call @json_buffer_dispose(event_buffer)
    event_free_ok = eq event_free_status, 0
    call @assert_contract(event_free_ok, 153)

    uuid1_free_status = call @plugin_free_buffer(uuid1_ptr, uuid1_len)
    uuid1_free_ok = eq uuid1_free_status, 0
    call @assert_contract(uuid1_free_ok, 154)
    uuid2_free_status = call @plugin_free_buffer(uuid2_ptr, uuid2_len)
    uuid2_free_ok = eq uuid2_free_status, 0
    call @assert_contract(uuid2_free_ok, 155)

    !uuid2_free_ok
    !uuid2_free_status
    !uuid1_free_ok
    !uuid1_free_status
    !event_free_ok
    !event_free_status
    !event_len
    !event_data
    !event_buffer
    !event_finish_status
    !event_write_status
    !event_writer
    !event_writer_status
    !result_free_ok
    !result_free_status
    !result_len
    !result_data
    !result_buffer
    !result_finish_status
    !result_write_status
    !result_writer
    !result_writer_status
    !uuid_unique
    !uuid_eq_raw
    !uuid2_len
    !uuid2_ptr
    !uuid2_ok
    !uuid2_status
    !uuid1_len
    !uuid1_ptr
    !uuid1_ok
    !uuid1_status
    return

@test "realtime append and stop native writers match Deno result shapes"():
L_ENTRY:
    EXPAND JSON_WRITER_NEW_MINIFIED audio_writer_status, audio_writer
    audio_write_status = call @json_writer_write_realtime_thread_result(audio_writer, &RT_THREAD_ID, RT_THREAD_ID_LEN, 1)
    audio_write_ok = eq audio_write_status, 0
    call @assert_contract(audio_write_ok, 168)
    audio_buffer_slot = stack_alloc 8
    audio_data_slot = stack_alloc 8
    audio_len_slot = stack_alloc 8
    audio_finish_status = call @json_writer_finish_view(audio_writer, &audio_buffer_slot, &audio_data_slot, &audio_len_slot)
    audio_buffer = load audio_buffer_slot+0 as ptr
    audio_data = load audio_data_slot+0 as ptr
    audio_len = load audio_len_slot+0 as u64
    call @assert_buffer_contains(&audio_data, audio_len, &NEEDLE_RT_APPENDED_TRUE, NEEDLE_RT_APPENDED_TRUE_LEN, 169)
    call @assert_buffer_contains(&audio_data, audio_len, &NEEDLE_RT_THREAD, NEEDLE_RT_THREAD_LEN, 170)
    call @assert_buffer_contains(&audio_data, audio_len, &NEEDLE_RT_KIND_AUDIO, NEEDLE_RT_KIND_AUDIO_LEN, 171)
    call @assert_buffer_not_contains(&audio_data, audio_len, &NEEDLE_RT_STOPPED_TRUE, NEEDLE_RT_STOPPED_TRUE_LEN, 172)
    audio_free_status = call @json_buffer_dispose(audio_buffer)
    audio_free_ok = eq audio_free_status, 0
    call @assert_contract(audio_free_ok, 173)

    EXPAND JSON_WRITER_NEW_MINIFIED text_writer_status, text_writer
    text_write_status = call @json_writer_write_realtime_thread_result(text_writer, &RT_THREAD_ID, RT_THREAD_ID_LEN, 2)
    text_write_ok = eq text_write_status, 0
