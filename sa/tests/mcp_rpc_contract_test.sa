    call @assert_buffer_contains(&text_data, text_len, &NEEDLE_RT_KIND_TEXT, NEEDLE_RT_KIND_TEXT_LEN, 177)
    call @assert_buffer_not_contains(&text_data, text_len, &NEEDLE_RT_STOPPED_TRUE, NEEDLE_RT_STOPPED_TRUE_LEN, 178)
    text_free_status = call @json_buffer_dispose(text_buffer)
    text_free_ok = eq text_free_status, 0
    call @assert_contract(text_free_ok, 179)

    EXPAND JSON_WRITER_NEW_MINIFIED stop_writer_status, stop_writer
    stop_write_status = call @json_writer_write_realtime_thread_result(stop_writer, &RT_THREAD_ID, RT_THREAD_ID_LEN, 3)
    stop_write_ok = eq stop_write_status, 0
    call @assert_contract(stop_write_ok, 180)
    stop_buffer_slot = stack_alloc 8
    stop_data_slot = stack_alloc 8
    stop_len_slot = stack_alloc 8
    stop_finish_status = call @json_writer_finish_view(stop_writer, &stop_buffer_slot, &stop_data_slot, &stop_len_slot)
    stop_buffer = load stop_buffer_slot+0 as ptr
    stop_data = load stop_data_slot+0 as ptr
    stop_len = load stop_len_slot+0 as u64
    call @assert_buffer_contains(&stop_data, stop_len, &NEEDLE_RT_STOPPED_TRUE, NEEDLE_RT_STOPPED_TRUE_LEN, 181)
    call @assert_buffer_contains(&stop_data, stop_len, &NEEDLE_RT_THREAD, NEEDLE_RT_THREAD_LEN, 182)
    call @assert_buffer_not_contains(&stop_data, stop_len, &NEEDLE_RT_APPENDED_TRUE, NEEDLE_RT_APPENDED_TRUE_LEN, 183)
    call @assert_buffer_not_contains(&stop_data, stop_len, &NEEDLE_RT_KIND_AUDIO, NEEDLE_RT_KIND_AUDIO_LEN, 184)
    call @assert_buffer_not_contains(&stop_data, stop_len, &NEEDLE_RT_KIND_TEXT, NEEDLE_RT_KIND_TEXT_LEN, 185)
    stop_free_status = call @json_buffer_dispose(stop_buffer)
    stop_free_ok = eq stop_free_status, 0
