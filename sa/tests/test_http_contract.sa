@ffi_wrapper rpc_post_contains(&auth_buf: ptr, auth_len: u64, &body: ptr, body_len: u64, &needle: ptr, needle_len: u64) -> u8:
L_ENTRY:
    client_slot = stack_alloc 8
    req_slot = stack_alloc 8
    resp_slot = stack_alloc 8
    reader_slot = stack_alloc 8
    read_len_slot = stack_alloc 8
    resp_buf = stack_alloc RESP_BUF_SIZE

    client_status = call @sa_http_client_new(0, &client_slot)
    client = load client_slot+0 as ptr
    req_status = call @sa_http_client_req_new(client, 2, &URL_RPC, URL_RPC_LEN, &req_slot)
    req = load req_slot+0 as ptr
    auth_hdr_status = call @sa_http_client_req_add_header(req, &HDR_AUTH, HDR_AUTH_LEN, &auth_buf, auth_len)
    ct_status = call @sa_http_client_req_add_header(req, &HDR_CONTENT_TYPE, HDR_CONTENT_TYPE_LEN, &MIME_JSON, MIME_JSON_LEN)
    body_status = call @sa_http_client_req_set_body(req, &body, body_len)
    send_status = call @sa_http_client_req_send(req, &resp_slot)
    resp = load resp_slot+0 as ptr
    code = call @sa_http_client_resp_status(resp)
    reader_status = call @sa_http_client_resp_body_reader(resp, &reader_slot)
    reader = load reader_slot+0 as ptr
    read_status = call @sa_http_client_resp_read_chunk(reader, &resp_buf, RESP_BUF_SIZE, &read_len_slot)
    read_len = load read_len_slot+0 as u64
    needle_idx = call @sa_bytes_find(&resp_buf, read_len, &needle, needle_len)

    client_ok = eq client_status, 0
    req_ok = eq req_status, 0
    auth_ok = eq auth_hdr_status, 0
    ct_ok = eq ct_status, 0
    body_ok = eq body_status, 0
    send_ok = eq send_status, 0
    code_ok = eq code, 200
    reader_ok = eq reader_status, 0
    read_ok = eq read_status, 0
    found = sge needle_idx, 0
    ok = and client_ok, req_ok
    ok = and ok, auth_ok
    ok = and ok, ct_ok
    ok = and ok, body_ok
    ok = and ok, send_ok
    ok = and ok, code_ok
    ok = and ok, reader_ok
    ok = and ok, read_ok
    ok = and ok, found

    call @sa_http_client_body_reader_free(^reader)
    call @sa_http_client_resp_free(^resp)
    call @sa_http_client_req_free(^req)
    call @sa_http_client_free(^client)

    !client_status
    !req_status
    !auth_hdr_status
    !ct_status
    !body_status
    !send_status
    !code
    !reader_status
    !read_status
    !read_len
    !needle_idx
    !client_ok
    !req_ok
    !auth_ok
    !ct_ok
    !body_ok
    !send_ok
    !code_ok
    !reader_ok
    !read_ok
    !found
    !auth_buf
    !auth_len
    !body
    !body_len
    !needle
    !needle_len
    br ok -> L_RPC_POST_PASS, L_RPC_POST_FAIL

L_RPC_POST_PASS:
    !ok
    return 1

L_RPC_POST_FAIL:
    !ok
    return 0

@main() -> i32!:
L_ENTRY:
    cfg = alloc CFG_SIZE
    load_status = call @cfg_load(&ENV_PATH, 7, &cfg)
    load_ok = eq load_status, 0
    !load_status
    br load_ok -> L_CHECK_PORT, L_FAIL_CFG

L_CHECK_PORT:
    !load_ok
    port = call @cfg_get_port(&cfg)
    port_ok = eq port, 28080
    !port
    br port_ok -> L_HEALTH_REQ, L_FAIL_PORT

L_HEALTH_REQ:
    !port_ok
    client_slot = stack_alloc 8
    req_slot = stack_alloc 8
    resp_slot = stack_alloc 8
    status = call @sa_http_client_new(0, &client_slot)
    client = load client_slot+0 as ptr
    req_status = call @sa_http_client_req_new(client, 1, &URL_HEALTH, URL_HEALTH_LEN, &req_slot)
    req = load req_slot+0 as ptr
    send_status = call @sa_http_client_req_send(req, &resp_slot)
    health_send_ok = eq send_status, 0
    br health_send_ok -> L_HEALTH_RESP, L_HEALTH_SEND_FAIL

L_HEALTH_RESP:
    !health_send_ok
    resp = load resp_slot+0 as ptr
    health_code = call @sa_http_client_resp_status(resp)
    health_ok = eq health_code, 200
    call @sa_http_client_resp_free(^resp)
    call @sa_http_client_req_free(^req)
    call @sa_http_client_free(^client)
    !status
    !req_status
    !send_status
    !health_code
    br health_ok -> L_RPC_UNAUTH_REQ, L_FAIL_HEALTH

L_HEALTH_SEND_FAIL:
    !health_send_ok
    call @sa_http_client_req_free(^req)
    call @sa_http_client_free(^client)
    !status
    !req_status
    !send_status
    jmp L_FAIL_HEALTH_NO_RESPONSE

L_RPC_UNAUTH_REQ:
    !health_ok
    unauth_client_slot = stack_alloc 8
    unauth_req_slot = stack_alloc 8
    unauth_resp_slot = stack_alloc 8
    unauth_reader_slot = stack_alloc 8
    unauth_read_len_slot = stack_alloc 8
    unauth_resp_buf = stack_alloc RESP_BUF_SIZE
    unauth_client_status = call @sa_http_client_new(0, &unauth_client_slot)
    unauth_client = load unauth_client_slot+0 as ptr
    unauth_req_status = call @sa_http_client_req_new(unauth_client, 2, &URL_RPC, URL_RPC_LEN, &unauth_req_slot)
    unauth_req = load unauth_req_slot+0 as ptr
    unauth_hdr_status = call @sa_http_client_req_add_header(unauth_req, &HDR_CONTENT_TYPE, HDR_CONTENT_TYPE_LEN, &MIME_JSON, MIME_JSON_LEN)
    unauth_body_status = call @sa_http_client_req_set_body(unauth_req, &RPC_INIT_BODY, RPC_INIT_BODY_LEN)
    unauth_send_status = call @sa_http_client_req_send(unauth_req, &unauth_resp_slot)
    unauth_resp = load unauth_resp_slot+0 as ptr
    unauth_code = call @sa_http_client_resp_status(unauth_resp)
    unauth_reader_status = call @sa_http_client_resp_body_reader(unauth_resp, &unauth_reader_slot)
    unauth_reader = load unauth_reader_slot+0 as ptr
    unauth_read_status = call @sa_http_client_resp_read_chunk(unauth_reader, &unauth_resp_buf, RESP_BUF_SIZE, &unauth_read_len_slot)
    unauth_read_len = load unauth_read_len_slot+0 as u64
    unauth_body_match = call @sa_bytes_eq(&unauth_resp_buf, unauth_read_len, &UNAUTH_RESP, UNAUTH_RESP_LEN)
    unauth_code_ok = eq unauth_code, 401
    unauth_body_ok = eq unauth_body_match, 1
    unauth_ok = and unauth_code_ok, unauth_body_ok
    call @sa_http_client_body_reader_free(^unauth_reader)
    call @sa_http_client_resp_free(^unauth_resp)
    call @sa_http_client_req_free(^unauth_req)
    call @sa_http_client_free(^unauth_client)
    !unauth_client_status
    !unauth_req_status
    !unauth_hdr_status
    !unauth_body_status
    !unauth_send_status
    !unauth_code
    !unauth_reader_status
    !unauth_read_status
    !unauth_read_len
    !unauth_body_match
    !unauth_code_ok
    !unauth_body_ok
    br unauth_ok -> L_MODELS_PUBLIC_REQ, L_FAIL_UNAUTH

L_MODELS_PUBLIC_REQ:
    !unauth_ok
    models_client_slot = stack_alloc 8
    models_req_slot = stack_alloc 8
    models_resp_slot = stack_alloc 8
    models_reader_slot = stack_alloc 8
    models_read_len_slot = stack_alloc 8
    models_resp_buf = stack_alloc RESP_BUF_SIZE
    models_client_status = call @sa_http_client_new(0, &models_client_slot)
    models_client = load models_client_slot+0 as ptr
    models_req_status = call @sa_http_client_req_new(models_client, 1, &URL_MODELS, URL_MODELS_LEN, &models_req_slot)
    models_req = load models_req_slot+0 as ptr
    models_send_status = call @sa_http_client_req_send(models_req, &models_resp_slot)
    models_resp = load models_resp_slot+0 as ptr
    models_code = call @sa_http_client_resp_status(models_resp)
    models_hdr_ptr_slot = stack_alloc 8
    models_hdr_len_slot = stack_alloc 8
    store models_hdr_ptr_slot+0, 0 as ptr
    store models_hdr_len_slot+0, 0 as u64
    models_hdr_status = call @sa_http_client_resp_get_header(models_resp, &HDR_CONTENT_TYPE, HDR_CONTENT_TYPE_LEN, &models_hdr_ptr_slot, &models_hdr_len_slot)
    models_hdr_ptr = load models_hdr_ptr_slot+0 as ptr
    models_hdr_len = load models_hdr_len_slot+0 as u64
    models_text_idx = call @sa_bytes_find(&models_hdr_ptr, models_hdr_len, &MIME_TEXT_PLAIN, MIME_TEXT_PLAIN_LEN)
    models_not_text = slt models_text_idx, 0
    models_reader_status = call @sa_http_client_resp_body_reader(models_resp, &models_reader_slot)
    models_reader = load models_reader_slot+0 as ptr
    models_read_status = call @sa_http_client_resp_read_chunk(models_reader, &models_resp_buf, RESP_BUF_SIZE, &models_read_len_slot)
    models_read_len = load models_read_len_slot+0 as u64
    models_unauth_idx = call @sa_bytes_find(&models_resp_buf, models_read_len, &NEEDLE_LOCAL_UNAUTH, NEEDLE_LOCAL_UNAUTH_LEN)
    models_public_ok = slt models_unauth_idx, 0
    models_public_ok = and models_public_ok, models_not_text
    call @sa_http_client_body_reader_free(^models_reader)
    call @sa_http_client_resp_free(^models_resp)
    call @sa_http_client_req_free(^models_req)
    call @sa_http_client_free(^models_client)
    !models_client_status
    !models_req_status
    !models_send_status
    !models_hdr_status
    !models_hdr_ptr
    !models_hdr_len
    !models_text_idx
    !models_not_text
    !models_code
    !models_reader_status
    !models_read_status
    !models_read_len
    !models_unauth_idx
    br models_public_ok -> L_AUTH_HEADER, L_FAIL_MODELS_PUBLIC

L_AUTH_HEADER:
    !models_public_ok
    auth_buf = stack_alloc AUTH_BUF_SIZE
    auth_dst = ptr_add auth_buf, 0
    prefix_copy = call @sa_bytes_copy(&auth_dst, &AUTH_PREFIX, AUTH_PREFIX_LEN)
    !prefix_copy
    !auth_dst
    auth_token_ptr = load cfg+CFG_AUTH_PTR as ptr
    auth_token_len = load cfg+CFG_AUTH_LEN as u64
    token_dst = ptr_add auth_buf, AUTH_PREFIX_LEN
    token_copy = call @sa_bytes_copy(&token_dst, &auth_token_ptr, auth_token_len)
    !token_copy
    !token_dst
    auth_len = add auth_token_len, AUTH_PREFIX_LEN
    token_present = ugt auth_token_len, 0
    br token_present -> L_CHAT_STATUS_REQ, L_FAIL_AUTH

L_CHAT_STATUS_REQ:
    !token_present
    chat_client_slot = stack_alloc 8
    chat_req_slot = stack_alloc 8
    chat_resp_slot = stack_alloc 8
    chat_client_status = call @sa_http_client_new(0, &chat_client_slot)
    chat_client = load chat_client_slot+0 as ptr
    chat_req_status = call @sa_http_client_req_new(chat_client, 2, &URL_CHAT, URL_CHAT_LEN, &chat_req_slot)
    chat_req = load chat_req_slot+0 as ptr
    chat_auth_status = call @sa_http_client_req_add_header(chat_req, &HDR_AUTH, HDR_AUTH_LEN, &auth_buf, auth_len)
    chat_ct_status = call @sa_http_client_req_add_header(chat_req, &HDR_CONTENT_TYPE, HDR_CONTENT_TYPE_LEN, &MIME_JSON, MIME_JSON_LEN)
    chat_body_status = call @sa_http_client_req_set_body(chat_req, &EMPTY_JSON_BODY, EMPTY_JSON_BODY_LEN)
    chat_send_status = call @sa_http_client_req_send(chat_req, &chat_resp_slot)
    chat_resp = load chat_resp_slot+0 as ptr
    chat_code = call @sa_http_client_resp_status(chat_resp)
    chat_hdr_ptr_slot = stack_alloc 8
    chat_hdr_len_slot = stack_alloc 8
    store chat_hdr_ptr_slot+0, 0 as ptr
    store chat_hdr_len_slot+0, 0 as u64
    chat_hdr_status = call @sa_http_client_resp_get_header(chat_resp, &HDR_CONTENT_TYPE, HDR_CONTENT_TYPE_LEN, &chat_hdr_ptr_slot, &chat_hdr_len_slot)
    chat_hdr_ptr = load chat_hdr_ptr_slot+0 as ptr
    chat_hdr_len = load chat_hdr_len_slot+0 as u64
    chat_sse_idx = call @sa_bytes_find(&chat_hdr_ptr, chat_hdr_len, &MIME_EVENT_STREAM, MIME_EVENT_STREAM_LEN)
    chat_not_sse = slt chat_sse_idx, 0
    chat_status_ok = ne chat_code, 200
    chat_status_ok = and chat_status_ok, chat_not_sse
    call @sa_http_client_resp_free(^chat_resp)
    call @sa_http_client_req_free(^chat_req)
    call @sa_http_client_free(^chat_client)
    !chat_client_status
    !chat_req_status
    !chat_auth_status
    !chat_ct_status
    !chat_body_status
    !chat_send_status
    !chat_hdr_status
    !chat_hdr_ptr
    !chat_hdr_len
    !chat_sse_idx
    !chat_not_sse
    !chat_code
    br chat_status_ok -> L_RESP_FALLBACK_REQ, L_FAIL_CHAT_STATUS

L_RESP_FALLBACK_REQ:
    !chat_status_ok
    resp_client_slot = stack_alloc 8
    resp_req_slot = stack_alloc 8
    resp_resp_slot = stack_alloc 8
    resp_reader_slot = stack_alloc 8
    resp_read_len_slot = stack_alloc 8
    resp_buf = stack_alloc RESP_BUF_SIZE
    resp_client_status = call @sa_http_client_new(0, &resp_client_slot)
    resp_client = load resp_client_slot+0 as ptr
    resp_req_status = call @sa_http_client_req_new(resp_client, 2, &URL_RESP, URL_RESP_LEN, &resp_req_slot)
    resp_req = load resp_req_slot+0 as ptr
    resp_auth_status = call @sa_http_client_req_add_header(resp_req, &HDR_AUTH, HDR_AUTH_LEN, &auth_buf, auth_len)
    resp_ct_status = call @sa_http_client_req_add_header(resp_req, &HDR_CONTENT_TYPE, HDR_CONTENT_TYPE_LEN, &MIME_JSON, MIME_JSON_LEN)
    resp_body_status = call @sa_http_client_req_set_body(resp_req, &RESP_FALLBACK_BODY, RESP_FALLBACK_BODY_LEN)
    resp_send_status = call @sa_http_client_req_send(resp_req, &resp_resp_slot)
    resp_resp = load resp_resp_slot+0 as ptr
    resp_code = call @sa_http_client_resp_status(resp_resp)
    resp_reader_status = call @sa_http_client_resp_body_reader(resp_resp, &resp_reader_slot)
    resp_reader = load resp_reader_slot+0 as ptr
    resp_read_status = call @sa_http_client_resp_read_chunk(resp_reader, &resp_buf, RESP_BUF_SIZE, &resp_read_len_slot)
    resp_read_len = load resp_read_len_slot+0 as u64
    resp_chat_idx = call @sa_bytes_find(&resp_buf, resp_read_len, &NEEDLE_RESPONSE_OBJECT, NEEDLE_RESPONSE_OBJECT_LEN)
    resp_html_idx = call @sa_bytes_find(&resp_buf, resp_read_len, &NEEDLE_HTML, NEEDLE_HTML_LEN)
    resp_code_ok = ne resp_code, 404
    resp_chat_ok = sge resp_chat_idx, 0
    resp_no_html = slt resp_html_idx, 0
    resp_ok = and resp_code_ok, resp_chat_ok
    resp_ok = and resp_ok, resp_no_html
    call @sa_http_client_body_reader_free(^resp_reader)
    call @sa_http_client_resp_free(^resp_resp)
    call @sa_http_client_req_free(^resp_req)
    call @sa_http_client_free(^resp_client)
    !resp_client_status
    !resp_req_status
    !resp_auth_status
    !resp_ct_status
    !resp_body_status
    !resp_send_status
    !resp_code
    !resp_reader_status
    !resp_read_status
    !resp_read_len
    !resp_chat_idx
    !resp_html_idx
    !resp_code_ok
    !resp_chat_ok
    !resp_no_html
    br resp_ok -> L_RPC_GET_NOT_FOUND_REQ, L_FAIL_RESP_FALLBACK

L_RPC_GET_NOT_FOUND_REQ:
    !resp_ok
    rpc_get_client_slot = stack_alloc 8
    rpc_get_req_slot = stack_alloc 8
    rpc_get_resp_slot = stack_alloc 8
    rpc_get_client_status = call @sa_http_client_new(0, &rpc_get_client_slot)
    rpc_get_client = load rpc_get_client_slot+0 as ptr
    rpc_get_req_status = call @sa_http_client_req_new(rpc_get_client, 1, &URL_RPC, URL_RPC_LEN, &rpc_get_req_slot)
    rpc_get_req = load rpc_get_req_slot+0 as ptr
    rpc_get_auth_status = call @sa_http_client_req_add_header(rpc_get_req, &HDR_AUTH, HDR_AUTH_LEN, &auth_buf, auth_len)
    rpc_get_send_status = call @sa_http_client_req_send(rpc_get_req, &rpc_get_resp_slot)
    rpc_get_resp = load rpc_get_resp_slot+0 as ptr
    rpc_get_code = call @sa_http_client_resp_status(rpc_get_resp)
    rpc_get_ok = eq rpc_get_code, 404
    call @sa_http_client_resp_free(^rpc_get_resp)
    call @sa_http_client_req_free(^rpc_get_req)
    call @sa_http_client_free(^rpc_get_client)
    !rpc_get_client_status
    !rpc_get_req_status
    !rpc_get_auth_status
    !rpc_get_send_status
    !rpc_get_code
    br rpc_get_ok -> L_RPC_AUTH_REQ, L_FAIL_RPC_GET

L_RPC_AUTH_REQ:
    !rpc_get_ok
    auth_client_slot = stack_alloc 8
    auth_req_slot = stack_alloc 8
    auth_resp_slot = stack_alloc 8
    auth_reader_slot = stack_alloc 8
    auth_read_len_slot = stack_alloc 8
    auth_resp_buf = stack_alloc RESP_BUF_SIZE
    auth_client_status = call @sa_http_client_new(0, &auth_client_slot)
    auth_client = load auth_client_slot+0 as ptr
    auth_req_status = call @sa_http_client_req_new(auth_client, 2, &URL_RPC, URL_RPC_LEN, &auth_req_slot)
    auth_req = load auth_req_slot+0 as ptr
    auth_hdr_status = call @sa_http_client_req_add_header(auth_req, &HDR_AUTH, HDR_AUTH_LEN, &auth_buf, auth_len)
    auth_ct_status = call @sa_http_client_req_add_header(auth_req, &HDR_CONTENT_TYPE, HDR_CONTENT_TYPE_LEN, &MIME_JSON, MIME_JSON_LEN)
    auth_body_status = call @sa_http_client_req_set_body(auth_req, &RPC_INIT_BODY, RPC_INIT_BODY_LEN)
    auth_send_status = call @sa_http_client_req_send(auth_req, &auth_resp_slot)
    auth_resp = load auth_resp_slot+0 as ptr
    auth_code = call @sa_http_client_resp_status(auth_resp)
    auth_reader_status = call @sa_http_client_resp_body_reader(auth_resp, &auth_reader_slot)
    auth_reader = load auth_reader_slot+0 as ptr
    auth_read_status = call @sa_http_client_resp_read_chunk(auth_reader, &auth_resp_buf, RESP_BUF_SIZE, &auth_read_len_slot)
    auth_read_len = load auth_read_len_slot+0 as u64
    auth_id_idx = call @sa_bytes_find(&auth_resp_buf, auth_read_len, &NEEDLE_INIT_ID, NEEDLE_INIT_ID_LEN)
    auth_user_agent_idx = call @sa_bytes_find(&auth_resp_buf, auth_read_len, &NEEDLE_INIT_USER_AGENT, NEEDLE_INIT_USER_AGENT_LEN)
    auth_codex_home_idx = call @sa_bytes_find(&auth_resp_buf, auth_read_len, &NEEDLE_INIT_CODEX_HOME, NEEDLE_INIT_CODEX_HOME_LEN)
    auth_platform_family_idx = call @sa_bytes_find(&auth_resp_buf, auth_read_len, &NEEDLE_INIT_PLATFORM_FAMILY, NEEDLE_INIT_PLATFORM_FAMILY_LEN)
    auth_platform_os_idx = call @sa_bytes_find(&auth_resp_buf, auth_read_len, &NEEDLE_INIT_PLATFORM_OS, NEEDLE_INIT_PLATFORM_OS_LEN)
    auth_code_ok = eq auth_code, 200
    auth_id_ok = sge auth_id_idx, 0
    auth_user_agent_ok = sge auth_user_agent_idx, 0
    auth_codex_home_ok = sge auth_codex_home_idx, 0
    auth_platform_family_ok = sge auth_platform_family_idx, 0
    auth_platform_os_ok = sge auth_platform_os_idx, 0
    auth_body_ok = and auth_id_ok, auth_user_agent_ok
    auth_body_ok = and auth_body_ok, auth_codex_home_ok
    auth_body_ok = and auth_body_ok, auth_platform_family_ok
    auth_body_ok = and auth_body_ok, auth_platform_os_ok
    auth_reader_ok = eq auth_reader_status, 0
    auth_read_ok = eq auth_read_status, 0
    auth_ok = and auth_code_ok, auth_body_ok
    auth_ok = and auth_ok, auth_reader_ok
    auth_ok = and auth_ok, auth_read_ok
    call @sa_http_client_body_reader_free(^auth_reader)
    call @sa_http_client_resp_free(^auth_resp)
    call @sa_http_client_req_free(^auth_req)
    call @sa_http_client_free(^auth_client)
    !auth_client_status
    !auth_req_status
    !auth_hdr_status
    !auth_ct_status
    !auth_body_status
    !auth_send_status
    !auth_code
    !auth_reader_status
    !auth_read_status
    !auth_read_len
    !auth_id_idx
    !auth_user_agent_idx
    !auth_codex_home_idx
    !auth_platform_family_idx
    !auth_platform_os_idx
    !auth_code_ok
    !auth_id_ok
    !auth_user_agent_ok
    !auth_codex_home_ok
    !auth_platform_family_ok
    !auth_platform_os_ok
    !auth_body_ok
    !auth_reader_ok
    !auth_read_ok
    br auth_ok -> L_THREAD_START_REQ, L_FAIL_AUTH_RPC

