    fuzzy_path_ok = call @rpc_post_contains(&auth_buf, auth_len, &RPC_FUZZY_BODY, RPC_FUZZY_BODY_LEN, &NEEDLE_FUZZY_PATH, NEEDLE_FUZZY_PATH_LEN)
    is_fuzzy_path_ok = eq fuzzy_path_ok, 1
    !fuzzy_path_ok
    br is_fuzzy_path_ok -> L_FUZZY_START_REQ, L_FAIL_FUZZY_PATH

L_FUZZY_START_REQ:
    !is_fuzzy_path_ok
    fuzzy_start_ok = call @rpc_post_contains(&auth_buf, auth_len, &RPC_FUZZY_START_BODY, RPC_FUZZY_START_BODY_LEN, &NEEDLE_SESSION, NEEDLE_SESSION_LEN)
    is_fuzzy_start_ok = eq fuzzy_start_ok, 1
    !fuzzy_start_ok
    br is_fuzzy_start_ok -> L_FUZZY_STOP_REQ, L_FAIL_FUZZY_START

L_FUZZY_STOP_REQ:
    !is_fuzzy_start_ok
    fuzzy_stop_ok = call @rpc_post_contains(&auth_buf, auth_len, &RPC_FUZZY_STOP_BODY, RPC_FUZZY_STOP_BODY_LEN, &NEEDLE_STOPPED, NEEDLE_STOPPED_LEN)
    is_fuzzy_stop_ok = eq fuzzy_stop_ok, 1
    !fuzzy_stop_ok
    br is_fuzzy_stop_ok -> L_SERVER_RESOLVED_REQ, L_FAIL_FUZZY_STOP

L_SERVER_RESOLVED_REQ:
    !is_fuzzy_stop_ok
    server_resolved_ok = call @rpc_post_contains(&auth_buf, auth_len, &RPC_SERVER_RESOLVED_BODY, RPC_SERVER_RESOLVED_BODY_LEN, &NEEDLE_REQUEST_ID, NEEDLE_REQUEST_ID_LEN)
    is_server_resolved_ok = eq server_resolved_ok, 1
    !server_resolved_ok
    br is_server_resolved_ok -> L_WORLD_WARN_REQ, L_FAIL_SERVER_RESOLVED

L_WORLD_WARN_REQ:
    !is_server_resolved_ok
    world_warn_ok = call @rpc_post_contains(&auth_buf, auth_len, &RPC_WORLD_WARN_BODY, RPC_WORLD_WARN_BODY_LEN, &NEEDLE_WARNED, NEEDLE_WARNED_LEN)
    is_world_warn_ok = eq world_warn_ok, 1
    !world_warn_ok
    br is_world_warn_ok -> L_COMMAND_WRITE_REQ2, L_FAIL_WORLD_WARN

L_COMMAND_WRITE_REQ2:
    !is_world_warn_ok
    command_write_ok = call @rpc_post_contains(&auth_buf, auth_len, &RPC_COMMAND_WRITE_BODY, RPC_COMMAND_WRITE_BODY_LEN, &NEEDLE_OK_TRUE, NEEDLE_OK_TRUE_LEN)
    is_command_write_ok = eq command_write_ok, 1
    !command_write_ok
    br is_command_write_ok -> L_PROCESS_SPAWN_REQ, L_FAIL_COMMAND_WRITE

L_PROCESS_SPAWN_REQ:
    !is_command_write_ok
    process_spawn_ok = call @rpc_post_contains(&auth_buf, auth_len, &RPC_PROCESS_SPAWN_BODY, RPC_PROCESS_SPAWN_BODY_LEN, &NEEDLE_PROCESS_HANDLE, NEEDLE_PROCESS_HANDLE_LEN)
    is_process_spawn_ok = eq process_spawn_ok, 1
    !process_spawn_ok
    br is_process_spawn_ok -> L_REALTIME_START_REQ, L_FAIL_PROCESS_SPAWN

L_REALTIME_START_REQ:
    !is_process_spawn_ok
    realtime_start_ok = call @rpc_post_contains(&auth_buf, auth_len, &RPC_REALTIME_START_BODY, RPC_REALTIME_START_BODY_LEN, &NEEDLE_STATUS_COMPLETED, NEEDLE_STATUS_COMPLETED_LEN)
    is_realtime_start_ok = eq realtime_start_ok, 1
    !realtime_start_ok
    br is_realtime_start_ok -> L_REALTIME_AUDIO_REQ, L_FAIL_REALTIME_START

L_REALTIME_AUDIO_REQ:
    !is_realtime_start_ok
    realtime_audio_ok = call @rpc_post_contains(&auth_buf, auth_len, &RPC_REALTIME_AUDIO_BODY, RPC_REALTIME_AUDIO_BODY_LEN, &NEEDLE_KIND_AUDIO, NEEDLE_KIND_AUDIO_LEN)
    is_realtime_audio_ok = eq realtime_audio_ok, 1
    !realtime_audio_ok
    br is_realtime_audio_ok -> L_REALTIME_TEXT_REQ, L_FAIL_REALTIME_AUDIO

L_REALTIME_TEXT_REQ:
    !is_realtime_audio_ok
    realtime_text_ok = call @rpc_post_contains(&auth_buf, auth_len, &RPC_REALTIME_TEXT_BODY, RPC_REALTIME_TEXT_BODY_LEN, &NEEDLE_KIND_TEXT, NEEDLE_KIND_TEXT_LEN)
    is_realtime_text_ok = eq realtime_text_ok, 1
    !realtime_text_ok
    br is_realtime_text_ok -> L_REALTIME_STOP_REQ, L_FAIL_REALTIME_TEXT

L_REALTIME_STOP_REQ:
    !is_realtime_text_ok
    realtime_stop_ok = call @rpc_post_contains(&auth_buf, auth_len, &RPC_REALTIME_STOP_BODY, RPC_REALTIME_STOP_BODY_LEN, &NEEDLE_STOPPED_TRUE, NEEDLE_STOPPED_TRUE_LEN)
    is_realtime_stop_ok = eq realtime_stop_ok, 1
    !realtime_stop_ok
    br is_realtime_stop_ok -> L_MCP_TOOL_REQ, L_FAIL_REALTIME_STOP

L_MCP_TOOL_REQ:
    !is_realtime_stop_ok
    mcp_tool_ok = call @rpc_post_contains(&auth_buf, auth_len, &RPC_MCP_TOOL_BODY, RPC_MCP_TOOL_BODY_LEN, &NEEDLE_STRUCTURED_OK, NEEDLE_STRUCTURED_OK_LEN)
    is_mcp_tool_ok = eq mcp_tool_ok, 1
    !mcp_tool_ok
    br is_mcp_tool_ok -> L_MCP_TOOL_MSG_REQ, L_FAIL_MCP_TOOL

L_MCP_TOOL_MSG_REQ:
    !is_mcp_tool_ok
    mcp_msg_ok = call @rpc_post_contains(&auth_buf, auth_len, &RPC_MCP_TOOL_BODY, RPC_MCP_TOOL_BODY_LEN, &NEEDLE_MCP_MSG, NEEDLE_MCP_MSG_LEN)
    is_mcp_msg_ok = eq mcp_msg_ok, 1
    !mcp_msg_ok
    br is_mcp_msg_ok -> L_MCP_TOOL_NAME_REQ, L_FAIL_MCP_MSG

L_MCP_TOOL_NAME_REQ:
    !is_mcp_msg_ok
    mcp_tool_name_ok = call @rpc_post_contains(&auth_buf, auth_len, &RPC_MCP_TOOL_BODY, RPC_MCP_TOOL_BODY_LEN, &NEEDLE_MCP_TOOL, NEEDLE_MCP_TOOL_LEN)
    is_mcp_tool_name_ok = eq mcp_tool_name_ok, 1
    !mcp_tool_name_ok
    br is_mcp_tool_name_ok -> L_MCP_TOOL_THREAD_REQ, L_FAIL_MCP_TOOL_NAME

L_MCP_TOOL_THREAD_REQ:
    !is_mcp_tool_name_ok
    mcp_thread_ok = call @rpc_post_contains(&auth_buf, auth_len, &RPC_MCP_TOOL_BODY, RPC_MCP_TOOL_BODY_LEN, &NEEDLE_MCP_THREAD, NEEDLE_MCP_THREAD_LEN)
    is_mcp_thread_ok = eq mcp_thread_ok, 1
    !mcp_thread_ok
    br is_mcp_thread_ok -> L_COMMAND_EXEC_EXIT_REQ, L_FAIL_MCP_THREAD

L_COMMAND_EXEC_EXIT_REQ:
    !is_mcp_thread_ok
    command_exit_ok = call @rpc_post_contains(&auth_buf, auth_len, &RPC_COMMAND_EXEC_BODY, RPC_COMMAND_EXEC_BODY_LEN, &NEEDLE_EXIT_ZERO, NEEDLE_EXIT_ZERO_LEN)
    is_command_exit_ok = eq command_exit_ok, 1
    !command_exit_ok
    br is_command_exit_ok -> L_COMMAND_EXEC_STDOUT_REQ, L_FAIL_COMMAND_EXEC_EXIT

L_COMMAND_EXEC_STDOUT_REQ:
    !is_command_exit_ok
    command_stdout_ok = call @rpc_post_contains(&auth_buf, auth_len, &RPC_COMMAND_EXEC_BODY, RPC_COMMAND_EXEC_BODY_LEN, &NEEDLE_STDOUT_HI, NEEDLE_STDOUT_HI_LEN)
    is_command_stdout_ok = eq command_stdout_ok, 1
    !command_stdout_ok
    br is_command_stdout_ok -> L_COMMAND_EXEC_ID_REQ, L_FAIL_COMMAND_EXEC_STDOUT

L_COMMAND_EXEC_ID_REQ:
    !is_command_stdout_ok
    command_id_ok = call @rpc_post_contains(&auth_buf, auth_len, &RPC_COMMAND_EXEC_BODY, RPC_COMMAND_EXEC_BODY_LEN, &NEEDLE_ID_58, NEEDLE_ID_58_LEN)
    is_command_id_ok = eq command_id_ok, 1
    !command_id_ok
    br is_command_id_ok -> L_RPC_UNKNOWN_REQ, L_FAIL_COMMAND_EXEC_ID

L_RPC_UNKNOWN_REQ:
    !is_command_id_ok
    unknown_ok = call @rpc_post_contains(&auth_buf, auth_len, &RPC_FS_READ_EXTRA_BODY, RPC_FS_READ_EXTRA_BODY_LEN, &NEEDLE_METHOD_NOT_FOUND, NEEDLE_METHOD_NOT_FOUND_LEN)
    is_unknown_ok = eq unknown_ok, 1
    !unknown_ok
    br is_unknown_ok -> L_RPC_UNKNOWN_ID_REQ, L_FAIL_RPC_PREFIX_METHOD

L_RPC_UNKNOWN_ID_REQ:
    !is_unknown_ok
    unknown_id_ok = call @rpc_post_contains(&auth_buf, auth_len, &RPC_FS_READ_EXTRA_BODY, RPC_FS_READ_EXTRA_BODY_LEN, &NEEDLE_ID_35, NEEDLE_ID_35_LEN)
    is_unknown_id_ok = eq unknown_id_ok, 1
    !unknown_id_ok
    br is_unknown_id_ok -> L_PASS, L_FAIL_RPC_PREFIX_ID

L_PASS:
    !is_unknown_id_ok
    !auth_token_ptr
    !auth_token_len
    !auth_len
    !cfg
