    !len
    !has_len
    !data
    !has_handle
    return

@test "progress continuation allows Deno goal code and default contexts with exec"():
L_ENTRY:
    goal_allowed = call @body_allows_progress_continuation(&REQ_GOAL_EXEC, REQ_GOAL_EXEC_LEN)
    goal_ok = eq goal_allowed, 1
