@test "chat SSE fallback maps reasoning content thinking and split thought tags like Deno"():
L_ENTRY:
    out_ptr_slot = stack_alloc 8
    out_len_slot = stack_alloc 8
    status = call @sa_deno_plugin_chat_sse_to_responses(&CHAT_SSE_REASONING_THINKING_SPLIT, CHAT_SSE_REASONING_THINKING_SPLIT_LEN, &EMPTY_REQ, EMPTY_REQ_LEN, &out_ptr_slot, &out_len_slot)
    status_ok = eq status, 0
    call @assert_contract(status_ok, 521)
    data = load out_ptr_slot+0 as ptr
    len = load out_len_slot+0 as u64
    has_handle = ne data, 0
    call @assert_contract(has_handle, 522)
    has_len = ugt len, 0
    call @assert_contract(has_len, 523)

    delta_one_idx = call @sa_bytes_find(&data, len, &NEEDLE_SSE_DELTA_THINK_ONE, NEEDLE_SSE_DELTA_THINK_ONE_LEN)
    has_delta_one = sge delta_one_idx, 0
    call @assert_contract(has_delta_one, 524)

    delta_two_idx = call @sa_bytes_find(&data, len, &NEEDLE_SSE_DELTA_AND_TWO, NEEDLE_SSE_DELTA_AND_TWO_LEN)
    has_delta_two = sge delta_two_idx, 0
    call @assert_contract(has_delta_two, 525)

    split_thought_idx = call @sa_bytes_find(&data, len, &NEEDLE_SSE_SPLIT_THOUGHT, NEEDLE_SSE_SPLIT_THOUGHT_LEN)
    has_split_thought = sge split_thought_idx, 0
    call @assert_contract(has_split_thought, 526)

    answer_idx = call @sa_bytes_find(&data, len, &NEEDLE_SSE_DELTA_ANSWER, NEEDLE_SSE_DELTA_ANSWER_LEN)
    has_answer = sge answer_idx, 0
    call @assert_contract(has_answer, 527)

    reason_done_idx = call @sa_bytes_find(&data, len, &NEEDLE_REASON_DONE, NEEDLE_REASON_DONE_LEN)
    has_reason_done = sge reason_done_idx, 0
    call @assert_contract(has_reason_done, 528)

    msg_added_idx = call @sa_bytes_find(&data, len, &NEEDLE_MSG_ADDED, NEEDLE_MSG_ADDED_LEN)
    has_msg_added = sge msg_added_idx, 0
    call @assert_contract(has_msg_added, 529)

    msg_off = bitcast msg_added_idx as u64
    after_msg_ptr = ptr_add data, msg_off
    after_msg_len = sub len, msg_off
    reason_after_msg_idx = call @sa_bytes_find(&after_msg_ptr, after_msg_len, &NEEDLE_REASON_DONE, NEEDLE_REASON_DONE_LEN)
    no_reason_done_after_msg = slt reason_after_msg_idx, 0
    call @assert_contract(no_reason_done_after_msg, 530)

    free_status = call @sa_deno_plugin_free_buffer(data, len)
    free_ok = eq free_status, 0
    call @assert_contract(free_ok, 531)

    !free_status
    !free_ok
    !status
    !status_ok
    !reason_after_msg_idx
    !no_reason_done_after_msg
    !after_msg_len
    !after_msg_ptr
    !msg_off
    !msg_added_idx
    !has_msg_added
    !reason_done_idx
    !has_reason_done
    !answer_idx
    !has_answer
    !split_thought_idx
    !has_split_thought
    !delta_two_idx
    !has_delta_two
    !delta_one_idx
    !has_delta_one
    !len
    !has_len
    !data
    !has_handle
    return

