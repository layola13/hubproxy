@const SSE_PROGRESS_CN = utf8:"event: response.output_text.delta\ndata: {\"delta\":\"我先检查 MCP 状态\"}\n\n"
@const SSE_FINAL_SUMMARY = utf8:"event: response.output_text.delta\ndata: {\"delta\":\"summary: done\"}\n\n"
@const SSE_PROPOSED_PLAN = utf8:"event: response.output_text.delta\ndata: {\"delta\":\"<proposed_plan>check files</proposed_plan>\"}\n\n"
@const SSE_NORMAL_FINAL = utf8:"event: response.output_text.delta\ndata: {\"delta\":\"The request is complete\"}\n\n"
@const NEEDLE_CONT_EXEC = utf8:"\"name\":\"exec_command\""
@const NEEDLE_CONT_CALL = utf8:"\"call_id\":\"call_chat_continue\""
@const NEEDLE_RESPONSE_DONE = utf8:"event: response.done"
@const REQ_CTX_THREAD_KEY = utf8:"ctx-thread"
@const REQ_CTX_MODEL = utf8:"ctx-model"
@const REQ_CTX_CWD = utf8:"/tmp/ctx"
@const REQ_CTX_TURN_TWO = utf8:"2"
@const REQ_CTX_TURN_MISSING = utf8:"999"
@const REQ_CTX_THREAD_NUMERIC_ONE = utf8:"1"
@const REQ_CTX_GOAL_BODY = utf8:"{\"input\":[{\"role\":\"developer\",\"content\":[{\"text\":\"<goal_context>Continue working toward the active thread goal.</goal_context>\"}]}]}"
@const REQ_CTX_CODE_BODY = utf8:"{\"client_metadata\":{\"mode\":\"code\"},\"input\":[{\"role\":\"user\",\"content\":[{\"text\":\"hi\"}]}]}"
@const REQ_CTX_DEFAULT_BODY = utf8:"{\"input\":[{\"role\":\"developer\",\"content\":[{\"text\":\"<collaboration_mode># Plan Mode (Conversational)</collaboration_mode>\"}]},{\"role\":\"developer\",\"content\":[{\"text\":\"<collaboration_mode># Collaboration Mode: Default</collaboration_mode>\"}]}]}"
@const REQ_CTX_PLAN_BODY = utf8:"{\"instructions\":\"# Plan Mode (Conversational)\"}"

