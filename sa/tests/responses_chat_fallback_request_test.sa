@test "progress continuation builder emits exec tool call and response done"():
L_ENTRY:
    out_len_slot = stack_alloc 8
    out = call @build_native_progress_continuation(&out_len_slot)
    out_len = load out_len_slot+0 as u64
    has_out = ne out, 0
    call @assert_contract(has_out, 520)
    has_len = ugt out_len, 0
    call @assert_contract(has_len, 521)

    exec_idx = call @sa_bytes_find(&out, out_len, &NEEDLE_CONT_EXEC, NEEDLE_CONT_EXEC_LEN)
    has_exec = sge exec_idx, 0
    call @assert_contract(has_exec, 522)

    call_idx = call @sa_bytes_find(&out, out_len, &NEEDLE_CONT_CALL, NEEDLE_CONT_CALL_LEN)
    has_call = sge call_idx, 0
    call @assert_contract(has_call, 523)

    done_idx = call @sa_bytes_find(&out, out_len, &NEEDLE_RESPONSE_DONE, NEEDLE_RESPONSE_DONE_LEN)
    has_done = sge done_idx, 0
    call @assert_contract(has_done, 524)

    !done_idx
    !has_done
    !call_idx
    !has_call
    !exec_idx
    !has_exec
    !out_len
    !has_len
    !out
    !has_out
    return

@test "request context uses current turn mode from string thread id like Deno"():
L_ENTRY:
    state = stack_alloc STATE_MEM_SIZE
    init_status = call @state_init(&state)
    init_ok = eq init_status, 0
    call @assert_contract(init_ok, 525)

    thread_id = call @state_thread_create_with_key(&state, &REQ_CTX_THREAD_KEY, REQ_CTX_THREAD_KEY_LEN, &REQ_CTX_MODEL, REQ_CTX_MODEL_LEN, &REQ_CTX_CWD, REQ_CTX_CWD_LEN)
    thread_ok = ugt thread_id, 0
    call @assert_contract(thread_ok, 526)

    turn_id = call @state_turn_create(&state, thread_id)
    turn_ok = eq turn_id, 2
    call @assert_contract(turn_ok, 527)

    set_status = call @state_turn_set_mode(&state, thread_id, turn_id, 2)
    set_ok = eq set_status, 0
    call @assert_contract(set_ok, 528)

    mode = call @response_request_context_mode_from_ids(&state, &REQ_CTX_THREAD_KEY, REQ_CTX_THREAD_KEY_LEN, &REQ_CTX_TURN_TWO, REQ_CTX_TURN_TWO_LEN, &REQ_CTX_PLAN_BODY, REQ_CTX_PLAN_BODY_LEN)
    state_goal_wins = eq mode, 2
    call @assert_contract(state_goal_wins, 529)

    !mode
    !state_goal_wins
    !set_status
    !set_ok
    !turn_id
    !turn_ok
    !thread_id
    !thread_ok
    !init_status
    !init_ok
    return

@test "request context ignores stale turn id and falls back to body mode"():
L_ENTRY:
    state = stack_alloc STATE_MEM_SIZE
    init_status = call @state_init(&state)
    init_ok = eq init_status, 0
    call @assert_contract(init_ok, 530)

    thread_id = call @state_thread_create_with_key(&state, &REQ_CTX_THREAD_KEY, REQ_CTX_THREAD_KEY_LEN, &REQ_CTX_MODEL, REQ_CTX_MODEL_LEN, &REQ_CTX_CWD, REQ_CTX_CWD_LEN)
    thread_ok = ugt thread_id, 0
    call @assert_contract(thread_ok, 531)

    turn_id = call @state_turn_create(&state, thread_id)
    turn_ok = eq turn_id, 2
    call @assert_contract(turn_ok, 532)

    set_status = call @state_turn_set_mode(&state, thread_id, turn_id, 1)
    set_ok = eq set_status, 0
    call @assert_contract(set_ok, 533)

    stale_mode = call @response_request_context_mode_from_ids(&state, &REQ_CTX_THREAD_KEY, REQ_CTX_THREAD_KEY_LEN, &REQ_CTX_TURN_MISSING, REQ_CTX_TURN_MISSING_LEN, &REQ_CTX_GOAL_BODY, REQ_CTX_GOAL_BODY_LEN)
    stale_falls_back_goal = eq stale_mode, 2
