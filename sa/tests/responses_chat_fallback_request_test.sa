    code_allowed = call @body_allows_progress_continuation(&REQ_CODE_EXEC, REQ_CODE_EXEC_LEN)
    code_ok = eq code_allowed, 1
    call @assert_contract(code_ok, 511)

    default_allowed = call @body_allows_progress_continuation(&REQ_DEFAULT_EXEC, REQ_DEFAULT_EXEC_LEN)
    default_ok = eq default_allowed, 1
    call @assert_contract(default_ok, 512)

    !default_allowed
    !default_ok
    !code_allowed
    !code_ok
    !goal_allowed
    !goal_ok
    return

@test "progress continuation rejects plan context and missing exec tool"():
