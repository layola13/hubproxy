    !input_idx
    !no_input
    !store_idx
    !no_store
    !text_idx
    !no_text
    !content_idx
    !no_content
    !user_idx
    !has_user
    !system_idx
    !has_system
    !model_idx
    !has_model
    !len
    !has_len
    !data
    !has_handle
    return

@test "chat fallback SSE keeps message active across multiple deltas"():
L_ENTRY:
    out_ptr_slot = stack_alloc 8
    out_len_slot = stack_alloc 8
    status = call @sa_deno_plugin_chat_sse_to_responses(&CHAT_SSE_MULTI_VISIBLE, CHAT_SSE_MULTI_VISIBLE_LEN, &EMPTY_REQ, EMPTY_REQ_LEN, &out_ptr_slot, &out_len_slot)
    status_ok = eq status, 0
    call @assert_contract(status_ok, 409)
    data = load out_ptr_slot+0 as ptr
    len = load out_len_slot+0 as u64
    has_handle = ne data, 0
    call @assert_contract(has_handle, 410)
    has_len = ugt len, 0
    call @assert_contract(has_len, 411)

    reason_done_idx = call @sa_bytes_find(&data, len, &NEEDLE_REASON_DONE, NEEDLE_REASON_DONE_LEN)
    has_reason_done = sge reason_done_idx, 0
    call @assert_contract(has_reason_done, 412)

    msg_added_idx = call @sa_bytes_find(&data, len, &NEEDLE_MSG_ADDED, NEEDLE_MSG_ADDED_LEN)
    has_msg_added = sge msg_added_idx, 0
    call @assert_contract(has_msg_added, 413)

    hello_idx = call @sa_bytes_find(&data, len, &NEEDLE_DELTA_HELLO, NEEDLE_DELTA_HELLO_LEN)
    has_hello = sge hello_idx, 0
    call @assert_contract(has_hello, 414)

    world_idx = call @sa_bytes_find(&data, len, &NEEDLE_DELTA_WORLD, NEEDLE_DELTA_WORLD_LEN)
    has_world = sge world_idx, 0
    call @assert_contract(has_world, 415)

    item_id_idx = call @sa_bytes_find(&data, len, &NEEDLE_ITEM_ID, NEEDLE_ITEM_ID_LEN)
    has_item_id = sge item_id_idx, 0
    call @assert_contract(has_item_id, 416)

    content_idx = call @sa_bytes_find(&data, len, &NEEDLE_CONTENT_INDEX, NEEDLE_CONTENT_INDEX_LEN)
    has_content_idx = sge content_idx, 0
    call @assert_contract(has_content_idx, 417)

    msg_off = bitcast msg_added_idx as u64
    after_msg_ptr = ptr_add data, msg_off
    after_msg_len = sub len, msg_off
    reason_after_msg_idx = call @sa_bytes_find(&after_msg_ptr, after_msg_len, &NEEDLE_REASON_DONE, NEEDLE_REASON_DONE_LEN)
    no_reason_done_after_msg = slt reason_after_msg_idx, 0
    call @assert_contract(no_reason_done_after_msg, 418)

    free_status = call @sa_deno_plugin_free_buffer(data, len)
    free_ok = eq free_status, 0
    call @assert_contract(free_ok, 419)

    !free_status
    !free_ok
    !status
    !status_ok
    !reason_after_msg_idx
    !no_reason_done_after_msg
    !after_msg_len
    !after_msg_ptr
    !msg_off
    !content_idx
    !has_content_idx
    !item_id_idx
    !has_item_id
    !world_idx
    !has_world
    !hello_idx
    !has_hello
    !msg_added_idx
    !has_msg_added
    !reason_done_idx
    !has_reason_done
    !len
    !has_len
    !data
    !has_handle
    return

@test "chat fallback SSE normalizes read and exec tool calls like Deno"():
L_ENTRY:
    out_ptr_slot = stack_alloc 8
    out_len_slot = stack_alloc 8
    status = call @sa_deno_plugin_chat_sse_to_responses(&CHAT_SSE_TOOL_CALLS, CHAT_SSE_TOOL_CALLS_LEN, &REQ_CODE_EXEC, REQ_CODE_EXEC_LEN, &out_ptr_slot, &out_len_slot)
    status_ok = eq status, 0
    call @assert_contract(status_ok, 480)
    data = load out_ptr_slot+0 as ptr
    len = load out_len_slot+0 as u64
    has_handle = ne data, 0
    call @assert_contract(has_handle, 481)
    has_len = ugt len, 0
    call @assert_contract(has_len, 482)

    raw_read_idx = call @sa_bytes_find(&data, len, &NEEDLE_READ_RAW, NEEDLE_READ_RAW_LEN)
    no_raw_read = slt raw_read_idx, 0
    call @assert_contract(no_raw_read, 483)

    call_read_idx = call @sa_bytes_find(&data, len, &NEEDLE_CALL_READ, NEEDLE_CALL_READ_LEN)
    has_call_read = sge call_read_idx, 0
    call @assert_contract(has_call_read, 484)

    call_cmd_idx = call @sa_bytes_find(&data, len, &NEEDLE_CALL_CMD, NEEDLE_CALL_CMD_LEN)
    has_call_cmd = sge call_cmd_idx, 0
    call @assert_contract(has_call_cmd, 485)

    cat_idx = call @sa_bytes_find(&data, len, &NEEDLE_READ_CAT_CMD, NEEDLE_READ_CAT_CMD_LEN)
    has_cat = sge cat_idx, 0
    call @assert_contract(has_cat, 486)

    deno_idx = call @sa_bytes_find(&data, len, &NEEDLE_DENO_CHECK_CMD, NEEDLE_DENO_CHECK_CMD_LEN)
    has_deno = sge deno_idx, 0
    call @assert_contract(has_deno, 487)

    free_status = call @sa_deno_plugin_free_buffer(data, len)
    free_ok = eq free_status, 0
    call @assert_contract(free_ok, 488)

    !free_status
    !free_ok
    !status
    !status_ok
    !deno_idx
    !has_deno
    !cat_idx
    !has_cat
    !call_cmd_idx
    !has_call_cmd
    !call_read_idx
    !has_call_read
    !raw_read_idx
    !no_raw_read
    !len
    !has_len
    !data
    !has_handle
    return

@test "chat fallback SSE redacts env read commands like Deno shell contract"():
L_ENTRY:
    out_ptr_slot = stack_alloc 8
    out_len_slot = stack_alloc 8
    status = call @sa_deno_plugin_chat_sse_to_responses(&CHAT_SSE_READ_ENV, CHAT_SSE_READ_ENV_LEN, &REQ_CODE_EXEC, REQ_CODE_EXEC_LEN, &out_ptr_slot, &out_len_slot)
    status_ok = eq status, 0
    call @assert_contract(status_ok, 489)
    data = load out_ptr_slot+0 as ptr
    len = load out_len_slot+0 as u64
    has_handle = ne data, 0
    call @assert_contract(has_handle, 490)
    has_len = ugt len, 0
    call @assert_contract(has_len, 491)

    raw_read_idx = call @sa_bytes_find(&data, len, &NEEDLE_READ_RAW, NEEDLE_READ_RAW_LEN)
