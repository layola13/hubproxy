// SA native @test coverage for Deno-compatible thread RPC contracts.
@import "../src/hub_modules.sa"

@const THREAD_ROLLBACK_NUMERIC_BODY = utf8:"{\"params\":{\"numTurns\":2}}"
@const THREAD_ROLLBACK_STRING_BODY = utf8:"{\"params\":{\"numTurns\":\"2\"}}"
@const THREAD_ROLLBACK_MISSING_BODY = utf8:"{\"params\":{}}"
@const THREAD_ROLLBACK_KEY = utf8:"rollback-thread"
