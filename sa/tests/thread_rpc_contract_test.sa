@const THREAD_INJECT_COUNT_NEEDLE = utf8:"\"injectedCount\":1"
@const THREAD_INJECT_STARTED_EVENT = utf8:"event: item/started"
@const THREAD_INJECT_RAW_EVENT = utf8:"event: rawResponseItem/completed"
@const THREAD_INJECT_COMPLETED_EVENT = utf8:"event: item/completed"
@const THREAD_INJECT_TURN_NEEDLE = utf8:"\"turnId\":\"2\""
@const THREAD_INJECT_CONTENT_NEEDLE = utf8:"\"content\":\"injected\""

