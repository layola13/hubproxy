@const THREAD_NAME = utf8:"fork thread"
@const THREAD_GIT_INFO = utf8:"{\"branch\":\"main\",\"commit\":\"abc123\"}"
@const THREAD_FORK_PARENT_NEEDLE = utf8:"\"forkedFromId\":\"fork-source\""
@const THREAD_ID_NEEDLE = utf8:"\"id\":\"fork-child\""
@const THREAD_SESSION_ID_NEEDLE = utf8:"\"sessionId\":\"fork-child\""
