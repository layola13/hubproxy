    !thread_ok
    !init_status
    !init_ok
    !state
    return

@test "thread object writer preserves fork parent git info name and provider"():
L_ENTRY:
    state = alloc ST_TOTAL
    init_status = call @state_init(&state)
    init_ok = eq init_status, 0
    call @assert_contract(init_ok, 855)

    source_tid = call @state_thread_create_with_key(&state, &THREAD_FORK_SOURCE_KEY, THREAD_FORK_SOURCE_KEY_LEN, &THREAD_MODEL, THREAD_MODEL_LEN, &THREAD_CWD, THREAD_CWD_LEN)
    source_ok = ugt source_tid, 0
    call @assert_contract(source_ok, 856)
    child_tid = call @state_thread_create_with_key(&state, &THREAD_FORK_CHILD_KEY, THREAD_FORK_CHILD_KEY_LEN, &THREAD_MODEL, THREAD_MODEL_LEN, &THREAD_CWD, THREAD_CWD_LEN)
    child_ok = ugt child_tid, 0
    call @assert_contract(child_ok, 857)

    source_git_status = call @state_thread_set_git_info(&state, source_tid, &THREAD_GIT_INFO, THREAD_GIT_INFO_LEN)
    source_git_ok = eq source_git_status, 0
    call @assert_contract(source_git_ok, 858)
    copy_git_status = call @state_thread_copy_git_info(&state, source_tid, child_tid)
    copy_git_ok = eq copy_git_status, 0
    call @assert_contract(copy_git_ok, 859)
    provider_status = call @state_thread_set_model_provider(&state, child_tid, &THREAD_PROVIDER, THREAD_PROVIDER_LEN)
    provider_ok = eq provider_status, 0
    call @assert_contract(provider_ok, 860)
    preview_status = call @state_thread_set_preview(&state, child_tid, &THREAD_PREVIEW, THREAD_PREVIEW_LEN)
    preview_ok = eq preview_status, 0
    call @assert_contract(preview_ok, 861)
    name_status = call @state_thread_set_name(&state, child_tid, &THREAD_NAME, THREAD_NAME_LEN)
    name_ok = eq name_status, 0
    call @assert_contract(name_ok, 862)
    ephemeral_status = call @state_thread_set_ephemeral(&state, child_tid, 1)
    ephemeral_ok = eq ephemeral_status, 0
    call @assert_contract(ephemeral_ok, 863)

    child_slot = call @state_thread_find(&state, child_tid)
    has_child_slot = ne child_slot, 0
    call @assert_contract(has_child_slot, 864)
    store child_slot+THR_FORKED_FROM_ID, source_tid as u64
    child_name_ptr = ptr_add child_slot, THR_NAME
    child_name_len = load child_slot+THR_NAME_LEN as u64
    child_name_set = load child_slot+THR_NAME_SET as u8

    buffer_slot = stack_alloc 8
    EXPAND JSON_WRITER_NEW_MINIFIED writer_status, writer
    write_status = call @json_writer_write_thread_object(writer, &state, child_tid, source_tid, &THREAD_PREVIEW, THREAD_PREVIEW_LEN, &THREAD_PROVIDER, THREAD_PROVIDER_LEN, 1, &THREAD_MODEL, THREAD_MODEL_LEN, &THREAD_CWD, THREAD_CWD_LEN, &child_name_ptr, child_name_len, child_name_set, 1)
    finish_ptr_slot = stack_alloc 8
    finish_len_slot = stack_alloc 8
    finish_status = call @json_writer_finish_view(writer, &buffer_slot, &finish_ptr_slot, &finish_len_slot)
    buffer = load buffer_slot+0 as ptr
    data = load finish_ptr_slot+0 as ptr
    len = load finish_len_slot+0 as u64
    has_data = ne data, 0
    call @assert_contract(has_data, 865)
    has_len = ugt len, 0
    call @assert_contract(has_len, 866)

    parent_idx = call @sa_bytes_find(&data, len, &THREAD_FORK_PARENT_NEEDLE, THREAD_FORK_PARENT_NEEDLE_LEN)
    has_parent = sge parent_idx, 0
    call @assert_contract(has_parent, 867)
    id_idx = call @sa_bytes_find(&data, len, &THREAD_ID_NEEDLE, THREAD_ID_NEEDLE_LEN)
    has_id = sge id_idx, 0
    call @assert_contract(has_id, 875)
    session_id_idx = call @sa_bytes_find(&data, len, &THREAD_SESSION_ID_NEEDLE, THREAD_SESSION_ID_NEEDLE_LEN)
    has_session_id = sge session_id_idx, 0
    call @assert_contract(has_session_id, 876)
    name_idx = call @sa_bytes_find(&data, len, &THREAD_NAME_NEEDLE, THREAD_NAME_NEEDLE_LEN)
    has_name = sge name_idx, 0
    call @assert_contract(has_name, 868)
    branch_idx = call @sa_bytes_find(&data, len, &THREAD_GIT_BRANCH_NEEDLE, THREAD_GIT_BRANCH_NEEDLE_LEN)
    has_branch = sge branch_idx, 0
    call @assert_contract(has_branch, 869)
    commit_idx = call @sa_bytes_find(&data, len, &THREAD_GIT_COMMIT_NEEDLE, THREAD_GIT_COMMIT_NEEDLE_LEN)
    has_commit = sge commit_idx, 0
    call @assert_contract(has_commit, 870)
    ephemeral_idx = call @sa_bytes_find(&data, len, &THREAD_EPHEMERAL_NEEDLE, THREAD_EPHEMERAL_NEEDLE_LEN)
    has_ephemeral = sge ephemeral_idx, 0
    call @assert_contract(has_ephemeral, 871)
    provider_idx = call @sa_bytes_find(&data, len, &THREAD_PROVIDER_NEEDLE, THREAD_PROVIDER_NEEDLE_LEN)
    has_provider = sge provider_idx, 0
    call @assert_contract(has_provider, 872)
    turns_idx = call @sa_bytes_find(&data, len, &THREAD_TURNS_EMPTY_NEEDLE, THREAD_TURNS_EMPTY_NEEDLE_LEN)
    has_turns = sge turns_idx, 0
    call @assert_contract(has_turns, 873)

    dispose_status = call @json_writer_dispose_finished(buffer, writer)
    dispose_ok = eq dispose_status, 0
    call @assert_contract(dispose_ok, 874)

    !dispose_status
    !dispose_ok
    !turns_idx
    !has_turns
    !session_id_idx
    !has_session_id
    !id_idx
    !has_id
    !provider_idx
    !has_provider
    !ephemeral_idx
    !has_ephemeral
    !commit_idx
    !has_commit
    !branch_idx
    !has_branch
    !name_idx
    !has_name
    !parent_idx
    !has_parent
    !buffer
    !finish_status
    !write_status
    !writer_status
    !child_name_ptr
    !child_name_len
    !child_name_set
    !child_slot
    !has_child_slot
    !ephemeral_status
    !ephemeral_ok
    !name_status
    !name_ok
    !preview_status
    !preview_ok
    !provider_status
    !provider_ok
    !copy_git_status
    !copy_git_ok
    !source_git_status
    !source_git_ok
    !child_tid
    !child_ok
    !source_tid
    !source_ok
    !init_status
    !init_ok
    !state
    return

@test "memory reset clears runtime state and emits wildcard thread closed"():
L_ENTRY:
    state = alloc ST_TOTAL
    init_status = call @state_init(&state)
    init_ok = eq init_status, 0
    call @assert_contract(init_ok, 850)

    thread_id = call @state_thread_create_with_key(&state, &THREAD_ROLLBACK_KEY, THREAD_ROLLBACK_KEY_LEN, &THREAD_MODEL, THREAD_MODEL_LEN, &THREAD_CWD, THREAD_CWD_LEN)
    thread_ok = ugt thread_id, 0
    call @assert_contract(thread_ok, 851)
    turn_id = call @state_turn_create(&state, thread_id)
    turn_ok = ugt turn_id, 0
    call @assert_contract(turn_ok, 852)
    goal_status = call @state_goal_set(&state, thread_id, &THREAD_ROLLBACK_KEY, THREAD_ROLLBACK_KEY_LEN, 0, &THREAD_RESET_OBJECTIVE, 0, 1, -1, &THREAD_RESET_OBJECTIVE, THREAD_RESET_OBJECTIVE_LEN)
    goal_ok = eq goal_status, 0
    call @assert_contract(goal_ok, 853)
    proc_status = call @state_process_put(&state, &THREAD_RESET_PROC, THREAD_RESET_PROC_LEN)
    proc_ok = eq proc_status, 0
    call @assert_contract(proc_ok, 854)
    watch_status = call @state_watch_put(&state, &THREAD_RESET_WATCH, THREAD_RESET_WATCH_LEN)
    watch_ok = eq watch_status, 0
    call @assert_contract(watch_ok, 855)

    reset_status = call @state_reset_runtime(&state)
    reset_ok = eq reset_status, 0
    call @assert_contract(reset_ok, 856)
    closed_notify = call @notify_thread_id_string(&state, &RPC_SESSION_EV_THREAD_CLOSED, RPC_SESSION_EV_THREAD_CLOSED_LEN, &RPC_SESSION_J_THREAD_ID_ALL, RPC_SESSION_J_THREAD_ID_ALL_LEN)
    closed_ok = eq closed_notify, 0
    call @assert_contract(closed_ok, 857)

    reset_thread = call @state_thread_find(&state, thread_id)
    thread_cleared = eq reset_thread, 0
    call @assert_contract(thread_cleared, 858)
    reset_turn = call @state_turn_find(&state, thread_id, turn_id)
    turn_cleared = eq reset_turn, 0
    call @assert_contract(turn_cleared, 859)
    budget_slot = stack_alloc 8
    used_slot = stack_alloc 8
    reset_goal = call @state_goal_get(&state, thread_id, &budget_slot, &used_slot)
    goal_cleared = ne reset_goal, 0
    call @assert_contract(goal_cleared, 860)
    proc_deleted = call @state_process_delete(&state, &THREAD_RESET_PROC, THREAD_RESET_PROC_LEN)
    proc_cleared = eq proc_deleted, 0
    call @assert_contract(proc_cleared, 861)
    watch_deleted = call @state_watch_delete(&state, &THREAD_RESET_WATCH, THREAD_RESET_WATCH_LEN)
    watch_cleared = eq watch_deleted, 0
    call @assert_contract(watch_cleared, 862)

    cursor_slot = stack_alloc 8
    store cursor_slot+0, 0 as u64
    out_frame = stack_alloc 512
    out_len_slot = stack_alloc 8
    read_status = call @state_notify_read(&state, &cursor_slot, &out_frame, 512, &out_len_slot)
    read_ok = eq read_status, 1
    call @assert_contract(read_ok, 863)
    out_len = load out_len_slot+0 as u64
    event_pos = call @sa_bytes_find(&out_frame, out_len, &THREAD_CLOSED_NEEDLE, THREAD_CLOSED_NEEDLE_LEN)
    has_event = sge event_pos, 0
    call @assert_contract(has_event, 864)
    thread_pos = call @sa_bytes_find(&out_frame, out_len, &THREAD_ID_STAR_NEEDLE, THREAD_ID_STAR_NEEDLE_LEN)
    has_thread_star = sge thread_pos, 0
    call @assert_contract(has_thread_star, 865)

    !has_thread_star
    !thread_pos
    !has_event
    !event_pos
    !out_len
    !read_status
    !read_ok
    !watch_deleted
    !watch_cleared
    !proc_deleted
    !proc_cleared
    !reset_goal
    !goal_cleared
    !reset_turn
    !turn_cleared
    !reset_thread
    !thread_cleared
    !closed_notify
    !closed_ok
    !reset_status
    !reset_ok
    !watch_status
    !watch_ok
    !proc_status
    !proc_ok
    !goal_status
    !goal_ok
    !turn_id
    !turn_ok
    !thread_id
    !thread_ok
    !init_status
    !init_ok
    !state
    return
