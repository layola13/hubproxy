@const THREAD_CWD = utf8:"/tmp"
@const THREAD_RESET_OBJECTIVE = utf8:"reset objective"
@const THREAD_RESET_PROC = utf8:"reset-proc"
@const THREAD_RESET_WATCH = utf8:"reset-watch"
@const THREAD_CLOSED_NEEDLE = utf8:"thread/closed"
@const THREAD_ID_STAR_NEEDLE = utf8:"\"threadId\":\"*\""
