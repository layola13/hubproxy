@const THREAD_RESUME_MODE = utf8:"goal"
@const THREAD_INJECT_KEY = utf8:"inject-thread"
@const THREAD_INJECT_BODY = utf8:"{\"params\":{\"threadId\":\"inject-thread\",\"items\":[{\"type\":\"message\",\"role\":\"user\",\"content\":\"injected\"}]}}"
@const THREAD_INJECT_ITEMS = utf8:"[{\"type\":\"message\",\"role\":\"user\",\"content\":\"injected\"}]"
