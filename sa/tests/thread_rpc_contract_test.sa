@const THREAD_STARTED_ID_NEEDLE = utf8:"\"thread\":{\"id\":\"archive-thread\""
@const THREAD_STARTED_SESSION_NEEDLE = utf8:"\"sessionId\":\"archive-thread\""
@const THREAD_STATUS_EVENT_NEEDLE = utf8:"event: thread/status/changed"
@const THREAD_ARCHIVED_EVENT_NEEDLE = utf8:"event: thread/archived"
@const THREAD_UNARCHIVED_EVENT_NEEDLE = utf8:"event: thread/unarchived"
@const THREAD_CLOSED_EVENT_NEEDLE = utf8:"event: thread/closed"
@const THREAD_NAME_UPDATED_EVENT_NEEDLE = utf8:"event: thread/name/updated"
@const THREAD_GOAL_CLEARED_EVENT_NEEDLE = utf8:"event: thread/goal/cleared"
@const THREAD_ARCHIVE_THREAD_NEEDLE = utf8:"\"threadId\":\"archive-thread\""
@const THREAD_STATUS_IDLE_NEEDLE = utf8:"\"status\":{\"type\":\"idle\"}"
@const THREAD_NAME_NULL_NEEDLE = utf8:"\"name\":null"
@const THREAD_MODEL_NEEDLE = utf8:"\"model\":\"model\""
@const THREAD_CWD_NEEDLE = utf8:"\"cwd\":\"/tmp\""
@const THREAD_RESUME_MODEL_NEEDLE = utf8:"\"model\":\"resume-model\""
@const THREAD_RESUME_PROVIDER_NEEDLE = utf8:"\"modelProvider\":\"anthropic\""
@const THREAD_RESUME_CWD_NEEDLE = utf8:"\"cwd\":\"/tmp/resume-cwd\""
@const THREAD_RESUME_SERVICE_NEEDLE = utf8:"\"serviceTier\":null"
@const THREAD_RESUME_INSTRUCTIONS_NEEDLE = utf8:"\"instructionSources\":[]"
@const THREAD_RESUME_APPROVAL_NEEDLE = utf8:"\"approvalPolicy\":\"never\""
@const THREAD_RESUME_REVIEWER_NEEDLE = utf8:"\"approvalsReviewer\":\"user\""
@const THREAD_RESUME_SANDBOX_NEEDLE = utf8:"\"sandbox\":\"danger-full-access\""
@const THREAD_RESUME_THREAD_ID_NEEDLE = utf8:"\"thread\":{\"id\":\"resume-thread\""
@const THREAD_RESUME_SESSION_ID_NEEDLE = utf8:"\"sessionId\":\"resume-thread\""
@const THREAD_RESUME_TURNS_NEEDLE = utf8:"\"turns\":[{\"id\":\"2\""
