// test_server_config.sa — start HTTP server using SA_PORT loaded from .env
@import "../src/config.sa"
@import "../src/strings.sa"
@import "../sa_http_server.sai"

@const ENV_PATH = utf8:"../.env"

@main() -> i32!:
L_ENTRY:
    cfg = alloc CFG_SIZE
    cfg_status = call @cfg_load(&ENV_PATH, 7, &cfg)
    cfg_ok = eq cfg_status, 0
    !cfg_status
    br cfg_ok -> L_START, L_FAIL_CFG

L_START:
    !cfg_ok
    port = call @cfg_get_port(&cfg)
    port_ok = eq port, 28080
    br port_ok -> L_START_SERVER, L_FAIL_PORT

L_START_SERVER:
    !port_ok
    host_ptr_slot = stack_alloc 8
    host_len_slot = stack_alloc 8
    call @cfg_get_host(&cfg, &host_ptr_slot, &host_len_slot)
    host_ptr = load host_ptr_slot+0 as ptr
    host_len = load host_len_slot+0 as u64
    server_slot = stack_alloc 8
    new_status = call @sa_http_server_new(&server_slot)
    server = load server_slot+0 as ptr
    start_status = call @sa_http_server_start(server, &host_ptr, host_len, port)
    start_ok = eq start_status, 0
    call @sa_http_server_free(^server)
    !new_status
    !start_status
    !host_ptr
    !host_len
    !port
    !cfg
    br start_ok -> L_PASS, L_FAIL_START

L_PASS:
    !start_ok
    return 0

L_FAIL_CFG:
    !cfg_ok
    !cfg
    panic(211)

L_FAIL_START:
    !start_ok
    panic(212)

L_FAIL_PORT:
    !port_ok
    !port
    !cfg
    panic(213)
