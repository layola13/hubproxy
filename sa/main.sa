@ffi_wrapper send_rpc_experimental_enablement_set(&req: ptr, &id_ptr: ptr, id_len: u64, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    root = call @sa_json_parse(&body, body_len)
    has_root = ne root, 0
    br has_root -> L_EXP_ENABLE_ROOT, L_EXP_ENABLE_DEFAULT_NO_ROOT

L_EXP_ENABLE_ROOT:
    !has_root
    params_slot = stack_alloc 8
    params_status = call @sa_json_object_get(root, &FB_KEY_PARAMS, FB_KEY_PARAMS_LEN, &params_slot)
    params_ok = eq params_status, 0
    br params_ok -> L_EXP_ENABLE_PARAMS, L_EXP_ENABLE_NO_PARAMS

L_EXP_ENABLE_PARAMS:
    !params_ok
    params_node = load params_slot+0 as ptr
    enable_slot = stack_alloc 8
    enable_status = call @sa_json_object_get(params_node, &FB_KEY_ENABLEMENT, FB_KEY_ENABLEMENT_LEN, &enable_slot)
    enable_ok = eq enable_status, 0
    br enable_ok -> L_EXP_ENABLE_VALUE, L_EXP_ENABLE_NO_VALUE

L_EXP_ENABLE_VALUE:
    !enable_ok
    enable_node = load enable_slot+0 as ptr
    enable_kind = call @sa_json_kind(enable_node)
    enable_is_null = eq enable_kind, SA_JSON_KIND_NULL
    !enable_kind
    br enable_is_null -> L_EXP_ENABLE_NULL, L_EXP_ENABLE_RAW

L_EXP_ENABLE_RAW:
    !enable_is_null
    result = call @rpc_builder_new()
    call @rpc_builder_append(&result, &J_EXPERIMENTAL_ENABLEMENT_A, J_EXPERIMENTAL_ENABLEMENT_A_LEN)
    raw_status = call @append_json_node_raw(&result, enable_node)
    !raw_status
    call @rpc_builder_append(&result, &J_EXPERIMENTAL_ENABLEMENT_B, J_EXPERIMENTAL_ENABLEMENT_B_LEN)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result)
    enable_free = call @sa_json_free(^enable_node)
    !enable_free
    params_free = call @sa_json_free(^params_node)
    !params_free
    root_free = call @sa_json_free(^root)
    !root_free
    !enable_status
    !params_status
    !body
    !body_len
    !req
    return 0

L_EXP_ENABLE_NULL:
    !enable_is_null
    enable_free_null = call @sa_json_free(^enable_node)
    !enable_free_null
    params_free_null = call @sa_json_free(^params_node)
    !params_free_null
    root_free_null = call @sa_json_free(^root)
    !root_free_null
    call @send_wrapped_const_with_id(&req, &id_ptr, id_len, &J_EXPERIMENTAL_ENABLEMENT_RESULT, J_EXPERIMENTAL_ENABLEMENT_RESULT_LEN)
    !enable_status
    !params_status
    !body
    !body_len
    !req
    return 0

L_EXP_ENABLE_NO_VALUE:
    !enable_ok
    params_free_no_value = call @sa_json_free(^params_node)
    !params_free_no_value
    root_free_no_value = call @sa_json_free(^root)
    !root_free_no_value
    call @send_wrapped_const_with_id(&req, &id_ptr, id_len, &J_EXPERIMENTAL_ENABLEMENT_RESULT, J_EXPERIMENTAL_ENABLEMENT_RESULT_LEN)
    !enable_status
    !params_status
    !body
    !body_len
    !req
    return 0

L_EXP_ENABLE_NO_PARAMS:
    !params_ok
    root_free_no_params = call @sa_json_free(^root)
    !root_free_no_params
    call @send_wrapped_const_with_id(&req, &id_ptr, id_len, &J_EXPERIMENTAL_ENABLEMENT_RESULT, J_EXPERIMENTAL_ENABLEMENT_RESULT_LEN)
    !params_status
    !body
    !body_len
    !req
    return 0

L_EXP_ENABLE_DEFAULT_NO_ROOT:
    !has_root
    call @send_wrapped_const_with_id(&req, &id_ptr, id_len, &J_EXPERIMENTAL_ENABLEMENT_RESULT, J_EXPERIMENTAL_ENABLEMENT_RESULT_LEN)
    !body
    !body_len
    !req
    return 0

@ffi_wrapper send_rpc_realtime_start(&req: ptr, &id_ptr: ptr, id_len: u64) -> u32:
L_ENTRY:
    now_i = call @sa_time_unix_s()
    now = bitcast now_i as u64
    uuid_buf = call @sa_deno_random_uuid()
    uuid_ptr = call @sa_fmt_buffer_data(uuid_buf)
    uuid_len = call @sa_fmt_buffer_len(uuid_buf)
    result = call @rpc_builder_new()
    call @rpc_builder_append(&result, &J_REALTIME_START_A, J_REALTIME_START_A_LEN)
    call @rpc_builder_append(&result, &uuid_ptr, uuid_len)
    call @rpc_builder_append(&result, &J_REALTIME_START_A2, J_REALTIME_START_A2_LEN)
    call @rpc_builder_append_u64(&result, now)
    call @rpc_builder_append(&result, &J_REALTIME_START_B, J_REALTIME_START_B_LEN)
    call @rpc_builder_append_u64(&result, now)
    call @rpc_builder_append(&result, &J_REALTIME_START_C, J_REALTIME_START_C_LEN)
    call @rpc_builder_append_u64(&result, now)
    call @rpc_builder_append(&result, &J_REALTIME_START_D, J_REALTIME_START_D_LEN)
    call @rpc_builder_append_u64(&result, now)
    call @rpc_builder_append(&result, &J_REALTIME_START_E, J_REALTIME_START_E_LEN)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result)
    uuid_free_status = call @sa_fmt_buffer_free(^uuid_buf)
    !uuid_free_status
    !uuid_ptr
    !uuid_len
    !now_i
    !now
    !req
    return 0

@ffi_wrapper send_rpc_realtime_thread(&req: ptr, &id_ptr: ptr, id_len: u64, &body: ptr, body_len: u64, &prefix: ptr, prefix_len: u64, &suffix: ptr, suffix_len: u64) -> u32:
L_ENTRY:
    result = call @rpc_builder_new()
    call @rpc_builder_append(&result, &prefix, prefix_len)
    call @rpc_builder_append_param_string_or_default(&result, &body, body_len, &J_THREADID_KEY, J_THREADID_KEY_LEN, &EMPTY_TEXT, EMPTY_TEXT_LEN)
    call @rpc_builder_append(&result, &suffix, suffix_len)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result)
    !body
    !body_len
    !prefix
    !prefix_len
    !suffix
    !suffix_len
    !req
    return 0

@ffi_wrapper send_rpc_sandbox_setup(&req: ptr, &id_ptr: ptr, id_len: u64, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    result = call @rpc_builder_new()
    call @rpc_builder_append(&result, &J_SANDBOX_SETUP_A, J_SANDBOX_SETUP_A_LEN)
    call @rpc_builder_append_param_string_or_default(&result, &body, body_len, &J_MODE_KEY, J_MODE_KEY_LEN, &DEFAULT_LOCAL, DEFAULT_LOCAL_LEN)
    call @rpc_builder_append(&result, &J_SANDBOX_SETUP_B, J_SANDBOX_SETUP_B_LEN)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result)
    !body
    !body_len
    !req
    return 0

@ffi_wrapper send_rpc_fuzzy_search(&req: ptr, &id_ptr: ptr, id_len: u64, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    query_ptr_slot = stack_alloc 8
    query_len_slot = stack_alloc 8
    query_status = call @rpc_extract_string_after(&body, body_len, &J_QUERY_KEY, J_QUERY_KEY_LEN, &query_ptr_slot, &query_len_slot)
    query_found = eq query_status, 1
    br query_found -> L_FUZZY_QUERY_FOUND, L_FUZZY_EMPTY

L_FUZZY_QUERY_FOUND:
    !query_found
    query_ptr = load query_ptr_slot+0 as ptr
    query_len = load query_len_slot+0 as u64
    has_query = ugt query_len, 0
    br has_query -> L_FUZZY_HIT, L_FUZZY_EMPTY_FOUND

L_FUZZY_HIT:
    !has_query
    result_hit = call @rpc_builder_new()
    call @rpc_builder_append(&result_hit, &J_FUZZY_HIT_A, J_FUZZY_HIT_A_LEN)
    call @rpc_builder_append_json_string(&result_hit, &query_ptr, query_len)
    call @rpc_builder_append(&result_hit, &J_FUZZY_HIT_B, J_FUZZY_HIT_B_LEN)
    call @rpc_builder_append_json_string(&result_hit, &query_ptr, query_len)
    call @rpc_builder_append(&result_hit, &J_FUZZY_B, J_FUZZY_B_LEN)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result_hit)
    !query_ptr
    !query_len
    !query_status
    !body
    !body_len
    !req
    return 0

L_FUZZY_EMPTY_FOUND:
    !has_query
    !query_ptr
    !query_len
    jmp L_FUZZY_EMPTY_FROM_FOUND

L_FUZZY_EMPTY:
    !query_found

L_FUZZY_EMPTY_FROM_FOUND:
    result = call @rpc_builder_new()
    call @rpc_builder_append(&result, &J_FUZZY_A, J_FUZZY_A_LEN)
    call @rpc_builder_append_param_string_or_default(&result, &body, body_len, &J_QUERY_KEY, J_QUERY_KEY_LEN, &EMPTY_TEXT, EMPTY_TEXT_LEN)
    call @rpc_builder_append(&result, &J_FUZZY_B, J_FUZZY_B_LEN)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result)
    !query_status
    !body
    !body_len
    !req
    return 0

@ffi_wrapper send_rpc_fuzzy_session(&req: ptr, &id_ptr: ptr, id_len: u64, &body: ptr, body_len: u64, is_stop: u8) -> u32:
L_ENTRY:
    result = call @rpc_builder_new()
    call @rpc_builder_append(&result, &J_FUZZY_SESSION_A, J_FUZZY_SESSION_A_LEN)
    call @rpc_builder_append_param_string_or_default(&result, &body, body_len, &J_SESSION_ID_KEY, J_SESSION_ID_KEY_LEN, &EMPTY_TEXT, EMPTY_TEXT_LEN)
    stop = eq is_stop, 1
    br stop -> L_FUZZY_STOP, L_FUZZY_OK

L_FUZZY_OK:
    !stop
    call @rpc_builder_append(&result, &J_FUZZY_SESSION_B, J_FUZZY_SESSION_B_LEN)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result)
    !body
    !body_len
    !is_stop
    !req
    return 0

L_FUZZY_STOP:
    !stop
    call @rpc_builder_append(&result, &J_FUZZY_SESSION_STOP_B, J_FUZZY_SESSION_STOP_B_LEN)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result)
    !body
    !body_len
    !is_stop
    !req
    return 0

@ffi_wrapper send_rpc_server_resolved(&req: ptr, &id_ptr: ptr, id_len: u64, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    result = call @rpc_builder_new()
    call @rpc_builder_append(&result, &J_SERVER_RESOLVED_A, J_SERVER_RESOLVED_A_LEN)
    call @rpc_builder_append_param_string_or_default(&result, &body, body_len, &J_THREADID_KEY, J_THREADID_KEY_LEN, &EMPTY_TEXT, EMPTY_TEXT_LEN)
    call @rpc_builder_append(&result, &J_SERVER_RESOLVED_B, J_SERVER_RESOLVED_B_LEN)
    call @rpc_builder_append_param_string_or_default(&result, &body, body_len, &J_REQUEST_ID_KEY, J_REQUEST_ID_KEY_LEN, &EMPTY_TEXT, EMPTY_TEXT_LEN)
    call @rpc_builder_append(&result, &J_SERVER_RESOLVED_C, J_SERVER_RESOLVED_C_LEN)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result)
    !body
    !body_len
    !req
    return 0

// ============================================================
// Helper: check_auth(req, auth_token_ptr, auth_token_len) -> u8
// Returns 1 if auth is valid or no auth required, 0 if unauthorized.
// ============================================================
@ffi_wrapper check_auth(&req: ptr, &token_ptr: ptr, token_len: u64) -> u8:
L_ENTRY:
    no_token = eq token_len, 0
    br no_token -> L_AUTH_ALLOW, L_AUTH_CHECK_HDR

L_AUTH_ALLOW:
    !no_token
    !req
    !token_ptr
    !token_len
    return 1

L_AUTH_CHECK_HDR:
    !no_token
    hdr_val_slot = stack_alloc 8
    hdr_len_slot = stack_alloc 8
    store hdr_val_slot+0, 0 as ptr
    store hdr_len_slot+0, 0 as u64
    hdr_status = call @sa_http_server_req_get_header(req, &HDR_AUTH, HDR_AUTH_LEN, &hdr_val_slot, &hdr_len_slot)
    hdr_ptr = load hdr_val_slot+0 as ptr
    hdr_len = load hdr_len_slot+0 as u64
    has_hdr = ne hdr_ptr, 0
    br has_hdr -> L_AUTH_HDR_PREP, L_AUTH_TRY_XKEY

L_AUTH_TRY_XKEY:
    !has_hdr
    !hdr_status
    !hdr_ptr
    !hdr_len
    store hdr_val_slot+0, 0 as ptr
    store hdr_len_slot+0, 0 as u64
    xkey_status = call @sa_http_server_req_get_header(req, &HDR_X_API_KEY, HDR_X_API_KEY_LEN, &hdr_val_slot, &hdr_len_slot)
    xkey_ptr = load hdr_val_slot+0 as ptr
    xkey_len = load hdr_len_slot+0 as u64
    has_xkey = ne xkey_ptr, 0
    br has_xkey -> L_AUTH_XKEY_CMP, L_AUTH_XKEY_FAIL

L_AUTH_XKEY_CMP:
    !has_xkey
    !xkey_status
    xkey_match = call @sa_bytes_eq(&xkey_ptr, xkey_len, &token_ptr, token_len)
    xkey_ok = eq xkey_match, 1
    !xkey_match
    !xkey_ptr
    !xkey_len
    br xkey_ok -> L_AUTH_OK_XKEY, L_AUTH_FAIL_XKEY

L_AUTH_HDR_PREP:
    !has_hdr
    !hdr_status
    bearer_idx = call @sa_bytes_find(&hdr_ptr, hdr_len, &BEARER_PREFIX, BEARER_PREFIX_LEN)
    has_bearer = sge bearer_idx, 0
    br has_bearer -> L_AUTH_STRIP, L_AUTH_RAW

L_AUTH_STRIP:
    !has_bearer
    !bearer_idx
    auth_ptr = ptr_add hdr_ptr, BEARER_PREFIX_LEN
    auth_len = sub hdr_len, BEARER_PREFIX_LEN
    jmp L_AUTH_DO_CMP

L_AUTH_RAW:
    !has_bearer
    !bearer_idx
    auth_ptr = ptr_add hdr_ptr, 0
    auth_len = add hdr_len, 0
    jmp L_AUTH_DO_CMP

L_AUTH_DO_CMP:
    match = call @sa_bytes_eq(&auth_ptr, auth_len, &token_ptr, token_len)
    is_match = eq match, 1
    !match
    !auth_ptr
    !auth_len
    !hdr_ptr
    !hdr_len
    br is_match -> L_AUTH_OK_HDR, L_AUTH_FAIL_HDR

L_AUTH_OK_HDR:
    !is_match
    call @sa_print_bytes(&LOG_AUTH_OK, LOG_AUTH_OK_LEN)
    !req
    !token_ptr
    !token_len
    return 1

L_AUTH_FAIL_HDR:
    !is_match
    call @sa_print_bytes(&LOG_AUTH_FAIL, LOG_AUTH_FAIL_LEN)
    !req
    !token_ptr
    !token_len
    return 0

L_AUTH_OK_XKEY:
    !xkey_ok
    call @sa_print_bytes(&LOG_AUTH_OK, LOG_AUTH_OK_LEN)
    !req
    !token_ptr
    !token_len
    return 1

L_AUTH_FAIL_XKEY:
    !xkey_ok
    call @sa_print_bytes(&LOG_AUTH_FAIL, LOG_AUTH_FAIL_LEN)
    !req
    !token_ptr
    !token_len
    return 0

L_AUTH_XKEY_FAIL:
    !has_xkey
    !xkey_status
    !xkey_ptr
    !xkey_len
    call @sa_print_bytes(&LOG_AUTH_FAIL, LOG_AUTH_FAIL_LEN)
    !req
    !token_ptr
    !token_len
    return 0

// ============================================================
// Helper: scan_chunk_for_tokens(buf, len) -> u64
// Scans an SSE chunk for "total_tokens" value.
// Returns the token count, or 0 if not found.
// ============================================================
@ffi_wrapper scan_chunk_for_tokens(&buf: ptr, len: u64) -> u64:
L_ENTRY:
    // Look for "total_tokens" in the buffer
    idx = call @sa_bytes_find(&buf, len, &TOTAL_TOK, TOTAL_TOK_LEN)
    found = sge idx, 0
    br found -> L_TOK_PARSE, L_TOK_NONE

L_TOK_NONE:
    !found
    !idx
    !buf
    !len
    return 0

L_TOK_PARSE:
    !found
    // Skip past "total_tokens" and the colon
    // total_tokens": NNN or total_tokens": NNN
    after_key = add idx, TOTAL_TOK_LEN
    !idx
    // Find the colon
    remaining = sub len, after_key
    buf_at = ptr_add buf, after_key
    colon_idx = call @sa_bytes_find_byte(&buf_at, remaining, 58)
    !buf_at
    !remaining
    has_colon = sge colon_idx, 0
    br has_colon -> L_TOK_COLON, L_TOK_NO_COLON

L_TOK_COLON:
    !has_colon
    // Skip past colon and any spaces
    val_start = add after_key, colon_idx
    val_start2 = add val_start, 1
    !val_start
    !colon_idx
    !after_key
    // Find the end of the number (comma, space, or brace)
    val_buf = ptr_add buf, val_start2
    val_remaining = sub len, val_start2
    // Find comma (44) or space (32) or closing brace (125)
    comma_idx = call @sa_bytes_find_byte(&val_buf, val_remaining, 44)
    !val_buf
    !val_remaining
    has_comma = sge comma_idx, 0
    br has_comma -> L_TOK_EXTRACT, L_TOK_NO_COMMA

L_TOK_EXTRACT:
    !has_comma
    // Extract the number bytes
    num_buf = ptr_add buf, val_start2
    num_len = add comma_idx, 0
    !comma_idx
    !val_start2
    // Skip leading spaces
    first = load num_buf+0 as u8
    is_space = eq first, 32
    !first
    br is_space -> L_TOK_TRIM, L_TOK_CONV

L_TOK_TRIM:
    !is_space
    num_buf2 = ptr_add num_buf, 1
    num_len2 = sub num_len, 1
    result = call @sa_bytes_to_u64(&num_buf2, num_len2)
    !num_buf2
    !num_len2
    !num_buf
    !num_len
    !buf
    !len
    return result

L_TOK_CONV:
    !is_space
    result2 = call @sa_bytes_to_u64(&num_buf, num_len)
    !num_buf
    !num_len
    !buf
    !len
    return result2

L_TOK_NO_COLON:
    !has_colon
    !colon_idx
    !after_key
    !buf
    !len
    return 0

L_TOK_NO_COMMA:
    !has_comma
    !comma_idx
    !val_start2
    !buf
    !len
    return 0

// ============================================================
// Helper: handle_rpc_request(req, body, len, state, cfg)
// Dispatches JSON-RPC methods used by the Codex bridge.
// ============================================================
@ffi_wrapper handle_rpc_request(&req: ptr, &rpc_body_ptr: ptr, rpc_body_len: u64, &state_ptr: ptr, &cfg_ptr: ptr) -> u32:
L_ENTRY:
    rpc_id_ptr_slot = stack_alloc 8
    rpc_id_len_slot = stack_alloc 8
    rpc_id_status = call @rpc_extract_id_token(&rpc_body_ptr, rpc_body_len, &rpc_id_ptr_slot, &rpc_id_len_slot)
    !rpc_id_status
    rpc_id_ptr = load rpc_id_ptr_slot+0 as ptr
    rpc_id_len = load rpc_id_len_slot+0 as u64
    m_init_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_INIT, RPC_M_INIT_LEN)
    m_init_ok = sge m_init_idx, 0
    !m_init_idx
    br m_init_ok -> L_RPC_INIT, L_RPC_TRY_THR_START

L_RPC_INIT:
    !m_init_ok
    call @send_rpc_initialize(&req, &rpc_id_ptr, rpc_id_len)
    jmp L_RPC_DONE

L_RPC_TRY_THR_START:
    !m_init_ok
    m_ts_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_THR_START, RPC_M_THR_START_LEN)
    m_ts_ok = sge m_ts_idx, 0
    !m_ts_idx
    br m_ts_ok -> L_RPC_THR_START, L_RPC_TRY_THR_LIST

L_RPC_THR_START:
    !m_ts_ok
    cfg_model_ptr = load cfg_ptr+CFG_MODEL_PTR as ptr
    cfg_model_len = load cfg_ptr+CFG_MODEL_LEN as u64
    cfg_dir_ptr = load cfg_ptr+CFG_DIR_PTR as ptr
    cfg_dir_len = load cfg_ptr+CFG_DIR_LEN as u64
    model_ptr_slot = stack_alloc 8
    model_len_slot = stack_alloc 8
    dir_ptr_slot = stack_alloc 8
    dir_len_slot = stack_alloc 8
    provider_ptr_slot = stack_alloc 8
    provider_len_slot = stack_alloc 8
    thread_key_ptr_slot = stack_alloc 8
    thread_key_len_slot = stack_alloc 8
    default_provider_ptr = &DEFAULT_OPENAI
    model_override = call @rpc_extract_string_or_default(&rpc_body_ptr, rpc_body_len, &J_MODEL_KEY, J_MODEL_KEY_LEN, &cfg_model_ptr, cfg_model_len, &model_ptr_slot, &model_len_slot)
    dir_override = call @rpc_extract_string_or_default(&rpc_body_ptr, rpc_body_len, &J_CWD_KEY, J_CWD_KEY_LEN, &cfg_dir_ptr, cfg_dir_len, &dir_ptr_slot, &dir_len_slot)
    provider_override = call @rpc_extract_string_or_default(&rpc_body_ptr, rpc_body_len, &J_MODEL_PROVIDER_KEY, J_MODEL_PROVIDER_KEY_LEN, &default_provider_ptr, DEFAULT_OPENAI_LEN, &provider_ptr_slot, &provider_len_slot)
    thread_key_override = call @rpc_extract_string_or_default(&rpc_body_ptr, rpc_body_len, &J_THREADID_KEY, J_THREADID_KEY_LEN, &EMPTY_TEXT, EMPTY_TEXT_LEN, &thread_key_ptr_slot, &thread_key_len_slot)
    !model_override
    !dir_override
    !provider_override
    !thread_key_override
    !default_provider_ptr
    model_ptr = load model_ptr_slot+0 as ptr
    model_len = load model_len_slot+0 as u64
    dir_ptr = load dir_ptr_slot+0 as ptr
    dir_len = load dir_len_slot+0 as u64
    provider_ptr = load provider_ptr_slot+0 as ptr
    provider_len = load provider_len_slot+0 as u64
    thread_key_ptr = load thread_key_ptr_slot+0 as ptr
    thread_key_len = load thread_key_len_slot+0 as u64
    eph_false_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &J_EPHEMERAL_FALSE_KEY, J_EPHEMERAL_FALSE_KEY_LEN)
    eph_false_found = sge eph_false_idx, 0
    ephemeral = eq eph_false_found, 0
    !eph_false_idx
    !eph_false_found
    new_tid = call @state_thread_create_with_key(&state_ptr, &thread_key_ptr, thread_key_len, &model_ptr, model_len, &dir_ptr, dir_len)
    provider_set = call @state_thread_set_model_provider(&state_ptr, new_tid, &provider_ptr, provider_len)
    ephemeral_set = call @state_thread_set_ephemeral(&state_ptr, new_tid, ephemeral)
    !provider_set
    !ephemeral_set
    !cfg_model_ptr
    !cfg_model_len
    !cfg_dir_ptr
    !cfg_dir_len
    !model_ptr
    !model_len
    !dir_ptr
    !dir_len
    !provider_ptr
    !provider_len
    !thread_key_ptr
    !thread_key_len
    out_model_ptr = load model_ptr_slot+0 as ptr
    out_model_len = load model_len_slot+0 as u64
    out_dir_ptr = load dir_ptr_slot+0 as ptr
    out_dir_len = load dir_len_slot+0 as u64
    out_provider_ptr = load provider_ptr_slot+0 as ptr
    out_provider_len = load provider_len_slot+0 as u64
    call @notify_thread_started_with_values(&state_ptr, new_tid, 0, &out_provider_ptr, out_provider_len, ephemeral, &out_model_ptr, out_model_len, &out_dir_ptr, out_dir_len)
    call @notify_thread_status_idle(&state_ptr, new_tid)
    call @send_rpc_thread_start_with_values(&req, &rpc_id_ptr, rpc_id_len, &state_ptr, new_tid, 0, &out_provider_ptr, out_provider_len, ephemeral, &out_model_ptr, out_model_len, &out_dir_ptr, out_dir_len, &rpc_body_ptr, rpc_body_len)
    !out_provider_ptr
    !out_provider_len
    !ephemeral
    !out_model_ptr
    !out_model_len
    !out_dir_ptr
    !out_dir_len
    !new_tid
    jmp L_RPC_DONE

L_RPC_TRY_THR_LIST:
    !m_ts_ok
    m_tl_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_THR_LIST, RPC_M_THR_LIST_LEN)
    m_tl_ok = sge m_tl_idx, 0
    !m_tl_idx
    br m_tl_ok -> L_RPC_THR_LIST, L_RPC_TRY_THR_LOADED_LIST

L_RPC_THR_LIST:
    !m_tl_ok
    call @send_rpc_thread_list(&req, &rpc_id_ptr, rpc_id_len, &state_ptr)
    jmp L_RPC_DONE

L_RPC_TRY_THR_LOADED_LIST:
    !m_tl_ok
    m_tloaded_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_THR_LOADED_LIST, RPC_M_THR_LOADED_LIST_LEN)
    m_tloaded_ok = sge m_tloaded_idx, 0
    !m_tloaded_idx
    br m_tloaded_ok -> L_RPC_THR_LOADED_LIST, L_RPC_TRY_THR_READ

L_RPC_THR_LOADED_LIST:
    !m_tloaded_ok
    call @send_rpc_thread_loaded_list(&req, &rpc_id_ptr, rpc_id_len, &state_ptr)
    jmp L_RPC_DONE

L_RPC_TRY_THR_READ:
    !m_tloaded_ok
    m_tr_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_THR_READ, RPC_M_THR_READ_LEN)
    m_tr_ok = sge m_tr_idx, 0
    !m_tr_idx
    br m_tr_ok -> L_RPC_THR_READ, L_RPC_TRY_THR_ARCH

L_RPC_THR_READ:
    !m_tr_ok
    read_tid = call @rpc_resolve_thread_id(&state_ptr, &rpc_body_ptr, rpc_body_len, 1)
    include_turns_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_INCLUDE_TURNS_TRUE, RPC_INCLUDE_TURNS_TRUE_LEN)
    include_turns_ok = sge include_turns_idx, 0
    include_turns = eq include_turns_ok, 1
    !include_turns_idx
    !include_turns_ok
    call @send_rpc_thread_read(&req, &rpc_id_ptr, rpc_id_len, &state_ptr, read_tid, include_turns)
    !read_tid
    !include_turns
    jmp L_RPC_DONE

L_RPC_TRY_THR_ARCH:
    !m_tr_ok
    m_ta_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_THR_ARCH, RPC_M_THR_ARCH_LEN)
    m_ta_ok = sge m_ta_idx, 0
    !m_ta_idx
    br m_ta_ok -> L_RPC_THR_ARCH, L_RPC_TRY_THR_UNARCH

L_RPC_THR_ARCH:
    !m_ta_ok
    arch_tid = call @rpc_resolve_thread_id(&state_ptr, &rpc_body_ptr, rpc_body_len, 1)
    call @send_rpc_thread_archive(&req, &rpc_id_ptr, rpc_id_len, &state_ptr, arch_tid)
    !arch_tid
    jmp L_RPC_DONE

L_RPC_TRY_THR_UNARCH:
    !m_ta_ok
    m_tu_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_THR_UNARCH, RPC_M_THR_UNARCH_LEN)
    m_tu_ok = sge m_tu_idx, 0
    !m_tu_idx
    br m_tu_ok -> L_RPC_THR_UNARCH, L_RPC_TRY_THR_NAME_SET

L_RPC_THR_UNARCH:
    !m_tu_ok
    unarch_tid = call @rpc_resolve_thread_id(&state_ptr, &rpc_body_ptr, rpc_body_len, 1)
    call @send_rpc_thread_unarchive(&req, &rpc_id_ptr, rpc_id_len, &state_ptr, unarch_tid)
    !unarch_tid
    jmp L_RPC_DONE

L_RPC_TRY_THR_NAME_SET:
    !m_tu_ok
    m_tname_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_THR_NAME_SET, RPC_M_THR_NAME_SET_LEN)
    m_tname_ok = sge m_tname_idx, 0
    !m_tname_idx
    br m_tname_ok -> L_RPC_THR_NAME_SET, L_RPC_TRY_THR_METADATA_UPDATE

L_RPC_THR_NAME_SET:
    !m_tname_ok
    call @send_rpc_thread_name_set(&req, &rpc_id_ptr, rpc_id_len, &state_ptr, &rpc_body_ptr, rpc_body_len)
    jmp L_RPC_DONE

L_RPC_TRY_THR_METADATA_UPDATE:
    !m_tname_ok
    m_tmeta_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_THR_METADATA_UPDATE, RPC_M_THR_METADATA_UPDATE_LEN)
    m_tmeta_ok = sge m_tmeta_idx, 0
    !m_tmeta_idx
    br m_tmeta_ok -> L_RPC_THR_METADATA_UPDATE, L_RPC_TRY_THR_FORK

L_RPC_THR_METADATA_UPDATE:
    !m_tmeta_ok
    call @send_rpc_thread_metadata_update(&req, &rpc_id_ptr, rpc_id_len, &state_ptr, &rpc_body_ptr, rpc_body_len)
    jmp L_RPC_DONE

L_RPC_TRY_THR_FORK:
    !m_tmeta_ok
    m_tf_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_THR_FORK, RPC_M_THR_FORK_LEN)
    m_tf_ok = sge m_tf_idx, 0
    !m_tf_idx
    br m_tf_ok -> L_RPC_THR_FORK, L_RPC_TRY_THR_RESUME

L_RPC_THR_FORK:
    !m_tf_ok
    fork_source_tid = call @rpc_resolve_thread_id(&state_ptr, &rpc_body_ptr, rpc_body_len, 0)
    source_slot = call @state_thread_find(&state_ptr, fork_source_tid)
    source_missing = eq source_slot, 0
    br source_missing -> L_RPC_THR_FORK_NOT_FOUND, L_RPC_THR_FORK_FOUND

L_RPC_THR_FORK_FOUND:
    !source_missing
    source_model_ptr = load source_slot+THR_MODEL_PTR as ptr
    source_model_len = load source_slot+THR_MODEL_LEN as u64
    source_dir_ptr = load source_slot+THR_DIR_PTR as ptr
    source_dir_len = load source_slot+THR_DIR_LEN as u64
    source_provider_ptr = load source_slot+THR_PROVIDER_PTR as ptr
    source_provider_len = load source_slot+THR_PROVIDER_LEN as u64
    fork_model_ptr_slot = stack_alloc 8
    fork_model_len_slot = stack_alloc 8
    fork_dir_ptr_slot = stack_alloc 8
    fork_dir_len_slot = stack_alloc 8
    fork_provider_ptr_slot = stack_alloc 8
    fork_provider_len_slot = stack_alloc 8
    fork_model_override = call @rpc_extract_string_or_default(&rpc_body_ptr, rpc_body_len, &J_MODEL_KEY, J_MODEL_KEY_LEN, &source_model_ptr, source_model_len, &fork_model_ptr_slot, &fork_model_len_slot)
    fork_dir_override = call @rpc_extract_string_or_default(&rpc_body_ptr, rpc_body_len, &J_CWD_KEY, J_CWD_KEY_LEN, &source_dir_ptr, source_dir_len, &fork_dir_ptr_slot, &fork_dir_len_slot)
    fork_provider_override = call @rpc_extract_string_or_default(&rpc_body_ptr, rpc_body_len, &J_MODEL_PROVIDER_KEY, J_MODEL_PROVIDER_KEY_LEN, &source_provider_ptr, source_provider_len, &fork_provider_ptr_slot, &fork_provider_len_slot)
    !fork_model_override
    !fork_dir_override
    !fork_provider_override
    model_ptr2 = load fork_model_ptr_slot+0 as ptr
    model_len2 = load fork_model_len_slot+0 as u64
    dir_ptr2 = load fork_dir_ptr_slot+0 as ptr
    dir_len2 = load fork_dir_len_slot+0 as u64
    provider_ptr2 = load fork_provider_ptr_slot+0 as ptr
    provider_len2 = load fork_provider_len_slot+0 as u64
    fork_eph_false_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &J_EPHEMERAL_FALSE_KEY, J_EPHEMERAL_FALSE_KEY_LEN)
    fork_eph_false_found = sge fork_eph_false_idx, 0
    ephemeral2 = eq fork_eph_false_found, 0
    !fork_eph_false_idx
    !fork_eph_false_found
    fork_tid = call @state_thread_create(&state_ptr, &model_ptr2, model_len2, &dir_ptr2, dir_len2)
    fork_provider_set = call @state_thread_set_model_provider(&state_ptr, fork_tid, &provider_ptr2, provider_len2)
    fork_ephemeral_set = call @state_thread_set_ephemeral(&state_ptr, fork_tid, ephemeral2)
    !fork_provider_set
    !fork_ephemeral_set
    fork_slot = call @state_thread_find(&state_ptr, fork_tid)
    store fork_slot+THR_FORKED_FROM_ID, fork_source_tid as u64
    source_preview_len = load source_slot+THR_PREVIEW_LEN as u64
    source_preview_src = ptr_add source_slot, THR_PREVIEW
    fork_preview_dst = ptr_add fork_slot, THR_PREVIEW
    fork_preview_copied = call @sa_bytes_copy(&fork_preview_dst, &source_preview_src, source_preview_len)
    store fork_slot+THR_PREVIEW_LEN, fork_preview_copied as u64
    source_name_len = load source_slot+THR_NAME_LEN as u64
    source_name_set = load source_slot+THR_NAME_SET as u8
    source_name_src = ptr_add source_slot, THR_NAME
    fork_name_dst = ptr_add fork_slot, THR_NAME
    fork_name_copied = call @sa_bytes_copy(&fork_name_dst, &source_name_src, source_name_len)
    store fork_slot+THR_NAME_LEN, fork_name_copied as u64
    store fork_slot+THR_NAME_SET, source_name_set as u8
    fork_git_status = call @state_thread_copy_git_info(&state_ptr, fork_source_tid, fork_tid)
    !fork_git_status
    !source_model_ptr
    !source_model_len
    !source_dir_ptr
    !source_dir_len
    !source_provider_ptr
    !source_provider_len
    !model_ptr2
    !model_len2
    !dir_ptr2
    !dir_len2
    !provider_ptr2
    !provider_len2
    !fork_preview_copied
    !fork_name_copied
    !source_preview_len
    !source_preview_src
    !fork_preview_dst
    !source_name_len
    !source_name_set
    !source_name_src
    !fork_name_dst
    !fork_slot
    !source_slot
    fork_out_model_ptr = load fork_model_ptr_slot+0 as ptr
    fork_out_model_len = load fork_model_len_slot+0 as u64
    fork_out_dir_ptr = load fork_dir_ptr_slot+0 as ptr
    fork_out_dir_len = load fork_dir_len_slot+0 as u64
    fork_out_provider_ptr = load fork_provider_ptr_slot+0 as ptr
    fork_out_provider_len = load fork_provider_len_slot+0 as u64
    call @notify_thread_started_with_values(&state_ptr, fork_tid, fork_source_tid, &fork_out_provider_ptr, fork_out_provider_len, ephemeral2, &fork_out_model_ptr, fork_out_model_len, &fork_out_dir_ptr, fork_out_dir_len)
    call @notify_thread_status_idle(&state_ptr, fork_tid)
    call @send_rpc_thread_start_with_values(&req, &rpc_id_ptr, rpc_id_len, &state_ptr, fork_tid, fork_source_tid, &fork_out_provider_ptr, fork_out_provider_len, ephemeral2, &fork_out_model_ptr, fork_out_model_len, &fork_out_dir_ptr, fork_out_dir_len, &rpc_body_ptr, rpc_body_len)
    !fork_out_provider_ptr
    !fork_out_provider_len
    !ephemeral2
    !fork_out_model_ptr
    !fork_out_model_len
    !fork_out_dir_ptr
    !fork_out_dir_len
    !fork_tid
    !fork_source_tid
    jmp L_RPC_DONE

L_RPC_THR_FORK_NOT_FOUND:
    !source_missing
    !source_slot
    !fork_source_tid
    call @send_error_with_id(&req, 404, &rpc_id_ptr, rpc_id_len, &J_ERR_THREAD_NOT_FOUND, J_ERR_THREAD_NOT_FOUND_LEN)
    jmp L_RPC_DONE

L_RPC_TRY_THR_RESUME:
    !m_tf_ok
    m_tres_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_THR_RESUME, RPC_M_THR_RESUME_LEN)
    m_tres_ok = sge m_tres_idx, 0
    !m_tres_idx
    br m_tres_ok -> L_RPC_THR_RESUME, L_RPC_TRY_THR_ROLLBACK

L_RPC_THR_RESUME:
    !m_tres_ok
    resume_tid = call @rpc_resolve_thread_id(&state_ptr, &rpc_body_ptr, rpc_body_len, 1)
    call @send_rpc_thread_resume(&req, &rpc_id_ptr, rpc_id_len, &state_ptr, resume_tid, &rpc_body_ptr, rpc_body_len)
    !resume_tid
    jmp L_RPC_DONE

L_RPC_TRY_THR_ROLLBACK:
    !m_tres_ok
    m_trb_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_THR_ROLLBACK, RPC_M_THR_ROLLBACK_LEN)
    m_trb_ok = sge m_trb_idx, 0
    !m_trb_idx
    br m_trb_ok -> L_RPC_THR_ROLLBACK, L_RPC_TRY_THR_TURNS

L_RPC_THR_ROLLBACK:
    !m_trb_ok
    rollback_tid = call @rpc_resolve_thread_id(&state_ptr, &rpc_body_ptr, rpc_body_len, 1)
    remove_count_string_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &J_NUM_TURNS_KEY, J_NUM_TURNS_KEY_LEN)
    remove_count_is_string = sge remove_count_string_idx, 0
    !remove_count_string_idx
    br remove_count_is_string -> L_RPC_THR_ROLLBACK_STRING_COUNT, L_RPC_THR_ROLLBACK_NUMBER_COUNT

L_RPC_THR_ROLLBACK_STRING_COUNT:
    !remove_count_is_string
    remove_count = call @rpc_extract_u64_after(&rpc_body_ptr, rpc_body_len, &J_NUM_TURNS_KEY, J_NUM_TURNS_KEY_LEN, 1)
    call @send_rpc_thread_rollback(&req, &rpc_id_ptr, rpc_id_len, &state_ptr, rollback_tid, remove_count)
    !rollback_tid
    !remove_count
    jmp L_RPC_DONE

L_RPC_THR_ROLLBACK_NUMBER_COUNT:
    !remove_count_is_string
    remove_count2 = call @rpc_extract_u64_number_after(&rpc_body_ptr, rpc_body_len, &J_NUM_TURNS_NUM_KEY, J_NUM_TURNS_NUM_KEY_LEN, 1)
    call @send_rpc_thread_rollback(&req, &rpc_id_ptr, rpc_id_len, &state_ptr, rollback_tid, remove_count2)
    !rollback_tid
    !remove_count2
    jmp L_RPC_DONE

L_RPC_TRY_THR_TURNS:
    !m_trb_ok
    m_tturn_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_THR_TURNS, RPC_M_THR_TURNS_LEN)
    m_tt_ok = sge m_tturn_idx, 0
    !m_tturn_idx
    br m_tt_ok -> L_RPC_THR_TURNS, L_RPC_TRY_THR_TURN_ITEMS

L_RPC_THR_TURNS:
    !m_tt_ok
    turns_tid = call @rpc_resolve_thread_id(&state_ptr, &rpc_body_ptr, rpc_body_len, 1)
    call @send_rpc_turns_list(&req, &rpc_id_ptr, rpc_id_len, &state_ptr, turns_tid)
    !turns_tid
    jmp L_RPC_DONE

L_RPC_TRY_THR_TURN_ITEMS:
    !m_tt_ok
    m_titems_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_THR_TURN_ITEMS, RPC_M_THR_TURN_ITEMS_LEN)
    m_titems_ok = sge m_titems_idx, 0
    !m_titems_idx
    br m_titems_ok -> L_RPC_THR_TURN_ITEMS, L_RPC_TRY_THR_INJECT_ITEMS

L_RPC_THR_TURN_ITEMS:
    !m_titems_ok
    items_thread_id = call @rpc_resolve_thread_id(&state_ptr, &rpc_body_ptr, rpc_body_len, 1)
    items_turn_id = call @rpc_extract_u64_after(&rpc_body_ptr, rpc_body_len, &J_TURNID_KEY, J_TURNID_KEY_LEN, 0)
    call @send_rpc_turn_items_list(&req, &rpc_id_ptr, rpc_id_len, &state_ptr, items_thread_id, items_turn_id)
    !items_thread_id
    !items_turn_id
    jmp L_RPC_DONE

L_RPC_TRY_THR_INJECT_ITEMS:
    !m_titems_ok
    m_tinject_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_THR_INJECT_ITEMS, RPC_M_THR_INJECT_ITEMS_LEN)
    m_tinject_ok = sge m_tinject_idx, 0
    !m_tinject_idx
    br m_tinject_ok -> L_RPC_THR_INJECT_ITEMS, L_RPC_TRY_THR_INC_ELICITATION

L_RPC_THR_INJECT_ITEMS:
    !m_tinject_ok
    call @send_rpc_thread_inject_items(&req, &rpc_id_ptr, rpc_id_len, &state_ptr, &rpc_body_ptr, rpc_body_len)
    jmp L_RPC_DONE

L_RPC_TRY_THR_INC_ELICITATION:
    !m_tinject_ok
    m_tinc_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_THR_INC_ELICITATION, RPC_M_THR_INC_ELICITATION_LEN)
    m_tinc_ok = sge m_tinc_idx, 0
    !m_tinc_idx
    br m_tinc_ok -> L_RPC_THR_INC_ELICITATION, L_RPC_TRY_THR_DEC_ELICITATION

L_RPC_THR_INC_ELICITATION:
    !m_tinc_ok
    call @send_rpc_thread_increment_elicitation(&req, &rpc_id_ptr, rpc_id_len, &state_ptr, &rpc_body_ptr, rpc_body_len)
    jmp L_RPC_DONE

L_RPC_TRY_THR_DEC_ELICITATION:
    !m_tinc_ok
    m_tdec_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_THR_DEC_ELICITATION, RPC_M_THR_DEC_ELICITATION_LEN)
    m_tdec_ok = sge m_tdec_idx, 0
    !m_tdec_idx
    br m_tdec_ok -> L_RPC_THR_DEC_ELICITATION, L_RPC_TRY_TURN_START

L_RPC_THR_DEC_ELICITATION:
    !m_tdec_ok
    call @send_rpc_thread_decrement_elicitation(&req, &rpc_id_ptr, rpc_id_len, &state_ptr, &rpc_body_ptr, rpc_body_len)
    jmp L_RPC_DONE

L_RPC_TRY_TURN_START:
    !m_tdec_ok
    m_turns_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_TURN_START, RPC_M_TURN_START_LEN)
    m_turns_ok = sge m_turns_idx, 0
    !m_turns_idx
    br m_turns_ok -> L_RPC_TURN_START, L_RPC_TRY_THR_COMPACT_START

L_RPC_TURN_START:
    !m_turns_ok
    turn_thread_id = call @rpc_resolve_thread_id(&state_ptr, &rpc_body_ptr, rpc_body_len, 1)
    new_turn_id = call @state_turn_create(&state_ptr, turn_thread_id)
    turn_created = ne new_turn_id, 0
    br turn_created -> L_RPC_TURN_START_CREATED, L_RPC_TURN_START_NOT_FOUND

L_RPC_TURN_START_CREATED:
    !turn_created
    input_ptr_slot = stack_alloc 8
    input_len_slot = stack_alloc 8
    input_status = call @rpc_extract_array_after(&rpc_body_ptr, rpc_body_len, &J_INPUT_ARRAY_KEY, J_INPUT_ARRAY_KEY_LEN, &input_ptr_slot, &input_len_slot)
    has_input = eq input_status, 1
    br has_input -> L_RPC_TURN_START_STORE_INPUT, L_RPC_TURN_START_NO_INPUT

L_RPC_TURN_START_STORE_INPUT:
    !has_input
    !input_status
    input_ptr = load input_ptr_slot+0 as ptr
    input_len = load input_len_slot+0 as u64
    set_items_status = call @state_turn_set_items(&state_ptr, turn_thread_id, new_turn_id, &input_ptr, input_len)
    !set_items_status
    !input_ptr
    !input_len
    jmp L_RPC_TURN_START_NOTIFY

L_RPC_TURN_START_NO_INPUT:
    !has_input
    !input_status
    jmp L_RPC_TURN_START_NOTIFY

L_RPC_TURN_START_NOTIFY:
    turn_mode = call @body_collaboration_mode(&rpc_body_ptr, rpc_body_len)
    turn_mode_set_status = call @state_turn_set_mode(&state_ptr, turn_thread_id, new_turn_id, turn_mode)
    !turn_mode_set_status
    call @notify_turn_started(&state_ptr, turn_thread_id, new_turn_id)
    call @notify_turn_diff(&state_ptr, turn_thread_id, new_turn_id)
    call @notify_turn_plan(&state_ptr, turn_thread_id, new_turn_id)
    turn_input_notify_count = call @notify_turn_input_items_from_dom(&state_ptr, &rpc_body_ptr, rpc_body_len, turn_thread_id, new_turn_id)
    !turn_input_notify_count
    call @send_rpc_turn_start(&req, &rpc_id_ptr, rpc_id_len, &state_ptr, turn_thread_id, new_turn_id, turn_mode)
    !turn_mode
    !turn_thread_id
    !new_turn_id
    jmp L_RPC_DONE

L_RPC_TURN_START_NOT_FOUND:
    !turn_created
    !new_turn_id
    call @send_error_with_id(&req, 404, &rpc_id_ptr, rpc_id_len, &J_ERR_THREAD_NOT_FOUND, J_ERR_THREAD_NOT_FOUND_LEN)
    !turn_thread_id
    jmp L_RPC_DONE

L_RPC_TRY_THR_COMPACT_START:
    !m_turns_ok
    m_compact_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_THR_COMPACT_START, RPC_M_THR_COMPACT_START_LEN)
    m_compact_ok = sge m_compact_idx, 0
    !m_compact_idx
    br m_compact_ok -> L_RPC_THR_COMPACT_START, L_RPC_TRY_THR_SHELL_COMMAND

L_RPC_THR_COMPACT_START:
    !m_compact_ok
    call @send_rpc_thread_simple_id(&req, &rpc_id_ptr, rpc_id_len, &rpc_body_ptr, rpc_body_len, &J_COMPACT_A, J_COMPACT_A_LEN, &J_COMPACT_B, J_COMPACT_B_LEN)
    jmp L_RPC_DONE

L_RPC_TRY_THR_SHELL_COMMAND:
    !m_compact_ok
    m_shell_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_THR_SHELL_COMMAND, RPC_M_THR_SHELL_COMMAND_LEN)
    m_shell_ok = sge m_shell_idx, 0
    !m_shell_idx
    br m_shell_ok -> L_RPC_THR_SHELL_COMMAND, L_RPC_TRY_THR_APPROVE_GUARDIAN

L_RPC_THR_SHELL_COMMAND:
    !m_shell_ok
    call @send_rpc_thread_shell_command(&req, &rpc_id_ptr, rpc_id_len, &rpc_body_ptr, rpc_body_len)
    jmp L_RPC_DONE

L_RPC_TRY_THR_APPROVE_GUARDIAN:
    !m_shell_ok
    m_guardian_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_THR_APPROVE_GUARDIAN, RPC_M_THR_APPROVE_GUARDIAN_LEN)
    m_guardian_ok = sge m_guardian_idx, 0
    !m_guardian_idx
    br m_guardian_ok -> L_RPC_THR_APPROVE_GUARDIAN, L_RPC_TRY_THR_BG_CLEAN

L_RPC_THR_APPROVE_GUARDIAN:
    !m_guardian_ok
    call @send_rpc_thread_simple_id(&req, &rpc_id_ptr, rpc_id_len, &rpc_body_ptr, rpc_body_len, &J_APPROVE_A, J_APPROVE_A_LEN, &J_APPROVE_B, J_APPROVE_B_LEN)
    jmp L_RPC_DONE

L_RPC_TRY_THR_BG_CLEAN:
    !m_guardian_ok
    m_bgclean_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_THR_BG_CLEAN, RPC_M_THR_BG_CLEAN_LEN)
    m_bgclean_ok = sge m_bgclean_idx, 0
    !m_bgclean_idx
    br m_bgclean_ok -> L_RPC_THR_BG_CLEAN, L_RPC_TRY_THR_MEMORY_MODE_SET

L_RPC_THR_BG_CLEAN:
    !m_bgclean_ok
    call @send_rpc_thread_simple_id(&req, &rpc_id_ptr, rpc_id_len, &rpc_body_ptr, rpc_body_len, &J_CLEAN_A, J_CLEAN_A_LEN, &J_CLEAN_B, J_CLEAN_B_LEN)
    jmp L_RPC_DONE

L_RPC_TRY_THR_MEMORY_MODE_SET:
    !m_bgclean_ok
    m_memory_mode_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_THR_MEMORY_MODE_SET, RPC_M_THR_MEMORY_MODE_SET_LEN)
    m_memory_mode_ok = sge m_memory_mode_idx, 0
    !m_memory_mode_idx
    br m_memory_mode_ok -> L_RPC_THR_MEMORY_MODE_SET, L_RPC_TRY_TURN_STEER

L_RPC_THR_MEMORY_MODE_SET:
    !m_memory_mode_ok
    call @send_rpc_thread_memory_mode(&req, &rpc_id_ptr, rpc_id_len, &rpc_body_ptr, rpc_body_len)
    jmp L_RPC_DONE

L_RPC_TRY_TURN_STEER:
    !m_memory_mode_ok
    m_tsteer_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_TURN_STEER, RPC_M_TURN_STEER_LEN)
    m_tsteer_ok = sge m_tsteer_idx, 0
    !m_tsteer_idx
    br m_tsteer_ok -> L_RPC_TURN_STEER, L_RPC_TRY_TURN_INT

L_RPC_TURN_STEER:
    !m_tsteer_ok
    steer_thread_id = call @rpc_resolve_thread_id(&state_ptr, &rpc_body_ptr, rpc_body_len, 1)
    steer_turn_id = call @rpc_extract_u64_after(&rpc_body_ptr, rpc_body_len, &J_EXPECTED_TURNID_KEY, J_EXPECTED_TURNID_KEY_LEN, 1)
    call @send_rpc_turn_steer(&req, &rpc_id_ptr, rpc_id_len, &state_ptr, steer_thread_id, steer_turn_id, &rpc_body_ptr, rpc_body_len)
    !steer_thread_id
    !steer_turn_id
    jmp L_RPC_DONE

L_RPC_TRY_TURN_INT:
    !m_tsteer_ok
    m_turni_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_TURN_INTERRUPT, RPC_M_TURN_INTERRUPT_LEN)
    m_turni_ok = sge m_turni_idx, 0
    !m_turni_idx
    br m_turni_ok -> L_RPC_TURN_INT, L_RPC_TRY_GOAL_SET

L_RPC_TURN_INT:
    !m_turni_ok
    int_thread_id = call @rpc_resolve_thread_id(&state_ptr, &rpc_body_ptr, rpc_body_len, 1)
    int_turn_id = call @rpc_extract_u64_after(&rpc_body_ptr, rpc_body_len, &J_TURNID_KEY, J_TURNID_KEY_LEN, 1)
    call @send_rpc_turn_interrupt(&req, &rpc_id_ptr, rpc_id_len, &state_ptr, int_thread_id, int_turn_id)
    !int_thread_id
    !int_turn_id
    jmp L_RPC_DONE

L_RPC_TRY_GOAL_SET:
    !m_turni_ok
    m_gs_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_GOAL_SET, RPC_M_GOAL_SET_LEN)
    m_gs_ok = sge m_gs_idx, 0
    !m_gs_idx
    br m_gs_ok -> L_RPC_GOAL_SET, L_RPC_TRY_GOAL_GET

L_RPC_GOAL_SET:
    !m_gs_ok
    gs_thread_id = call @rpc_resolve_thread_id(&state_ptr, &rpc_body_ptr, rpc_body_len, 0)
    gs_budget = call @rpc_extract_u64_number_after(&rpc_body_ptr, rpc_body_len, &J_TOKEN_BUDGET_KEY, J_TOKEN_BUDGET_KEY_LEN, 0)
    gs_obj_ptr_slot = stack_alloc 8
    gs_obj_len_slot = stack_alloc 8
    gs_obj_status = call @rpc_extract_string_after(&rpc_body_ptr, rpc_body_len, &J_OBJECTIVE_KEY, J_OBJECTIVE_KEY_LEN, &gs_obj_ptr_slot, &gs_obj_len_slot)
    gs_has_obj = eq gs_obj_status, 1
    !gs_obj_status
    br gs_has_obj -> L_RPC_GOAL_SET_WITH_OBJ, L_RPC_GOAL_SET_EMPTY_OBJ

L_RPC_GOAL_SET_WITH_OBJ:
    !gs_has_obj
    gs_obj_ptr = load gs_obj_ptr_slot+0 as ptr
    gs_obj_len = load gs_obj_len_slot+0 as u64
    gs_status = call @state_goal_set(&state_ptr, gs_thread_id, gs_budget, &gs_obj_ptr, gs_obj_len)
    !gs_status
    call @notify_goal_updated(&state_ptr, gs_thread_id, gs_budget, 0, &gs_obj_ptr, gs_obj_len)
    call @send_rpc_goal_obj(&req, &rpc_id_ptr, rpc_id_len, &state_ptr, gs_thread_id, gs_budget, 0, &gs_obj_ptr, gs_obj_len)
    !gs_obj_ptr
    !gs_obj_len
    !gs_thread_id
    !gs_budget
    jmp L_RPC_DONE

L_RPC_GOAL_SET_EMPTY_OBJ:
    !gs_has_obj
    gs_status2 = call @state_goal_set(&state_ptr, gs_thread_id, gs_budget, &EMPTY_TEXT, 0)
    !gs_status2
    call @notify_goal_updated(&state_ptr, gs_thread_id, gs_budget, 0, &EMPTY_TEXT, 0)
    call @send_rpc_goal_obj(&req, &rpc_id_ptr, rpc_id_len, &state_ptr, gs_thread_id, gs_budget, 0, &EMPTY_TEXT, 0)
    !gs_thread_id
    !gs_budget
    jmp L_RPC_DONE

L_RPC_TRY_GOAL_GET:
    !m_gs_ok
    m_gg_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_GOAL_GET, RPC_M_GOAL_GET_LEN)
    m_gg_ok = sge m_gg_idx, 0
    !m_gg_idx
    br m_gg_ok -> L_RPC_GOAL_GET, L_RPC_TRY_GOAL_CLR

L_RPC_GOAL_GET:
    !m_gg_ok
    gg_thread_id = call @rpc_resolve_thread_id(&state_ptr, &rpc_body_ptr, rpc_body_len, 0)
    budget_slot = stack_alloc 8
    used_slot = stack_alloc 8
    obj_ptr_slot = stack_alloc 8
    obj_len_slot = stack_alloc 8
    gg_status = call @state_goal_get_full(&state_ptr, gg_thread_id, &budget_slot, &used_slot, &obj_ptr_slot, &obj_len_slot)
    goal_found = eq gg_status, 0
    !gg_status
    br goal_found -> L_RPC_GOAL_GET_FOUND, L_RPC_GOAL_GET_NONE

L_RPC_GOAL_GET_FOUND:
    !goal_found
    budget = load budget_slot+0 as u64
    used = load used_slot+0 as u64
    obj_ptr = load obj_ptr_slot+0 as ptr
    obj_len = load obj_len_slot+0 as u64
    call @send_rpc_goal_obj(&req, &rpc_id_ptr, rpc_id_len, &state_ptr, gg_thread_id, budget, used, &obj_ptr, obj_len)
    !obj_ptr
    !obj_len
    !budget
    !used
    !gg_thread_id
    jmp L_RPC_DONE

L_RPC_GOAL_GET_NONE:
    !goal_found
    call @send_wrapped_const_with_id(&req, &rpc_id_ptr, rpc_id_len, &J_GOAL_NULL, J_GOAL_NULL_LEN)
    !gg_thread_id
    jmp L_RPC_DONE

L_RPC_TRY_GOAL_CLR:
    !m_gg_ok
    m_gc_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_GOAL_CLEAR, RPC_M_GOAL_CLEAR_LEN)
    m_gc_ok = sge m_gc_idx, 0
