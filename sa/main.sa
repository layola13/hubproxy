    !event_len
    !item_suffix
    !item_suffix_len
    return 0

@ffi_wrapper notify_timed_item(&state_ptr: ptr, &event_ptr: ptr, event_len: u64, thread_id: u64, turn_id: u64, &item_ptr: ptr, item_len: u64, &time_prefix: ptr, time_prefix_len: u64) -> u32:
L_ENTRY:
    now_i = call @sa_time_unix_ms()
    now = bitcast now_i as u64
    frame = call @rpc_builder_new()
    call @notify_frame_begin(&frame, &event_ptr, event_len)
    call @rpc_builder_append(&frame, &J_EVT_THREAD_ID_A, J_EVT_THREAD_ID_A_LEN)
    call @rpc_builder_append_u64(&frame, thread_id)
    call @rpc_builder_append(&frame, &J_EVT_TURN_ID_B, J_EVT_TURN_ID_B_LEN)
    call @rpc_builder_append_u64(&frame, turn_id)
    call @rpc_builder_append(&frame, &time_prefix, time_prefix_len)
    call @rpc_builder_append_u64(&frame, now)
    call @rpc_builder_append(&frame, &J_EVT_ITEM_TIME_B2, J_EVT_ITEM_TIME_B2_LEN)
    call @rpc_builder_append(&frame, &item_ptr, item_len)
    call @rpc_builder_append(&frame, &J_EVT_CLOSE, J_EVT_CLOSE_LEN)
    call @rpc_builder_append(&frame, &SSE_FRAME_END, SSE_FRAME_END_LEN)
    call @notify_push_frame(&state_ptr, ^frame)
    !now_i
    !now
    !thread_id
    !turn_id
    !item_ptr
    !item_len
    !state_ptr
    !event_ptr
    !event_len
    !time_prefix
    !time_prefix_len
    return 0

@ffi_wrapper notify_completed_item_node(&state_ptr: ptr, thread_id: u64, turn_id: u64, item_node: ptr) -> u32:
L_ENTRY:
    buffer_slot = stack_alloc 8
    stringify_status = call @sa_json_stringify(item_node, &buffer_slot)
    stringify_ok = eq stringify_status, 0
    br stringify_ok -> L_NOTIFY_ITEM_NODE_OK, L_NOTIFY_ITEM_NODE_BAD

L_NOTIFY_ITEM_NODE_OK:
    !stringify_ok
    buffer = load buffer_slot+0 as ptr
    item_ptr = call @sa_json_buffer_data(&buffer)
    item_len = call @sa_json_buffer_len(&buffer)
    call @notify_timed_item(&state_ptr, &EV_ITEM_STARTED, EV_ITEM_STARTED_LEN, thread_id, turn_id, &item_ptr, item_len, &J_EVT_ITEM_STARTED_B1, J_EVT_ITEM_STARTED_B1_LEN)
    call @notify_injected_item(&state_ptr, &EV_RAW_ITEM_COMPLETED, EV_RAW_ITEM_COMPLETED_LEN, thread_id, turn_id, &item_ptr, item_len, &J_EVT_ITEM_RAW_B, J_EVT_ITEM_RAW_B_LEN)
    call @notify_timed_item(&state_ptr, &EV_ITEM_COMPLETED, EV_ITEM_COMPLETED_LEN, thread_id, turn_id, &item_ptr, item_len, &J_EVT_ITEM_COMPLETED_B1, J_EVT_ITEM_COMPLETED_B1_LEN)
    free_buffer = call @sa_json_buffer_free(^buffer)
    !free_buffer
    !item_ptr
    !item_len
    !stringify_status
    !state_ptr
    !thread_id
    !turn_id
    !item_node
    return 1

L_NOTIFY_ITEM_NODE_BAD:
    !stringify_ok
    !stringify_status
    !state_ptr
    !thread_id
    !turn_id
    !item_node
    return 0

@ffi_wrapper notify_turn_input_items_from_dom(&state_ptr: ptr, &body: ptr, body_len: u64, thread_id: u64, turn_id: u64) -> u64:
L_ENTRY:
    root = call @sa_json_parse(&body, body_len)
    has_root = ne root, 0
    br has_root -> L_TURN_INPUT_ROOT, L_TURN_INPUT_NO_ROOT

L_TURN_INPUT_ROOT:
    !has_root
    params_slot = stack_alloc 8
    params_status = call @sa_json_object_get(root, &FB_KEY_PARAMS, FB_KEY_PARAMS_LEN, &params_slot)
    params_ok = eq params_status, 0
    br params_ok -> L_TURN_INPUT_PARAMS, L_TURN_INPUT_NO_PARAMS

L_TURN_INPUT_PARAMS:
    !params_ok
    params_node = load params_slot+0 as ptr
    input_slot = stack_alloc 8
    input_status = call @sa_json_object_get(params_node, &FB_KEY_INPUT, FB_KEY_INPUT_LEN, &input_slot)
    input_ok = eq input_status, 0
    br input_ok -> L_TURN_INPUT_ITEMS, L_TURN_INPUT_NO_INPUT

L_TURN_INPUT_ITEMS:
    !input_ok
    input_node = load input_slot+0 as ptr
    count_slot = stack_alloc 8
    count_status = call @sa_json_value_count(input_node, &count_slot)
    count_ok = eq count_status, 0
    br count_ok -> L_TURN_INPUT_LOOP_INIT, L_TURN_INPUT_BAD_COUNT

L_TURN_INPUT_LOOP_INIT:
    !count_ok
    count = load count_slot+0 as u64
    index_slot = stack_alloc 8
    item_slot = stack_alloc 8
    store index_slot+0, 0 as u64
    jmp L_TURN_INPUT_LOOP_COND

L_TURN_INPUT_LOOP_COND:
    index = load index_slot+0 as u64
    has_next = ult index, count
    br has_next -> L_TURN_INPUT_LOOP_BODY, L_TURN_INPUT_LOOP_DONE

L_TURN_INPUT_LOOP_BODY:
    !has_next
    item_status = call @sa_json_array_get(input_node, index, &item_slot)
    item_ok = eq item_status, 0
    br item_ok -> L_TURN_INPUT_NOTIFY, L_TURN_INPUT_NEXT_BAD

L_TURN_INPUT_NOTIFY:
    !item_ok
    item_node = load item_slot+0 as ptr
    notify_status = call @notify_completed_item_node(&state_ptr, thread_id, turn_id, item_node)
    !notify_status
    item_free = call @sa_json_free(^item_node)
    !item_free
    !item_status
    jmp L_TURN_INPUT_NEXT

L_TURN_INPUT_NEXT_BAD:
    !item_ok
    !item_status
    jmp L_TURN_INPUT_NEXT

L_TURN_INPUT_NEXT:
    next_index = add index, 1
    store index_slot+0, next_index as u64
    !next_index
    !index
    jmp L_TURN_INPUT_LOOP_COND

L_TURN_INPUT_LOOP_DONE:
    !has_next
    !index
    input_free = call @sa_json_free(^input_node)
    !input_free
    params_free = call @sa_json_free(^params_node)
    !params_free
    root_free = call @sa_json_free(^root)
    !root_free
    !count_status
    !input_status
    !params_status
    !state_ptr
    !body
    !body_len
    !thread_id
    !turn_id
    return count

L_TURN_INPUT_BAD_COUNT:
    !count_ok
    !count_status
    input_free_bad = call @sa_json_free(^input_node)
    !input_free_bad
    params_free_bad_count = call @sa_json_free(^params_node)
    !params_free_bad_count
    root_free_bad_count = call @sa_json_free(^root)
    !root_free_bad_count
    !input_status
    !params_status
    !state_ptr
    !body
    !body_len
    !thread_id
    !turn_id
    return 0

L_TURN_INPUT_NO_INPUT:
    !input_ok
    params_free_no_input = call @sa_json_free(^params_node)
    !params_free_no_input
    root_free_no_input = call @sa_json_free(^root)
    !root_free_no_input
    !input_status
    !params_status
    !state_ptr
    !body
    !body_len
    !thread_id
    !turn_id
    return 0

L_TURN_INPUT_NO_PARAMS:
    !params_ok
    root_free_no_params = call @sa_json_free(^root)
    !root_free_no_params
    !params_status
    !state_ptr
    !body
    !body_len
    !thread_id
    !turn_id
    return 0

L_TURN_INPUT_NO_ROOT:
    !has_root
    !state_ptr
    !body
    !body_len
    !thread_id
    !turn_id
    return 0

@ffi_wrapper notify_injected_items_from_dom(&state_ptr: ptr, &body: ptr, body_len: u64, thread_id: u64, turn_id: u64) -> u64:
L_ENTRY:
    root = call @sa_json_parse(&body, body_len)
    has_root = ne root, 0
    br has_root -> L_INJECT_DOM_ROOT, L_INJECT_DOM_NO_ROOT

L_INJECT_DOM_ROOT:
    !has_root
    params_slot = stack_alloc 8
    params_status = call @sa_json_object_get(root, &FB_KEY_PARAMS, FB_KEY_PARAMS_LEN, &params_slot)
    params_ok = eq params_status, 0
    br params_ok -> L_INJECT_DOM_PARAMS, L_INJECT_DOM_NO_PARAMS

L_INJECT_DOM_PARAMS:
    !params_ok
    params_node = load params_slot+0 as ptr
    items_slot = stack_alloc 8
    items_status = call @sa_json_object_get(params_node, &FB_KEY_ITEMS, FB_KEY_ITEMS_LEN, &items_slot)
    items_ok = eq items_status, 0
    br items_ok -> L_INJECT_DOM_ITEMS, L_INJECT_DOM_NO_ITEMS

L_INJECT_DOM_ITEMS:
    !items_ok
    items_node = load items_slot+0 as ptr
    count_slot = stack_alloc 8
    count_status = call @sa_json_value_count(items_node, &count_slot)
    count_ok = eq count_status, 0
    br count_ok -> L_INJECT_DOM_COUNT, L_INJECT_DOM_BAD_COUNT

L_INJECT_DOM_COUNT:
    !count_ok
    count = load count_slot+0 as u64
    has_first = ugt count, 0
    br has_first -> L_INJECT_DOM_FIRST, L_INJECT_DOM_EMPTY

L_INJECT_DOM_FIRST:
    !has_first
    first_slot = stack_alloc 8
    first_status = call @sa_json_array_get(items_node, 0, &first_slot)
    first_ok = eq first_status, 0
    br first_ok -> L_INJECT_DOM_STRINGIFY, L_INJECT_DOM_FIRST_BAD

L_INJECT_DOM_STRINGIFY:
    !first_ok
    first_node = load first_slot+0 as ptr
    buffer_slot = stack_alloc 8
    stringify_status = call @sa_json_stringify(first_node, &buffer_slot)
    stringify_ok = eq stringify_status, 0
    br stringify_ok -> L_INJECT_DOM_NOTIFY, L_INJECT_DOM_STRINGIFY_BAD

L_INJECT_DOM_NOTIFY:
    !stringify_ok
    buffer = load buffer_slot+0 as ptr
    first_item_ptr = call @sa_json_buffer_data(&buffer)
    first_item_len = call @sa_json_buffer_len(&buffer)
    call @notify_timed_item(&state_ptr, &EV_ITEM_STARTED, EV_ITEM_STARTED_LEN, thread_id, turn_id, &first_item_ptr, first_item_len, &J_EVT_ITEM_STARTED_B1, J_EVT_ITEM_STARTED_B1_LEN)
    call @notify_injected_item(&state_ptr, &EV_RAW_ITEM_COMPLETED, EV_RAW_ITEM_COMPLETED_LEN, thread_id, turn_id, &first_item_ptr, first_item_len, &J_EVT_ITEM_RAW_B, J_EVT_ITEM_RAW_B_LEN)
    call @notify_timed_item(&state_ptr, &EV_ITEM_COMPLETED, EV_ITEM_COMPLETED_LEN, thread_id, turn_id, &first_item_ptr, first_item_len, &J_EVT_ITEM_COMPLETED_B1, J_EVT_ITEM_COMPLETED_B1_LEN)
    free_buffer = call @sa_json_buffer_free(^buffer)
    !free_buffer
    first_free = call @sa_json_free(^first_node)
    !first_free
    items_free = call @sa_json_free(^items_node)
    !items_free
    params_free = call @sa_json_free(^params_node)
    !params_free
    root_free = call @sa_json_free(^root)
    !root_free
    !first_item_ptr
    !first_item_len
    !stringify_status
    !first_status
    !count_status
    !params_status
    !items_status
    !state_ptr
    !body
    !body_len
    !thread_id
    !turn_id
    return count

L_INJECT_DOM_STRINGIFY_BAD:
    !stringify_ok
    !stringify_status
    first_free_bad = call @sa_json_free(^first_node)
    !first_free_bad
    !first_status
    items_free_stringify_bad = call @sa_json_free(^items_node)
    !items_free_stringify_bad
    params_free_stringify_bad = call @sa_json_free(^params_node)
    !params_free_stringify_bad
    root_free_stringify_bad = call @sa_json_free(^root)
    !root_free_stringify_bad
    !count_status
    !params_status
    !items_status
    !state_ptr
    !body
    !body_len
    !thread_id
    !turn_id
    return count

L_INJECT_DOM_FIRST_BAD:
    !first_ok
    !first_status
    items_free_first_bad = call @sa_json_free(^items_node)
    !items_free_first_bad
    params_free_first_bad = call @sa_json_free(^params_node)
    !params_free_first_bad
    root_free_first_bad = call @sa_json_free(^root)
    !root_free_first_bad
    !count_status
    !params_status
    !items_status
    !state_ptr
    !body
    !body_len
    !thread_id
    !turn_id
    return count

L_INJECT_DOM_EMPTY:
    !has_first
    jmp L_INJECT_DOM_RETURN_COUNT

L_INJECT_DOM_RETURN_COUNT:
    items_free2 = call @sa_json_free(^items_node)
    !items_free2
    params_free2 = call @sa_json_free(^params_node)
    !params_free2
    root_free2 = call @sa_json_free(^root)
    !root_free2
    !count_status
    !params_status
    !items_status
    !state_ptr
    !body
    !body_len
    !thread_id
    !turn_id
    return count

L_INJECT_DOM_BAD_COUNT:
    !count_ok
    !count_status
    items_free_bad = call @sa_json_free(^items_node)
    !items_free_bad
    params_free_bad_count = call @sa_json_free(^params_node)
    !params_free_bad_count
    root_free_bad_count = call @sa_json_free(^root)
    !root_free_bad_count
    !items_status
    !params_status
    !state_ptr
    !body
    !body_len
    !thread_id
    !turn_id
    return 0

L_INJECT_DOM_NO_ITEMS:
    !items_ok
    jmp L_INJECT_DOM_NO_ITEMS_AFTER

L_INJECT_DOM_NO_ITEMS_AFTER:
    params_free_no_items = call @sa_json_free(^params_node)
    !params_free_no_items
    root_free_no_items = call @sa_json_free(^root)
    !root_free_no_items
    !items_status
    !params_status
    !state_ptr
    !body
    !body_len
    !thread_id
    !turn_id
    return 0

L_INJECT_DOM_NO_PARAMS:
    !params_ok
    root_free_no_params = call @sa_json_free(^root)
    !root_free_no_params
    !params_status
    !state_ptr
    !body
    !body_len
    !thread_id
    !turn_id
    return 0

L_INJECT_DOM_NO_ROOT:
    !has_root
    !state_ptr
    !body
    !body_len
    !thread_id
    !turn_id
    return 0

@ffi_wrapper notify_fs_changed(&state_ptr: ptr, &watch_id_ptr: ptr, watch_id_len: u64, &path_ptr: ptr, path_len: u64) -> u32:
L_ENTRY:
    frame = call @rpc_builder_new()
    call @notify_frame_begin(&frame, &EV_FS_CHANGED, EV_FS_CHANGED_LEN)
    call @rpc_builder_append(&frame, &J_EVT_FS_CHANGED_A, J_EVT_FS_CHANGED_A_LEN)
    call @rpc_builder_append(&frame, &watch_id_ptr, watch_id_len)
    call @rpc_builder_append(&frame, &J_EVT_FS_CHANGED_B, J_EVT_FS_CHANGED_B_LEN)
    call @rpc_builder_append(&frame, &path_ptr, path_len)
    call @rpc_builder_append(&frame, &J_EVT_FS_CHANGED_C, J_EVT_FS_CHANGED_C_LEN)
    call @rpc_builder_append(&frame, &SSE_FRAME_END, SSE_FRAME_END_LEN)
    call @notify_push_frame(&state_ptr, ^frame)
    !state_ptr
    !watch_id_ptr
    !watch_id_len
    !path_ptr
    !path_len
    return 0

@ffi_wrapper notify_const_params(&state_ptr: ptr, &event_ptr: ptr, event_len: u64, &params_ptr: ptr, params_len: u64) -> u32:
L_ENTRY:
    frame = call @rpc_builder_new()
    call @notify_frame_begin(&frame, &event_ptr, event_len)
    call @rpc_builder_append(&frame, &params_ptr, params_len)
    call @rpc_builder_append(&frame, &SSE_FRAME_END, SSE_FRAME_END_LEN)
    call @notify_push_frame(&state_ptr, ^frame)
    !state_ptr
    !event_ptr
    !event_len
    !params_ptr
    !params_len
    return 0

