@ffi_wrapper build_remote_status_params(&body: ptr, body_len: u64, &status_ptr: ptr, status_len: u64) -> ^ptr:
L_ENTRY:
    result = call @rpc_builder_new()
    call @rpc_builder_append(&result, &J_REMOTE_STATUS_A, J_REMOTE_STATUS_A_LEN)
    call @rpc_builder_append(&result, &status_ptr, status_len)
    call @rpc_builder_append(&result, &J_REMOTE_STATUS_B, J_REMOTE_STATUS_B_LEN)
    call @rpc_builder_append_param_string_or_default(&result, &body, body_len, &J_SERVER_NAME_KEY, J_SERVER_NAME_KEY_LEN, &DEFAULT_LOCAL, DEFAULT_LOCAL_LEN)
    call @rpc_builder_append(&result, &J_REMOTE_STATUS_C, J_REMOTE_STATUS_C_LEN)
    call @rpc_builder_append_param_string_or_default(&result, &body, body_len, &J_INSTALLATION_ID_KEY, J_INSTALLATION_ID_KEY_LEN, &DEFAULT_INSTALLATION, DEFAULT_INSTALLATION_LEN)
    call @rpc_builder_append(&result, &J_REMOTE_STATUS_D, J_REMOTE_STATUS_D_LEN)
    call @rpc_builder_append_param_string_or_null(&result, &body, body_len, &J_ENVIRONMENT_ID_KEY, J_ENVIRONMENT_ID_KEY_LEN)
    call @rpc_builder_append(&result, &J_REMOTE_STATUS_E, J_REMOTE_STATUS_E_LEN)
    !body
    !body_len
    !status_ptr
    !status_len
    return result

@ffi_wrapper notify_remote_status(&state_ptr: ptr, &body: ptr, body_len: u64, &status_ptr: ptr, status_len: u64) -> u32:
L_ENTRY:
    result = call @build_remote_status_params(&body, body_len, &status_ptr, status_len)
    params_ptr = call @rpc_builder_data(&result)
    params_len = call @rpc_builder_len(&result)
    call @notify_const_params(&state_ptr, &EV_REMOTE_STATUS, EV_REMOTE_STATUS_LEN, &params_ptr, params_len)
    !params_ptr
    !params_len
    !result
    !state_ptr
    !body
    !body_len
    !status_ptr
    !status_len
    return 0

