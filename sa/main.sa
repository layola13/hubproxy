    !value
    return 0

@ffi_wrapper json_writer_write_u64_string(writer: ptr, value: u64) -> u32:
L_ENTRY:
    tmp = stack_alloc ID_BUF_SIZE
    len_slot = stack_alloc 8
    fmt_status = call @sa_fmt_u64_into(value, 10, tmp, ID_BUF_SIZE, &len_slot)
    !fmt_status
    fmt_len = load len_slot+0 as u64
    write_status = call @sa_json_writer_write_string(writer, &tmp, fmt_len)
    !write_status
    !fmt_len
    !writer
    !value
    return 0

@ffi_wrapper json_writer_field_nullable_string(writer: ptr, &key: ptr, key_len: u64, &value_ptr: ptr, value_len: u64, is_set: u8) -> u32:
L_ENTRY:
    has_value = eq is_set, 1
    br has_value -> L_JW_NULLABLE_STRING_VALUE, L_JW_NULLABLE_STRING_NULL

L_JW_NULLABLE_STRING_VALUE:
    !has_value
    field_status = call @sa_json_writer_field_string(writer, &key, key_len, &value_ptr, value_len)
    !field_status
    !writer
    !key
    !key_len
    !value_ptr
    !value_len
    !is_set
    return 0

L_JW_NULLABLE_STRING_NULL:
    !has_value
    null_status = call @sa_json_writer_field_null(writer, &key, key_len)
    !null_status
    !writer
    !key
    !key_len
    !value_ptr
    !value_len
    !is_set
    return 0

@ffi_wrapper json_writer_field_nullable_thread_id_string(writer: ptr, &key: ptr, key_len: u64, &state_ptr: ptr, thread_id: u64) -> u32:
L_ENTRY:
    has_value = ne thread_id, 0
    br has_value -> L_JW_NULLABLE_TID_VALUE, L_JW_NULLABLE_TID_NULL

L_JW_NULLABLE_TID_VALUE:
    !has_value
    field_status = call @json_writer_field_thread_id_string(writer, &key, key_len, &state_ptr, thread_id)
    !field_status
    !writer
    !key
    !key_len
    !state_ptr
    !thread_id
    return 0

L_JW_NULLABLE_TID_NULL:
    !has_value
    null_status = call @sa_json_writer_field_null(writer, &key, key_len)
    !null_status
    !writer
    !key
    !key_len
    !state_ptr
    !thread_id
    return 0

@ffi_wrapper json_writer_write_thread_id_string(writer: ptr, &state_ptr: ptr, thread_id: u64) -> u32:
L_ENTRY:
    slot = call @state_thread_find(&state_ptr, thread_id)
    missing = eq slot, 0
    br missing -> L_JW_WRITE_TID_NUMERIC_MISSING, L_JW_WRITE_TID_SLOT

L_JW_WRITE_TID_SLOT:
    !missing
    stored_key_len = load slot+THR_KEY_LEN as u64
    has_key = ugt stored_key_len, 0
    br has_key -> L_JW_WRITE_TID_KEY, L_JW_WRITE_TID_NUMERIC_SLOT

L_JW_WRITE_TID_KEY:
    !has_key
    stored_key_ptr = ptr_add slot, THR_KEY
    write_status = call @sa_json_writer_write_string(writer, &stored_key_ptr, stored_key_len)
    !write_status
    !stored_key_ptr
    !stored_key_len
    !slot
    !writer
    !state_ptr
    !thread_id
    return 0

L_JW_WRITE_TID_NUMERIC_SLOT:
    !has_key
    !stored_key_len
    !slot
    jmp L_JW_WRITE_TID_NUMERIC

L_JW_WRITE_TID_NUMERIC_MISSING:
    !missing
    !slot
    jmp L_JW_WRITE_TID_NUMERIC

L_JW_WRITE_TID_NUMERIC:
    write_status2 = call @json_writer_write_u64_string(writer, thread_id)
    !write_status2
    !writer
    !state_ptr
    !thread_id
    return 0

@ffi_wrapper json_writer_field_mode_value(writer: ptr, &key: ptr, key_len: u64, mode: u8) -> u32:
L_ENTRY:
    is_plan = eq mode, 1
    br is_plan -> L_JW_MODE_PLAN, L_JW_MODE_GOAL_CHECK

L_JW_MODE_PLAN:
    !is_plan
    field_plan = call @sa_json_writer_field_string(writer, &key, key_len, &FB_VALUE_PLAN, FB_VALUE_PLAN_LEN)
    !field_plan
    !writer
    !key
    !key_len
    !mode
    return 0

L_JW_MODE_GOAL_CHECK:
    !is_plan
    is_goal = eq mode, 2
    br is_goal -> L_JW_MODE_GOAL, L_JW_MODE_CODE_CHECK

L_JW_MODE_GOAL:
    !is_goal
    field_goal = call @sa_json_writer_field_string(writer, &key, key_len, &FB_VALUE_GOAL, FB_VALUE_GOAL_LEN)
    !field_goal
    !writer
    !key
    !key_len
    !mode
    return 0

L_JW_MODE_CODE_CHECK:
    !is_goal
    is_code = eq mode, 3
    br is_code -> L_JW_MODE_CODE, L_JW_MODE_NULL

L_JW_MODE_CODE:
    !is_code
    field_code = call @sa_json_writer_field_string(writer, &key, key_len, &FB_VALUE_CODE, FB_VALUE_CODE_LEN)
    !field_code
    !writer
    !key
    !key_len
    !mode
    return 0

L_JW_MODE_NULL:
    !is_code
    field_null = call @sa_json_writer_field_null(writer, &key, key_len)
    !field_null
    !writer
    !key
    !key_len
    !mode
    return 0

@ffi_wrapper json_writer_field_mode_text_or_value(writer: ptr, &key: ptr, key_len: u64, mode: u8, &mode_ptr: ptr, mode_len: u64) -> u32:
L_ENTRY:
    has_mode_text = ugt mode_len, 0
    br has_mode_text -> L_JW_MODE_TEXT, L_JW_MODE_VALUE

L_JW_MODE_TEXT:
    !has_mode_text
    field_text = call @sa_json_writer_field_string(writer, &key, key_len, &mode_ptr, mode_len)
    !field_text
    !writer
    !key
    !key_len
    !mode
    !mode_ptr
    !mode_len
    return 0

L_JW_MODE_VALUE:
    !has_mode_text
    field_value = call @json_writer_field_mode_value(writer, &key, key_len, mode)
    !field_value
    !writer
    !key
    !key_len
    !mode
    !mode_ptr
    !mode_len
    return 0

@ffi_wrapper json_writer_field_thread_git_info(writer: ptr, &state_ptr: ptr, thread_id: u64) -> u32:
L_ENTRY:
    slot = call @state_thread_find(&state_ptr, thread_id)
    missing = eq slot, 0
    br missing -> L_JW_GITINFO_NULL_MISSING, L_JW_GITINFO_SLOT

L_JW_GITINFO_SLOT:
    !missing
    git_set = load slot+THR_GIT_SET as u8
    has_git = eq git_set, 1
    br has_git -> L_JW_GITINFO_VALUE, L_JW_GITINFO_NULL_SLOT

L_JW_GITINFO_VALUE:
    !has_git
    git_ptr = load slot+THR_GIT_PTR as ptr
    git_len = load slot+THR_GIT_LEN as u64
    has_len = ugt git_len, 0
    br has_len -> L_JW_GITINFO_PARSE, L_JW_GITINFO_VALUE_NULL

L_JW_GITINFO_PARSE:
    !has_len
    git_node = call @sa_json_parse(&git_ptr, git_len)
    has_node = ne git_node, 0
    br has_node -> L_JW_GITINFO_NODE, L_JW_GITINFO_BAD

L_JW_GITINFO_NODE:
    !has_node
    field_status = call @sa_json_writer_field_node(writer, &JSON_KEY_GIT_INFO, JSON_KEY_GIT_INFO_LEN, git_node)
    node_free = call @sa_json_free(^git_node)
    !node_free
    !field_status
    !git_ptr
    !git_len
    !git_set
    !slot
    !writer
    !state_ptr
    !thread_id
    return 0

L_JW_GITINFO_BAD:
    !has_node
    !git_node
    jmp L_JW_GITINFO_VALUE_NULL_AFTER

L_JW_GITINFO_VALUE_NULL:
    !has_len
    jmp L_JW_GITINFO_VALUE_NULL_AFTER

L_JW_GITINFO_VALUE_NULL_AFTER:
    null_status_value = call @sa_json_writer_field_null(writer, &JSON_KEY_GIT_INFO, JSON_KEY_GIT_INFO_LEN)
    !null_status_value
    !git_ptr
    !git_len
    !git_set
    !slot
    !writer
    !state_ptr
    !thread_id
    return 0

L_JW_GITINFO_NULL_SLOT:
    !has_git
    null_status_slot = call @sa_json_writer_field_null(writer, &JSON_KEY_GIT_INFO, JSON_KEY_GIT_INFO_LEN)
    !null_status_slot
    !git_set
    !slot
    !writer
    !state_ptr
    !thread_id
    return 0

L_JW_GITINFO_NULL_MISSING:
    !missing
    !slot
    null_status_missing = call @sa_json_writer_field_null(writer, &JSON_KEY_GIT_INFO, JSON_KEY_GIT_INFO_LEN)
    !null_status_missing
    !writer
    !state_ptr
    !thread_id
    return 0

@ffi_wrapper json_writer_field_items_or_empty(writer: ptr, &key: ptr, key_len: u64, &items_ptr: ptr, items_len: u64) -> u32:
L_ENTRY:
    has_items = ugt items_len, 0
    br has_items -> L_JW_ITEMS_PARSE, L_JW_ITEMS_EMPTY

L_JW_ITEMS_PARSE:
    !has_items
    items_node = call @sa_json_parse(&items_ptr, items_len)
    has_node = ne items_node, 0
    br has_node -> L_JW_ITEMS_NODE, L_JW_ITEMS_BAD

L_JW_ITEMS_NODE:
    !has_node
    field_status = call @sa_json_writer_field_node(writer, &key, key_len, items_node)
    node_free = call @sa_json_free(^items_node)
    !node_free
    !field_status
    !items_ptr
    !items_len
    !writer
    !key
    !key_len
    return 0

L_JW_ITEMS_BAD:
    !has_node
    !items_node
    jmp L_JW_ITEMS_EMPTY_AFTER

L_JW_ITEMS_EMPTY:
    !has_items
    jmp L_JW_ITEMS_EMPTY_AFTER

L_JW_ITEMS_EMPTY_AFTER:
    field_status_empty = call @sa_json_writer_object_field(writer, &key, key_len)
    begin_status_empty = call @sa_json_writer_begin_array(writer)
    end_status_empty = call @sa_json_writer_end_array(writer)
    !end_status_empty
    !begin_status_empty
    !field_status_empty
    !items_ptr
    !items_len
    !writer
    !key
    !key_len
    return 0

@ffi_wrapper json_writer_field_raw_node_or_null(writer: ptr, &key: ptr, key_len: u64, &raw_ptr: ptr, raw_len: u64) -> u32:
L_ENTRY:
    has_raw = ugt raw_len, 0
    br has_raw -> L_JW_RAW_NODE_PARSE, L_JW_RAW_NODE_NULL

L_JW_RAW_NODE_PARSE:
    !has_raw
    node = call @sa_json_parse(&raw_ptr, raw_len)
    has_node = ne node, 0
    br has_node -> L_JW_RAW_NODE_WRITE, L_JW_RAW_NODE_BAD

L_JW_RAW_NODE_WRITE:
    !has_node
    field_status = call @sa_json_writer_field_node(writer, &key, key_len, node)
    node_free = call @sa_json_free(^node)
    !node_free
    !field_status
    !raw_ptr
    !raw_len
    !writer
    !key
    !key_len
    return 0

L_JW_RAW_NODE_BAD:
    !has_node
    !node
    jmp L_JW_RAW_NODE_NULL_AFTER

L_JW_RAW_NODE_NULL:
    !has_raw
    jmp L_JW_RAW_NODE_NULL_AFTER

L_JW_RAW_NODE_NULL_AFTER:
    null_status = call @sa_json_writer_field_null(writer, &key, key_len)
    !null_status
    !raw_ptr
    !raw_len
    !writer
    !key
    !key_len
    return 0

@ffi_wrapper json_writer_write_thread_object(writer: ptr, &state_ptr: ptr, tid: u64, forked_from_id: u64, &preview_ptr: ptr, preview_len: u64, &provider_ptr: ptr, provider_len: u64, ephemeral: u8, &model_ptr: ptr, model_len: u64, &dir_ptr: ptr, dir_len: u64, &name_ptr: ptr, name_len: u64, name_set: u8, include_empty_turns: u8) -> u32:
L_ENTRY:
    begin_status = call @sa_json_writer_begin_object(writer)
    id_status = call @json_writer_field_thread_id_string(writer, &RPC_KEY_ID, RPC_KEY_ID_LEN, &state_ptr, tid)
    session_status = call @json_writer_field_thread_id_string(writer, &JSON_KEY_SESSION_ID, JSON_KEY_SESSION_ID_LEN, &state_ptr, tid)
    fork_status = call @json_writer_field_nullable_thread_id_string(writer, &JSON_KEY_FORKED_FROM_ID, JSON_KEY_FORKED_FROM_ID_LEN, &state_ptr, forked_from_id)
    preview_status = call @sa_json_writer_field_string(writer, &JSON_KEY_PREVIEW, JSON_KEY_PREVIEW_LEN, &preview_ptr, preview_len)
    ephemeral_status = call @sa_json_writer_field_bool(writer, &JSON_KEY_EPHEMERAL, JSON_KEY_EPHEMERAL_LEN, ephemeral)
    provider_status = call @sa_json_writer_field_string(writer, &JSON_KEY_MODEL_PROVIDER, JSON_KEY_MODEL_PROVIDER_LEN, &provider_ptr, provider_len)
    model_status = call @sa_json_writer_field_string(writer, &JSON_KEY_MODEL, JSON_KEY_MODEL_LEN, &model_ptr, model_len)
    now_i = call @sa_time_unix_s()
    created_status = call @sa_json_writer_field_i64(writer, &JSON_KEY_CREATED_AT, JSON_KEY_CREATED_AT_LEN, now_i)
    updated_status = call @sa_json_writer_field_i64(writer, &JSON_KEY_UPDATED_AT, JSON_KEY_UPDATED_AT_LEN, now_i)
    status_field = call @sa_json_writer_object_field(writer, &JSON_KEY_STATUS, JSON_KEY_STATUS_LEN)
    status_begin = call @sa_json_writer_begin_object(writer)
    type_status = call @sa_json_writer_field_string(writer, &FB_KEY_TYPE, FB_KEY_TYPE_LEN, &JSON_VALUE_IDLE, JSON_VALUE_IDLE_LEN)
    status_end = call @sa_json_writer_end_object(writer)
    path_status = call @sa_json_writer_field_null(writer, &JSON_KEY_PATH, JSON_KEY_PATH_LEN)
    cwd_status = call @sa_json_writer_field_string(writer, &JSON_KEY_CWD, JSON_KEY_CWD_LEN, &dir_ptr, dir_len)
    cli_status = call @sa_json_writer_field_string(writer, &JSON_KEY_CLI_VERSION, JSON_KEY_CLI_VERSION_LEN, &JSON_VALUE_HUBPROXY_CLI, JSON_VALUE_HUBPROXY_CLI_LEN)
    source_status = call @sa_json_writer_field_string(writer, &JSON_KEY_SOURCE, JSON_KEY_SOURCE_LEN, &JSON_VALUE_APP_SERVER, JSON_VALUE_APP_SERVER_LEN)
    thread_source_status = call @sa_json_writer_field_null(writer, &JSON_KEY_THREAD_SOURCE, JSON_KEY_THREAD_SOURCE_LEN)
    nickname_status = call @sa_json_writer_field_null(writer, &JSON_KEY_AGENT_NICKNAME, JSON_KEY_AGENT_NICKNAME_LEN)
    role_status = call @sa_json_writer_field_null(writer, &JSON_KEY_AGENT_ROLE, JSON_KEY_AGENT_ROLE_LEN)
    git_status = call @json_writer_field_thread_git_info(writer, &state_ptr, tid)
    name_status = call @json_writer_field_nullable_string(writer, &JSON_KEY_NAME, JSON_KEY_NAME_LEN, &name_ptr, name_len, name_set)
    include_turns = eq include_empty_turns, 1
    br include_turns -> L_JW_THREAD_WITH_EMPTY_TURNS, L_JW_THREAD_DYNAMIC_CHECK

L_JW_THREAD_WITH_EMPTY_TURNS:
    !include_turns
    turns_status = call @json_writer_field_empty_array(writer, &JSON_KEY_TURNS, JSON_KEY_TURNS_LEN)
    !turns_status
    jmp L_JW_THREAD_CLOSE_AFTER_TURNS

L_JW_THREAD_DYNAMIC_CHECK:
    !include_turns
    dynamic_turns = eq include_empty_turns, 2
    br dynamic_turns -> L_JW_THREAD_WITH_DYNAMIC_TURNS, L_JW_THREAD_CLOSE

L_JW_THREAD_WITH_DYNAMIC_TURNS:
    !dynamic_turns
    dynamic_status = call @json_writer_write_thread_turns_array(writer, &state_ptr, tid)
    !dynamic_status
    jmp L_JW_THREAD_CLOSE_AFTER_TURNS

L_JW_THREAD_CLOSE:
    !dynamic_turns
    jmp L_JW_THREAD_CLOSE_AFTER_TURNS

L_JW_THREAD_CLOSE_AFTER_TURNS:
    end_status = call @sa_json_writer_end_object(writer)
    !end_status
    !name_status
    !git_status
    !role_status
    !nickname_status
    !thread_source_status
    !source_status
    !cli_status
    !cwd_status
    !path_status
    !status_end
    !type_status
    !status_begin
    !status_field
    !updated_status
    !created_status
    !now_i
    !model_status
    !provider_status
    !ephemeral_status
    !preview_status
    !fork_status
    !session_status
    !id_status
    !begin_status
    !writer
    !state_ptr
    !tid
    !forked_from_id
    !preview_ptr
    !preview_len
    !provider_ptr
    !provider_len
    !ephemeral
    !model_ptr
    !model_len
    !dir_ptr
    !dir_len
    !name_ptr
    !name_len
    !name_set
    !include_empty_turns
    return 0

@ffi_wrapper json_writer_write_turn_status_string(writer: ptr, status: u8) -> u32:
L_ENTRY:
    is_interrupted = eq status, 2
    br is_interrupted -> L_JW_TURN_STATUS_INTERRUPTED, L_JW_TURN_STATUS_DONE_CHECK

L_JW_TURN_STATUS_INTERRUPTED:
    !is_interrupted
    write_interrupted = call @sa_json_writer_write_string(writer, &J_TURN_STATUS_INTERRUPTED, J_TURN_STATUS_INTERRUPTED_LEN)
    !write_interrupted
    !writer
    !status
    return 0

L_JW_TURN_STATUS_DONE_CHECK:
    !is_interrupted
    is_done = eq status, 0
    br is_done -> L_JW_TURN_STATUS_COMPLETED, L_JW_TURN_STATUS_IN_PROGRESS

L_JW_TURN_STATUS_COMPLETED:
    !is_done
    write_completed = call @sa_json_writer_write_string(writer, &J_TURN_STATUS_COMPLETED, J_TURN_STATUS_COMPLETED_LEN)
    !write_completed
    !writer
    !status
    return 0

L_JW_TURN_STATUS_IN_PROGRESS:
    !is_done
    write_progress = call @sa_json_writer_write_string(writer, &J_TURN_STATUS_IN_PROGRESS, J_TURN_STATUS_IN_PROGRESS_LEN)
    !write_progress
    !writer
    !status
    return 0

@ffi_wrapper json_writer_write_turn_completion_fields(writer: ptr, status: u8, completed_ts: u64) -> u32:
L_ENTRY:
    is_open = eq status, 1
    br is_open -> L_JW_TURN_OPEN_FIELDS, L_JW_TURN_DONE_FIELDS

L_JW_TURN_OPEN_FIELDS:
    !is_open
    completed_null = call @sa_json_writer_field_null(writer, &JSON_KEY_COMPLETED_AT, JSON_KEY_COMPLETED_AT_LEN)
    duration_null = call @sa_json_writer_field_null(writer, &JSON_KEY_DURATION_MS, JSON_KEY_DURATION_MS_LEN)
    error_null = call @sa_json_writer_field_null(writer, &JSON_KEY_ERROR, JSON_KEY_ERROR_LEN)
    !error_null
    !duration_null
    !completed_null
    !writer
    !status
    !completed_ts
    return 0

L_JW_TURN_DONE_FIELDS:
    !is_open
    completed_i = bitcast completed_ts as i64
    completed_value = call @sa_json_writer_field_i64(writer, &JSON_KEY_COMPLETED_AT, JSON_KEY_COMPLETED_AT_LEN, completed_i)
    is_completed = eq status, 0
    br is_completed -> L_JW_TURN_DONE_DURATION_ZERO, L_JW_TURN_DONE_DURATION_NULL

L_JW_TURN_DONE_DURATION_ZERO:
    !is_completed
    duration_value = call @sa_json_writer_field_i64(writer, &JSON_KEY_DURATION_MS, JSON_KEY_DURATION_MS_LEN, 0)
    jmp L_JW_TURN_DONE_ERROR

L_JW_TURN_DONE_DURATION_NULL:
    !is_completed
    duration_value = call @sa_json_writer_field_null(writer, &JSON_KEY_DURATION_MS, JSON_KEY_DURATION_MS_LEN)
    jmp L_JW_TURN_DONE_ERROR

L_JW_TURN_DONE_ERROR:
    error_null_done = call @sa_json_writer_field_null(writer, &JSON_KEY_ERROR, JSON_KEY_ERROR_LEN)
    !error_null_done
    !duration_value
    !completed_value
    !completed_i
    !writer
    !status
    !completed_ts
    return 0

@ffi_wrapper json_writer_write_turn_object(writer: ptr, turn_id: u64, status: u8, mode: u8, created_ts: u64, updated_ts: u64, completed_ts: u64, &mode_ptr: ptr, mode_len: u64, &items_ptr: ptr, items_len: u64) -> u32:
L_ENTRY:
    begin_status = call @sa_json_writer_begin_object(writer)
    id_status = call @json_writer_field_u64_string(writer, &RPC_KEY_ID, RPC_KEY_ID_LEN, turn_id)
    items_status = call @json_writer_field_items_or_empty(writer, &JSON_KEY_ITEMS, JSON_KEY_ITEMS_LEN, &items_ptr, items_len)
    status_field = call @sa_json_writer_object_field(writer, &JSON_KEY_STATUS, JSON_KEY_STATUS_LEN)
    status_write = call @json_writer_write_turn_status_string(writer, status)
    created_i = bitcast created_ts as i64
    updated_i = bitcast updated_ts as i64
    created_status = call @sa_json_writer_field_i64(writer, &JSON_KEY_CREATED_AT, JSON_KEY_CREATED_AT_LEN, created_i)
    updated_status = call @sa_json_writer_field_i64(writer, &JSON_KEY_UPDATED_AT, JSON_KEY_UPDATED_AT_LEN, updated_i)
    mode_status = call @json_writer_field_mode_text_or_value(writer, &FB_KEY_COLLAB_MODE_KIND, FB_KEY_COLLAB_MODE_KIND_LEN, mode, &mode_ptr, mode_len)
    view_status = call @sa_json_writer_field_string(writer, &JSON_KEY_ITEMS_VIEW, JSON_KEY_ITEMS_VIEW_LEN, &JSON_VALUE_FULL, JSON_VALUE_FULL_LEN)
    started_status = call @sa_json_writer_field_i64(writer, &JSON_KEY_STARTED_AT, JSON_KEY_STARTED_AT_LEN, created_i)
    completion_status = call @json_writer_write_turn_completion_fields(writer, status, completed_ts)
    end_status = call @sa_json_writer_end_object(writer)
    !end_status
    !completion_status
    !started_status
    !view_status
    !mode_status
    !updated_status
    !created_status
    !updated_i
    !created_i
    !status_write
    !status_field
    !items_status
    !id_status
    !begin_status
    !writer
    !turn_id
    !status
    !mode
    !created_ts
    !updated_ts
    !completed_ts
    !mode_ptr
    !mode_len
    !items_ptr
    !items_len
    return 0

@ffi_wrapper json_writer_write_turn_object_mode(writer: ptr, turn_id: u64, mode: u8) -> u32:
L_ENTRY:
    empty_ptr = &EMPTY_TEXT
    now_i = call @sa_time_unix_s()
    now_u = bitcast now_i as u64
    status = call @json_writer_write_turn_object(writer, turn_id, 1, mode, now_u, now_u, 0, &empty_ptr, 0, &empty_ptr, 0)
    !status
    !now_u
    !now_i
    !empty_ptr
    !writer
    !turn_id
    !mode
    return 0

@ffi_wrapper json_writer_write_thread_envelope_prefix(writer: ptr, &body: ptr, body_len: u64, &model_ptr: ptr, model_len: u64, &provider_ptr: ptr, provider_len: u64, &dir_ptr: ptr, dir_len: u64) -> u32:
L_ENTRY:
    model_status = call @sa_json_writer_field_string(writer, &JSON_KEY_MODEL, JSON_KEY_MODEL_LEN, &model_ptr, model_len)
    provider_status = call @sa_json_writer_field_string(writer, &JSON_KEY_MODEL_PROVIDER, JSON_KEY_MODEL_PROVIDER_LEN, &provider_ptr, provider_len)
    service_status = call @sa_json_writer_field_null(writer, &JSON_KEY_SERVICE_TIER, JSON_KEY_SERVICE_TIER_LEN)
    cwd_status = call @sa_json_writer_field_string(writer, &JSON_KEY_CWD, JSON_KEY_CWD_LEN, &dir_ptr, dir_len)
    instruction_status = call @json_writer_field_empty_array(writer, &JSON_KEY_INSTRUCTION_SOURCES, JSON_KEY_INSTRUCTION_SOURCES_LEN)
    approval_status = call @json_writer_field_param_string_or_default(writer, &JSON_KEY_APPROVAL_POLICY, JSON_KEY_APPROVAL_POLICY_LEN, &body, body_len, &J_APPROVAL_POLICY_KEY, J_APPROVAL_POLICY_KEY_LEN, &DEFAULT_APPROVAL, DEFAULT_APPROVAL_LEN, 0)
    reviewer_status = call @json_writer_field_param_string_or_default(writer, &JSON_KEY_APPROVALS_REVIEWER, JSON_KEY_APPROVALS_REVIEWER_LEN, &body, body_len, &J_APPROVALS_REVIEWER_KEY, J_APPROVALS_REVIEWER_KEY_LEN, &DEFAULT_REVIEWER, DEFAULT_REVIEWER_LEN, 0)
    sandbox_status = call @json_writer_field_param_string_or_default(writer, &JSON_KEY_SANDBOX, JSON_KEY_SANDBOX_LEN, &body, body_len, &J_SANDBOX_KEY, J_SANDBOX_KEY_LEN, &DEFAULT_SANDBOX, DEFAULT_SANDBOX_LEN, 0)
    reasoning_status = call @sa_json_writer_field_null(writer, &JSON_KEY_REASONING_EFFORT, JSON_KEY_REASONING_EFFORT_LEN)
    profile_status = call @sa_json_writer_field_null(writer, &JSON_KEY_ACTIVE_PERMISSION_PROFILE, JSON_KEY_ACTIVE_PERMISSION_PROFILE_LEN)
    !profile_status
    !reasoning_status
    !sandbox_status
