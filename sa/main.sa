    !thread_id
    !state_ptr
    !req
    return 0

@ffi_wrapper send_rpc_thread_archive(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, thread_id: u64) -> u32:
L_ENTRY:
    arch_status = call @state_thread_archive(&state_ptr, thread_id)
    ok = eq arch_status, 0
    !arch_status
    br ok -> L_ARCH_OK, L_ARCH_NOT_FOUND

L_ARCH_OK:
    !ok
    call @notify_thread_id_only(&state_ptr, &EV_THREAD_ARCHIVED, EV_THREAD_ARCHIVED_LEN, thread_id)
    call @notify_thread_id_only(&state_ptr, &EV_THREAD_CLOSED, EV_THREAD_CLOSED_LEN, thread_id)
    result = call @rpc_builder_new()
    call @rpc_builder_append(&result, &J_ARCHIVE_A, J_ARCHIVE_A_LEN)
    call @rpc_builder_append_thread_id_inner(&result, &state_ptr, thread_id)
    call @rpc_builder_append(&result, &J_ARCHIVE_B, J_ARCHIVE_B_LEN)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result)
    !thread_id
    !state_ptr
    !req
    return 0

L_ARCH_NOT_FOUND:
    !ok
    call @send_error_with_id(&req, 404, &id_ptr, id_len, &J_ERR_THREAD_NOT_FOUND, J_ERR_THREAD_NOT_FOUND_LEN)
    !thread_id
    !state_ptr
    !req
    return 0

@ffi_wrapper send_rpc_thread_unarchive(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, thread_id: u64) -> u32:
L_ENTRY:
    unarch_status = call @state_thread_unarchive(&state_ptr, thread_id)
    ok = eq unarch_status, 0
    !unarch_status
    br ok -> L_UNARCH_OK, L_UNARCH_NOT_FOUND

L_UNARCH_OK:
    !ok
    call @notify_thread_id_only(&state_ptr, &EV_THREAD_UNARCHIVED, EV_THREAD_UNARCHIVED_LEN, thread_id)
    call @notify_thread_status_idle(&state_ptr, thread_id)
    call @send_rpc_thread_read(&req, &id_ptr, id_len, &state_ptr, thread_id, 0)
    !thread_id
    !state_ptr
    !req
    return 0

L_UNARCH_NOT_FOUND:
    !ok
    call @send_error_with_id(&req, 404, &id_ptr, id_len, &J_ERR_THREAD_NOT_FOUND, J_ERR_THREAD_NOT_FOUND_LEN)
    !thread_id
    !state_ptr
    !req
    return 0

@ffi_wrapper send_rpc_thread_name_set(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    thread_id = call @rpc_resolve_thread_id(&state_ptr, &body, body_len, 0)
    name_ptr_slot = stack_alloc 8
    name_len_slot = stack_alloc 8
    name_status = call @rpc_extract_string_after(&body, body_len, &J_NAME_KEY, J_NAME_KEY_LEN, &name_ptr_slot, &name_len_slot)
    has_name = eq name_status, 1
    !name_status
    br has_name -> L_NAME_SET, L_NAME_CLEAR

L_NAME_SET:
    !has_name
    name_ptr = load name_ptr_slot+0 as ptr
    name_len = load name_len_slot+0 as u64
    set_status = call @state_thread_set_name(&state_ptr, thread_id, &name_ptr, name_len)
    set_ok = eq set_status, 0
    !set_status
    br set_ok -> L_NAME_SET_RESP, L_NAME_SET_NOT_FOUND

L_NAME_CLEAR:
    !has_name
    clear_status = call @state_thread_clear_name(&state_ptr, thread_id)
    clear_ok = eq clear_status, 0
    !clear_status
    br clear_ok -> L_NAME_CLEAR_RESP, L_NAME_CLEAR_NOT_FOUND

L_NAME_SET_RESP:
    !set_ok
    call @notify_thread_name_updated(&state_ptr, thread_id, &name_ptr, name_len, 1)
    result = call @rpc_builder_new()
    call @rpc_builder_append(&result, &J_THREAD_NAME_A, J_THREAD_NAME_A_LEN)
    call @rpc_builder_append_thread_id_inner(&result, &state_ptr, thread_id)
    call @rpc_builder_append(&result, &J_THREAD_NAME_B, J_THREAD_NAME_B_LEN)
    call @rpc_builder_append_nullable_string(&result, &name_ptr, name_len, 1)
    call @rpc_builder_append(&result, &J_EVT_CLOSE, J_EVT_CLOSE_LEN)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result)
    !name_ptr
    !name_len
    !thread_id
    !state_ptr
    !body
    !body_len
    !req
    return 0

L_NAME_CLEAR_RESP:
    !clear_ok
    call @notify_thread_name_updated(&state_ptr, thread_id, &EMPTY_TEXT, EMPTY_TEXT_LEN, 0)
    result2 = call @rpc_builder_new()
    call @rpc_builder_append(&result2, &J_THREAD_NAME_A, J_THREAD_NAME_A_LEN)
    call @rpc_builder_append_thread_id_inner(&result2, &state_ptr, thread_id)
    call @rpc_builder_append(&result2, &J_THREAD_NAME_B, J_THREAD_NAME_B_LEN)
    call @rpc_builder_append(&result2, &J_NULL, J_NULL_LEN)
    call @rpc_builder_append(&result2, &J_EVT_CLOSE, J_EVT_CLOSE_LEN)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result2)
    !thread_id
    !state_ptr
    !body
    !body_len
    !req
    return 0

L_NAME_SET_NOT_FOUND:
    !set_ok
    !name_ptr
    !name_len
    call @send_error_with_id(&req, 404, &id_ptr, id_len, &J_ERR_THREAD_NOT_FOUND, J_ERR_THREAD_NOT_FOUND_LEN)
    !thread_id
    !state_ptr
    !body
    !body_len
    !req
    return 0

L_NAME_CLEAR_NOT_FOUND:
    !clear_ok
    call @send_error_with_id(&req, 404, &id_ptr, id_len, &J_ERR_THREAD_NOT_FOUND, J_ERR_THREAD_NOT_FOUND_LEN)
    !thread_id
    !state_ptr
    !body
    !body_len
    !req
    return 0

@ffi_wrapper send_rpc_thread_metadata_update(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    thread_id = call @rpc_resolve_thread_id(&state_ptr, &body, body_len, 0)
    slot = call @state_thread_find(&state_ptr, thread_id)
    missing = eq slot, 0
    br missing -> L_META_NOT_FOUND, L_META_SLOT

L_META_SLOT:
    !missing
    preview_ptr_slot = stack_alloc 8
    preview_len_slot = stack_alloc 8
    preview_status = call @rpc_extract_string_after(&body, body_len, &J_PREVIEW_KEY, J_PREVIEW_KEY_LEN, &preview_ptr_slot, &preview_len_slot)
    has_preview = eq preview_status, 1
    !preview_status
    !slot
    br has_preview -> L_META_SET, L_META_CHECK_NULL

L_META_SET:
    !has_preview
    preview_ptr = load preview_ptr_slot+0 as ptr
    preview_len = load preview_len_slot+0 as u64
    set_status = call @state_thread_set_preview(&state_ptr, thread_id, &preview_ptr, preview_len)
    !set_status
    !preview_ptr
    !preview_len
    jmp L_META_READ

L_META_CHECK_NULL:
    !has_preview
    null_idx = call @sa_bytes_find(&body, body_len, &J_PREVIEW_NULL, J_PREVIEW_NULL_LEN)
    has_null = sge null_idx, 0
    !null_idx
    br has_null -> L_META_CLEAR, L_META_READ

L_META_CLEAR:
    !has_null
    clear_status = call @state_thread_clear_preview(&state_ptr, thread_id)
    !clear_status
    jmp L_META_READ

L_META_READ:
    git_status = call @apply_thread_git_info_from_body(&state_ptr, thread_id, &body, body_len)
    !git_status
    call @send_rpc_thread_read(&req, &id_ptr, id_len, &state_ptr, thread_id, 0)
    !thread_id
    !body
    !body_len
    !state_ptr
    !req
    return 0

L_META_NOT_FOUND:
    !missing
    !slot
    call @send_error_with_id(&req, 404, &id_ptr, id_len, &J_ERR_THREAD_NOT_FOUND, J_ERR_THREAD_NOT_FOUND_LEN)
    !thread_id
    !body
    !body_len
    !state_ptr
    !req
    return 0

@ffi_wrapper apply_thread_git_info_from_body(&state_ptr: ptr, thread_id: u64, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    root = call @sa_json_parse(&body, body_len)
    has_root = ne root, 0
    br has_root -> L_GIT_ROOT, L_GIT_NO_ROOT

L_GIT_ROOT:
    !has_root
    params_slot = stack_alloc 8
    params_status = call @sa_json_object_get(root, &FB_KEY_PARAMS, FB_KEY_PARAMS_LEN, &params_slot)
    params_ok = eq params_status, 0
    br params_ok -> L_GIT_PARAMS, L_GIT_NO_PARAMS

L_GIT_PARAMS:
    !params_ok
    !params_status
    params_node = load params_slot+0 as ptr
    git_slot = stack_alloc 8
    git_status = call @sa_json_object_get(params_node, &FB_KEY_GITINFO, FB_KEY_GITINFO_LEN, &git_slot)
    git_ok = eq git_status, 0
    br git_ok -> L_GIT_VALUE, L_GIT_NO_VALUE

L_GIT_VALUE:
    !git_ok
    !git_status
    git_node = load git_slot+0 as ptr
    git_kind = call @sa_json_kind(git_node)
    git_is_null = eq git_kind, SA_JSON_KIND_NULL
    !git_kind
    br git_is_null -> L_GIT_CLEAR, L_GIT_STRINGIFY

L_GIT_STRINGIFY:
    !git_is_null
    buffer_slot = stack_alloc 8
    stringify_status = call @sa_json_stringify(git_node, &buffer_slot)
    stringify_ok = eq stringify_status, 0
    br stringify_ok -> L_GIT_STORE, L_GIT_STRINGIFY_FAIL

L_GIT_STORE:
    !stringify_ok
    buffer = load buffer_slot+0 as ptr
    raw_ptr = call @sa_json_buffer_data(&buffer)
    raw_len = call @sa_json_buffer_len(&buffer)
    set_status = call @state_thread_set_git_info(&state_ptr, thread_id, &raw_ptr, raw_len)
    !set_status
    free_buf = call @sa_json_buffer_free(^buffer)
    !free_buf
    git_free = call @sa_json_free(^git_node)
    params_free = call @sa_json_free(^params_node)
    root_free = call @sa_json_free(^root)
    !git_free
    !params_free
    !root_free
    !raw_ptr
    !raw_len
    !stringify_status
    !state_ptr
    !thread_id
    !body
    !body_len
    return 0

L_GIT_STRINGIFY_FAIL:
    !stringify_ok
    !stringify_status
    git_free_bad = call @sa_json_free(^git_node)
    params_free_bad = call @sa_json_free(^params_node)
    root_free_bad = call @sa_json_free(^root)
    !git_free_bad
    !params_free_bad
    !root_free_bad
    !state_ptr
    !thread_id
    !body
    !body_len
    return 1

L_GIT_CLEAR:
    !git_is_null
    clear_status = call @state_thread_clear_git_info(&state_ptr, thread_id)
    !clear_status
    git_free_null = call @sa_json_free(^git_node)
    params_free_null = call @sa_json_free(^params_node)
    root_free_null = call @sa_json_free(^root)
    !git_free_null
    !params_free_null
    !root_free_null
    !state_ptr
    !thread_id
    !body
    !body_len
    return 0

L_GIT_NO_VALUE:
    !git_ok
    !git_status
    params_free_no_value = call @sa_json_free(^params_node)
    root_free_no_value = call @sa_json_free(^root)
    !params_free_no_value
    !root_free_no_value
    !state_ptr
    !thread_id
    !body
    !body_len
    return 0

L_GIT_NO_PARAMS:
    !params_ok
    !params_status
    root_free_no_params = call @sa_json_free(^root)
    !root_free_no_params
    !state_ptr
    !thread_id
    !body
    !body_len
    return 0

L_GIT_NO_ROOT:
    !has_root
    !root
    !state_ptr
    !thread_id
    !body
    !body_len
    return 0

@ffi_wrapper send_rpc_thread_unsubscribe(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    thread_id = call @rpc_resolve_thread_id(&state_ptr, &body, body_len, 0)
    slot = call @state_thread_find(&state_ptr, thread_id)
    missing = eq slot, 0
    br missing -> L_UNSUB_NOT_LOADED, L_UNSUB_NOT_SUBSCRIBED

L_UNSUB_NOT_SUBSCRIBED:
    !missing
    !slot
    call @send_wrapped_const_with_id(&req, &id_ptr, id_len, &J_UNSUB_RESULT, J_UNSUB_RESULT_LEN)
    !thread_id
    !state_ptr
    !body
    !body_len
    !req
    return 0

L_UNSUB_NOT_LOADED:
    !missing
    !slot
    call @send_wrapped_const_with_id(&req, &id_ptr, id_len, &J_UNSUB_NOT_LOADED_RESULT, J_UNSUB_NOT_LOADED_RESULT_LEN)
    !thread_id
    !state_ptr
    !body
    !body_len
    !req
    return 0

@ffi_wrapper send_rpc_thread_elicitation_result(&req: ptr, &id_ptr: ptr, id_len: u64, count: u64) -> u32:
L_ENTRY:
    result = call @rpc_builder_new()
    call @rpc_builder_append(&result, &J_ELICITATION_A, J_ELICITATION_A_LEN)
    call @rpc_builder_append_u64(&result, count)
    paused = ugt count, 0
    br paused -> L_ELICITATION_TRUE, L_ELICITATION_FALSE

L_ELICITATION_TRUE:
    !paused
    call @rpc_builder_append(&result, &J_ELICITATION_TRUE, J_ELICITATION_TRUE_LEN)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result)
    !count
    !req
    return 0

L_ELICITATION_FALSE:
    !paused
    call @rpc_builder_append(&result, &J_ELICITATION_FALSE, J_ELICITATION_FALSE_LEN)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result)
    !count
    !req
    return 0

@ffi_wrapper send_rpc_thread_increment_elicitation(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    thread_id = call @rpc_resolve_thread_id(&state_ptr, &body, body_len, 0)
    count = call @state_thread_increment_elicitation(&state_ptr, thread_id)
    call @send_rpc_thread_elicitation_result(&req, &id_ptr, id_len, count)
    !count
    !thread_id
    !body
    !body_len
    !state_ptr
    !req
    return 0

@ffi_wrapper send_rpc_thread_decrement_elicitation(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    thread_id = call @rpc_resolve_thread_id(&state_ptr, &body, body_len, 0)
    count = call @state_thread_decrement_elicitation(&state_ptr, thread_id)
    call @send_rpc_thread_elicitation_result(&req, &id_ptr, id_len, count)
    !count
    !thread_id
    !body
    !body_len
    !state_ptr
    !req
    return 0

@ffi_wrapper send_rpc_fs_watch(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    path_ptr_slot = stack_alloc 8
    path_len_slot = stack_alloc 8
    watch_ptr_slot = stack_alloc 8
    watch_len_slot = stack_alloc 8
    path_status = call @rpc_extract_string_after(&body, body_len, &J_PATH_KEY, J_PATH_KEY_LEN, &path_ptr_slot, &path_len_slot)
    has_path = eq path_status, 1
    !path_status
    br has_path -> L_WATCH_ID, L_WATCH_BAD_PARAMS

L_WATCH_ID:
    !has_path
    watch_status = call @rpc_extract_string_after(&body, body_len, &J_WATCH_ID_KEY, J_WATCH_ID_KEY_LEN, &watch_ptr_slot, &watch_len_slot)
    has_watch = eq watch_status, 1
    !watch_status
    br has_watch -> L_WATCH_DO, L_WATCH_BAD_PARAMS2

L_WATCH_BAD_PARAMS:
    !has_path
    call @send_error_with_id(&req, 400, &id_ptr, id_len, &J_ERR_INVALID_PARAMS, J_ERR_INVALID_PARAMS_LEN)
    !body
    !body_len
    !state_ptr
    !req
    return 0

L_WATCH_BAD_PARAMS2:
    !has_watch
    call @send_error_with_id(&req, 400, &id_ptr, id_len, &J_ERR_INVALID_PARAMS, J_ERR_INVALID_PARAMS_LEN)
    !body
    !body_len
    !state_ptr
    !req
    return 0

L_WATCH_DO:
    !has_watch
    path_ptr = load path_ptr_slot+0 as ptr
    path_len = load path_len_slot+0 as u64
    watch_ptr = load watch_ptr_slot+0 as ptr
    watch_len = load watch_len_slot+0 as u64
    put_status = call @state_watch_put(&state_ptr, &watch_ptr, watch_len)
    put_ok = eq put_status, 0
    !put_status
    br put_ok -> L_WATCH_RESP, L_WATCH_ERR

L_WATCH_ERR:
    !put_ok
    !path_ptr
    !path_len
    !watch_ptr
    !watch_len
    call @send_error_with_id(&req, 500, &id_ptr, id_len, &J_ERR_FS, J_ERR_FS_LEN)
    !body
    !body_len
    !state_ptr
    !req
    return 0

L_WATCH_RESP:
    !put_ok
    call @notify_fs_changed(&state_ptr, &watch_ptr, watch_len, &path_ptr, path_len)
    result = call @rpc_builder_new()
    call @rpc_builder_append(&result, &J_FS_WATCH_A, J_FS_WATCH_A_LEN)
    call @rpc_builder_append(&result, &path_ptr, path_len)
    call @rpc_builder_append(&result, &J_FS_WATCH_B, J_FS_WATCH_B_LEN)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result)
    !path_ptr
    !path_len
    !watch_ptr
    !watch_len
    !body
    !body_len
    !state_ptr
    !req
    return 0

@ffi_wrapper send_rpc_fs_unwatch(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    watch_ptr_slot = stack_alloc 8
    watch_len_slot = stack_alloc 8
    watch_status = call @rpc_extract_string_after(&body, body_len, &J_WATCH_ID_KEY, J_WATCH_ID_KEY_LEN, &watch_ptr_slot, &watch_len_slot)
    has_watch = eq watch_status, 1
    !watch_status
    br has_watch -> L_UNWATCH_DO, L_UNWATCH_FALSE

L_UNWATCH_DO:
    !has_watch
    watch_ptr = load watch_ptr_slot+0 as ptr
    watch_len = load watch_len_slot+0 as u64
    deleted = call @state_watch_delete(&state_ptr, &watch_ptr, watch_len)
    found = eq deleted, 1
    !deleted
    br found -> L_UNWATCH_TRUE, L_UNWATCH_FALSE2

L_UNWATCH_TRUE:
    !found
    call @send_wrapped_const_with_id(&req, &id_ptr, id_len, &J_FS_OK_TRUE, J_FS_OK_TRUE_LEN)
    !watch_ptr
    !watch_len
    !body
    !body_len
    !state_ptr
    !req
    return 0

L_UNWATCH_FALSE2:
    !found
    call @send_wrapped_const_with_id(&req, &id_ptr, id_len, &J_FS_OK_FALSE, J_FS_OK_FALSE_LEN)
    !watch_ptr
    !watch_len
    !body
    !body_len
    !state_ptr
    !req
    return 0

L_UNWATCH_FALSE:
    !has_watch
    call @send_wrapped_const_with_id(&req, &id_ptr, id_len, &J_FS_OK_FALSE, J_FS_OK_FALSE_LEN)
    !body
    !body_len
    !state_ptr
    !req
    return 0

@ffi_wrapper send_rpc_turns_list(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, thread_id: u64) -> u32:
L_ENTRY:
    result = call @rpc_builder_new()
    ids = stack_alloc 8192
    count_slot = stack_alloc 8
    list_status = call @state_turn_list(&state_ptr, thread_id, &ids, &count_slot)
    !list_status
    count = load count_slot+0 as u64
    call @rpc_builder_append(&result, &J_TURNS_LIST_A, J_TURNS_LIST_A_LEN)
    i_slot = stack_alloc 8
    store i_slot+0, 0 as u64
    jmp L_TURNS_COND

L_TURNS_COND:
    i = load i_slot+0 as u64
    done = uge i, count
    br done -> L_TURNS_DONE, L_TURNS_BODY

L_TURNS_BODY:
    id_off = mul i, 8
    list_id_ptr = ptr_add ids, id_off
    turn_id = load list_id_ptr+0 as u64
    is_first = eq i, 0
    br is_first -> L_TURNS_APPEND, L_TURNS_COMMA

L_TURNS_COMMA:
    !is_first
    call @rpc_builder_append(&result, &J_COMMA, J_COMMA_LEN)
    jmp L_TURNS_APPEND2

L_TURNS_APPEND:
    !is_first
    jmp L_TURNS_APPEND2

L_TURNS_APPEND2:
    turn_slot2 = call @state_turn_find(&state_ptr, thread_id, turn_id)
    turn_status2 = load turn_slot2+TURN_STATUS as u8
    turn_mode2 = load turn_slot2+TURN_MODE as u8
    turn_items_ptr2 = ptr_add turn_slot2, TURN_ITEMS
    turn_items_len2 = load turn_slot2+TURN_ITEMS_LEN as u64
    call @rpc_builder_append_turn_status_mode_items(&result, turn_id, turn_status2, turn_mode2, &turn_items_ptr2, turn_items_len2)
    !turn_items_ptr2
    !turn_items_len2
    !turn_mode2
    !turn_status2
    !turn_slot2
    !turn_id
    !list_id_ptr
    !id_off
    next = add i, 1
    store i_slot+0, next as u64
    !next
    !i
    !done
    jmp L_TURNS_COND

L_TURNS_DONE:
    !done
    !i
    call @rpc_builder_append(&result, &J_TURNS_LIST_B, J_TURNS_LIST_B_LEN)
    !count
    !thread_id
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result)
    !state_ptr
    !req
    return 0

@ffi_wrapper send_rpc_turn_items_list(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, thread_id: u64, turn_id: u64) -> u32:
L_ENTRY:
    slot = call @state_turn_find(&state_ptr, thread_id, turn_id)
    missing = eq slot, 0
    br missing -> L_TITEMS_EMPTY, L_TITEMS_FOUND

L_TITEMS_FOUND:
    !missing
    items_len = load slot+TURN_ITEMS_LEN as u64
    has_items = ugt items_len, 0
    br has_items -> L_TITEMS_WITH_ITEMS, L_TITEMS_EMPTY_FROM_FOUND

L_TITEMS_WITH_ITEMS:
    !has_items
    items_ptr = ptr_add slot, TURN_ITEMS
    result = call @rpc_builder_new()
    call @rpc_builder_append(&result, &J_TURN_ITEMS_A, J_TURN_ITEMS_A_LEN)
    call @rpc_builder_append(&result, &items_ptr, items_len)
    call @rpc_builder_append(&result, &J_TURN_ITEMS_B, J_TURN_ITEMS_B_LEN)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result)
    !items_ptr
    !items_len
    !slot
    !turn_id
    !thread_id
    !state_ptr
    !req
    return 0

L_TITEMS_EMPTY_FROM_FOUND:
    !has_items
    !items_len
    !slot
    jmp L_TITEMS_EMPTY_FOUND

L_TITEMS_EMPTY:
    !missing
    !slot
    call @send_wrapped_const_with_id(&req, &id_ptr, id_len, &J_TURN_ITEMS_EMPTY, J_TURN_ITEMS_EMPTY_LEN)
    !turn_id
    !thread_id
    !state_ptr
    !req
    return 0

L_TITEMS_EMPTY_FOUND:
    call @send_wrapped_const_with_id(&req, &id_ptr, id_len, &J_TURN_ITEMS_EMPTY, J_TURN_ITEMS_EMPTY_LEN)
    !turn_id
    !thread_id
    !state_ptr
    !req
    return 0

@ffi_wrapper send_rpc_thread_rollback(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, thread_id: u64, remove_count: u64) -> u32:
L_ENTRY:
    rb_status = call @state_turn_rollback(&state_ptr, thread_id, remove_count)
    ok = eq rb_status, 0
    !rb_status
    br ok -> L_ROLLBACK_OK, L_ROLLBACK_NOT_FOUND

L_ROLLBACK_OK:
    !ok
    call @send_rpc_thread_read(&req, &id_ptr, id_len, &state_ptr, thread_id, 1)
    !remove_count
    !thread_id
    !state_ptr
    !req
    return 0

L_ROLLBACK_NOT_FOUND:
    !ok
    call @send_error_with_id(&req, 404, &id_ptr, id_len, &J_ERR_THREAD_NOT_FOUND, J_ERR_THREAD_NOT_FOUND_LEN)
    !remove_count
    !thread_id
    !state_ptr
    !req
    return 0

@ffi_wrapper send_rpc_turn_start(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, thread_id: u64, turn_id: u64, mode: u8) -> u32:
L_ENTRY:
    result = call @rpc_builder_new()
    call @rpc_builder_append(&result, &J_TURN_RESULT_A, J_TURN_RESULT_A_LEN)
    slot = call @state_turn_find(&state_ptr, thread_id, turn_id)
    missing = eq slot, 0
    br missing -> L_TURN_START_EMPTY, L_TURN_START_WITH_SLOT

L_TURN_START_WITH_SLOT:
    !missing
    turn_status = load slot+TURN_STATUS as u8
    items_ptr = ptr_add slot, TURN_ITEMS
    items_len = load slot+TURN_ITEMS_LEN as u64
    call @rpc_builder_append_turn_status_mode_items(&result, turn_id, turn_status, mode, &items_ptr, items_len)
    !items_ptr
    !items_len
    !turn_status
    !slot
    jmp L_TURN_START_WRAP

L_TURN_START_EMPTY:
    !missing
    !slot
    call @rpc_builder_append_turn_mode(&result, turn_id, mode)
    jmp L_TURN_START_WRAP

L_TURN_START_WRAP:
    call @rpc_builder_append(&result, &J_RPC_SUFFIX, J_RPC_SUFFIX_LEN)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result)
    !mode
    !thread_id
    !turn_id
    !state_ptr
    !req
    return 0

@ffi_wrapper send_rpc_turn_steer(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, thread_id: u64, turn_id: u64, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    slot = call @state_turn_find(&state_ptr, thread_id, turn_id)
    missing = eq slot, 0
    br missing -> L_STEER_NOT_FOUND, L_STEER_OK

L_STEER_OK:
    !missing
    input_ptr_slot = stack_alloc 8
    input_len_slot = stack_alloc 8
    input_status = call @rpc_extract_array_after(&body, body_len, &J_INPUT_ARRAY_KEY, J_INPUT_ARRAY_KEY_LEN, &input_ptr_slot, &input_len_slot)
    has_input = eq input_status, 1
    br has_input -> L_STEER_APPEND, L_STEER_NO_INPUT

L_STEER_APPEND:
    !has_input
    !input_status
    input_ptr = load input_ptr_slot+0 as ptr
    input_len = load input_len_slot+0 as u64
    append_status = call @state_turn_append_items(&state_ptr, thread_id, turn_id, &input_ptr, input_len)
    !append_status
    steer_notify_count = call @notify_turn_input_items_from_dom(&state_ptr, &body, body_len, thread_id, turn_id)
    !steer_notify_count
    !input_ptr
    !input_len
    jmp L_STEER_RESP

L_STEER_NO_INPUT:
    !has_input
    !input_status
    jmp L_STEER_RESP

L_STEER_RESP:
    result = call @rpc_builder_new()
    call @rpc_builder_append(&result, &J_STEER_A, J_STEER_A_LEN)
    call @rpc_builder_append_u64(&result, turn_id)
    call @rpc_builder_append(&result, &J_ARCHIVE_B, J_ARCHIVE_B_LEN)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result)
    !slot
    !thread_id
    !turn_id
    !state_ptr
    !body
    !body_len
    !req
    return 0

L_STEER_NOT_FOUND:
    !missing
    !slot
    call @send_error_with_id(&req, 404, &id_ptr, id_len, &J_ERR_TURN_NOT_FOUND, J_ERR_TURN_NOT_FOUND_LEN)
    !thread_id
    !turn_id
    !state_ptr
    !body
    !body_len
    !req
    return 0

@ffi_wrapper send_rpc_turn_interrupt(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, thread_id: u64, turn_id: u64) -> u32:
L_ENTRY:
    int_status = call @state_turn_interrupt(&state_ptr, thread_id, turn_id)
    ok = eq int_status, 0
    !int_status
    br ok -> L_TINT_OK, L_TINT_NOT_FOUND

L_TINT_OK:
    !ok
    call @notify_turn_completed(&state_ptr, thread_id, turn_id)
    result = call @rpc_builder_new()
    call @rpc_builder_append(&result, &J_INTERRUPT_A, J_INTERRUPT_A_LEN)
    call @rpc_builder_append_thread_id_inner(&result, &state_ptr, thread_id)
    call @rpc_builder_append(&result, &J_INTERRUPT_B, J_INTERRUPT_B_LEN)
    call @rpc_builder_append_u64(&result, turn_id)
    call @rpc_builder_append(&result, &J_INTERRUPT_C, J_INTERRUPT_C_LEN)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result)
    !thread_id
    !turn_id
    !state_ptr
    !req
    return 0

L_TINT_NOT_FOUND:
    !ok
    call @send_error_with_id(&req, 404, &id_ptr, id_len, &J_ERR_TURN_NOT_FOUND, J_ERR_TURN_NOT_FOUND_LEN)
    !thread_id
    !turn_id
    !state_ptr
    !req
    return 0

@ffi_wrapper send_rpc_goal_obj(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, thread_id: u64, budget: u64, used: u64, &obj_ptr: ptr, obj_len: u64) -> u32:
L_ENTRY:
    result = call @rpc_builder_new()
    call @rpc_builder_append(&result, &J_GOAL_RESULT_A, J_GOAL_RESULT_A_LEN)
    call @rpc_builder_append(&result, &J_GOAL_OBJ_A, J_GOAL_OBJ_A_LEN)
    call @rpc_builder_append_thread_id_inner(&result, &state_ptr, thread_id)
    call @rpc_builder_append(&result, &J_GOAL_OBJ_B, J_GOAL_OBJ_B_LEN)
    call @rpc_builder_append_json_string(&result, &obj_ptr, obj_len)
    call @rpc_builder_append(&result, &J_GOAL_OBJ_B2, J_GOAL_OBJ_B2_LEN)
    call @rpc_builder_append_u64(&result, budget)
    call @rpc_builder_append(&result, &J_GOAL_OBJ_C, J_GOAL_OBJ_C_LEN)
    call @rpc_builder_append_u64(&result, used)
    call @rpc_builder_append_goal_tail(&result)
    call @rpc_builder_append(&result, &J_RPC_SUFFIX, J_RPC_SUFFIX_LEN)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result)
    !thread_id
    !state_ptr
    !budget
    !used
    !obj_ptr
    !obj_len
    !req
    return 0

@ffi_wrapper send_rpc_goal_clear(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, thread_id: u64, cleared: u8) -> u32:
L_ENTRY:
    is_cleared = eq cleared, 1
    br is_cleared -> L_GOAL_CLR_TRUE, L_GOAL_CLR_FALSE

L_GOAL_CLR_TRUE:
    !is_cleared
    result = call @rpc_builder_new()
    call @rpc_builder_append(&result, &J_GOAL_CLEAR_TRUE, J_GOAL_CLEAR_TRUE_LEN)
    call @rpc_builder_append_thread_id_inner(&result, &state_ptr, thread_id)
    call @rpc_builder_append(&result, &J_GOAL_CLEAR_B, J_GOAL_CLEAR_B_LEN)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result)
    !thread_id
    !state_ptr
    !cleared
    !req
    return 0

L_GOAL_CLR_FALSE:
    !is_cleared
    call @send_wrapped_const_with_id(&req, &id_ptr, id_len, &J_GOAL_CLEAR_FALSE, J_GOAL_CLEAR_FALSE_LEN)
    !thread_id
    !state_ptr
    !cleared
    !req
    return 0

@ffi_wrapper send_rpc_memory_reset(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, thread_id: u64) -> u32:
L_ENTRY:
    reset_status = call @state_reset_runtime(&state_ptr)
    !reset_status
    call @notify_thread_id_string(&state_ptr, &EV_THREAD_CLOSED, EV_THREAD_CLOSED_LEN, &J_THREAD_ID_ALL, J_THREAD_ID_ALL_LEN)
    result = call @rpc_builder_new()
    call @rpc_builder_append(&result, &J_MEMORY_RESET_A, J_MEMORY_RESET_A_LEN)
    call @rpc_builder_append_u64(&result, thread_id)
    call @rpc_builder_append(&result, &J_ARCHIVE_B, J_ARCHIVE_B_LEN)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result)
    !thread_id
    !state_ptr
    !req
    return 0

@ffi_wrapper send_rpc_hooks_list(&req: ptr, &id_ptr: ptr, id_len: u64, &cfg_ptr: ptr) -> u32:
L_ENTRY:
    cwd_buf = call @sa_deno_cwd()
    cwd_ptr = call @sa_fs_read_buffer_data(cwd_buf)
    cwd_len = call @sa_fs_read_buffer_len(cwd_buf)
    result = call @rpc_builder_new()
    call @rpc_builder_append(&result, &J_HOOKS_A, J_HOOKS_A_LEN)
    call @rpc_builder_append_json_string(&result, &cwd_ptr, cwd_len)
    call @rpc_builder_append(&result, &J_HOOKS_B, J_HOOKS_B_LEN)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result)
    free_status = call @sa_fs_read_buffer_free(^cwd_buf)
    !free_status
    !cwd_ptr
    !cwd_len
    !cfg_ptr
    !req
    return 0

@ffi_wrapper send_rpc_model_list(&req: ptr, &id_ptr: ptr, id_len: u64, &cfg_ptr: ptr) -> u32:
L_ENTRY:
    chat_base_ptr = load cfg_ptr+CFG_CHAT_PTR as ptr
    chat_base_len = load cfg_ptr+CFG_CHAT_LEN as u64
    url_len_slot = stack_alloc 8
    models_url = call @build_proxy_url(&chat_base_ptr, chat_base_len, &UP_MODELS_SUFFIX, UP_MODELS_SUFFIX_LEN, &url_len_slot)
    models_url_len = load url_len_slot+0 as u64
    api_key_ptr = load cfg_ptr+CFG_KEY_PTR as ptr
    api_key_len = load cfg_ptr+CFG_KEY_LEN as u64
    up_auth_buf = stack_alloc UP_AUTH_BUF_SIZE
    up_auth_dst = ptr_add up_auth_buf, 0
    up_auth_prefix = call @sa_bytes_copy(&up_auth_dst, &BEARER_PREFIX, BEARER_PREFIX_LEN)
    !up_auth_prefix
    !up_auth_dst
    up_auth_key_dst = ptr_add up_auth_buf, BEARER_PREFIX_LEN
    up_auth_key_copy = call @sa_bytes_copy(&up_auth_key_dst, &api_key_ptr, api_key_len)
    !up_auth_key_copy
    !up_auth_key_dst
    up_auth_len = add api_key_len, BEARER_PREFIX_LEN

    client_slot = stack_alloc 8
    client_status = call @sa_http_client_new(1, &client_slot)
    client = load client_slot+0 as ptr
    req_slot = stack_alloc 8
    req_status = call @sa_http_client_req_new(client, 1, &models_url, models_url_len, &req_slot)
    up_req = load req_slot+0 as ptr
    call @sa_http_client_req_add_header(up_req, &HDR_AUTH, HDR_AUTH_LEN, &up_auth_buf, up_auth_len)
    call @sa_http_client_req_add_header(up_req, &HDR_X_API_KEY, HDR_X_API_KEY_LEN, &api_key_ptr, api_key_len)
    resp_slot = stack_alloc 8
    send_status = call @sa_http_client_req_send(up_req, &resp_slot)
    up_resp = load resp_slot+0 as ptr
    up_status = call @sa_http_client_resp_status(up_resp)
    ct_ptr_slot = stack_alloc 8
    ct_len_slot = stack_alloc 8
    store ct_ptr_slot+0, 0 as ptr
    store ct_len_slot+0, 0 as u64
    ct_status = call @sa_http_client_resp_get_header(up_resp, &HDR_CONTENT_TYPE, HDR_CONTENT_TYPE_LEN, &ct_ptr_slot, &ct_len_slot)
    ct_ptr = load ct_ptr_slot+0 as ptr
    ct_len = load ct_len_slot+0 as u64
    !ct_status
    body_ptr_slot = stack_alloc 8
    body_len_slot = stack_alloc 8
    body_status = call @sa_http_client_resp_body_slice(up_resp, &body_ptr_slot, &body_len_slot)
    body_ptr = load body_ptr_slot+0 as ptr
    body_len = load body_len_slot+0 as u64

    out_slot = stack_alloc 8
    out_status = call @sa_http_server_resp_new(req, up_status, &out_slot)
    out_resp = load out_slot+0 as ptr
    has_ct = ugt ct_len, 0
    br has_ct -> L_RPC_MODELS_CT_UPSTREAM, L_RPC_MODELS_CT_DEFAULT

L_RPC_MODELS_CT_UPSTREAM:
    !has_ct
    set_ct = call @sa_http_server_resp_set_content_type(out_resp, &ct_ptr, ct_len)
    !set_ct
    jmp L_RPC_MODELS_SEND

L_RPC_MODELS_CT_DEFAULT:
    !has_ct
    set_default_ct = call @sa_http_server_resp_set_content_type(out_resp, &MIME_JSON, MIME_JSON_LEN)
    !set_default_ct
    jmp L_RPC_MODELS_SEND

L_RPC_MODELS_SEND:
    send_back = call @sa_http_server_resp_send(out_resp, &body_ptr, body_len)
    !send_back
    !out_status
    !body_status
    !body_ptr
    !body_len
    !ct_ptr
    !ct_len
    call @sa_http_server_resp_free(^out_resp)
    call @sa_http_client_resp_free(^up_resp)
    call @sa_http_client_req_free(^up_req)
    call @sa_http_client_free(^client)
    !send_status
    !req_status
    !client_status
    !up_auth_len
    !api_key_ptr
    !api_key_len
    !models_url
    !models_url_len
    !chat_base_ptr
    !chat_base_len
    !id_ptr
    !id_len
    !cfg_ptr
    !req
    return 0

@ffi_wrapper send_rpc_account_read(&req: ptr, &id_ptr: ptr, id_len: u64, &cfg_ptr: ptr) -> u32:
L_ENTRY:
    plan_ptr = load cfg_ptr+CFG_PLAN_PTR as ptr
    plan_len = load cfg_ptr+CFG_PLAN_LEN as u64
    email_ptr = load cfg_ptr+CFG_EMAIL_PTR as ptr
    email_len = load cfg_ptr+CFG_EMAIL_LEN as u64
    has_plan = ugt plan_len, 0
    br has_plan -> L_ACCOUNT_USE_CFG, L_ACCOUNT_USE_DEFAULT

L_ACCOUNT_USE_CFG:
    !has_plan
    result = call @rpc_builder_new()
    call @rpc_builder_append(&result, &J_ACCOUNT_A, J_ACCOUNT_A_LEN)
    has_email = ugt email_len, 0
    br has_email -> L_ACCOUNT_CFG_EMAIL_CFG_PLAN, L_ACCOUNT_DEFAULT_EMAIL_CFG_PLAN

L_ACCOUNT_CFG_EMAIL_CFG_PLAN:
    !has_email
    call @rpc_builder_append_json_string(&result, &email_ptr, email_len)
    jmp L_ACCOUNT_AFTER_EMAIL_CFG_PLAN

L_ACCOUNT_DEFAULT_EMAIL_CFG_PLAN:
    !has_email
    call @rpc_builder_append_json_string(&result, &J_ACCOUNT_DEFAULT_EMAIL, J_ACCOUNT_DEFAULT_EMAIL_LEN)
    jmp L_ACCOUNT_AFTER_EMAIL_CFG_PLAN

L_ACCOUNT_AFTER_EMAIL_CFG_PLAN:
    call @rpc_builder_append(&result, &J_ACCOUNT_PLAN, J_ACCOUNT_PLAN_LEN)
    call @rpc_builder_append_json_string(&result, &plan_ptr, plan_len)
    call @rpc_builder_append(&result, &J_ACCOUNT_B, J_ACCOUNT_B_LEN)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result)
    !email_ptr
    !email_len
    !plan_ptr
    !plan_len
    !cfg_ptr
    !req
    return 0

L_ACCOUNT_USE_DEFAULT:
    !has_plan
    result2 = call @rpc_builder_new()
    call @rpc_builder_append(&result2, &J_ACCOUNT_A, J_ACCOUNT_A_LEN)
    has_email2 = ugt email_len, 0
    br has_email2 -> L_ACCOUNT_CFG_EMAIL_DEFAULT_PLAN, L_ACCOUNT_DEFAULT_EMAIL_DEFAULT_PLAN

L_ACCOUNT_CFG_EMAIL_DEFAULT_PLAN:
    !has_email2
    call @rpc_builder_append_json_string(&result2, &email_ptr, email_len)
    jmp L_ACCOUNT_AFTER_EMAIL_DEFAULT_PLAN

L_ACCOUNT_DEFAULT_EMAIL_DEFAULT_PLAN:
    !has_email2
    call @rpc_builder_append_json_string(&result2, &J_ACCOUNT_DEFAULT_EMAIL, J_ACCOUNT_DEFAULT_EMAIL_LEN)
    jmp L_ACCOUNT_AFTER_EMAIL_DEFAULT_PLAN

L_ACCOUNT_AFTER_EMAIL_DEFAULT_PLAN:
    call @rpc_builder_append(&result2, &J_ACCOUNT_PLAN, J_ACCOUNT_PLAN_LEN)
    call @rpc_builder_append_json_string(&result2, &DEFAULT_PLAN_PLUS, DEFAULT_PLAN_PLUS_LEN)
    call @rpc_builder_append(&result2, &J_ACCOUNT_B, J_ACCOUNT_B_LEN)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result2)
    !email_ptr
    !email_len
    !plan_ptr
    !plan_len
    !cfg_ptr
    !req
    return 0

@ffi_wrapper send_rpc_rate_limits(&req: ptr, &id_ptr: ptr, id_len: u64, &cfg_ptr: ptr) -> u32:
L_ENTRY:
    plan_ptr = load cfg_ptr+CFG_PLAN_PTR as ptr
    plan_len = load cfg_ptr+CFG_PLAN_LEN as u64
    has_plan = ugt plan_len, 0
    br has_plan -> L_RATE_USE_CFG, L_RATE_USE_DEFAULT

L_RATE_USE_CFG:
    !has_plan
    result = call @rpc_builder_new()
    call @rpc_builder_append(&result, &J_RATE_LIMITS_A, J_RATE_LIMITS_A_LEN)
    call @rpc_builder_append_json_string(&result, &plan_ptr, plan_len)
    call @rpc_builder_append(&result, &J_RATE_LIMITS_B, J_RATE_LIMITS_B_LEN)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result)
    !plan_ptr
    !plan_len
    !cfg_ptr
    !req
    return 0

L_RATE_USE_DEFAULT:
    !has_plan
    result2 = call @rpc_builder_new()
    call @rpc_builder_append(&result2, &J_RATE_LIMITS_A, J_RATE_LIMITS_A_LEN)
    call @rpc_builder_append_json_string(&result2, &DEFAULT_PLAN_PLUS, DEFAULT_PLAN_PLUS_LEN)
    call @rpc_builder_append(&result2, &J_RATE_LIMITS_B, J_RATE_LIMITS_B_LEN)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result2)
    !plan_ptr
    !plan_len
    !cfg_ptr
    !req
    return 0

@ffi_wrapper send_rpc_chatgpt_tokens_refresh(&req: ptr, &id_ptr: ptr, id_len: u64) -> u32:
L_ENTRY:
    iso_buf = call @sa_deno_date_now_iso()
    iso_ptr = call @sa_fs_read_buffer_data(iso_buf)
    iso_len = call @sa_fs_read_buffer_len(iso_buf)
    result = call @rpc_builder_new()
    call @rpc_builder_append(&result, &J_CHATGPT_REFRESH_A, J_CHATGPT_REFRESH_A_LEN)
    call @rpc_builder_append_json_string(&result, &iso_ptr, iso_len)
    call @rpc_builder_append(&result, &J_CHATGPT_REFRESH_B, J_CHATGPT_REFRESH_B_LEN)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result)
    iso_free = call @sa_fs_read_buffer_free(^iso_buf)
    !iso_free
    !iso_ptr
    !iso_len
    !req
    return 0

@ffi_wrapper send_rpc_config_read(&req: ptr, &id_ptr: ptr, id_len: u64, &cfg_ptr: ptr) -> u32:
L_ENTRY:
    host_ptr = load cfg_ptr+CFG_HOST_PTR as ptr
    host_len = load cfg_ptr+CFG_HOST_LEN as u64
    port = load cfg_ptr+CFG_PORT as u16
    port_u64 = zext port
    rbase_ptr = load cfg_ptr+CFG_RBASE_PTR as ptr
    rbase_len = load cfg_ptr+CFG_RBASE_LEN as u64
    chat_ptr = load cfg_ptr+CFG_CHAT_PTR as ptr
    chat_len = load cfg_ptr+CFG_CHAT_LEN as u64
    model_ptr = load cfg_ptr+CFG_MODEL_PTR as ptr
    model_len = load cfg_ptr+CFG_MODEL_LEN as u64
    auth_ptr = load cfg_ptr+CFG_AUTH_PTR as ptr
    auth_len = load cfg_ptr+CFG_AUTH_LEN as u64
    result = call @rpc_builder_new()
    call @rpc_builder_append(&result, &J_CONFIG_READ_A, J_CONFIG_READ_A_LEN)
    call @rpc_builder_append_json_string(&result, &host_ptr, host_len)
    call @rpc_builder_append(&result, &J_CONFIG_READ_B, J_CONFIG_READ_B_LEN)
    call @rpc_builder_append_u64(&result, port_u64)
    call @rpc_builder_append(&result, &J_CONFIG_READ_C, J_CONFIG_READ_C_LEN)
    has_rbase = ugt rbase_len, 0
    br has_rbase -> L_CFG_RBASE_STRING, L_CFG_RBASE_NULL

L_CFG_RBASE_STRING:
    !has_rbase
    call @rpc_builder_append_json_string(&result, &rbase_ptr, rbase_len)
    jmp L_CFG_AFTER_RBASE

L_CFG_RBASE_NULL:
    !has_rbase
    call @rpc_builder_append(&result, &J_NULL, J_NULL_LEN)
    jmp L_CFG_AFTER_RBASE

L_CFG_AFTER_RBASE:
    call @rpc_builder_append(&result, &J_CONFIG_READ_D, J_CONFIG_READ_D_LEN)
    call @rpc_builder_append_json_string(&result, &chat_ptr, chat_len)
    call @rpc_builder_append(&result, &J_CONFIG_READ_E, J_CONFIG_READ_E_LEN)
    call @rpc_builder_append_json_string(&result, &model_ptr, model_len)
    call @rpc_builder_append(&result, &J_CONFIG_READ_F, J_CONFIG_READ_F_LEN)
    has_auth = ugt auth_len, 0
    br has_auth -> L_CFG_AUTH_STRING, L_CFG_AUTH_NULL

L_CFG_AUTH_STRING:
    !has_auth
    call @rpc_builder_append_json_string(&result, &auth_ptr, auth_len)
    jmp L_CFG_AFTER_AUTH

L_CFG_AUTH_NULL:
    !has_auth
    call @rpc_builder_append(&result, &J_NULL, J_NULL_LEN)
    jmp L_CFG_AFTER_AUTH

L_CFG_AFTER_AUTH:
    call @rpc_builder_append(&result, &J_CONFIG_READ_G, J_CONFIG_READ_G_LEN)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result)
    !host_ptr
    !host_len
    !port
    !port_u64
    !rbase_ptr
    !rbase_len
    !chat_ptr
    !chat_len
    !model_ptr
    !model_len
    !auth_ptr
    !auth_len
    !cfg_ptr
    !req
    return 0

