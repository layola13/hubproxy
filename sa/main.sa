L_NOTIFY_TURN_COMPLETED_EMPTY:
    !missing
    !slot
    empty_ptr = &EMPTY_TEXT
    now_empty_i = call @sa_time_unix_s()
    now_empty_u = bitcast now_empty_i as u64
    turn_status_empty = call @json_writer_write_turn_object(writer, turn_id, 2, 0, now_empty_u, now_empty_u, now_empty_u, &empty_ptr, 0, &empty_ptr, 0)
