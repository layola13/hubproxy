    jmp L_RPC_DONE

L_RPC_TRY_FS_METADATA:
    !m_fsrd_ok
    m_fsmeta_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_FS_METADATA, RPC_M_FS_METADATA_LEN)
    m_fsmeta_ok = sge m_fsmeta_idx, 0
    !m_fsmeta_idx
    br m_fsmeta_ok -> L_RPC_FS_METADATA, L_RPC_TRY_FS_REMOVE

L_RPC_FS_METADATA:
    !m_fsmeta_ok
    call @send_rpc_fs_metadata(&req, &rpc_id_ptr, rpc_id_len, &rpc_body_ptr, rpc_body_len)
    jmp L_RPC_DONE

L_RPC_TRY_FS_REMOVE:
    !m_fsmeta_ok
    m_fsremove_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_FS_REMOVE, RPC_M_FS_REMOVE_LEN)
    m_fsremove_ok = sge m_fsremove_idx, 0
    !m_fsremove_idx
    br m_fsremove_ok -> L_RPC_FS_REMOVE, L_RPC_TRY_FS_COPY

L_RPC_FS_REMOVE:
    !m_fsremove_ok
    call @send_rpc_fs_remove(&req, &rpc_id_ptr, rpc_id_len, &rpc_body_ptr, rpc_body_len)
    jmp L_RPC_DONE

L_RPC_TRY_FS_COPY:
    !m_fsremove_ok
    m_fscopy_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_FS_COPY, RPC_M_FS_COPY_LEN)
    m_fscopy_ok = sge m_fscopy_idx, 0
    !m_fscopy_idx
    br m_fscopy_ok -> L_RPC_FS_COPY, L_RPC_TRY_FS_WATCH

L_RPC_FS_COPY:
    !m_fscopy_ok
    call @send_rpc_fs_copy(&req, &rpc_id_ptr, rpc_id_len, &rpc_body_ptr, rpc_body_len)
    jmp L_RPC_DONE

L_RPC_TRY_FS_WATCH:
    !m_fscopy_ok
    m_fwatch_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_FS_WATCH, RPC_M_FS_WATCH_LEN)
    m_fwatch_ok = sge m_fwatch_idx, 0
    !m_fwatch_idx
    br m_fwatch_ok -> L_RPC_FS_WATCH, L_RPC_TRY_FS_UNWATCH

L_RPC_FS_WATCH:
    !m_fwatch_ok
    call @send_rpc_fs_watch(&req, &rpc_id_ptr, rpc_id_len, &state_ptr, &rpc_body_ptr, rpc_body_len)
    jmp L_RPC_DONE

L_RPC_TRY_FS_UNWATCH:
    !m_fwatch_ok
    m_funwatch_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_FS_UNWATCH, RPC_M_FS_UNWATCH_LEN)
    m_funwatch_ok = sge m_funwatch_idx, 0
    !m_funwatch_idx
    br m_funwatch_ok -> L_RPC_FS_UNWATCH, L_RPC_TRY_COMMAND_EXEC

L_RPC_FS_UNWATCH:
    !m_funwatch_ok
    call @send_rpc_fs_unwatch(&req, &rpc_id_ptr, rpc_id_len, &state_ptr, &rpc_body_ptr, rpc_body_len)
    jmp L_RPC_DONE

L_RPC_TRY_COMMAND_EXEC:
    !m_funwatch_ok
    m_cmd_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_COMMAND_EXEC, RPC_M_COMMAND_EXEC_LEN)
    m_cmd_ok = sge m_cmd_idx, 0
    !m_cmd_idx
    br m_cmd_ok -> L_RPC_COMMAND_EXEC, L_RPC_TRY_COMMAND_WRITE

L_RPC_COMMAND_EXEC:
    !m_cmd_ok
    call @send_rpc_command_exec(&req, &rpc_id_ptr, rpc_id_len, &state_ptr, &rpc_body_ptr, rpc_body_len)
    jmp L_RPC_DONE

L_RPC_TRY_COMMAND_WRITE:
    !m_cmd_ok
    m_cmd_write_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_COMMAND_WRITE, RPC_M_COMMAND_WRITE_LEN)
    m_cmd_write_ok = sge m_cmd_write_idx, 0
    !m_cmd_write_idx
    br m_cmd_write_ok -> L_RPC_COMMAND_WRITE, L_RPC_TRY_COMMAND_TERMINATE

L_RPC_COMMAND_WRITE:
    !m_cmd_write_ok
    call @send_wrapped_const_with_id(&req, &rpc_id_ptr, rpc_id_len, &J_FS_OK_TRUE, J_FS_OK_TRUE_LEN)
    jmp L_RPC_DONE

L_RPC_TRY_COMMAND_TERMINATE:
    !m_cmd_write_ok
    m_cmd_term_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_COMMAND_TERMINATE, RPC_M_COMMAND_TERMINATE_LEN)
    m_cmd_term_ok = sge m_cmd_term_idx, 0
    !m_cmd_term_idx
    br m_cmd_term_ok -> L_RPC_COMMAND_TERMINATE, L_RPC_TRY_COMMAND_RESIZE

L_RPC_COMMAND_TERMINATE:
    !m_cmd_term_ok
    call @send_wrapped_const_with_id(&req, &rpc_id_ptr, rpc_id_len, &J_FS_OK_TRUE, J_FS_OK_TRUE_LEN)
    jmp L_RPC_DONE

L_RPC_TRY_COMMAND_RESIZE:
    !m_cmd_term_ok
    m_cmd_resize_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_COMMAND_RESIZE, RPC_M_COMMAND_RESIZE_LEN)
    m_cmd_resize_ok = sge m_cmd_resize_idx, 0
    !m_cmd_resize_idx
    br m_cmd_resize_ok -> L_RPC_COMMAND_RESIZE, L_RPC_TRY_PROCESS_SPAWN

L_RPC_COMMAND_RESIZE:
    !m_cmd_resize_ok
    call @send_wrapped_const_with_id(&req, &rpc_id_ptr, rpc_id_len, &J_FS_OK_TRUE, J_FS_OK_TRUE_LEN)
    jmp L_RPC_DONE

L_RPC_TRY_PROCESS_SPAWN:
    !m_cmd_resize_ok
    m_proc_spawn_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_PROCESS_SPAWN, RPC_M_PROCESS_SPAWN_LEN)
    m_proc_spawn_ok = sge m_proc_spawn_idx, 0
    !m_proc_spawn_idx
    br m_proc_spawn_ok -> L_RPC_PROCESS_SPAWN, L_RPC_TRY_PROCESS_WRITE_STDIN

L_RPC_PROCESS_SPAWN:
    !m_proc_spawn_ok
    call @send_rpc_process_spawn(&req, &rpc_id_ptr, rpc_id_len, &state_ptr, &rpc_body_ptr, rpc_body_len)
    jmp L_RPC_DONE

L_RPC_TRY_PROCESS_WRITE_STDIN:
    !m_proc_spawn_ok
    m_proc_write_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_PROCESS_WRITE_STDIN, RPC_M_PROCESS_WRITE_STDIN_LEN)
    m_proc_write_ok = sge m_proc_write_idx, 0
    !m_proc_write_idx
    br m_proc_write_ok -> L_RPC_PROCESS_WRITE_STDIN, L_RPC_TRY_PROCESS_KILL

L_RPC_PROCESS_WRITE_STDIN:
    !m_proc_write_ok
    call @send_wrapped_const_with_id(&req, &rpc_id_ptr, rpc_id_len, &J_FS_OK_TRUE, J_FS_OK_TRUE_LEN)
    jmp L_RPC_DONE

L_RPC_TRY_PROCESS_KILL:
    !m_proc_write_ok
    m_proc_kill_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_PROCESS_KILL, RPC_M_PROCESS_KILL_LEN)
    m_proc_kill_ok = sge m_proc_kill_idx, 0
    !m_proc_kill_idx
    br m_proc_kill_ok -> L_RPC_PROCESS_KILL, L_RPC_TRY_PROCESS_RESIZE

L_RPC_PROCESS_KILL:
    !m_proc_kill_ok
    call @send_rpc_process_kill(&req, &rpc_id_ptr, rpc_id_len, &state_ptr, &rpc_body_ptr, rpc_body_len)
    jmp L_RPC_DONE

L_RPC_TRY_PROCESS_RESIZE:
    !m_proc_kill_ok
    m_proc_resize_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_PROCESS_RESIZE, RPC_M_PROCESS_RESIZE_LEN)
    m_proc_resize_ok = sge m_proc_resize_idx, 0
    !m_proc_resize_idx
    br m_proc_resize_ok -> L_RPC_PROCESS_RESIZE, L_RPC_UNKNOWN

L_RPC_PROCESS_RESIZE:
    !m_proc_resize_ok
    call @send_wrapped_const_with_id(&req, &rpc_id_ptr, rpc_id_len, &J_FS_OK_TRUE, J_FS_OK_TRUE_LEN)
    jmp L_RPC_DONE

L_RPC_UNKNOWN:
    !m_proc_resize_ok
    call @send_error_with_id(&req, 200, &rpc_id_ptr, rpc_id_len, &J_ERR_NOT_FOUND, J_ERR_NOT_FOUND_LEN)
    jmp L_RPC_DONE

L_RPC_DONE:
    !rpc_id_ptr
    !rpc_id_len
    !req
    !rpc_body_ptr
    !rpc_body_len
    !state_ptr
    !cfg_ptr
    return 0

// ============================================================
// @main — Entry point
// ============================================================
@ffi_wrapper handle_http_request(^req: ptr, &state_ptr: ptr, &cfg_ptr: ptr) -> u32:
L_ENTRY:
    method_ptr_slot = stack_alloc 8
    method_len_slot = stack_alloc 8
    path_ptr_slot = stack_alloc 8
    path_len_slot = stack_alloc 8

    method_status = call @sa_http_server_req_get_method(req, &method_ptr_slot, &method_len_slot)
    method_ptr = load method_ptr_slot+0 as ptr
    method_len = load method_len_slot+0 as u64
    !method_status

    // Extract request path before auth so health endpoints stay public.
    path_status = call @sa_http_server_req_get_path(req, &path_ptr_slot, &path_len_slot)
    path_ptr = load path_ptr_slot+0 as ptr
    path_len = load path_len_slot+0 as u64
    !path_status

    is_get_raw = call @sa_bytes_eq(&method_ptr, method_len, &METHOD_GET, METHOD_GET_LEN)
    is_get = eq is_get_raw, 1
    !is_get_raw
    is_post_raw = call @sa_bytes_eq(&method_ptr, method_len, &METHOD_POST, METHOD_POST_LEN)
    is_post = eq is_post_raw, 1
    !is_post_raw

    // --- Route: /healthz ---
    is_health = call @sa_bytes_eq(&path_ptr, path_len, &ROUTE_HEALTH, ROUTE_HEALTH_LEN)
    is_health_path = eq is_health, 1
    is_health_ok = and is_health_path, is_get
    !is_health
    !is_health_path
    br is_health_ok -> L_HEALTH, L_CHECK_READY

L_CHECK_READY:
    !is_health_ok
    is_ready = call @sa_bytes_eq(&path_ptr, path_len, &ROUTE_READY, ROUTE_READY_LEN)
    is_ready_path = eq is_ready, 1
    is_ready_ok = and is_ready_path, is_get
    !is_ready
    !is_ready_path
    br is_ready_ok -> L_READY, L_CHECK_PUBLIC_MODELS

L_CHECK_PUBLIC_MODELS:
    !is_ready_ok
    is_models_public = call @sa_bytes_eq(&path_ptr, path_len, &ROUTE_MODELS, ROUTE_MODELS_LEN)
    is_models_public_path = eq is_models_public, 1
    is_models_public_ok = and is_models_public_path, is_get
    !is_models_public
    !is_models_public_path
    br is_models_public_ok -> L_PROXY_MODELS_PUBLIC, L_AUTH_PREP

L_AUTH_PREP:
    !is_models_public_ok
    // --- Auth interceptor (for all non-health routes) ---
    auth_token_ptr = load cfg_ptr+CFG_AUTH_PTR as ptr
    auth_token_len = load cfg_ptr+CFG_AUTH_LEN as u64
    auth_ok = call @check_auth(&req, &auth_token_ptr, auth_token_len)
    is_authed = eq auth_ok, 1
    !auth_ok
    br is_authed -> L_AUTHED, L_NO_AUTH

L_NO_AUTH:
    !is_authed
    noauth_chat_raw = call @sa_bytes_eq(&path_ptr, path_len, &ROUTE_CHAT, ROUTE_CHAT_LEN)
    noauth_chat = eq noauth_chat_raw, 1
    !noauth_chat_raw
    noauth_resp_raw = call @sa_bytes_eq(&path_ptr, path_len, &ROUTE_RESP, ROUTE_RESP_LEN)
    noauth_resp = eq noauth_resp_raw, 1
    !noauth_resp_raw
    noauth_v1 = or noauth_chat, noauth_resp
    !noauth_chat
    !noauth_resp
    noauth_rpc_raw = call @sa_bytes_eq(&path_ptr, path_len, &ROUTE_RPC, ROUTE_RPC_LEN)
    noauth_rpc = eq noauth_rpc_raw, 1
    !noauth_rpc_raw
    noauth_api = or noauth_v1, noauth_rpc
    !noauth_v1
    !noauth_rpc
    noauth_body_ptr_slot = stack_alloc 8
    noauth_body_len_slot = stack_alloc 8
    br noauth_api -> L_NO_AUTH_API_LOG, L_NO_AUTH_SKIP_API_LOG

L_NO_AUTH_API_LOG:
    !noauth_api
    noauth_body_status = call @sa_http_server_req_get_body(req, &noauth_body_ptr_slot, &noauth_body_len_slot)
    noauth_body_ptr = load noauth_body_ptr_slot+0 as ptr
    noauth_body_len = load noauth_body_len_slot+0 as u64
    noauth_req_log_status = call @write_api_request_log(&req, &cfg_ptr, &path_ptr, path_len, &method_ptr, method_len, &noauth_body_ptr, noauth_body_len)
    !noauth_req_log_status
    !noauth_body_status
    !noauth_body_ptr
    !noauth_body_len
    jmp L_NO_AUTH_WRITE_AUTH_LOG

L_NO_AUTH_SKIP_API_LOG:
    !noauth_api
    jmp L_NO_AUTH_WRITE_AUTH_LOG

L_NO_AUTH_WRITE_AUTH_LOG:
    auth_log_status = call @write_auth_failure_log(&req, &cfg_ptr, &path_ptr, path_len, &auth_token_ptr, auth_token_len)
    !auth_log_status
    !auth_token_ptr
    !auth_token_len
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    call @send_rpc_json(&req, 401, &AUTH_ERR_JSON, AUTH_ERR_LEN)
    call @sa_http_server_req_free(^req)
    !state_ptr
    !cfg_ptr
    return 0

L_AUTHED:
    !is_authed
    !auth_token_ptr
    !auth_token_len

L_CHECK_CHAT:
    is_chat = call @sa_bytes_eq(&path_ptr, path_len, &ROUTE_CHAT, ROUTE_CHAT_LEN)
    is_chat_path = eq is_chat, 1
    is_chat_ok = and is_chat_path, is_post
    !is_chat
    !is_chat_path
    br is_chat_ok -> L_PROXY_CHAT, L_CHECK_RESP

L_CHECK_RESP:
    !is_chat_ok
    is_resp = call @sa_bytes_eq(&path_ptr, path_len, &ROUTE_RESP, ROUTE_RESP_LEN)
    is_resp_path = eq is_resp, 1
    is_resp_ok = and is_resp_path, is_post
    !is_resp
    !is_resp_path
    br is_resp_ok -> L_PROXY_RESP, L_CHECK_MODELS

L_CHECK_MODELS:
    !is_resp_ok
    is_models = call @sa_bytes_eq(&path_ptr, path_len, &ROUTE_MODELS, ROUTE_MODELS_LEN)
    is_models_path = eq is_models, 1
    is_models_ok = and is_models_path, is_get
    !is_models
    !is_models_path
    br is_models_ok -> L_PROXY_MODELS, L_CHECK_RPC

L_CHECK_RPC:
    !is_models_ok
    is_rpc = call @sa_bytes_eq(&path_ptr, path_len, &ROUTE_RPC, ROUTE_RPC_LEN)
    is_rpc_path = eq is_rpc, 1
    is_rpc_ok = and is_rpc_path, is_post
    !is_rpc
    !is_rpc_path
    br is_rpc_ok -> L_HANDLE_RPC, L_CHECK_EVENTS

L_CHECK_EVENTS:
    !is_rpc_ok
    is_events = call @sa_bytes_eq(&path_ptr, path_len, &ROUTE_EVENTS, ROUTE_EVENTS_LEN)
    is_events_path = eq is_events, 1
    is_events_ok = and is_events_path, is_get
    !is_events
    !is_events_path
    br is_events_ok -> L_HANDLE_EVENTS, L_NOT_FOUND

L_PROXY_MODELS_PUBLIC:
    is_models_ok = eq is_models_public_ok, 1
    !is_models_public_ok
    jmp L_PROXY_MODELS

// ============================================================
// /healthz and /readyz — Simple 200 OK
// ============================================================
L_HEALTH:
    !is_health_ok
    call @sa_print_bytes(&LOG_HEALTH, LOG_HEALTH_LEN)
    h_resp_slot = stack_alloc 8
    h_status = call @sa_http_server_resp_new(req, 200, &h_resp_slot)
    h_resp = load h_resp_slot+0 as ptr
    h_send = call @sa_http_server_resp_send(h_resp, &OK_JSON, OK_JSON_LEN)
    call @sa_http_server_resp_free(^h_resp)
    !h_send
    !h_status
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    call @sa_http_server_req_free(^req)
    !state_ptr
    !cfg_ptr
    return 0

L_READY:
    !is_ready_ok
    call @sa_print_bytes(&LOG_HEALTH, LOG_HEALTH_LEN)
    rdy_resp_slot = stack_alloc 8
    rdy_status = call @sa_http_server_resp_new(req, 200, &rdy_resp_slot)
    rdy_resp = load rdy_resp_slot+0 as ptr
    rdy_send = call @sa_http_server_resp_send(rdy_resp, &OK_JSON, OK_JSON_LEN)
    call @sa_http_server_resp_free(^rdy_resp)
    !rdy_send
    !rdy_status
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    call @sa_http_server_req_free(^req)
    !state_ptr
    !cfg_ptr
    return 0

// ============================================================
// /v1/chat/completions — Reverse proxy with SSE streaming
// + Token metering from SSE chunks
// ============================================================
L_PROXY_CHAT:
    !is_chat_ok
    call @sa_print_bytes(&LOG_CHAT, LOG_CHAT_LEN)

    // Read request body
    body_ptr_slot = stack_alloc 8
    body_len_slot = stack_alloc 8
    body_status = call @sa_http_server_req_get_body(req, &body_ptr_slot, &body_len_slot)
    body_ptr = load body_ptr_slot+0 as ptr
    body_len = load body_len_slot+0 as u64
    chat_log_status = call @write_api_request_log(&req, &cfg_ptr, &path_ptr, path_len, &method_ptr, method_len, &body_ptr, body_len)
    !chat_log_status
    chat_blank = call @body_is_blank(&body_ptr, body_len)
    chat_blank_ok = eq chat_blank, 1
    br chat_blank_ok -> L_CHAT_EMPTY_BODY, L_CHAT_BODY_OK

L_CHAT_EMPTY_BODY:
    !chat_blank_ok
    !chat_blank
    empty_send_status = call @send_json_response(&req, 400, &EMPTY_BODY_ERR_JSON, EMPTY_BODY_ERR_LEN)
    !empty_send_status
    !body_ptr
    !body_len
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    call @sa_http_server_req_free(^req)
    !state_ptr
    !cfg_ptr
    return 0

L_CHAT_BODY_OK:
    !chat_blank_ok
    !chat_blank
    proxy_body_len_slot = stack_alloc 8
    proxy_body_ptr = call @build_chat_proxy_body(&body_ptr, body_len, &proxy_body_len_slot)
    proxy_body_len = load proxy_body_len_slot+0 as u64

    // Get upstream URL from config
    chat_base_ptr = load cfg_ptr+CFG_CHAT_PTR as ptr
    chat_base_len = load cfg_ptr+CFG_CHAT_LEN as u64
    upstream_len_slot = stack_alloc 8
    upstream_ptr = call @build_proxy_url(&chat_base_ptr, chat_base_len, &UP_CHAT_SUFFIX, UP_CHAT_SUFFIX_LEN, &upstream_len_slot)
    upstream_len = load upstream_len_slot+0 as u64
    api_key_ptr = load cfg_ptr+CFG_KEY_PTR as ptr
    api_key_len = load cfg_ptr+CFG_KEY_LEN as u64
    up_auth_buf = stack_alloc UP_AUTH_BUF_SIZE
    up_auth_dst = ptr_add up_auth_buf, 0
    up_auth_prefix = call @sa_bytes_copy(&up_auth_dst, &BEARER_PREFIX, BEARER_PREFIX_LEN)
    !up_auth_prefix
    !up_auth_dst
    up_auth_key_dst = ptr_add up_auth_buf, BEARER_PREFIX_LEN
    up_auth_key_copy = call @sa_bytes_copy(&up_auth_key_dst, &api_key_ptr, api_key_len)
    !up_auth_key_copy
    !up_auth_key_dst
    up_auth_len = add api_key_len, BEARER_PREFIX_LEN

    // Create outbound HTTP client (TLS=1)
    client_slot = stack_alloc 8
    client_status = call @sa_http_client_new(1, &client_slot)
    client = load client_slot+0 as ptr

    // Create outbound request (POST)
    out_req_slot = stack_alloc 8
    out_status = call @sa_http_client_req_new(client, 2, &upstream_ptr, upstream_len, &out_req_slot)
    out_req = load out_req_slot+0 as ptr

    // Match Deno forwardHeaders: upstream sees Bearer auth and raw x-api-key.
    call @sa_http_client_req_add_header(out_req, &HDR_AUTH, HDR_AUTH_LEN, &up_auth_buf, up_auth_len)
    call @sa_http_client_req_add_header(out_req, &HDR_X_API_KEY, HDR_X_API_KEY_LEN, &api_key_ptr, api_key_len)

    // Add Content-Type header
    call @sa_http_client_req_add_header(out_req, &HDR_CONTENT_TYPE, HDR_CONTENT_TYPE_LEN, &MIME_JSON, MIME_JSON_LEN)

    // Set request body
    call @sa_http_client_req_set_body(out_req, &proxy_body_ptr, proxy_body_len)

    // Send request
    out_resp_slot = stack_alloc 8
    send_status = call @sa_http_client_req_send(out_req, &out_resp_slot)
    out_resp = load out_resp_slot+0 as ptr

    up_status = call @sa_http_client_resp_status(out_resp)

    ct_ptr_slot = stack_alloc 8
    ct_len_slot = stack_alloc 8
    store ct_ptr_slot+0, 0 as ptr
    store ct_len_slot+0, 0 as u64
    ct_status = call @sa_http_client_resp_get_header(out_resp, &HDR_CONTENT_TYPE, HDR_CONTENT_TYPE_LEN, &ct_ptr_slot, &ct_len_slot)
    ct_ptr = load ct_ptr_slot+0 as ptr
    ct_len = load ct_len_slot+0 as u64
    !ct_status
    ct_has_len = ugt ct_len, 0
    br ct_has_len -> L_CHAT_CT_FIND, L_CHAT_NON_SSE_DEFAULT

L_CHAT_CT_FIND:
    !ct_has_len
    ct_idx = call @sa_bytes_find(&ct_ptr, ct_len, &MIME_EVENT_STREAM, MIME_EVENT_STREAM_LEN)
    ct_is_sse = sge ct_idx, 0
    br ct_is_sse -> L_CHAT_STREAM_START, L_CHAT_NON_SSE_HEADER

L_CHAT_NON_SSE_DEFAULT:
    !ct_has_len
    !ct_ptr
    !ct_len
    chat_body_ptr_slot = stack_alloc 8
    chat_body_len_slot = stack_alloc 8
    chat_body_status = call @sa_http_client_resp_body_slice(out_resp, &chat_body_ptr_slot, &chat_body_len_slot)
    chat_body_ptr = load chat_body_ptr_slot+0 as ptr
    chat_body_len = load chat_body_len_slot+0 as u64
    chat_resp_slot = stack_alloc 8
    chat_resp_status = call @sa_http_server_resp_new(req, up_status, &chat_resp_slot)
    chat_resp = load chat_resp_slot+0 as ptr
    chat_set_ct = call @sa_http_server_resp_set_content_type(chat_resp, &MIME_JSON, MIME_JSON_LEN)
    chat_send_back = call @sa_http_server_resp_send(chat_resp, &chat_body_ptr, chat_body_len)
    call @sa_http_server_resp_free(^chat_resp)
    call @sa_http_client_resp_free(^out_resp)
    call @sa_http_client_req_free(^out_req)
    call @sa_http_client_free(^client)
    !chat_body_status
    !chat_body_ptr
    !chat_body_len
    !chat_resp_status
    !chat_set_ct
    !chat_send_back
    !proxy_body_ptr
    !proxy_body_len
    !up_status
    !upstream_ptr
    !chat_base_ptr
    !chat_base_len
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    call @sa_http_server_req_free(^req)
    !state_ptr
    !cfg_ptr
    return 0

L_CHAT_NON_SSE_HEADER:
    !ct_is_sse
    !ct_idx
    chat_h_body_ptr_slot = stack_alloc 8
    chat_h_body_len_slot = stack_alloc 8
    chat_h_body_status = call @sa_http_client_resp_body_slice(out_resp, &chat_h_body_ptr_slot, &chat_h_body_len_slot)
    chat_h_body_ptr = load chat_h_body_ptr_slot+0 as ptr
    chat_h_body_len = load chat_h_body_len_slot+0 as u64
    chat_h_resp_slot = stack_alloc 8
    chat_h_resp_status = call @sa_http_server_resp_new(req, up_status, &chat_h_resp_slot)
    chat_h_resp = load chat_h_resp_slot+0 as ptr
    chat_h_set_ct = call @sa_http_server_resp_set_content_type(chat_h_resp, &ct_ptr, ct_len)
    chat_h_send_back = call @sa_http_server_resp_send(chat_h_resp, &chat_h_body_ptr, chat_h_body_len)
    call @sa_http_server_resp_free(^chat_h_resp)
    call @sa_http_client_resp_free(^out_resp)
    call @sa_http_client_req_free(^out_req)
    call @sa_http_client_free(^client)
    !chat_h_body_status
    !chat_h_body_ptr
    !chat_h_body_len
    !chat_h_resp_status
    !chat_h_set_ct
    !chat_h_send_back
    !proxy_body_ptr
    !proxy_body_len
    !ct_ptr
    !ct_len
    !up_status
    !upstream_ptr
    !chat_base_ptr
    !chat_base_len
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    call @sa_http_server_req_free(^req)
    !state_ptr
    !cfg_ptr
    return 0

L_CHAT_STREAM_START:
    !ct_is_sse
    !ct_idx
    !ct_ptr
    !ct_len
    // Create streaming response back to client
    stream_slot = stack_alloc 8
    stream_status = call @sa_http_server_resp_stream_new(req, up_status, &stream_slot)
    stream = load stream_slot+0 as ptr
    !up_status

    // Get body reader for chunked reading
    reader_slot = stack_alloc 8
    reader_status = call @sa_http_client_resp_body_reader(out_resp, &reader_slot)
    reader = load reader_slot+0 as ptr

    // Allocate SSE buffer
    sse_buf = stack_alloc SSE_BUF_SIZE
    read_len_slot = stack_alloc 8

    // Token accumulator
    total_tokens_slot = stack_alloc 8
    store total_tokens_slot+0, 0 as u64

    call @sa_print_bytes(&LOG_STREAM, LOG_STREAM_LEN)

// Stream loop: read chunks from upstream, write to client
L_STREAM_LOOP:
    chunk_status = call @sa_http_client_resp_read_chunk(reader, &sse_buf, SSE_BUF_SIZE, &read_len_slot)
    chunk_len = load read_len_slot+0 as u64
    is_eos = eq chunk_len, 0
    br is_eos -> L_STREAM_END, L_STREAM_WRITE

L_STREAM_WRITE:
    !is_eos
    // Write chunk to client
    write_status = call @sa_http_server_resp_stream_write(stream, &sse_buf, chunk_len)
    flush_status = call @sa_http_server_resp_stream_flush(stream)
    !write_status
    !flush_status

    // --- Token metering: scan chunk for usage data ---
    chunk_tokens = call @scan_chunk_for_tokens(&sse_buf, chunk_len)
    has_tokens = ugt chunk_tokens, 0
    br has_tokens -> L_ACCUM_TOKENS, L_NO_ACCUM_TOKENS

L_ACCUM_TOKENS:
    !has_tokens
    cur_total = load total_tokens_slot+0 as u64
    new_total = add cur_total, chunk_tokens
    store total_tokens_slot+0, new_total as u64
    !new_total
    !cur_total
    !chunk_tokens
    jmp L_STREAM_NEXT

L_NO_ACCUM_TOKENS:
    !has_tokens
    !chunk_tokens
    jmp L_STREAM_NEXT

L_STREAM_NEXT:
    !chunk_len
    !chunk_status
    jmp L_STREAM_LOOP

L_STREAM_END:
    !is_eos
    !chunk_len
    !chunk_status

    // Log total tokens used
    final_tokens = load total_tokens_slot+0 as u64
    tok_used = ugt final_tokens, 0
    br tok_used -> L_LOG_TOKENS, L_SKIP_TOKENS

L_LOG_TOKENS:
    !tok_used
    call @sa_print_bytes(&LOG_TOK, LOG_TOK_LEN)
    // (In production, would write final_tokens to state here)
    !final_tokens
    jmp L_STREAM_DONE

L_SKIP_TOKENS:
    !tok_used
    !final_tokens
    jmp L_STREAM_DONE

L_STREAM_DONE:
    call @sa_print_bytes(&LOG_DONE, LOG_DONE_LEN)

    // End the chunked stream
    end_status = call @sa_http_server_resp_stream_end(stream)
    !end_status

    // Release all proxy handles
    call @sa_http_client_body_reader_free(^reader)
    call @sa_http_client_resp_free(^out_resp)
    call @sa_http_client_req_free(^out_req)
    call @sa_http_client_free(^client)
    call @sa_http_server_resp_stream_free(^stream)
    !proxy_body_ptr
    !proxy_body_len
    !upstream_ptr
    !chat_base_ptr
    !chat_base_len
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    call @sa_http_server_req_free(^req)
    !state_ptr
    !cfg_ptr
    return 0

// ============================================================
// /v1/responses — Reverse proxy with streaming
// ============================================================
L_PROXY_RESP:
    !is_resp_ok
    call @sa_print_bytes(&LOG_RESP, LOG_RESP_LEN)

    r_body_ptr_slot = stack_alloc 8
    r_body_len_slot = stack_alloc 8
    r_body_status = call @sa_http_server_req_get_body(req, &r_body_ptr_slot, &r_body_len_slot)
    r_body_ptr = load r_body_ptr_slot+0 as ptr
    r_body_len = load r_body_len_slot+0 as u64
    resp_log_status = call @write_api_request_log(&req, &cfg_ptr, &path_ptr, path_len, &method_ptr, method_len, &r_body_ptr, r_body_len)
    !resp_log_status
    resp_blank = call @body_is_blank(&r_body_ptr, r_body_len)
    resp_blank_ok = eq resp_blank, 1
    br resp_blank_ok -> L_RESP_EMPTY_BODY, L_RESP_BODY_OK

L_RESP_EMPTY_BODY:
    !resp_blank_ok
    !resp_blank
    resp_empty_send_status = call @send_json_response(&req, 400, &EMPTY_BODY_ERR_JSON, EMPTY_BODY_ERR_LEN)
    !resp_empty_send_status
    !r_body_ptr
    !r_body_len
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    call @sa_http_server_req_free(^req)
    !state_ptr
    !cfg_ptr
    return 0

L_RESP_BODY_OK:
    !resp_blank_ok
    !resp_blank
    r_proxy_body_len_slot = stack_alloc 8
    r_is_gemini = call @body_is_gemini_responses_request(&r_body_ptr, r_body_len)
    r_proxy_pre_len_slot = stack_alloc 8
    r_proxy_pre_ptr = call @build_responses_proxy_body(&r_body_ptr, r_body_len, r_is_gemini, &r_proxy_pre_len_slot)
    r_proxy_pre_len = load r_proxy_pre_len_slot+0 as u64
    r_proxy_norm_handle = call @sa_deno_responses_request_normalize(&r_proxy_pre_ptr, r_proxy_pre_len)
    r_proxy_norm_ptr = call @sa_fs_read_buffer_data(r_proxy_norm_handle)
    r_proxy_norm_len = call @sa_fs_read_buffer_len(r_proxy_norm_handle)
    r_proxy_body_ptr = alloc r_proxy_norm_len
    r_proxy_copy_status = call @sa_bytes_copy(&r_proxy_body_ptr, &r_proxy_norm_ptr, r_proxy_norm_len)
    !r_proxy_copy_status
    store r_proxy_body_len_slot+0, r_proxy_norm_len as u64
    r_proxy_body_len = load r_proxy_body_len_slot+0 as u64
    r_proxy_norm_free = call @sa_fs_read_buffer_free(^r_proxy_norm_handle)
    !r_proxy_norm_free
    !r_proxy_norm_ptr
    !r_proxy_norm_len
    !r_proxy_pre_ptr
    !r_proxy_pre_len
    !r_is_gemini
    jmp L_RESP_HAVE_PROXY_BODY

L_RESP_HAVE_PROXY_BODY:

    r_fb_len_slot = stack_alloc 8
    r_base_ptr = load cfg_ptr+CFG_RBASE_PTR as ptr
    r_base_len = load cfg_ptr+CFG_RBASE_LEN as u64
    r_api_key_ptr = load cfg_ptr+CFG_KEY_PTR as ptr
    r_api_key_len = load cfg_ptr+CFG_KEY_LEN as u64
    r_up_auth_buf = stack_alloc UP_AUTH_BUF_SIZE
    r_up_auth_dst = ptr_add r_up_auth_buf, 0
    r_up_auth_prefix = call @sa_bytes_copy(&r_up_auth_dst, &BEARER_PREFIX, BEARER_PREFIX_LEN)
    !r_up_auth_prefix
