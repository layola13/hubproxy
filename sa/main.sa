// ============================================================
// Helper: send_rpc_json(req, status_code, json_ptr, json_len)
// Sends a JSON response on the given request.
// ============================================================
@ffi_wrapper send_rpc_json(&req: ptr, status: u16, &json_ptr: ptr, json_len: u64) -> u32:
L_ENTRY:
    resp_slot = stack_alloc 8
    s = call @sa_http_server_resp_new(req, status, &resp_slot)
    resp = load resp_slot+0 as ptr
    send_s = call @sa_http_server_resp_send(resp, &json_ptr, json_len)
    !send_s
    !s
    call @sa_http_server_resp_free(^resp)
    return 0

@ffi_wrapper send_json_response(&req: ptr, status: u16, &json_ptr: ptr, json_len: u64) -> u32:
L_ENTRY:
    resp_slot = stack_alloc 8
    s = call @sa_http_server_resp_new(req, status, &resp_slot)
    resp = load resp_slot+0 as ptr
    ct_s = call @sa_http_server_resp_set_content_type(resp, &MIME_JSON, MIME_JSON_LEN)
    send_s = call @sa_http_server_resp_send(resp, &json_ptr, json_len)
    !send_s
    !ct_s
    !s
    call @sa_http_server_resp_free(^resp)
    return 0

@ffi_wrapper log_append_token_preview(&buf: ptr, &token_ptr: ptr, token_len: u64) -> u32:
L_ENTRY:
    no_token = eq token_len, 0
    br no_token -> L_LOG_TOKEN_NONE, L_LOG_TOKEN_PREP

L_LOG_TOKEN_NONE:
    !no_token
    call @rpc_builder_append(&buf, &LOG_PREVIEW_NONE, LOG_PREVIEW_NONE_LEN)
    !buf
    !token_ptr
    !token_len
    return 0

L_LOG_TOKEN_PREP:
    !no_token
    prefix_len = add token_len, 0
    prefix_big = ugt prefix_len, 3
    br prefix_big -> L_LOG_PREFIX_THREE, L_LOG_PREFIX_KEEP

L_LOG_PREFIX_THREE:
    !prefix_big
    !prefix_len
    prefix_len2 = add 3, 0
    jmp L_LOG_TOKEN_APPEND_PREFIX

L_LOG_PREFIX_KEEP:
    !prefix_big
    prefix_len2 = add prefix_len, 0
    !prefix_len
    jmp L_LOG_TOKEN_APPEND_PREFIX

L_LOG_TOKEN_APPEND_PREFIX:
    call @rpc_builder_append(&buf, &token_ptr, prefix_len2)
    call @rpc_builder_append(&buf, &LOG_PREVIEW_ELLIPSIS, LOG_PREVIEW_ELLIPSIS_LEN)
    suffix_len = add token_len, 0
    suffix_big = ugt suffix_len, 3
    br suffix_big -> L_LOG_SUFFIX_THREE, L_LOG_SUFFIX_KEEP

L_LOG_SUFFIX_THREE:
    !suffix_big
    !suffix_len
    suffix_len2 = add 3, 0
    jmp L_LOG_TOKEN_APPEND_SUFFIX

L_LOG_SUFFIX_KEEP:
    !suffix_big
    suffix_len2 = add suffix_len, 0
    !suffix_len
    jmp L_LOG_TOKEN_APPEND_SUFFIX

L_LOG_TOKEN_APPEND_SUFFIX:
    suffix_start = sub token_len, suffix_len2
    suffix_ptr = ptr_add token_ptr, suffix_start
    call @rpc_builder_append(&buf, &suffix_ptr, suffix_len2)
    call @rpc_builder_append(&buf, &LOG_PREVIEW_LEN_A, LOG_PREVIEW_LEN_A_LEN)
    len_buf = stack_alloc 32
    len_out_slot = stack_alloc 8
    fmt_status = call @sa_fmt_u64_into(token_len, 10, len_buf, 32, &len_out_slot)
    len_text_len = load len_out_slot+0 as u64
    !fmt_status
    call @rpc_builder_append(&buf, &len_buf, len_text_len)
    call @rpc_builder_append(&buf, &LOG_PREVIEW_LEN_B, LOG_PREVIEW_LEN_B_LEN)
    !len_text_len
    !suffix_ptr
    !suffix_start
    !suffix_len2
    !prefix_len2
    !buf
    !token_ptr
    !token_len
    return 0

@ffi_wrapper write_auth_failure_log(&req: ptr, &cfg_ptr: ptr, &path_ptr: ptr, path_len: u64, &token_ptr: ptr, token_len: u64) -> u32:
L_ENTRY:
    log_dir_ptr = load cfg_ptr+CFG_LOG_PTR as ptr
    log_dir_len = load cfg_ptr+CFG_LOG_LEN as u64
    has_log = ugt log_dir_len, 0
    br has_log -> L_AUTH_LOG_BUILD, L_AUTH_LOG_SKIP

L_AUTH_LOG_SKIP:
    !has_log
    !log_dir_ptr
    !log_dir_len
    !req
    !cfg_ptr
    !path_ptr
    !path_len
    !token_ptr
    !token_len
    return 0

L_AUTH_LOG_BUILD:
    !has_log
    mkdir_status = call @sa_fs_make_dir(&log_dir_ptr, log_dir_len)
    !mkdir_status
    file_len = add log_dir_len, LOG_FILE_AUTH_SUFFIX_LEN
    file_path = alloc file_len
    file_dst = ptr_add file_path, 0
    copy_dir = call @sa_bytes_copy(&file_dst, &log_dir_ptr, log_dir_len)
    !copy_dir
    !file_dst
    file_suffix_dst = ptr_add file_path, log_dir_len
    copy_suffix = call @sa_bytes_copy(&file_suffix_dst, &LOG_FILE_AUTH_SUFFIX, LOG_FILE_AUTH_SUFFIX_LEN)
    !copy_suffix
    !file_suffix_dst
    result = call @rpc_builder_new()
    call @rpc_builder_append(&result, &LOG_AUTH_JSON_A, LOG_AUTH_JSON_A_LEN)
    call @rpc_builder_append_json_string(&result, &path_ptr, path_len)
    call @rpc_builder_append(&result, &LOG_AUTH_JSON_B, LOG_AUTH_JSON_B_LEN)
    log_auth_slot = stack_alloc 8
    log_auth_len_slot = stack_alloc 8
    store log_auth_slot+0, 0 as ptr
    store log_auth_len_slot+0, 0 as u64
    hdr_status = call @sa_http_server_req_get_header(req, &HDR_AUTH, HDR_AUTH_LEN, &log_auth_slot, &log_auth_len_slot)
    hdr_ptr = load log_auth_slot+0 as ptr
    hdr_len = load log_auth_len_slot+0 as u64
    !hdr_status
    has_hdr = ne hdr_ptr, 0
    br has_hdr -> L_AUTH_LOG_HEADER_PREVIEW, L_AUTH_LOG_HEADER_NONE

L_AUTH_LOG_HEADER_PREVIEW:
    !has_hdr
    bearer_idx = call @sa_bytes_find(&hdr_ptr, hdr_len, &BEARER_PREFIX, BEARER_PREFIX_LEN)
    has_bearer = sge bearer_idx, 0
    br has_bearer -> L_AUTH_LOG_HEADER_STRIP, L_AUTH_LOG_HEADER_RAW

L_AUTH_LOG_HEADER_STRIP:
    !has_bearer
    !bearer_idx
    client_ptr = ptr_add hdr_ptr, BEARER_PREFIX_LEN
    client_len = sub hdr_len, BEARER_PREFIX_LEN
    preview_status = call @log_append_token_preview(&result, &client_ptr, client_len)
    !preview_status
    !client_ptr
    !client_len
    !hdr_ptr
    !hdr_len
    jmp L_AUTH_LOG_EXPECTED

L_AUTH_LOG_HEADER_RAW:
    !has_bearer
    !bearer_idx
    client_ptr2 = ptr_add hdr_ptr, 0
    client_len2 = add hdr_len, 0
    preview_status2 = call @log_append_token_preview(&result, &client_ptr2, client_len2)
    !preview_status2
    !client_ptr2
    !client_len2
    !hdr_ptr
    !hdr_len
    jmp L_AUTH_LOG_EXPECTED

L_AUTH_LOG_HEADER_NONE:
    !has_hdr
    !hdr_ptr
    !hdr_len
    call @rpc_builder_append(&result, &LOG_PREVIEW_NONE, LOG_PREVIEW_NONE_LEN)
    jmp L_AUTH_LOG_EXPECTED

L_AUTH_LOG_EXPECTED:
    call @rpc_builder_append(&result, &LOG_AUTH_JSON_C, LOG_AUTH_JSON_C_LEN)
    expected_status = call @log_append_token_preview(&result, &token_ptr, token_len)
    !expected_status
    call @rpc_builder_append(&result, &LOG_AUTH_JSON_D, LOG_AUTH_JSON_D_LEN)
    body_ptr = call @rpc_builder_data(&result)
    body_len = call @rpc_builder_len(&result)
    write_status = call @sa_fs_write_file(&file_path, file_len, &body_ptr, body_len)
    !write_status
    !body_ptr
    !body_len
    !result
    !file_path
    !file_len
    !log_dir_ptr
    !log_dir_len
    !req
    !cfg_ptr
    !path_ptr
    !path_len
    !token_ptr
    !token_len
    return 0

@ffi_wrapper write_api_request_log(&req: ptr, &cfg_ptr: ptr, &path_ptr: ptr, path_len: u64, &method_ptr: ptr, method_len: u64, &body_ptr_in: ptr, body_len: u64) -> u32:
L_ENTRY:
    log_dir_ptr = load cfg_ptr+CFG_LOG_PTR as ptr
    log_dir_len = load cfg_ptr+CFG_LOG_LEN as u64
    has_log = ugt log_dir_len, 0
    br has_log -> L_REQ_LOG_BUILD, L_REQ_LOG_SKIP

L_REQ_LOG_SKIP:
    !has_log
    !log_dir_ptr
    !log_dir_len
    !req
    !cfg_ptr
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !body_ptr_in
    !body_len
    return 0

L_REQ_LOG_BUILD:
    !has_log
    mkdir_status = call @sa_fs_make_dir(&log_dir_ptr, log_dir_len)
    !mkdir_status
    file_len = add log_dir_len, LOG_FILE_REQ_SUFFIX_LEN
    file_path = alloc file_len
    file_dst = ptr_add file_path, 0
    copy_dir = call @sa_bytes_copy(&file_dst, &log_dir_ptr, log_dir_len)
    !copy_dir
    !file_dst
    file_suffix_dst = ptr_add file_path, log_dir_len
    copy_suffix = call @sa_bytes_copy(&file_suffix_dst, &LOG_FILE_REQ_SUFFIX, LOG_FILE_REQ_SUFFIX_LEN)
    !copy_suffix
    !file_suffix_dst

    result = call @rpc_builder_new()
    call @rpc_builder_append(&result, &LOG_REQ_JSON_A, LOG_REQ_JSON_A_LEN)
    call @rpc_builder_append_json_string(&result, &path_ptr, path_len)
    call @rpc_builder_append(&result, &LOG_REQ_JSON_B, LOG_REQ_JSON_B_LEN)
    call @rpc_builder_append(&result, &method_ptr, method_len)
    call @rpc_builder_append(&result, &LOG_REQ_JSON_C, LOG_REQ_JSON_C_LEN)
    auth_ptr_slot = stack_alloc 8
    auth_len_slot = stack_alloc 8
    store auth_ptr_slot+0, 0 as ptr
    store auth_len_slot+0, 0 as u64
    auth_hdr_status = call @sa_http_server_req_get_header(req, &HDR_AUTH, HDR_AUTH_LEN, &auth_ptr_slot, &auth_len_slot)
    auth_hdr_ptr = load auth_ptr_slot+0 as ptr
    auth_hdr_len = load auth_len_slot+0 as u64
    !auth_hdr_status
    auth_has_hdr = ne auth_hdr_ptr, 0
    br auth_has_hdr -> L_REQ_LOG_AUTH_HEADER, L_REQ_LOG_AUTH_NONE

L_REQ_LOG_AUTH_HEADER:
    !auth_has_hdr
    auth_bearer_idx = call @sa_bytes_find(&auth_hdr_ptr, auth_hdr_len, &BEARER_PREFIX, BEARER_PREFIX_LEN)
    auth_has_bearer = ne auth_bearer_idx, 18446744073709551615
    br auth_has_bearer -> L_REQ_LOG_AUTH_BEARER, L_REQ_LOG_AUTH_RAW

L_REQ_LOG_AUTH_BEARER:
    !auth_has_bearer
    token_start = add auth_bearer_idx, BEARER_PREFIX_LEN
    token_ptr = ptr_add auth_hdr_ptr, token_start
    token_len = sub auth_hdr_len, token_start
    token_preview_status = call @log_append_token_preview(&result, &token_ptr, token_len)
    !token_preview_status
    !token_ptr
    !token_len
    !token_start
    !auth_bearer_idx
    !auth_hdr_ptr
    !auth_hdr_len
    jmp L_REQ_LOG_X_API_KEY

L_REQ_LOG_AUTH_RAW:
    !auth_has_bearer
    !auth_bearer_idx
    auth_raw_ptr = ptr_add auth_hdr_ptr, 0
    auth_raw_len = add auth_hdr_len, 0
    auth_raw_status = call @log_append_token_preview(&result, &auth_raw_ptr, auth_raw_len)
    !auth_raw_status
    !auth_raw_ptr
    !auth_raw_len
    !auth_hdr_ptr
    !auth_hdr_len
    jmp L_REQ_LOG_X_API_KEY

L_REQ_LOG_AUTH_NONE:
    !auth_has_hdr
    !auth_hdr_ptr
    !auth_hdr_len
    call @rpc_builder_append(&result, &LOG_PREVIEW_NONE, LOG_PREVIEW_NONE_LEN)
    jmp L_REQ_LOG_X_API_KEY

L_REQ_LOG_X_API_KEY:
    call @rpc_builder_append(&result, &LOG_REQ_JSON_D, LOG_REQ_JSON_D_LEN)
    xkey_ptr_slot = stack_alloc 8
    xkey_len_slot = stack_alloc 8
    store xkey_ptr_slot+0, 0 as ptr
    store xkey_len_slot+0, 0 as u64
    xkey_hdr_status = call @sa_http_server_req_get_header(req, &HDR_X_API_KEY, HDR_X_API_KEY_LEN, &xkey_ptr_slot, &xkey_len_slot)
    xkey_hdr_ptr = load xkey_ptr_slot+0 as ptr
    xkey_hdr_len = load xkey_len_slot+0 as u64
    !xkey_hdr_status
    xkey_has_hdr = ne xkey_hdr_ptr, 0
    br xkey_has_hdr -> L_REQ_LOG_XKEY_HEADER, L_REQ_LOG_XKEY_NONE

L_REQ_LOG_XKEY_HEADER:
    !xkey_has_hdr
    xkey_status = call @log_append_token_preview(&result, &xkey_hdr_ptr, xkey_hdr_len)
    !xkey_status
    !xkey_hdr_ptr
    !xkey_hdr_len
    jmp L_REQ_LOG_CONTENT_TYPE

L_REQ_LOG_XKEY_NONE:
    !xkey_has_hdr
    !xkey_hdr_ptr
    !xkey_hdr_len
    call @rpc_builder_append(&result, &LOG_PREVIEW_NONE, LOG_PREVIEW_NONE_LEN)
    jmp L_REQ_LOG_CONTENT_TYPE

L_REQ_LOG_CONTENT_TYPE:
    call @rpc_builder_append(&result, &LOG_REQ_JSON_E, LOG_REQ_JSON_E_LEN)
    ct_ptr_slot = stack_alloc 8
    ct_len_slot = stack_alloc 8
    store ct_ptr_slot+0, 0 as ptr
    store ct_len_slot+0, 0 as u64
    ct_hdr_status = call @sa_http_server_req_get_header(req, &HDR_CONTENT_TYPE, HDR_CONTENT_TYPE_LEN, &ct_ptr_slot, &ct_len_slot)
    ct_hdr_ptr = load ct_ptr_slot+0 as ptr
    ct_hdr_len = load ct_len_slot+0 as u64
    !ct_hdr_status
    ct_has_hdr = ne ct_hdr_ptr, 0
    br ct_has_hdr -> L_REQ_LOG_CT_HEADER, L_REQ_LOG_CT_NONE

L_REQ_LOG_CT_HEADER:
    !ct_has_hdr
    call @rpc_builder_append(&result, &ct_hdr_ptr, ct_hdr_len)
    !ct_hdr_ptr
    !ct_hdr_len
    jmp L_REQ_LOG_BODY_BYTES

L_REQ_LOG_CT_NONE:
    !ct_has_hdr
    !ct_hdr_ptr
    !ct_hdr_len
    call @rpc_builder_append(&result, &LOG_PREVIEW_NONE, LOG_PREVIEW_NONE_LEN)
    jmp L_REQ_LOG_BODY_BYTES

L_REQ_LOG_BODY_BYTES:
    call @rpc_builder_append(&result, &LOG_REQ_JSON_F, LOG_REQ_JSON_F_LEN)
    len_buf = stack_alloc 32
    len_out_slot = stack_alloc 8
    fmt_status = call @sa_fmt_u64_into(body_len, 10, len_buf, 32, &len_out_slot)
    len_text_len = load len_out_slot+0 as u64
    !fmt_status
    call @rpc_builder_append(&result, &len_buf, len_text_len)
    call @rpc_builder_append(&result, &LOG_REQ_JSON_G, LOG_REQ_JSON_G_LEN)
    has_body = ugt body_len, 0
    br has_body -> L_REQ_LOG_BODY_TEXT, L_REQ_LOG_BODY_NULL

L_REQ_LOG_BODY_TEXT:
    !has_body
    call @rpc_builder_append_json_string(&result, &body_ptr_in, body_len)
    jmp L_REQ_LOG_FINISH

L_REQ_LOG_BODY_NULL:
    !has_body
    call @rpc_builder_append(&result, &J_NULL, J_NULL_LEN)
    jmp L_REQ_LOG_FINISH

L_REQ_LOG_FINISH:
    call @rpc_builder_append(&result, &LOG_REQ_JSON_H, LOG_REQ_JSON_H_LEN)
    body_ptr = call @rpc_builder_data(&result)
    log_body_len = call @rpc_builder_len(&result)
    write_status = call @sa_fs_write_file(&file_path, file_len, &body_ptr, log_body_len)
    !write_status
    !body_ptr
    !log_body_len
    !len_text_len
    !result
    !file_path
    !file_len
    !log_dir_ptr
    !log_dir_len
    !req
    !cfg_ptr
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !body_ptr_in
    !body_len
    return 0

@ffi_wrapper body_is_blank(&body: ptr, body_len: u64) -> u32:
L_ENTRY:
    i_slot = stack_alloc 8
    store i_slot+0, 0 as u64
    jmp L_BODY_BLANK_COND

L_BODY_BLANK_COND:
    i = load i_slot+0 as u64
    done = uge i, body_len
    br done -> L_BODY_BLANK_YES, L_BODY_BLANK_CHECK

L_BODY_BLANK_CHECK:
    !done
    ch_ptr = ptr_add body, i
    ch = load ch_ptr+0 as u8
    is_space = eq ch, 32
    is_lf = eq ch, 10
    is_cr = eq ch, 13
    is_tab = eq ch, 9
    ws_a = or is_space, is_lf
    ws_b = or is_cr, is_tab
    is_ws = or ws_a, ws_b
    br is_ws -> L_BODY_BLANK_NEXT, L_BODY_BLANK_NO

L_BODY_BLANK_NEXT:
    !is_ws
    !ws_a
    !ws_b
    !is_space
    !is_lf
    !is_cr
    !is_tab
    !ch
    !ch_ptr
    next = add i, 1
    store i_slot+0, next as u64
    !next
    !i
    jmp L_BODY_BLANK_COND

L_BODY_BLANK_NO:
    !is_ws
    !ws_a
    !ws_b
    !is_space
    !is_lf
    !is_cr
    !is_tab
    !ch
    !ch_ptr
    !i
    !body
    !body_len
    return 0

L_BODY_BLANK_YES:
    !done
    !i
    !body
    !body_len
    return 1

@ffi_wrapper rpc_builder_new() -> ^ptr:
L_ENTRY:
    buf = alloc RPC_JSON_BUF_SIZE
    store buf+0, 0 as u64
    return buf

@ffi_wrapper rpc_builder_len(&buf: ptr) -> u64:
L_ENTRY:
    len = load buf+0 as u64
    !buf
    return len

@ffi_wrapper rpc_builder_data(&buf: ptr) -> &ptr:
L_ENTRY:
    data = ptr_add buf, 8
    raw_data = *data
    view = assume_borrow raw_data
    !data
    !buf
    return view

@ffi_wrapper rpc_builder_append(&buf: ptr, &src: ptr, src_len: u64) -> u32:
L_ENTRY:
    cur = load buf+0 as u64
    dst_base = ptr_add buf, 8
    dst = ptr_add dst_base, cur
    copied = call @sa_bytes_copy(&dst, &src, src_len)
    next = add cur, copied
    store buf+0, next as u64
    !next
    !copied
    !dst
    !dst_base
    !cur
    !buf
    !src
    !src_len
    return 0

@ffi_wrapper build_proxy_url(&base_ptr: ptr, base_len: u64, &suffix_ptr: ptr, suffix_len: u64, &out_len: ptr) -> ^ptr:
L_ENTRY:
    total_len = add base_len, suffix_len
    buf = alloc total_len
    base_dst = ptr_add buf, 0
    base_copy = call @sa_bytes_copy(&base_dst, &base_ptr, base_len)
    !base_copy
    !base_dst
    suffix_dst = ptr_add buf, base_len
    suffix_copy = call @sa_bytes_copy(&suffix_dst, &suffix_ptr, suffix_len)
    !suffix_copy
    !suffix_dst
    store out_len+0, total_len as u64
    !total_len
    !base_ptr
    !base_len
    !suffix_ptr
    !suffix_len
    !out_len
    return buf

@ffi_wrapper rpc_builder_append_u64(&buf: ptr, value: u64) -> u32:
L_ENTRY:
    tmp = stack_alloc ID_BUF_SIZE
    len_slot = stack_alloc 8
    status = call @sa_fmt_u64_into(value, 10, tmp, ID_BUF_SIZE, &len_slot)
    !status
    fmt_len = load len_slot+0 as u64
    append_status = call @rpc_builder_append(&buf, &tmp, fmt_len)
    !append_status
    !fmt_len
    !buf
    !value
    return 0

@ffi_wrapper rpc_builder_append_json_string_inner(&buf: ptr, &src: ptr, src_len: u64) -> u32:
L_ENTRY:
    i_slot = stack_alloc 8
    store i_slot+0, 0 as u64
    jmp L_JSON_INNER_COND

L_JSON_INNER_COND:
    i = load i_slot+0 as u64
    done = uge i, src_len
    br done -> L_JSON_INNER_DONE, L_JSON_INNER_BODY

L_JSON_INNER_BODY:
    !done
    ch_ptr = ptr_add src, i
    ch = load ch_ptr+0 as u8
    is_quote = eq ch, 34
    br is_quote -> L_JSON_INNER_ESC_QUOTE, L_JSON_INNER_CHECK_BS

L_JSON_INNER_CHECK_BS:
    !is_quote
    is_bs = eq ch, 92
    br is_bs -> L_JSON_INNER_ESC_BS, L_JSON_INNER_CHECK_N

L_JSON_INNER_CHECK_N:
    !is_bs
    is_n = eq ch, 10
    br is_n -> L_JSON_INNER_ESC_N, L_JSON_INNER_CHECK_R

L_JSON_INNER_CHECK_R:
    !is_n
    is_r = eq ch, 13
    br is_r -> L_JSON_INNER_ESC_R, L_JSON_INNER_CHECK_T

L_JSON_INNER_CHECK_T:
    !is_r
    is_t = eq ch, 9
    br is_t -> L_JSON_INNER_ESC_T, L_JSON_INNER_RAW

L_JSON_INNER_ESC_QUOTE:
    !is_quote
    call @rpc_builder_append(&buf, &JSON_ESC_QUOTE, JSON_ESC_QUOTE_LEN)
    jmp L_JSON_INNER_NEXT

L_JSON_INNER_ESC_BS:
    !is_bs
    call @rpc_builder_append(&buf, &JSON_ESC_BACKSLASH, JSON_ESC_BACKSLASH_LEN)
    jmp L_JSON_INNER_NEXT

L_JSON_INNER_ESC_N:
    !is_n
    call @rpc_builder_append(&buf, &JSON_ESC_N, JSON_ESC_N_LEN)
    jmp L_JSON_INNER_NEXT

L_JSON_INNER_ESC_R:
    !is_r
    call @rpc_builder_append(&buf, &JSON_ESC_R, JSON_ESC_R_LEN)
    jmp L_JSON_INNER_NEXT

L_JSON_INNER_ESC_T:
    !is_t
    call @rpc_builder_append(&buf, &JSON_ESC_T, JSON_ESC_T_LEN)
    jmp L_JSON_INNER_NEXT

L_JSON_INNER_RAW:
    !is_t
    call @rpc_builder_append(&buf, &ch_ptr, 1)
    jmp L_JSON_INNER_NEXT

L_JSON_INNER_NEXT:
    !ch
    !ch_ptr
    next = add i, 1
    store i_slot+0, next as u64
    !next
    !i
    jmp L_JSON_INNER_COND

L_JSON_INNER_DONE:
    !done
    !i
    !buf
    !src
    !src_len
    return 0

@ffi_wrapper rpc_builder_append_nullable_string(&buf: ptr, &value_ptr: ptr, value_len: u64, is_set: u8) -> u32:
L_ENTRY:
    has_value = eq is_set, 1
    br has_value -> L_STR_VALUE, L_STR_NULL

L_STR_VALUE:
    !has_value
    call @rpc_builder_append(&buf, &J_QUOTE, J_QUOTE_LEN)
    call @rpc_builder_append(&buf, &value_ptr, value_len)
    call @rpc_builder_append(&buf, &J_QUOTE, J_QUOTE_LEN)
    !buf
    !value_ptr
    !value_len
    !is_set
    return 0

L_STR_NULL:
    !has_value
    call @rpc_builder_append(&buf, &J_NULL, J_NULL_LEN)
    !buf
    !value_ptr
    !value_len
    !is_set
    return 0

@ffi_wrapper rpc_builder_append_thread_id_string(&buf: ptr, &state_ptr: ptr, thread_id: u64) -> u32:
L_ENTRY:
    slot = call @state_thread_find(&state_ptr, thread_id)
    missing = eq slot, 0
    br missing -> L_TID_STRING_NUMERIC_MISSING, L_TID_STRING_SLOT

L_TID_STRING_SLOT:
    !missing
    key_len = load slot+THR_KEY_LEN as u64
    has_key = ugt key_len, 0
    br has_key -> L_TID_STRING_KEY, L_TID_STRING_NUMERIC_SLOT

L_TID_STRING_KEY:
    !has_key
    key_ptr = ptr_add slot, THR_KEY
    append_status = call @rpc_builder_append_json_string(&buf, &key_ptr, key_len)
    !append_status
    !key_ptr
    !key_len
    !slot
    !buf
    !state_ptr
    !thread_id
    return 0

L_TID_STRING_NUMERIC_SLOT:
    !has_key
    call @rpc_builder_append(&buf, &J_QUOTE, J_QUOTE_LEN)
    call @rpc_builder_append_u64(&buf, thread_id)
    call @rpc_builder_append(&buf, &J_QUOTE, J_QUOTE_LEN)
    !key_len
    !slot
    !buf
    !state_ptr
    !thread_id
    return 0

L_TID_STRING_NUMERIC_MISSING:
    !missing
    !slot
    call @rpc_builder_append(&buf, &J_QUOTE, J_QUOTE_LEN)
    call @rpc_builder_append_u64(&buf, thread_id)
    call @rpc_builder_append(&buf, &J_QUOTE, J_QUOTE_LEN)
    !buf
    !state_ptr
    !thread_id
    return 0

@ffi_wrapper rpc_builder_append_thread_id_inner(&buf: ptr, &state_ptr: ptr, thread_id: u64) -> u32:
L_ENTRY:
    slot = call @state_thread_find(&state_ptr, thread_id)
    missing = eq slot, 0
    br missing -> L_TID_INNER_NUMERIC_MISSING, L_TID_INNER_SLOT

L_TID_INNER_SLOT:
    !missing
    key_len = load slot+THR_KEY_LEN as u64
    has_key = ugt key_len, 0
    br has_key -> L_TID_INNER_KEY, L_TID_INNER_NUMERIC_SLOT

L_TID_INNER_KEY:
    !has_key
    key_ptr = ptr_add slot, THR_KEY
    append_status = call @rpc_builder_append_json_string_inner(&buf, &key_ptr, key_len)
    !append_status
    !key_ptr
    !key_len
    !slot
    !buf
    !state_ptr
    !thread_id
    return 0

L_TID_INNER_NUMERIC_SLOT:
    !has_key
    call @rpc_builder_append_u64(&buf, thread_id)
    !key_len
    !slot
    !buf
    !state_ptr
    !thread_id
    return 0

L_TID_INNER_NUMERIC_MISSING:
    !missing
    !slot
    call @rpc_builder_append_u64(&buf, thread_id)
    !buf
    !state_ptr
    !thread_id
    return 0

@ffi_wrapper rpc_builder_append_nullable_thread_id_string(&buf: ptr, &state_ptr: ptr, thread_id: u64) -> u32:
L_ENTRY:
    has_value = ne thread_id, 0
    br has_value -> L_TID_NULLABLE_VALUE, L_TID_NULLABLE_NULL

L_TID_NULLABLE_VALUE:
    !has_value
    call @rpc_builder_append_thread_id_string(&buf, &state_ptr, thread_id)
    !buf
    !state_ptr
    !thread_id
