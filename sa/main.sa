@ffi_wrapper send_rpc_fs_readdir(&req: ptr, &id_ptr: ptr, id_len: u64, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    path_ptr_slot = stack_alloc 8
    path_len_slot = stack_alloc 8
    path_status = call @rpc_extract_string_after(&body, body_len, &J_PATH_KEY, J_PATH_KEY_LEN, &path_ptr_slot, &path_len_slot)
    has_path = eq path_status, 1
    !path_status
    br has_path -> L_FS_READDIR_DO, L_FS_READDIR_BAD_PARAMS

L_FS_READDIR_BAD_PARAMS:
    !has_path
    call @send_error_with_id(&req, 400, &id_ptr, id_len, &J_ERR_INVALID_PARAMS, J_ERR_INVALID_PARAMS_LEN)
    !body
    !body_len
    !req
    return 0

L_FS_READDIR_DO:
    !has_path
    path_ptr = load path_ptr_slot+0 as ptr
    path_len = load path_len_slot+0 as u64
    EXPAND DENO_READ_DIR_JSON dir_ptr, dir_len, dir_status, path_ptr, path_len
    dir_ok = eq dir_status, 0
    !dir_status
    br dir_ok -> L_FS_READDIR_OK, L_FS_READDIR_ERR

L_FS_READDIR_ERR:
    !dir_ok
    !path_ptr
    !path_len
    call @send_error_with_id(&req, 500, &id_ptr, id_len, &J_ERR_FS, J_ERR_FS_LEN)
    !body
    !body_len
    !req
    return 0

L_FS_READDIR_OK:
    !dir_ok
    dir_node = call @sa_json_parse(&dir_ptr, dir_len)
    has_dir_node = ne dir_node, 0
    br has_dir_node -> L_FS_READDIR_WRITE_NODE, L_FS_READDIR_WRITE_EMPTY

L_FS_READDIR_WRITE_NODE:
    !has_dir_node
    writer_slot = stack_alloc 8
    writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot)
    writer = load writer_slot+0 as ptr
    begin_status = call @sa_json_writer_begin_object(writer)
    entries_status = call @sa_json_writer_field_node(writer, &JSON_KEY_ENTRIES, JSON_KEY_ENTRIES_LEN, dir_node)
    end_status = call @sa_json_writer_end_object(writer)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    dir_node_free = call @sa_json_free(^dir_node)
    !dir_node_free
    !end_status
    !entries_status
    !begin_status
    !writer_status
    free_status = call @sa_deno_plugin_free_buffer(dir_ptr, dir_len)
    !free_status
    !dir_ptr
    !dir_len
    !path_ptr
    !path_len
    !body
    !body_len
    !req
    return 0

L_FS_READDIR_WRITE_EMPTY:
    !has_dir_node
    !dir_node
    writer_slot_empty = stack_alloc 8
    writer_status_empty = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot_empty)
    writer_empty = load writer_slot_empty+0 as ptr
    begin_status_empty = call @sa_json_writer_begin_object(writer_empty)
    entries_status_empty = call @json_writer_field_empty_array(writer_empty, &JSON_KEY_ENTRIES, JSON_KEY_ENTRIES_LEN)
    end_status_empty = call @sa_json_writer_end_object(writer_empty)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer_empty)
    free_status_empty = call @sa_deno_plugin_free_buffer(dir_ptr, dir_len)
    !free_status_empty
    !end_status_empty
    !entries_status_empty
    !begin_status_empty
    !writer_status_empty
    !dir_ptr
    !dir_len
    !path_ptr
    !path_len
    !body
    !body_len
    !req
    return 0

