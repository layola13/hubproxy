@ffi_wrapper notify_rt_item_value(&state_ptr: ptr, &event_ptr: ptr, event_len: u64, &body: ptr, body_len: u64, &prefix: ptr, prefix_len: u64, &key: ptr, key_len: u64, &suffix: ptr, suffix_len: u64) -> u32:
L_ENTRY:
    result = call @rpc_builder_new()
    call @rpc_builder_append(&result, &J_EVT_THREAD_STR_A, J_EVT_THREAD_STR_A_LEN)
    call @rpc_builder_append_param_raw_or_default(&result, &body, body_len, &J_THREADID_KEY, J_THREADID_KEY_LEN, &EMPTY_TEXT, EMPTY_TEXT_LEN)
    call @rpc_builder_append(&result, &prefix, prefix_len)
    call @rpc_builder_append_param_string_or_null(&result, &body, body_len, &key, key_len)
    call @rpc_builder_append(&result, &suffix, suffix_len)
    params_ptr = call @rpc_builder_data(&result)
    params_len = call @rpc_builder_len(&result)
    call @notify_const_params(&state_ptr, &event_ptr, event_len, &params_ptr, params_len)
    !params_ptr
    !params_len
    !result
    !state_ptr
    !event_ptr
    !event_len
    !body
    !body_len
    !prefix
    !prefix_len
    !key
    !key_len
    !suffix
    !suffix_len
    return 0

@ffi_wrapper notify_rt_role_value(&state_ptr: ptr, &event_ptr: ptr, event_len: u64, &body: ptr, body_len: u64, &value_key: ptr, value_key_len: u64, &mid: ptr, mid_len: u64, &suffix: ptr, suffix_len: u64) -> u32:
L_ENTRY:
    result = call @rpc_builder_new()
    call @rpc_builder_append(&result, &J_EVT_THREAD_STR_A, J_EVT_THREAD_STR_A_LEN)
    call @rpc_builder_append_param_raw_or_default(&result, &body, body_len, &J_THREADID_KEY, J_THREADID_KEY_LEN, &EMPTY_TEXT, EMPTY_TEXT_LEN)
    call @rpc_builder_append(&result, &J_EVT_RT_DELTA_A, J_EVT_RT_DELTA_A_LEN)
    call @rpc_builder_append_param_string_or_default(&result, &body, body_len, &J_ROLE_KEY, J_ROLE_KEY_LEN, &DEFAULT_ASSISTANT, DEFAULT_ASSISTANT_LEN)
    call @rpc_builder_append(&result, &mid, mid_len)
    call @rpc_builder_append_param_string_or_default(&result, &body, body_len, &value_key, value_key_len, &EMPTY_TEXT, EMPTY_TEXT_LEN)
    call @rpc_builder_append(&result, &suffix, suffix_len)
    params_ptr = call @rpc_builder_data(&result)
    params_len = call @rpc_builder_len(&result)
    call @notify_const_params(&state_ptr, &event_ptr, event_len, &params_ptr, params_len)
    !params_ptr
    !params_len
    !result
    !state_ptr
    !event_ptr
    !event_len
    !body
    !body_len
    !value_key
    !value_key_len
    !mid
    !mid_len
    !suffix
    !suffix_len
    return 0

@ffi_wrapper notify_fuzzy_events(&state_ptr: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    updated = call @rpc_builder_new()
    call @rpc_builder_append(&updated, &J_EVT_FUZZY_A, J_EVT_FUZZY_A_LEN)
    call @rpc_builder_append_param_string_or_default(&updated, &body, body_len, &J_SESSION_ID_KEY, J_SESSION_ID_KEY_LEN, &EMPTY_TEXT, EMPTY_TEXT_LEN)
    call @rpc_builder_append(&updated, &J_EVT_FUZZY_B, J_EVT_FUZZY_B_LEN)
    call @rpc_builder_append_param_string_or_default(&updated, &body, body_len, &J_QUERY_KEY, J_QUERY_KEY_LEN, &EMPTY_TEXT, EMPTY_TEXT_LEN)
    call @rpc_builder_append(&updated, &J_EVT_FUZZY_C, J_EVT_FUZZY_C_LEN)
    updated_ptr = call @rpc_builder_data(&updated)
    updated_len = call @rpc_builder_len(&updated)
    call @notify_const_params(&state_ptr, &EV_FUZZY_UPDATED, EV_FUZZY_UPDATED_LEN, &updated_ptr, updated_len)
    !updated_ptr
    !updated_len
    !updated

    completed = call @rpc_builder_new()
    call @rpc_builder_append(&completed, &J_EVT_FUZZY_A, J_EVT_FUZZY_A_LEN)
    call @rpc_builder_append_param_string_or_default(&completed, &body, body_len, &J_SESSION_ID_KEY, J_SESSION_ID_KEY_LEN, &EMPTY_TEXT, EMPTY_TEXT_LEN)
    call @rpc_builder_append(&completed, &J_EVT_CLOSE, J_EVT_CLOSE_LEN)
    completed_ptr = call @rpc_builder_data(&completed)
    completed_len = call @rpc_builder_len(&completed)
    call @notify_const_params(&state_ptr, &EV_FUZZY_COMPLETED, EV_FUZZY_COMPLETED_LEN, &completed_ptr, completed_len)
    !completed_ptr
    !completed_len
    !completed
    !state_ptr
    !body
    !body_len
    return 0

@ffi_wrapper notify_server_resolved(&state_ptr: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    result = call @rpc_builder_new()
    call @rpc_builder_append(&result, &J_SERVER_RESOLVED_A, J_SERVER_RESOLVED_A_LEN)
    call @rpc_builder_append_param_string_or_default(&result, &body, body_len, &J_THREADID_KEY, J_THREADID_KEY_LEN, &EMPTY_TEXT, EMPTY_TEXT_LEN)
    call @rpc_builder_append(&result, &J_SERVER_RESOLVED_B, J_SERVER_RESOLVED_B_LEN)
    call @rpc_builder_append_param_string_or_default(&result, &body, body_len, &J_REQUEST_ID_KEY, J_REQUEST_ID_KEY_LEN, &EMPTY_TEXT, EMPTY_TEXT_LEN)
    call @rpc_builder_append(&result, &J_EVT_CLOSE, J_EVT_CLOSE_LEN)
    params_ptr = call @rpc_builder_data(&result)
    params_len = call @rpc_builder_len(&result)
    call @notify_const_params(&state_ptr, &EV_SERVER_RESOLVED, EV_SERVER_RESOLVED_LEN, &params_ptr, params_len)
    !params_ptr
    !params_len
    !result
    !state_ptr
    !body
    !body_len
    return 0

@event_stream_worker(^ctx: ptr) -> i32:
L_EW_ENTRY:
    req = load ctx+EVENT_CTX_REQ as ptr
    state_ptr = load ctx+EVENT_CTX_STATE as ptr
    stream_slot = stack_alloc 8
    stream_status = call @sa_http_server_resp_stream_new(req, 200, &stream_slot)
    stream = load stream_slot+0 as ptr
    keepalive_write = call @sa_http_server_resp_stream_write(stream, &SSE_KEEPALIVE, SSE_KEEPALIVE_LEN)
    keepalive_flush = call @sa_http_server_resp_stream_flush(stream)
    keepalive_ok = eq keepalive_write, 0
    !keepalive_write
    !keepalive_flush
    !stream_status
    br keepalive_ok -> L_EW_INIT_OK, L_EW_END_INIT_CLOSED

L_EW_INIT_OK:
    !keepalive_ok
    frame_buf = stack_alloc NOTIFY_CAP
    frame_len_slot = stack_alloc 8
    cursor_slot = stack_alloc 8
    cursor_start = call @state_notify_cursor(&state_ptr)
    store cursor_slot+0, cursor_start as u64
    !cursor_start
    loop_slot = stack_alloc 8
    store loop_slot+0, 0 as u64
    jmp L_EW_LOOP_COND

L_EW_LOOP_COND:
    loop_i = load loop_slot+0 as u64
    done = uge loop_i, EVENT_WORKER_LOOPS
    br done -> L_EW_END, L_EW_POP

L_EW_POP:
    !done
    pop_status = call @state_notify_read(&state_ptr, &cursor_slot, &frame_buf, NOTIFY_CAP, &frame_len_slot)
    has_frame = eq pop_status, 1
    !pop_status
    br has_frame -> L_EW_WRITE_FRAME, L_EW_SLEEP

L_EW_WRITE_FRAME:
    !has_frame
    frame_len = load frame_len_slot+0 as u64
    frame_write = call @sa_http_server_resp_stream_write(stream, &frame_buf, frame_len)
    frame_flush = call @sa_http_server_resp_stream_flush(stream)
    frame_write_ok = eq frame_write, 0
    !frame_write
    !frame_flush
    !frame_len
    br frame_write_ok -> L_EW_WRITE_OK, L_EW_END_WRITE_CLOSED

L_EW_WRITE_OK:
    !frame_write_ok
    jmp L_EW_NEXT

L_EW_SLEEP:
    !has_frame
    idle_keepalive_write = call @sa_http_server_resp_stream_write(stream, &SSE_KEEPALIVE, SSE_KEEPALIVE_LEN)
    idle_keepalive_flush = call @sa_http_server_resp_stream_flush(stream)
    idle_keepalive_ok = eq idle_keepalive_write, 0
    !idle_keepalive_write
    !idle_keepalive_flush
    br idle_keepalive_ok -> L_EW_SLEEP_OK, L_EW_END_IDLE_CLOSED

L_EW_SLEEP_OK:
    !idle_keepalive_ok
    EXPAND DENO_SLEEP_MS sleep_status, 50
    !sleep_status
    jmp L_EW_NEXT

L_EW_NEXT:
    next_loop = add loop_i, 1
    store loop_slot+0, next_loop as u64
    !next_loop
    !loop_i
    jmp L_EW_LOOP_COND

L_EW_END:
    !done
    !loop_i
    end_status = call @sa_http_server_resp_stream_end(stream)
    !end_status
    call @sa_http_server_resp_stream_free(^stream)
    call @sa_http_server_req_free(^req)
    !state_ptr
    !ctx
    return 0

L_EW_END_INIT_CLOSED:
    !keepalive_ok
    call @sa_http_server_resp_stream_free(^stream)
    call @sa_http_server_req_free(^req)
    !state_ptr
    !ctx
    return 0

L_EW_END_WRITE_CLOSED:
    !frame_write_ok
    call @sa_http_server_resp_stream_free(^stream)
    call @sa_http_server_req_free(^req)
    !state_ptr
    !ctx
    return 0

L_EW_END_IDLE_CLOSED:
    !idle_keepalive_ok
    call @sa_http_server_resp_stream_free(^stream)
    call @sa_http_server_req_free(^req)
    !state_ptr
    !ctx
    return 0

@ffi_wrapper spawn_event_stream(^ctx: ptr) -> u32:
L_ENTRY:
    worker_vt = &EVENT_WORKER_VT
    worker_fn = load worker_vt+0 as ptr
    worker_raw = *worker_fn
    worker_safe = assume_safe worker_raw
    spawn_status = call @pthread_spawn_detached(*worker_safe, ^ctx)
    !worker_safe
    !worker_raw
    !worker_fn
    !worker_vt
    return spawn_status

@ffi_wrapper send_builder_response(&req: ptr, ^buf: ptr) -> u32:
L_ENTRY:
    json_ptr = call @rpc_builder_data(&buf)
    json_len = call @rpc_builder_len(&buf)
    call @send_rpc_json(&req, 200, &json_ptr, json_len)
    !json_ptr
    !json_len
    !buf
    !req
    return 0

@ffi_wrapper rpc_extract_id_token(&body: ptr, body_len: u64, &out_ptr: ptr, &out_len: ptr) -> u32:
L_ENTRY:
    idx = call @sa_bytes_find(&body, body_len, &J_ID_KEY, J_ID_KEY_LEN)
    found = sge idx, 0
    br found -> L_ID_PREP, L_ID_NOT_FOUND

L_ID_PREP:
    !found
    val_off_i = add idx, J_ID_KEY_LEN
    !idx
    val_off = bitcast val_off_i as u64
    remaining = sub body_len, val_off
    val_ptr = ptr_add body, val_off
    method_idx = call @sa_bytes_find(&val_ptr, remaining, &J_METHOD_KEY, J_METHOD_KEY_LEN)
    method_found = sge method_idx, 0
    br method_found -> L_ID_FOUND, L_ID_NO_METHOD

L_ID_FOUND:
    !method_found
    token_len = bitcast method_idx as u64
    store out_ptr+0, val_ptr as ptr
    store out_len+0, token_len as u64
    !token_len
    !method_idx
    !val_ptr
    !remaining
    !val_off
    !val_off_i
    !body
    !body_len
    !out_ptr
    !out_len
    return 1

L_ID_NO_METHOD:
    !method_found
    !method_idx
    !val_ptr
    !remaining
    !val_off
    !val_off_i
    !body
    !body_len
    store out_ptr+0, J_NULL_ID as ptr
    store out_len+0, J_NULL_ID_LEN as u64
    !out_ptr
    !out_len
    return 0

L_ID_NOT_FOUND:
    !found
    !idx
    !body
    !body_len
    store out_ptr+0, J_NULL_ID as ptr
    store out_len+0, J_NULL_ID_LEN as u64
    !out_ptr
    !out_len
    return 0

@ffi_wrapper send_wrapped_builder_response_with_id(&req: ptr, &id_ptr: ptr, id_len: u64, ^result_buf: ptr) -> u32:
L_ENTRY:
    out = call @rpc_builder_new()
    result_ptr = call @rpc_builder_data(&result_buf)
    result_len = call @rpc_builder_len(&result_buf)
    call @rpc_builder_append(&out, &J_RPC_HEAD, J_RPC_HEAD_LEN)
    call @rpc_builder_append(&out, &id_ptr, id_len)
    call @rpc_builder_append(&out, &J_RPC_RESULT_SEP, J_RPC_RESULT_SEP_LEN)
    call @rpc_builder_append(&out, &result_ptr, result_len)
    call @rpc_builder_append(&out, &J_RPC_SUFFIX, J_RPC_SUFFIX_LEN)
    !result_ptr
    !result_len
    !result_buf
    !id_ptr
    !id_len
    call @send_builder_response(&req, ^out)
    !req
    return 0

@ffi_wrapper send_wrapped_const_with_id(&req: ptr, &id_ptr: ptr, id_len: u64, &result_ptr: ptr, result_len: u64) -> u32:
L_ENTRY:
    out = call @rpc_builder_new()
    call @rpc_builder_append(&out, &J_RPC_HEAD, J_RPC_HEAD_LEN)
    call @rpc_builder_append(&out, &id_ptr, id_len)
    call @rpc_builder_append(&out, &J_RPC_RESULT_SEP, J_RPC_RESULT_SEP_LEN)
    call @rpc_builder_append(&out, &result_ptr, result_len)
    call @rpc_builder_append(&out, &J_RPC_SUFFIX, J_RPC_SUFFIX_LEN)
    !id_ptr
    !id_len
    !result_ptr
    !result_len
    call @send_builder_response(&req, ^out)
    !req
    return 0

@ffi_wrapper send_error_with_id(&req: ptr, status: u16, &id_ptr: ptr, id_len: u64, &error_ptr: ptr, error_len: u64) -> u32:
L_ENTRY:
    out = call @rpc_builder_new()
    call @rpc_builder_append(&out, &J_RPC_HEAD, J_RPC_HEAD_LEN)
    call @rpc_builder_append(&out, &id_ptr, id_len)
    call @rpc_builder_append(&out, &J_RPC_ERROR_SEP, J_RPC_ERROR_SEP_LEN)
    call @rpc_builder_append(&out, &error_ptr, error_len)
    call @rpc_builder_append(&out, &J_RPC_SUFFIX, J_RPC_SUFFIX_LEN)
    json_ptr = call @rpc_builder_data(&out)
    json_len = call @rpc_builder_len(&out)
    call @send_rpc_json(&req, status, &json_ptr, json_len)
    !json_ptr
    !json_len
    !id_ptr
    !id_len
    !error_ptr
    !error_len
    !out
    !status
    !req
    return 0

@ffi_wrapper rpc_extract_u64_after(&body: ptr, body_len: u64, &key: ptr, key_len: u64, fallback: u64) -> u64:
L_ENTRY:
    idx = call @sa_bytes_find(&body, body_len, &key, key_len)
    found = sge idx, 0
    br found -> L_EXTRACT_PREP, L_EXTRACT_FALLBACK

L_EXTRACT_PREP:
    !found
    val_off_i = add idx, key_len
    !idx
    val_off = bitcast val_off_i as u64
    remaining = sub body_len, val_off
    val_ptr = ptr_add body, val_off
    quote_idx = call @sa_bytes_find_byte(&val_ptr, remaining, 34)
    has_quote = sge quote_idx, 0
    br has_quote -> L_EXTRACT_PARSE, L_EXTRACT_NO_QUOTE

L_EXTRACT_PARSE:
    !has_quote
    parsed = call @sa_bytes_to_u64(&val_ptr, quote_idx)
    parsed_ok = sge parsed, 0
    br parsed_ok -> L_EXTRACT_OK, L_EXTRACT_BAD_PARSE

L_EXTRACT_OK:
    !parsed_ok
    result = bitcast parsed as u64
    !parsed
    !quote_idx
    !val_ptr
    !remaining
    !val_off
    !val_off_i
    !body
    !body_len
    !key
    !key_len
    !fallback
    return result

L_EXTRACT_BAD_PARSE:
    !parsed_ok
    !parsed
    !quote_idx
    !val_ptr
    !remaining
    !val_off
    !val_off_i
    !body
    !body_len
    !key
    !key_len
    return fallback

L_EXTRACT_NO_QUOTE:
    !has_quote
    !quote_idx
    !val_ptr
    !remaining
    !val_off
    !val_off_i
    !body
    !body_len
    !key
    !key_len
    return fallback

L_EXTRACT_FALLBACK:
    !found
    !idx
    !body
    !body_len
    !key
    !key_len
    return fallback

@ffi_wrapper rpc_extract_u64_number_after(&body: ptr, body_len: u64, &key: ptr, key_len: u64, fallback: u64) -> u64:
L_ENTRY:
    idx = call @sa_bytes_find(&body, body_len, &key, key_len)
    found = sge idx, 0
    br found -> L_NUM_PREP, L_NUM_FALLBACK

L_NUM_PREP:
    !found
    val_off_i = add idx, key_len
    !idx
    val_off = bitcast val_off_i as u64
    remaining = sub body_len, val_off
    val_ptr = ptr_add body, val_off
    comma_idx = call @sa_bytes_find_byte(&val_ptr, remaining, 44)
    has_comma = sge comma_idx, 0
    br has_comma -> L_NUM_PARSE_COMMA, L_NUM_BRACE

L_NUM_PARSE_COMMA:
    !has_comma
    parsed = call @sa_bytes_to_u64(&val_ptr, comma_idx)
    parsed_ok = sge parsed, 0
    br parsed_ok -> L_NUM_OK, L_NUM_BAD

L_NUM_OK:
    !parsed_ok
    result = bitcast parsed as u64
    !parsed
    !comma_idx
    !val_ptr
    !remaining
    !val_off
    !val_off_i
    !body
    !body_len
    !key
    !key_len
    !fallback
    return result

L_NUM_BAD:
    !parsed_ok
    !parsed
    !comma_idx
    !val_ptr
    !remaining
    !val_off
    !val_off_i
    !body
    !body_len
    !key
    !key_len
    return fallback

L_NUM_BRACE:
    !has_comma
    !comma_idx
    brace_idx = call @sa_bytes_find_byte(&val_ptr, remaining, 125)
    has_brace = sge brace_idx, 0
    br has_brace -> L_NUM_PARSE_BRACE, L_NUM_FALLBACK2

L_NUM_PARSE_BRACE:
    !has_brace
    parsed2 = call @sa_bytes_to_u64(&val_ptr, brace_idx)
    parsed2_ok = sge parsed2, 0
    br parsed2_ok -> L_NUM_OK2, L_NUM_BAD2

L_NUM_OK2:
    !parsed2_ok
    result2 = bitcast parsed2 as u64
    !parsed2
    !brace_idx
    !val_ptr
    !remaining
    !val_off
    !val_off_i
    !body
    !body_len
    !key
    !key_len
    !fallback
    return result2

L_NUM_BAD2:
    !parsed2_ok
    !parsed2
    !brace_idx
    !val_ptr
    !remaining
    !val_off
    !val_off_i
    !body
    !body_len
    !key
    !key_len
    return fallback

L_NUM_FALLBACK2:
    !has_brace
    !brace_idx
    !val_ptr
    !remaining
    !val_off
    !val_off_i
    !body
    !body_len
    !key
    !key_len
    return fallback

L_NUM_FALLBACK:
    !found
    !idx
    !body
    !body_len
    !key
    !key_len
    return fallback

@ffi_wrapper rpc_extract_string_after(&body: ptr, body_len: u64, &key: ptr, key_len: u64, &out_ptr: ptr, &out_len: ptr) -> u32:
L_ENTRY:
    idx = call @sa_bytes_find(&body, body_len, &key, key_len)
    found = sge idx, 0
    br found -> L_STR_PREP, L_STR_NOT_FOUND

L_STR_PREP:
    !found
    val_off_i = add idx, key_len
    !idx
    val_off = bitcast val_off_i as u64
    remaining = sub body_len, val_off
    val_ptr = ptr_add body, val_off
    quote_idx = call @sa_bytes_find_byte(&val_ptr, remaining, 34)
    has_quote = sge quote_idx, 0
    br has_quote -> L_STR_FOUND, L_STR_NO_QUOTE

L_STR_FOUND:
    !has_quote
    store out_ptr+0, val_ptr as ptr
    store out_len+0, quote_idx as u64
    !quote_idx
    !val_ptr
    !remaining
    !val_off
    !val_off_i
    !body
    !body_len
    !key
    !key_len
    !out_ptr
    !out_len
    return 1

L_STR_NO_QUOTE:
    !has_quote
    !quote_idx
    !val_ptr
    !remaining
    !val_off
    !val_off_i
    !body
    !body_len
    !key
    !key_len
    !out_ptr
    !out_len
    return 0

L_STR_NOT_FOUND:
    !found
    !idx
    !body
    !body_len
    !key
    !key_len
    !out_ptr
    !out_len
    return 0

@ffi_wrapper rpc_extract_string_or_default(&body: ptr, body_len: u64, &key: ptr, key_len: u64, &default_ptr: ptr, default_len: u64, &out_ptr: ptr, &out_len: ptr) -> u32:
L_ENTRY:
    tmp_ptr_slot = stack_alloc 8
    tmp_len_slot = stack_alloc 8
    status = call @rpc_extract_string_after(&body, body_len, &key, key_len, &tmp_ptr_slot, &tmp_len_slot)
    has_value = eq status, 1
    !status
    br has_value -> L_STR_DEF_BODY, L_STR_DEF_DEFAULT

L_STR_DEF_BODY:
    !has_value
    tmp_ptr = load tmp_ptr_slot+0 as ptr
    tmp_len = load tmp_len_slot+0 as u64
    store out_ptr+0, tmp_ptr as ptr
    store out_len+0, tmp_len as u64
    !tmp_ptr
    !tmp_len
    !body
    !body_len
    !key
    !key_len
    !default_ptr
    !default_len
    !out_ptr
    !out_len
    return 1

L_STR_DEF_DEFAULT:
    !has_value
    store out_ptr+0, default_ptr as ptr
    store out_len+0, default_len as u64
    !body
    !body_len
    !key
    !key_len
    !default_ptr
    !default_len
    !out_ptr
    !out_len
    return 0

@ffi_wrapper rpc_resolve_thread_id(&state_ptr: ptr, &body: ptr, body_len: u64, fallback: u64) -> u64:
L_ENTRY:
    key_ptr_slot = stack_alloc 8
    key_len_slot = stack_alloc 8
    key_status = call @rpc_extract_string_after(&body, body_len, &J_THREADID_KEY, J_THREADID_KEY_LEN, &key_ptr_slot, &key_len_slot)
    has_key = eq key_status, 1
    !key_status
    br has_key -> L_RESOLVE_THREAD_KEY, L_RESOLVE_THREAD_NUMERIC

L_RESOLVE_THREAD_KEY:
    !has_key
    key_ptr = load key_ptr_slot+0 as ptr
    key_len = load key_len_slot+0 as u64
    slot = call @state_thread_find_by_key(&state_ptr, &key_ptr, key_len)
    found = ne slot, 0
    br found -> L_RESOLVE_THREAD_FOUND, L_RESOLVE_THREAD_PARSE_STRING

L_RESOLVE_THREAD_FOUND:
    !found
    resolved = load slot+THR_ID as u64
    !slot
    !key_ptr
    !key_len
    !state_ptr
    !body
    !body_len
    !fallback
    return resolved

L_RESOLVE_THREAD_PARSE_STRING:
    !found
    !slot
    parsed = call @rpc_extract_u64_after(&body, body_len, &J_THREADID_KEY, J_THREADID_KEY_LEN, fallback)
    !key_ptr
    !key_len
    !state_ptr
    !body
    !body_len
    !fallback
    return parsed

L_RESOLVE_THREAD_NUMERIC:
    !has_key
    parsed2 = call @rpc_extract_u64_after(&body, body_len, &J_THREADID_KEY, J_THREADID_KEY_LEN, fallback)
    !state_ptr
    !body
    !body_len
    !fallback
    return parsed2

@ffi_wrapper bytes_has(&body: ptr, body_len: u64, &needle: ptr, needle_len: u64) -> u32:
L_ENTRY:
    idx = call @sa_bytes_find(&body, body_len, &needle, needle_len)
    found = sge idx, 0
    br found -> L_HAS_YES, L_HAS_NO

L_HAS_YES:
    !found
    !idx
    !body
    !body_len
    !needle
    !needle_len
    return 1

L_HAS_NO:
    !found
    !idx
    !body
    !body_len
    !needle
    !needle_len
    return 0

@ffi_wrapper body_collaboration_mode(&body: ptr, body_len: u64) -> u8:
L_ENTRY:
    mode_code = call @bytes_has(&body, body_len, &BODY_MODE_CODE, BODY_MODE_CODE_LEN)
    kind_code = call @bytes_has(&body, body_len, &BODY_KIND_CODE, BODY_KIND_CODE_LEN)
    collab_code = call @bytes_has(&body, body_len, &BODY_COLLAB_CODE, BODY_COLLAB_CODE_LEN)
    default_text = call @bytes_has(&body, body_len, &BODY_COLLAB_DEFAULT_TEXT, BODY_COLLAB_DEFAULT_TEXT_LEN)
    code_text = call @bytes_has(&body, body_len, &BODY_COLLAB_CODE_TEXT, BODY_COLLAB_CODE_TEXT_LEN)
    code1 = or mode_code, kind_code
    code2 = or collab_code, default_text
    code3 = or code1, code2
    code_any = or code3, code_text
    is_code = ne code_any, 0
    br is_code -> L_BODY_MODE_CODE, L_BODY_MODE_GOAL_CHECK

L_BODY_MODE_CODE:
    !is_code
    !code_any
    !code3
    !code2
    !code1
    !code_text
    !default_text
    !collab_code
    !kind_code
    !mode_code
    !body
    !body_len
    return 3

L_BODY_MODE_GOAL_CHECK:
    !is_code
    !code_any
    !code3
    !code2
    !code1
    !code_text
    !default_text
    !collab_code
    !kind_code
    !mode_code
    goal_ctx = call @bytes_has(&body, body_len, &BODY_GOAL_CONTEXT, BODY_GOAL_CONTEXT_LEN)
    goal_text = call @bytes_has(&body, body_len, &BODY_GOAL_CONTEXT_TEXT, BODY_GOAL_CONTEXT_TEXT_LEN)
    mode_goal = call @bytes_has(&body, body_len, &BODY_MODE_GOAL, BODY_MODE_GOAL_LEN)
    kind_goal = call @bytes_has(&body, body_len, &BODY_KIND_GOAL, BODY_KIND_GOAL_LEN)
    collab_goal = call @bytes_has(&body, body_len, &BODY_COLLAB_GOAL, BODY_COLLAB_GOAL_LEN)
    any1 = or goal_ctx, goal_text
    any2 = or mode_goal, kind_goal
    any3 = or collab_goal, any2
    any12 = or any1, any2
    any = or any12, any3
    has_goal = ne any, 0
    br has_goal -> L_BODY_MODE_GOAL, L_BODY_MODE_PLAN_CHECK

L_BODY_MODE_GOAL:
    !has_goal
    !any
    !any12
    !any3
    !any2
    !any1
    !collab_goal
    !kind_goal
    !mode_goal
    !goal_text
    !goal_ctx
    !body
    !body_len
    return 2

L_BODY_MODE_PLAN_CHECK:
    !has_goal
    !any
    !any12
    !any3
    !any2
    !any1
    !collab_goal
    !kind_goal
    !mode_goal
    !goal_text
    !goal_ctx
    mode_plan = call @bytes_has(&body, body_len, &BODY_MODE_PLAN, BODY_MODE_PLAN_LEN)
    kind_plan = call @bytes_has(&body, body_len, &BODY_KIND_PLAN, BODY_KIND_PLAN_LEN)
    collab_plan = call @bytes_has(&body, body_len, &BODY_COLLAB_PLAN, BODY_COLLAB_PLAN_LEN)
    plan_text = call @bytes_has(&body, body_len, &BODY_PLAN_TEXT, BODY_PLAN_TEXT_LEN)
    plan1 = or mode_plan, kind_plan
    plan2 = or collab_plan, plan_text
    plan_any = or plan1, plan2
    is_plan = ne plan_any, 0
    br is_plan -> L_BODY_MODE_PLAN, L_BODY_MODE_NONE

L_BODY_MODE_PLAN:
    !is_plan
    !plan_any
    !plan2
    !plan1
    !plan_text
    !collab_plan
    !kind_plan
    !mode_plan
    !body
    !body_len
    return 1

L_BODY_MODE_NONE:
    !is_plan
    !plan_any
    !plan2
    !plan1
    !plan_text
    !collab_plan
    !kind_plan
    !mode_plan
    !body
    !body_len
    return 0

@ffi_wrapper body_allows_progress_continuation(&body: ptr, body_len: u64) -> u32:
L_ENTRY:
    exec_status = call @bytes_has(&body, body_len, &TOOL_NAME_EXEC_KEY, TOOL_NAME_EXEC_KEY_LEN)
    has_exec = eq exec_status, 1
    br has_exec -> L_CONT_MODE_CHECK, L_CONT_MODE_NO_EXEC

L_CONT_MODE_CHECK:
    !has_exec
    !exec_status
    mode = call @body_collaboration_mode(&body, body_len)
    is_goal = eq mode, 2
    is_code = eq mode, 3
    allowed = or is_goal, is_code
    has_allowed = ne allowed, 0
    br has_allowed -> L_CONT_MODE_YES, L_CONT_MODE_NO

L_CONT_MODE_YES:
    !has_allowed
    !allowed
    !is_code
    !is_goal
    !mode
    !body
    !body_len
    return 1

L_CONT_MODE_NO:
    !has_allowed
    !allowed
    !is_code
    !is_goal
    !mode
    !body
    !body_len
    return 0

L_CONT_MODE_NO_EXEC:
    !has_exec
    !exec_status
    !body
    !body_len
    return 0

@ffi_wrapper build_request_context_body(&body: ptr, body_len: u64, mode: u8, &out_len: ptr) -> ^ptr:
L_ENTRY:
    is_plan = eq mode, 1
    br is_plan -> L_CTX_PLAN, L_CTX_GOAL_CHECK

L_CTX_PLAN:
    !is_plan
    out_plan = alloc BODY_MODE_PLAN_LEN
    copy_plan = call @sa_bytes_copy(&out_plan, &BODY_MODE_PLAN, BODY_MODE_PLAN_LEN)
    !copy_plan
    store out_len+0, BODY_MODE_PLAN_LEN as u64
    !body
    !body_len
    !mode
    !out_len
    return out_plan

L_CTX_GOAL_CHECK:
    !is_plan
    is_goal = eq mode, 2
    br is_goal -> L_CTX_GOAL, L_CTX_CODE_CHECK

L_CTX_GOAL:
    !is_goal
    out_goal_len = add body_len, BODY_COLLAB_GOAL_LEN
    out_goal = alloc out_goal_len
    copy_goal_body = call @sa_bytes_copy(&out_goal, &body, body_len)
    !copy_goal_body
    goal_tail = ptr_add out_goal, body_len
    copy_goal = call @sa_bytes_copy(&goal_tail, &BODY_COLLAB_GOAL, BODY_COLLAB_GOAL_LEN)
    !copy_goal
    !goal_tail
    store out_len+0, out_goal_len as u64
    !out_goal_len
    !body
    !body_len
    !mode
    !out_len
    return out_goal

L_CTX_CODE_CHECK:
    !is_goal
    is_code = eq mode, 3
    br is_code -> L_CTX_CODE, L_CTX_ORIGINAL

L_CTX_CODE:
    !is_code
    out_code_len = add body_len, BODY_COLLAB_CODE_LEN
    out_code = alloc out_code_len
    copy_code_body = call @sa_bytes_copy(&out_code, &body, body_len)
    !copy_code_body
    code_tail = ptr_add out_code, body_len
    copy_code = call @sa_bytes_copy(&code_tail, &BODY_COLLAB_CODE, BODY_COLLAB_CODE_LEN)
    !copy_code
    !code_tail
    store out_len+0, out_code_len as u64
    !out_code_len
    !body
    !body_len
    !mode
    !out_len
    return out_code

L_CTX_ORIGINAL:
    !is_code
    out = alloc body_len
    copy_status = call @sa_bytes_copy(&out, &body, body_len)
    !copy_status
    store out_len+0, body_len as u64
    !body
    !body_len
    !mode
    !out_len
    return out

@ffi_wrapper response_request_context_mode(&req: ptr, &state_ptr: ptr, &body: ptr, body_len: u64) -> u8:
L_ENTRY:
    body_mode = call @body_collaboration_mode(&body, body_len)
    thread_ptr_slot = stack_alloc 8
    thread_len_slot = stack_alloc 8
    turn_ptr_slot = stack_alloc 8
    turn_len_slot = stack_alloc 8
    store thread_ptr_slot+0, 0 as ptr
    store thread_len_slot+0, 0 as u64
    store turn_ptr_slot+0, 0 as ptr
    store turn_len_slot+0, 0 as u64
    thread_hdr_status = call @sa_http_server_req_get_header(req, &HDR_THREAD_ID, HDR_THREAD_ID_LEN, &thread_ptr_slot, &thread_len_slot)
    turn_hdr_status = call @sa_http_server_req_get_header(req, &HDR_TURN_ID, HDR_TURN_ID_LEN, &turn_ptr_slot, &turn_len_slot)
    thread_ptr = load thread_ptr_slot+0 as ptr
    thread_len = load thread_len_slot+0 as u64
    turn_ptr = load turn_ptr_slot+0 as ptr
    turn_len = load turn_len_slot+0 as u64
    !thread_hdr_status
    !turn_hdr_status
    has_thread = ne thread_ptr, 0
    br has_thread -> L_RESP_CTX_HAS_THREAD, L_RESP_CTX_BODY_MODE

L_RESP_CTX_HAS_THREAD:
    !has_thread
    has_turn = ne turn_ptr, 0
    br has_turn -> L_RESP_CTX_PARSE, L_RESP_CTX_BODY_MODE_AFTER_THREAD

L_RESP_CTX_PARSE:
    !has_turn
    parsed_turn = call @sa_bytes_to_u64(&turn_ptr, turn_len)
    turn_ok = sgt parsed_turn, 0
    br turn_ok -> L_RESP_CTX_RESOLVE_THREAD, L_RESP_CTX_BODY_MODE_AFTER_PARSE

L_RESP_CTX_RESOLVE_THREAD:
    !turn_ok
    thread_slot = call @state_thread_find_by_key(&state_ptr, &thread_ptr, thread_len)
    thread_found = ne thread_slot, 0
    br thread_found -> L_RESP_CTX_LOOKUP_KEY, L_RESP_CTX_PARSE_THREAD_NUMERIC

L_RESP_CTX_LOOKUP_KEY:
    !thread_found
    key_thread_id = load thread_slot+THR_ID as u64
    !thread_slot
    key_turn_id = bitcast parsed_turn as u64
    slot_key = call @state_turn_find(&state_ptr, key_thread_id, key_turn_id)
    missing_key = eq slot_key, 0
    br missing_key -> L_RESP_CTX_BODY_MODE_AFTER_LOOKUP_KEY, L_RESP_CTX_LOAD_MODE_KEY

L_RESP_CTX_PARSE_THREAD_NUMERIC:
    !thread_found
    !thread_slot
    parsed_thread = call @sa_bytes_to_u64(&thread_ptr, thread_len)
    thread_ok = sgt parsed_thread, 0
    br thread_ok -> L_RESP_CTX_LOOKUP_THREAD_NUMERIC, L_RESP_CTX_BODY_MODE_AFTER_PARSE_THREAD

L_RESP_CTX_LOOKUP_THREAD_NUMERIC:
    !thread_ok
    numeric_thread_id = bitcast parsed_thread as u64
    !parsed_thread
    numeric_turn_id = bitcast parsed_turn as u64
    slot_num = call @state_turn_find(&state_ptr, numeric_thread_id, numeric_turn_id)
    missing_num = eq slot_num, 0
    br missing_num -> L_RESP_CTX_BODY_MODE_AFTER_LOOKUP_NUM, L_RESP_CTX_LOAD_MODE_NUM

L_RESP_CTX_LOAD_MODE_KEY:
    !missing_key
    mode_key = load slot_key+TURN_MODE as u8
    has_mode_key = ne mode_key, 0
    br has_mode_key -> L_RESP_CTX_STATE_MODE_KEY, L_RESP_CTX_BODY_MODE_AFTER_STATE_ZERO_KEY

L_RESP_CTX_STATE_MODE_KEY:
    !has_mode_key
    !slot_key
    !key_thread_id
    !key_turn_id
    !parsed_turn
    !thread_ptr
    !thread_len
    !turn_ptr
    !turn_len
    !body_mode
    !body
    !body_len
    !state_ptr
    !req
    return mode_key

L_RESP_CTX_BODY_MODE_AFTER_STATE_ZERO_KEY:
    !has_mode_key
    !mode_key
    !slot_key
    jmp L_RESP_CTX_BODY_MODE_AFTER_IDS_KEY

L_RESP_CTX_BODY_MODE_AFTER_LOOKUP_KEY:
    !missing_key
    !slot_key
    jmp L_RESP_CTX_BODY_MODE_AFTER_IDS_KEY

L_RESP_CTX_BODY_MODE_AFTER_IDS_KEY:
    !key_thread_id
    !key_turn_id
    !parsed_turn
    jmp L_RESP_CTX_BODY_MODE_KEEP_PTRS

L_RESP_CTX_LOAD_MODE_NUM:
    !missing_num
    mode_num = load slot_num+TURN_MODE as u8
    has_mode_num = ne mode_num, 0
    br has_mode_num -> L_RESP_CTX_STATE_MODE_NUM, L_RESP_CTX_BODY_MODE_AFTER_STATE_ZERO_NUM

L_RESP_CTX_STATE_MODE_NUM:
    !has_mode_num
    !slot_num
    !numeric_thread_id
    !numeric_turn_id
    !parsed_turn
    !thread_ptr
    !thread_len
    !turn_ptr
    !turn_len
    !body_mode
    !body
    !body_len
    !state_ptr
    !req
    return mode_num

L_RESP_CTX_BODY_MODE_AFTER_STATE_ZERO_NUM:
    !has_mode_num
    !mode_num
    !slot_num
    jmp L_RESP_CTX_BODY_MODE_AFTER_IDS_NUM

L_RESP_CTX_BODY_MODE_AFTER_LOOKUP_NUM:
    !missing_num
    !slot_num
    jmp L_RESP_CTX_BODY_MODE_AFTER_IDS_NUM

L_RESP_CTX_BODY_MODE_AFTER_IDS_NUM:
    !numeric_thread_id
    !numeric_turn_id
    !parsed_turn
    jmp L_RESP_CTX_BODY_MODE_KEEP_PTRS

L_RESP_CTX_BODY_MODE_AFTER_PARSE:
    !turn_ok
    !parsed_turn
    jmp L_RESP_CTX_BODY_MODE_KEEP_PTRS

L_RESP_CTX_BODY_MODE_AFTER_PARSE_THREAD:
    !thread_ok
    !parsed_thread
    !parsed_turn
    jmp L_RESP_CTX_BODY_MODE_KEEP_PTRS

L_RESP_CTX_BODY_MODE_AFTER_THREAD:
    !has_turn
    jmp L_RESP_CTX_BODY_MODE_KEEP_PTRS

L_RESP_CTX_BODY_MODE:
    !has_thread
    jmp L_RESP_CTX_BODY_MODE_KEEP_PTRS

L_RESP_CTX_BODY_MODE_KEEP_PTRS:
    !thread_ptr
    !thread_len
    !turn_ptr
    !turn_len
    !body
    !body_len
    !state_ptr
    !req
    return body_mode

@ffi_wrapper build_response_request_context_body(&req: ptr, &state_ptr: ptr, &body: ptr, body_len: u64, &out_len: ptr) -> ^ptr:
L_ENTRY:
    mode = call @response_request_context_mode(&req, &state_ptr, &body, body_len)
    out = call @build_request_context_body(&body, body_len, mode, &out_len)
    !mode
    !req
    !state_ptr
    !body
    !body_len
    !out_len
    return out

@ffi_wrapper responses_sse_is_progress_message(&body: ptr, body_len: u64) -> u32:
L_ENTRY:
    final_cn = call @bytes_has(&body, body_len, &CHAT_FINAL_CN_DONE, CHAT_FINAL_CN_DONE_LEN)
    proposed = call @bytes_has(&body, body_len, &CHAT_PROPOSED_PLAN, CHAT_PROPOSED_PLAN_LEN)
    final_any = or final_cn, proposed
    is_final = ne final_any, 0
    br is_final -> L_RESP_PROGRESS_NO_FINAL, L_RESP_PROGRESS_MATCH

L_RESP_PROGRESS_MATCH:
    !is_final
    !final_any
    !proposed
    !final_cn
    en_let = call @bytes_has(&body, body_len, &CHAT_PROGRESS_EN_LET_ME, CHAT_PROGRESS_EN_LET_ME_LEN)
    en_check = call @bytes_has(&body, body_len, &CHAT_PROGRESS_EN_CHECK, CHAT_PROGRESS_EN_CHECK_LEN)
    en_inspect = call @bytes_has(&body, body_len, &CHAT_PROGRESS_EN_INSPECT, CHAT_PROGRESS_EN_INSPECT_LEN)
    en_read = call @bytes_has(&body, body_len, &CHAT_PROGRESS_EN_READ, CHAT_PROGRESS_EN_READ_LEN)
    en_tmp1 = or en_check, en_inspect
    en_tmp2 = or en_tmp1, en_read
    en_has_action = ne en_tmp2, 0
    en_progress_raw = and en_let, en_has_action
    cn_will = call @bytes_has(&body, body_len, &CHAT_PROGRESS_CN_WOHUI, CHAT_PROGRESS_CN_WOHUI_LEN)
    cn_continue = call @bytes_has(&body, body_len, &CHAT_PROGRESS_CN_JIXU, CHAT_PROGRESS_CN_JIXU_LEN)
    cn_read = call @bytes_has(&body, body_len, &CHAT_PROGRESS_CN_READ, CHAT_PROGRESS_CN_READ_LEN)
    cn_check = call @bytes_has(&body, body_len, &CHAT_PROGRESS_CN_CHECK, CHAT_PROGRESS_CN_CHECK_LEN)
    cn_run = call @bytes_has(&body, body_len, &CHAT_PROGRESS_CN_RUN, CHAT_PROGRESS_CN_RUN_LEN)
    cn_tmp_will = or cn_will, cn_continue
    cn_tmp_action1 = or cn_read, cn_check
    cn_tmp_action2 = or cn_tmp_action1, cn_run
    cn_has_action = ne cn_tmp_action2, 0
    cn_progress_raw = and cn_tmp_will, cn_has_action
    progress_any = or en_progress_raw, cn_progress_raw
    is_progress = ne progress_any, 0
    br is_progress -> L_RESP_PROGRESS_YES, L_RESP_PROGRESS_NO_MATCH

L_RESP_PROGRESS_YES:
    !is_progress
    !progress_any
    !cn_progress_raw
    !cn_has_action
    !cn_tmp_action2
    !cn_tmp_action1
    !cn_tmp_will
    !cn_run
    !cn_check
    !cn_read
    !cn_continue
    !cn_will
    !en_progress_raw
    !en_has_action
    !en_tmp2
    !en_tmp1
    !en_read
    !en_inspect
    !en_check
    !en_let
    !body
    !body_len
    return 1

L_RESP_PROGRESS_NO_MATCH:
    !is_progress
    !progress_any
    !cn_progress_raw
    !cn_has_action
    !cn_tmp_action2
    !cn_tmp_action1
    !cn_tmp_will
    !cn_run
    !cn_check
    !cn_read
    !cn_continue
    !cn_will
    !en_progress_raw
    !en_has_action
    !en_tmp2
    !en_tmp1
    !en_read
    !en_inspect
    !en_check
    !en_let
    !body
    !body_len
    return 0

L_RESP_PROGRESS_NO_FINAL:
    !is_final
    !final_any
    !proposed
    !final_cn
    !body
    !body_len
    return 0

@ffi_wrapper rpc_builder_append_json_string(&buf: ptr, &src: ptr, src_len: u64) -> u32:
L_ENTRY:
    call @rpc_builder_append(&buf, &J_QUOTE, J_QUOTE_LEN)
    i_slot = stack_alloc 8
    store i_slot+0, 0 as u64
    jmp L_JSON_STR_COND

L_JSON_STR_COND:
    i = load i_slot+0 as u64
    done = uge i, src_len
    br done -> L_JSON_STR_DONE, L_JSON_STR_BODY

L_JSON_STR_BODY:
    !done
    ch_ptr = ptr_add src, i
    ch = load ch_ptr+0 as u8
    is_quote = eq ch, 34
    br is_quote -> L_JSON_ESC_QUOTE, L_JSON_CHECK_BS

L_JSON_CHECK_BS:
    !is_quote
    is_bs = eq ch, 92
    br is_bs -> L_JSON_ESC_BS, L_JSON_CHECK_N

L_JSON_CHECK_N:
    !is_bs
    is_n = eq ch, 10
    br is_n -> L_JSON_ESC_N, L_JSON_CHECK_R

L_JSON_CHECK_R:
    !is_n
    is_r = eq ch, 13
    br is_r -> L_JSON_ESC_R, L_JSON_CHECK_T

L_JSON_CHECK_T:
    !is_r
    is_t = eq ch, 9
    br is_t -> L_JSON_ESC_T, L_JSON_RAW

L_JSON_ESC_QUOTE:
    !is_quote
    call @rpc_builder_append(&buf, &JSON_ESC_QUOTE, JSON_ESC_QUOTE_LEN)
    jmp L_JSON_NEXT

L_JSON_ESC_BS:
    !is_bs
    call @rpc_builder_append(&buf, &JSON_ESC_BACKSLASH, JSON_ESC_BACKSLASH_LEN)
    jmp L_JSON_NEXT

L_JSON_ESC_N:
    !is_n
    call @rpc_builder_append(&buf, &JSON_ESC_N, JSON_ESC_N_LEN)
    jmp L_JSON_NEXT

L_JSON_ESC_R:
    !is_r
    call @rpc_builder_append(&buf, &JSON_ESC_R, JSON_ESC_R_LEN)
    jmp L_JSON_NEXT

L_JSON_ESC_T:
    !is_t
    call @rpc_builder_append(&buf, &JSON_ESC_T, JSON_ESC_T_LEN)
    jmp L_JSON_NEXT

L_JSON_RAW:
    !is_t
    call @rpc_builder_append(&buf, &ch_ptr, 1)
    jmp L_JSON_NEXT

L_JSON_NEXT:
    !ch
    !ch_ptr
    next = add i, 1
    store i_slot+0, next as u64
    !next
    !i
    jmp L_JSON_STR_COND

L_JSON_STR_DONE:
    !done
    !i
    call @rpc_builder_append(&buf, &J_QUOTE, J_QUOTE_LEN)
    !buf
    !src
    !src_len
    return 0

@ffi_wrapper rpc_builder_append_param_string_or_default(&buf: ptr, &body: ptr, body_len: u64, &key: ptr, key_len: u64, &fallback: ptr, fallback_len: u64) -> u32:
L_ENTRY:
    value_ptr_slot = stack_alloc 8
    value_len_slot = stack_alloc 8
    status = call @rpc_extract_string_after(&body, body_len, &key, key_len, &value_ptr_slot, &value_len_slot)
    found = eq status, 1
    br found -> L_PARAM_STRING_FOUND, L_PARAM_STRING_DEFAULT

L_PARAM_STRING_FOUND:
    !found
    value_ptr = load value_ptr_slot+0 as ptr
    value_len = load value_len_slot+0 as u64
    append_status = call @rpc_builder_append_json_string(&buf, &value_ptr, value_len)
    !append_status
    !value_ptr
    !value_len
    !status
    !buf
    !body
    !body_len
    !key
    !key_len
    !fallback
    !fallback_len
    return 0

L_PARAM_STRING_DEFAULT:
    !found
    append_status2 = call @rpc_builder_append_json_string(&buf, &fallback, fallback_len)
    !append_status2
    !status
    !buf
    !body
    !body_len
    !key
    !key_len
    !fallback
    !fallback_len
    return 0

@ffi_wrapper rpc_builder_append_param_string_or_alt_default(&buf: ptr, &body: ptr, body_len: u64, &primary_key: ptr, primary_key_len: u64, &alt_key: ptr, alt_key_len: u64, &fallback: ptr, fallback_len: u64) -> u32:
L_ENTRY:
    value_ptr_slot = stack_alloc 8
    value_len_slot = stack_alloc 8
    primary_status = call @rpc_extract_string_after(&body, body_len, &primary_key, primary_key_len, &value_ptr_slot, &value_len_slot)
    primary_found = eq primary_status, 1
    !primary_status
    br primary_found -> L_PARAM_ALT_FOUND, L_PARAM_ALT_TRY_ALT

L_PARAM_ALT_FOUND:
    !primary_found
    value_ptr = load value_ptr_slot+0 as ptr
    value_len = load value_len_slot+0 as u64
    append_status = call @rpc_builder_append_json_string(&buf, &value_ptr, value_len)
    !append_status
    !value_ptr
    !value_len
    !buf
    !body
    !body_len
    !primary_key
    !primary_key_len
    !alt_key
    !alt_key_len
    !fallback
    !fallback_len
    return 0

L_PARAM_ALT_TRY_ALT:
    !primary_found
    alt_status = call @rpc_extract_string_after(&body, body_len, &alt_key, alt_key_len, &value_ptr_slot, &value_len_slot)
    alt_found = eq alt_status, 1
    !alt_status
    br alt_found -> L_PARAM_ALT_FOUND2, L_PARAM_ALT_DEFAULT

L_PARAM_ALT_FOUND2:
    !alt_found
    value_ptr2 = load value_ptr_slot+0 as ptr
    value_len2 = load value_len_slot+0 as u64
    append_status2 = call @rpc_builder_append_json_string(&buf, &value_ptr2, value_len2)
    !append_status2
    !value_ptr2
    !value_len2
    !buf
    !body
    !body_len
    !primary_key
    !primary_key_len
    !alt_key
    !alt_key_len
    !fallback
    !fallback_len
    return 0

L_PARAM_ALT_DEFAULT:
    !alt_found
    append_status3 = call @rpc_builder_append_json_string(&buf, &fallback, fallback_len)
    !append_status3
    !buf
    !body
    !body_len
    !primary_key
    !primary_key_len
    !alt_key
    !alt_key_len
    !fallback
    !fallback_len
    return 0

@ffi_wrapper rpc_extract_array_after(&body: ptr, body_len: u64, &key: ptr, key_len: u64, &out_ptr: ptr, &out_len: ptr) -> u32:
L_ENTRY:
    idx = call @sa_bytes_find(&body, body_len, &key, key_len)
    found = sge idx, 0
    br found -> L_ARRAY_PREP, L_ARRAY_NOT_FOUND

L_ARRAY_PREP:
    !found
    val_off_i = add idx, key_len
    !idx
    val_off = bitcast val_off_i as u64
    remaining = sub body_len, val_off
    val_ptr = ptr_add body, val_off
    first = load val_ptr+0 as u8
    is_array = eq first, 91
    !first
    br is_array -> L_ARRAY_SCAN_INIT, L_ARRAY_BAD

L_ARRAY_SCAN_INIT:
    !is_array
    depth_slot = stack_alloc 8
    i_slot = stack_alloc 8
    in_str_slot = stack_alloc 8
    esc_slot = stack_alloc 8
    store depth_slot+0, 0 as u64
    store i_slot+0, 0 as u64
    store in_str_slot+0, 0 as u64
    store esc_slot+0, 0 as u64
    jmp L_ARRAY_SCAN_COND

L_ARRAY_SCAN_COND:
    i = load i_slot+0 as u64
    done = uge i, remaining
    br done -> L_ARRAY_BAD_FROM_SCAN, L_ARRAY_SCAN_BODY

L_ARRAY_SCAN_BODY:
    ch_ptr = ptr_add val_ptr, i
    ch = load ch_ptr+0 as u8
    esc = load esc_slot+0 as u64
    in_str = load in_str_slot+0 as u64
    is_escaped = eq esc, 1
    br is_escaped -> L_ARRAY_ESCAPED, L_ARRAY_NOT_ESCAPED

L_ARRAY_ESCAPED:
    !is_escaped
    store esc_slot+0, 0 as u64
    jmp L_ARRAY_NEXT

L_ARRAY_NOT_ESCAPED:
    !is_escaped
    is_in_str = eq in_str, 1
    br is_in_str -> L_ARRAY_IN_STRING, L_ARRAY_STRUCT

L_ARRAY_IN_STRING:
    !is_in_str
    is_backslash = eq ch, 92
    br is_backslash -> L_ARRAY_SET_ESC, L_ARRAY_CHECK_QUOTE_IN_STRING

L_ARRAY_SET_ESC:
    !is_backslash
    store esc_slot+0, 1 as u64
    jmp L_ARRAY_NEXT

L_ARRAY_CHECK_QUOTE_IN_STRING:
    !is_backslash
    is_quote = eq ch, 34
    br is_quote -> L_ARRAY_END_STRING, L_ARRAY_NEXT_FROM_STRING

L_ARRAY_END_STRING:
    !is_quote
    store in_str_slot+0, 0 as u64
    jmp L_ARRAY_NEXT

L_ARRAY_NEXT_FROM_STRING:
    !is_quote
    jmp L_ARRAY_NEXT

L_ARRAY_STRUCT:
    !is_in_str
    is_quote2 = eq ch, 34
    br is_quote2 -> L_ARRAY_START_STRING, L_ARRAY_CHECK_OPEN

L_ARRAY_START_STRING:
    !is_quote2
    store in_str_slot+0, 1 as u64
    jmp L_ARRAY_NEXT

L_ARRAY_CHECK_OPEN:
    !is_quote2
    is_open = eq ch, 91
    br is_open -> L_ARRAY_INC_DEPTH, L_ARRAY_CHECK_CLOSE

L_ARRAY_INC_DEPTH:
    !is_open
    depth = load depth_slot+0 as u64
    next_depth = add depth, 1
    store depth_slot+0, next_depth as u64
    !next_depth
    !depth
    jmp L_ARRAY_NEXT

L_ARRAY_CHECK_CLOSE:
    !is_open
    is_close = eq ch, 93
    br is_close -> L_ARRAY_DEC_OR_DONE, L_ARRAY_NEXT_FROM_STRUCT

L_ARRAY_DEC_OR_DONE:
    !is_close
    depth2 = load depth_slot+0 as u64
    is_outer = eq depth2, 1
    br is_outer -> L_ARRAY_FOUND_END, L_ARRAY_DEC_DEPTH

L_ARRAY_DEC_DEPTH:
    !is_outer
    next_depth2 = sub depth2, 1
    store depth_slot+0, next_depth2 as u64
    !next_depth2
    !depth2
    jmp L_ARRAY_NEXT

L_ARRAY_FOUND_END:
    !is_outer
    arr_len = add i, 1
    store out_ptr+0, val_ptr as ptr
    store out_len+0, arr_len as u64
    !arr_len
    !depth2
    !ch
    !ch_ptr
    !i
    !done
    !remaining
    !val_ptr
    !val_off
    !val_off_i
    !body
    !body_len
    !key
    !key_len
    !out_ptr
    !out_len
    return 1

L_ARRAY_NEXT_FROM_STRUCT:
    !is_close
    jmp L_ARRAY_NEXT

L_ARRAY_NEXT:
    !ch
    !ch_ptr
    !esc
    !in_str
    next_i = add i, 1
    store i_slot+0, next_i as u64
    !next_i
    !i
    !done
    jmp L_ARRAY_SCAN_COND

L_ARRAY_BAD_FROM_SCAN:
    !done
    !i
    !remaining
    !val_ptr
    !val_off
    !val_off_i
    !body
    !body_len
    !key
    !key_len
    !out_ptr
    !out_len
    return 0

L_ARRAY_BAD:
    !remaining
    !val_ptr
    !val_off
    !val_off_i
    !body
    !body_len
    !key
    !key_len
    !out_ptr
    !out_len
    return 0

L_ARRAY_NOT_FOUND:
    !found
    !idx
    !body
    !body_len
    !key
    !key_len
    !out_ptr
    !out_len
    return 0

@ffi_wrapper append_json_node_raw(&buf: ptr, node: ptr) -> u32:
L_ENTRY:
    buffer_slot = stack_alloc 8
    stringify_status = call @sa_json_stringify(node, &buffer_slot)
    stringify_ok = eq stringify_status, 0
    br stringify_ok -> L_RAW_BUFFER, L_RAW_FAIL

L_RAW_BUFFER:
    !stringify_ok
    buffer = load buffer_slot+0 as ptr
    raw_ptr = call @sa_json_buffer_data(&buffer)
    raw_len = call @sa_json_buffer_len(&buffer)
    append_status = call @rpc_builder_append(&buf, &raw_ptr, raw_len)
    !append_status
    free_res = call @sa_json_buffer_free(^buffer)
    !free_res
    !raw_ptr
    !raw_len
    !stringify_status
    !buf
    !node
    return 1

L_RAW_FAIL:
    !stringify_ok
    !stringify_status
    !buf
    !node
    return 0

@ffi_wrapper rpc_builder_append_thread_envelope_tail(&buf: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    call @rpc_builder_append(&buf, &J_THREAD_START_APPROVAL, J_THREAD_START_APPROVAL_LEN)
    call @rpc_builder_append_param_string_or_default(&buf, &body, body_len, &J_APPROVAL_POLICY_KEY, J_APPROVAL_POLICY_KEY_LEN, &DEFAULT_APPROVAL, DEFAULT_APPROVAL_LEN)
    call @rpc_builder_append(&buf, &J_THREAD_START_REVIEWER, J_THREAD_START_REVIEWER_LEN)
    call @rpc_builder_append_param_string_or_default(&buf, &body, body_len, &J_APPROVALS_REVIEWER_KEY, J_APPROVALS_REVIEWER_KEY_LEN, &DEFAULT_REVIEWER, DEFAULT_REVIEWER_LEN)
    call @rpc_builder_append(&buf, &J_THREAD_START_SANDBOX, J_THREAD_START_SANDBOX_LEN)
    call @rpc_builder_append_param_string_or_default(&buf, &body, body_len, &J_SANDBOX_KEY, J_SANDBOX_KEY_LEN, &DEFAULT_SANDBOX, DEFAULT_SANDBOX_LEN)
    call @rpc_builder_append(&buf, &J_THREAD_START_TAIL, J_THREAD_START_TAIL_LEN)
    !buf
    !body
    !body_len
    return 0

@ffi_wrapper rpc_canonicalize_body(&body: ptr, body_len: u64, &out_ptr: ptr, &out_len: ptr, &out_buffer: ptr) -> u32:
L_ENTRY:
    root = call @sa_json_parse(&body, body_len)
    has_root = ne root, 0
    br has_root -> L_CANON_STRINGIFY, L_CANON_FALLBACK

L_CANON_STRINGIFY:
    !has_root
    buffer_slot = stack_alloc 8
    stringify_status = call @sa_json_stringify(root, &buffer_slot)
    stringify_ok = eq stringify_status, 0
    br stringify_ok -> L_CANON_OK, L_CANON_STRINGIFY_FAIL

L_CANON_OK:
    !stringify_ok
    buffer = load buffer_slot+0 as ptr
    data_ptr = call @sa_json_buffer_data(&buffer)
    data_len = call @sa_json_buffer_len(&buffer)
    store out_ptr+0, data_ptr as ptr
    store out_len+0, data_len as u64
    store out_buffer+0, buffer as ptr
    root_free = call @sa_json_free(^root)
    !root_free
    !data_ptr
    !data_len
    !buffer
    !stringify_status
    !body
    !body_len
    !out_ptr
    !out_len
    !out_buffer
    return 1

L_CANON_STRINGIFY_FAIL:
    !stringify_ok
    !stringify_status
    root_free_bad = call @sa_json_free(^root)
    !root_free_bad
    store out_ptr+0, body as ptr
    store out_len+0, body_len as u64
    store out_buffer+0, 0 as ptr
    !body
    !body_len
    !out_ptr
    !out_len
    !out_buffer
    return 0

L_CANON_FALLBACK:
    !has_root
    store out_ptr+0, body as ptr
    store out_len+0, body_len as u64
    store out_buffer+0, 0 as ptr
    !body
    !body_len
    !out_ptr
    !out_len
    !out_buffer
    return 0

@ffi_wrapper append_with_replacement(&buf: ptr, &src: ptr, src_len: u64, &needle: ptr, needle_len: u64, &replacement: ptr, replacement_len: u64) -> u32:
L_ENTRY:
    i_slot = stack_alloc 8
    store i_slot+0, 0 as u64
    jmp L_REPL_COND

L_REPL_COND:
    i = load i_slot+0 as u64
    done = uge i, src_len
    br done -> L_REPL_DONE, L_REPL_BODY

L_REPL_BODY:
    !done
    remaining = sub src_len, i
    can_match = uge remaining, needle_len
    br can_match -> L_REPL_CHECK, L_REPL_COPY_ONE

L_REPL_CHECK:
    !can_match
    cur_ptr = ptr_add src, i
    match_raw = call @sa_bytes_eq(&cur_ptr, needle_len, &needle, needle_len)
    is_match = eq match_raw, 1
    br is_match -> L_REPL_WRITE_REPLACEMENT, L_REPL_COPY_ONE_FROM_CHECK

L_REPL_WRITE_REPLACEMENT:
    !is_match
    !match_raw
    append_status = call @rpc_builder_append(&buf, &replacement, replacement_len)
    !append_status
    next_i = add i, needle_len
    store i_slot+0, next_i as u64
    !next_i
    !cur_ptr
    !remaining
    !i
    jmp L_REPL_COND

L_REPL_COPY_ONE_FROM_CHECK:
    !is_match
    !match_raw
    !cur_ptr
    jmp L_REPL_COPY_ONE_AFTER_CHECK

L_REPL_COPY_ONE:
    !can_match
    jmp L_REPL_COPY_ONE_AFTER_CHECK

L_REPL_COPY_ONE_AFTER_CHECK:
    ch_ptr = ptr_add src, i
    one_status = call @rpc_builder_append(&buf, &ch_ptr, 1)
    !one_status
    !ch_ptr
    next_one = add i, 1
    store i_slot+0, next_one as u64
    !next_one
    !remaining
    !i
    jmp L_REPL_COND

L_REPL_DONE:
    !done
    !i
    !buf
    !src
    !src_len
    !needle
    !needle_len
    !replacement
    !replacement_len
    return 0

@ffi_wrapper normalize_responses_client_json_body(&body: ptr, body_len: u64, &out_len: ptr) -> ^ptr:
L_ENTRY:
    norm_handle = call @sa_deno_responses_json_normalize(&body, body_len)
    norm_ok = ne norm_handle, 0
    br norm_ok -> L_RESP_JSON_STD_COPY, L_RESP_JSON_STD_COPY_ORIGINAL

L_RESP_JSON_STD_COPY:
    !norm_ok
    norm_ptr = call @sa_fs_read_buffer_data(norm_handle)
    norm_len = call @sa_fs_read_buffer_len(norm_handle)
    out_std = alloc RPC_JSON_BUF_SIZE
    copy_status = call @sa_bytes_copy(&out_std, &norm_ptr, norm_len)
    !copy_status
    free_status = call @sa_fs_read_buffer_free(^norm_handle)
    !free_status
    store out_len+0, norm_len as u64
    !norm_ptr
    !norm_len
    !body
    !body_len
    !out_len
    return out_std

L_RESP_JSON_STD_COPY_ORIGINAL:
    !norm_ok
    !norm_handle
    out_copy = alloc RPC_JSON_BUF_SIZE
    copy_status2 = call @sa_bytes_copy(&out_copy, &body, body_len)
    !copy_status2
    store out_len+0, body_len as u64
    !body
    !body_len
    !out_len
    return out_copy

@ffi_wrapper normalize_chat_fallback_json_body(&body: ptr, body_len: u64, &req_body: ptr, req_body_len: u64, &out_len: ptr) -> ^ptr:
L_ENTRY:
    std_json_handle = call @sa_deno_chat_json_to_responses(&body, body_len, &req_body, req_body_len)
    std_json_ok = ne std_json_handle, 0
    br std_json_ok -> L_CHAT_JSON_STD_COPY, L_CHAT_JSON_STD_COPY_ORIGINAL

L_CHAT_JSON_STD_COPY:
    !std_json_ok
    std_json_ptr = call @sa_fs_read_buffer_data(std_json_handle)
    std_json_len = call @sa_fs_read_buffer_len(std_json_handle)
    out_std_json = alloc RPC_JSON_BUF_SIZE
    std_json_copy_status = call @sa_bytes_copy(&out_std_json, &std_json_ptr, std_json_len)
    !std_json_copy_status
    std_json_free_status = call @sa_fs_read_buffer_free(^std_json_handle)
    !std_json_free_status
    store out_len+0, std_json_len as u64
    !std_json_ptr
    !std_json_len
    !body
    !body_len
    !req_body
    !req_body_len
    !out_len
    return out_std_json

L_CHAT_JSON_STD_COPY_ORIGINAL:
    !std_json_ok
    !std_json_handle
    out_std_json_orig = alloc RPC_JSON_BUF_SIZE
    std_json_copy_orig_status = call @sa_bytes_copy(&out_std_json_orig, &body, body_len)
    !std_json_copy_orig_status
    store out_len+0, body_len as u64
    !body
    !body_len
    !req_body
    !req_body_len
    !out_len
    return out_std_json_orig

@ffi_wrapper normalize_responses_client_sse_body(&body: ptr, body_len: u64, &req_body: ptr, req_body_len: u64, &out_len: ptr) -> ^ptr:
L_ENTRY:
    norm_handle = call @sa_deno_responses_sse_normalize(&body, body_len)
    norm_ptr = call @sa_fs_read_buffer_data(norm_handle)
    norm_len = call @sa_fs_read_buffer_len(norm_handle)

    allow_native_status = call @body_allows_progress_continuation(&req_body, req_body_len)
    allow_native = eq allow_native_status, 1
    br allow_native -> L_NATIVE_CONT_PROGRESS_CHECK, L_NATIVE_CONT_COPY_NO_ALLOW

L_NATIVE_CONT_PROGRESS_CHECK:
    !allow_native
    !allow_native_status
    native_progress_status = call @responses_sse_is_progress_message(&norm_ptr, norm_len)
    native_progress = eq native_progress_status, 1
    br native_progress -> L_NATIVE_CONT_REWRITE, L_NATIVE_CONT_COPY_AFTER_PROGRESS

L_NATIVE_CONT_REWRITE:
    !native_progress
    !native_progress_status
    pass5 = call @rpc_builder_new()
    p5_status = call @append_with_replacement(&pass5, &norm_ptr, norm_len, &RESP_EVENT_COMPLETED_PREFIX, RESP_EVENT_COMPLETED_PREFIX_LEN, &RESP_NATIVE_CONT_BEFORE_COMPLETED, RESP_NATIVE_CONT_BEFORE_COMPLETED_LEN)
    !p5_status
    p5_ptr = call @rpc_builder_data(&pass5)
    p5_len = call @rpc_builder_len(&pass5)
    out2 = alloc RPC_JSON_BUF_SIZE
    copy_status2 = call @sa_bytes_copy(&out2, &p5_ptr, p5_len)
    !copy_status2
    store out_len+0, p5_len as u64
    !p5_ptr
    !p5_len
    !pass5
    norm_free_status2 = call @sa_fs_read_buffer_free(^norm_handle)
    !norm_free_status2
    !norm_ptr
    !norm_len
    !body
    !body_len
    !req_body
    !req_body_len
    !out_len
    return out2

L_NATIVE_CONT_COPY_AFTER_PROGRESS:
    !native_progress
    !native_progress_status
    jmp L_NATIVE_CONT_COPY

L_NATIVE_CONT_COPY_NO_ALLOW:
    !allow_native
    !allow_native_status
    jmp L_NATIVE_CONT_COPY

L_NATIVE_CONT_COPY:
    out = alloc RPC_JSON_BUF_SIZE
    copy_status = call @sa_bytes_copy(&out, &norm_ptr, norm_len)
    !copy_status
    store out_len+0, norm_len as u64
    norm_free_status = call @sa_fs_read_buffer_free(^norm_handle)
    !norm_free_status
    !norm_ptr
    !norm_len
    !body
    !body_len
    !req_body
    !req_body_len
    !out_len
    return out

@ffi_wrapper chat_fallback_sse_to_responses_body(&body: ptr, body_len: u64, &req_body: ptr, req_body_len: u64, &out_len: ptr) -> ^ptr:
L_ENTRY:
    std_sse_handle = call @sa_deno_chat_sse_to_responses(&body, body_len, &req_body, req_body_len)
    std_sse_ok = ne std_sse_handle, 0
    br std_sse_ok -> L_CHAT_SSE_STD_COPY, L_CHAT_SSE_STD_COPY_ORIGINAL

L_CHAT_SSE_STD_COPY:
    !std_sse_ok
    std_sse_ptr = call @sa_fs_read_buffer_data(std_sse_handle)
    std_sse_len = call @sa_fs_read_buffer_len(std_sse_handle)
    out_std = alloc RPC_JSON_BUF_SIZE
    std_copy_status = call @sa_bytes_copy(&out_std, &std_sse_ptr, std_sse_len)
    !std_copy_status
    std_free_status = call @sa_fs_read_buffer_free(^std_sse_handle)
    !std_free_status
    store out_len+0, std_sse_len as u64
    !std_sse_ptr
    !std_sse_len
    !body
    !body_len
    !req_body
    !req_body_len
    !out_len
    return out_std

L_CHAT_SSE_STD_COPY_ORIGINAL:
    !std_sse_ok
    !std_sse_handle
    out_std_orig = alloc RPC_JSON_BUF_SIZE
    std_copy_orig_status = call @sa_bytes_copy(&out_std_orig, &body, body_len)
    !std_copy_orig_status
    store out_len+0, body_len as u64
    !body
    !body_len
    !req_body
    !req_body_len
    !out_len
    return out_std_orig

@ffi_wrapper body_has_responses_tool_history(&body: ptr, body_len: u64) -> u32:
L_ENTRY:
    idx_fn = call @sa_bytes_find(&body, body_len, &RESP_TYPE_FUNCTION_CALL, RESP_TYPE_FUNCTION_CALL_LEN)
    has_fn = sge idx_fn, 0
    !idx_fn
    br has_fn -> L_TOOL_HIST_YES_FN, L_TOOL_HIST_CHECK_CUSTOM

L_TOOL_HIST_YES_FN:
    !has_fn
    !body
    !body_len
    return 1

L_TOOL_HIST_CHECK_CUSTOM:
    !has_fn
    idx_custom = call @sa_bytes_find(&body, body_len, &RESP_TYPE_CUSTOM_TOOL_CALL, RESP_TYPE_CUSTOM_TOOL_CALL_LEN)
    has_custom = sge idx_custom, 0
    !idx_custom
    br has_custom -> L_TOOL_HIST_YES_CUSTOM, L_TOOL_HIST_CHECK_SEARCH

L_TOOL_HIST_YES_CUSTOM:
    !has_custom
    !body
    !body_len
    return 1

L_TOOL_HIST_CHECK_SEARCH:
    !has_custom
    idx_search = call @sa_bytes_find(&body, body_len, &RESP_TYPE_TOOL_SEARCH_CALL, RESP_TYPE_TOOL_SEARCH_CALL_LEN)
    has_search = sge idx_search, 0
    !idx_search
    br has_search -> L_TOOL_HIST_YES_SEARCH, L_TOOL_HIST_CHECK_MCP

L_TOOL_HIST_YES_SEARCH:
    !has_search
    !body
    !body_len
    return 1

L_TOOL_HIST_CHECK_MCP:
    !has_search
    idx_mcp = call @sa_bytes_find(&body, body_len, &RESP_TYPE_MCP_TOOL_CALL, RESP_TYPE_MCP_TOOL_CALL_LEN)
    has_mcp = sge idx_mcp, 0
    !idx_mcp
    br has_mcp -> L_TOOL_HIST_YES_MCP, L_TOOL_HIST_CHECK_FN_OUT

L_TOOL_HIST_YES_MCP:
    !has_mcp
    !body
    !body_len
    return 1

L_TOOL_HIST_CHECK_FN_OUT:
    !has_mcp
    idx_fn_out = call @sa_bytes_find(&body, body_len, &RESP_TYPE_FUNCTION_OUTPUT, RESP_TYPE_FUNCTION_OUTPUT_LEN)
    has_fn_out = sge idx_fn_out, 0
    !idx_fn_out
    br has_fn_out -> L_TOOL_HIST_YES_FN_OUT, L_TOOL_HIST_CHECK_CUSTOM_OUT

L_TOOL_HIST_YES_FN_OUT:
    !has_fn_out
    !body
    !body_len
    return 1

L_TOOL_HIST_CHECK_CUSTOM_OUT:
    !has_fn_out
    idx_custom_out = call @sa_bytes_find(&body, body_len, &RESP_TYPE_CUSTOM_OUTPUT, RESP_TYPE_CUSTOM_OUTPUT_LEN)
    has_custom_out = sge idx_custom_out, 0
    !idx_custom_out
    br has_custom_out -> L_TOOL_HIST_YES_CUSTOM_OUT, L_TOOL_HIST_CHECK_SEARCH_OUT

L_TOOL_HIST_YES_CUSTOM_OUT:
    !has_custom_out
    !body
    !body_len
    return 1

L_TOOL_HIST_CHECK_SEARCH_OUT:
    !has_custom_out
    idx_search_out = call @sa_bytes_find(&body, body_len, &RESP_TYPE_TOOL_SEARCH_OUTPUT, RESP_TYPE_TOOL_SEARCH_OUTPUT_LEN)
    has_search_out = sge idx_search_out, 0
    !idx_search_out
    br has_search_out -> L_TOOL_HIST_YES_SEARCH_OUT, L_TOOL_HIST_CHECK_MCP_OUT

L_TOOL_HIST_YES_SEARCH_OUT:
    !has_search_out
    !body
    !body_len
    return 1

L_TOOL_HIST_CHECK_MCP_OUT:
    !has_search_out
    idx_mcp_out = call @sa_bytes_find(&body, body_len, &RESP_TYPE_MCP_OUTPUT, RESP_TYPE_MCP_OUTPUT_LEN)
    has_mcp_out = sge idx_mcp_out, 0
    !idx_mcp_out
    br has_mcp_out -> L_TOOL_HIST_YES_MCP_OUT, L_TOOL_HIST_NO

L_TOOL_HIST_YES_MCP_OUT:
    !has_mcp_out
    !body
    !body_len
    return 1

L_TOOL_HIST_NO:
    !has_mcp_out
    !body
    !body_len
    return 0

@ffi_wrapper body_is_unsafe_gemini_chat_fallback(&body: ptr, body_len: u64) -> u32:
L_ENTRY:
    is_gemini = call @body_is_gemini_responses_request(&body, body_len)
    gemini_ok = eq is_gemini, 1
    br gemini_ok -> L_UNSAFE_GEMINI_CHECK_TOOLS, L_UNSAFE_GEMINI_NO

L_UNSAFE_GEMINI_CHECK_TOOLS:
    !gemini_ok
    has_tools = call @body_has_responses_tool_history(&body, body_len)
    unsafe = eq has_tools, 1
    !has_tools
    !is_gemini
    !body
    !body_len
    return unsafe

L_UNSAFE_GEMINI_NO:
    !gemini_ok
    !is_gemini
    !body
    !body_len
    return 0

@ffi_wrapper append_chat_fallback_tool_dom_source(&buf: ptr, tool_node: ptr, source_node: ptr, &prefix: ptr, prefix_len: u64, &first_slot: ptr) -> u32:
L_ENTRY:
    name_slot = stack_alloc 8
    name_status = call @sa_json_object_get(source_node, &FB_KEY_NAME, FB_KEY_NAME_LEN, &name_slot)
    name_ok = eq name_status, 0
    br name_ok -> L_DOM_NAME, L_DOM_NO_NAME

L_DOM_NAME:
    !name_ok
    name_node = load name_slot+0 as ptr
    name_kind = call @sa_json_kind(name_node)
    name_is_string = eq name_kind, SA_JSON_KIND_STRING
    !name_kind
    br name_is_string -> L_DOM_TYPE_CHECK, L_DOM_NAME_BAD

L_DOM_TYPE_CHECK:
    !name_is_string
    type_slot = stack_alloc 8
    type_status = call @sa_json_object_get(tool_node, &FB_KEY_TYPE, FB_KEY_TYPE_LEN, &type_slot)
    has_type = eq type_status, 0
    br has_type -> L_DOM_TYPE_HANDLE, L_DOM_APPEND_NO_TYPE

L_DOM_TYPE_HANDLE:
    !has_type
    type_node = load type_slot+0 as ptr
    type_kind = call @sa_json_kind(type_node)
    type_is_string = eq type_kind, SA_JSON_KIND_STRING
    !type_kind
    br type_is_string -> L_DOM_TYPE_COMPARE, L_DOM_SKIP_TYPE_FREE

L_DOM_TYPE_COMPARE:
    !type_is_string
    type_ptr = call @sa_json_string_ptr(type_node)
    type_len = call @sa_json_string_len(type_node)
    type_match_raw = call @sa_bytes_eq(&type_ptr, type_len, &FB_TYPE_FUNCTION, FB_TYPE_FUNCTION_LEN)
    type_match = eq type_match_raw, 1
    !type_match_raw
    br type_match -> L_DOM_TYPE_OK, L_DOM_SKIP_TYPE

L_DOM_TYPE_OK:
    !type_match
    !type_ptr
    !type_len
    type_free_ok = call @sa_json_free(^type_node)
    !type_free_ok
    !type_status
    jmp L_DOM_APPEND

L_DOM_APPEND_NO_TYPE:
    !has_type
    !type_status
    jmp L_DOM_APPEND

L_DOM_SKIP_TYPE:
    !type_match
    !type_ptr
    !type_len
    type_free_skip = call @sa_json_free(^type_node)
    !type_free_skip
    !type_status
    name_free_skip = call @sa_json_free(^name_node)
    !name_free_skip
    !name_status
    !buf
    !tool_node
    !source_node
    !prefix
    !prefix_len
    !first_slot
    return 0

L_DOM_SKIP_TYPE_FREE:
    !type_is_string
    type_free_bad = call @sa_json_free(^type_node)
    !type_free_bad
    !type_status
    name_free_bad_type = call @sa_json_free(^name_node)
    !name_free_bad_type
    !name_status
    !buf
    !tool_node
    !source_node
    !prefix
    !prefix_len
    !first_slot
    return 0

L_DOM_APPEND:
    name_ptr = call @sa_json_string_ptr(name_node)
    name_len = call @sa_json_string_len(name_node)
    full_name_len = add prefix_len, name_len
    full_name = alloc full_name_len
    full_prefix_copy = call @sa_bytes_copy(&full_name, &prefix, prefix_len)
    !full_prefix_copy
    full_name_dst = ptr_add full_name, prefix_len
    full_name_copy = call @sa_bytes_copy(&full_name_dst, &name_ptr, name_len)
    !full_name_copy
    !full_name_dst
    is_first = load first_slot+0 as u8
    first_ok = eq is_first, 1
    br first_ok -> L_DOM_NO_COMMA, L_DOM_WITH_COMMA

L_DOM_WITH_COMMA:
    !first_ok
    comma_status = call @rpc_builder_append(&buf, &CHAT_FB_COMMA, CHAT_FB_COMMA_LEN)
    !comma_status
    jmp L_DOM_APPEND_BODY

L_DOM_NO_COMMA:
    !first_ok
    store first_slot+0, 0 as u8
    jmp L_DOM_APPEND_BODY

L_DOM_APPEND_BODY:
    call @rpc_builder_append(&buf, &CHAT_FB_TOOL_A, CHAT_FB_TOOL_A_LEN)
    call @rpc_builder_append_json_string(&buf, &full_name, full_name_len)
    desc_slot = stack_alloc 8
    desc_status = call @sa_json_object_get(source_node, &FB_KEY_DESCRIPTION, FB_KEY_DESCRIPTION_LEN, &desc_slot)
    desc_ok = eq desc_status, 0
    br desc_ok -> L_DOM_DESC, L_DOM_PARAMS_NO_DESC

L_DOM_DESC:
    !desc_ok
    desc_node = load desc_slot+0 as ptr
    desc_kind = call @sa_json_kind(desc_node)
    desc_is_string = eq desc_kind, SA_JSON_KIND_STRING
    !desc_kind
    br desc_is_string -> L_DOM_DESC_APPEND, L_DOM_DESC_FREE

L_DOM_DESC_APPEND:
    !desc_is_string
    desc_ptr = call @sa_json_string_ptr(desc_node)
    desc_len = call @sa_json_string_len(desc_node)
    call @rpc_builder_append(&buf, &CHAT_FB_TOOL_DESC_A, CHAT_FB_TOOL_DESC_A_LEN)
    call @rpc_builder_append_json_string(&buf, &desc_ptr, desc_len)
    !desc_ptr
    !desc_len
    jmp L_DOM_DESC_FREE_AFTER

L_DOM_DESC_FREE:
    !desc_is_string
    jmp L_DOM_DESC_FREE_AFTER

L_DOM_DESC_FREE_AFTER:
    desc_free = call @sa_json_free(^desc_node)
    !desc_free
    !desc_status
    jmp L_DOM_PARAMS

L_DOM_PARAMS_NO_DESC:
    !desc_ok
    !desc_status
    jmp L_DOM_PARAMS

L_DOM_PARAMS:
    params_slot = stack_alloc 8
    params_status = call @sa_json_object_get(source_node, &FB_KEY_PARAMETERS, FB_KEY_PARAMETERS_LEN, &params_slot)
    params_ok = eq params_status, 0
    br params_ok -> L_DOM_PARAMS_APPEND, L_DOM_CLOSE_NO_PARAMS

L_DOM_PARAMS_APPEND:
    !params_ok
    params_node = load params_slot+0 as ptr
    call @rpc_builder_append(&buf, &CHAT_FB_TOOL_PARAMS_A, CHAT_FB_TOOL_PARAMS_A_LEN)
    raw_status = call @append_json_node_raw(&buf, params_node)
    !raw_status
    params_free = call @sa_json_free(^params_node)
    !params_free
    !params_status
    jmp L_DOM_CLOSE

L_DOM_CLOSE_NO_PARAMS:
    !params_ok
    !params_status
    jmp L_DOM_CLOSE

L_DOM_CLOSE:
    strict_slot = stack_alloc 1
    strict_tool_slot = stack_alloc 1
    strict_status = call @sa_json_object_get_bool(source_node, &FB_KEY_STRICT, FB_KEY_STRICT_LEN, &strict_slot)
    strict_ok = eq strict_status, 0
    br strict_ok -> L_DOM_STRICT_SOURCE, L_DOM_STRICT_SOURCE_MISSING

L_DOM_STRICT_SOURCE:
    !strict_ok
    strict_value = load strict_slot+0 as u8
    !strict_status
    jmp L_DOM_STRICT_APPEND_SOURCE

L_DOM_STRICT_SOURCE_MISSING:
    !strict_ok
    !strict_status
    strict_tool_status = call @sa_json_object_get_bool(tool_node, &FB_KEY_STRICT, FB_KEY_STRICT_LEN, &strict_tool_slot)
    strict_tool_ok = eq strict_tool_status, 0
    br strict_tool_ok -> L_DOM_STRICT_TOOL, L_DOM_STRICT_TOOL_MISSING

L_DOM_STRICT_TOOL:
    !strict_tool_ok
    strict_tool_value = load strict_tool_slot+0 as u8
    !strict_tool_status
    jmp L_DOM_STRICT_APPEND_TOOL

L_DOM_STRICT_TOOL_MISSING:
    !strict_tool_ok
    !strict_tool_status
    jmp L_DOM_CLOSE_BODY

L_DOM_STRICT_APPEND_SOURCE:
    strict_is_true = eq strict_value, 1
    br strict_is_true -> L_DOM_STRICT_TRUE_SOURCE, L_DOM_STRICT_FALSE_SOURCE

L_DOM_STRICT_TRUE_SOURCE:
    !strict_is_true
    call @rpc_builder_append(&buf, &CHAT_FB_TOOL_STRICT_TRUE, CHAT_FB_TOOL_STRICT_TRUE_LEN)
    !strict_value
    jmp L_DOM_CLOSE_BODY

L_DOM_STRICT_FALSE_SOURCE:
    !strict_is_true
    call @rpc_builder_append(&buf, &CHAT_FB_TOOL_STRICT_FALSE, CHAT_FB_TOOL_STRICT_FALSE_LEN)
    !strict_value
    jmp L_DOM_CLOSE_BODY

L_DOM_STRICT_APPEND_TOOL:
    strict_tool_is_true = eq strict_tool_value, 1
    br strict_tool_is_true -> L_DOM_STRICT_TRUE_TOOL, L_DOM_STRICT_FALSE_TOOL

L_DOM_STRICT_TRUE_TOOL:
    !strict_tool_is_true
    call @rpc_builder_append(&buf, &CHAT_FB_TOOL_STRICT_TRUE, CHAT_FB_TOOL_STRICT_TRUE_LEN)
    !strict_tool_value
    jmp L_DOM_CLOSE_BODY

L_DOM_STRICT_FALSE_TOOL:
    !strict_tool_is_true
    call @rpc_builder_append(&buf, &CHAT_FB_TOOL_STRICT_FALSE, CHAT_FB_TOOL_STRICT_FALSE_LEN)
    !strict_tool_value
    jmp L_DOM_CLOSE_BODY

L_DOM_CLOSE_BODY:
    call @rpc_builder_append(&buf, &CHAT_FB_TOOL_CLOSE, CHAT_FB_TOOL_CLOSE_LEN)
    name_free = call @sa_json_free(^name_node)
    !name_free
    !full_name
    !full_name_len
    !name_ptr
    !name_len
    !is_first
    !name_status
    !buf
    !tool_node
    !source_node
    !prefix
    !prefix_len
    !first_slot
    return 1

L_DOM_NAME_BAD:
    !name_is_string
    name_free_bad = call @sa_json_free(^name_node)
    !name_free_bad
    !name_status
    !buf
    !tool_node
    !source_node
    !prefix
    !prefix_len
    !first_slot
    return 0

L_DOM_NO_NAME:
    !name_ok
    !name_status
    !buf
    !tool_node
    !source_node
    !prefix
    !prefix_len
    !first_slot
    return 0

@ffi_wrapper append_chat_fallback_tool_dom(&buf: ptr, tool_node: ptr, &first_slot: ptr) -> u32:
L_ENTRY:
    type_slot = stack_alloc 8
    type_status = call @sa_json_object_get(tool_node, &FB_KEY_TYPE, FB_KEY_TYPE_LEN, &type_slot)
    has_type = eq type_status, 0
    br has_type -> L_DOM_TOOL_TYPE, L_DOM_TOOL_NO_TYPE

L_DOM_TOOL_TYPE:
    !has_type
    type_node = load type_slot+0 as ptr
    type_kind = call @sa_json_kind(type_node)
    type_is_string = eq type_kind, SA_JSON_KIND_STRING
    !type_kind
    br type_is_string -> L_DOM_TOOL_TYPE_COMPARE, L_DOM_TOOL_TYPE_BAD

L_DOM_TOOL_TYPE_COMPARE:
    !type_is_string
    type_ptr = call @sa_json_string_ptr(type_node)
    type_len = call @sa_json_string_len(type_node)
    type_ns_raw = call @sa_bytes_eq(&type_ptr, type_len, &FB_TYPE_NAMESPACE, FB_TYPE_NAMESPACE_LEN)
    type_is_ns = eq type_ns_raw, 1
    !type_ns_raw
    br type_is_ns -> L_DOM_TOOL_NAMESPACE, L_DOM_TOOL_FUNCTION_OR_SKIP

L_DOM_TOOL_NAMESPACE:
    !type_is_ns
    !type_ptr
    !type_len
    type_free_ns = call @sa_json_free(^type_node)
    !type_free_ns
    !type_status
    ns_appended = call @append_chat_fallback_namespace_tools_dom(&buf, tool_node, &first_slot)
    !buf
    !tool_node
    !first_slot
    return ns_appended

L_DOM_TOOL_FUNCTION_OR_SKIP:
    !type_is_ns
    type_fn_raw = call @sa_bytes_eq(&type_ptr, type_len, &FB_TYPE_FUNCTION, FB_TYPE_FUNCTION_LEN)
    type_is_fn = eq type_fn_raw, 1
    !type_fn_raw
    br type_is_fn -> L_DOM_TOOL_FUNCTION_TYPE_OK, L_DOM_TOOL_TYPE_SKIP

L_DOM_TOOL_FUNCTION_TYPE_OK:
    !type_is_fn
    !type_ptr
    !type_len
    type_free_fn = call @sa_json_free(^type_node)
    !type_free_fn
    !type_status
    jmp L_DOM_TOOL_APPEND_FUNCTION

L_DOM_TOOL_TYPE_SKIP:
    !type_is_fn
    !type_ptr
    !type_len
    type_free_skip = call @sa_json_free(^type_node)
    !type_free_skip
    !type_status
    !buf
    !tool_node
    !first_slot
    return 0

L_DOM_TOOL_TYPE_BAD:
    !type_is_string
    type_free_bad = call @sa_json_free(^type_node)
    !type_free_bad
    !type_status
    !buf
    !tool_node
    !first_slot
    return 0

L_DOM_TOOL_NO_TYPE:
    !has_type
    !type_status
    jmp L_DOM_TOOL_APPEND_FUNCTION

L_DOM_TOOL_APPEND_FUNCTION:
    fn_slot = stack_alloc 8
    fn_status = call @sa_json_object_get(tool_node, &FB_KEY_FUNCTION, FB_KEY_FUNCTION_LEN, &fn_slot)
    has_fn = eq fn_status, 0
    br has_fn -> L_DOM_HAS_FN, L_DOM_FLAT

L_DOM_HAS_FN:
    !has_fn
    fn_node = load fn_slot+0 as ptr
    appended = call @append_chat_fallback_tool_dom_source(&buf, tool_node, fn_node, &EMPTY_TEXT, 0, &first_slot)
    fn_free = call @sa_json_free(^fn_node)
    !fn_free
    !fn_status
    !buf
    !tool_node
    !first_slot
    return appended

L_DOM_FLAT:
    !has_fn
    appended2 = call @append_chat_fallback_tool_dom_source(&buf, tool_node, tool_node, &EMPTY_TEXT, 0, &first_slot)
    !fn_status
    !buf
    !tool_node
    !first_slot
    return appended2

@ffi_wrapper append_chat_fallback_tool_dom_with_prefix(&buf: ptr, tool_node: ptr, &prefix: ptr, prefix_len: u64, &first_slot: ptr) -> u32:
L_ENTRY:
    fn_slot = stack_alloc 8
    fn_status = call @sa_json_object_get(tool_node, &FB_KEY_FUNCTION, FB_KEY_FUNCTION_LEN, &fn_slot)
    has_fn = eq fn_status, 0
    br has_fn -> L_PREFIX_HAS_FN, L_PREFIX_FLAT

L_PREFIX_HAS_FN:
    !has_fn
    fn_node = load fn_slot+0 as ptr
    appended = call @append_chat_fallback_tool_dom_source(&buf, tool_node, fn_node, &prefix, prefix_len, &first_slot)
    fn_free = call @sa_json_free(^fn_node)
    !fn_free
    !fn_status
    !buf
    !tool_node
    !prefix
    !prefix_len
    !first_slot
    return appended

L_PREFIX_FLAT:
    !has_fn
    appended2 = call @append_chat_fallback_tool_dom_source(&buf, tool_node, tool_node, &prefix, prefix_len, &first_slot)
    !fn_status
    !buf
    !tool_node
    !prefix
    !prefix_len
    !first_slot
    return appended2

@ffi_wrapper append_chat_fallback_namespace_tools_dom(&buf: ptr, ns_node: ptr, &first_slot: ptr) -> u32:
L_ENTRY:
    ns_name_slot = stack_alloc 8
    ns_name_status = call @sa_json_object_get(ns_node, &FB_KEY_NAME, FB_KEY_NAME_LEN, &ns_name_slot)
    ns_name_ok = eq ns_name_status, 0
    br ns_name_ok -> L_NS_NAME, L_NS_NO_NAME

L_NS_NAME:
    !ns_name_ok
    ns_name_node = load ns_name_slot+0 as ptr
    ns_name_kind = call @sa_json_kind(ns_name_node)
    ns_name_is_string = eq ns_name_kind, SA_JSON_KIND_STRING
    !ns_name_kind
    br ns_name_is_string -> L_NS_TOOLS, L_NS_NAME_BAD

L_NS_TOOLS:
    !ns_name_is_string
    ns_prefix = call @sa_json_string_ptr(ns_name_node)
    ns_prefix_len = call @sa_json_string_len(ns_name_node)
    ns_tools_slot = stack_alloc 8
    ns_tools_status = call @sa_json_object_get(ns_node, &FB_KEY_TOOLS, FB_KEY_TOOLS_LEN, &ns_tools_slot)
    ns_has_tools = eq ns_tools_status, 0
    br ns_has_tools -> L_NS_LOOP_PREP, L_NS_NO_TOOLS_FREE

L_NS_LOOP_PREP:
    !ns_has_tools
    ns_tools_node = load ns_tools_slot+0 as ptr
    ns_count_slot = stack_alloc 8
    ns_count_status = call @sa_json_value_count(ns_tools_node, &ns_count_slot)
    ns_count_ok = eq ns_count_status, 0
    br ns_count_ok -> L_NS_LOOP_INIT, L_NS_TOOLS_FREE_EMPTY

L_NS_LOOP_INIT:
    !ns_count_ok
    ns_count = load ns_count_slot+0 as u64
    ns_index_slot = stack_alloc 8
    ns_item_slot = stack_alloc 8
    store ns_index_slot+0, 0 as u64
    jmp L_NS_LOOP_COND

L_NS_LOOP_COND:
    ns_index = load ns_index_slot+0 as u64
    ns_has_next = ult ns_index, ns_count
    br ns_has_next -> L_NS_LOOP_BODY, L_NS_LOOP_DONE

L_NS_LOOP_BODY:
    !ns_has_next
    ns_item_status = call @sa_json_array_get(ns_tools_node, ns_index, &ns_item_slot)
    ns_item_ok = eq ns_item_status, 0
    br ns_item_ok -> L_NS_ITEM, L_NS_ITEM_NEXT

L_NS_ITEM:
    !ns_item_ok
    ns_item_node = load ns_item_slot+0 as ptr
    ns_append = call @append_chat_fallback_tool_dom_with_prefix(&buf, ns_item_node, &ns_prefix, ns_prefix_len, &first_slot)
    ns_item_free = call @sa_json_free(^ns_item_node)
    !ns_item_free
    !ns_append
    !ns_item_status
    jmp L_NS_ITEM_ADVANCE

L_NS_ITEM_NEXT:
    !ns_item_ok
    !ns_item_status
    jmp L_NS_ITEM_ADVANCE

L_NS_ITEM_ADVANCE:
    ns_next_index = add ns_index, 1
    store ns_index_slot+0, ns_next_index as u64
    !ns_next_index
    !ns_index
    jmp L_NS_LOOP_COND

L_NS_LOOP_DONE:
    !ns_has_next
    !ns_index
    ns_tools_free = call @sa_json_free(^ns_tools_node)
    !ns_tools_free
    ns_name_free = call @sa_json_free(^ns_name_node)
    !ns_name_free
    !ns_prefix
    !ns_prefix_len
    !ns_count
    !ns_count_status
    !ns_tools_status
    !ns_name_status
    !buf
    !ns_node
    !first_slot
    return 1

L_NS_TOOLS_FREE_EMPTY:
    !ns_count_ok
    ns_tools_free_empty = call @sa_json_free(^ns_tools_node)
    !ns_tools_free_empty
    ns_name_free_empty = call @sa_json_free(^ns_name_node)
    !ns_name_free_empty
    !ns_prefix
    !ns_prefix_len
    !ns_count_status
    !ns_tools_status
    !ns_name_status
    !buf
    !ns_node
    !first_slot
    return 0

L_NS_NO_TOOLS_FREE:
    !ns_has_tools
    ns_name_free_no_tools = call @sa_json_free(^ns_name_node)
    !ns_name_free_no_tools
    !ns_prefix
    !ns_prefix_len
    !ns_tools_status
    !ns_name_status
    !buf
    !ns_node
    !first_slot
    return 0

L_NS_NAME_BAD:
    !ns_name_is_string
    ns_name_free_bad = call @sa_json_free(^ns_name_node)
    !ns_name_free_bad
    !ns_name_status
    !buf
    !ns_node
    !first_slot
    return 0

L_NS_NO_NAME:
    !ns_name_ok
    !ns_name_status
    !buf
    !ns_node
    !first_slot
    return 0

@ffi_wrapper append_chat_fallback_tool_dom_at(&buf: ptr, tools_node: ptr, index: u64, &first_slot: ptr) -> u32:
L_ENTRY:
    item_slot = stack_alloc 8
    item_status = call @sa_json_array_get(tools_node, index, &item_slot)
    item_ok = eq item_status, 0
    br item_ok -> L_DOM_AT_ITEM, L_DOM_AT_NONE

L_DOM_AT_ITEM:
    !item_ok
    item_node = load item_slot+0 as ptr
    item_append_status = call @append_chat_fallback_tool_dom(&buf, item_node, &first_slot)
    item_free = call @sa_json_free(^item_node)
    !item_free
    !item_status
    !buf
    !tools_node
    !index
    !first_slot
    return item_append_status

L_DOM_AT_NONE:
    !item_ok
    !item_status
    !buf
    !tools_node
    !index
    !first_slot
    return 0

@ffi_wrapper append_responses_tool_dom_source(&buf: ptr, tool_node: ptr, source_node: ptr, &prefix: ptr, prefix_len: u64, &first_slot: ptr) -> u32:
L_ENTRY:
    name_slot = stack_alloc 8
    name_status = call @sa_json_object_get(source_node, &FB_KEY_NAME, FB_KEY_NAME_LEN, &name_slot)
    name_ok = eq name_status, 0
    br name_ok -> L_RESP_DOM_NAME, L_RESP_DOM_NO_NAME

L_RESP_DOM_NAME:
    !name_ok
    name_node = load name_slot+0 as ptr
    name_kind = call @sa_json_kind(name_node)
    name_is_string = eq name_kind, SA_JSON_KIND_STRING
    !name_kind
    br name_is_string -> L_RESP_DOM_TYPE_CHECK, L_RESP_DOM_NAME_BAD

L_RESP_DOM_TYPE_CHECK:
    !name_is_string
    type_slot = stack_alloc 8
    type_status = call @sa_json_object_get(tool_node, &FB_KEY_TYPE, FB_KEY_TYPE_LEN, &type_slot)
    has_type = eq type_status, 0
    br has_type -> L_RESP_DOM_TYPE_HANDLE, L_RESP_DOM_APPEND_NO_TYPE

L_RESP_DOM_TYPE_HANDLE:
    !has_type
    type_node = load type_slot+0 as ptr
    type_kind = call @sa_json_kind(type_node)
    type_is_string = eq type_kind, SA_JSON_KIND_STRING
    !type_kind
    br type_is_string -> L_RESP_DOM_TYPE_COMPARE, L_RESP_DOM_SKIP_TYPE_FREE

L_RESP_DOM_TYPE_COMPARE:
    !type_is_string
    type_ptr = call @sa_json_string_ptr(type_node)
    type_len = call @sa_json_string_len(type_node)
    type_match_raw = call @sa_bytes_eq(&type_ptr, type_len, &FB_TYPE_FUNCTION, FB_TYPE_FUNCTION_LEN)
    type_match = eq type_match_raw, 1
    !type_match_raw
    br type_match -> L_RESP_DOM_TYPE_OK, L_RESP_DOM_SKIP_TYPE

L_RESP_DOM_TYPE_OK:
    !type_match
    !type_ptr
    !type_len
    type_free_ok = call @sa_json_free(^type_node)
    !type_free_ok
    !type_status
    jmp L_RESP_DOM_APPEND

L_RESP_DOM_APPEND_NO_TYPE:
    !has_type
    !type_status
    jmp L_RESP_DOM_APPEND

L_RESP_DOM_SKIP_TYPE:
    !type_match
    !type_ptr
    !type_len
    type_free_skip = call @sa_json_free(^type_node)
    !type_free_skip
    !type_status
    name_free_skip = call @sa_json_free(^name_node)
    !name_free_skip
    !name_status
    !buf
    !tool_node
    !source_node
    !prefix
    !prefix_len
    !first_slot
    return 0

L_RESP_DOM_SKIP_TYPE_FREE:
    !type_is_string
    type_free_bad = call @sa_json_free(^type_node)
    !type_free_bad
    !type_status
    name_free_bad_type = call @sa_json_free(^name_node)
    !name_free_bad_type
    !name_status
    !buf
    !tool_node
    !source_node
    !prefix
    !prefix_len
    !first_slot
    return 0

L_RESP_DOM_APPEND:
    name_ptr = call @sa_json_string_ptr(name_node)
    name_len = call @sa_json_string_len(name_node)
    full_name_len = add prefix_len, name_len
    full_name = alloc full_name_len
    full_prefix_copy = call @sa_bytes_copy(&full_name, &prefix, prefix_len)
    !full_prefix_copy
    full_name_dst = ptr_add full_name, prefix_len
    full_name_copy = call @sa_bytes_copy(&full_name_dst, &name_ptr, name_len)
    !full_name_copy
    !full_name_dst
    is_first = load first_slot+0 as u8
    first_ok = eq is_first, 1
    br first_ok -> L_RESP_DOM_NO_COMMA, L_RESP_DOM_WITH_COMMA

L_RESP_DOM_WITH_COMMA:
    !first_ok
    comma_status = call @rpc_builder_append(&buf, &CHAT_FB_COMMA, CHAT_FB_COMMA_LEN)
    !comma_status
    jmp L_RESP_DOM_APPEND_BODY

L_RESP_DOM_NO_COMMA:
    !first_ok
    store first_slot+0, 0 as u8
    jmp L_RESP_DOM_APPEND_BODY

L_RESP_DOM_APPEND_BODY:
    call @rpc_builder_append(&buf, &RESP_TOOL_A, RESP_TOOL_A_LEN)
    call @rpc_builder_append_json_string(&buf, &full_name, full_name_len)
    desc_slot = stack_alloc 8
    desc_status = call @sa_json_object_get(source_node, &FB_KEY_DESCRIPTION, FB_KEY_DESCRIPTION_LEN, &desc_slot)
    desc_ok = eq desc_status, 0
    br desc_ok -> L_RESP_DOM_DESC, L_RESP_DOM_PARAMS_NO_DESC

L_RESP_DOM_DESC:
    !desc_ok
    desc_node = load desc_slot+0 as ptr
    desc_kind = call @sa_json_kind(desc_node)
    desc_is_string = eq desc_kind, SA_JSON_KIND_STRING
    !desc_kind
    br desc_is_string -> L_RESP_DOM_DESC_APPEND, L_RESP_DOM_DESC_FREE

L_RESP_DOM_DESC_APPEND:
    !desc_is_string
    desc_ptr = call @sa_json_string_ptr(desc_node)
    desc_len = call @sa_json_string_len(desc_node)
    call @rpc_builder_append(&buf, &CHAT_FB_TOOL_DESC_A, CHAT_FB_TOOL_DESC_A_LEN)
    call @rpc_builder_append_json_string(&buf, &desc_ptr, desc_len)
    !desc_ptr
    !desc_len
    jmp L_RESP_DOM_DESC_FREE_AFTER

L_RESP_DOM_DESC_FREE:
    !desc_is_string
    jmp L_RESP_DOM_DESC_FREE_AFTER

L_RESP_DOM_DESC_FREE_AFTER:
    desc_free = call @sa_json_free(^desc_node)
    !desc_free
    !desc_status
    jmp L_RESP_DOM_PARAMS

L_RESP_DOM_PARAMS_NO_DESC:
    !desc_ok
    !desc_status
    jmp L_RESP_DOM_PARAMS

L_RESP_DOM_PARAMS:
    params_slot = stack_alloc 8
    params_status = call @sa_json_object_get(source_node, &FB_KEY_PARAMETERS, FB_KEY_PARAMETERS_LEN, &params_slot)
    params_ok = eq params_status, 0
    br params_ok -> L_RESP_DOM_PARAMS_APPEND, L_RESP_DOM_CLOSE_NO_PARAMS

L_RESP_DOM_PARAMS_APPEND:
    !params_ok
    params_node = load params_slot+0 as ptr
    call @rpc_builder_append(&buf, &CHAT_FB_TOOL_PARAMS_A, CHAT_FB_TOOL_PARAMS_A_LEN)
    raw_status = call @append_json_node_raw(&buf, params_node)
    !raw_status
    params_free = call @sa_json_free(^params_node)
    !params_free
    !params_status
    jmp L_RESP_DOM_CLOSE

L_RESP_DOM_CLOSE_NO_PARAMS:
    !params_ok
    !params_status
    jmp L_RESP_DOM_CLOSE

L_RESP_DOM_CLOSE:
    strict_slot = stack_alloc 1
    strict_tool_slot = stack_alloc 1
    strict_status = call @sa_json_object_get_bool(source_node, &FB_KEY_STRICT, FB_KEY_STRICT_LEN, &strict_slot)
    strict_ok = eq strict_status, 0
    br strict_ok -> L_RESP_DOM_STRICT_SOURCE, L_RESP_DOM_STRICT_SOURCE_MISSING

L_RESP_DOM_STRICT_SOURCE:
    !strict_ok
    strict_value = load strict_slot+0 as u8
    !strict_status
    jmp L_RESP_DOM_STRICT_APPEND_SOURCE

L_RESP_DOM_STRICT_SOURCE_MISSING:
    !strict_ok
    !strict_status
    strict_tool_status = call @sa_json_object_get_bool(tool_node, &FB_KEY_STRICT, FB_KEY_STRICT_LEN, &strict_tool_slot)
    strict_tool_ok = eq strict_tool_status, 0
    br strict_tool_ok -> L_RESP_DOM_STRICT_TOOL, L_RESP_DOM_STRICT_TOOL_MISSING

L_RESP_DOM_STRICT_TOOL:
    !strict_tool_ok
    strict_tool_value = load strict_tool_slot+0 as u8
    !strict_tool_status
    jmp L_RESP_DOM_STRICT_APPEND_TOOL

L_RESP_DOM_STRICT_TOOL_MISSING:
    !strict_tool_ok
    !strict_tool_status
    jmp L_RESP_DOM_CLOSE_BODY

L_RESP_DOM_STRICT_APPEND_SOURCE:
    strict_is_true = eq strict_value, 1
    br strict_is_true -> L_RESP_DOM_STRICT_TRUE_SOURCE, L_RESP_DOM_STRICT_FALSE_SOURCE

L_RESP_DOM_STRICT_TRUE_SOURCE:
    !strict_is_true
    call @rpc_builder_append(&buf, &CHAT_FB_TOOL_STRICT_TRUE, CHAT_FB_TOOL_STRICT_TRUE_LEN)
    !strict_value
    jmp L_RESP_DOM_CLOSE_BODY

L_RESP_DOM_STRICT_FALSE_SOURCE:
    !strict_is_true
    call @rpc_builder_append(&buf, &CHAT_FB_TOOL_STRICT_FALSE, CHAT_FB_TOOL_STRICT_FALSE_LEN)
    !strict_value
    jmp L_RESP_DOM_CLOSE_BODY

L_RESP_DOM_STRICT_APPEND_TOOL:
    strict_tool_is_true = eq strict_tool_value, 1
    br strict_tool_is_true -> L_RESP_DOM_STRICT_TRUE_TOOL, L_RESP_DOM_STRICT_FALSE_TOOL

L_RESP_DOM_STRICT_TRUE_TOOL:
    !strict_tool_is_true
    call @rpc_builder_append(&buf, &CHAT_FB_TOOL_STRICT_TRUE, CHAT_FB_TOOL_STRICT_TRUE_LEN)
    !strict_tool_value
    jmp L_RESP_DOM_CLOSE_BODY

L_RESP_DOM_STRICT_FALSE_TOOL:
    !strict_tool_is_true
    call @rpc_builder_append(&buf, &CHAT_FB_TOOL_STRICT_FALSE, CHAT_FB_TOOL_STRICT_FALSE_LEN)
    !strict_tool_value
    jmp L_RESP_DOM_CLOSE_BODY

L_RESP_DOM_CLOSE_BODY:
    call @rpc_builder_append(&buf, &RESP_TOOL_CLOSE, RESP_TOOL_CLOSE_LEN)
    name_free = call @sa_json_free(^name_node)
    !name_free
    !full_name
    !full_name_len
    !name_ptr
    !name_len
    !is_first
    !name_status
    !buf
    !tool_node
    !source_node
    !prefix
    !prefix_len
    !first_slot
    return 1

L_RESP_DOM_NAME_BAD:
    !name_is_string
    name_free_bad = call @sa_json_free(^name_node)
    !name_free_bad
    !name_status
    !buf
    !tool_node
    !source_node
    !prefix
    !prefix_len
    !first_slot
    return 0

L_RESP_DOM_NO_NAME:
    !name_ok
    !name_status
    !buf
    !tool_node
    !source_node
    !prefix
    !prefix_len
    !first_slot
    return 0

@ffi_wrapper append_responses_tool_dom(&buf: ptr, tool_node: ptr, &first_slot: ptr) -> u32:
L_ENTRY:
    type_slot = stack_alloc 8
    type_status = call @sa_json_object_get(tool_node, &FB_KEY_TYPE, FB_KEY_TYPE_LEN, &type_slot)
    has_type = eq type_status, 0
    br has_type -> L_RESP_TOOL_TYPE, L_RESP_TOOL_NO_TYPE

L_RESP_TOOL_TYPE:
    !has_type
    type_node = load type_slot+0 as ptr
    type_kind = call @sa_json_kind(type_node)
    type_is_string = eq type_kind, SA_JSON_KIND_STRING
    !type_kind
    br type_is_string -> L_RESP_TOOL_TYPE_COMPARE, L_RESP_TOOL_TYPE_BAD

L_RESP_TOOL_TYPE_COMPARE:
    !type_is_string
    type_ptr = call @sa_json_string_ptr(type_node)
    type_len = call @sa_json_string_len(type_node)
    type_ns_raw = call @sa_bytes_eq(&type_ptr, type_len, &FB_TYPE_NAMESPACE, FB_TYPE_NAMESPACE_LEN)
    type_is_ns = eq type_ns_raw, 1
    !type_ns_raw
    br type_is_ns -> L_RESP_TOOL_NAMESPACE, L_RESP_TOOL_FUNCTION_OR_SKIP

L_RESP_TOOL_NAMESPACE:
    !type_is_ns
    !type_ptr
    !type_len
    type_free_ns = call @sa_json_free(^type_node)
    !type_free_ns
    !type_status
    ns_appended = call @append_responses_namespace_tools_dom(&buf, tool_node, &first_slot)
    !buf
    !tool_node
    !first_slot
    return ns_appended

L_RESP_TOOL_FUNCTION_OR_SKIP:
    !type_is_ns
    type_fn_raw = call @sa_bytes_eq(&type_ptr, type_len, &FB_TYPE_FUNCTION, FB_TYPE_FUNCTION_LEN)
    type_is_fn = eq type_fn_raw, 1
    !type_fn_raw
    br type_is_fn -> L_RESP_TOOL_FUNCTION_TYPE_OK, L_RESP_TOOL_TYPE_SKIP

L_RESP_TOOL_FUNCTION_TYPE_OK:
    !type_is_fn
    !type_ptr
    !type_len
    type_free_fn = call @sa_json_free(^type_node)
    !type_free_fn
    !type_status
    jmp L_RESP_TOOL_APPEND_FUNCTION

L_RESP_TOOL_TYPE_SKIP:
    !type_is_fn
    !type_ptr
    !type_len
    type_free_skip = call @sa_json_free(^type_node)
    !type_free_skip
    !type_status
    !buf
    !tool_node
    !first_slot
    return 0

L_RESP_TOOL_TYPE_BAD:
    !type_is_string
    type_free_bad = call @sa_json_free(^type_node)
    !type_free_bad
    !type_status
    !buf
    !tool_node
    !first_slot
    return 0

L_RESP_TOOL_NO_TYPE:
    !has_type
    !type_status
    jmp L_RESP_TOOL_APPEND_FUNCTION

L_RESP_TOOL_APPEND_FUNCTION:
    fn_slot = stack_alloc 8
    fn_status = call @sa_json_object_get(tool_node, &FB_KEY_FUNCTION, FB_KEY_FUNCTION_LEN, &fn_slot)
    has_fn = eq fn_status, 0
    br has_fn -> L_RESP_HAS_FN, L_RESP_FLAT

L_RESP_HAS_FN:
    !has_fn
    fn_node = load fn_slot+0 as ptr
    appended = call @append_responses_tool_dom_source(&buf, tool_node, fn_node, &EMPTY_TEXT, 0, &first_slot)
    fn_free = call @sa_json_free(^fn_node)
    !fn_free
    !fn_status
    !buf
    !tool_node
    !first_slot
    return appended

L_RESP_FLAT:
    !has_fn
    appended2 = call @append_responses_tool_dom_source(&buf, tool_node, tool_node, &EMPTY_TEXT, 0, &first_slot)
    !fn_status
    !buf
    !tool_node
    !first_slot
    return appended2

@ffi_wrapper append_responses_tool_dom_with_prefix(&buf: ptr, tool_node: ptr, &prefix: ptr, prefix_len: u64, &first_slot: ptr) -> u32:
L_ENTRY:
    fn_slot = stack_alloc 8
    fn_status = call @sa_json_object_get(tool_node, &FB_KEY_FUNCTION, FB_KEY_FUNCTION_LEN, &fn_slot)
    has_fn = eq fn_status, 0
    br has_fn -> L_RESP_PREFIX_HAS_FN, L_RESP_PREFIX_FLAT

L_RESP_PREFIX_HAS_FN:
    !has_fn
    fn_node = load fn_slot+0 as ptr
    appended = call @append_responses_tool_dom_source(&buf, tool_node, fn_node, &prefix, prefix_len, &first_slot)
    fn_free = call @sa_json_free(^fn_node)
    !fn_free
    !fn_status
    !buf
    !tool_node
    !prefix
    !prefix_len
    !first_slot
    return appended

L_RESP_PREFIX_FLAT:
    !has_fn
    appended2 = call @append_responses_tool_dom_source(&buf, tool_node, tool_node, &prefix, prefix_len, &first_slot)
    !fn_status
    !buf
    !tool_node
    !prefix
    !prefix_len
    !first_slot
    return appended2

@ffi_wrapper append_responses_namespace_tools_dom(&buf: ptr, ns_node: ptr, &first_slot: ptr) -> u32:
L_ENTRY:
    ns_name_slot = stack_alloc 8
    ns_name_status = call @sa_json_object_get(ns_node, &FB_KEY_NAME, FB_KEY_NAME_LEN, &ns_name_slot)
    ns_name_ok = eq ns_name_status, 0
    br ns_name_ok -> L_RESP_NS_NAME, L_RESP_NS_NO_NAME

L_RESP_NS_NAME:
    !ns_name_ok
    ns_name_node = load ns_name_slot+0 as ptr
    ns_name_kind = call @sa_json_kind(ns_name_node)
    ns_name_is_string = eq ns_name_kind, SA_JSON_KIND_STRING
    !ns_name_kind
    br ns_name_is_string -> L_RESP_NS_TOOLS, L_RESP_NS_NAME_BAD

L_RESP_NS_TOOLS:
    !ns_name_is_string
    ns_prefix = call @sa_json_string_ptr(ns_name_node)
    ns_prefix_len = call @sa_json_string_len(ns_name_node)
    ns_tools_slot = stack_alloc 8
    ns_tools_status = call @sa_json_object_get(ns_node, &FB_KEY_TOOLS, FB_KEY_TOOLS_LEN, &ns_tools_slot)
    ns_has_tools = eq ns_tools_status, 0
    br ns_has_tools -> L_RESP_NS_LOOP_PREP, L_RESP_NS_NO_TOOLS_FREE

L_RESP_NS_LOOP_PREP:
    !ns_has_tools
    ns_tools_node = load ns_tools_slot+0 as ptr
    ns_count_slot = stack_alloc 8
    ns_count_status = call @sa_json_value_count(ns_tools_node, &ns_count_slot)
    ns_count_ok = eq ns_count_status, 0
    br ns_count_ok -> L_RESP_NS_LOOP_INIT, L_RESP_NS_TOOLS_FREE_EMPTY

L_RESP_NS_LOOP_INIT:
    !ns_count_ok
    ns_count = load ns_count_slot+0 as u64
    ns_index_slot = stack_alloc 8
    ns_item_slot = stack_alloc 8
    store ns_index_slot+0, 0 as u64
    jmp L_RESP_NS_LOOP_COND

L_RESP_NS_LOOP_COND:
    ns_index = load ns_index_slot+0 as u64
    ns_has_next = ult ns_index, ns_count
    br ns_has_next -> L_RESP_NS_LOOP_BODY, L_RESP_NS_LOOP_DONE

L_RESP_NS_LOOP_BODY:
    !ns_has_next
    ns_item_status = call @sa_json_array_get(ns_tools_node, ns_index, &ns_item_slot)
    ns_item_ok = eq ns_item_status, 0
    br ns_item_ok -> L_RESP_NS_ITEM, L_RESP_NS_ITEM_NEXT

L_RESP_NS_ITEM:
    !ns_item_ok
    ns_item_node = load ns_item_slot+0 as ptr
    ns_append = call @append_responses_tool_dom_with_prefix(&buf, ns_item_node, &ns_prefix, ns_prefix_len, &first_slot)
    ns_item_free = call @sa_json_free(^ns_item_node)
    !ns_item_free
    !ns_append
    !ns_item_status
    jmp L_RESP_NS_ITEM_ADVANCE

L_RESP_NS_ITEM_NEXT:
    !ns_item_ok
    !ns_item_status
    jmp L_RESP_NS_ITEM_ADVANCE

L_RESP_NS_ITEM_ADVANCE:
    ns_next_index = add ns_index, 1
    store ns_index_slot+0, ns_next_index as u64
    !ns_next_index
    !ns_index
    jmp L_RESP_NS_LOOP_COND

L_RESP_NS_LOOP_DONE:
    !ns_has_next
    !ns_index
    ns_tools_free = call @sa_json_free(^ns_tools_node)
    !ns_tools_free
    ns_name_free = call @sa_json_free(^ns_name_node)
    !ns_name_free
    !ns_prefix
    !ns_prefix_len
    !ns_count
    !ns_count_status
    !ns_tools_status
    !ns_name_status
    !buf
    !ns_node
    !first_slot
    return 1

L_RESP_NS_TOOLS_FREE_EMPTY:
    !ns_count_ok
    ns_tools_free_empty = call @sa_json_free(^ns_tools_node)
    !ns_tools_free_empty
    ns_name_free_empty = call @sa_json_free(^ns_name_node)
    !ns_name_free_empty
    !ns_prefix
    !ns_prefix_len
    !ns_count_status
    !ns_tools_status
    !ns_name_status
    !buf
    !ns_node
    !first_slot
    return 0

L_RESP_NS_NO_TOOLS_FREE:
    !ns_has_tools
    ns_name_free_no_tools = call @sa_json_free(^ns_name_node)
    !ns_name_free_no_tools
    !ns_prefix
    !ns_prefix_len
    !ns_tools_status
    !ns_name_status
    !buf
    !ns_node
    !first_slot
    return 0

L_RESP_NS_NAME_BAD:
    !ns_name_is_string
    ns_name_free_bad = call @sa_json_free(^ns_name_node)
    !ns_name_free_bad
    !ns_name_status
    !buf
    !ns_node
    !first_slot
    return 0

L_RESP_NS_NO_NAME:
    !ns_name_ok
    !ns_name_status
    !buf
    !ns_node
    !first_slot
    return 0

@ffi_wrapper append_responses_tool_dom_at(&buf: ptr, tools_node: ptr, index: u64, &first_slot: ptr) -> u32:
L_ENTRY:
    item_slot = stack_alloc 8
    item_status = call @sa_json_array_get(tools_node, index, &item_slot)
    item_ok = eq item_status, 0
    br item_ok -> L_RESP_DOM_AT_ITEM, L_RESP_DOM_AT_NONE

L_RESP_DOM_AT_ITEM:
    !item_ok
    item_node = load item_slot+0 as ptr
    item_append_status = call @append_responses_tool_dom(&buf, item_node, &first_slot)
    item_free = call @sa_json_free(^item_node)
    !item_free
    !item_status
    !buf
    !tools_node
    !index
    !first_slot
    return item_append_status

L_RESP_DOM_AT_NONE:
    !item_ok
    !item_status
    !buf
    !tools_node
    !index
    !first_slot
    return 0

@ffi_wrapper append_chat_proxy_field_prefix(&buf: ptr, &key: ptr, key_len: u64, &first_slot: ptr) -> u32:
L_ENTRY:
    is_first = load first_slot+0 as u8
    first_ok = eq is_first, 1
    br first_ok -> L_FIELD_FIRST, L_FIELD_COMMA

L_FIELD_COMMA:
    !first_ok
    comma_status = call @rpc_builder_append(&buf, &CHAT_FB_COMMA, CHAT_FB_COMMA_LEN)
    !comma_status
    jmp L_FIELD_APPEND

L_FIELD_FIRST:
    !first_ok
    store first_slot+0, 0 as u8
    jmp L_FIELD_APPEND

L_FIELD_APPEND:
    key_status = call @rpc_builder_append_json_string(&buf, &key, key_len)
    colon_status = call @rpc_builder_append(&buf, &CHAT_PROXY_COLON, CHAT_PROXY_COLON_LEN)
    !key_status
    !colon_status
    !is_first
    !buf
    !key
    !key_len
    !first_slot
    return 0

@ffi_wrapper chat_proxy_is_tools_key(&key: ptr, key_len: u64) -> u32:
L_ENTRY:
    tools_raw = call @sa_bytes_eq(&key, key_len, &FB_KEY_TOOLS, FB_KEY_TOOLS_LEN)
    tools_ok = eq tools_raw, 1
    br tools_ok -> L_TOOLS_YES, L_TOOLS_NO

L_TOOLS_YES:
    !tools_ok
    !tools_raw
    !key
    !key_len
    return 1

L_TOOLS_NO:
    !tools_ok
    !tools_raw
    !key
    !key_len
    return 0

@ffi_wrapper chat_proxy_is_drop_key(&key: ptr, key_len: u64) -> u32:
L_ENTRY:
    store_raw = call @sa_bytes_eq(&key, key_len, &CHAT_DROP_STORE, CHAT_DROP_STORE_LEN)
    store_ok = eq store_raw, 1
    br store_ok -> L_DROP_STORE, L_DROP_PROMPT

L_DROP_STORE:
    !store_ok
    !store_raw
    !key
    !key_len
    return 1

L_DROP_PROMPT:
    !store_ok
    !store_raw
    prompt_raw = call @sa_bytes_eq(&key, key_len, &CHAT_DROP_PROMPT_CACHE_KEY, CHAT_DROP_PROMPT_CACHE_KEY_LEN)
    prompt_ok = eq prompt_raw, 1
    br prompt_ok -> L_DROP_PROMPT_YES, L_DROP_INCLUDE

L_DROP_PROMPT_YES:
    !prompt_ok
    !prompt_raw
    !key
    !key_len
    return 1

L_DROP_INCLUDE:
    !prompt_ok
    !prompt_raw
    include_raw = call @sa_bytes_eq(&key, key_len, &CHAT_DROP_INCLUDE, CHAT_DROP_INCLUDE_LEN)
    include_ok = eq include_raw, 1
    br include_ok -> L_DROP_INCLUDE_YES, L_DROP_REASONING

L_DROP_INCLUDE_YES:
    !include_ok
    !include_raw
    !key
    !key_len
    return 1

L_DROP_REASONING:
    !include_ok
    !include_raw
    reasoning_raw = call @sa_bytes_eq(&key, key_len, &CHAT_DROP_REASONING, CHAT_DROP_REASONING_LEN)
    reasoning_ok = eq reasoning_raw, 1
    br reasoning_ok -> L_DROP_REASONING_YES, L_DROP_NO

L_DROP_REASONING_YES:
    !reasoning_ok
    !reasoning_raw
    !key
    !key_len
    return 1

L_DROP_NO:
    !reasoning_ok
    !reasoning_raw
    !key
    !key_len
    return 0

@ffi_wrapper responses_gemini_is_drop_key(&key: ptr, key_len: u64) -> u32:
L_ENTRY:
    store_raw = call @sa_bytes_eq(&key, key_len, &CHAT_DROP_STORE, CHAT_DROP_STORE_LEN)
    store_ok = eq store_raw, 1
    br store_ok -> L_RESP_DROP_STORE, L_RESP_DROP_PROMPT

L_RESP_DROP_STORE:
    !store_ok
    !store_raw
    !key
    !key_len
    return 1

L_RESP_DROP_PROMPT:
    !store_ok
    !store_raw
    prompt_raw = call @sa_bytes_eq(&key, key_len, &CHAT_DROP_PROMPT_CACHE_KEY, CHAT_DROP_PROMPT_CACHE_KEY_LEN)
    prompt_ok = eq prompt_raw, 1
    br prompt_ok -> L_RESP_DROP_PROMPT_YES, L_RESP_DROP_NO

L_RESP_DROP_PROMPT_YES:
    !prompt_ok
    !prompt_raw
    !key
    !key_len
    return 1

L_RESP_DROP_NO:
    !prompt_ok
    !prompt_raw
    !key
    !key_len
    return 0

@ffi_wrapper json_string_is_gemini_model(&model_ptr: ptr, model_len: u64) -> u32:
L_ENTRY:
    exact_raw = call @sa_bytes_eq(&model_ptr, model_len, &GEMINI_MODEL, GEMINI_MODEL_LEN)
    exact_ok = eq exact_raw, 1
    br exact_ok -> L_GEMINI_YES_EXACT, L_GEMINI_CHECK_PREFIX

L_GEMINI_YES_EXACT:
    !exact_ok
    !exact_raw
    !model_ptr
    !model_len
    return 1

L_GEMINI_CHECK_PREFIX:
    !exact_ok
    !exact_raw
    can_short = uge model_len, GEMINI_PREFIX_LEN
    br can_short -> L_GEMINI_SHORT_PREFIX, L_GEMINI_CHECK_MODELS

L_GEMINI_SHORT_PREFIX:
    !can_short
    short_raw = call @sa_bytes_eq(&model_ptr, GEMINI_PREFIX_LEN, &GEMINI_PREFIX, GEMINI_PREFIX_LEN)
    short_ok = eq short_raw, 1
    br short_ok -> L_GEMINI_YES_SHORT, L_GEMINI_SHORT_NO

L_GEMINI_YES_SHORT:
    !short_ok
    !short_raw
    !model_ptr
    !model_len
    return 1

L_GEMINI_SHORT_NO:
    !short_ok
    !short_raw
    jmp L_GEMINI_CHECK_MODELS_AFTER_SHORT

L_GEMINI_CHECK_MODELS:
    !can_short
    jmp L_GEMINI_CHECK_MODELS_AFTER_SHORT

L_GEMINI_CHECK_MODELS_AFTER_SHORT:
    can_models = uge model_len, MODELS_GEMINI_PREFIX_LEN
    br can_models -> L_GEMINI_MODELS_PREFIX, L_GEMINI_NO

L_GEMINI_MODELS_PREFIX:
    !can_models
    models_raw = call @sa_bytes_eq(&model_ptr, MODELS_GEMINI_PREFIX_LEN, &MODELS_GEMINI_PREFIX, MODELS_GEMINI_PREFIX_LEN)
    models_ok = eq models_raw, 1
    br models_ok -> L_GEMINI_YES_MODELS, L_GEMINI_MODELS_NO

L_GEMINI_YES_MODELS:
    !models_ok
    !models_raw
    !model_ptr
    !model_len
    return 1

L_GEMINI_MODELS_NO:
    !models_ok
    !models_raw
    jmp L_GEMINI_NO_AFTER_MODELS

L_GEMINI_NO:
    !can_models
    jmp L_GEMINI_NO_AFTER_MODELS

L_GEMINI_NO_AFTER_MODELS:
    !model_ptr
    !model_len
    return 0

@ffi_wrapper body_is_gemini_responses_request(&body: ptr, body_len: u64) -> u32:
L_ENTRY:
    root = call @sa_json_parse(&body, body_len)
    has_root = ne root, 0
    br has_root -> L_BODY_GEMINI_ROOT, L_BODY_GEMINI_NO_ROOT

L_BODY_GEMINI_ROOT:
    !has_root
    model_slot = stack_alloc 8
    model_status = call @sa_json_object_get(root, &FB_KEY_MODEL, FB_KEY_MODEL_LEN, &model_slot)
    model_ok = eq model_status, 0
    br model_ok -> L_BODY_GEMINI_MODEL, L_BODY_GEMINI_NO_MODEL

L_BODY_GEMINI_MODEL:
    !model_ok
    model_node = load model_slot+0 as ptr
    model_kind = call @sa_json_kind(model_node)
    model_is_string = eq model_kind, SA_JSON_KIND_STRING
    !model_kind
    br model_is_string -> L_BODY_GEMINI_STRING, L_BODY_GEMINI_MODEL_BAD

L_BODY_GEMINI_STRING:
    !model_is_string
    model_ptr = call @sa_json_string_ptr(model_node)
    model_len = call @sa_json_string_len(model_node)
    is_gemini = call @json_string_is_gemini_model(&model_ptr, model_len)
    model_free = call @sa_json_free(^model_node)
    !model_free
    root_free = call @sa_json_free(^root)
    !root_free
    !model_status
    !body
    !body_len
    return is_gemini

L_BODY_GEMINI_MODEL_BAD:
    !model_is_string
    model_free_bad = call @sa_json_free(^model_node)
    !model_free_bad
    jmp L_BODY_GEMINI_NO_MODEL_AFTER

L_BODY_GEMINI_NO_MODEL:
    !model_ok
    jmp L_BODY_GEMINI_NO_MODEL_AFTER

L_BODY_GEMINI_NO_MODEL_AFTER:
    root_free_no_model = call @sa_json_free(^root)
    !root_free_no_model
    !model_status
    !body
    !body_len
    return 0

L_BODY_GEMINI_NO_ROOT:
    !has_root
    !body
    !body_len
    return 0

@ffi_wrapper build_responses_proxy_body(&body: ptr, body_len: u64, is_gemini: u32, &out_len: ptr) -> ^ptr:
L_ENTRY:
    root = call @sa_json_parse(&body, body_len)
    has_root = ne root, 0
    br has_root -> L_RESP_PROXY_ROOT, L_RESP_PROXY_COPY_ORIGINAL

L_RESP_PROXY_ROOT:
    !has_root
    count_slot = stack_alloc 8
    count_status = call @sa_json_value_count(root, &count_slot)
    count_ok = eq count_status, 0
    br count_ok -> L_RESP_PROXY_LOOP_INIT, L_RESP_PROXY_ROOT_BAD

L_RESP_PROXY_LOOP_INIT:
    !count_ok
    count = load count_slot+0 as u64
    result = call @rpc_builder_new()
    first_slot = stack_alloc 1
    index_slot = stack_alloc 8
    key_ptr_slot = stack_alloc 8
    key_len_slot = stack_alloc 8
    tools_slot = stack_alloc 8
    value_slot = stack_alloc 8
    store first_slot+0, 1 as u8
    store index_slot+0, 0 as u64
    obj_open_status = call @rpc_builder_append(&result, &CHAT_PROXY_OBJECT_OPEN, CHAT_PROXY_OBJECT_OPEN_LEN)
    !obj_open_status
    jmp L_RESP_PROXY_LOOP_COND

L_RESP_PROXY_LOOP_COND:
    index = load index_slot+0 as u64
    has_next = ult index, count
    br has_next -> L_RESP_PROXY_LOOP_BODY, L_RESP_PROXY_DONE

L_RESP_PROXY_LOOP_BODY:
    !has_next
    key_status = call @sa_json_object_key_at(root, index, &key_ptr_slot, &key_len_slot)
    key_ok = eq key_status, 0
    br key_ok -> L_RESP_PROXY_KEY, L_RESP_PROXY_NEXT_BAD_KEY

L_RESP_PROXY_KEY:
    !key_ok
    key_ptr = load key_ptr_slot+0 as ptr
    key_len = load key_len_slot+0 as u64
    gemini_drop_enabled = eq is_gemini, 1
    br gemini_drop_enabled -> L_RESP_PROXY_CHECK_DROP_KEY, L_RESP_PROXY_KEEP_FIELD_NO_DROP

L_RESP_PROXY_CHECK_DROP_KEY:
    !gemini_drop_enabled
    is_drop = call @responses_gemini_is_drop_key(&key_ptr, key_len)
    drop_ok = eq is_drop, 1
    br drop_ok -> L_RESP_PROXY_SKIP_KEY, L_RESP_PROXY_COPY_FIELD

L_RESP_PROXY_KEEP_FIELD_NO_DROP:
    !gemini_drop_enabled
    jmp L_RESP_PROXY_CHECK_TOOLS_FIELD

L_RESP_PROXY_COPY_FIELD:
    !drop_ok
    !is_drop
    jmp L_RESP_PROXY_CHECK_TOOLS_FIELD

L_RESP_PROXY_CHECK_TOOLS_FIELD:
    is_tools = call @chat_proxy_is_tools_key(&key_ptr, key_len)
    tools_ok = eq is_tools, 1
    br tools_ok -> L_RESP_PROXY_TOOLS_FIELD, L_RESP_PROXY_COPY_NORMAL_FIELD

L_RESP_PROXY_TOOLS_FIELD:
    !tools_ok
    !is_tools
    tools_status = call @sa_json_object_get(root, &FB_KEY_TOOLS, FB_KEY_TOOLS_LEN, &tools_slot)
    tools_found = eq tools_status, 0
    br tools_found -> L_RESP_PROXY_TOOLS_NODE, L_RESP_PROXY_TOOLS_MISSING

L_RESP_PROXY_TOOLS_NODE:
    !tools_found
    tools_node = load tools_slot+0 as ptr
    tools_append = call @append_responses_tools_node(&result, tools_node, &first_slot)
    tools_free = call @sa_json_free(^tools_node)
    !tools_free
    !tools_append
    !tools_status
    jmp L_RESP_PROXY_NEXT_KEY

L_RESP_PROXY_TOOLS_MISSING:
    !tools_found
    !tools_status
    jmp L_RESP_PROXY_NEXT_KEY

L_RESP_PROXY_COPY_NORMAL_FIELD:
    !tools_ok
    !is_tools
    value_status = call @sa_json_object_get(root, &key_ptr, key_len, &value_slot)
    value_ok = eq value_status, 0
    br value_ok -> L_RESP_PROXY_VALUE, L_RESP_PROXY_VALUE_MISSING

L_RESP_PROXY_VALUE:
    !value_ok
    value_node = load value_slot+0 as ptr
    field_status = call @append_chat_proxy_field_prefix(&result, &key_ptr, key_len, &first_slot)
    raw_status = call @append_json_node_raw(&result, value_node)
    value_free = call @sa_json_free(^value_node)
    !value_free
    !raw_status
    !field_status
    !value_status
    jmp L_RESP_PROXY_NEXT_KEY

L_RESP_PROXY_VALUE_MISSING:
    !value_ok
    !value_status
    jmp L_RESP_PROXY_NEXT_KEY

L_RESP_PROXY_SKIP_KEY:
    !drop_ok
    !is_drop
    jmp L_RESP_PROXY_NEXT_KEY

L_RESP_PROXY_NEXT_BAD_KEY:
    !key_ok
    !key_status
    jmp L_RESP_PROXY_ADVANCE

L_RESP_PROXY_NEXT_KEY:
    !key_ptr
    !key_len
    !key_status
    jmp L_RESP_PROXY_ADVANCE

L_RESP_PROXY_ADVANCE:
    next_index = add index, 1
    store index_slot+0, next_index as u64
    !next_index
    !index
    jmp L_RESP_PROXY_LOOP_COND

L_RESP_PROXY_DONE:
    !has_next
    !index
    obj_close_status = call @rpc_builder_append(&result, &CHAT_PROXY_OBJECT_CLOSE, CHAT_PROXY_OBJECT_CLOSE_LEN)
    !obj_close_status
    result_ptr = call @rpc_builder_data(&result)
    result_len = call @rpc_builder_len(&result)
    out = alloc RPC_JSON_BUF_SIZE
    copy_status = call @sa_bytes_copy(&out, &result_ptr, result_len)
    !copy_status
    store out_len+0, result_len as u64
    root_free = call @sa_json_free(^root)
    !root_free
    !result_ptr
    !result_len
    !result
    !count
    !count_status
    !is_gemini
    !body
    !body_len
    !out_len
    return out

L_RESP_PROXY_ROOT_BAD:
    !count_ok
    root_free_bad = call @sa_json_free(^root)
    !root_free_bad
    !count_status
    !is_gemini
    out_bad = alloc body_len
    bad_copy_status = call @sa_bytes_copy(&out_bad, &body, body_len)
    !bad_copy_status
    store out_len+0, body_len as u64
    !body
    !body_len
    !out_len
    return out_bad

L_RESP_PROXY_COPY_ORIGINAL:
    !has_root
    out_orig = alloc body_len
    orig_copy_status = call @sa_bytes_copy(&out_orig, &body, body_len)
    !orig_copy_status
    store out_len+0, body_len as u64
    !is_gemini
    !body
    !body_len
    !out_len
    return out_orig

@ffi_wrapper append_chat_proxy_tools_node(&buf: ptr, tools_node: ptr, &first_slot: ptr) -> u32:
L_ENTRY:
    count_slot = stack_alloc 8
    count_status = call @sa_json_value_count(tools_node, &count_slot)
    count_ok = eq count_status, 0
    br count_ok -> L_PROXY_TOOLS_INIT, L_PROXY_TOOLS_EMPTY

L_PROXY_TOOLS_INIT:
    !count_ok
    count = load count_slot+0 as u64
    tmp = call @rpc_builder_new()
    tmp_first_slot = stack_alloc 1
    index_slot = stack_alloc 8
    store tmp_first_slot+0, 1 as u8
    store index_slot+0, 0 as u64
    open_status = call @rpc_builder_append(&tmp, &CHAT_PROXY_ARRAY_OPEN, CHAT_PROXY_ARRAY_OPEN_LEN)
    !open_status
    jmp L_PROXY_TOOLS_COND

L_PROXY_TOOLS_COND:
    index = load index_slot+0 as u64
    has_next = ult index, count
    br has_next -> L_PROXY_TOOLS_BODY, L_PROXY_TOOLS_DONE

L_PROXY_TOOLS_BODY:
    !has_next
    item_status = call @append_chat_fallback_tool_dom_at(&tmp, tools_node, index, &tmp_first_slot)
    next_index = add index, 1
    store index_slot+0, next_index as u64
    !next_index
    !item_status
    !index
    jmp L_PROXY_TOOLS_COND

L_PROXY_TOOLS_DONE:
    !has_next
    !index
    close_status = call @rpc_builder_append(&tmp, &CHAT_FB_ARRAY_CLOSE, CHAT_FB_ARRAY_CLOSE_LEN)
    !close_status
    has_written_flag = load tmp_first_slot+0 as u8
    none_written = eq has_written_flag, 1
    br none_written -> L_PROXY_TOOLS_NO_VALID, L_PROXY_TOOLS_APPEND

L_PROXY_TOOLS_APPEND:
    !none_written
    field_status = call @append_chat_proxy_field_prefix(&buf, &FB_KEY_TOOLS, FB_KEY_TOOLS_LEN, &first_slot)
    !field_status
    tmp_ptr = call @rpc_builder_data(&tmp)
    tmp_len = call @rpc_builder_len(&tmp)
    append_status = call @rpc_builder_append(&buf, &tmp_ptr, tmp_len)
    !append_status
    !tmp_ptr
    !tmp_len
    !tmp
    !has_written_flag
    !count
    !count_status
    !buf
    !tools_node
    !first_slot
    return 1

L_PROXY_TOOLS_NO_VALID:
    !none_written
    !tmp
    !has_written_flag
    !count
    !count_status
    !buf
    !tools_node
    !first_slot
    return 0

L_PROXY_TOOLS_EMPTY:
    !count_ok
    !count_status
    !buf
    !tools_node
    !first_slot
    return 0

@ffi_wrapper append_responses_tools_node(&buf: ptr, tools_node: ptr, &first_slot: ptr) -> u32:
L_ENTRY:
    count_slot = stack_alloc 8
    count_status = call @sa_json_value_count(tools_node, &count_slot)
    count_ok = eq count_status, 0
    br count_ok -> L_RESP_PROXY_TOOLS_INIT, L_RESP_PROXY_TOOLS_EMPTY

L_RESP_PROXY_TOOLS_INIT:
    !count_ok
    count = load count_slot+0 as u64
    tmp = call @rpc_builder_new()
    tmp_first_slot = stack_alloc 1
    index_slot = stack_alloc 8
    store tmp_first_slot+0, 1 as u8
    store index_slot+0, 0 as u64
    open_status = call @rpc_builder_append(&tmp, &CHAT_PROXY_ARRAY_OPEN, CHAT_PROXY_ARRAY_OPEN_LEN)
    !open_status
    jmp L_RESP_PROXY_TOOLS_COND

L_RESP_PROXY_TOOLS_COND:
    index = load index_slot+0 as u64
    has_next = ult index, count
    br has_next -> L_RESP_PROXY_TOOLS_BODY, L_RESP_PROXY_TOOLS_DONE

L_RESP_PROXY_TOOLS_BODY:
    !has_next
    item_status = call @append_responses_tool_dom_at(&tmp, tools_node, index, &tmp_first_slot)
    next_index = add index, 1
    store index_slot+0, next_index as u64
    !next_index
    !item_status
    !index
    jmp L_RESP_PROXY_TOOLS_COND

L_RESP_PROXY_TOOLS_DONE:
    !has_next
    !index
    close_status = call @rpc_builder_append(&tmp, &CHAT_FB_ARRAY_CLOSE, CHAT_FB_ARRAY_CLOSE_LEN)
    !close_status
    has_written_flag = load tmp_first_slot+0 as u8
    none_written = eq has_written_flag, 1
    br none_written -> L_RESP_PROXY_TOOLS_NO_VALID, L_RESP_PROXY_TOOLS_APPEND

L_RESP_PROXY_TOOLS_APPEND:
    !none_written
    field_status = call @append_chat_proxy_field_prefix(&buf, &FB_KEY_TOOLS, FB_KEY_TOOLS_LEN, &first_slot)
    !field_status
    tmp_ptr = call @rpc_builder_data(&tmp)
    tmp_len = call @rpc_builder_len(&tmp)
    append_status = call @rpc_builder_append(&buf, &tmp_ptr, tmp_len)
    !append_status
    !tmp_ptr
    !tmp_len
    !tmp
    !has_written_flag
    !count
    !count_status
    !buf
    !tools_node
    !first_slot
    return 1

L_RESP_PROXY_TOOLS_NO_VALID:
    !none_written
    !tmp
    !has_written_flag
    !count
    !count_status
    !buf
    !tools_node
    !first_slot
    return 0

L_RESP_PROXY_TOOLS_EMPTY:
    !count_ok
    !count_status
    !buf
    !tools_node
    !first_slot
    return 0

@ffi_wrapper build_chat_proxy_body(&body: ptr, body_len: u64, &out_len: ptr) -> ^ptr:
L_ENTRY:
    root = call @sa_json_parse(&body, body_len)
    has_root = ne root, 0
    br has_root -> L_CHAT_PROXY_ROOT, L_CHAT_PROXY_COPY_ORIGINAL

L_CHAT_PROXY_ROOT:
    !has_root
    count_slot = stack_alloc 8
    count_status = call @sa_json_value_count(root, &count_slot)
    count_ok = eq count_status, 0
    br count_ok -> L_CHAT_PROXY_LOOP_INIT, L_CHAT_PROXY_ROOT_BAD

L_CHAT_PROXY_LOOP_INIT:
    !count_ok
    count = load count_slot+0 as u64
    result = call @rpc_builder_new()
    first_slot = stack_alloc 1
    index_slot = stack_alloc 8
    key_ptr_slot = stack_alloc 8
    key_len_slot = stack_alloc 8
    tools_slot = stack_alloc 8
    value_slot = stack_alloc 8
    store first_slot+0, 1 as u8
    store index_slot+0, 0 as u64
    obj_open_status = call @rpc_builder_append(&result, &CHAT_PROXY_OBJECT_OPEN, CHAT_PROXY_OBJECT_OPEN_LEN)
    !obj_open_status
    jmp L_CHAT_PROXY_LOOP_COND

L_CHAT_PROXY_LOOP_COND:
    index = load index_slot+0 as u64
    has_next = ult index, count
    br has_next -> L_CHAT_PROXY_LOOP_BODY, L_CHAT_PROXY_DONE

L_CHAT_PROXY_LOOP_BODY:
    !has_next
    key_status = call @sa_json_object_key_at(root, index, &key_ptr_slot, &key_len_slot)
    key_ok = eq key_status, 0
    br key_ok -> L_CHAT_PROXY_KEY, L_CHAT_PROXY_NEXT_BAD_KEY

L_CHAT_PROXY_KEY:
    !key_ok
    key_ptr = load key_ptr_slot+0 as ptr
    key_len = load key_len_slot+0 as u64
    is_drop = call @chat_proxy_is_drop_key(&key_ptr, key_len)
    drop_ok = eq is_drop, 1
    br drop_ok -> L_CHAT_PROXY_SKIP_KEY, L_CHAT_PROXY_CHECK_TOOLS

L_CHAT_PROXY_CHECK_TOOLS:
    !drop_ok
    !is_drop
    is_tools = call @chat_proxy_is_tools_key(&key_ptr, key_len)
    tools_ok = eq is_tools, 1
    br tools_ok -> L_CHAT_PROXY_TOOLS_FIELD, L_CHAT_PROXY_COPY_FIELD

L_CHAT_PROXY_TOOLS_FIELD:
    !tools_ok
    !is_tools
    tools_status = call @sa_json_object_get(root, &FB_KEY_TOOLS, FB_KEY_TOOLS_LEN, &tools_slot)
    tools_found = eq tools_status, 0
    br tools_found -> L_CHAT_PROXY_TOOLS_NODE, L_CHAT_PROXY_TOOLS_MISSING

L_CHAT_PROXY_TOOLS_NODE:
    !tools_found
    tools_node = load tools_slot+0 as ptr
    tools_append = call @append_chat_proxy_tools_node(&result, tools_node, &first_slot)
    tools_free = call @sa_json_free(^tools_node)
    !tools_free
    !tools_append
    !tools_status
    jmp L_CHAT_PROXY_NEXT_KEY

L_CHAT_PROXY_TOOLS_MISSING:
    !tools_found
    !tools_status
    jmp L_CHAT_PROXY_NEXT_KEY

L_CHAT_PROXY_COPY_FIELD:
    !tools_ok
    !is_tools
    value_status = call @sa_json_object_get(root, &key_ptr, key_len, &value_slot)
    value_ok = eq value_status, 0
    br value_ok -> L_CHAT_PROXY_VALUE, L_CHAT_PROXY_VALUE_MISSING

L_CHAT_PROXY_VALUE:
    !value_ok
    value_node = load value_slot+0 as ptr
    field_status = call @append_chat_proxy_field_prefix(&result, &key_ptr, key_len, &first_slot)
    raw_status = call @append_json_node_raw(&result, value_node)
    value_free = call @sa_json_free(^value_node)
    !value_free
    !raw_status
    !field_status
    !value_status
    jmp L_CHAT_PROXY_NEXT_KEY

L_CHAT_PROXY_VALUE_MISSING:
    !value_ok
    !value_status
    jmp L_CHAT_PROXY_NEXT_KEY

L_CHAT_PROXY_SKIP_KEY:
    !drop_ok
    !is_drop
    jmp L_CHAT_PROXY_NEXT_KEY

L_CHAT_PROXY_NEXT_BAD_KEY:
    !key_ok
    !key_status
    jmp L_CHAT_PROXY_ADVANCE

L_CHAT_PROXY_NEXT_KEY:
    !key_ptr
    !key_len
    !key_status
    jmp L_CHAT_PROXY_ADVANCE

L_CHAT_PROXY_ADVANCE:
    next_index = add index, 1
    store index_slot+0, next_index as u64
    !next_index
    !index
    jmp L_CHAT_PROXY_LOOP_COND

L_CHAT_PROXY_DONE:
    !has_next
    !index
    obj_close_status = call @rpc_builder_append(&result, &CHAT_PROXY_OBJECT_CLOSE, CHAT_PROXY_OBJECT_CLOSE_LEN)
    !obj_close_status
    result_ptr = call @rpc_builder_data(&result)
    result_len = call @rpc_builder_len(&result)
    out = alloc RPC_JSON_BUF_SIZE
    copy_status = call @sa_bytes_copy(&out, &result_ptr, result_len)
    !copy_status
    store out_len+0, result_len as u64
    root_free = call @sa_json_free(^root)
    !root_free
    !result_ptr
    !result_len
    !result
    !count
    !count_status
    !body
    !body_len
    !out_len
    return out

L_CHAT_PROXY_ROOT_BAD:
    !count_ok
    root_free_bad = call @sa_json_free(^root)
    !root_free_bad
    !count_status
    out_bad = alloc body_len
    bad_copy_status = call @sa_bytes_copy(&out_bad, &body, body_len)
    !bad_copy_status
    store out_len+0, body_len as u64
    !body
    !body_len
    !out_len
    return out_bad

L_CHAT_PROXY_COPY_ORIGINAL:
    !has_root
    out_orig = alloc body_len
    orig_copy_status = call @sa_bytes_copy(&out_orig, &body, body_len)
    !orig_copy_status
    store out_len+0, body_len as u64
    !body
    !body_len
    !out_len
    return out_orig

@ffi_wrapper rpc_builder_append_param_raw_or_default(&buf: ptr, &body: ptr, body_len: u64, &key: ptr, key_len: u64, &fallback: ptr, fallback_len: u64) -> u32:
L_ENTRY:
    value_ptr_slot = stack_alloc 8
    value_len_slot = stack_alloc 8
    status = call @rpc_extract_string_after(&body, body_len, &key, key_len, &value_ptr_slot, &value_len_slot)
    found = eq status, 1
    br found -> L_PARAM_RAW_FOUND, L_PARAM_RAW_DEFAULT

L_PARAM_RAW_FOUND:
    !found
    value_ptr = load value_ptr_slot+0 as ptr
    value_len = load value_len_slot+0 as u64
    append_status = call @rpc_builder_append(&buf, &value_ptr, value_len)
    !append_status
    !value_ptr
    !value_len
    !status
    !buf
    !body
    !body_len
    !key
    !key_len
    !fallback
    !fallback_len
    return 0

L_PARAM_RAW_DEFAULT:
    !found
    append_status2 = call @rpc_builder_append(&buf, &fallback, fallback_len)
    !append_status2
    !status
    !buf
    !body
    !body_len
    !key
    !key_len
    !fallback
    !fallback_len
    return 0

@ffi_wrapper rpc_builder_append_param_string_or_null(&buf: ptr, &body: ptr, body_len: u64, &key: ptr, key_len: u64) -> u32:
L_ENTRY:
    value_ptr_slot = stack_alloc 8
    value_len_slot = stack_alloc 8
    status = call @rpc_extract_string_after(&body, body_len, &key, key_len, &value_ptr_slot, &value_len_slot)
    found = eq status, 1
    br found -> L_PARAM_STRING_FOUND, L_PARAM_STRING_NULL

L_PARAM_STRING_FOUND:
    !found
    value_ptr = load value_ptr_slot+0 as ptr
    value_len = load value_len_slot+0 as u64
    append_status = call @rpc_builder_append_json_string(&buf, &value_ptr, value_len)
    !append_status
    !value_ptr
    !value_len
    !status
    !buf
    !body
    !body_len
    !key
    !key_len
    return 0

L_PARAM_STRING_NULL:
    !found
    append_status2 = call @rpc_builder_append(&buf, &J_NULL, J_NULL_LEN)
    !append_status2
    !status
    !buf
    !body
    !body_len
    !key
    !key_len
    return 0

@ffi_wrapper rpc_builder_append_params_string_or_default(&buf: ptr, &body: ptr, body_len: u64, &key: ptr, key_len: u64, &fallback: ptr, fallback_len: u64) -> u32:
L_ENTRY:
    literal_handle = call @sa_deno_jsonrpc_params_string_literal(&body, body_len, &key, key_len, &fallback, fallback_len, 0)
    literal_ok = ne literal_handle, 0
    br literal_ok -> L_PARAMS_STR_LITERAL, L_PARAMS_STR_DEFAULT

L_PARAMS_STR_LITERAL:
    !literal_ok
    literal_ptr = call @sa_fs_read_buffer_data(literal_handle)
    literal_len = call @sa_fs_read_buffer_len(literal_handle)
    append_status = call @rpc_builder_append(&buf, &literal_ptr, literal_len)
    !append_status
    literal_free = call @sa_fs_read_buffer_free(^literal_handle)
    !literal_free
    !literal_ptr
    !literal_len
    !buf
    !body
    !body_len
    !key
    !key_len
    !fallback
    !fallback_len
    return 1

L_PARAMS_STR_DEFAULT:
    !literal_ok
    append_default = call @rpc_builder_append_json_string(&buf, &fallback, fallback_len)
    !append_default
    !literal_handle
    !buf
    !body
    !body_len
    !key
    !key_len
    !fallback
    !fallback_len
    return 0

@ffi_wrapper rpc_builder_append_params_string_or_null(&buf: ptr, &body: ptr, body_len: u64, &key: ptr, key_len: u64) -> u32:
L_ENTRY:
    literal_handle = call @sa_deno_jsonrpc_params_string_literal(&body, body_len, &key, key_len, &EMPTY_TEXT, EMPTY_TEXT_LEN, 1)
    literal_ok = ne literal_handle, 0
    br literal_ok -> L_PARAMS_NULL_LITERAL, L_PARAMS_NULL_DEFAULT

L_PARAMS_NULL_LITERAL:
    !literal_ok
    literal_ptr = call @sa_fs_read_buffer_data(literal_handle)
    literal_len = call @sa_fs_read_buffer_len(literal_handle)
    append_status = call @rpc_builder_append(&buf, &literal_ptr, literal_len)
    !append_status
    literal_free = call @sa_fs_read_buffer_free(^literal_handle)
    !literal_free
    !literal_ptr
    !literal_len
    !buf
    !body
    !body_len
    !key
    !key_len
    return 1

L_PARAMS_NULL_DEFAULT:
    !literal_ok
    append_null = call @rpc_builder_append(&buf, &J_NULL, J_NULL_LEN)
    !append_null
    !literal_handle
    !buf
    !body
    !body_len
    !key
    !key_len
    return 0

@ffi_wrapper build_chat_fallback_body(&body: ptr, body_len: u64, &model_ptr: ptr, model_len: u64, &out_len: ptr) -> ^ptr:
L_ENTRY:
    std_fb_handle = call @sa_deno_responses_chat_fallback_request(&body, body_len, &model_ptr, model_len, 0)
    std_fb_ok = ne std_fb_handle, 0
    br std_fb_ok -> L_CHAT_FB_STD_COPY, L_CHAT_FB_STD_FAIL

L_CHAT_FB_STD_COPY:
    !std_fb_ok
    std_fb_ptr = call @sa_fs_read_buffer_data(std_fb_handle)
    std_fb_len = call @sa_fs_read_buffer_len(std_fb_handle)
    out_std_fb = alloc RPC_JSON_BUF_SIZE
    std_fb_copy_status = call @sa_bytes_copy(&out_std_fb, &std_fb_ptr, std_fb_len)
    !std_fb_copy_status
    std_fb_free_status = call @sa_fs_read_buffer_free(^std_fb_handle)
    !std_fb_free_status
    store out_len+0, std_fb_len as u64
    !std_fb_ptr
    !std_fb_len
    !body
    !body_len
    !model_ptr
    !model_len
    !out_len
    return out_std_fb

L_CHAT_FB_STD_FAIL:
    !std_fb_ok
    !std_fb_handle
    store out_len+0, 0 as u64
    out_empty = alloc 1
    !body
    !body_len
    !model_ptr
    !model_len
    !out_len
    return out_empty

@ffi_wrapper b64_emit_char(&out: ptr, &out_i_slot: ptr, idx: u64) -> u32:
L_ENTRY:
    alphabet = &B64_ALPHABET
    char_ptr = ptr_add alphabet, idx
    ch = load char_ptr+0 as u8
    out_i = load out_i_slot+0 as u64
    dst = ptr_add out, out_i
    store dst+0, ch as u8
    next = add out_i, 1
    store out_i_slot+0, next as u64
    !next
    !dst
    !out_i
    !ch
    !char_ptr
    !alphabet
    !idx
    !out_i_slot
    !out
    return 0

@ffi_wrapper base64_encode_into(&src: ptr, src_len: u64, &out: ptr, &out_len_slot: ptr) -> u32:
L_ENTRY:
    i_slot = stack_alloc 8
    out_i_slot = stack_alloc 8
    has_b1_slot = stack_alloc 1
    has_b2_slot = stack_alloc 1
    store i_slot+0, 0 as u64
    store out_i_slot+0, 0 as u64
    jmp L_B64_COND

L_B64_COND:
    i = load i_slot+0 as u64
    done = uge i, src_len
    br done -> L_B64_DONE, L_B64_BODY

L_B64_BODY:
    !done
    p0 = ptr_add src, i
    b0u8 = load p0+0 as u8
    b0 = bitcast b0u8 as u64
    i1 = add i, 1
    has_b1 = ult i1, src_len
    store has_b1_slot+0, has_b1 as u8
    br has_b1 -> L_B64_LOAD_B1, L_B64_NO_B1

L_B64_LOAD_B1:
    !has_b1
    p1 = ptr_add src, i1
    b1u8 = load p1+0 as u8
    b1 = bitcast b1u8 as u64
    !b1u8
    !p1
    jmp L_B64_HAVE_B1

L_B64_NO_B1:
    !has_b1
    b1 = add 0, 0
    jmp L_B64_HAVE_B1

L_B64_HAVE_B1:
    i2 = add i, 2
    has_b2 = ult i2, src_len
    store has_b2_slot+0, has_b2 as u8
    br has_b2 -> L_B64_LOAD_B2, L_B64_NO_B2

L_B64_LOAD_B2:
    !has_b2
    p2 = ptr_add src, i2
    b2u8 = load p2+0 as u8
    b2 = bitcast b2u8 as u64
    !b2u8
    !p2
    jmp L_B64_ENCODE

L_B64_NO_B2:
    !has_b2
    b2 = add 0, 0
    jmp L_B64_ENCODE

L_B64_ENCODE:
    idx0 = udiv b0, 4
    b0_low = urem b0, 4
    b0_low_shift = mul b0_low, 16
    b1_hi = udiv b1, 16
    idx1 = add b0_low_shift, b1_hi
    b1_low = urem b1, 16
    b1_low_shift = mul b1_low, 4
    b2_hi = udiv b2, 64
    idx2 = add b1_low_shift, b2_hi
    idx3 = urem b2, 64
    call @b64_emit_char(&out, &out_i_slot, idx0)
    call @b64_emit_char(&out, &out_i_slot, idx1)
    has_b1_again = load has_b1_slot+0 as u8
    br has_b1_again -> L_B64_EMIT_2, L_B64_PAD_2

L_B64_EMIT_2:
    !has_b1_again
    call @b64_emit_char(&out, &out_i_slot, idx2)
    has_b2_again = load has_b2_slot+0 as u8
    br has_b2_again -> L_B64_EMIT_3, L_B64_PAD_3

L_B64_PAD_2:
    !has_b1_again
    out_i_a = load out_i_slot+0 as u64
    dst_a = ptr_add out, out_i_a
    store dst_a+0, 61 as u8
    next_a = add out_i_a, 1
    store out_i_slot+0, next_a as u64
    !next_a
    !dst_a
    !out_i_a
    out_i_b = load out_i_slot+0 as u64
    dst_b = ptr_add out, out_i_b
    store dst_b+0, 61 as u8
    next_b = add out_i_b, 1
    store out_i_slot+0, next_b as u64
    !next_b
    !dst_b
    !out_i_b
    jmp L_B64_NEXT

L_B64_EMIT_3:
    !has_b2_again
    call @b64_emit_char(&out, &out_i_slot, idx3)
    jmp L_B64_NEXT

L_B64_PAD_3:
    !has_b2_again
    out_i_c = load out_i_slot+0 as u64
    dst_c = ptr_add out, out_i_c
    store dst_c+0, 61 as u8
    next_c = add out_i_c, 1
    store out_i_slot+0, next_c as u64
    !next_c
    !dst_c
    !out_i_c
    jmp L_B64_NEXT

L_B64_NEXT:
    !idx0
    !b0_low
    !b0_low_shift
    !b1_hi
    !idx1
    !b1_low
    !b1_low_shift
    !b2_hi
    !idx2
    !idx3
    !b0u8
    !b0
    !b1
    !b2
    !p0
    !i1
    !i2
    next_i = add i, 3
    store i_slot+0, next_i as u64
    !next_i
    !i
    jmp L_B64_COND

L_B64_DONE:
    !done
    !i
    final_len = load out_i_slot+0 as u64
    store out_len_slot+0, final_len as u64
    !final_len
    !src
    !src_len
    !out
    !out_len_slot
    return 0

@ffi_wrapper rpc_extract_command_argv(&body: ptr, body_len: u64, &argv: ptr, &out_count: ptr) -> u32:
L_ENTRY:
    start_idx = call @sa_bytes_find(&body, body_len, &J_COMMAND_ARRAY_START, J_COMMAND_ARRAY_START_LEN)
    found = sge start_idx, 0
    br found -> L_CMD_PARSE_INIT, L_CMD_PARSE_NOT_FOUND

L_CMD_PARSE_INIT:
    !found
    start_off_i = add start_idx, J_COMMAND_ARRAY_START_LEN
    !start_idx
    start_off = bitcast start_off_i as u64
    cursor_slot = stack_alloc 8
    count_slot = stack_alloc 8
    store cursor_slot+0, start_off as u64
    store count_slot+0, 0 as u64
    !start_off
    !start_off_i
    jmp L_CMD_ARG_START

L_CMD_ARG_START:
    count = load count_slot+0 as u64
    too_many = uge count, CMD_ARGV_MAX
    br too_many -> L_CMD_DONE_MAX, L_CMD_FIND_END

L_CMD_FIND_END:
    !too_many
    cursor = load cursor_slot+0 as u64
    rem = sub body_len, cursor
    arg_ptr = ptr_add body, cursor
    end_idx = call @sa_bytes_find_byte(&arg_ptr, rem, 34)
    has_end = sge end_idx, 0
    br has_end -> L_CMD_STORE_ARG, L_CMD_DONE_NO_MORE

L_CMD_STORE_ARG:
    !has_end
    arg_len = bitcast end_idx as u64
    off = mul count, SaProcessArgv_SIZE
    entry = ptr_add argv, off
    store entry+SaProcessArgv_data, arg_ptr as ptr
    store entry+SaProcessArgv_len, arg_len as u64
    next_count = add count, 1
    store count_slot+0, next_count as u64
    after_quote = add cursor, arg_len
    next_after_quote = add after_quote, 1
    rem_after = sub body_len, next_after_quote
    sep_ptr = ptr_add body, next_after_quote
    sep_idx = call @sa_bytes_find(&sep_ptr, rem_after, &J_ARG_SEPARATOR, J_ARG_SEPARATOR_LEN)
    sep_here = eq sep_idx, 0
    br sep_here -> L_CMD_NEXT_ARG, L_CMD_DONE_AFTER_ARG

L_CMD_NEXT_ARG:
    !sep_here
    !sep_idx
    next_cursor = add next_after_quote, J_ARG_SEPARATOR_LEN
    store cursor_slot+0, next_cursor as u64
    !next_cursor
    !sep_ptr
    !rem_after
    !next_after_quote
    !after_quote
    !next_count
    !entry
    !off
    !arg_len
    !end_idx
    !arg_ptr
    !rem
    !cursor
    !count
    jmp L_CMD_ARG_START

L_CMD_DONE_AFTER_ARG:
    !sep_here
    !sep_idx
    !sep_ptr
    !rem_after
    !next_after_quote
    !after_quote
    !next_count
    !entry
    !off
    !arg_len
    !end_idx
    !arg_ptr
    !rem
    !cursor
    !count
    jmp L_CMD_DONE

L_CMD_DONE_NO_MORE:
    !has_end
    !end_idx
    !arg_ptr
    !rem
    !cursor
    !count
    jmp L_CMD_DONE

L_CMD_DONE_MAX:
    !too_many
    !count
    jmp L_CMD_DONE

L_CMD_DONE:
    final_count = load count_slot+0 as u64
    store out_count+0, final_count as u64
    ok = ugt final_count, 0
    br ok -> L_CMD_OK, L_CMD_BAD

L_CMD_OK:
    !ok
    !final_count
    !body
    !body_len
    !argv
    !out_count
    return 1

L_CMD_BAD:
    !ok
    !final_count
    !body
    !body_len
    !argv
    !out_count
    return 0

L_CMD_PARSE_NOT_FOUND:
    !found
    !start_idx
    !body
    !body_len
    !argv
    !out_count
    return 0

@ffi_wrapper notify_command_output(&state_ptr: ptr, &process_id_ptr: ptr, process_id_len: u64, &stream_ptr: ptr, stream_len: u64, &data_ptr: ptr, data_len: u64) -> u32:
L_ENTRY:
    has_data = ugt data_len, 0
    br has_data -> L_CMD_NOTIFY_DO, L_CMD_NOTIFY_SKIP

L_CMD_NOTIFY_DO:
    !has_data
    b64_buf = stack_alloc CMD_OUTPUT_BUF_SIZE
    b64_len_slot = stack_alloc 8
    b64_status = call @base64_encode_into(&data_ptr, data_len, &b64_buf, &b64_len_slot)
    !b64_status
    b64_len = load b64_len_slot+0 as u64
    frame = call @rpc_builder_new()
    call @notify_frame_begin(&frame, &EV_CMD_OUTPUT, EV_CMD_OUTPUT_LEN)
    call @rpc_builder_append(&frame, &J_CMD_EVT_A, J_CMD_EVT_A_LEN)
    call @rpc_builder_append(&frame, &process_id_ptr, process_id_len)
    call @rpc_builder_append(&frame, &J_CMD_EVT_B, J_CMD_EVT_B_LEN)
    call @rpc_builder_append(&frame, &stream_ptr, stream_len)
    call @rpc_builder_append(&frame, &J_CMD_EVT_C, J_CMD_EVT_C_LEN)
    call @rpc_builder_append(&frame, &b64_buf, b64_len)
    call @rpc_builder_append(&frame, &J_CMD_EVT_D, J_CMD_EVT_D_LEN)
    call @rpc_builder_append(&frame, &SSE_FRAME_END, SSE_FRAME_END_LEN)
    call @notify_push_frame(&state_ptr, ^frame)
    !b64_len
    !state_ptr
    !process_id_ptr
    !process_id_len
    !stream_ptr
    !stream_len
    !data_ptr
    !data_len
    return 0

L_CMD_NOTIFY_SKIP:
    !has_data
    !state_ptr
    !process_id_ptr
    !process_id_len
    !stream_ptr
    !stream_len
    !data_ptr
    !data_len
    return 0

@ffi_wrapper send_rpc_command_exec(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    argv = stack_alloc CMD_ARGV_BUF_SIZE
    count_slot = stack_alloc 8
    parse_ok = call @rpc_extract_command_argv(&body, body_len, &argv, &count_slot)
    has_command = eq parse_ok, 1
    !parse_ok
    br has_command -> L_CMD_EXEC_PROCESS_ID, L_CMD_EXEC_BAD_PARAMS

L_CMD_EXEC_PROCESS_ID:
    !has_command
    process_id_ptr_slot = stack_alloc 8
    process_id_len_slot = stack_alloc 8
    pid_status = call @rpc_extract_string_after(&body, body_len, &J_PROCESS_ID_KEY, J_PROCESS_ID_KEY_LEN, &process_id_ptr_slot, &process_id_len_slot)
    has_pid = eq pid_status, 1
    !pid_status
    br has_pid -> L_CMD_EXEC_WITH_PID, L_CMD_EXEC_DEFAULT_PID

L_CMD_EXEC_WITH_PID:
    !has_pid
    jmp L_CMD_EXEC_RUN

L_CMD_EXEC_DEFAULT_PID:
    !has_pid
    default_pid_ptr = &DEFAULT_PROCESS_ID
    store process_id_ptr_slot+0, default_pid_ptr as ptr
    store process_id_len_slot+0, DEFAULT_PROCESS_ID_LEN as u64
    !default_pid_ptr
    jmp L_CMD_EXEC_RUN

L_CMD_EXEC_RUN:
    process_id_ptr = load process_id_ptr_slot+0 as ptr
    process_id_len = load process_id_len_slot+0 as u64
    cwd_ptr_slot = stack_alloc 8
    cwd_len_slot = stack_alloc 8
    cwd_status = call @rpc_extract_string_after(&body, body_len, &J_CWD_KEY, J_CWD_KEY_LEN, &cwd_ptr_slot, &cwd_len_slot)
    has_cwd = eq cwd_status, 1
    !cwd_status
    br has_cwd -> L_CMD_EXEC_RUN_WITH_CWD_DIRECT, L_CMD_EXEC_DEFAULT_CWD

L_CMD_EXEC_DEFAULT_CWD:
    !has_cwd
    default_cwd_ptr = &DEFAULT_CWD
    store cwd_ptr_slot+0, default_cwd_ptr as ptr
    store cwd_len_slot+0, DEFAULT_CWD_LEN as u64
    !default_cwd_ptr
    jmp L_CMD_EXEC_RUN_AFTER_CWD

L_CMD_EXEC_RUN_WITH_CWD_DIRECT:
    !has_cwd
    jmp L_CMD_EXEC_RUN_AFTER_CWD

L_CMD_EXEC_RUN_AFTER_CWD:
    cwd_ptr = load cwd_ptr_slot+0 as ptr
    cwd_len = load cwd_len_slot+0 as u64
    count = load count_slot+0 as u64
    EXPAND DENO_COMMAND_RUN_CWD run_status, process_handle, argv, count, cwd_ptr, cwd_len
    run_ok = eq run_status, 0
    !run_status
    br run_ok -> L_CMD_EXEC_WAIT, L_CMD_EXEC_RUN_ERR

L_CMD_EXEC_WAIT:
    !run_ok
    EXPAND DENO_COMMAND_WAIT wait_status, exit_code_u32, process_handle
    wait_ok = eq wait_status, 0
    !wait_status
    br wait_ok -> L_CMD_EXEC_READ, L_CMD_EXEC_WAIT_ERR

L_CMD_EXEC_READ:
    !wait_ok
    stdout_buf = stack_alloc CMD_OUTPUT_BUF_SIZE
    stderr_buf = stack_alloc CMD_OUTPUT_BUF_SIZE
    EXPAND DENO_COMMAND_READ_STDOUT stdout_status, stdout_len, process_handle, stdout_buf, CMD_OUTPUT_BUF_SIZE
    EXPAND DENO_COMMAND_READ_STDERR stderr_status, stderr_len, process_handle, stderr_buf, CMD_OUTPUT_BUF_SIZE
    !stdout_status
    !stderr_status
    exit_code = zext exit_code_u32
    call @notify_command_output(&state_ptr, &process_id_ptr, process_id_len, &STREAM_STDOUT, STREAM_STDOUT_LEN, &stdout_buf, stdout_len)
    call @notify_command_output(&state_ptr, &process_id_ptr, process_id_len, &STREAM_STDERR, STREAM_STDERR_LEN, &stderr_buf, stderr_len)
    result = call @rpc_builder_new()
    call @rpc_builder_append(&result, &J_CMD_RESULT_A, J_CMD_RESULT_A_LEN)
    call @rpc_builder_append_u64(&result, exit_code)
    call @rpc_builder_append(&result, &J_CMD_RESULT_B, J_CMD_RESULT_B_LEN)
    call @rpc_builder_append_json_string(&result, &stdout_buf, stdout_len)
    call @rpc_builder_append(&result, &J_CMD_RESULT_C, J_CMD_RESULT_C_LEN)
    call @rpc_builder_append_json_string(&result, &stderr_buf, stderr_len)
    call @rpc_builder_append(&result, &J_EVT_CLOSE, J_EVT_CLOSE_LEN)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result)
    EXPAND DENO_COMMAND_CLOSE close_status, process_handle
    !close_status
    !exit_code_u32
    !exit_code
    !stdout_len
    !stderr_len
    !process_handle
    !count
    !cwd_ptr
    !cwd_len
    !process_id_ptr
    !process_id_len
    !body
    !body_len
    !state_ptr
    !req
    return 0

L_CMD_EXEC_RUN_ERR:
    !run_ok
    !process_handle
    !count
    !cwd_ptr
    !cwd_len
    !process_id_ptr
    !process_id_len
    call @send_error_with_id(&req, 500, &id_ptr, id_len, &J_ERR_FS, J_ERR_FS_LEN)
    !body
    !body_len
    !state_ptr
    !req
    return 0

L_CMD_EXEC_WAIT_ERR:
    !wait_ok
    !exit_code_u32
    EXPAND DENO_COMMAND_CLOSE close_status_err, process_handle
    !close_status_err
    !process_handle
    !count
    !cwd_ptr
    !cwd_len
    !process_id_ptr
    !process_id_len
    call @send_error_with_id(&req, 500, &id_ptr, id_len, &J_ERR_FS, J_ERR_FS_LEN)
    !body
    !body_len
    !state_ptr
    !req
    return 0

L_CMD_EXEC_BAD_PARAMS:
    !has_command
    call @send_error_with_id(&req, 400, &id_ptr, id_len, &J_ERR_INVALID_PARAMS, J_ERR_INVALID_PARAMS_LEN)
    !body
    !body_len
    !state_ptr
    !req
    return 0

@ffi_wrapper notify_process_output(&state_ptr: ptr, &handle_ptr: ptr, handle_len: u64, &stream_ptr: ptr, stream_len: u64, &data_ptr: ptr, data_len: u64) -> u32:
L_ENTRY:
    has_data = ugt data_len, 0
    br has_data -> L_PROC_NOTIFY_DO, L_PROC_NOTIFY_SKIP

L_PROC_NOTIFY_DO:
    !has_data
    b64_buf = stack_alloc CMD_OUTPUT_BUF_SIZE
    b64_len_slot = stack_alloc 8
    b64_status = call @base64_encode_into(&data_ptr, data_len, &b64_buf, &b64_len_slot)
    !b64_status
    b64_len = load b64_len_slot+0 as u64
    frame = call @rpc_builder_new()
    call @notify_frame_begin(&frame, &EV_PROCESS_OUTPUT, EV_PROCESS_OUTPUT_LEN)
    call @rpc_builder_append(&frame, &J_PROC_EVT_A, J_PROC_EVT_A_LEN)
    call @rpc_builder_append(&frame, &handle_ptr, handle_len)
    call @rpc_builder_append(&frame, &J_PROC_EVT_B, J_PROC_EVT_B_LEN)
    call @rpc_builder_append(&frame, &stream_ptr, stream_len)
    call @rpc_builder_append(&frame, &J_PROC_EVT_C, J_PROC_EVT_C_LEN)
    call @rpc_builder_append(&frame, &b64_buf, b64_len)
    call @rpc_builder_append(&frame, &J_PROC_EVT_D, J_PROC_EVT_D_LEN)
    call @rpc_builder_append(&frame, &SSE_FRAME_END, SSE_FRAME_END_LEN)
    call @notify_push_frame(&state_ptr, ^frame)
    !b64_len
    !state_ptr
    !handle_ptr
    !handle_len
    !stream_ptr
    !stream_len
    !data_ptr
    !data_len
    return 0

L_PROC_NOTIFY_SKIP:
    !has_data
    !state_ptr
    !handle_ptr
    !handle_len
    !stream_ptr
    !stream_len
    !data_ptr
    !data_len
    return 0

@ffi_wrapper notify_process_exited(&state_ptr: ptr, &handle_ptr: ptr, handle_len: u64, exit_code: u64, &stdout_ptr: ptr, stdout_len: u64, &stderr_ptr: ptr, stderr_len: u64) -> u32:
L_ENTRY:
    params = call @rpc_builder_new()
    call @rpc_builder_append(&params, &J_PROC_EXIT_A, J_PROC_EXIT_A_LEN)
    call @rpc_builder_append(&params, &handle_ptr, handle_len)
    call @rpc_builder_append(&params, &J_PROC_EXIT_B, J_PROC_EXIT_B_LEN)
    call @rpc_builder_append_u64(&params, exit_code)
    call @rpc_builder_append(&params, &J_PROC_EXIT_C, J_PROC_EXIT_C_LEN)
    call @rpc_builder_append_json_string(&params, &stdout_ptr, stdout_len)
    call @rpc_builder_append(&params, &J_PROC_EXIT_D, J_PROC_EXIT_D_LEN)
    call @rpc_builder_append_json_string(&params, &stderr_ptr, stderr_len)
    call @rpc_builder_append(&params, &J_PROC_EXIT_E, J_PROC_EXIT_E_LEN)
    params_ptr = call @rpc_builder_data(&params)
    params_len = call @rpc_builder_len(&params)
    call @notify_const_params(&state_ptr, &EV_PROCESS_EXITED, EV_PROCESS_EXITED_LEN, &params_ptr, params_len)
    !params_ptr
    !params_len
    !params
    !state_ptr
    !handle_ptr
    !handle_len
    !exit_code
    !stdout_ptr
    !stdout_len
    !stderr_ptr
    !stderr_len
    return 0

@ffi_wrapper send_rpc_process_spawn(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    argv = stack_alloc CMD_ARGV_BUF_SIZE
    count_slot = stack_alloc 8
    parse_ok = call @rpc_extract_command_argv(&body, body_len, &argv, &count_slot)
    has_command = eq parse_ok, 1
    !parse_ok
    br has_command -> L_PROC_HANDLE, L_PROC_DEFAULT_COMMAND

L_PROC_DEFAULT_COMMAND:
    !has_command
    default_arg_ptr = &DEFAULT_TRUE
    store argv+SaProcessArgv_data, default_arg_ptr as ptr
    store argv+SaProcessArgv_len, DEFAULT_TRUE_LEN as u64
    store count_slot+0, 1 as u64
    !default_arg_ptr
    jmp L_PROC_HANDLE_FROM_DEFAULT

L_PROC_HANDLE:
    !has_command

L_PROC_HANDLE_FROM_DEFAULT:
    handle_ptr_slot = stack_alloc 8
    handle_len_slot = stack_alloc 8
    handle_status = call @rpc_extract_string_after(&body, body_len, &J_PROCESS_HANDLE_KEY, J_PROCESS_HANDLE_KEY_LEN, &handle_ptr_slot, &handle_len_slot)
    has_handle = eq handle_status, 1
    !handle_status
    br has_handle -> L_PROC_RUN, L_PROC_DEFAULT_HANDLE

L_PROC_DEFAULT_HANDLE:
    !has_handle
    default_handle_ptr = &DEFAULT_PROCESS_HANDLE
    store handle_ptr_slot+0, default_handle_ptr as ptr
    store handle_len_slot+0, DEFAULT_PROCESS_HANDLE_LEN as u64
    !default_handle_ptr
    jmp L_PROC_RUN_FROM_DEFAULT

L_PROC_RUN:
    !has_handle

L_PROC_RUN_FROM_DEFAULT:
    handle_ptr = load handle_ptr_slot+0 as ptr
    handle_len = load handle_len_slot+0 as u64
    cwd_ptr_slot = stack_alloc 8
    cwd_len_slot = stack_alloc 8
    cwd_status = call @rpc_extract_string_after(&body, body_len, &J_CWD_KEY, J_CWD_KEY_LEN, &cwd_ptr_slot, &cwd_len_slot)
    has_cwd = eq cwd_status, 1
    !cwd_status
    br has_cwd -> L_PROC_RUN_WITH_CWD_DIRECT, L_PROC_DEFAULT_CWD

L_PROC_DEFAULT_CWD:
    !has_cwd
    default_cwd_ptr = &DEFAULT_CWD
    store cwd_ptr_slot+0, default_cwd_ptr as ptr
    store cwd_len_slot+0, DEFAULT_CWD_LEN as u64
    !default_cwd_ptr
    jmp L_PROC_RUN_AFTER_CWD

L_PROC_RUN_WITH_CWD_DIRECT:
    !has_cwd
    jmp L_PROC_RUN_AFTER_CWD

L_PROC_RUN_AFTER_CWD:
    cwd_ptr = load cwd_ptr_slot+0 as ptr
    cwd_len = load cwd_len_slot+0 as u64
    count = load count_slot+0 as u64
    EXPAND DENO_COMMAND_RUN_CWD run_status, process_handle, argv, count, cwd_ptr, cwd_len
    run_ok = eq run_status, 0
    !run_status
    br run_ok -> L_PROC_WAIT, L_PROC_RUN_ERR

L_PROC_WAIT:
    !run_ok
    EXPAND DENO_COMMAND_WAIT wait_status, exit_code_u32, process_handle
    wait_ok = eq wait_status, 0
    !wait_status
    br wait_ok -> L_PROC_READ, L_PROC_WAIT_ERR

L_PROC_READ:
    !wait_ok
    stdout_buf = stack_alloc CMD_OUTPUT_BUF_SIZE
    stderr_buf = stack_alloc CMD_OUTPUT_BUF_SIZE
    EXPAND DENO_COMMAND_READ_STDOUT stdout_status, stdout_len, process_handle, stdout_buf, CMD_OUTPUT_BUF_SIZE
    EXPAND DENO_COMMAND_READ_STDERR stderr_status, stderr_len, process_handle, stderr_buf, CMD_OUTPUT_BUF_SIZE
    !stdout_status
    !stderr_status
    exit_code = zext exit_code_u32
    proc_put_status = call @state_process_put(&state_ptr, &handle_ptr, handle_len)
    !proc_put_status
    call @notify_process_output(&state_ptr, &handle_ptr, handle_len, &STREAM_STDOUT, STREAM_STDOUT_LEN, &stdout_buf, stdout_len)
    call @notify_process_output(&state_ptr, &handle_ptr, handle_len, &STREAM_STDERR, STREAM_STDERR_LEN, &stderr_buf, stderr_len)
    call @notify_process_exited(&state_ptr, &handle_ptr, handle_len, exit_code, &stdout_buf, stdout_len, &stderr_buf, stderr_len)
    result = call @rpc_builder_new()
    call @rpc_builder_append(&result, &J_PROCESS_SPAWN_A, J_PROCESS_SPAWN_A_LEN)
    call @rpc_builder_append_json_string(&result, &handle_ptr, handle_len)
    call @rpc_builder_append(&result, &J_PROCESS_SPAWN_B, J_PROCESS_SPAWN_B_LEN)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result)
    EXPAND DENO_COMMAND_CLOSE close_status, process_handle
    !close_status
    !exit_code_u32
    !exit_code
    !stdout_len
    !stderr_len
    !process_handle
    !count
    !cwd_ptr
    !cwd_len
    !handle_ptr
    !handle_len
    !body
    !body_len
    !state_ptr
    !req
    return 0

L_PROC_RUN_ERR:
    !run_ok
    !process_handle
    !count
    !cwd_ptr
    !cwd_len
    !handle_ptr
    !handle_len
    call @send_error_with_id(&req, 500, &id_ptr, id_len, &J_ERR_FS, J_ERR_FS_LEN)
    !body
    !body_len
    !state_ptr
    !req
    return 0

L_PROC_WAIT_ERR:
    !wait_ok
    !exit_code_u32
    EXPAND DENO_COMMAND_CLOSE close_status_err, process_handle
    !close_status_err
    !process_handle
    !count
    !cwd_ptr
    !cwd_len
    !handle_ptr
    !handle_len
    call @send_error_with_id(&req, 500, &id_ptr, id_len, &J_ERR_FS, J_ERR_FS_LEN)
    !body
    !body_len
    !state_ptr
    !req
    return 0

@ffi_wrapper send_rpc_process_kill(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    handle_ptr_slot = stack_alloc 8
    handle_len_slot = stack_alloc 8
    handle_status = call @rpc_extract_string_after(&body, body_len, &J_PROCESS_HANDLE_KEY, J_PROCESS_HANDLE_KEY_LEN, &handle_ptr_slot, &handle_len_slot)
    has_handle = eq handle_status, 1
    !handle_status
    br has_handle -> L_PK_DELETE, L_PK_FALSE

L_PK_DELETE:
    !has_handle
    handle_ptr = load handle_ptr_slot+0 as ptr
    handle_len = load handle_len_slot+0 as u64
    deleted = call @state_process_delete(&state_ptr, &handle_ptr, handle_len)
    is_deleted = eq deleted, 1
    !deleted
    br is_deleted -> L_PK_TRUE, L_PK_FALSE_WITH_HANDLE

L_PK_TRUE:
    !is_deleted
    call @send_wrapped_const_with_id(&req, &id_ptr, id_len, &J_FS_OK_TRUE, J_FS_OK_TRUE_LEN)
    !handle_ptr
    !handle_len
    !body
    !body_len
    !state_ptr
    !req
    return 0

L_PK_FALSE_WITH_HANDLE:
    !is_deleted
    !handle_ptr
    !handle_len
    jmp L_PK_FALSE_FROM_HANDLE

L_PK_FALSE:
    !has_handle
    jmp L_PK_FALSE_FROM_HANDLE

L_PK_FALSE_FROM_HANDLE:
    call @send_wrapped_const_with_id(&req, &id_ptr, id_len, &J_OK_FALSE_RESULT, J_OK_FALSE_RESULT_LEN)
    !body
    !body_len
    !state_ptr
    !req
    return 0

@ffi_wrapper send_rpc_fs_read(&req: ptr, &id_ptr: ptr, id_len: u64, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    path_ptr_slot = stack_alloc 8
    path_len_slot = stack_alloc 8
    path_status = call @rpc_extract_string_after(&body, body_len, &J_PATH_KEY, J_PATH_KEY_LEN, &path_ptr_slot, &path_len_slot)
    has_path = eq path_status, 1
    !path_status
    br has_path -> L_FS_READ_DO, L_FS_READ_BAD_PARAMS

L_FS_READ_BAD_PARAMS:
    !has_path
    call @send_error_with_id(&req, 400, &id_ptr, id_len, &J_ERR_INVALID_PARAMS, J_ERR_INVALID_PARAMS_LEN)
    !body
    !body_len
    !req
    return 0

L_FS_READ_DO:
    !has_path
    path_ptr = load path_ptr_slot+0 as ptr
    path_len = load path_len_slot+0 as u64
    EXPAND DENO_READ_FILE_BASE64 read_status, read_handle, path_ptr, path_len, FS_MAX_READ_BYTES
    read_ok = eq read_status, 0
    !read_status
    br read_ok -> L_FS_READ_OK, L_FS_READ_ERR

L_FS_READ_ERR:
    !read_ok
    !read_handle
    !path_ptr
    !path_len
    call @send_error_with_id(&req, 500, &id_ptr, id_len, &J_ERR_FS, J_ERR_FS_LEN)
    !body
    !body_len
    !req
    return 0

L_FS_READ_OK:
    !read_ok
    data_ptr = call @sa_fs_read_buffer_data(read_handle)
    data_len = call @sa_fs_read_buffer_len(read_handle)
    result = call @rpc_builder_new()
    call @rpc_builder_append(&result, &J_FS_READ_A, J_FS_READ_A_LEN)
    call @rpc_builder_append(&result, &data_ptr, data_len)
    call @rpc_builder_append(&result, &J_FS_READ_B, J_FS_READ_B_LEN)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result)
    !data_ptr
    !data_len
    free_status = call @sa_fs_read_buffer_free(^read_handle)
    !free_status
    !path_ptr
    !path_len
    !body
    !body_len
    !req
    return 0

@ffi_wrapper send_rpc_fs_write(&req: ptr, &id_ptr: ptr, id_len: u64, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    path_ptr_slot = stack_alloc 8
