    call @rpc_builder_append_u64(&frame, turn_id)
    call @rpc_builder_append(&frame, &item_suffix, item_suffix_len)
    call @rpc_builder_append(&frame, &item_ptr, item_len)
    call @rpc_builder_append(&frame, &J_EVT_CLOSE, J_EVT_CLOSE_LEN)
    call @rpc_builder_append(&frame, &SSE_FRAME_END, SSE_FRAME_END_LEN)
    call @notify_push_frame(&state_ptr, ^frame)
    !thread_id
    !turn_id
    !item_ptr
    !item_len
    !state_ptr
