    m_fsw_ok = sge m_fsw_idx, 0
    !m_fsw_idx
    br m_fsw_ok -> L_RPC_FS_WRITE, L_RPC_TRY_FS_MKDIR

L_RPC_FS_WRITE:
    !m_fsw_ok
    call @send_rpc_fs_write(&req, &rpc_id_ptr, rpc_id_len, &rpc_body_ptr, rpc_body_len)
    jmp L_RPC_DONE

L_RPC_TRY_FS_MKDIR:
    !m_fsw_ok
    m_fsm_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_FS_MKDIR, RPC_M_FS_MKDIR_LEN)
    m_fsm_ok = sge m_fsm_idx, 0
    !m_fsm_idx
    br m_fsm_ok -> L_RPC_FS_MKDIR, L_RPC_TRY_FS_READDIR

L_RPC_FS_MKDIR:
    !m_fsm_ok
    call @send_rpc_fs_mkdir(&req, &rpc_id_ptr, rpc_id_len, &rpc_body_ptr, rpc_body_len)
    jmp L_RPC_DONE

L_RPC_TRY_FS_READDIR:
    !m_fsm_ok
    m_fsrd_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_FS_READDIR, RPC_M_FS_READDIR_LEN)
    m_fsrd_ok = sge m_fsrd_idx, 0
    !m_fsrd_idx
    br m_fsrd_ok -> L_RPC_FS_READDIR, L_RPC_TRY_FS_METADATA

L_RPC_FS_READDIR:
    !m_fsrd_ok
    call @send_rpc_fs_readdir(&req, &rpc_id_ptr, rpc_id_len, &rpc_body_ptr, rpc_body_len)
    jmp L_RPC_DONE

L_RPC_TRY_FS_METADATA:
    !m_fsrd_ok
    m_fsmeta_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_FS_METADATA, RPC_M_FS_METADATA_LEN)
    m_fsmeta_ok = sge m_fsmeta_idx, 0
    !m_fsmeta_idx
    br m_fsmeta_ok -> L_RPC_FS_METADATA, L_RPC_TRY_FS_REMOVE

L_RPC_FS_METADATA:
    !m_fsmeta_ok
    call @send_rpc_fs_metadata(&req, &rpc_id_ptr, rpc_id_len, &rpc_body_ptr, rpc_body_len)
    jmp L_RPC_DONE

L_RPC_TRY_FS_REMOVE:
    !m_fsmeta_ok
    m_fsremove_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_FS_REMOVE, RPC_M_FS_REMOVE_LEN)
    m_fsremove_ok = sge m_fsremove_idx, 0
    !m_fsremove_idx
    br m_fsremove_ok -> L_RPC_FS_REMOVE, L_RPC_TRY_FS_COPY

L_RPC_FS_REMOVE:
    !m_fsremove_ok
    call @send_rpc_fs_remove(&req, &rpc_id_ptr, rpc_id_len, &rpc_body_ptr, rpc_body_len)
    jmp L_RPC_DONE

L_RPC_TRY_FS_COPY:
    !m_fsremove_ok
    m_fscopy_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_FS_COPY, RPC_M_FS_COPY_LEN)
    m_fscopy_ok = sge m_fscopy_idx, 0
    !m_fscopy_idx
    br m_fscopy_ok -> L_RPC_FS_COPY, L_RPC_TRY_FS_WATCH

L_RPC_FS_COPY:
    !m_fscopy_ok
    call @send_rpc_fs_copy(&req, &rpc_id_ptr, rpc_id_len, &rpc_body_ptr, rpc_body_len)
    jmp L_RPC_DONE

L_RPC_TRY_FS_WATCH:
    !m_fscopy_ok
    m_fwatch_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_FS_WATCH, RPC_M_FS_WATCH_LEN)
    m_fwatch_ok = sge m_fwatch_idx, 0
    !m_fwatch_idx
    br m_fwatch_ok -> L_RPC_FS_WATCH, L_RPC_TRY_FS_UNWATCH

L_RPC_FS_WATCH:
    !m_fwatch_ok
    call @send_rpc_fs_watch(&req, &rpc_id_ptr, rpc_id_len, &state_ptr, &rpc_body_ptr, rpc_body_len)
    jmp L_RPC_DONE

L_RPC_TRY_FS_UNWATCH:
    !m_fwatch_ok
    m_funwatch_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_FS_UNWATCH, RPC_M_FS_UNWATCH_LEN)
    m_funwatch_ok = sge m_funwatch_idx, 0
    !m_funwatch_idx
    br m_funwatch_ok -> L_RPC_FS_UNWATCH, L_RPC_TRY_COMMAND_EXEC

L_RPC_FS_UNWATCH:
    !m_funwatch_ok
    call @send_rpc_fs_unwatch(&req, &rpc_id_ptr, rpc_id_len, &state_ptr, &rpc_body_ptr, rpc_body_len)
    jmp L_RPC_DONE

L_RPC_TRY_COMMAND_EXEC:
    !m_funwatch_ok
    m_cmd_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_COMMAND_EXEC, RPC_M_COMMAND_EXEC_LEN)
    m_cmd_ok = sge m_cmd_idx, 0
    !m_cmd_idx
    br m_cmd_ok -> L_RPC_COMMAND_EXEC, L_RPC_TRY_COMMAND_WRITE

L_RPC_COMMAND_EXEC:
    !m_cmd_ok
    call @send_rpc_command_exec(&req, &rpc_id_ptr, rpc_id_len, &state_ptr, &rpc_body_ptr, rpc_body_len)
    jmp L_RPC_DONE

L_RPC_TRY_COMMAND_WRITE:
    !m_cmd_ok
    m_cmd_write_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_COMMAND_WRITE, RPC_M_COMMAND_WRITE_LEN)
    m_cmd_write_ok = sge m_cmd_write_idx, 0
    !m_cmd_write_idx
    br m_cmd_write_ok -> L_RPC_COMMAND_WRITE, L_RPC_TRY_COMMAND_TERMINATE

L_RPC_COMMAND_WRITE:
    !m_cmd_write_ok
    call @send_rpc_bool_field_with_id(&req, &rpc_id_ptr, rpc_id_len, &JSON_KEY_OK, JSON_KEY_OK_LEN, 1)
    jmp L_RPC_DONE

L_RPC_TRY_COMMAND_TERMINATE:
    !m_cmd_write_ok
    m_cmd_term_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_COMMAND_TERMINATE, RPC_M_COMMAND_TERMINATE_LEN)
    m_cmd_term_ok = sge m_cmd_term_idx, 0
    !m_cmd_term_idx
    br m_cmd_term_ok -> L_RPC_COMMAND_TERMINATE, L_RPC_TRY_COMMAND_RESIZE

L_RPC_COMMAND_TERMINATE:
    !m_cmd_term_ok
    call @send_rpc_bool_field_with_id(&req, &rpc_id_ptr, rpc_id_len, &JSON_KEY_OK, JSON_KEY_OK_LEN, 1)
    jmp L_RPC_DONE

L_RPC_TRY_COMMAND_RESIZE:
    !m_cmd_term_ok
    m_cmd_resize_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_COMMAND_RESIZE, RPC_M_COMMAND_RESIZE_LEN)
    m_cmd_resize_ok = sge m_cmd_resize_idx, 0
    !m_cmd_resize_idx
    br m_cmd_resize_ok -> L_RPC_COMMAND_RESIZE, L_RPC_TRY_PROCESS_SPAWN

L_RPC_COMMAND_RESIZE:
    !m_cmd_resize_ok
    call @send_rpc_bool_field_with_id(&req, &rpc_id_ptr, rpc_id_len, &JSON_KEY_OK, JSON_KEY_OK_LEN, 1)
    jmp L_RPC_DONE

L_RPC_TRY_PROCESS_SPAWN:
    !m_cmd_resize_ok
    m_proc_spawn_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_PROCESS_SPAWN, RPC_M_PROCESS_SPAWN_LEN)
    m_proc_spawn_ok = sge m_proc_spawn_idx, 0
    !m_proc_spawn_idx
    br m_proc_spawn_ok -> L_RPC_PROCESS_SPAWN, L_RPC_TRY_PROCESS_WRITE_STDIN

L_RPC_PROCESS_SPAWN:
    !m_proc_spawn_ok
    call @send_rpc_process_spawn(&req, &rpc_id_ptr, rpc_id_len, &state_ptr, &rpc_body_ptr, rpc_body_len)
    jmp L_RPC_DONE

L_RPC_TRY_PROCESS_WRITE_STDIN:
    !m_proc_spawn_ok
    m_proc_write_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_PROCESS_WRITE_STDIN, RPC_M_PROCESS_WRITE_STDIN_LEN)
    m_proc_write_ok = sge m_proc_write_idx, 0
    !m_proc_write_idx
    br m_proc_write_ok -> L_RPC_PROCESS_WRITE_STDIN, L_RPC_TRY_PROCESS_KILL

L_RPC_PROCESS_WRITE_STDIN:
    !m_proc_write_ok
    call @send_rpc_bool_field_with_id(&req, &rpc_id_ptr, rpc_id_len, &JSON_KEY_OK, JSON_KEY_OK_LEN, 1)
    jmp L_RPC_DONE

L_RPC_TRY_PROCESS_KILL:
    !m_proc_write_ok
    m_proc_kill_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_PROCESS_KILL, RPC_M_PROCESS_KILL_LEN)
    m_proc_kill_ok = sge m_proc_kill_idx, 0
    !m_proc_kill_idx
    br m_proc_kill_ok -> L_RPC_PROCESS_KILL, L_RPC_TRY_PROCESS_RESIZE

L_RPC_PROCESS_KILL:
    !m_proc_kill_ok
    call @send_rpc_process_kill(&req, &rpc_id_ptr, rpc_id_len, &state_ptr, &rpc_body_ptr, rpc_body_len)
    jmp L_RPC_DONE

L_RPC_TRY_PROCESS_RESIZE:
    !m_proc_kill_ok
    m_proc_resize_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_PROCESS_RESIZE, RPC_M_PROCESS_RESIZE_LEN)
    m_proc_resize_ok = sge m_proc_resize_idx, 0
    !m_proc_resize_idx
    br m_proc_resize_ok -> L_RPC_PROCESS_RESIZE, L_RPC_UNKNOWN

L_RPC_PROCESS_RESIZE:
    !m_proc_resize_ok
    call @send_rpc_bool_field_with_id(&req, &rpc_id_ptr, rpc_id_len, &JSON_KEY_OK, JSON_KEY_OK_LEN, 1)
    jmp L_RPC_DONE

L_RPC_UNKNOWN:
    !m_proc_resize_ok
    call @send_error_with_id(&req, 404, &rpc_id_ptr, rpc_id_len, &J_ERR_NOT_FOUND, J_ERR_NOT_FOUND_LEN)
    jmp L_RPC_DONE

L_RPC_DONE:
    !rpc_id_ptr
    !rpc_id_len
    !req
    !rpc_body_ptr
    !rpc_body_len
    !state_ptr
    !cfg_ptr
    return 0

@accept_and_handle_http_request(server: ptr, &req_slot: ptr, &state_ptr: ptr, &cfg_ptr: ptr) -> u32:
L_ENTRY:
    accept_status = call @sa_http_server_accept(server, &req_slot)
    accept_ok = eq accept_status, 0
    !accept_status
    br accept_ok -> L_ACCEPT_OK, L_ACCEPT_SKIP

L_ACCEPT_SKIP:
    return 0

L_ACCEPT_OK:
    req = load req_slot+0 as ptr
    has_req = ne req, 0
    br has_req -> L_HANDLE, L_NO_REQ

L_NO_REQ:
    return 0

L_HANDLE:
    handle_status = call @handle_http_request(^req, &state_ptr, &cfg_ptr)
    !handle_status
    return 0

// ============================================================
// @main — Entry point
// ============================================================
@handle_http_request(^req: ptr, &state_ptr: ptr, &cfg_ptr: ptr) -> u32:
L_ENTRY:
    method_ptr_slot = stack_alloc 8
    method_len_slot = stack_alloc 8
    path_ptr_slot = stack_alloc 8
    path_len_slot = stack_alloc 8

    method_status = call @sa_http_server_req_get_method(req, &method_ptr_slot, &method_len_slot)
    method_ptr = load method_ptr_slot+0 as ptr
    method_len = load method_len_slot+0 as u64
    !method_status

    // Extract request path before auth so health endpoints stay public.
    path_status = call @sa_http_server_req_get_path(req, &path_ptr_slot, &path_len_slot)
    path_ptr = load path_ptr_slot+0 as ptr
    path_len = load path_len_slot+0 as u64
    !path_status

    is_get_raw = call @sa_bytes_eq(&method_ptr, method_len, &METHOD_GET, METHOD_GET_LEN)
    is_get = eq is_get_raw, 1
    !is_get_raw
    is_post_raw = call @sa_bytes_eq(&method_ptr, method_len, &METHOD_POST, METHOD_POST_LEN)
    is_post = eq is_post_raw, 1
    !is_post_raw

    // --- Route: /healthz ---
    is_health = call @sa_bytes_eq(&path_ptr, path_len, &ROUTE_HEALTH, ROUTE_HEALTH_LEN)
    is_health_path = eq is_health, 1
    is_health_ok = and is_health_path, is_get
    !is_health
    !is_health_path
    br is_health_ok -> L_HEALTH, L_CHECK_READY

L_CHECK_READY:
    !is_health_ok
    is_ready = call @sa_bytes_eq(&path_ptr, path_len, &ROUTE_READY, ROUTE_READY_LEN)
    is_ready_path = eq is_ready, 1
    is_ready_ok = and is_ready_path, is_get
    !is_ready
    !is_ready_path
    br is_ready_ok -> L_READY, L_CHECK_PUBLIC_MODELS

L_CHECK_PUBLIC_MODELS:
    !is_ready_ok
    is_models_public = call @sa_bytes_eq(&path_ptr, path_len, &ROUTE_MODELS, ROUTE_MODELS_LEN)
    is_models_public_path = eq is_models_public, 1
    is_models_public_ok = and is_models_public_path, is_get
    !is_models_public
    !is_models_public_path
    br is_models_public_ok -> L_PROXY_MODELS_PUBLIC, L_AUTH_PREP

L_AUTH_PREP:
    !is_models_public_ok
    // --- Auth interceptor (for all non-health routes) ---
    auth_token_ptr = load cfg_ptr+CFG_AUTH_PTR as ptr
    auth_token_len = load cfg_ptr+CFG_AUTH_LEN as u64
    auth_ok = call @check_auth(&req, &auth_token_ptr, auth_token_len)
    is_authed = eq auth_ok, 1
    !auth_ok
    br is_authed -> L_AUTHED, L_NO_AUTH

L_NO_AUTH:
    !is_authed
    noauth_chat_raw = call @sa_bytes_eq(&path_ptr, path_len, &ROUTE_CHAT, ROUTE_CHAT_LEN)
    noauth_chat = eq noauth_chat_raw, 1
    !noauth_chat_raw
    noauth_resp_raw = call @sa_bytes_eq(&path_ptr, path_len, &ROUTE_RESP, ROUTE_RESP_LEN)
    noauth_resp = eq noauth_resp_raw, 1
    !noauth_resp_raw
    noauth_v1 = or noauth_chat, noauth_resp
    !noauth_chat
    !noauth_resp
    noauth_rpc_raw = call @sa_bytes_eq(&path_ptr, path_len, &ROUTE_RPC, ROUTE_RPC_LEN)
    noauth_rpc = eq noauth_rpc_raw, 1
    !noauth_rpc_raw
    noauth_api = or noauth_v1, noauth_rpc
    !noauth_v1
    !noauth_rpc
    noauth_body_ptr_slot = stack_alloc 8
    noauth_body_len_slot = stack_alloc 8
    br noauth_api -> L_NO_AUTH_API_LOG, L_NO_AUTH_SKIP_API_LOG

L_NO_AUTH_API_LOG:
    !noauth_api
    noauth_body_status = call @sa_http_server_req_get_body(req, &noauth_body_ptr_slot, &noauth_body_len_slot)
    noauth_body_ptr = load noauth_body_ptr_slot+0 as ptr
    noauth_body_len = load noauth_body_len_slot+0 as u64
    noauth_req_log_status = call @write_api_request_log(&req, &cfg_ptr, &path_ptr, path_len, &method_ptr, method_len, &noauth_body_ptr, noauth_body_len)
    !noauth_req_log_status
    !noauth_body_status
    !noauth_body_ptr
    !noauth_body_len
    jmp L_NO_AUTH_WRITE_AUTH_LOG

L_NO_AUTH_SKIP_API_LOG:
    !noauth_api
    jmp L_NO_AUTH_WRITE_AUTH_LOG

L_NO_AUTH_WRITE_AUTH_LOG:
    auth_log_status = call @write_auth_failure_log(&req, &cfg_ptr, &path_ptr, path_len, &auth_token_ptr, auth_token_len)
    !auth_log_status
    !auth_token_ptr
    !auth_token_len
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    call @send_json_error_string_response(&req, 401, &JSON_VALUE_UNAUTHORIZED, JSON_VALUE_UNAUTHORIZED_LEN)
    call @sa_http_server_req_free(^req)
    !state_ptr
    !cfg_ptr
    return 0

L_AUTHED:
    !is_authed
    !auth_token_ptr
    !auth_token_len

L_CHECK_CHAT:
    is_chat = call @sa_bytes_eq(&path_ptr, path_len, &ROUTE_CHAT, ROUTE_CHAT_LEN)
    is_chat_path = eq is_chat, 1
    is_chat_ok = and is_chat_path, is_post
    !is_chat
    !is_chat_path
    br is_chat_ok -> L_PROXY_CHAT, L_CHECK_RESP

L_CHECK_RESP:
    !is_chat_ok
    is_resp = call @sa_bytes_eq(&path_ptr, path_len, &ROUTE_RESP, ROUTE_RESP_LEN)
    is_resp_path = eq is_resp, 1
    is_resp_ok = and is_resp_path, is_post
    !is_resp
    !is_resp_path
    br is_resp_ok -> L_PROXY_RESP, L_CHECK_MODELS

L_CHECK_MODELS:
    !is_resp_ok
    is_models = call @sa_bytes_eq(&path_ptr, path_len, &ROUTE_MODELS, ROUTE_MODELS_LEN)
    is_models_path = eq is_models, 1
    is_models_ok = and is_models_path, is_get
    !is_models
    !is_models_path
    br is_models_ok -> L_PROXY_MODELS, L_CHECK_RPC

L_CHECK_RPC:
    !is_models_ok
    is_rpc = call @sa_bytes_eq(&path_ptr, path_len, &ROUTE_RPC, ROUTE_RPC_LEN)
    is_rpc_path = eq is_rpc, 1
    is_rpc_ok = and is_rpc_path, is_post
    !is_rpc
    !is_rpc_path
    br is_rpc_ok -> L_HANDLE_RPC, L_CHECK_EVENTS

L_CHECK_EVENTS:
    !is_rpc_ok
    is_events = call @sa_bytes_eq(&path_ptr, path_len, &ROUTE_EVENTS, ROUTE_EVENTS_LEN)
    is_events_path = eq is_events, 1
    is_events_ok = and is_events_path, is_get
    !is_events
    !is_events_path
    br is_events_ok -> L_HANDLE_EVENTS, L_NOT_FOUND

L_PROXY_MODELS_PUBLIC:
    is_models_ok = eq is_models_public_ok, 1
    !is_models_public_ok
    jmp L_PROXY_MODELS

// ============================================================
// /healthz and /readyz — Simple 200 OK
// ============================================================
L_HEALTH:
    !is_health_ok
    call @sa_print_bytes(&LOG_HEALTH, LOG_HEALTH_LEN)
    h_send = call @send_json_bool_field_response(&req, 200, &JSON_KEY_OK, JSON_KEY_OK_LEN, 1)
    !h_send
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    call @sa_http_server_req_free(^req)
    !state_ptr
    !cfg_ptr
    return 0

L_READY:
    !is_ready_ok
    call @sa_print_bytes(&LOG_HEALTH, LOG_HEALTH_LEN)
    rdy_send = call @send_json_bool_field_response(&req, 200, &JSON_KEY_OK, JSON_KEY_OK_LEN, 1)
    !rdy_send
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    call @sa_http_server_req_free(^req)
    !state_ptr
    !cfg_ptr
    return 0

// ============================================================
// /v1/chat/completions — Reverse proxy with SSE streaming
// + Token metering from SSE chunks
// ============================================================
L_PROXY_CHAT:
    !is_chat_ok
    call @sa_print_bytes(&LOG_CHAT, LOG_CHAT_LEN)

    // Read request body
    body_ptr_slot = stack_alloc 8
    body_len_slot = stack_alloc 8
    body_status = call @sa_http_server_req_get_body(req, &body_ptr_slot, &body_len_slot)
    body_ptr = load body_ptr_slot+0 as ptr
    body_len = load body_len_slot+0 as u64
    chat_log_status = call @write_api_request_log(&req, &cfg_ptr, &path_ptr, path_len, &method_ptr, method_len, &body_ptr, body_len)
    !chat_log_status
    chat_blank = call @body_is_blank(&body_ptr, body_len)
    chat_blank_ok = eq chat_blank, 1
    br chat_blank_ok -> L_CHAT_EMPTY_BODY, L_CHAT_BODY_OK

L_CHAT_EMPTY_BODY:
    !chat_blank_ok
    !chat_blank
    empty_send_status = call @send_empty_body_error_response(&req)
    !empty_send_status
    !body_ptr
    !body_len
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    call @sa_http_server_req_free(^req)
    !state_ptr
    !cfg_ptr
    return 0

L_CHAT_BODY_OK:
    !chat_blank_ok
    !chat_blank
    proxy_body_len_slot = stack_alloc 8
    proxy_body_ptr = call @build_chat_proxy_body(&body_ptr, body_len, &proxy_body_len_slot)
    proxy_body_len = load proxy_body_len_slot+0 as u64

    // Get upstream URL from config
    chat_base_ptr = load cfg_ptr+CFG_CHAT_PTR as ptr
    chat_base_len = load cfg_ptr+CFG_CHAT_LEN as u64
    upstream_len_slot = stack_alloc 8
    upstream_ptr = call @build_proxy_url(&chat_base_ptr, chat_base_len, &UP_CHAT_SUFFIX, UP_CHAT_SUFFIX_LEN, &upstream_len_slot)
    upstream_len = load upstream_len_slot+0 as u64
    api_key_ptr = load cfg_ptr+CFG_KEY_PTR as ptr
    api_key_len = load cfg_ptr+CFG_KEY_LEN as u64
    up_auth_len_slot = stack_alloc 8
    up_auth_buf = call @build_bearer_auth_header(&api_key_ptr, api_key_len, &up_auth_len_slot)
    up_auth_len = load up_auth_len_slot+0 as u64

    // Create outbound HTTP client (TLS=1)
    client_slot = stack_alloc 8
    client_status = call @sa_http_client_new(1, &client_slot)
    client = load client_slot+0 as ptr

    // Create outbound request (POST)
    out_req_slot = stack_alloc 8
    out_status = call @sa_http_client_req_new(client, 2, &upstream_ptr, upstream_len, &out_req_slot)
    out_req = load out_req_slot+0 as ptr

    // Match Deno forwardHeaders: upstream sees Bearer auth and raw x-api-key.
    call @sa_http_client_req_add_header(out_req, &HDR_AUTH, HDR_AUTH_LEN, &up_auth_buf, up_auth_len)
    call @sa_http_client_req_add_header(out_req, &HDR_X_API_KEY, HDR_X_API_KEY_LEN, &api_key_ptr, api_key_len)

    // Add Content-Type header
    call @sa_http_client_req_add_header(out_req, &HDR_CONTENT_TYPE, HDR_CONTENT_TYPE_LEN, &MIME_JSON, MIME_JSON_LEN)

    // Set request body
    call @sa_http_client_req_set_body(out_req, &proxy_body_ptr, proxy_body_len)

    // Send request
    out_resp_slot = stack_alloc 8
    send_status = call @sa_http_client_req_send(out_req, &out_resp_slot)
    out_resp = load out_resp_slot+0 as ptr

    up_status = call @sa_http_client_resp_status(out_resp)

    ct_ptr_slot = stack_alloc 8
    ct_len_slot = stack_alloc 8
    store ct_ptr_slot+0, 0 as ptr
    store ct_len_slot+0, 0 as u64
    ct_status = call @sa_http_client_resp_get_header(out_resp, &HDR_CONTENT_TYPE, HDR_CONTENT_TYPE_LEN, &ct_ptr_slot, &ct_len_slot)
    ct_ptr = load ct_ptr_slot+0 as ptr
    ct_len = load ct_len_slot+0 as u64
    !ct_status
    ct_has_len = ugt ct_len, 0
    br ct_has_len -> L_CHAT_CT_FIND, L_CHAT_NON_SSE_DEFAULT

L_CHAT_CT_FIND:
    !ct_has_len
    ct_idx = call @sa_bytes_find(&ct_ptr, ct_len, &MIME_EVENT_STREAM, MIME_EVENT_STREAM_LEN)
    ct_is_sse = sge ct_idx, 0
    br ct_is_sse -> L_CHAT_STREAM_START, L_CHAT_NON_SSE_HEADER

L_CHAT_NON_SSE_DEFAULT:
    !ct_has_len
    !ct_ptr
    !ct_len
    chat_body_len_slot = stack_alloc 8
    chat_body_ptr_slot = stack_alloc 8
    chat_body_status = call @http_response_read_all(out_resp, &chat_body_ptr_slot, &chat_body_len_slot)
    chat_body_ptr = load chat_body_ptr_slot+0 as ptr
    chat_body_len = load chat_body_len_slot+0 as u64
    chat_resp_slot = stack_alloc 8
    chat_resp_status = call @sa_http_server_resp_new(req, up_status, &chat_resp_slot)
    chat_resp = load chat_resp_slot+0 as ptr
    chat_set_ct = call @sa_http_server_resp_set_content_type(chat_resp, &MIME_JSON, MIME_JSON_LEN)
    chat_send_back = call @sa_http_server_resp_send(chat_resp, &chat_body_ptr, chat_body_len)
    call @sa_http_server_resp_free(^chat_resp)
    call @sa_http_client_resp_free(^out_resp)
    call @sa_http_client_req_free(^out_req)
    call @sa_http_client_free(^client)
    !chat_body_status
    !chat_body_ptr
    !chat_body_len
    !chat_resp_status
    !chat_set_ct
    !chat_send_back
    !proxy_body_ptr
    !proxy_body_len
    !up_status
    !upstream_ptr
    !chat_base_ptr
    !chat_base_len
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    call @sa_http_server_req_free(^req)
    !state_ptr
    !cfg_ptr
    return 0

L_CHAT_NON_SSE_HEADER:
    !ct_is_sse
    !ct_idx
    chat_h_body_len_slot = stack_alloc 8
    chat_h_body_ptr_slot = stack_alloc 8
    chat_h_body_status = call @http_response_read_all(out_resp, &chat_h_body_ptr_slot, &chat_h_body_len_slot)
    chat_h_body_ptr = load chat_h_body_ptr_slot+0 as ptr
    chat_h_body_len = load chat_h_body_len_slot+0 as u64
    chat_h_resp_slot = stack_alloc 8
    chat_h_resp_status = call @sa_http_server_resp_new(req, up_status, &chat_h_resp_slot)
    chat_h_resp = load chat_h_resp_slot+0 as ptr
    chat_h_set_ct = call @sa_http_server_resp_set_content_type(chat_h_resp, &ct_ptr, ct_len)
    chat_h_send_back = call @sa_http_server_resp_send(chat_h_resp, &chat_h_body_ptr, chat_h_body_len)
    call @sa_http_server_resp_free(^chat_h_resp)
    call @sa_http_client_resp_free(^out_resp)
    call @sa_http_client_req_free(^out_req)
    call @sa_http_client_free(^client)
    !chat_h_body_status
    !chat_h_body_ptr
    !chat_h_body_len
    !chat_h_resp_status
    !chat_h_set_ct
    !chat_h_send_back
    !proxy_body_ptr
    !proxy_body_len
    !ct_ptr
    !ct_len
    !up_status
    !upstream_ptr
    !chat_base_ptr
    !chat_base_len
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    call @sa_http_server_req_free(^req)
    !state_ptr
    !cfg_ptr
    return 0

L_CHAT_STREAM_START:
    !ct_is_sse
    !ct_idx
    !ct_ptr
    !ct_len
    // Create streaming response back to client
    stream_slot = stack_alloc 8
    stream_status = call @sa_http_server_resp_stream_new(req, up_status, &stream_slot)
    stream = load stream_slot+0 as ptr
    !up_status

    // Get body reader for chunked reading
    reader_slot = stack_alloc 8
    reader_status = call @sa_http_client_resp_body_reader(out_resp, &reader_slot)
    reader = load reader_slot+0 as ptr

    // Allocate SSE buffer
    sse_buf = stack_alloc SSE_BUF_SIZE
    read_len_slot = stack_alloc 8

    // Token accumulator
    total_tokens_slot = stack_alloc 8
    store total_tokens_slot+0, 0 as u64

    call @sa_print_bytes(&LOG_STREAM, LOG_STREAM_LEN)

// Stream loop: read chunks from upstream, write to client
L_STREAM_LOOP:
    chunk_status = call @sa_http_client_resp_read_chunk(reader, &sse_buf, SSE_BUF_SIZE, &read_len_slot)
    chunk_len = load read_len_slot+0 as u64
    is_eos = eq chunk_len, 0
    br is_eos -> L_STREAM_END, L_STREAM_WRITE

L_STREAM_WRITE:
    !is_eos
    // Write chunk to client
    write_status = call @sa_http_server_resp_stream_write(stream, &sse_buf, chunk_len)
    flush_status = call @sa_http_server_resp_stream_flush(stream)
    !write_status
    !flush_status

    // --- Token metering: scan chunk for usage data ---
    chunk_tokens = call @scan_chunk_for_tokens(&sse_buf, chunk_len)
    has_tokens = ugt chunk_tokens, 0
    br has_tokens -> L_ACCUM_TOKENS, L_NO_ACCUM_TOKENS

L_ACCUM_TOKENS:
    !has_tokens
    cur_total = load total_tokens_slot+0 as u64
    new_total = add cur_total, chunk_tokens
    store total_tokens_slot+0, new_total as u64
    !new_total
    !cur_total
    !chunk_tokens
    jmp L_STREAM_NEXT

L_NO_ACCUM_TOKENS:
    !has_tokens
    !chunk_tokens
    jmp L_STREAM_NEXT

L_STREAM_NEXT:
    !chunk_len
    !chunk_status
    jmp L_STREAM_LOOP

L_STREAM_END:
    !is_eos
    !chunk_len
    !chunk_status

    // Log total tokens used
    final_tokens = load total_tokens_slot+0 as u64
    tok_used = ugt final_tokens, 0
    br tok_used -> L_LOG_TOKENS, L_SKIP_TOKENS

L_LOG_TOKENS:
    !tok_used
    call @sa_print_bytes(&LOG_TOK, LOG_TOK_LEN)
    // (In production, would write final_tokens to state here)
    !final_tokens
    jmp L_STREAM_DONE

L_SKIP_TOKENS:
    !tok_used
    !final_tokens
    jmp L_STREAM_DONE

L_STREAM_DONE:
    call @sa_print_bytes(&LOG_DONE, LOG_DONE_LEN)

    // End the chunked stream
    end_status = call @sa_http_server_resp_stream_end(stream)
    !end_status

    // Release all proxy handles
    call @sa_http_client_body_reader_free(^reader)
    call @sa_http_client_resp_free(^out_resp)
    call @sa_http_client_req_free(^out_req)
    call @sa_http_client_free(^client)
    call @sa_http_server_resp_stream_free(^stream)
    !proxy_body_ptr
    !proxy_body_len
    !upstream_ptr
    !chat_base_ptr
    !chat_base_len
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    call @sa_http_server_req_free(^req)
    !state_ptr
    !cfg_ptr
    return 0

// ============================================================
// /v1/responses — Reverse proxy with streaming
// ============================================================
L_PROXY_RESP:
    !is_resp_ok
    call @sa_print_bytes(&LOG_RESP, LOG_RESP_LEN)

    r_body_ptr_slot = stack_alloc 8
    r_body_len_slot = stack_alloc 8
    r_body_status = call @sa_http_server_req_get_body(req, &r_body_ptr_slot, &r_body_len_slot)
    r_body_ptr = load r_body_ptr_slot+0 as ptr
    r_body_len = load r_body_len_slot+0 as u64
    resp_log_status = call @write_api_request_log(&req, &cfg_ptr, &path_ptr, path_len, &method_ptr, method_len, &r_body_ptr, r_body_len)
    !resp_log_status
    resp_blank = call @body_is_blank(&r_body_ptr, r_body_len)
    resp_blank_ok = eq resp_blank, 1
    br resp_blank_ok -> L_RESP_EMPTY_BODY, L_RESP_BODY_OK

L_RESP_EMPTY_BODY:
    !resp_blank_ok
    !resp_blank
    resp_empty_send_status = call @send_empty_body_error_response(&req)
    !resp_empty_send_status
    !r_body_ptr
    !r_body_len
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    call @sa_http_server_req_free(^req)
    !state_ptr
    !cfg_ptr
    return 0

L_RESP_BODY_OK:
    !resp_blank_ok
    !resp_blank
    r_proxy_body_len_slot = stack_alloc 8
    r_is_gemini = call @body_is_gemini_responses_request(&r_body_ptr, r_body_len)
    r_proxy_pre_len_slot = stack_alloc 8
    r_proxy_pre_ptr = call @build_responses_proxy_body(&r_body_ptr, r_body_len, r_is_gemini, &r_proxy_pre_len_slot)
    r_proxy_pre_len = load r_proxy_pre_len_slot+0 as u64
    r_proxy_norm_ptr_slot = stack_alloc 8
    r_proxy_norm_len_slot = stack_alloc 8
    r_proxy_norm_status = call @sa_deno_plugin_responses_request_normalize(&r_proxy_pre_ptr, r_proxy_pre_len, &r_proxy_norm_ptr_slot, &r_proxy_norm_len_slot)
    r_proxy_norm_ptr = load r_proxy_norm_ptr_slot+0 as ptr
    r_proxy_norm_len = load r_proxy_norm_len_slot+0 as u64
    r_proxy_body_ptr = alloc r_proxy_norm_len
    r_proxy_copy_status = call @sa_bytes_copy(&r_proxy_body_ptr, &r_proxy_norm_ptr, r_proxy_norm_len)
    !r_proxy_copy_status
    store r_proxy_body_len_slot+0, r_proxy_norm_len as u64
    r_proxy_body_len = load r_proxy_body_len_slot+0 as u64
    r_proxy_norm_free = call @sa_deno_plugin_free_buffer(r_proxy_norm_ptr, r_proxy_norm_len)
    !r_proxy_norm_free
    !r_proxy_norm_ptr
    !r_proxy_norm_len
    !r_proxy_norm_status
    !r_proxy_pre_ptr
    !r_proxy_pre_len
    !r_is_gemini
    jmp L_RESP_HAVE_PROXY_BODY

L_RESP_HAVE_PROXY_BODY:

    r_fb_len_slot = stack_alloc 8
    r_base_ptr = load cfg_ptr+CFG_RBASE_PTR as ptr
    r_base_len = load cfg_ptr+CFG_RBASE_LEN as u64
    r_api_key_ptr = load cfg_ptr+CFG_KEY_PTR as ptr
    r_api_key_len = load cfg_ptr+CFG_KEY_LEN as u64
    r_up_auth_len_slot = stack_alloc 8
    r_up_auth_buf = call @build_bearer_auth_header(&r_api_key_ptr, r_api_key_len, &r_up_auth_len_slot)
    r_up_auth_len = load r_up_auth_len_slot+0 as u64
    r_has_base = ugt r_base_len, 0
    br r_has_base -> L_RESP_HAS_BASE_URL, L_RESP_NO_BASE_FALLBACK

L_RESP_NO_BASE_FALLBACK:
    !r_has_base
    r_nb_fb_model_ptr = load cfg_ptr+CFG_MODEL_PTR as ptr
    r_nb_fb_model_len = load cfg_ptr+CFG_MODEL_LEN as u64
    r_fb_body = call @build_chat_fallback_body(&r_body_ptr, r_body_len, &r_nb_fb_model_ptr, r_nb_fb_model_len, &r_fb_len_slot)
    r_fb_len = load r_fb_len_slot+0 as u64
    !r_nb_fb_model_ptr
    !r_nb_fb_model_len
    r_nb_fb_has_body = ugt r_fb_len, 0
    br r_nb_fb_has_body -> L_RESP_NO_BASE_CHAT_FB_SEND, L_RESP_NO_BASE_BAD_FALLBACK

L_RESP_NO_BASE_BAD_FALLBACK:
    !r_nb_fb_has_body
    !r_fb_body
    !r_fb_len
    r_nb_empty_status = call @send_empty_body_error_response(&req)
    !r_nb_empty_status
    !r_proxy_body_ptr
    !r_proxy_body_len
    !r_base_ptr
    !r_base_len
    !r_api_key_ptr
    !r_api_key_len
    !r_up_auth_len
    !r_body_ptr
    !r_body_len
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    call @sa_http_server_req_free(^req)
    !state_ptr
    !cfg_ptr
    return 0

L_RESP_NO_BASE_CHAT_FB_SEND:
    !r_nb_fb_has_body
    !r_base_ptr
    !r_base_len
    jmp L_RESP_CHAT_FB_SEND_PREP

L_RESP_HAS_BASE_URL:
    !r_has_base
    r_upstream_len_slot = stack_alloc 8
    r_upstream_ptr = call @build_proxy_url(&r_base_ptr, r_base_len, &UP_RESP_SUFFIX, UP_RESP_SUFFIX_LEN, &r_upstream_len_slot)
    r_upstream_len = load r_upstream_len_slot+0 as u64

    r_client_slot = stack_alloc 8
    r_client_status = call @sa_http_client_new(1, &r_client_slot)
    r_client = load r_client_slot+0 as ptr

    r_out_req_slot = stack_alloc 8
    r_out_status = call @sa_http_client_req_new(r_client, 2, &r_upstream_ptr, r_upstream_len, &r_out_req_slot)
    r_out_req = load r_out_req_slot+0 as ptr

    call @sa_http_client_req_add_header(r_out_req, &HDR_AUTH, HDR_AUTH_LEN, &r_up_auth_buf, r_up_auth_len)
    call @sa_http_client_req_add_header(r_out_req, &HDR_X_API_KEY, HDR_X_API_KEY_LEN, &r_api_key_ptr, r_api_key_len)
    call @sa_http_client_req_add_header(r_out_req, &HDR_CONTENT_TYPE, HDR_CONTENT_TYPE_LEN, &MIME_JSON, MIME_JSON_LEN)
    call @sa_http_client_req_set_body(r_out_req, &r_proxy_body_ptr, r_proxy_body_len)

    r_out_resp_slot = stack_alloc 8
    r_send_status = call @sa_http_client_req_send(r_out_req, &r_out_resp_slot)
    r_out_resp = load r_out_resp_slot+0 as ptr
    r_up_status = call @sa_http_client_resp_status(r_out_resp)

    r_status_500 = uge r_up_status, 500
    r_status_404 = eq r_up_status, 404
    r_status_405 = eq r_up_status, 405
    r_status_410 = eq r_up_status, 410
    r_status_415 = eq r_up_status, 415
    r_fb_eligible = or r_status_500, r_status_404
    r_fb_eligible = or r_fb_eligible, r_status_405
    r_fb_eligible = or r_fb_eligible, r_status_410
    r_fb_eligible = or r_fb_eligible, r_status_415
    !r_status_500
    !r_status_404
    !r_status_405
    !r_status_410
    !r_status_415
    br r_fb_eligible -> L_RESP_CHAT_FB_BUILD, L_RESP_ORIGINAL_START

L_RESP_CHAT_FB_BUILD:
    !r_fb_eligible
    r_unsafe_gemini_fb = call @body_is_unsafe_gemini_chat_fallback(&r_body_ptr, r_body_len)
    r_unsafe_gemini_fb_ok = eq r_unsafe_gemini_fb, 1
    br r_unsafe_gemini_fb_ok -> L_RESP_CHAT_FB_UNSAFE_GEMINI_ORIGINAL, L_RESP_CHAT_FB_SAFE_BUILD

L_RESP_CHAT_FB_UNSAFE_GEMINI_ORIGINAL:
    !r_unsafe_gemini_fb_ok
    !r_unsafe_gemini_fb
    r_unsafe_ct_ptr_slot = stack_alloc 8
    r_unsafe_ct_len_slot = stack_alloc 8
    store r_unsafe_ct_ptr_slot+0, 0 as ptr
    store r_unsafe_ct_len_slot+0, 0 as u64
    r_unsafe_ct_status = call @sa_http_client_resp_get_header(r_out_resp, &HDR_CONTENT_TYPE, HDR_CONTENT_TYPE_LEN, &r_unsafe_ct_ptr_slot, &r_unsafe_ct_len_slot)
    r_unsafe_ct_ptr = load r_unsafe_ct_ptr_slot+0 as ptr
    r_unsafe_ct_len = load r_unsafe_ct_len_slot+0 as u64
    !r_unsafe_ct_status
    r_unsafe_body_len_slot = stack_alloc 8
    r_unsafe_body_ptr_slot = stack_alloc 8
    r_unsafe_body_status = call @http_response_read_all(r_out_resp, &r_unsafe_body_ptr_slot, &r_unsafe_body_len_slot)
    r_unsafe_body_ptr = load r_unsafe_body_ptr_slot+0 as ptr
    r_unsafe_body_len = load r_unsafe_body_len_slot+0 as u64
    r_unsafe_resp_slot = stack_alloc 8
    r_unsafe_resp_status = call @sa_http_server_resp_new(req, r_up_status, &r_unsafe_resp_slot)
    r_unsafe_resp = load r_unsafe_resp_slot+0 as ptr
    r_unsafe_has_ct = ugt r_unsafe_ct_len, 0
    br r_unsafe_has_ct -> L_RESP_UNSAFE_ORIG_SET_CT, L_RESP_UNSAFE_ORIG_SET_DEFAULT_CT

L_RESP_UNSAFE_ORIG_SET_CT:
    !r_unsafe_has_ct
    r_unsafe_set_ct = call @sa_http_server_resp_set_content_type(r_unsafe_resp, &r_unsafe_ct_ptr, r_unsafe_ct_len)
    !r_unsafe_set_ct
    jmp L_RESP_UNSAFE_ORIG_SEND_BACK

L_RESP_UNSAFE_ORIG_SET_DEFAULT_CT:
    !r_unsafe_has_ct
    r_unsafe_set_default_ct = call @sa_http_server_resp_set_content_type(r_unsafe_resp, &MIME_JSON, MIME_JSON_LEN)
    !r_unsafe_set_default_ct
    jmp L_RESP_UNSAFE_ORIG_SEND_BACK

L_RESP_UNSAFE_ORIG_SEND_BACK:
    r_unsafe_send_back = call @sa_http_server_resp_send(r_unsafe_resp, &r_unsafe_body_ptr, r_unsafe_body_len)
    call @sa_http_server_resp_free(^r_unsafe_resp)
    call @sa_http_client_resp_free(^r_out_resp)
    call @sa_http_client_req_free(^r_out_req)
    call @sa_http_client_free(^r_client)
    !r_unsafe_send_back
    !r_unsafe_resp_status
    !r_unsafe_body_status
    !r_unsafe_body_ptr
    !r_unsafe_body_len
    !r_unsafe_ct_ptr
    !r_unsafe_ct_len
    !r_proxy_body_ptr
    !r_proxy_body_len
    !r_up_status
    !r_upstream_ptr
    !r_base_ptr
    !r_base_len
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    call @sa_http_server_req_free(^req)
    !state_ptr
    !cfg_ptr
    return 0

L_RESP_CHAT_FB_SAFE_BUILD:
    !r_unsafe_gemini_fb_ok
    !r_unsafe_gemini_fb
    r_fb_model_ptr = load cfg_ptr+CFG_MODEL_PTR as ptr
    r_fb_model_len = load cfg_ptr+CFG_MODEL_LEN as u64
    r_fb_body = call @build_chat_fallback_body(&r_body_ptr, r_body_len, &r_fb_model_ptr, r_fb_model_len, &r_fb_len_slot)
    r_fb_len = load r_fb_len_slot+0 as u64
    !r_fb_model_ptr
    !r_fb_model_len
    r_fb_has_body = ugt r_fb_len, 0
    br r_fb_has_body -> L_RESP_CHAT_FB_SEND, L_RESP_CHAT_FB_ORIGINAL

L_RESP_CHAT_FB_ORIGINAL:
    !r_fb_has_body
    !r_fb_body
    !r_fb_len
    r_orig_ct_ptr_slot = stack_alloc 8
    r_orig_ct_len_slot = stack_alloc 8
    store r_orig_ct_ptr_slot+0, 0 as ptr
    store r_orig_ct_len_slot+0, 0 as u64
    r_orig_ct_status = call @sa_http_client_resp_get_header(r_out_resp, &HDR_CONTENT_TYPE, HDR_CONTENT_TYPE_LEN, &r_orig_ct_ptr_slot, &r_orig_ct_len_slot)
    r_orig_ct_ptr = load r_orig_ct_ptr_slot+0 as ptr
    r_orig_ct_len = load r_orig_ct_len_slot+0 as u64
    !r_orig_ct_status
    r_orig_body_len_slot = stack_alloc 8
    r_orig_body_ptr_slot = stack_alloc 8
    r_orig_body_status = call @http_response_read_all(r_out_resp, &r_orig_body_ptr_slot, &r_orig_body_len_slot)
    r_orig_body_ptr = load r_orig_body_ptr_slot+0 as ptr
    r_orig_body_len = load r_orig_body_len_slot+0 as u64
    r_orig_resp_slot = stack_alloc 8
    r_orig_resp_status = call @sa_http_server_resp_new(req, r_up_status, &r_orig_resp_slot)
    r_orig_resp = load r_orig_resp_slot+0 as ptr
    r_orig_has_ct = ugt r_orig_ct_len, 0
    br r_orig_has_ct -> L_RESP_ORIG_SET_CT, L_RESP_ORIG_SET_DEFAULT_CT

L_RESP_ORIG_SET_CT:
    !r_orig_has_ct
    r_orig_set_ct = call @sa_http_server_resp_set_content_type(r_orig_resp, &r_orig_ct_ptr, r_orig_ct_len)
    !r_orig_set_ct
    jmp L_RESP_ORIG_SEND_BACK

L_RESP_ORIG_SET_DEFAULT_CT:
    !r_orig_has_ct
    r_orig_set_default_ct = call @sa_http_server_resp_set_content_type(r_orig_resp, &MIME_JSON, MIME_JSON_LEN)
    !r_orig_set_default_ct
    jmp L_RESP_ORIG_SEND_BACK

L_RESP_ORIG_SEND_BACK:
    r_orig_send_back = call @sa_http_server_resp_send(r_orig_resp, &r_orig_body_ptr, r_orig_body_len)
    call @sa_http_server_resp_free(^r_orig_resp)
    call @sa_http_client_resp_free(^r_out_resp)
    call @sa_http_client_req_free(^r_out_req)
    call @sa_http_client_free(^r_client)
    !r_orig_send_back
    !r_orig_resp_status
    !r_orig_body_status
    !r_orig_body_ptr
    !r_orig_body_len
    !r_orig_ct_ptr
    !r_orig_ct_len
    !r_proxy_body_ptr
    !r_proxy_body_len
    !r_up_status
    !r_upstream_ptr
    !r_base_ptr
    !r_base_len
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    call @sa_http_server_req_free(^req)
    !state_ptr
    !cfg_ptr
    return 0

L_RESP_CHAT_FB_SEND:
    !r_fb_has_body
    call @sa_http_client_resp_free(^r_out_resp)
    call @sa_http_client_req_free(^r_out_req)
    call @sa_http_client_free(^r_client)
    !r_up_status
    !r_upstream_ptr
    !r_base_ptr
    !r_base_len
    jmp L_RESP_CHAT_FB_SEND_PREP

L_RESP_CHAT_FB_SEND_PREP:
    r_fb_chat_base_ptr = load cfg_ptr+CFG_CHAT_PTR as ptr
    r_fb_chat_base_len = load cfg_ptr+CFG_CHAT_LEN as u64
    r_fb_url_len_slot = stack_alloc 8
    r_fb_chat_url = call @build_proxy_url(&r_fb_chat_base_ptr, r_fb_chat_base_len, &UP_CHAT_SUFFIX, UP_CHAT_SUFFIX_LEN, &r_fb_url_len_slot)
    r_fb_chat_url_len = load r_fb_url_len_slot+0 as u64

    r_fb_client_slot = stack_alloc 8
    r_fb_client_status = call @sa_http_client_new(1, &r_fb_client_slot)
    r_fb_client = load r_fb_client_slot+0 as ptr
    r_fb_req_slot = stack_alloc 8
    r_fb_req_status = call @sa_http_client_req_new(r_fb_client, 2, &r_fb_chat_url, r_fb_chat_url_len, &r_fb_req_slot)
    r_fb_req = load r_fb_req_slot+0 as ptr
    call @sa_http_client_req_add_header(r_fb_req, &HDR_AUTH, HDR_AUTH_LEN, &r_up_auth_buf, r_up_auth_len)
    call @sa_http_client_req_add_header(r_fb_req, &HDR_X_API_KEY, HDR_X_API_KEY_LEN, &r_api_key_ptr, r_api_key_len)
    call @sa_http_client_req_add_header(r_fb_req, &HDR_CONTENT_TYPE, HDR_CONTENT_TYPE_LEN, &MIME_JSON, MIME_JSON_LEN)
    call @sa_http_client_req_set_body(r_fb_req, &r_fb_body, r_fb_len)
    r_fb_resp_slot = stack_alloc 8
    r_fb_send_status = call @sa_http_client_req_send(r_fb_req, &r_fb_resp_slot)
    r_fb_resp = load r_fb_resp_slot+0 as ptr
    r_fb_status = call @sa_http_client_resp_status(r_fb_resp)
    r_fb_ct_ptr_slot = stack_alloc 8
    r_fb_ct_len_slot = stack_alloc 8
    store r_fb_ct_ptr_slot+0, 0 as ptr
    store r_fb_ct_len_slot+0, 0 as u64
    r_fb_ct_status = call @sa_http_client_resp_get_header(r_fb_resp, &HDR_CONTENT_TYPE, HDR_CONTENT_TYPE_LEN, &r_fb_ct_ptr_slot, &r_fb_ct_len_slot)
    r_fb_ct_ptr = load r_fb_ct_ptr_slot+0 as ptr
    r_fb_ct_len = load r_fb_ct_len_slot+0 as u64
    !r_fb_ct_status
    r_fb_body_len_slot = stack_alloc 8
    r_fb_body_ptr_slot = stack_alloc 8
    r_fb_body_status = call @http_response_read_all(r_fb_resp, &r_fb_body_ptr_slot, &r_fb_body_len_slot)
    r_fb_body_ptr = load r_fb_body_ptr_slot+0 as ptr
    r_fb_body_len = load r_fb_body_len_slot+0 as u64
    r_fb_out_slot = stack_alloc 8
    r_fb_out_status = call @sa_http_server_resp_new(req, r_fb_status, &r_fb_out_slot)
    r_fb_out = load r_fb_out_slot+0 as ptr
    r_fb_ct_has_len = ugt r_fb_ct_len, 0
    br r_fb_ct_has_len -> L_RESP_CHAT_FB_SET_HEADER_CT, L_RESP_CHAT_FB_SET_DEFAULT_CT

L_RESP_CHAT_FB_SET_HEADER_CT:
    !r_fb_ct_has_len
    r_fb_set_ct = call @sa_http_server_resp_set_content_type(r_fb_out, &r_fb_ct_ptr, r_fb_ct_len)
    r_fb_sse_idx = call @sa_bytes_find(&r_fb_ct_ptr, r_fb_ct_len, &MIME_EVENT_STREAM, MIME_EVENT_STREAM_LEN)
    r_fb_is_sse = sge r_fb_sse_idx, 0
    br r_fb_is_sse -> L_RESP_CHAT_FB_SEND_SSE_BACK, L_RESP_CHAT_FB_SEND_BACK_HEADER

L_RESP_CHAT_FB_SET_DEFAULT_CT:
    !r_fb_ct_has_len
    r_fb_set_default_ct = call @sa_http_server_resp_set_content_type(r_fb_out, &MIME_JSON, MIME_JSON_LEN)
    !r_fb_set_default_ct
    jmp L_RESP_CHAT_FB_SEND_BACK

L_RESP_CHAT_FB_SEND_BACK_HEADER:
    !r_fb_is_sse
    !r_fb_sse_idx
    !r_fb_set_ct
    jmp L_RESP_CHAT_FB_SEND_BACK

L_RESP_CHAT_FB_SEND_SSE_BACK:
    !r_fb_is_sse
    !r_fb_sse_idx
    !r_fb_set_ct
    r_fb_sse_len_slot = stack_alloc 8
    r_fb_ctx_len_slot = stack_alloc 8
    r_fb_ctx_body = call @build_response_request_context_body(&req, &state_ptr, &r_body_ptr, r_body_len, &r_fb_ctx_len_slot)
    r_fb_ctx_len = load r_fb_ctx_len_slot+0 as u64
    r_fb_sse_body = call @chat_fallback_sse_to_responses_body(&r_fb_body_ptr, r_fb_body_len, &r_fb_ctx_body, r_fb_ctx_len, &r_fb_sse_len_slot)
    r_fb_sse_len = load r_fb_sse_len_slot+0 as u64
    r_fb_sse_send_back = call @sa_http_server_resp_send(r_fb_out, &r_fb_sse_body, r_fb_sse_len)
    call @sa_http_server_resp_free(^r_fb_out)
    call @sa_http_client_resp_free(^r_fb_resp)
    call @sa_http_client_req_free(^r_fb_req)
    call @sa_http_client_free(^r_fb_client)
    !r_fb_sse_send_back
    !r_fb_sse_body
    !r_fb_sse_len
    !r_fb_ctx_body
    !r_fb_ctx_len
    !r_fb_out_status
    !r_fb_body_status
    !r_fb_body_ptr
    !r_fb_body_len
    !r_fb_status
    !r_fb_send_status
    !r_fb_req_status
    !r_fb_client_status
    !r_fb_ct_ptr
    !r_fb_ct_len
    !r_fb_chat_url
    !r_fb_chat_base_ptr
    !r_fb_chat_base_len
    !r_fb_body
    !r_fb_len
    !r_proxy_body_ptr
    !r_proxy_body_len
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    call @sa_http_server_req_free(^req)
    !state_ptr
    !cfg_ptr
    return 0

L_RESP_CHAT_FB_SEND_BACK:
    r_fb_json_norm_len_slot = stack_alloc 8
    r_fb_json_ctx_len_slot = stack_alloc 8
    r_fb_json_ctx_body = call @build_response_request_context_body(&req, &state_ptr, &r_body_ptr, r_body_len, &r_fb_json_ctx_len_slot)
    r_fb_json_ctx_len = load r_fb_json_ctx_len_slot+0 as u64
    r_fb_json_norm_body = call @normalize_chat_fallback_json_body(&r_fb_body_ptr, r_fb_body_len, &r_fb_json_ctx_body, r_fb_json_ctx_len, &r_fb_json_norm_len_slot)
    r_fb_json_norm_len = load r_fb_json_norm_len_slot+0 as u64
    r_fb_send_back = call @sa_http_server_resp_send(r_fb_out, &r_fb_json_norm_body, r_fb_json_norm_len)
    call @sa_http_server_resp_free(^r_fb_out)
    call @sa_http_client_resp_free(^r_fb_resp)
    call @sa_http_client_req_free(^r_fb_req)
    call @sa_http_client_free(^r_fb_client)
    !r_fb_send_back
    !r_fb_out_status
    !r_fb_body_status
    !r_fb_body_ptr
    !r_fb_body_len
    !r_fb_json_norm_body
    !r_fb_json_norm_len
    !r_fb_json_ctx_body
    !r_fb_json_ctx_len
    !r_fb_status
    !r_fb_send_status
    !r_fb_req_status
    !r_fb_client_status
    !r_fb_ct_ptr
    !r_fb_ct_len
    !r_fb_chat_url
    !r_fb_chat_base_ptr
    !r_fb_chat_base_len
    !r_fb_body
    !r_fb_len
    !r_proxy_body_ptr
    !r_proxy_body_len
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    call @sa_http_server_req_free(^req)
    !state_ptr
    !cfg_ptr
    return 0

L_RESP_ORIGINAL_START:
    !r_fb_eligible
    r_ct_ptr_slot = stack_alloc 8
    r_ct_len_slot = stack_alloc 8
    store r_ct_ptr_slot+0, 0 as ptr
    store r_ct_len_slot+0, 0 as u64
    r_ct_status = call @sa_http_client_resp_get_header(r_out_resp, &HDR_CONTENT_TYPE, HDR_CONTENT_TYPE_LEN, &r_ct_ptr_slot, &r_ct_len_slot)
    r_ct_ptr = load r_ct_ptr_slot+0 as ptr
    r_ct_len = load r_ct_len_slot+0 as u64
    !r_ct_status
    r_ct_has_len = ugt r_ct_len, 0
    br r_ct_has_len -> L_RESP_CT_FIND, L_RESP_NON_SSE_DEFAULT

L_RESP_CT_FIND:
    !r_ct_has_len
    r_ct_idx = call @sa_bytes_find(&r_ct_ptr, r_ct_len, &MIME_EVENT_STREAM, MIME_EVENT_STREAM_LEN)
    r_ct_is_sse = sge r_ct_idx, 0
    br r_ct_is_sse -> L_RESP_STREAM_START, L_RESP_NON_SSE_HEADER

L_RESP_NON_SSE_DEFAULT:
    !r_ct_has_len
    !r_ct_ptr
    !r_ct_len
    r_plain_body_len_slot = stack_alloc 8
    r_plain_body_ptr_slot = stack_alloc 8
    r_plain_body_status = call @http_response_read_all(r_out_resp, &r_plain_body_ptr_slot, &r_plain_body_len_slot)
    r_plain_body_ptr = load r_plain_body_ptr_slot+0 as ptr
    r_plain_body_len = load r_plain_body_len_slot+0 as u64
    r_plain_norm_len_slot = stack_alloc 8
    r_plain_norm_body = call @normalize_responses_client_json_body(&r_plain_body_ptr, r_plain_body_len, &r_plain_norm_len_slot)
    r_plain_norm_len = load r_plain_norm_len_slot+0 as u64
    r_plain_resp_slot = stack_alloc 8
    r_plain_resp_status = call @sa_http_server_resp_new(req, r_up_status, &r_plain_resp_slot)
    r_plain_resp = load r_plain_resp_slot+0 as ptr
    r_plain_set_ct = call @sa_http_server_resp_set_content_type(r_plain_resp, &MIME_JSON, MIME_JSON_LEN)
    r_plain_send_back = call @sa_http_server_resp_send(r_plain_resp, &r_plain_norm_body, r_plain_norm_len)
    call @sa_http_server_resp_free(^r_plain_resp)
    call @sa_http_client_resp_free(^r_out_resp)
    call @sa_http_client_req_free(^r_out_req)
    call @sa_http_client_free(^r_client)
    !r_plain_body_status
    !r_plain_body_ptr
    !r_plain_body_len
    !r_plain_norm_body
    !r_plain_norm_len
    !r_plain_resp_status
    !r_plain_set_ct
    !r_plain_send_back
    !r_proxy_body_ptr
    !r_proxy_body_len
    !r_up_status
    !r_upstream_ptr
    !r_base_ptr
    !r_base_len
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    call @sa_http_server_req_free(^req)
    !state_ptr
    !cfg_ptr
    return 0

L_RESP_NON_SSE_HEADER:
    !r_ct_is_sse
    !r_ct_idx
    r_h_body_len_slot = stack_alloc 8
    r_h_body_ptr_slot = stack_alloc 8
    r_h_body_status = call @http_response_read_all(r_out_resp, &r_h_body_ptr_slot, &r_h_body_len_slot)
    r_h_body_ptr = load r_h_body_ptr_slot+0 as ptr
    r_h_body_len = load r_h_body_len_slot+0 as u64
    r_h_norm_len_slot = stack_alloc 8
    r_h_norm_body = call @normalize_responses_client_json_body(&r_h_body_ptr, r_h_body_len, &r_h_norm_len_slot)
    r_h_norm_len = load r_h_norm_len_slot+0 as u64
    r_h_resp_slot = stack_alloc 8
    r_h_resp_status = call @sa_http_server_resp_new(req, r_up_status, &r_h_resp_slot)
    r_h_resp = load r_h_resp_slot+0 as ptr
    r_h_set_ct = call @sa_http_server_resp_set_content_type(r_h_resp, &r_ct_ptr, r_ct_len)
    r_h_send_back = call @sa_http_server_resp_send(r_h_resp, &r_h_norm_body, r_h_norm_len)
    call @sa_http_server_resp_free(^r_h_resp)
    call @sa_http_client_resp_free(^r_out_resp)
    call @sa_http_client_req_free(^r_out_req)
    call @sa_http_client_free(^r_client)
    !r_h_body_status
    !r_h_body_ptr
    !r_h_body_len
    !r_h_norm_body
    !r_h_norm_len
    !r_h_resp_status
    !r_h_set_ct
    !r_h_send_back
    !r_ct_ptr
    !r_ct_len
    !r_proxy_body_ptr
    !r_proxy_body_len
    !r_up_status
    !r_upstream_ptr
    !r_base_ptr
    !r_base_len
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    call @sa_http_server_req_free(^req)
    !state_ptr
    !cfg_ptr
    return 0

L_RESP_STREAM_START:
    !r_ct_is_sse
    !r_ct_idx
    !r_ct_ptr
    !r_ct_len
    r_stream_slot = stack_alloc 8
    r_stream_status = call @sa_http_server_resp_stream_new(req, r_up_status, &r_stream_slot)
    r_stream = load r_stream_slot+0 as ptr
    !r_up_status

    r_sse_body_len_slot = stack_alloc 8
    r_sse_body_ptr_slot = stack_alloc 8
    r_sse_body_status = call @http_response_read_all(r_out_resp, &r_sse_body_ptr_slot, &r_sse_body_len_slot)
    r_sse_body_ptr = load r_sse_body_ptr_slot+0 as ptr
    r_sse_body_len = load r_sse_body_len_slot+0 as u64
    r_norm_len_slot = stack_alloc 8
    r_ctx_len_slot = stack_alloc 8
    r_ctx_body = call @build_response_request_context_body(&req, &state_ptr, &r_body_ptr, r_body_len, &r_ctx_len_slot)
    r_ctx_len = load r_ctx_len_slot+0 as u64
    r_norm_body = call @normalize_responses_client_sse_body(&r_sse_body_ptr, r_sse_body_len, &r_ctx_body, r_ctx_len, &r_norm_len_slot)
    r_norm_len = load r_norm_len_slot+0 as u64
    r_write_status = call @sa_http_server_resp_stream_write(r_stream, &r_norm_body, r_norm_len)
    r_flush_status = call @sa_http_server_resp_stream_flush(r_stream)
    !r_write_status
    !r_flush_status
    r_end_status = call @sa_http_server_resp_stream_end(r_stream)
    !r_end_status
    call @sa_http_client_resp_free(^r_out_resp)
    call @sa_http_client_req_free(^r_out_req)
    call @sa_http_client_free(^r_client)
    call @sa_http_server_resp_stream_free(^r_stream)
    !r_norm_body
    !r_norm_len
    !r_ctx_body
    !r_ctx_len
    !r_sse_body_status
    !r_sse_body_ptr
    !r_sse_body_len
    !r_proxy_body_ptr
    !r_proxy_body_len
    !r_upstream_ptr
    !r_base_ptr
    !r_base_len
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    call @sa_http_server_req_free(^req)
    !state_ptr
    !cfg_ptr
    return 0

// ============================================================
// /v1/models — Proxy to upstream models endpoint
// ============================================================
L_PROXY_MODELS:
    !is_models_ok
    call @sa_print_bytes(&LOG_MODELS, LOG_MODELS_LEN)
    models_empty_body = stack_alloc 1
    models_log_status = call @write_api_request_log(&req, &cfg_ptr, &path_ptr, path_len, &method_ptr, method_len, &models_empty_body, 0)
    !models_log_status

    m_chat_base_ptr = load cfg_ptr+CFG_CHAT_PTR as ptr
    m_chat_base_len = load cfg_ptr+CFG_CHAT_LEN as u64
    m_url_len_slot = stack_alloc 8
    m_chat_ptr = call @build_proxy_url(&m_chat_base_ptr, m_chat_base_len, &UP_MODELS_SUFFIX, UP_MODELS_SUFFIX_LEN, &m_url_len_slot)
    m_chat_len = load m_url_len_slot+0 as u64
    m_api_key_ptr = load cfg_ptr+CFG_KEY_PTR as ptr
    m_api_key_len = load cfg_ptr+CFG_KEY_LEN as u64
    m_up_auth_len_slot = stack_alloc 8
    m_up_auth_buf = call @build_bearer_auth_header(&m_api_key_ptr, m_api_key_len, &m_up_auth_len_slot)
    m_up_auth_len = load m_up_auth_len_slot+0 as u64

    m_client_slot = stack_alloc 8
    m_client_status = call @sa_http_client_new(1, &m_client_slot)
    m_client = load m_client_slot+0 as ptr

    m_req_slot = stack_alloc 8
    m_req_status = call @sa_http_client_req_new(m_client, 1, &m_chat_ptr, m_chat_len, &m_req_slot)
    m_req = load m_req_slot+0 as ptr

    call @sa_http_client_req_add_header(m_req, &HDR_AUTH, HDR_AUTH_LEN, &m_up_auth_buf, m_up_auth_len)
    call @sa_http_client_req_add_header(m_req, &HDR_X_API_KEY, HDR_X_API_KEY_LEN, &m_api_key_ptr, m_api_key_len)

    m_resp_slot = stack_alloc 8
    m_send_status = call @sa_http_client_req_send(m_req, &m_resp_slot)
    m_resp = load m_resp_slot+0 as ptr

    m_status = call @sa_http_client_resp_status(m_resp)
    m_ct_ptr_slot = stack_alloc 8
    m_ct_len_slot = stack_alloc 8
    store m_ct_ptr_slot+0, 0 as ptr
    store m_ct_len_slot+0, 0 as u64
    m_ct_status = call @sa_http_client_resp_get_header(m_resp, &HDR_CONTENT_TYPE, HDR_CONTENT_TYPE_LEN, &m_ct_ptr_slot, &m_ct_len_slot)
    m_ct_ptr = load m_ct_ptr_slot+0 as ptr
    m_ct_len = load m_ct_len_slot+0 as u64
    !m_ct_status
    m_body_len_slot = stack_alloc 8
    m_body_ptr_slot = stack_alloc 8
    m_body_status = call @http_response_read_all(m_resp, &m_body_ptr_slot, &m_body_len_slot)
    m_body_ptr = load m_body_ptr_slot+0 as ptr
    m_body_len = load m_body_len_slot+0 as u64

    m_out_resp_slot = stack_alloc 8
    m_out_status = call @sa_http_server_resp_new(req, m_status, &m_out_resp_slot)
    m_out_resp = load m_out_resp_slot+0 as ptr
    m_ct_has_len = ugt m_ct_len, 0
    br m_ct_has_len -> L_MODELS_SEND_HEADER_CT, L_MODELS_SEND_DEFAULT_CT

L_MODELS_SEND_HEADER_CT:
    !m_ct_has_len
    m_set_ct = call @sa_http_server_resp_set_content_type(m_out_resp, &m_ct_ptr, m_ct_len)
    !m_set_ct
    jmp L_MODELS_SEND_BODY

L_MODELS_SEND_DEFAULT_CT:
    !m_ct_has_len
    m_set_default_ct = call @sa_http_server_resp_set_content_type(m_out_resp, &MIME_JSON, MIME_JSON_LEN)
    !m_set_default_ct
    jmp L_MODELS_SEND_BODY

L_MODELS_SEND_BODY:
    m_send_back = call @sa_http_server_resp_send(m_out_resp, &m_body_ptr, m_body_len)
    !m_send_back
    !m_out_status
    !m_body_status
    !m_body_ptr
    !m_body_len
    !m_ct_ptr
    !m_ct_len

    call @sa_http_server_resp_free(^m_out_resp)
    call @sa_http_client_resp_free(^m_resp)
    call @sa_http_client_req_free(^m_req)
    call @sa_http_client_free(^m_client)
    !m_chat_ptr
    !m_chat_base_ptr
    !m_chat_base_len
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    call @sa_http_server_req_free(^req)
    !state_ptr
    !cfg_ptr
    return 0

// ============================================================
// /rpc — JSON-RPC dispatch (20+ methods)
// ============================================================
L_HANDLE_RPC:
    !is_rpc_ok
    call @sa_print_bytes(&LOG_RPC, LOG_RPC_LEN)

    rpc_raw_ptr_slot = stack_alloc 8
    rpc_raw_len_slot = stack_alloc 8
    rpc_body_ptr_slot = stack_alloc 8
    rpc_body_len_slot = stack_alloc 8
    rpc_canon_buffer_slot = stack_alloc 8
    rpc_body_status = call @sa_http_server_req_get_body(req, &rpc_raw_ptr_slot, &rpc_raw_len_slot)
    rpc_raw_ptr = load rpc_raw_ptr_slot+0 as ptr
    rpc_raw_len = load rpc_raw_len_slot+0 as u64
    rpc_log_status = call @write_api_request_log(&req, &cfg_ptr, &path_ptr, path_len, &method_ptr, method_len, &rpc_raw_ptr, rpc_raw_len)
    !rpc_log_status
    rpc_canon_status = call @rpc_canonicalize_body(&rpc_raw_ptr, rpc_raw_len, &rpc_body_ptr_slot, &rpc_body_len_slot, &rpc_canon_buffer_slot)
    !rpc_canon_status
    rpc_body_ptr = load rpc_body_ptr_slot+0 as ptr
    rpc_body_len = load rpc_body_len_slot+0 as u64

    rpc_dispatch_status = call @handle_rpc_request(&req, &rpc_body_ptr, rpc_body_len, &state_ptr, &cfg_ptr)
    !rpc_dispatch_status
    rpc_canon_buffer = load rpc_canon_buffer_slot+0 as ptr
    has_rpc_canon_buffer = ne rpc_canon_buffer, 0
    br has_rpc_canon_buffer -> L_RPC_FREE_CANON_BODY, L_RPC_NO_CANON_BODY

L_RPC_FREE_CANON_BODY:
    !has_rpc_canon_buffer
    rpc_canon_free = call @sa_json_buffer_free(^rpc_canon_buffer)
    !rpc_canon_free
    jmp L_RPC_AFTER_CANON_BODY

L_RPC_NO_CANON_BODY:
    !has_rpc_canon_buffer
    !rpc_canon_buffer
    jmp L_RPC_AFTER_CANON_BODY

L_RPC_AFTER_CANON_BODY:
    !rpc_body_status
    !rpc_raw_ptr
    !rpc_raw_len
    !rpc_body_ptr
    !rpc_body_len
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    call @sa_http_server_req_free(^req)
    !state_ptr
    !cfg_ptr
    return 0

// ============================================================
// /events — SSE notification stream
// ============================================================
L_HANDLE_EVENTS:
    !is_events_ok
    call @sa_print_bytes(&LOG_EVENTS, LOG_EVENTS_LEN)

    ev_ctx = alloc EVENT_CTX_SIZE
    store ev_ctx+EVENT_CTX_REQ, req as ptr
    store ev_ctx+EVENT_CTX_STATE, state_ptr as ptr
    ev_spawn_status = call @spawn_event_stream(^ev_ctx)
    !ev_spawn_status
    !req
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    !state_ptr
    !cfg_ptr
    return 0

// ============================================================
// 404 Not Found
// ============================================================
L_NOT_FOUND:
    !is_events_ok
    nf_send = call @send_json_error_string_response(&req, 404, &JSON_VALUE_NOT_FOUND, JSON_VALUE_NOT_FOUND_LEN)
    !nf_send
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    call @sa_http_server_req_free(^req)
    !state_ptr
    !cfg_ptr
    return 0

@main() -> i32!:
L_ENTRY:
    call @sa_print_bytes(&LOG_INIT, LOG_INIT_LEN)

    // Phase 1: Load config from .env
    cfg_ptr = alloc CFG_SIZE
    cfg_status = call @cfg_load(&ENV_PATH, ENV_PATH_LEN, &cfg_ptr)
    cfg_ok = eq cfg_status, 0
    br cfg_ok -> L_CFG_OK_PRIMARY, L_CFG_TRY_CWD_ENV

L_CFG_TRY_CWD_ENV:
    !cfg_ok
    !cfg_status
    cfg_status2 = call @cfg_load(&ENV_PATH_CWD, ENV_PATH_CWD_LEN, &cfg_ptr)
    cfg_ok2 = eq cfg_status2, 0
    br cfg_ok2 -> L_CFG_OK_FROM_CWD, L_CFG_FAIL

L_CFG_OK_FROM_CWD:
    !cfg_ok2
    !cfg_status2
    jmp L_CFG_OK

L_CFG_FAIL:
    !cfg_ok2
    !cfg_status2
    !cfg_ptr
    return 1

L_CFG_OK_PRIMARY:
    !cfg_ok
    !cfg_status
    jmp L_CFG_OK

L_CFG_OK:
    // Ensure data directory exists
    data_dir_ptr = load cfg_ptr+CFG_DIR_PTR as ptr
    data_dir_len = load cfg_ptr+CFG_DIR_LEN as u64
    EXPAND DENO_MKDIR dir_status, data_dir_ptr, data_dir_len, 1
    !dir_status

    // Phase 2: Initialize state
    state_ptr = alloc ST_TOTAL
    st_status = call @state_init(&state_ptr)
    !st_status

    // Phase 3: Start HTTP server
    port = call @cfg_get_port(&cfg_ptr)
    host_ptr_slot = stack_alloc 8
    host_len_slot = stack_alloc 8
    call @cfg_get_host(&cfg_ptr, &host_ptr_slot, &host_len_slot)
    host_ptr = load host_ptr_slot+0 as ptr
    host_len = load host_len_slot+0 as u64

    server_slot = stack_alloc 8
    srv_status = call @sa_http_server_new(&server_slot)
    server = load server_slot+0 as ptr

    start_status = call @sa_http_server_start(server, &host_ptr, host_len, port)
    !start_status
    !srv_status

    // Print listen address
    call @sa_print_bytes(&LOG_LISTEN, LOG_LISTEN_LEN)
    call @sa_print_bytes(&host_ptr, host_len)
    call @sa_print_bytes(&LISTEN_SUFFIX, LISTEN_SUFFIX_LEN)
    !host_ptr
    !host_len

    // Allocate request handling slot
    req_slot = stack_alloc 8

// ============================================================
// Main HTTP accept loop
// ============================================================
L_HTTP_LOOP:
    loop_status = call @accept_and_handle_http_request(server, &req_slot, &state_ptr, &cfg_ptr)
    !loop_status
    jmp L_HTTP_LOOP

L_EXIT:
    return 0

@import "sa_http_server.sai"
@import "sa_http_client.sai"
@import "src/strings.sa"
