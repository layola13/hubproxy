    name_status = call @json_writer_field_param_string_or_default(writer, &JSON_KEY_PLUGIN_NAME, JSON_KEY_PLUGIN_NAME_LEN, &body, body_len, &J_PLUGIN_NAME_KEY, J_PLUGIN_NAME_KEY_LEN, &EMPTY_TEXT, EMPTY_TEXT_LEN, 0)
