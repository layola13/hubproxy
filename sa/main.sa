    !prefix_status
    !begin_status
    !writer_status
    !model_ptr
    !model_len
    !dir_ptr
    !dir_len
    !provider_ptr
    !provider_len
    !ephemeral
    !preview_ptr
    !preview_len
    !name_ptr
    !name_len
    !name_set
    !forked_from_id
    !body
    !body_len
    !slot
    !thread_id
    !state_ptr
    !req
    return 0

L_RESUME_NOT_FOUND:
    !missing
    !slot
    !body
