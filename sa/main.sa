@ffi_wrapper send_rpc_marketplace_upgrade(&req: ptr, &id_ptr: ptr, id_len: u64, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    name_ptr_slot = stack_alloc 8
    name_len_slot = stack_alloc 8
    status = call @rpc_extract_string_after(&body, body_len, &J_MARKETPLACE_NAME_KEY, J_MARKETPLACE_NAME_KEY_LEN, &name_ptr_slot, &name_len_slot)
    has_name = eq status, 1
    br has_name -> L_UPGRADE_WITH_NAME, L_UPGRADE_EMPTY

L_UPGRADE_WITH_NAME:
    !has_name
    name_ptr = load name_ptr_slot+0 as ptr
    name_len = load name_len_slot+0 as u64
    writer_slot = stack_alloc 8
    writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot)
    writer = load writer_slot+0 as ptr
    begin_status = call @sa_json_writer_begin_object(writer)
    errors_status = call @json_writer_field_empty_array(writer, &JSON_KEY_ERRORS, JSON_KEY_ERRORS_LEN)
    selected_field_status = call @sa_json_writer_object_field(writer, &JSON_KEY_SELECTED_MARKETPLACES, JSON_KEY_SELECTED_MARKETPLACES_LEN)
    selected_begin_status = call @sa_json_writer_begin_array(writer)
    selected_name_status = call @sa_json_writer_write_string(writer, &name_ptr, name_len)
    selected_end_status = call @sa_json_writer_end_array(writer)
    upgraded_status = call @json_writer_field_empty_array(writer, &JSON_KEY_UPGRADED_ROOTS, JSON_KEY_UPGRADED_ROOTS_LEN)
    end_status = call @sa_json_writer_end_object(writer)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !end_status
    !upgraded_status
    !selected_end_status
    !selected_name_status
    !selected_begin_status
    !selected_field_status
    !errors_status
    !begin_status
    !writer_status
    !name_ptr
    !name_len
    !status
    !body
    !body_len
    !req
    return 0

L_UPGRADE_EMPTY:
    !has_name
    writer_slot_empty = stack_alloc 8
    writer_status_empty = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot_empty)
    writer_empty = load writer_slot_empty+0 as ptr
    begin_status_empty = call @sa_json_writer_begin_object(writer_empty)
    errors_status_empty = call @json_writer_field_empty_array(writer_empty, &JSON_KEY_ERRORS, JSON_KEY_ERRORS_LEN)
    selected_status_empty = call @json_writer_field_empty_array(writer_empty, &JSON_KEY_SELECTED_MARKETPLACES, JSON_KEY_SELECTED_MARKETPLACES_LEN)
    upgraded_status_empty = call @json_writer_field_empty_array(writer_empty, &JSON_KEY_UPGRADED_ROOTS, JSON_KEY_UPGRADED_ROOTS_LEN)
    end_status_empty = call @sa_json_writer_end_object(writer_empty)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer_empty)
    !end_status_empty
    !upgraded_status_empty
    !selected_status_empty
    !errors_status_empty
    !begin_status_empty
    !writer_status_empty
    !status
    !body
    !body_len
    !req
    return 0

