@ffi_wrapper send_rpc_config_read(&req: ptr, &id_ptr: ptr, id_len: u64, &cfg_ptr: ptr) -> u32:
L_ENTRY:
    host_ptr = load cfg_ptr+CFG_HOST_PTR as ptr
    host_len = load cfg_ptr+CFG_HOST_LEN as u64
    port = load cfg_ptr+CFG_PORT as u16
    port_u64 = zext port
    rbase_ptr = load cfg_ptr+CFG_RBASE_PTR as ptr
    rbase_len = load cfg_ptr+CFG_RBASE_LEN as u64
    chat_ptr = load cfg_ptr+CFG_CHAT_PTR as ptr
    chat_len = load cfg_ptr+CFG_CHAT_LEN as u64
    model_ptr = load cfg_ptr+CFG_MODEL_PTR as ptr
    model_len = load cfg_ptr+CFG_MODEL_LEN as u64
    auth_ptr = load cfg_ptr+CFG_AUTH_PTR as ptr
    auth_len = load cfg_ptr+CFG_AUTH_LEN as u64
    writer_slot = stack_alloc 8
    writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot)
    writer = load writer_slot+0 as ptr
    begin_status = call @sa_json_writer_begin_object(writer)
    config_field_status = call @sa_json_writer_object_field(writer, &JSON_KEY_CONFIG, JSON_KEY_CONFIG_LEN)
    config_begin_status = call @sa_json_writer_begin_object(writer)
    host_field_status = call @json_writer_field_string_or_empty(writer, &JSON_KEY_HOST, JSON_KEY_HOST_LEN, &host_ptr, host_len)
    port_i64 = bitcast port_u64 as i64
    port_field_status = call @sa_json_writer_field_i64(writer, &JSON_KEY_PORT, JSON_KEY_PORT_LEN, port_i64)
    has_rbase = ugt rbase_len, 0
    br has_rbase -> L_CFG_RBASE_STRING, L_CFG_RBASE_NULL

L_CFG_RBASE_STRING:
    !has_rbase
    rbase_field_status = call @sa_json_writer_field_string(writer, &JSON_KEY_RESPONSES_BASE_URL, JSON_KEY_RESPONSES_BASE_URL_LEN, &rbase_ptr, rbase_len)
    !rbase_field_status
    jmp L_CFG_AFTER_RBASE

L_CFG_RBASE_NULL:
    !has_rbase
    rbase_null_status = call @sa_json_writer_field_null(writer, &JSON_KEY_RESPONSES_BASE_URL, JSON_KEY_RESPONSES_BASE_URL_LEN)
    !rbase_null_status
    jmp L_CFG_AFTER_RBASE

L_CFG_AFTER_RBASE:
    chat_field_status = call @json_writer_field_string_or_empty(writer, &JSON_KEY_CHAT_BASE_URL, JSON_KEY_CHAT_BASE_URL_LEN, &chat_ptr, chat_len)
    model_field_status = call @json_writer_field_string_or_empty(writer, &JSON_KEY_DEFAULT_MODEL, JSON_KEY_DEFAULT_MODEL_LEN, &model_ptr, model_len)
    has_auth = ugt auth_len, 0
    br has_auth -> L_CFG_AUTH_STRING, L_CFG_AUTH_NULL

L_CFG_AUTH_STRING:
    !has_auth
    auth_field_status = call @sa_json_writer_field_string(writer, &JSON_KEY_AUTH_TOKEN, JSON_KEY_AUTH_TOKEN_LEN, &auth_ptr, auth_len)
    !auth_field_status
    jmp L_CFG_AFTER_AUTH

L_CFG_AUTH_NULL:
    !has_auth
    auth_null_status = call @sa_json_writer_field_null(writer, &JSON_KEY_AUTH_TOKEN, JSON_KEY_AUTH_TOKEN_LEN)
    !auth_null_status
    jmp L_CFG_AFTER_AUTH

L_CFG_AFTER_AUTH:
    config_end_status = call @sa_json_writer_end_object(writer)
    layers_field_status = call @sa_json_writer_object_field(writer, &JSON_KEY_LAYERS, JSON_KEY_LAYERS_LEN)
    layers_begin_status = call @sa_json_writer_begin_array(writer)
    layers_end_status = call @sa_json_writer_end_array(writer)
    origins_field_status = call @sa_json_writer_object_field(writer, &JSON_KEY_ORIGINS, JSON_KEY_ORIGINS_LEN)
    origins_begin_status = call @sa_json_writer_begin_object(writer)
    origins_end_status = call @sa_json_writer_end_object(writer)
    end_status = call @sa_json_writer_end_object(writer)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !end_status
    !origins_end_status
    !origins_begin_status
    !origins_field_status
    !layers_end_status
    !layers_begin_status
    !layers_field_status
    !config_end_status
    !model_field_status
    !chat_field_status
    !port_field_status
    !port_i64
    !host_field_status
    !config_begin_status
    !config_field_status
    !begin_status
    !writer_status
    !host_ptr
    !host_len
    !port
    !port_u64
    !rbase_ptr
    !rbase_len
    !chat_ptr
    !chat_len
    !model_ptr
    !model_len
    !auth_ptr
    !auth_len
    !cfg_ptr
    !req
    return 0

@ffi_wrapper send_rpc_plugin_read(&req: ptr, &id_ptr: ptr, id_len: u64, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    writer_slot = stack_alloc 8
    writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot)
    writer = load writer_slot+0 as ptr
    begin_status = call @sa_json_writer_begin_object(writer)
    plugin_field_status = call @sa_json_writer_object_field(writer, &JSON_KEY_PLUGIN, JSON_KEY_PLUGIN_LEN)
    plugin_begin_status = call @sa_json_writer_begin_object(writer)
    apps_status = call @json_writer_field_empty_array(writer, &JSON_KEY_APPS, JSON_KEY_APPS_LEN)
    description_status = call @sa_json_writer_field_null(writer, &JSON_KEY_DESCRIPTION, JSON_KEY_DESCRIPTION_LEN)
    hooks_status = call @json_writer_field_empty_array(writer, &JSON_KEY_HOOKS, JSON_KEY_HOOKS_LEN)
    marketplace_status = call @json_writer_field_param_string_or_default(writer, &JSON_KEY_MARKETPLACE_NAME, JSON_KEY_MARKETPLACE_NAME_LEN, &body, body_len, &J_REMOTE_MARKETPLACE_KEY, J_REMOTE_MARKETPLACE_KEY_LEN, &DEFAULT_LOCAL, DEFAULT_LOCAL_LEN, 0)
    marketplace_path_status = call @json_writer_field_param_string_or_default(writer, &JSON_KEY_MARKETPLACE_PATH, JSON_KEY_MARKETPLACE_PATH_LEN, &body, body_len, &J_MARKETPLACE_PATH_KEY, J_MARKETPLACE_PATH_KEY_LEN, &EMPTY_TEXT, EMPTY_TEXT_LEN, 1)
    mcp_status = call @json_writer_field_empty_array(writer, &JSON_KEY_MCP_SERVERS, JSON_KEY_MCP_SERVERS_LEN)
    skills_status = call @json_writer_field_empty_array(writer, &JSON_KEY_SKILLS, JSON_KEY_SKILLS_LEN)
    summary_field_status = call @sa_json_writer_object_field(writer, &JSON_KEY_SUMMARY, JSON_KEY_SUMMARY_LEN)
    summary_begin_status = call @sa_json_writer_begin_object(writer)
    summary_name_status = call @json_writer_field_param_string_or_default(writer, &JSON_KEY_NAME, JSON_KEY_NAME_LEN, &body, body_len, &J_PLUGIN_NAME_KEY, J_PLUGIN_NAME_KEY_LEN, &EMPTY_TEXT, EMPTY_TEXT_LEN, 0)
    summary_end_status = call @sa_json_writer_end_object(writer)
    plugin_end_status = call @sa_json_writer_end_object(writer)
    end_status = call @sa_json_writer_end_object(writer)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !end_status
    !plugin_end_status
    !summary_end_status
    !summary_name_status
    !summary_begin_status
    !summary_field_status
    !skills_status
    !mcp_status
    !marketplace_path_status
    !marketplace_status
    !hooks_status
    !description_status
    !apps_status
    !plugin_begin_status
    !plugin_field_status
    !begin_status
    !writer_status
    !body
    !body_len
    !req
    return 0

