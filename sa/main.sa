@ffi_wrapper json_writer_write_thread_turns_array(writer: ptr, &state_ptr: ptr, thread_id: u64) -> u32:
L_ENTRY:
    turns_field = call @sa_json_writer_object_field(writer, &JSON_KEY_TURNS, JSON_KEY_TURNS_LEN)
    turns_begin = call @sa_json_writer_begin_array(writer)
    ids = stack_alloc 8192
    count_slot = stack_alloc 8
    list_status = call @state_turn_list(&state_ptr, thread_id, &ids, &count_slot)
    !list_status
    count = load count_slot+0 as u64
    i_slot = stack_alloc 8
    store i_slot+0, 0 as u64
    jmp L_JW_THREAD_TURNS_COND

L_JW_THREAD_TURNS_COND:
    i = load i_slot+0 as u64
    done = uge i, count
    br done -> L_JW_THREAD_TURNS_DONE, L_JW_THREAD_TURNS_BODY

L_JW_THREAD_TURNS_BODY:
    !done
    id_off = mul i, 8
    list_id_ptr = ptr_add ids, id_off
    turn_id = load list_id_ptr+0 as u64
    turn_slot = call @state_turn_find(&state_ptr, thread_id, turn_id)
    turn_status = load turn_slot+TURN_STATUS as u8
    turn_mode = load turn_slot+TURN_MODE as u8
    turn_mode_ptr = ptr_add turn_slot, TURN_MODE_TEXT
    turn_mode_len = load turn_slot+TURN_MODE_LEN as u64
    turn_items_ptr = ptr_add turn_slot, TURN_ITEMS
    turn_items_len = load turn_slot+TURN_ITEMS_LEN as u64
    turn_created = load turn_slot+TURN_CREATED as u64
    turn_updated = load turn_slot+TURN_UPDATED as u64
    turn_completed = load turn_slot+TURN_COMPLETED as u64
    write_status = call @json_writer_write_turn_object(writer, turn_id, turn_status, turn_mode, turn_created, turn_updated, turn_completed, &turn_mode_ptr, turn_mode_len, &turn_items_ptr, turn_items_len)
    !write_status
    !turn_completed
    !turn_updated
    !turn_created
    !turn_items_ptr
    !turn_items_len
    !turn_mode_ptr
    !turn_mode_len
    !turn_mode
    !turn_status
    !turn_slot
    !turn_id
    !list_id_ptr
    !id_off
    next = add i, 1
    store i_slot+0, next as u64
    !next
    !i
    jmp L_JW_THREAD_TURNS_COND

L_JW_THREAD_TURNS_DONE:
    !done
    !i
    turns_end = call @sa_json_writer_end_array(writer)
    !turns_end
    !count
    !turns_begin
    !turns_field
    !writer
    !state_ptr
    !thread_id
    return 0


@ffi_wrapper rpc_goal_status_from_body(&body: ptr, body_len: u64) -> u8:
L_ENTRY:
    status_ptr_slot = stack_alloc 8
    status_len_slot = stack_alloc 8
    status_found = call @rpc_extract_string_after(&body, body_len, &J_STATUS_KEY, J_STATUS_KEY_LEN, &status_ptr_slot, &status_len_slot)
    has_status = eq status_found, 1
    !status_found
    br has_status -> L_GOAL_STATUS_PARSE, L_GOAL_STATUS_PARSE_DEFAULT

L_GOAL_STATUS_PARSE:
    !has_status
    status_ptr = load status_ptr_slot+0 as ptr
    status_len = load status_len_slot+0 as u64
    active_raw = call @sa_bytes_eq(&status_ptr, status_len, &J_GOAL_STATUS_ACTIVE, J_GOAL_STATUS_ACTIVE_LEN)
    is_active = eq active_raw, 1
    !active_raw
    br is_active -> L_GOAL_STATUS_RET_ACTIVE, L_GOAL_STATUS_PARSE_PAUSED

L_GOAL_STATUS_RET_ACTIVE:
    !is_active
    !status_ptr
    !status_len
    !body
    !body_len
    return 0

L_GOAL_STATUS_PARSE_PAUSED:
    !is_active
    paused_raw = call @sa_bytes_eq(&status_ptr, status_len, &J_GOAL_STATUS_PAUSED, J_GOAL_STATUS_PAUSED_LEN)
    is_paused2 = eq paused_raw, 1
    !paused_raw
    br is_paused2 -> L_GOAL_STATUS_RET_PAUSED, L_GOAL_STATUS_PARSE_BLOCKED

L_GOAL_STATUS_RET_PAUSED:
    !is_paused2
    !status_ptr
    !status_len
    !body
    !body_len
    return 1

L_GOAL_STATUS_PARSE_BLOCKED:
    !is_paused2
    blocked_raw = call @sa_bytes_eq(&status_ptr, status_len, &J_GOAL_STATUS_BLOCKED, J_GOAL_STATUS_BLOCKED_LEN)
    is_blocked2 = eq blocked_raw, 1
    !blocked_raw
    br is_blocked2 -> L_GOAL_STATUS_RET_BLOCKED, L_GOAL_STATUS_PARSE_USAGE

L_GOAL_STATUS_RET_BLOCKED:
    !is_blocked2
    !status_ptr
    !status_len
    !body
    !body_len
    return 2

L_GOAL_STATUS_PARSE_USAGE:
    !is_blocked2
    usage_raw = call @sa_bytes_eq(&status_ptr, status_len, &J_GOAL_STATUS_USAGE_LIMITED, J_GOAL_STATUS_USAGE_LIMITED_LEN)
    is_usage2 = eq usage_raw, 1
    !usage_raw
    br is_usage2 -> L_GOAL_STATUS_RET_USAGE, L_GOAL_STATUS_PARSE_BUDGET

L_GOAL_STATUS_RET_USAGE:
    !is_usage2
    !status_ptr
    !status_len
    !body
    !body_len
    return 3

L_GOAL_STATUS_PARSE_BUDGET:
    !is_usage2
    budget_raw = call @sa_bytes_eq(&status_ptr, status_len, &J_GOAL_STATUS_BUDGET_LIMITED, J_GOAL_STATUS_BUDGET_LIMITED_LEN)
    is_budget2 = eq budget_raw, 1
    !budget_raw
    br is_budget2 -> L_GOAL_STATUS_RET_BUDGET, L_GOAL_STATUS_PARSE_COMPLETE

L_GOAL_STATUS_RET_BUDGET:
    !is_budget2
    !status_ptr
    !status_len
    !body
    !body_len
    return 4

L_GOAL_STATUS_PARSE_COMPLETE:
    !is_budget2
    complete_raw = call @sa_bytes_eq(&status_ptr, status_len, &J_GOAL_STATUS_COMPLETE, J_GOAL_STATUS_COMPLETE_LEN)
    is_complete2 = eq complete_raw, 1
    !complete_raw
    br is_complete2 -> L_GOAL_STATUS_RET_COMPLETE, L_GOAL_STATUS_RET_UNKNOWN

L_GOAL_STATUS_RET_COMPLETE:
    !is_complete2
    !status_ptr
    !status_len
    !body
    !body_len
    return 5

L_GOAL_STATUS_RET_UNKNOWN:
    !is_complete2
    !status_ptr
    !status_len
    !body
    !body_len
    return 255

L_GOAL_STATUS_PARSE_DEFAULT:
    !has_status
    !body
    !body_len
    return 0

