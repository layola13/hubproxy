    !gs_out_key_ptr
    !gs_out_key_len
    !gs_out_status_ptr
    !gs_out_status_len
    !gs_created
    !gs_updated
    !gs_obj_ptr
    !gs_obj_len
    !gs_thread_id
    !gs_key_ptr
    !gs_key_len
    !gs_goal_status
    !gs_budget_null
    !gs_budget
    jmp L_RPC_DONE

L_RPC_GOAL_SET_EMPTY_OBJ:
