    prefix_status = call @json_writer_write_thread_envelope_prefix(writer, &body, body_len, &model_ptr, model_len, &provider_ptr, provider_len, &dir_ptr, dir_len)
    thread_field_status = call @sa_json_writer_object_field(writer, &JSON_KEY_THREAD, JSON_KEY_THREAD_LEN)
    thread_status = call @json_writer_write_thread_object(writer, &state_ptr, thread_id, forked_from_id, &preview_ptr, preview_len, &provider_ptr, provider_len, ephemeral, &model_ptr, model_len, &dir_ptr, dir_len, &name_ptr, name_len, name_set, 2)
