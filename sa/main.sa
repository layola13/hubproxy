@ffi_wrapper send_rpc_thread_archive(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, thread_id: u64) -> u32:
L_ENTRY:
    arch_status = call @state_thread_archive(&state_ptr, thread_id)
    ok = eq arch_status, 0
    !arch_status
    br ok -> L_ARCH_OK, L_ARCH_NOT_FOUND

L_ARCH_OK:
    !ok
    call @notify_thread_id_only(&state_ptr, &EV_THREAD_ARCHIVED, EV_THREAD_ARCHIVED_LEN, thread_id)
    call @notify_thread_id_only(&state_ptr, &EV_THREAD_CLOSED, EV_THREAD_CLOSED_LEN, thread_id)
    writer_slot = stack_alloc 8
    writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot)
    writer = load writer_slot+0 as ptr
    begin_status = call @sa_json_writer_begin_object(writer)
    archived_status = call @sa_json_writer_field_bool(writer, &JSON_KEY_ARCHIVED, JSON_KEY_ARCHIVED_LEN, 1)
    thread_status = call @json_writer_field_thread_id_string(writer, &JSON_KEY_THREAD_ID, JSON_KEY_THREAD_ID_LEN, &state_ptr, thread_id)
    end_status = call @sa_json_writer_end_object(writer)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !end_status
    !thread_status
    !archived_status
    !begin_status
    !writer_status
    !thread_id
    !state_ptr
    !req
    return 0

L_ARCH_NOT_FOUND:
    !ok
    call @send_error_with_id(&req, 404, &id_ptr, id_len, &J_ERR_THREAD_NOT_FOUND, J_ERR_THREAD_NOT_FOUND_LEN)
    !thread_id
    !state_ptr
    !req
    return 0

@ffi_wrapper send_rpc_thread_unarchive(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, thread_id: u64) -> u32:
L_ENTRY:
    unarch_status = call @state_thread_unarchive(&state_ptr, thread_id)
    ok = eq unarch_status, 0
    !unarch_status
    br ok -> L_UNARCH_OK, L_UNARCH_NOT_FOUND

L_UNARCH_OK:
    !ok
    call @notify_thread_id_only(&state_ptr, &EV_THREAD_UNARCHIVED, EV_THREAD_UNARCHIVED_LEN, thread_id)
    call @notify_thread_status_idle(&state_ptr, thread_id)
    call @send_rpc_thread_read(&req, &id_ptr, id_len, &state_ptr, thread_id, 0)
    !thread_id
    !state_ptr
    !req
    return 0

L_UNARCH_NOT_FOUND:
    !ok
    call @send_error_with_id(&req, 404, &id_ptr, id_len, &J_ERR_THREAD_NOT_FOUND, J_ERR_THREAD_NOT_FOUND_LEN)
    !thread_id
    !state_ptr
    !req
    return 0

@ffi_wrapper send_rpc_thread_name_set(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    thread_id = call @rpc_resolve_thread_id(&state_ptr, &body, body_len, 0)
    name_ptr_slot = stack_alloc 8
    name_len_slot = stack_alloc 8
    name_status = call @rpc_extract_string_after(&body, body_len, &J_NAME_KEY, J_NAME_KEY_LEN, &name_ptr_slot, &name_len_slot)
    has_name = eq name_status, 1
    !name_status
    br has_name -> L_NAME_SET, L_NAME_CLEAR

L_NAME_SET:
    !has_name
    name_ptr = load name_ptr_slot+0 as ptr
    name_len = load name_len_slot+0 as u64
    set_status = call @state_thread_set_name(&state_ptr, thread_id, &name_ptr, name_len)
    set_ok = eq set_status, 0
    !set_status
    br set_ok -> L_NAME_SET_RESP, L_NAME_SET_NOT_FOUND

L_NAME_CLEAR:
    !has_name
    clear_status = call @state_thread_clear_name(&state_ptr, thread_id)
    clear_ok = eq clear_status, 0
    !clear_status
    br clear_ok -> L_NAME_CLEAR_RESP, L_NAME_CLEAR_NOT_FOUND

L_NAME_SET_RESP:
    !set_ok
    call @notify_thread_name_updated(&state_ptr, thread_id, &name_ptr, name_len, 1)
    writer_slot = stack_alloc 8
    writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot)
    writer = load writer_slot+0 as ptr
    begin_status = call @sa_json_writer_begin_object(writer)
    thread_status = call @json_writer_field_thread_id_string(writer, &JSON_KEY_THREAD_ID, JSON_KEY_THREAD_ID_LEN, &state_ptr, thread_id)
    name_field_status = call @sa_json_writer_field_string(writer, &JSON_KEY_NAME, JSON_KEY_NAME_LEN, &name_ptr, name_len)
    end_status = call @sa_json_writer_end_object(writer)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !end_status
    !name_field_status
    !thread_status
    !begin_status
    !writer_status
    !name_ptr
    !name_len
    !thread_id
    !state_ptr
    !body
    !body_len
    !req
    return 0

L_NAME_CLEAR_RESP:
    !clear_ok
    call @notify_thread_name_updated(&state_ptr, thread_id, &EMPTY_TEXT, EMPTY_TEXT_LEN, 0)
    writer_slot2 = stack_alloc 8
    writer_status2 = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot2)
    writer2 = load writer_slot2+0 as ptr
    begin_status2 = call @sa_json_writer_begin_object(writer2)
    thread_status2 = call @json_writer_field_thread_id_string(writer2, &JSON_KEY_THREAD_ID, JSON_KEY_THREAD_ID_LEN, &state_ptr, thread_id)
    name_null_status = call @sa_json_writer_field_null(writer2, &JSON_KEY_NAME, JSON_KEY_NAME_LEN)
    end_status2 = call @sa_json_writer_end_object(writer2)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer2)
    !end_status2
    !name_null_status
    !thread_status2
    !begin_status2
    !writer_status2
    !thread_id
    !state_ptr
    !body
    !body_len
    !req
    return 0

L_NAME_SET_NOT_FOUND:
    !set_ok
    !name_ptr
    !name_len
    call @send_error_with_id(&req, 404, &id_ptr, id_len, &J_ERR_THREAD_NOT_FOUND, J_ERR_THREAD_NOT_FOUND_LEN)
    !thread_id
    !state_ptr
    !body
    !body_len
    !req
    return 0

L_NAME_CLEAR_NOT_FOUND:
    !clear_ok
    call @send_error_with_id(&req, 404, &id_ptr, id_len, &J_ERR_THREAD_NOT_FOUND, J_ERR_THREAD_NOT_FOUND_LEN)
    !thread_id
    !state_ptr
    !body
    !body_len
    !req
    return 0

@ffi_wrapper send_rpc_thread_metadata_update(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    thread_id = call @rpc_resolve_thread_id(&state_ptr, &body, body_len, 0)
    slot = call @state_thread_find(&state_ptr, thread_id)
    missing = eq slot, 0
    br missing -> L_META_NOT_FOUND, L_META_SLOT

L_META_SLOT:
    !missing
    preview_ptr_slot = stack_alloc 8
    preview_len_slot = stack_alloc 8
    preview_status = call @rpc_extract_string_after(&body, body_len, &J_PREVIEW_KEY, J_PREVIEW_KEY_LEN, &preview_ptr_slot, &preview_len_slot)
    has_preview = eq preview_status, 1
    !preview_status
    !slot
    br has_preview -> L_META_SET, L_META_CHECK_NULL

L_META_SET:
    !has_preview
    preview_ptr = load preview_ptr_slot+0 as ptr
    preview_len = load preview_len_slot+0 as u64
    set_status = call @state_thread_set_preview(&state_ptr, thread_id, &preview_ptr, preview_len)
    !set_status
    !preview_ptr
    !preview_len
    jmp L_META_READ

L_META_CHECK_NULL:
    !has_preview
    null_idx = call @sa_bytes_find(&body, body_len, &J_PREVIEW_NULL, J_PREVIEW_NULL_LEN)
    has_null = sge null_idx, 0
    !null_idx
    br has_null -> L_META_CLEAR, L_META_READ

L_META_CLEAR:
    !has_null
    clear_status = call @state_thread_clear_preview(&state_ptr, thread_id)
    !clear_status
    jmp L_META_READ

L_META_READ:
    git_status = call @apply_thread_git_info_from_body(&state_ptr, thread_id, &body, body_len)
    !git_status
    call @send_rpc_thread_read(&req, &id_ptr, id_len, &state_ptr, thread_id, 0)
    !thread_id
    !body
    !body_len
    !state_ptr
    !req
    return 0

L_META_NOT_FOUND:
    !missing
    !slot
    call @send_error_with_id(&req, 404, &id_ptr, id_len, &J_ERR_THREAD_NOT_FOUND, J_ERR_THREAD_NOT_FOUND_LEN)
    !thread_id
    !body
    !body_len
    !state_ptr
    !req
    return 0

@ffi_wrapper apply_thread_git_info_from_body(&state_ptr: ptr, thread_id: u64, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    root = call @sa_json_parse(&body, body_len)
    has_root = ne root, 0
    br has_root -> L_GIT_ROOT, L_GIT_NO_ROOT

L_GIT_ROOT:
    !has_root
    params_slot = stack_alloc 8
    params_status = call @sa_json_object_get(root, &FB_KEY_PARAMS, FB_KEY_PARAMS_LEN, &params_slot)
    params_ok = eq params_status, 0
    br params_ok -> L_GIT_PARAMS, L_GIT_NO_PARAMS

L_GIT_PARAMS:
    !params_ok
    !params_status
    params_node = load params_slot+0 as ptr
    git_slot = stack_alloc 8
    git_status = call @sa_json_object_get(params_node, &FB_KEY_GITINFO, FB_KEY_GITINFO_LEN, &git_slot)
    git_ok = eq git_status, 0
    br git_ok -> L_GIT_VALUE, L_GIT_NO_VALUE

L_GIT_VALUE:
    !git_ok
    !git_status
    git_node = load git_slot+0 as ptr
    git_kind = call @sa_json_kind(git_node)
    git_is_null = eq git_kind, SA_JSON_KIND_NULL
    !git_kind
    br git_is_null -> L_GIT_CLEAR, L_GIT_STRINGIFY

L_GIT_STRINGIFY:
    !git_is_null
    buffer_slot = stack_alloc 8
    stringify_status = call @sa_json_stringify(git_node, &buffer_slot)
    stringify_ok = eq stringify_status, 0
    br stringify_ok -> L_GIT_STORE, L_GIT_STRINGIFY_FAIL

L_GIT_STORE:
    !stringify_ok
    buffer = load buffer_slot+0 as ptr
    raw_ptr = call @sa_json_buffer_data(&buffer)
    raw_len = call @sa_json_buffer_len(&buffer)
    set_status = call @state_thread_set_git_info(&state_ptr, thread_id, &raw_ptr, raw_len)
    !set_status
    free_buf = call @sa_json_buffer_free(^buffer)
    !free_buf
    git_free = call @sa_json_free(^git_node)
    params_free = call @sa_json_free(^params_node)
    root_free = call @sa_json_free(^root)
    !git_free
    !params_free
    !root_free
    !raw_ptr
    !raw_len
    !stringify_status
    !state_ptr
    !thread_id
    !body
    !body_len
    return 0

L_GIT_STRINGIFY_FAIL:
    !stringify_ok
    !stringify_status
    git_free_bad = call @sa_json_free(^git_node)
    params_free_bad = call @sa_json_free(^params_node)
    root_free_bad = call @sa_json_free(^root)
    !git_free_bad
    !params_free_bad
    !root_free_bad
    !state_ptr
    !thread_id
    !body
    !body_len
    return 1

L_GIT_CLEAR:
    !git_is_null
    clear_status = call @state_thread_clear_git_info(&state_ptr, thread_id)
    !clear_status
    git_free_null = call @sa_json_free(^git_node)
    params_free_null = call @sa_json_free(^params_node)
    root_free_null = call @sa_json_free(^root)
    !git_free_null
    !params_free_null
    !root_free_null
    !state_ptr
    !thread_id
    !body
    !body_len
    return 0

L_GIT_NO_VALUE:
    !git_ok
    !git_status
    params_free_no_value = call @sa_json_free(^params_node)
    root_free_no_value = call @sa_json_free(^root)
    !params_free_no_value
    !root_free_no_value
    !state_ptr
    !thread_id
    !body
    !body_len
    return 0

L_GIT_NO_PARAMS:
    !params_ok
    !params_status
    root_free_no_params = call @sa_json_free(^root)
    !root_free_no_params
    !state_ptr
    !thread_id
    !body
    !body_len
    return 0

L_GIT_NO_ROOT:
    !has_root
    !root
    !state_ptr
    !thread_id
    !body
    !body_len
    return 0

@ffi_wrapper send_rpc_thread_unsubscribe(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    thread_id = call @rpc_resolve_thread_id(&state_ptr, &body, body_len, 0)
    slot = call @state_thread_find(&state_ptr, thread_id)
    missing = eq slot, 0
    br missing -> L_UNSUB_NOT_LOADED, L_UNSUB_NOT_SUBSCRIBED

L_UNSUB_NOT_SUBSCRIBED:
    !missing
    !slot
    call @send_rpc_status_with_id(&req, &id_ptr, id_len, &JSON_VALUE_NOT_SUBSCRIBED, JSON_VALUE_NOT_SUBSCRIBED_LEN)
    !thread_id
    !state_ptr
    !body
    !body_len
    !req
    return 0

L_UNSUB_NOT_LOADED:
    !missing
    !slot
    call @send_rpc_status_with_id(&req, &id_ptr, id_len, &JSON_VALUE_NOT_LOADED, JSON_VALUE_NOT_LOADED_LEN)
    !thread_id
    !state_ptr
    !body
    !body_len
    !req
    return 0

@ffi_wrapper send_rpc_thread_elicitation_result(&req: ptr, &id_ptr: ptr, id_len: u64, count: u64) -> u32:
L_ENTRY:
    paused = ugt count, 0
    count_i64 = bitcast count as i64
    writer_slot = stack_alloc 8
    writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot)
    writer = load writer_slot+0 as ptr
    begin_status = call @sa_json_writer_begin_object(writer)
    count_status = call @sa_json_writer_field_i64(writer, &JSON_KEY_COUNT, JSON_KEY_COUNT_LEN, count_i64)
    paused_status = call @sa_json_writer_field_bool(writer, &JSON_KEY_PAUSED, JSON_KEY_PAUSED_LEN, paused)
    end_status = call @sa_json_writer_end_object(writer)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !end_status
    !paused_status
    !count_status
    !begin_status
    !writer_status
    !count_i64
    !paused
    !count
    !req
    return 0

@ffi_wrapper send_rpc_thread_increment_elicitation(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    thread_id = call @rpc_resolve_thread_id(&state_ptr, &body, body_len, 0)
    count = call @state_thread_increment_elicitation(&state_ptr, thread_id)
    call @send_rpc_thread_elicitation_result(&req, &id_ptr, id_len, count)
    !count
    !thread_id
    !body
    !body_len
    !state_ptr
    !req
    return 0

@ffi_wrapper send_rpc_thread_decrement_elicitation(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    thread_id = call @rpc_resolve_thread_id(&state_ptr, &body, body_len, 0)
    count = call @state_thread_decrement_elicitation(&state_ptr, thread_id)
    call @send_rpc_thread_elicitation_result(&req, &id_ptr, id_len, count)
    !count
    !thread_id
    !body
    !body_len
    !state_ptr
    !req
    return 0

@ffi_wrapper send_rpc_fs_watch(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    path_ptr_slot = stack_alloc 8
    path_len_slot = stack_alloc 8
    watch_ptr_slot = stack_alloc 8
    watch_len_slot = stack_alloc 8
    path_status = call @rpc_extract_string_after(&body, body_len, &J_PATH_KEY, J_PATH_KEY_LEN, &path_ptr_slot, &path_len_slot)
    has_path = eq path_status, 1
    !path_status
    br has_path -> L_WATCH_ID, L_WATCH_BAD_PARAMS

L_WATCH_ID:
    !has_path
    watch_status = call @rpc_extract_string_after(&body, body_len, &J_WATCH_ID_KEY, J_WATCH_ID_KEY_LEN, &watch_ptr_slot, &watch_len_slot)
    has_watch = eq watch_status, 1
    !watch_status
    br has_watch -> L_WATCH_DO, L_WATCH_BAD_PARAMS2

L_WATCH_BAD_PARAMS:
    !has_path
    call @send_error_with_id(&req, 400, &id_ptr, id_len, &J_ERR_INVALID_PARAMS, J_ERR_INVALID_PARAMS_LEN)
    !body
    !body_len
    !state_ptr
    !req
    return 0

L_WATCH_BAD_PARAMS2:
    !has_watch
    call @send_error_with_id(&req, 400, &id_ptr, id_len, &J_ERR_INVALID_PARAMS, J_ERR_INVALID_PARAMS_LEN)
    !body
    !body_len
    !state_ptr
    !req
    return 0

L_WATCH_DO:
    !has_watch
    path_ptr = load path_ptr_slot+0 as ptr
    path_len = load path_len_slot+0 as u64
    watch_ptr = load watch_ptr_slot+0 as ptr
    watch_len = load watch_len_slot+0 as u64
    put_status = call @state_watch_put(&state_ptr, &watch_ptr, watch_len)
    put_ok = eq put_status, 0
    !put_status
    br put_ok -> L_WATCH_RESP, L_WATCH_ERR

L_WATCH_ERR:
    !put_ok
    !path_ptr
    !path_len
    !watch_ptr
    !watch_len
    call @send_error_with_id(&req, 500, &id_ptr, id_len, &J_ERR_FS, J_ERR_FS_LEN)
    !body
    !body_len
    !state_ptr
    !req
    return 0

L_WATCH_RESP:
    !put_ok
    call @notify_fs_changed(&state_ptr, &watch_ptr, watch_len, &path_ptr, path_len)
    writer_slot = stack_alloc 8
    writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot)
    writer = load writer_slot+0 as ptr
    begin_status = call @sa_json_writer_begin_object(writer)
    path_status = call @sa_json_writer_field_string(writer, &JSON_KEY_PATH, JSON_KEY_PATH_LEN, &path_ptr, path_len)
    end_status = call @sa_json_writer_end_object(writer)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !end_status
    !path_status
    !begin_status
    !writer_status
    !path_ptr
    !path_len
    !watch_ptr
    !watch_len
    !body
    !body_len
    !state_ptr
    !req
    return 0

@ffi_wrapper send_rpc_fs_unwatch(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    watch_ptr_slot = stack_alloc 8
    watch_len_slot = stack_alloc 8
    watch_status = call @rpc_extract_string_after(&body, body_len, &J_WATCH_ID_KEY, J_WATCH_ID_KEY_LEN, &watch_ptr_slot, &watch_len_slot)
    has_watch = eq watch_status, 1
    !watch_status
    br has_watch -> L_UNWATCH_DO, L_UNWATCH_FALSE

L_UNWATCH_DO:
    !has_watch
    watch_ptr = load watch_ptr_slot+0 as ptr
    watch_len = load watch_len_slot+0 as u64
    deleted = call @state_watch_delete(&state_ptr, &watch_ptr, watch_len)
    found = eq deleted, 1
    !deleted
    br found -> L_UNWATCH_TRUE, L_UNWATCH_FALSE2

L_UNWATCH_TRUE:
    !found
    call @send_rpc_bool_field_with_id(&req, &id_ptr, id_len, &JSON_KEY_OK, JSON_KEY_OK_LEN, 1)
    !watch_ptr
    !watch_len
    !body
    !body_len
    !state_ptr
    !req
    return 0

L_UNWATCH_FALSE2:
    !found
    call @send_rpc_bool_field_with_id(&req, &id_ptr, id_len, &JSON_KEY_OK, JSON_KEY_OK_LEN, 0)
    !watch_ptr
    !watch_len
    !body
    !body_len
    !state_ptr
    !req
    return 0

L_UNWATCH_FALSE:
    !has_watch
    call @send_rpc_bool_field_with_id(&req, &id_ptr, id_len, &JSON_KEY_OK, JSON_KEY_OK_LEN, 0)
    !body
    !body_len
    !state_ptr
    !req
    return 0

@ffi_wrapper send_rpc_turns_list(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, thread_id: u64) -> u32:
L_ENTRY:
    writer_slot = stack_alloc 8
    writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot)
    writer = load writer_slot+0 as ptr
    ids = stack_alloc 8192
    count_slot = stack_alloc 8
    list_status = call @state_turn_list(&state_ptr, thread_id, &ids, &count_slot)
    !list_status
    count = load count_slot+0 as u64
    begin_status = call @sa_json_writer_begin_object(writer)
    data_field_status = call @sa_json_writer_object_field(writer, &JSON_KEY_DATA, JSON_KEY_DATA_LEN)
    data_begin_status = call @sa_json_writer_begin_array(writer)
    i_slot = stack_alloc 8
    store i_slot+0, 0 as u64
    jmp L_TURNS_COND

L_TURNS_COND:
    i = load i_slot+0 as u64
    done = uge i, count
    br done -> L_TURNS_DONE, L_TURNS_BODY

L_TURNS_BODY:
    id_off = mul i, 8
    list_id_ptr = ptr_add ids, id_off
    turn_id = load list_id_ptr+0 as u64
    turn_slot2 = call @state_turn_find(&state_ptr, thread_id, turn_id)
    turn_status2 = load turn_slot2+TURN_STATUS as u8
    turn_mode2 = load turn_slot2+TURN_MODE as u8
    turn_mode_ptr2 = ptr_add turn_slot2, TURN_MODE_TEXT
    turn_mode_len2 = load turn_slot2+TURN_MODE_LEN as u64
    turn_items_ptr2 = ptr_add turn_slot2, TURN_ITEMS
    turn_items_len2 = load turn_slot2+TURN_ITEMS_LEN as u64
    turn_created2 = load turn_slot2+TURN_CREATED as u64
    turn_updated2 = load turn_slot2+TURN_UPDATED as u64
    turn_completed2 = load turn_slot2+TURN_COMPLETED as u64
    write_status = call @json_writer_write_turn_object(writer, turn_id, turn_status2, turn_mode2, turn_created2, turn_updated2, turn_completed2, &turn_mode_ptr2, turn_mode_len2, &turn_items_ptr2, turn_items_len2)
    !write_status
    !turn_completed2
    !turn_updated2
    !turn_created2
    !turn_items_ptr2
    !turn_items_len2
    !turn_mode_ptr2
    !turn_mode_len2
    !turn_mode2
    !turn_status2
    !turn_slot2
    !turn_id
    !list_id_ptr
    !id_off
    next = add i, 1
    store i_slot+0, next as u64
    !next
    !i
    !done
    jmp L_TURNS_COND

L_TURNS_DONE:
    !done
    !i
    data_end_status = call @sa_json_writer_end_array(writer)
    next_status = call @sa_json_writer_field_null(writer, &JSON_KEY_NEXT_CURSOR, JSON_KEY_NEXT_CURSOR_LEN)
    backwards_status = call @sa_json_writer_field_null(writer, &JSON_KEY_BACKWARDS_CURSOR, JSON_KEY_BACKWARDS_CURSOR_LEN)
    end_status = call @sa_json_writer_end_object(writer)
    !count
    !thread_id
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !end_status
    !backwards_status
    !next_status
    !data_end_status
    !data_begin_status
    !data_field_status
    !begin_status
    !writer_status
    !state_ptr
    !req
    return 0

@ffi_wrapper send_rpc_turn_items_list(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, thread_id: u64, turn_id: u64) -> u32:
L_ENTRY:
    slot = call @state_turn_find(&state_ptr, thread_id, turn_id)
    missing = eq slot, 0
    br missing -> L_TITEMS_EMPTY, L_TITEMS_FOUND

L_TITEMS_FOUND:
    !missing
    items_len = load slot+TURN_ITEMS_LEN as u64
    has_items = ugt items_len, 0
    br has_items -> L_TITEMS_WITH_ITEMS, L_TITEMS_EMPTY_FROM_FOUND

L_TITEMS_WITH_ITEMS:
    !has_items
    items_ptr = ptr_add slot, TURN_ITEMS
    writer_slot = stack_alloc 8
    writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot)
    writer = load writer_slot+0 as ptr
    begin_status = call @sa_json_writer_begin_object(writer)
    data_status = call @json_writer_field_items_or_empty(writer, &JSON_KEY_DATA, JSON_KEY_DATA_LEN, &items_ptr, items_len)
    next_status = call @sa_json_writer_field_null(writer, &JSON_KEY_NEXT_CURSOR, JSON_KEY_NEXT_CURSOR_LEN)
    backwards_status = call @sa_json_writer_field_null(writer, &JSON_KEY_BACKWARDS_CURSOR, JSON_KEY_BACKWARDS_CURSOR_LEN)
    end_status = call @sa_json_writer_end_object(writer)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !end_status
    !backwards_status
    !next_status
    !data_status
    !begin_status
    !writer_status
    !items_ptr
    !items_len
    !slot
    !turn_id
    !thread_id
    !state_ptr
    !req
    return 0

L_TITEMS_EMPTY_FROM_FOUND:
    !has_items
    !items_len
    !slot
    jmp L_TITEMS_EMPTY_FOUND

L_TITEMS_EMPTY:
    !missing
    !slot
    writer_slot_empty = stack_alloc 8
    writer_status_empty = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot_empty)
    writer_empty = load writer_slot_empty+0 as ptr
    begin_status_empty = call @sa_json_writer_begin_object(writer_empty)
    data_status_empty = call @json_writer_field_empty_array(writer_empty, &JSON_KEY_DATA, JSON_KEY_DATA_LEN)
    next_status_empty = call @sa_json_writer_field_null(writer_empty, &JSON_KEY_NEXT_CURSOR, JSON_KEY_NEXT_CURSOR_LEN)
    backwards_status_empty = call @sa_json_writer_field_null(writer_empty, &JSON_KEY_BACKWARDS_CURSOR, JSON_KEY_BACKWARDS_CURSOR_LEN)
    end_status_empty = call @sa_json_writer_end_object(writer_empty)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer_empty)
    !end_status_empty
    !backwards_status_empty
    !next_status_empty
    !data_status_empty
    !begin_status_empty
    !writer_status_empty
    !turn_id
    !thread_id
    !state_ptr
    !req
    return 0

L_TITEMS_EMPTY_FOUND:
    writer_slot_empty_found = stack_alloc 8
    writer_status_empty_found = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot_empty_found)
    writer_empty_found = load writer_slot_empty_found+0 as ptr
    begin_status_empty_found = call @sa_json_writer_begin_object(writer_empty_found)
    data_status_empty_found = call @json_writer_field_empty_array(writer_empty_found, &JSON_KEY_DATA, JSON_KEY_DATA_LEN)
    next_status_empty_found = call @sa_json_writer_field_null(writer_empty_found, &JSON_KEY_NEXT_CURSOR, JSON_KEY_NEXT_CURSOR_LEN)
    backwards_status_empty_found = call @sa_json_writer_field_null(writer_empty_found, &JSON_KEY_BACKWARDS_CURSOR, JSON_KEY_BACKWARDS_CURSOR_LEN)
    end_status_empty_found = call @sa_json_writer_end_object(writer_empty_found)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer_empty_found)
    !end_status_empty_found
    !backwards_status_empty_found
    !next_status_empty_found
    !data_status_empty_found
    !begin_status_empty_found
    !writer_status_empty_found
    !turn_id
    !thread_id
    !state_ptr
    !req
    return 0

@ffi_wrapper send_rpc_thread_rollback(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, thread_id: u64, remove_count: u64) -> u32:
L_ENTRY:
    rb_status = call @state_turn_rollback(&state_ptr, thread_id, remove_count)
    ok = eq rb_status, 0
    !rb_status
    br ok -> L_ROLLBACK_OK, L_ROLLBACK_NOT_FOUND

L_ROLLBACK_OK:
    !ok
    call @send_rpc_thread_read(&req, &id_ptr, id_len, &state_ptr, thread_id, 1)
    !remove_count
    !thread_id
    !state_ptr
    !req
    return 0

L_ROLLBACK_NOT_FOUND:
    !ok
    call @send_error_with_id(&req, 404, &id_ptr, id_len, &J_ERR_THREAD_NOT_FOUND, J_ERR_THREAD_NOT_FOUND_LEN)
    !remove_count
    !thread_id
    !state_ptr
    !req
    return 0

@ffi_wrapper send_rpc_turn_start(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, thread_id: u64, turn_id: u64, mode: u8) -> u32:
L_ENTRY:
    writer_slot = stack_alloc 8
    writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot)
    writer = load writer_slot+0 as ptr
    begin_status = call @sa_json_writer_begin_object(writer)
    turn_field_status = call @sa_json_writer_object_field(writer, &JSON_KEY_TURN, JSON_KEY_TURN_LEN)
    slot = call @state_turn_find(&state_ptr, thread_id, turn_id)
    missing = eq slot, 0
    br missing -> L_TURN_START_EMPTY, L_TURN_START_WITH_SLOT

L_TURN_START_WITH_SLOT:
    !missing
    turn_status = load slot+TURN_STATUS as u8
    mode_ptr = ptr_add slot, TURN_MODE_TEXT
    mode_len = load slot+TURN_MODE_LEN as u64
    items_ptr = ptr_add slot, TURN_ITEMS
    items_len = load slot+TURN_ITEMS_LEN as u64
    created = load slot+TURN_CREATED as u64
    updated = load slot+TURN_UPDATED as u64
    completed = load slot+TURN_COMPLETED as u64
    write_status = call @json_writer_write_turn_object(writer, turn_id, turn_status, mode, created, updated, completed, &mode_ptr, mode_len, &items_ptr, items_len)
    !write_status
    !completed
    !updated
    !created
    !items_ptr
    !items_len
    !mode_ptr
    !mode_len
    !turn_status
    !slot
    jmp L_TURN_START_WRAP

L_TURN_START_EMPTY:
    !missing
    !slot
    empty_ptr = &EMPTY_TEXT
    now_empty_i = call @sa_time_unix_s()
    now_empty_u = bitcast now_empty_i as u64
    write_empty_status = call @json_writer_write_turn_object(writer, turn_id, 1, mode, now_empty_u, now_empty_u, 0, &empty_ptr, 0, &empty_ptr, 0)
    !write_empty_status
    !now_empty_u
    !now_empty_i
    !empty_ptr
    jmp L_TURN_START_WRAP

L_TURN_START_WRAP:
    end_status = call @sa_json_writer_end_object(writer)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !end_status
    !turn_field_status
    !begin_status
    !writer_status
    !mode
    !thread_id
    !turn_id
    !state_ptr
    !req
    return 0

@ffi_wrapper send_rpc_turn_steer(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, thread_id: u64, turn_id: u64, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    slot = call @state_turn_find(&state_ptr, thread_id, turn_id)
    missing = eq slot, 0
    br missing -> L_STEER_NOT_FOUND, L_STEER_OK

L_STEER_OK:
    !missing
    input_ptr_slot = stack_alloc 8
    input_len_slot = stack_alloc 8
    input_status = call @rpc_extract_array_after(&body, body_len, &J_INPUT_ARRAY_KEY, J_INPUT_ARRAY_KEY_LEN, &input_ptr_slot, &input_len_slot)
    has_input = eq input_status, 1
    br has_input -> L_STEER_APPEND, L_STEER_NO_INPUT

L_STEER_APPEND:
    !has_input
    !input_status
    input_ptr = load input_ptr_slot+0 as ptr
    input_len = load input_len_slot+0 as u64
    append_status = call @state_turn_append_items(&state_ptr, thread_id, turn_id, &input_ptr, input_len)
    !append_status
    steer_notify_count = call @notify_turn_input_items_from_dom(&state_ptr, &body, body_len, thread_id, turn_id)
    !steer_notify_count
    !input_ptr
    !input_len
    jmp L_STEER_RESP

L_STEER_NO_INPUT:
    !has_input
    !input_status
    jmp L_STEER_RESP

L_STEER_RESP:
    tmp = stack_alloc ID_BUF_SIZE
    len_slot = stack_alloc 8
    fmt_status = call @sa_fmt_u64_into(turn_id, 10, tmp, ID_BUF_SIZE, &len_slot)
    !fmt_status
    fmt_len = load len_slot+0 as u64
    writer_slot = stack_alloc 8
    writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot)
    writer = load writer_slot+0 as ptr
    begin_status = call @sa_json_writer_begin_object(writer)
    turn_status = call @sa_json_writer_field_string(writer, &JSON_KEY_TURN_ID, JSON_KEY_TURN_ID_LEN, &tmp, fmt_len)
    end_status = call @sa_json_writer_end_object(writer)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !end_status
    !turn_status
    !begin_status
    !writer_status
    !fmt_len
    !slot
    !thread_id
    !turn_id
    !state_ptr
    !body
    !body_len
    !req
    return 0

L_STEER_NOT_FOUND:
    !missing
    !slot
    call @send_error_with_id(&req, 404, &id_ptr, id_len, &J_ERR_TURN_NOT_FOUND, J_ERR_TURN_NOT_FOUND_LEN)
    !thread_id
    !turn_id
    !state_ptr
    !body
    !body_len
    !req
    return 0

@ffi_wrapper send_rpc_turn_interrupt(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, thread_id: u64, turn_id: u64) -> u32:
L_ENTRY:
    int_status = call @state_turn_interrupt(&state_ptr, thread_id, turn_id)
    ok = eq int_status, 0
    !int_status
    br ok -> L_TINT_OK, L_TINT_NOT_FOUND

L_TINT_OK:
    !ok
    call @notify_turn_completed(&state_ptr, thread_id, turn_id)
    tmp = stack_alloc ID_BUF_SIZE
    len_slot = stack_alloc 8
    fmt_status = call @sa_fmt_u64_into(turn_id, 10, tmp, ID_BUF_SIZE, &len_slot)
    !fmt_status
    fmt_len = load len_slot+0 as u64
    writer_slot = stack_alloc 8
    writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot)
    writer = load writer_slot+0 as ptr
    begin_status = call @sa_json_writer_begin_object(writer)
    interrupted_status = call @sa_json_writer_field_bool(writer, &JSON_KEY_INTERRUPTED, JSON_KEY_INTERRUPTED_LEN, 1)
    thread_status = call @json_writer_field_thread_id_string(writer, &JSON_KEY_THREAD_ID, JSON_KEY_THREAD_ID_LEN, &state_ptr, thread_id)
    turn_status = call @sa_json_writer_field_string(writer, &JSON_KEY_TURN_ID, JSON_KEY_TURN_ID_LEN, &tmp, fmt_len)
    end_status = call @sa_json_writer_end_object(writer)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !end_status
    !turn_status
    !thread_status
    !interrupted_status
    !begin_status
    !writer_status
    !fmt_len
    !thread_id
    !turn_id
    !state_ptr
    !req
    return 0

L_TINT_NOT_FOUND:
    !ok
    call @send_error_with_id(&req, 404, &id_ptr, id_len, &J_ERR_TURN_NOT_FOUND, J_ERR_TURN_NOT_FOUND_LEN)
    !thread_id
    !turn_id
    !state_ptr
    !req
    return 0

@ffi_wrapper send_rpc_goal_obj(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, thread_id: u64, &goal_key_ptr: ptr, goal_key_len: u64, status: u8, &status_ptr: ptr, status_len: u64, budget_null: u8, budget: i64, used: u64, created: u64, updated: u64, &obj_ptr: ptr, obj_len: u64) -> u32:
L_ENTRY:
    writer_slot = stack_alloc 8
    writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot)
    writer = load writer_slot+0 as ptr
    begin_status = call @sa_json_writer_begin_object(writer)
    goal_field_status = call @sa_json_writer_object_field(writer, &JSON_KEY_GOAL, JSON_KEY_GOAL_LEN)
    goal_begin_status = call @sa_json_writer_begin_object(writer)
    thread_field_status = call @json_writer_field_thread_id_goal_key(writer, &JSON_KEY_THREAD_ID, JSON_KEY_THREAD_ID_LEN, &state_ptr, thread_id, &goal_key_ptr, goal_key_len)
    objective_field_status = call @sa_json_writer_field_string(writer, &JSON_KEY_OBJECTIVE, JSON_KEY_OBJECTIVE_LEN, &obj_ptr, obj_len)
    status_field_status = call @json_writer_field_goal_status_text(writer, status, &status_ptr, status_len)
    budget_field_status = call @json_writer_field_goal_budget(writer, budget_null, budget)
    used_i64 = bitcast used as i64
    used_field_status = call @sa_json_writer_field_i64(writer, &JSON_KEY_TOKENS_USED, JSON_KEY_TOKENS_USED_LEN, used_i64)
    time_field_status = call @sa_json_writer_field_i64(writer, &JSON_KEY_TIME_USED_SECONDS, JSON_KEY_TIME_USED_SECONDS_LEN, 0)
    created_i = bitcast created as i64
    updated_i = bitcast updated as i64
    created_field_status = call @sa_json_writer_field_i64(writer, &JSON_KEY_CREATED_AT, JSON_KEY_CREATED_AT_LEN, created_i)
    updated_field_status = call @sa_json_writer_field_i64(writer, &JSON_KEY_UPDATED_AT, JSON_KEY_UPDATED_AT_LEN, updated_i)
    goal_end_status = call @sa_json_writer_end_object(writer)
    end_status = call @sa_json_writer_end_object(writer)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !end_status
    !goal_end_status
    !updated_field_status
    !created_field_status
    !time_field_status
    !used_field_status
    !used_i64
    !budget_field_status
    !status_field_status
    !objective_field_status
    !thread_field_status
    !goal_begin_status
    !goal_field_status
    !begin_status
    !writer_status
    !updated_i
    !created_i
    !thread_id
    !goal_key_ptr
    !goal_key_len
    !state_ptr
    !status
    !status_ptr
    !status_len
    !budget_null
    !budget
    !used
    !created
    !updated
    !obj_ptr
    !obj_len
    !req
    return 0

@ffi_wrapper send_rpc_goal_clear(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, thread_id: u64, &goal_key_ptr: ptr, goal_key_len: u64, cleared: u8) -> u32:
L_ENTRY:
    is_cleared = eq cleared, 1
    br is_cleared -> L_GOAL_CLR_TRUE, L_GOAL_CLR_FALSE

L_GOAL_CLR_TRUE:
    !is_cleared
    writer_slot = stack_alloc 8
    writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot)
    writer = load writer_slot+0 as ptr
    begin_status = call @sa_json_writer_begin_object(writer)
    cleared_status = call @sa_json_writer_field_bool(writer, &JSON_KEY_CLEARED, JSON_KEY_CLEARED_LEN, 1)
    notif_field_status = call @sa_json_writer_object_field(writer, &JSON_KEY_NOTIFICATION, JSON_KEY_NOTIFICATION_LEN)
    notif_begin_status = call @sa_json_writer_begin_object(writer)
    method_status = call @sa_json_writer_field_string(writer, &JSON_KEY_METHOD, JSON_KEY_METHOD_LEN, &JSON_VALUE_THREAD_GOAL_CLEARED, JSON_VALUE_THREAD_GOAL_CLEARED_LEN)
    params_field_status = call @sa_json_writer_object_field(writer, &JSON_KEY_PARAMS, JSON_KEY_PARAMS_LEN)
    params_begin_status = call @sa_json_writer_begin_object(writer)
    thread_status = call @json_writer_field_thread_id_goal_key(writer, &JSON_KEY_THREAD_ID, JSON_KEY_THREAD_ID_LEN, &state_ptr, thread_id, &goal_key_ptr, goal_key_len)
    params_end_status = call @sa_json_writer_end_object(writer)
    notif_end_status = call @sa_json_writer_end_object(writer)
    end_status = call @sa_json_writer_end_object(writer)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !end_status
    !notif_end_status
    !params_end_status
    !thread_status
    !params_begin_status
    !params_field_status
    !method_status
    !notif_begin_status
    !notif_field_status
    !cleared_status
    !begin_status
    !writer_status
    !thread_id
    !goal_key_ptr
    !goal_key_len
    !state_ptr
    !cleared
    !req
    return 0

L_GOAL_CLR_FALSE:
    !is_cleared
    writer_slot_false = stack_alloc 8
    writer_status_false = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot_false)
    writer_false = load writer_slot_false+0 as ptr
    begin_status_false = call @sa_json_writer_begin_object(writer_false)
    cleared_status_false = call @sa_json_writer_field_bool(writer_false, &JSON_KEY_CLEARED, JSON_KEY_CLEARED_LEN, 0)
    notif_status_false = call @sa_json_writer_field_null(writer_false, &JSON_KEY_NOTIFICATION, JSON_KEY_NOTIFICATION_LEN)
    end_status_false = call @sa_json_writer_end_object(writer_false)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer_false)
    !end_status_false
    !notif_status_false
    !cleared_status_false
    !begin_status_false
    !writer_status_false
    !thread_id
    !goal_key_ptr
    !goal_key_len
    !state_ptr
    !cleared
    !req
    return 0

