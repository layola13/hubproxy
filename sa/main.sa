@ffi_wrapper send_rpc_mock_experimental(&req: ptr, &id_ptr: ptr, id_len: u64, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    root = call @sa_json_parse(&body, body_len)
    has_root = ne root, 0
    br has_root -> L_MOCK_ROOT, L_MOCK_DEFAULT_NO_ROOT

L_MOCK_ROOT:
    !has_root
    params_slot = stack_alloc 8
    params_status = call @sa_json_object_get(root, &FB_KEY_PARAMS, FB_KEY_PARAMS_LEN, &params_slot)
    params_ok = eq params_status, 0
    br params_ok -> L_MOCK_PARAMS, L_MOCK_NO_PARAMS

L_MOCK_PARAMS:
    !params_ok
    params_node = load params_slot+0 as ptr
    value_slot = stack_alloc 8
    value_status = call @sa_json_object_get(params_node, &FB_KEY_VALUE, FB_KEY_VALUE_LEN, &value_slot)
    value_ok = eq value_status, 0
    br value_ok -> L_MOCK_VALUE, L_MOCK_NO_VALUE

L_MOCK_VALUE:
    !value_ok
    value_node = load value_slot+0 as ptr
    result = call @rpc_builder_new()
    call @rpc_builder_append(&result, &J_MOCK_A, J_MOCK_A_LEN)
    raw_status = call @append_json_node_raw(&result, value_node)
    !raw_status
    call @rpc_builder_append(&result, &J_MOCK_B, J_MOCK_B_LEN)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result)
    value_free = call @sa_json_free(^value_node)
    !value_free
    params_free = call @sa_json_free(^params_node)
    !params_free
    root_free = call @sa_json_free(^root)
    !root_free
    !value_status
    !params_status
    !body
    !body_len
    !req
    return 0

L_MOCK_NO_VALUE:
    !value_ok
    params_free_no_value = call @sa_json_free(^params_node)
    !params_free_no_value
    root_free_no_value = call @sa_json_free(^root)
    !root_free_no_value
    result_default = call @rpc_builder_new()
    call @rpc_builder_append(&result_default, &J_MOCK_A, J_MOCK_A_LEN)
    call @rpc_builder_append(&result_default, &J_NULL, J_NULL_LEN)
    call @rpc_builder_append(&result_default, &J_MOCK_B, J_MOCK_B_LEN)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result_default)
    !value_status
    !params_status
    !body
    !body_len
    !req
    return 0

L_MOCK_NO_PARAMS:
    !params_ok
    root_free_no_params = call @sa_json_free(^root)
    !root_free_no_params
    result_no_params = call @rpc_builder_new()
    call @rpc_builder_append(&result_no_params, &J_MOCK_A, J_MOCK_A_LEN)
    call @rpc_builder_append(&result_no_params, &J_NULL, J_NULL_LEN)
    call @rpc_builder_append(&result_no_params, &J_MOCK_B, J_MOCK_B_LEN)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result_no_params)
    !params_status
    !body
    !body_len
    !req
    return 0

L_MOCK_DEFAULT_NO_ROOT:
    !has_root
    result_no_root = call @rpc_builder_new()
    call @rpc_builder_append(&result_no_root, &J_MOCK_A, J_MOCK_A_LEN)
    call @rpc_builder_append(&result_no_root, &J_NULL, J_NULL_LEN)
    call @rpc_builder_append(&result_no_root, &J_MOCK_B, J_MOCK_B_LEN)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result_no_root)
    !body
    !body_len
    !req
    return 0

@ffi_wrapper send_rpc_thread_inject_items(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    thread_id = call @rpc_resolve_thread_id(&state_ptr, &body, body_len, 0)
    thread_slot = call @state_thread_find(&state_ptr, thread_id)
    missing = eq thread_slot, 0
    br missing -> L_INJECT_NOT_FOUND, L_INJECT_FOUND

L_INJECT_FOUND:
    !missing
    !thread_slot
    items_ptr_slot = stack_alloc 8
    items_len_slot = stack_alloc 8
    items_status = call @rpc_extract_array_after(&body, body_len, &J_ITEMS_ARRAY_KEY, J_ITEMS_ARRAY_KEY_LEN, &items_ptr_slot, &items_len_slot)
    has_items = eq items_status, 1
    br has_items -> L_INJECT_WITH_ITEMS, L_INJECT_EMPTY_ITEMS

L_INJECT_EMPTY_ITEMS:
    !has_items
    !items_status
    empty_items_ptr = &CHAT_FB_ARRAY_CLOSE
    store items_ptr_slot+0, empty_items_ptr as ptr
    store items_len_slot+0, CHAT_FB_ARRAY_CLOSE_LEN as u64
    !empty_items_ptr
    jmp L_INJECT_CREATE

L_INJECT_WITH_ITEMS:
    !has_items
    !items_status
    jmp L_INJECT_CREATE

L_INJECT_CREATE:
    items_ptr = load items_ptr_slot+0 as ptr
    items_len = load items_len_slot+0 as u64
    new_turn_id = call @state_turn_create(&state_ptr, thread_id)
    set_items_status = call @state_turn_set_items(&state_ptr, thread_id, new_turn_id, &items_ptr, items_len)
    !set_items_status
    injected_count = call @notify_injected_items_from_dom(&state_ptr, &body, body_len, thread_id, new_turn_id)
    jmp L_INJECT_RESP

L_INJECT_RESP:
    result = call @rpc_builder_new()
    call @rpc_builder_append(&result, &J_INJECT_A, J_INJECT_A_LEN)
    call @rpc_builder_append_thread_id_inner(&result, &state_ptr, thread_id)
    call @rpc_builder_append(&result, &J_INJECT_B, J_INJECT_B_LEN)
    call @rpc_builder_append_u64(&result, injected_count)
    call @rpc_builder_append(&result, &J_INJECT_C, J_INJECT_C_LEN)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result)
    !injected_count
    !new_turn_id
    !items_ptr
    !items_len
    !thread_id
    !state_ptr
    !body
    !body_len
    !req
    return 0

L_INJECT_NOT_FOUND:
    !missing
    !thread_slot
    call @send_error_with_id(&req, 404, &id_ptr, id_len, &J_ERR_THREAD_NOT_FOUND, J_ERR_THREAD_NOT_FOUND_LEN)
    !thread_id
    !state_ptr
    !body
    !body_len
    !req
    return 0

@ffi_wrapper send_rpc_thread_simple_id(&req: ptr, &id_ptr: ptr, id_len: u64, &body: ptr, body_len: u64, &prefix: ptr, prefix_len: u64, &suffix: ptr, suffix_len: u64) -> u32:
