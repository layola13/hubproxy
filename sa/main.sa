    call @send_rpc_goal_obj(&req, &rpc_id_ptr, rpc_id_len, &state_ptr, gs_thread_id, &gs_out_key_ptr, gs_out_key_len, gs_goal_status, &gs_out_status_ptr, gs_out_status_len, gs_budget_null, gs_budget, 0, gs_created, gs_updated, &gs_out_obj_ptr, gs_out_obj_len)
