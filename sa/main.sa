    call @rpc_builder_append_u64(&frame, thread_id)
    call @rpc_builder_append(&frame, &J_EVT_CLOSE, J_EVT_CLOSE_LEN)
    call @rpc_builder_append(&frame, &SSE_FRAME_END, SSE_FRAME_END_LEN)
    call @notify_push_frame(&state_ptr, ^frame)
    !event_ptr
    !event_len
    !thread_id
    !state_ptr
    return 0

@ffi_wrapper notify_thread_id_string(&state_ptr: ptr, &event_ptr: ptr, event_len: u64, &thread_ptr: ptr, thread_len: u64) -> u32:
L_ENTRY:
    frame = call @rpc_builder_new()
    call @notify_frame_begin(&frame, &event_ptr, event_len)
    call @rpc_builder_append(&frame, &J_EVT_THREAD_ID_A, J_EVT_THREAD_ID_A_LEN)
    call @rpc_builder_append(&frame, &thread_ptr, thread_len)
    call @rpc_builder_append(&frame, &J_QUOTE, J_QUOTE_LEN)
    call @rpc_builder_append(&frame, &J_EVT_CLOSE, J_EVT_CLOSE_LEN)
    call @rpc_builder_append(&frame, &SSE_FRAME_END, SSE_FRAME_END_LEN)
    call @notify_push_frame(&state_ptr, ^frame)
    !event_ptr
    !event_len
    !thread_ptr
    !thread_len
    !state_ptr
    return 0

@ffi_wrapper notify_thread_name_updated(&state_ptr: ptr, thread_id: u64, &name_ptr: ptr, name_len: u64, is_set: u8) -> u32:
L_ENTRY:
    frame = call @rpc_builder_new()
    call @notify_frame_begin(&frame, &EV_THREAD_NAME_UPDATED, EV_THREAD_NAME_UPDATED_LEN)
    call @rpc_builder_append(&frame, &J_THREAD_NAME_A, J_THREAD_NAME_A_LEN)
    call @rpc_builder_append_u64(&frame, thread_id)
    call @rpc_builder_append(&frame, &J_THREAD_NAME_B, J_THREAD_NAME_B_LEN)
    call @rpc_builder_append_nullable_string(&frame, &name_ptr, name_len, is_set)
    call @rpc_builder_append(&frame, &J_EVT_CLOSE, J_EVT_CLOSE_LEN)
    call @rpc_builder_append(&frame, &SSE_FRAME_END, SSE_FRAME_END_LEN)
    call @notify_push_frame(&state_ptr, ^frame)
    !thread_id
    !name_ptr
    !name_len
    !is_set
    !state_ptr
    return 0

@ffi_wrapper notify_goal_updated(&state_ptr: ptr, thread_id: u64, budget: u64, used: u64, &obj_ptr: ptr, obj_len: u64) -> u32:
L_ENTRY:
    frame = call @rpc_builder_new()
    call @notify_frame_begin(&frame, &EV_GOAL_UPDATED, EV_GOAL_UPDATED_LEN)
    call @rpc_builder_append(&frame, &J_EVT_THREAD_ID_A, J_EVT_THREAD_ID_A_LEN)
    call @rpc_builder_append_u64(&frame, thread_id)
    call @rpc_builder_append(&frame, &J_EVT_GOAL_B, J_EVT_GOAL_B_LEN)
    call @rpc_builder_append(&frame, &J_GOAL_OBJ_A, J_GOAL_OBJ_A_LEN)
    call @rpc_builder_append_u64(&frame, thread_id)
    call @rpc_builder_append(&frame, &J_GOAL_OBJ_B, J_GOAL_OBJ_B_LEN)
    call @rpc_builder_append_json_string(&frame, &obj_ptr, obj_len)
    call @rpc_builder_append(&frame, &J_GOAL_OBJ_B2, J_GOAL_OBJ_B2_LEN)
    call @rpc_builder_append_u64(&frame, budget)
    call @rpc_builder_append(&frame, &J_GOAL_OBJ_C, J_GOAL_OBJ_C_LEN)
    call @rpc_builder_append_u64(&frame, used)
    call @rpc_builder_append_goal_tail(&frame)
    call @rpc_builder_append(&frame, &J_EVT_CLOSE, J_EVT_CLOSE_LEN)
    call @rpc_builder_append(&frame, &SSE_FRAME_END, SSE_FRAME_END_LEN)
    call @notify_push_frame(&state_ptr, ^frame)
    !thread_id
    !budget
    !used
    !obj_ptr
    !obj_len
    !state_ptr
    return 0

@ffi_wrapper notify_turn_started(&state_ptr: ptr, thread_id: u64, turn_id: u64) -> u32:
L_ENTRY:
    frame = call @rpc_builder_new()
    call @notify_frame_begin(&frame, &EV_TURN_STARTED, EV_TURN_STARTED_LEN)
    call @rpc_builder_append(&frame, &J_EVT_THREAD_ID_A, J_EVT_THREAD_ID_A_LEN)
    call @rpc_builder_append_u64(&frame, thread_id)
    call @rpc_builder_append(&frame, &J_EVT_TURN_OBJ_B, J_EVT_TURN_OBJ_B_LEN)
    slot = call @state_turn_find(&state_ptr, thread_id, turn_id)
    missing = eq slot, 0
    br missing -> L_NOTIFY_TURN_STARTED_APPEND_NULL_MODE, L_NOTIFY_TURN_STARTED_APPEND_MODE

L_NOTIFY_TURN_STARTED_APPEND_MODE:
    !missing
    mode = load slot+TURN_MODE as u8
    call @rpc_builder_append_turn_mode(&frame, turn_id, mode)
    !mode
    !slot
    jmp L_NOTIFY_TURN_STARTED_CLOSE

L_NOTIFY_TURN_STARTED_APPEND_NULL_MODE:
    !missing
    !slot
    call @rpc_builder_append_turn(&frame, turn_id)
    jmp L_NOTIFY_TURN_STARTED_CLOSE

L_NOTIFY_TURN_STARTED_CLOSE:
    call @rpc_builder_append(&frame, &J_EVT_CLOSE, J_EVT_CLOSE_LEN)
    call @rpc_builder_append(&frame, &SSE_FRAME_END, SSE_FRAME_END_LEN)
    call @notify_push_frame(&state_ptr, ^frame)
    !thread_id
    !turn_id
    !state_ptr
    return 0

@ffi_wrapper notify_turn_completed(&state_ptr: ptr, thread_id: u64, turn_id: u64) -> u32:
L_ENTRY:
    frame = call @rpc_builder_new()
    call @notify_frame_begin(&frame, &EV_TURN_COMPLETED, EV_TURN_COMPLETED_LEN)
    call @rpc_builder_append(&frame, &J_EVT_THREAD_ID_A, J_EVT_THREAD_ID_A_LEN)
    call @rpc_builder_append_u64(&frame, thread_id)
    call @rpc_builder_append(&frame, &J_EVT_TURN_OBJ_B, J_EVT_TURN_OBJ_B_LEN)
    call @rpc_builder_append_turn_status(&frame, turn_id, 2)
    call @rpc_builder_append(&frame, &J_EVT_CLOSE, J_EVT_CLOSE_LEN)
    call @rpc_builder_append(&frame, &SSE_FRAME_END, SSE_FRAME_END_LEN)
    call @notify_push_frame(&state_ptr, ^frame)
    !thread_id
    !turn_id
    !state_ptr
    return 0

