    call @rpc_builder_append(&result, &CHAT_FB_ARRAY_CLOSE, CHAT_FB_ARRAY_CLOSE_LEN)
    call @rpc_builder_append(&result, &J_PLUGIN_SHARE_UPDATE_B, J_PLUGIN_SHARE_UPDATE_B_LEN)
