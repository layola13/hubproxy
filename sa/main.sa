    store gs_key_len_slot+0, 0 as u64
    gs_key_extract = call @rpc_extract_string_after(&rpc_body_ptr, rpc_body_len, &J_THREADID_KEY, J_THREADID_KEY_LEN, &gs_key_ptr_slot, &gs_key_len_slot)
