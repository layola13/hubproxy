    host_ptr = load cfg_ptr+CFG_HOST_PTR as ptr
    host_len = load cfg_ptr+CFG_HOST_LEN as u64
    port = load cfg_ptr+CFG_PORT as u16
    port_u64 = zext port
    uuid_buf = call @sa_deno_random_uuid()
    uuid_ptr = call @sa_fmt_buffer_data(uuid_buf)
    uuid_len = call @sa_fmt_buffer_len(uuid_buf)
    result = call @rpc_builder_new()
    call @rpc_builder_append(&result, &J_PLUGIN_SHARE_SAVE_A, J_PLUGIN_SHARE_SAVE_A_LEN)
    call @rpc_builder_append(&result, &uuid_ptr, uuid_len)
    call @rpc_builder_append(&result, &J_PLUGIN_SHARE_SAVE_B, J_PLUGIN_SHARE_SAVE_B_LEN)
    call @rpc_builder_append(&result, &host_ptr, host_len)
    call @rpc_builder_append(&result, &J_PLUGIN_SHARE_SAVE_C, J_PLUGIN_SHARE_SAVE_C_LEN)
    call @rpc_builder_append_u64(&result, port_u64)
    call @rpc_builder_append(&result, &J_PLUGIN_SHARE_SAVE_D, J_PLUGIN_SHARE_SAVE_D_LEN)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result)
    uuid_free_status = call @sa_fmt_buffer_free(^uuid_buf)
    !uuid_free_status
    !uuid_ptr
    !uuid_len
    !host_ptr
    !host_len
    !port
    !port_u64
    !cfg_ptr
    !req
    return 0

