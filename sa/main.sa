// ============================================================
// Helper: send_rpc_json(req, status_code, json_ptr, json_len)
// Sends a JSON response on the given request.
// ============================================================
@ffi_wrapper send_rpc_json(&req: ptr, status: u16, &json_ptr: ptr, json_len: u64) -> u32:
L_ENTRY:
    resp_slot = stack_alloc 8
    s = call @sa_http_server_resp_new(req, status, &resp_slot)
    resp = load resp_slot+0 as ptr
    send_s = call @sa_http_server_resp_send(resp, &json_ptr, json_len)
    !send_s
    !s
    call @sa_http_server_resp_free(^resp)
    return 0

@ffi_wrapper send_json_response(&req: ptr, status: u16, &json_ptr: ptr, json_len: u64) -> u32:
L_ENTRY:
    resp_slot = stack_alloc 8
    s = call @sa_http_server_resp_new(req, status, &resp_slot)
    resp = load resp_slot+0 as ptr
    ct_s = call @sa_http_server_resp_set_content_type(resp, &MIME_JSON, MIME_JSON_LEN)
    send_s = call @sa_http_server_resp_send(resp, &json_ptr, json_len)
    !send_s
    !ct_s
    !s
    call @sa_http_server_resp_free(^resp)
    return 0

@ffi_wrapper log_append_token_preview(&buf: ptr, &token_ptr: ptr, token_len: u64) -> u32:
L_ENTRY:
    no_token = eq token_len, 0
    br no_token -> L_LOG_TOKEN_NONE, L_LOG_TOKEN_PREP

L_LOG_TOKEN_NONE:
    !no_token
    call @rpc_builder_append(&buf, &LOG_PREVIEW_NONE, LOG_PREVIEW_NONE_LEN)
    !buf
    !token_ptr
    !token_len
    return 0

L_LOG_TOKEN_PREP:
    !no_token
    prefix_len = add token_len, 0
    prefix_big = ugt prefix_len, 3
    br prefix_big -> L_LOG_PREFIX_THREE, L_LOG_PREFIX_KEEP

L_LOG_PREFIX_THREE:
    !prefix_big
    !prefix_len
    prefix_len2 = add 3, 0
    jmp L_LOG_TOKEN_APPEND_PREFIX

L_LOG_PREFIX_KEEP:
    !prefix_big
    prefix_len2 = add prefix_len, 0
    !prefix_len
    jmp L_LOG_TOKEN_APPEND_PREFIX

L_LOG_TOKEN_APPEND_PREFIX:
    call @rpc_builder_append(&buf, &token_ptr, prefix_len2)
    call @rpc_builder_append(&buf, &LOG_PREVIEW_ELLIPSIS, LOG_PREVIEW_ELLIPSIS_LEN)
    suffix_len = add token_len, 0
    suffix_big = ugt suffix_len, 3
    br suffix_big -> L_LOG_SUFFIX_THREE, L_LOG_SUFFIX_KEEP

L_LOG_SUFFIX_THREE:
    !suffix_big
    !suffix_len
    suffix_len2 = add 3, 0
    jmp L_LOG_TOKEN_APPEND_SUFFIX

L_LOG_SUFFIX_KEEP:
    !suffix_big
    suffix_len2 = add suffix_len, 0
    !suffix_len
    jmp L_LOG_TOKEN_APPEND_SUFFIX

L_LOG_TOKEN_APPEND_SUFFIX:
    suffix_start = sub token_len, suffix_len2
    suffix_ptr = ptr_add token_ptr, suffix_start
    call @rpc_builder_append(&buf, &suffix_ptr, suffix_len2)
    call @rpc_builder_append(&buf, &LOG_PREVIEW_LEN_A, LOG_PREVIEW_LEN_A_LEN)
    len_buf = stack_alloc 32
    len_out_slot = stack_alloc 8
    fmt_status = call @sa_fmt_u64_into(token_len, 10, len_buf, 32, &len_out_slot)
    len_text_len = load len_out_slot+0 as u64
    !fmt_status
    call @rpc_builder_append(&buf, &len_buf, len_text_len)
    call @rpc_builder_append(&buf, &LOG_PREVIEW_LEN_B, LOG_PREVIEW_LEN_B_LEN)
    !len_text_len
    !suffix_ptr
    !suffix_start
    !suffix_len2
    !prefix_len2
    !buf
    !token_ptr
    !token_len
    return 0

@ffi_wrapper json_writer_field_token_preview(writer: ptr, &key: ptr, key_len: u64, &token_ptr: ptr, token_len: u64) -> u32:
L_ENTRY:
    no_token = eq token_len, 0
    br no_token -> L_JW_LOG_TOKEN_NONE, L_JW_LOG_TOKEN_PREP

L_JW_LOG_TOKEN_NONE:
    !no_token
    field_none = call @sa_json_writer_field_string(writer, &key, key_len, &LOG_PREVIEW_NONE, LOG_PREVIEW_NONE_LEN)
    !field_none
    !writer
    !key
    !key_len
    !token_ptr
    !token_len
    return 0

L_JW_LOG_TOKEN_PREP:
    !no_token
    prefix_len = add token_len, 0
    prefix_big = ugt prefix_len, 3
    br prefix_big -> L_JW_LOG_PREFIX_THREE, L_JW_LOG_PREFIX_KEEP

L_JW_LOG_PREFIX_THREE:
    !prefix_big
    !prefix_len
    prefix_len2 = add 3, 0
    jmp L_JW_LOG_SUFFIX_PREP

L_JW_LOG_PREFIX_KEEP:
    !prefix_big
    prefix_len2 = add prefix_len, 0
    !prefix_len
    jmp L_JW_LOG_SUFFIX_PREP

L_JW_LOG_SUFFIX_PREP:
    suffix_len = add token_len, 0
    suffix_big = ugt suffix_len, 3
    br suffix_big -> L_JW_LOG_SUFFIX_THREE, L_JW_LOG_SUFFIX_KEEP

L_JW_LOG_SUFFIX_THREE:
    !suffix_big
    !suffix_len
    suffix_len2 = add 3, 0
    jmp L_JW_LOG_BUILD

L_JW_LOG_SUFFIX_KEEP:
    !suffix_big
    suffix_len2 = add suffix_len, 0
    !suffix_len
    jmp L_JW_LOG_BUILD

L_JW_LOG_BUILD:
    len_buf = stack_alloc 32
    len_out_slot = stack_alloc 8
    fmt_status = call @sa_fmt_u64_into(token_len, 10, len_buf, 32, &len_out_slot)
    !fmt_status
    len_text_len = load len_out_slot+0 as u64
    part_a_len = add prefix_len2, LOG_PREVIEW_ELLIPSIS_LEN
    part_b_len = add part_a_len, suffix_len2
    part_c_len = add part_b_len, LOG_PREVIEW_LEN_A_LEN
    part_d_len = add part_c_len, len_text_len
    preview_len = add part_d_len, LOG_PREVIEW_LEN_B_LEN
    suffix_start = sub token_len, suffix_len2
    suffix_ptr = ptr_add token_ptr, suffix_start
    preview1_len_slot = stack_alloc 8
    preview1 = call @build_concat_owned(&token_ptr, prefix_len2, &LOG_PREVIEW_ELLIPSIS, LOG_PREVIEW_ELLIPSIS_LEN, &preview1_len_slot)
    preview1_len = load preview1_len_slot+0 as u64
    preview2_len_slot = stack_alloc 8
    preview2 = call @build_concat_owned(&preview1, preview1_len, &suffix_ptr, suffix_len2, &preview2_len_slot)
    preview2_len = load preview2_len_slot+0 as u64
    preview3_len_slot = stack_alloc 8
    preview3 = call @build_concat_owned(&preview2, preview2_len, &LOG_PREVIEW_LEN_A, LOG_PREVIEW_LEN_A_LEN, &preview3_len_slot)
    preview3_len = load preview3_len_slot+0 as u64
    preview4_len_slot = stack_alloc 8
    preview4 = call @build_concat_owned(&preview3, preview3_len, &len_buf, len_text_len, &preview4_len_slot)
    preview4_len = load preview4_len_slot+0 as u64
    preview_len_slot = stack_alloc 8
    preview = call @build_concat_owned(&preview4, preview4_len, &LOG_PREVIEW_LEN_B, LOG_PREVIEW_LEN_B_LEN, &preview_len_slot)
    preview_len2 = load preview_len_slot+0 as u64
    field_preview = call @sa_json_writer_field_string(writer, &key, key_len, &preview, preview_len2)
    !field_preview
    !suffix_ptr
    !suffix_start
    !preview
    !preview_len2
    !preview4
    !preview4_len
    !preview3
    !preview3_len
    !preview2
    !preview2_len
    !preview1
    !preview1_len
    !part_d_len
    !part_c_len
    !part_b_len
    !part_a_len
    !len_text_len
    !suffix_len2
    !prefix_len2
    !writer
    !key
    !key_len
    !token_ptr
    !token_len
    return 0

@ffi_wrapper write_auth_failure_log(&req: ptr, &cfg_ptr: ptr, &path_ptr: ptr, path_len: u64, &token_ptr: ptr, token_len: u64) -> u32:
L_ENTRY:
    log_dir_ptr = load cfg_ptr+CFG_LOG_PTR as ptr
    log_dir_len = load cfg_ptr+CFG_LOG_LEN as u64
    has_log = ugt log_dir_len, 0
    br has_log -> L_AUTH_LOG_BUILD, L_AUTH_LOG_SKIP

L_AUTH_LOG_SKIP:
    !has_log
    !log_dir_ptr
    !log_dir_len
    !req
    !cfg_ptr
    !path_ptr
    !path_len
    !token_ptr
    !token_len
    return 0

L_AUTH_LOG_BUILD:
    !has_log
    mkdir_status = call @sa_deno_plugin_mkdir(&log_dir_ptr, log_dir_len, 1)
    !mkdir_status
    file_len_slot = stack_alloc 8
    file_path = call @build_proxy_url(&log_dir_ptr, log_dir_len, &LOG_FILE_AUTH_SUFFIX, LOG_FILE_AUTH_SUFFIX_LEN, &file_len_slot)
    file_len = load file_len_slot+0 as u64
    writer_slot = stack_alloc 8
    buffer_slot = stack_alloc 8
    writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot)
    writer = load writer_slot+0 as ptr
    begin_status = call @sa_json_writer_begin_object(writer)
    kind_status = call @sa_json_writer_field_string(writer, &JSON_KEY_KIND, JSON_KEY_KIND_LEN, &JSON_VALUE_AUTH_FAILURE, JSON_VALUE_AUTH_FAILURE_LEN)
    path_status = call @sa_json_writer_field_string(writer, &JSON_KEY_PATH, JSON_KEY_PATH_LEN, &path_ptr, path_len)
    log_auth_slot = stack_alloc 8
    log_auth_len_slot = stack_alloc 8
    store log_auth_slot+0, 0 as ptr
    store log_auth_len_slot+0, 0 as u64
    hdr_status = call @sa_http_server_req_get_header(req, &HDR_AUTH, HDR_AUTH_LEN, &log_auth_slot, &log_auth_len_slot)
    hdr_ptr = load log_auth_slot+0 as ptr
    hdr_len = load log_auth_len_slot+0 as u64
    !hdr_status
    has_hdr = ne hdr_ptr, 0
    br has_hdr -> L_AUTH_LOG_HEADER_PREVIEW, L_AUTH_LOG_HEADER_NONE

L_AUTH_LOG_HEADER_PREVIEW:
    !has_hdr
    bearer_idx = call @sa_bytes_find(&hdr_ptr, hdr_len, &BEARER_PREFIX, BEARER_PREFIX_LEN)
    has_bearer = sge bearer_idx, 0
    br has_bearer -> L_AUTH_LOG_HEADER_STRIP, L_AUTH_LOG_HEADER_RAW

L_AUTH_LOG_HEADER_STRIP:
    !has_bearer
    !bearer_idx
    client_ptr = ptr_add hdr_ptr, BEARER_PREFIX_LEN
    client_len = sub hdr_len, BEARER_PREFIX_LEN
    preview_status = call @json_writer_field_token_preview(writer, &JSON_KEY_AUTHORIZATION, JSON_KEY_AUTHORIZATION_LEN, &client_ptr, client_len)
    !preview_status
    !client_ptr
    !client_len
    !hdr_ptr
    !hdr_len
    jmp L_AUTH_LOG_EXPECTED

L_AUTH_LOG_HEADER_RAW:
    !has_bearer
    !bearer_idx
    client_ptr2 = ptr_add hdr_ptr, 0
    client_len2 = add hdr_len, 0
    preview_status2 = call @json_writer_field_token_preview(writer, &JSON_KEY_AUTHORIZATION, JSON_KEY_AUTHORIZATION_LEN, &client_ptr2, client_len2)
    !preview_status2
    !client_ptr2
    !client_len2
    !hdr_ptr
    !hdr_len
    jmp L_AUTH_LOG_EXPECTED

L_AUTH_LOG_HEADER_NONE:
    !has_hdr
    !hdr_ptr
    !hdr_len
    preview_none_status = call @json_writer_field_token_preview(writer, &JSON_KEY_AUTHORIZATION, JSON_KEY_AUTHORIZATION_LEN, &EMPTY_TEXT, 0)
    !preview_none_status
    jmp L_AUTH_LOG_EXPECTED

L_AUTH_LOG_EXPECTED:
    expected_status = call @json_writer_field_token_preview(writer, &JSON_KEY_EXPECTED_AUTH, JSON_KEY_EXPECTED_AUTH_LEN, &token_ptr, token_len)
    !expected_status
    end_status = call @sa_json_writer_end_object(writer)
    finish_status = call @sa_json_writer_finish(writer, &buffer_slot)
    buffer = load buffer_slot+0 as ptr
    body_ptr = call @sa_json_buffer_data(&buffer)
    body_len = call @sa_json_buffer_len(&buffer)
    write_status = call @sa_deno_plugin_write_text_file(&file_path, file_len, &body_ptr, body_len)
    !write_status
    buffer_free = call @sa_json_buffer_free(^buffer)
    writer_free = call @sa_json_writer_free(^writer)
    !writer_free
    !buffer_free
    !body_ptr
    !body_len
    !finish_status
    !end_status
    !path_status
    !kind_status
    !begin_status
    !writer_status
    !file_path
    !file_len
    !log_dir_ptr
    !log_dir_len
    !req
    !cfg_ptr
    !path_ptr
    !path_len
    !token_ptr
    !token_len
    return 0

@ffi_wrapper write_api_request_log(&req: ptr, &cfg_ptr: ptr, &path_ptr: ptr, path_len: u64, &method_ptr: ptr, method_len: u64, &body_ptr_in: ptr, body_len: u64) -> u32:
L_ENTRY:
    log_dir_ptr = load cfg_ptr+CFG_LOG_PTR as ptr
    log_dir_len = load cfg_ptr+CFG_LOG_LEN as u64
    has_log = ugt log_dir_len, 0
    br has_log -> L_REQ_LOG_BUILD, L_REQ_LOG_SKIP

L_REQ_LOG_SKIP:
    !has_log
    !log_dir_ptr
    !log_dir_len
    !req
    !cfg_ptr
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !body_ptr_in
    !body_len
    return 0

L_REQ_LOG_BUILD:
    !has_log
    mkdir_status = call @sa_deno_plugin_mkdir(&log_dir_ptr, log_dir_len, 1)
    !mkdir_status
    file_len_slot = stack_alloc 8
    file_path = call @build_proxy_url(&log_dir_ptr, log_dir_len, &LOG_FILE_REQ_SUFFIX, LOG_FILE_REQ_SUFFIX_LEN, &file_len_slot)
    file_len = load file_len_slot+0 as u64

    writer_slot = stack_alloc 8
    buffer_slot = stack_alloc 8
    writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot)
    writer = load writer_slot+0 as ptr
    begin_status = call @sa_json_writer_begin_object(writer)
    kind_status = call @sa_json_writer_field_string(writer, &JSON_KEY_KIND, JSON_KEY_KIND_LEN, &JSON_VALUE_REQUEST_LOG, JSON_VALUE_REQUEST_LOG_LEN)
    path_field_status = call @sa_json_writer_field_string(writer, &JSON_KEY_PATH, JSON_KEY_PATH_LEN, &path_ptr, path_len)
    method_status = call @sa_json_writer_field_string(writer, &JSON_KEY_METHOD, JSON_KEY_METHOD_LEN, &method_ptr, method_len)
    headers_field_status = call @sa_json_writer_object_field(writer, &JSON_KEY_HEADERS, JSON_KEY_HEADERS_LEN)
    headers_begin_status = call @sa_json_writer_begin_object(writer)
    auth_ptr_slot = stack_alloc 8
    auth_len_slot = stack_alloc 8
    store auth_ptr_slot+0, 0 as ptr
    store auth_len_slot+0, 0 as u64
    auth_hdr_status = call @sa_http_server_req_get_header(req, &HDR_AUTH, HDR_AUTH_LEN, &auth_ptr_slot, &auth_len_slot)
    auth_hdr_ptr = load auth_ptr_slot+0 as ptr
    auth_hdr_len = load auth_len_slot+0 as u64
    !auth_hdr_status
    auth_has_hdr = ne auth_hdr_ptr, 0
    br auth_has_hdr -> L_REQ_LOG_AUTH_HEADER, L_REQ_LOG_AUTH_NONE

L_REQ_LOG_AUTH_HEADER:
    !auth_has_hdr
    auth_bearer_idx = call @sa_bytes_find(&auth_hdr_ptr, auth_hdr_len, &BEARER_PREFIX, BEARER_PREFIX_LEN)
    auth_has_bearer = ne auth_bearer_idx, 18446744073709551615
    br auth_has_bearer -> L_REQ_LOG_AUTH_BEARER, L_REQ_LOG_AUTH_RAW

L_REQ_LOG_AUTH_BEARER:
    !auth_has_bearer
    token_start = add auth_bearer_idx, BEARER_PREFIX_LEN
    token_ptr = ptr_add auth_hdr_ptr, token_start
    token_len = sub auth_hdr_len, token_start
    token_preview_status = call @json_writer_field_token_preview(writer, &JSON_KEY_AUTHORIZATION, JSON_KEY_AUTHORIZATION_LEN, &token_ptr, token_len)
    !token_preview_status
    !token_ptr
    !token_len
    !token_start
    !auth_bearer_idx
    !auth_hdr_ptr
    !auth_hdr_len
    jmp L_REQ_LOG_X_API_KEY

L_REQ_LOG_AUTH_RAW:
    !auth_has_bearer
    !auth_bearer_idx
    auth_raw_ptr = ptr_add auth_hdr_ptr, 0
    auth_raw_len = add auth_hdr_len, 0
    auth_raw_status = call @json_writer_field_token_preview(writer, &JSON_KEY_AUTHORIZATION, JSON_KEY_AUTHORIZATION_LEN, &auth_raw_ptr, auth_raw_len)
    !auth_raw_status
    !auth_raw_ptr
    !auth_raw_len
    !auth_hdr_ptr
    !auth_hdr_len
    jmp L_REQ_LOG_X_API_KEY

L_REQ_LOG_AUTH_NONE:
    !auth_has_hdr
    !auth_hdr_ptr
    !auth_hdr_len
    auth_none_status = call @json_writer_field_token_preview(writer, &JSON_KEY_AUTHORIZATION, JSON_KEY_AUTHORIZATION_LEN, &EMPTY_TEXT, 0)
    !auth_none_status
    jmp L_REQ_LOG_X_API_KEY

L_REQ_LOG_X_API_KEY:
    xkey_ptr_slot = stack_alloc 8
    xkey_len_slot = stack_alloc 8
    store xkey_ptr_slot+0, 0 as ptr
    store xkey_len_slot+0, 0 as u64
    xkey_hdr_status = call @sa_http_server_req_get_header(req, &HDR_X_API_KEY, HDR_X_API_KEY_LEN, &xkey_ptr_slot, &xkey_len_slot)
    xkey_hdr_ptr = load xkey_ptr_slot+0 as ptr
    xkey_hdr_len = load xkey_len_slot+0 as u64
    !xkey_hdr_status
    xkey_has_hdr = ne xkey_hdr_ptr, 0
    br xkey_has_hdr -> L_REQ_LOG_XKEY_HEADER, L_REQ_LOG_XKEY_NONE

L_REQ_LOG_XKEY_HEADER:
    !xkey_has_hdr
    xkey_status = call @json_writer_field_token_preview(writer, &JSON_KEY_X_API_KEY, JSON_KEY_X_API_KEY_LEN, &xkey_hdr_ptr, xkey_hdr_len)
    !xkey_status
    !xkey_hdr_ptr
    !xkey_hdr_len
    jmp L_REQ_LOG_CONTENT_TYPE

L_REQ_LOG_XKEY_NONE:
    !xkey_has_hdr
    !xkey_hdr_ptr
    !xkey_hdr_len
    xkey_none_status = call @json_writer_field_token_preview(writer, &JSON_KEY_X_API_KEY, JSON_KEY_X_API_KEY_LEN, &EMPTY_TEXT, 0)
    !xkey_none_status
    jmp L_REQ_LOG_CONTENT_TYPE

L_REQ_LOG_CONTENT_TYPE:
    ct_ptr_slot = stack_alloc 8
    ct_len_slot = stack_alloc 8
    store ct_ptr_slot+0, 0 as ptr
    store ct_len_slot+0, 0 as u64
    ct_hdr_status = call @sa_http_server_req_get_header(req, &HDR_CONTENT_TYPE, HDR_CONTENT_TYPE_LEN, &ct_ptr_slot, &ct_len_slot)
    ct_hdr_ptr = load ct_ptr_slot+0 as ptr
    ct_hdr_len = load ct_len_slot+0 as u64
    !ct_hdr_status
    ct_has_hdr = ne ct_hdr_ptr, 0
    br ct_has_hdr -> L_REQ_LOG_CT_HEADER, L_REQ_LOG_CT_NONE

L_REQ_LOG_CT_HEADER:
    !ct_has_hdr
    ct_status = call @sa_json_writer_field_string(writer, &JSON_KEY_CONTENT_TYPE, JSON_KEY_CONTENT_TYPE_LEN, &ct_hdr_ptr, ct_hdr_len)
    !ct_status
    !ct_hdr_ptr
    !ct_hdr_len
    jmp L_REQ_LOG_BODY_BYTES

L_REQ_LOG_CT_NONE:
    !ct_has_hdr
    !ct_hdr_ptr
    !ct_hdr_len
    ct_none_status = call @sa_json_writer_field_string(writer, &JSON_KEY_CONTENT_TYPE, JSON_KEY_CONTENT_TYPE_LEN, &LOG_PREVIEW_NONE, LOG_PREVIEW_NONE_LEN)
    !ct_none_status
    jmp L_REQ_LOG_BODY_BYTES

L_REQ_LOG_BODY_BYTES:
    headers_end_status = call @sa_json_writer_end_object(writer)
    body_len_i64 = bitcast body_len as i64
    bytes_status = call @sa_json_writer_field_i64(writer, &JSON_KEY_BODY_BYTES, JSON_KEY_BODY_BYTES_LEN, body_len_i64)
    has_body = ugt body_len, 0
    br has_body -> L_REQ_LOG_BODY_TEXT, L_REQ_LOG_BODY_NULL

L_REQ_LOG_BODY_TEXT:
    !has_body
    body_field_status = call @sa_json_writer_field_string(writer, &JSON_KEY_BODY, JSON_KEY_BODY_LEN, &body_ptr_in, body_len)
    !body_field_status
    jmp L_REQ_LOG_FINISH

L_REQ_LOG_BODY_NULL:
    !has_body
    body_null_status = call @sa_json_writer_field_null(writer, &JSON_KEY_BODY, JSON_KEY_BODY_LEN)
    !body_null_status
    jmp L_REQ_LOG_FINISH

L_REQ_LOG_FINISH:
    end_status = call @sa_json_writer_end_object(writer)
    finish_status = call @sa_json_writer_finish(writer, &buffer_slot)
    buffer = load buffer_slot+0 as ptr
    body_ptr = call @sa_json_buffer_data(&buffer)
    log_body_len = call @sa_json_buffer_len(&buffer)
    write_status = call @sa_deno_plugin_write_text_file(&file_path, file_len, &body_ptr, log_body_len)
    !write_status
    buffer_free = call @sa_json_buffer_free(^buffer)
    writer_free = call @sa_json_writer_free(^writer)
    !writer_free
    !buffer_free
    !body_ptr
    !log_body_len
    !finish_status
    !end_status
    !bytes_status
    !body_len_i64
    !headers_end_status
    !headers_begin_status
    !headers_field_status
    !method_status
    !path_field_status
    !kind_status
    !begin_status
    !writer_status
    !file_path
    !file_len
    !log_dir_ptr
    !log_dir_len
    !req
    !cfg_ptr
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !body_ptr_in
    !body_len
    return 0

@ffi_wrapper body_is_blank(&body: ptr, body_len: u64) -> u32:
L_ENTRY:
    i_slot = stack_alloc 8
    store i_slot+0, 0 as u64
    jmp L_BODY_BLANK_COND

L_BODY_BLANK_COND:
    i = load i_slot+0 as u64
    done = uge i, body_len
    br done -> L_BODY_BLANK_YES, L_BODY_BLANK_CHECK

L_BODY_BLANK_CHECK:
    !done
    ch_ptr = ptr_add body, i
    ch = load ch_ptr+0 as u8
    is_space = eq ch, 32
    is_lf = eq ch, 10
    is_cr = eq ch, 13
    is_tab = eq ch, 9
    ws_a = or is_space, is_lf
    ws_b = or is_cr, is_tab
    is_ws = or ws_a, ws_b
    br is_ws -> L_BODY_BLANK_NEXT, L_BODY_BLANK_NO

L_BODY_BLANK_NEXT:
    !is_ws
    !ws_a
    !ws_b
    !is_space
    !is_lf
    !is_cr
    !is_tab
    !ch
    !ch_ptr
    next = add i, 1
    store i_slot+0, next as u64
    !next
    !i
    jmp L_BODY_BLANK_COND

L_BODY_BLANK_NO:
    !is_ws
    !ws_a
    !ws_b
    !is_space
    !is_lf
    !is_cr
    !is_tab
    !ch
    !ch_ptr
    !i
    !body
    !body_len
    return 0

L_BODY_BLANK_YES:
    !done
    !i
    !body
    !body_len
    return 1

@ffi_wrapper rpc_builder_new() -> ^ptr:
L_ENTRY:
    buf = alloc RPC_JSON_BUF_SIZE
    store buf+0, 0 as u64
    return buf

@ffi_wrapper rpc_builder_new_capacity(capacity: u64) -> ^ptr:
L_ENTRY:
    total = add capacity, 8
    buf = alloc total
    store buf+0, 0 as u64
    !total
    !capacity
    return buf

@ffi_wrapper rpc_builder_len(&buf: ptr) -> u64:
L_ENTRY:
    len = load buf+0 as u64
    !buf
    return len

@ffi_wrapper rpc_builder_data(&buf: ptr) -> &ptr:
L_ENTRY:
    data = ptr_add buf, 8
    raw_data = *data
    view = assume_borrow raw_data
    !data
    !buf
    return view

@ffi_wrapper rpc_builder_append(&buf: ptr, &src: ptr, src_len: u64) -> u32:
L_ENTRY:
    cur = load buf+0 as u64
    dst_base = ptr_add buf, 8
    dst = ptr_add dst_base, cur
    copied = call @sa_bytes_copy(&dst, &src, src_len)
    next = add cur, copied
    store buf+0, next as u64
    !next
    !copied
    !dst
    !dst_base
    !cur
    !buf
    !src
    !src_len
    return 0

@ffi_wrapper build_proxy_url(&base_ptr: ptr, base_len: u64, &suffix_ptr: ptr, suffix_len: u64, &out_len: ptr) -> ^ptr:
L_ENTRY:
    joined_str = call @sa_string_concat(base_ptr, base_len, suffix_ptr, suffix_len)
    joined_ptr = call @sa_fmt_buffer_data(joined_str)
    joined_len = call @sa_fmt_buffer_len(joined_str)
    out_ptr = alloc joined_len
    out_copy = call @sa_bytes_copy(&out_ptr, &joined_ptr, joined_len)
    joined_free = call @sa_fmt_buffer_free(^joined_str)
    store out_len+0, joined_len as u64
    !joined_free
    !out_copy
    !joined_len
    !joined_ptr
    !base_ptr
    !base_len
    !suffix_ptr
    !suffix_len
    !out_len
    return out_ptr

@ffi_wrapper build_bearer_auth_header(&token_ptr: ptr, token_len: u64, &out_len: ptr) -> ^ptr:
L_ENTRY:
    out_ptr = call @build_concat_owned(&BEARER_PREFIX, BEARER_PREFIX_LEN, &token_ptr, token_len, &out_len)
    !token_ptr
    !token_len
    !out_len
    return out_ptr

@ffi_wrapper build_concat_owned(&left_ptr: ptr, left_len: u64, &right_ptr: ptr, right_len: u64, &out_len: ptr) -> ^ptr:
L_ENTRY:
    joined_str = call @sa_string_concat(left_ptr, left_len, right_ptr, right_len)
    joined_ptr = call @sa_fmt_buffer_data(joined_str)
    joined_len = call @sa_fmt_buffer_len(joined_str)
    out_ptr = alloc joined_len
    out_copy = call @sa_bytes_copy(&out_ptr, &joined_ptr, joined_len)
    joined_free = call @sa_fmt_buffer_free(^joined_str)
    store out_len+0, joined_len as u64
    !joined_free
    !out_copy
    !joined_len
    !joined_ptr
    !left_ptr
    !left_len
    !right_ptr
    !right_len
    !out_len
    return out_ptr

@ffi_wrapper build_http_url(&host_ptr: ptr, host_len: u64, port_u64: u64, &suffix_ptr: ptr, suffix_len: u64, &out_len: ptr) -> ^ptr:
L_ENTRY:
    port_buf = stack_alloc ID_BUF_SIZE
    port_len_slot = stack_alloc 8
    port_fmt_status = call @sa_fmt_u64_into(port_u64, 10, port_buf, ID_BUF_SIZE, &port_len_slot)
    port_len = load port_len_slot+0 as u64
    part1_len_slot = stack_alloc 8
    part1 = call @build_concat_owned(&STRING_HTTP_PREFIX, STRING_HTTP_PREFIX_LEN, &host_ptr, host_len, &part1_len_slot)
    part1_len = load part1_len_slot+0 as u64
    part2_len_slot = stack_alloc 8
    part2 = call @build_concat_owned(&part1, part1_len, &CHAT_PROXY_COLON, CHAT_PROXY_COLON_LEN, &part2_len_slot)
    part2_len = load part2_len_slot+0 as u64
    part3_len_slot = stack_alloc 8
    part3 = call @build_concat_owned(&part2, part2_len, &port_buf, port_len, &part3_len_slot)
    part3_len = load part3_len_slot+0 as u64
    final_ptr = call @build_concat_owned(&part3, part3_len, &suffix_ptr, suffix_len, &out_len)
    !part3_len
    !part2_len
    !part1_len
    !port_fmt_status
    !port_len
    !part3
    !part2
    !part1
    !host_ptr
    !host_len
    !port_u64
    !suffix_ptr
    !suffix_len
    return final_ptr

@ffi_wrapper http_response_read_all(resp: ptr, &out_ptr: ptr, &out_len: ptr) -> u32:
L_ENTRY:
    reader_slot = stack_alloc 8
    status = call @sa_http_client_resp_body_reader(resp, &reader_slot)
    reader = load reader_slot+0 as ptr
    body_buf = alloc FS_MAX_READ_BYTES
    chunk_buf = stack_alloc SSE_BUF_SIZE
    read_len_slot = stack_alloc 8
    offset_slot = stack_alloc 8
    store offset_slot+0, 0 as u64
    !status
    jmp L_READ_LOOP

L_READ_LOOP:
    read_status = call @sa_http_client_resp_read_chunk(reader, &chunk_buf, SSE_BUF_SIZE, &read_len_slot)
    read_len = load read_len_slot+0 as u64
    done = eq read_len, 0
    br done -> L_READ_DONE, L_READ_APPEND

L_READ_APPEND:
    !done
    offset = load offset_slot+0 as u64
    dst = ptr_add body_buf, offset
    copied = call @sa_bytes_copy(&dst, &chunk_buf, read_len)
    next_offset = add offset, copied
    store offset_slot+0, next_offset as u64
    !next_offset
    !copied
    !dst
    !offset
    !read_status
    !read_len
    jmp L_READ_LOOP

L_READ_DONE:
    !done
    !read_status
    final_len = load offset_slot+0 as u64
    store out_ptr+0, body_buf as ptr
    store out_len+0, final_len as u64
    free_status = call @sa_http_client_body_reader_free(^reader)
    !free_status
    !final_len
    !body_buf
    !read_len
    !resp
    !out_ptr
    !out_len
    return 0


@ffi_wrapper json_writer_field_thread_id_string(writer: ptr, &key: ptr, key_len: u64, &state_ptr: ptr, thread_id: u64) -> u32:
L_ENTRY:
    slot = call @state_thread_find(&state_ptr, thread_id)
    missing = eq slot, 0
    br missing -> L_JW_TID_NUMERIC_MISSING, L_JW_TID_SLOT

L_JW_TID_SLOT:
    !missing
    stored_key_len = load slot+THR_KEY_LEN as u64
    has_key = ugt stored_key_len, 0
    br has_key -> L_JW_TID_KEY, L_JW_TID_NUMERIC_SLOT

L_JW_TID_KEY:
    !has_key
    stored_key_ptr = ptr_add slot, THR_KEY
    field_status = call @sa_json_writer_field_string(writer, &key, key_len, &stored_key_ptr, stored_key_len)
    !field_status
    !stored_key_ptr
    !stored_key_len
    !slot
    !writer
    !key
    !key_len
    !state_ptr
    !thread_id
    return 0

L_JW_TID_NUMERIC_SLOT:
    !has_key
    !stored_key_len
    !slot
    jmp L_JW_TID_NUMERIC

L_JW_TID_NUMERIC_MISSING:
    !missing
    !slot
    jmp L_JW_TID_NUMERIC

L_JW_TID_NUMERIC:
    tmp = stack_alloc ID_BUF_SIZE
    len_slot = stack_alloc 8
    fmt_status = call @sa_fmt_u64_into(thread_id, 10, tmp, ID_BUF_SIZE, &len_slot)
    !fmt_status
    fmt_len = load len_slot+0 as u64
    field_status2 = call @sa_json_writer_field_string(writer, &key, key_len, &tmp, fmt_len)
    !field_status2
    !fmt_len
    !writer
    !key
    !key_len
    !state_ptr
    !thread_id
    return 0

@ffi_wrapper json_writer_field_thread_id_goal_key(writer: ptr, &key: ptr, key_len: u64, &state_ptr: ptr, thread_id: u64, &goal_key_ptr: ptr, goal_key_len: u64) -> u32:
L_ENTRY:
    has_goal_key = ugt goal_key_len, 0
    br has_goal_key -> L_JW_TID_GOAL_KEY, L_JW_TID_GOAL_FALLBACK

L_JW_TID_GOAL_KEY:
    !has_goal_key
    field_status = call @sa_json_writer_field_string(writer, &key, key_len, &goal_key_ptr, goal_key_len)
    !field_status
    !writer
    !key
    !key_len
    !state_ptr
    !thread_id
    !goal_key_ptr
    !goal_key_len
    return 0

L_JW_TID_GOAL_FALLBACK:
    !has_goal_key
    fallback_status = call @json_writer_field_thread_id_string(writer, &key, key_len, &state_ptr, thread_id)
    !fallback_status
    !writer
    !key
    !key_len
    !state_ptr
    !thread_id
    !goal_key_ptr
    !goal_key_len
    return 0

@ffi_wrapper json_writer_field_goal_status(writer: ptr, status: u8) -> u32:
L_ENTRY:
    is_paused = eq status, 1
    br is_paused -> L_JW_GOAL_STATUS_PAUSED, L_JW_GOAL_STATUS_BLOCKED_CHECK

L_JW_GOAL_STATUS_PAUSED:
    !is_paused
    field_paused = call @sa_json_writer_field_string(writer, &JSON_KEY_STATUS, JSON_KEY_STATUS_LEN, &J_GOAL_STATUS_PAUSED, J_GOAL_STATUS_PAUSED_LEN)
    !field_paused
    !writer
    !status
    return 0

L_JW_GOAL_STATUS_BLOCKED_CHECK:
    !is_paused
    is_blocked = eq status, 2
    br is_blocked -> L_JW_GOAL_STATUS_BLOCKED, L_JW_GOAL_STATUS_USAGE_CHECK

L_JW_GOAL_STATUS_BLOCKED:
    !is_blocked
    field_blocked = call @sa_json_writer_field_string(writer, &JSON_KEY_STATUS, JSON_KEY_STATUS_LEN, &J_GOAL_STATUS_BLOCKED, J_GOAL_STATUS_BLOCKED_LEN)
    !field_blocked
    !writer
    !status
    return 0

L_JW_GOAL_STATUS_USAGE_CHECK:
    !is_blocked
    is_usage = eq status, 3
    br is_usage -> L_JW_GOAL_STATUS_USAGE, L_JW_GOAL_STATUS_BUDGET_CHECK

L_JW_GOAL_STATUS_USAGE:
    !is_usage
    field_usage = call @sa_json_writer_field_string(writer, &JSON_KEY_STATUS, JSON_KEY_STATUS_LEN, &J_GOAL_STATUS_USAGE_LIMITED, J_GOAL_STATUS_USAGE_LIMITED_LEN)
    !field_usage
    !writer
    !status
    return 0

L_JW_GOAL_STATUS_BUDGET_CHECK:
    !is_usage
    is_budget = eq status, 4
    br is_budget -> L_JW_GOAL_STATUS_BUDGET, L_JW_GOAL_STATUS_COMPLETE_CHECK

L_JW_GOAL_STATUS_BUDGET:
    !is_budget
    field_budget = call @sa_json_writer_field_string(writer, &JSON_KEY_STATUS, JSON_KEY_STATUS_LEN, &J_GOAL_STATUS_BUDGET_LIMITED, J_GOAL_STATUS_BUDGET_LIMITED_LEN)
    !field_budget
    !writer
    !status
    return 0

L_JW_GOAL_STATUS_COMPLETE_CHECK:
    !is_budget
    is_complete = eq status, 5
    br is_complete -> L_JW_GOAL_STATUS_COMPLETE, L_JW_GOAL_STATUS_ACTIVE

L_JW_GOAL_STATUS_COMPLETE:
    !is_complete
    field_complete = call @sa_json_writer_field_string(writer, &JSON_KEY_STATUS, JSON_KEY_STATUS_LEN, &J_GOAL_STATUS_COMPLETE, J_GOAL_STATUS_COMPLETE_LEN)
    !field_complete
    !writer
    !status
    return 0

L_JW_GOAL_STATUS_ACTIVE:
    !is_complete
    field_active = call @sa_json_writer_field_string(writer, &JSON_KEY_STATUS, JSON_KEY_STATUS_LEN, &J_GOAL_STATUS_ACTIVE, J_GOAL_STATUS_ACTIVE_LEN)
    !field_active
    !writer
    !status
    return 0

@ffi_wrapper json_writer_field_goal_status_text(writer: ptr, status: u8, &status_ptr: ptr, status_len: u64) -> u32:
L_ENTRY:
    is_custom = eq status, 255
    br is_custom -> L_JW_GOAL_STATUS_TEXT_CUSTOM, L_JW_GOAL_STATUS_TEXT_KNOWN_DIRECT

L_JW_GOAL_STATUS_TEXT_CUSTOM:
    has_text = ugt status_len, 0
    br has_text -> L_JW_GOAL_STATUS_TEXT_WRITE, L_JW_GOAL_STATUS_TEXT_KNOWN_EMPTY

L_JW_GOAL_STATUS_TEXT_WRITE:
    !has_text
    !is_custom
    field_custom = call @sa_json_writer_field_string(writer, &JSON_KEY_STATUS, JSON_KEY_STATUS_LEN, &status_ptr, status_len)
    !field_custom
    !writer
    !status
    !status_ptr
    !status_len
    return 0

L_JW_GOAL_STATUS_TEXT_KNOWN_EMPTY:
    !is_custom
    !has_text
    known_status_empty = call @json_writer_field_goal_status(writer, status)
    !known_status_empty
    !writer
    !status
    !status_ptr
    !status_len
    return 0

L_JW_GOAL_STATUS_TEXT_KNOWN_DIRECT:
    !is_custom
    known_status = call @json_writer_field_goal_status(writer, status)
    !known_status
    !writer
    !status
    !status_ptr
    !status_len
    return 0

@ffi_wrapper json_writer_field_goal_budget(writer: ptr, budget_null: u8, budget: i64) -> u32:
L_ENTRY:
    is_null = eq budget_null, 1
    br is_null -> L_JW_GOAL_BUDGET_NULL, L_JW_GOAL_BUDGET_VALUE

L_JW_GOAL_BUDGET_NULL:
    !is_null
    null_status = call @sa_json_writer_field_null(writer, &JSON_KEY_TOKEN_BUDGET, JSON_KEY_TOKEN_BUDGET_LEN)
    !null_status
    !writer
