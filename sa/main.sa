    call @rpc_builder_append(&result, &suffix_ptr, suffix_len)
    params_ptr = call @rpc_builder_data(&result)
    params_len = call @rpc_builder_len(&result)
    call @notify_const_params(&state_ptr, &event_ptr, event_len, &params_ptr, params_len)
    !params_ptr
    !params_len
    !result
    !state_ptr
    !event_ptr
    !event_len
    !body
    !body_len
    !suffix_ptr
    !suffix_len
    return 0

