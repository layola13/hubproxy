    error_field = call @sa_json_writer_object_field(writer, &JSON_KEY_ERROR, JSON_KEY_ERROR_LEN)
    error_begin = call @sa_json_writer_begin_object(writer)
    code_status = call @sa_json_writer_field_string(writer, &JSON_KEY_CODE, JSON_KEY_CODE_LEN, &JSON_VALUE_HTTP_400, JSON_VALUE_HTTP_400_LEN)
    message_status = call @sa_json_writer_field_string(writer, &JSON_KEY_MESSAGE, JSON_KEY_MESSAGE_LEN, &JSON_VALUE_EMPTY_BODY_MESSAGE, JSON_VALUE_EMPTY_BODY_MESSAGE_LEN)
    type_status = call @sa_json_writer_field_string(writer, &FB_KEY_TYPE, FB_KEY_TYPE_LEN, &JSON_VALUE_BAD_REQUEST, JSON_VALUE_BAD_REQUEST_LEN)
    error_end = call @sa_json_writer_end_object(writer)
    end_status = call @sa_json_writer_end_object(writer)
    call @send_json_writer_response(&req, 400, writer)
    !end_status
    !error_end
