    return 0

L_JW_PARAM_WRITE_DEFAULT:
    !emit_null
    default_status = call @sa_json_writer_field_string(writer, &field_key, field_key_len, &fallback, fallback_len)
    !default_status
    !writer
    !field_key
    !field_key_len
