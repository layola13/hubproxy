@ffi_wrapper send_rpc_mock_experimental(&req: ptr, &id_ptr: ptr, id_len: u64, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    root = call @sa_json_parse(&body, body_len)
    has_root = ne root, 0
    br has_root -> L_MOCK_ROOT, L_MOCK_DEFAULT_NO_ROOT

L_MOCK_ROOT:
    !has_root
    params_slot = stack_alloc 8
    params_status = call @sa_json_object_get(root, &FB_KEY_PARAMS, FB_KEY_PARAMS_LEN, &params_slot)
    params_ok = eq params_status, 0
    br params_ok -> L_MOCK_PARAMS, L_MOCK_NO_PARAMS

L_MOCK_PARAMS:
    !params_ok
    params_node = load params_slot+0 as ptr
    value_slot = stack_alloc 8
    value_status = call @sa_json_object_get(params_node, &FB_KEY_VALUE, FB_KEY_VALUE_LEN, &value_slot)
    value_ok = eq value_status, 0
    br value_ok -> L_MOCK_VALUE, L_MOCK_NO_VALUE

L_MOCK_VALUE:
    !value_ok
    value_node = load value_slot+0 as ptr
    writer_slot = stack_alloc 8
    writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot)
    writer = load writer_slot+0 as ptr
    begin_status = call @sa_json_writer_begin_object(writer)
    echoed_status = call @sa_json_writer_field_node(writer, &JSON_KEY_ECHOED, JSON_KEY_ECHOED_LEN, value_node)
    end_status = call @sa_json_writer_end_object(writer)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !end_status
    !echoed_status
    !begin_status
    !writer_status
    value_free = call @sa_json_free(^value_node)
    !value_free
    params_free = call @sa_json_free(^params_node)
    !params_free
    root_free = call @sa_json_free(^root)
    !root_free
    !value_status
    !params_status
    !body
    !body_len
    !req
    return 0

L_MOCK_NO_VALUE:
    !value_ok
    params_free_no_value = call @sa_json_free(^params_node)
    !params_free_no_value
    root_free_no_value = call @sa_json_free(^root)
    !root_free_no_value
    writer_slot_default = stack_alloc 8
    writer_status_default = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot_default)
    writer_default = load writer_slot_default+0 as ptr
    begin_status_default = call @sa_json_writer_begin_object(writer_default)
    echoed_status_default = call @sa_json_writer_field_null(writer_default, &JSON_KEY_ECHOED, JSON_KEY_ECHOED_LEN)
    end_status_default = call @sa_json_writer_end_object(writer_default)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer_default)
    !end_status_default
    !echoed_status_default
    !begin_status_default
    !writer_status_default
    !value_status
    !params_status
    !body
    !body_len
    !req
    return 0

L_MOCK_NO_PARAMS:
    !params_ok
    root_free_no_params = call @sa_json_free(^root)
    !root_free_no_params
    writer_slot_no_params = stack_alloc 8
    writer_status_no_params = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot_no_params)
    writer_no_params = load writer_slot_no_params+0 as ptr
    begin_status_no_params = call @sa_json_writer_begin_object(writer_no_params)
    echoed_status_no_params = call @sa_json_writer_field_null(writer_no_params, &JSON_KEY_ECHOED, JSON_KEY_ECHOED_LEN)
    end_status_no_params = call @sa_json_writer_end_object(writer_no_params)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer_no_params)
    !end_status_no_params
    !echoed_status_no_params
    !begin_status_no_params
    !writer_status_no_params
    !params_status
    !body
    !body_len
    !req
    return 0

L_MOCK_DEFAULT_NO_ROOT:
    !has_root
    writer_slot_no_root = stack_alloc 8
    writer_status_no_root = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot_no_root)
    writer_no_root = load writer_slot_no_root+0 as ptr
    begin_status_no_root = call @sa_json_writer_begin_object(writer_no_root)
    echoed_status_no_root = call @sa_json_writer_field_null(writer_no_root, &JSON_KEY_ECHOED, JSON_KEY_ECHOED_LEN)
    end_status_no_root = call @sa_json_writer_end_object(writer_no_root)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer_no_root)
    !end_status_no_root
    !echoed_status_no_root
    !begin_status_no_root
    !writer_status_no_root
    !body
    !body_len
    !req
    return 0

@ffi_wrapper send_rpc_thread_inject_items(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    thread_id = call @rpc_resolve_thread_id(&state_ptr, &body, body_len, 0)
    thread_slot = call @state_thread_find(&state_ptr, thread_id)
    missing = eq thread_slot, 0
    br missing -> L_INJECT_NOT_FOUND, L_INJECT_FOUND

L_INJECT_FOUND:
    !missing
    !thread_slot
    items_ptr_slot = stack_alloc 8
    items_len_slot = stack_alloc 8
    items_status = call @rpc_extract_array_after(&body, body_len, &J_ITEMS_ARRAY_KEY, J_ITEMS_ARRAY_KEY_LEN, &items_ptr_slot, &items_len_slot)
    has_items = eq items_status, 1
    br has_items -> L_INJECT_WITH_ITEMS, L_INJECT_EMPTY_ITEMS

L_INJECT_EMPTY_ITEMS:
    !has_items
    !items_status
    empty_items_ptr = &CHAT_FB_ARRAY_CLOSE
    store items_ptr_slot+0, empty_items_ptr as ptr
    store items_len_slot+0, CHAT_FB_ARRAY_CLOSE_LEN as u64
    !empty_items_ptr
    jmp L_INJECT_CREATE

L_INJECT_WITH_ITEMS:
    !has_items
    !items_status
    jmp L_INJECT_CREATE

L_INJECT_CREATE:
    items_ptr = load items_ptr_slot+0 as ptr
    items_len = load items_len_slot+0 as u64
    new_turn_id = call @state_turn_create(&state_ptr, thread_id)
    set_items_status = call @state_turn_set_items(&state_ptr, thread_id, new_turn_id, &items_ptr, items_len)
    !set_items_status
    injected_count = call @notify_injected_items_from_dom(&state_ptr, &body, body_len, thread_id, new_turn_id)
    jmp L_INJECT_RESP

L_INJECT_RESP:
    writer_slot = stack_alloc 8
    writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot)
    writer = load writer_slot+0 as ptr
    begin_status = call @sa_json_writer_begin_object(writer)
    thread_status = call @json_writer_field_thread_id_string(writer, &JSON_KEY_THREAD_ID, JSON_KEY_THREAD_ID_LEN, &state_ptr, thread_id)
    injected_i64 = bitcast injected_count as i64
    injected_status = call @sa_json_writer_field_i64(writer, &JSON_KEY_INJECTED_COUNT, JSON_KEY_INJECTED_COUNT_LEN, injected_i64)
    end_status = call @sa_json_writer_end_object(writer)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !end_status
    !injected_status
    !injected_i64
    !thread_status
    !begin_status
    !writer_status
    !injected_count
    !new_turn_id
    !items_ptr
    !items_len
    !thread_id
    !state_ptr
    !body
    !body_len
    !req
    return 0

L_INJECT_NOT_FOUND:
    !missing
    !thread_slot
    call @send_error_with_id(&req, 404, &id_ptr, id_len, &J_ERR_THREAD_NOT_FOUND, J_ERR_THREAD_NOT_FOUND_LEN)
    !thread_id
    !state_ptr
    !body
    !body_len
    !req
    return 0

@ffi_wrapper send_rpc_thread_simple_id(&req: ptr, &id_ptr: ptr, id_len: u64, &body: ptr, body_len: u64, kind: u8) -> u32:
L_ENTRY:
    is_compact = eq kind, 1
    is_approve = eq kind, 2
    is_clean = eq kind, 3
    writer_slot = stack_alloc 8
    writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot)
    writer = load writer_slot+0 as ptr
    begin_status = call @sa_json_writer_begin_object(writer)
    br is_compact -> L_THREAD_SIMPLE_COMPACT, L_THREAD_SIMPLE_APPROVE_CHECK

L_THREAD_SIMPLE_COMPACT:
    !is_compact
    compact_status = call @sa_json_writer_field_bool(writer, &JSON_KEY_COMPACTED, JSON_KEY_COMPACTED_LEN, 1)
    thread_status_compact = call @json_writer_field_param_string_or_default(writer, &JSON_KEY_THREAD_ID, JSON_KEY_THREAD_ID_LEN, &body, body_len, &J_THREADID_KEY, J_THREADID_KEY_LEN, &EMPTY_TEXT, EMPTY_TEXT_LEN, 0)
    end_status_compact = call @sa_json_writer_end_object(writer)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !end_status_compact
    !thread_status_compact
    !compact_status
    !begin_status
    !writer_status
    !is_approve
    !is_clean
    !body
    !body_len
    !kind
    !req
    return 0

L_THREAD_SIMPLE_APPROVE_CHECK:
    !is_compact
    br is_approve -> L_THREAD_SIMPLE_APPROVE, L_THREAD_SIMPLE_CLEAN_CHECK

L_THREAD_SIMPLE_APPROVE:
    !is_approve
    approve_status = call @sa_json_writer_field_bool(writer, &JSON_KEY_APPROVED, JSON_KEY_APPROVED_LEN, 1)
    thread_status_approve = call @json_writer_field_param_string_or_default(writer, &JSON_KEY_THREAD_ID, JSON_KEY_THREAD_ID_LEN, &body, body_len, &J_THREADID_KEY, J_THREADID_KEY_LEN, &EMPTY_TEXT, EMPTY_TEXT_LEN, 0)
    end_status_approve = call @sa_json_writer_end_object(writer)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !end_status_approve
    !thread_status_approve
    !approve_status
    !begin_status
    !writer_status
    !is_clean
    !body
    !body_len
    !kind
    !req
    return 0

L_THREAD_SIMPLE_CLEAN_CHECK:
    !is_approve
    br is_clean -> L_THREAD_SIMPLE_CLEAN, L_THREAD_SIMPLE_FEEDBACK

L_THREAD_SIMPLE_CLEAN:
    !is_clean
    clean_status = call @sa_json_writer_field_bool(writer, &JSON_KEY_CLEANED, JSON_KEY_CLEANED_LEN, 1)
    thread_status_clean = call @json_writer_field_param_string_or_default(writer, &JSON_KEY_THREAD_ID, JSON_KEY_THREAD_ID_LEN, &body, body_len, &J_THREADID_KEY, J_THREADID_KEY_LEN, &EMPTY_TEXT, EMPTY_TEXT_LEN, 0)
    end_status_clean = call @sa_json_writer_end_object(writer)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !end_status_clean
    !thread_status_clean
    !clean_status
    !begin_status
    !writer_status
    !body
    !body_len
    !kind
    !req
    return 0

L_THREAD_SIMPLE_FEEDBACK:
    !is_clean
    thread_status = call @json_writer_field_param_string_or_default(writer, &JSON_KEY_THREAD_ID, JSON_KEY_THREAD_ID_LEN, &body, body_len, &J_THREADID_KEY, J_THREADID_KEY_LEN, &EMPTY_TEXT, EMPTY_TEXT_LEN, 0)
    end_status = call @sa_json_writer_end_object(writer)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !end_status
    !thread_status
    !begin_status
    !writer_status
    !body
    !body_len
    !kind
    !req
    return 0

@ffi_wrapper send_rpc_thread_shell_command(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    thread_ptr_slot = stack_alloc 8
    thread_len_slot = stack_alloc 8
    command_ptr_slot = stack_alloc 8
    command_len_slot = stack_alloc 8
    thread_status = call @rpc_extract_string_or_default(&body, body_len, &J_THREADID_KEY, J_THREADID_KEY_LEN, &EMPTY_TEXT, EMPTY_TEXT_LEN, &thread_ptr_slot, &thread_len_slot)
    command_status = call @rpc_extract_string_or_default(&body, body_len, &J_COMMAND_KEY, J_COMMAND_KEY_LEN, &EMPTY_TEXT, EMPTY_TEXT_LEN, &command_ptr_slot, &command_len_slot)
    thread_ptr = load thread_ptr_slot+0 as ptr
    thread_len = load thread_len_slot+0 as u64
    command_ptr = load command_ptr_slot+0 as ptr
    command_len = load command_len_slot+0 as u64
    warning_text_len = add J_SHELL_WARNING_PREFIX_LEN, command_len
    warning_text = alloc warning_text_len
    warning_prefix_dst = ptr_add warning_text, 0
    warning_prefix_copy = call @state_copy_bytes(&warning_prefix_dst, &J_SHELL_WARNING_PREFIX, J_SHELL_WARNING_PREFIX_LEN)
    warning_command_dst = ptr_add warning_text, J_SHELL_WARNING_PREFIX_LEN
    warning_command_copy = call @state_copy_bytes(&warning_command_dst, &command_ptr, command_len)
    emit_status = call @state_emit_warning(&state_ptr, &warning_text, warning_text_len, &thread_ptr, thread_len)
    writer_slot = stack_alloc 8
    writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot)
    writer = load writer_slot+0 as ptr
    begin_status = call @sa_json_writer_begin_object(writer)
    queued_status = call @sa_json_writer_field_bool(writer, &JSON_KEY_QUEUED, JSON_KEY_QUEUED_LEN, 1)
    thread_field_status = call @json_writer_field_param_string_or_default(writer, &JSON_KEY_THREAD_ID, JSON_KEY_THREAD_ID_LEN, &body, body_len, &J_THREADID_KEY, J_THREADID_KEY_LEN, &EMPTY_TEXT, EMPTY_TEXT_LEN, 0)
    command_field_status = call @json_writer_field_param_string_or_default(writer, &JSON_KEY_COMMAND, JSON_KEY_COMMAND_LEN, &body, body_len, &J_COMMAND_KEY, J_COMMAND_KEY_LEN, &EMPTY_TEXT, EMPTY_TEXT_LEN, 0)
    end_status = call @sa_json_writer_end_object(writer)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !end_status
    !command_field_status
    !thread_field_status
    !queued_status
    !begin_status
    !writer_status
    !emit_status
    !warning_command_copy
    !warning_command_dst
    !warning_prefix_copy
    !warning_prefix_dst
    !warning_text
    !warning_text_len
    !thread_status
    !command_status
    !thread_ptr
    !thread_len
    !command_ptr
    !command_len
    !body
    !body_len
    !req
    return 0

