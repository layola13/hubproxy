    br m_gc_ok -> L_RPC_GOAL_CLR, L_RPC_TRY_ACCT_READ

L_RPC_GOAL_CLR:
    !m_gc_ok
    clear_thread_id = call @rpc_resolve_thread_id(&state_ptr, &rpc_body_ptr, rpc_body_len, 0)
    clear_status = call @state_goal_clear(&state_ptr, clear_thread_id)
    clear_ok = eq clear_status, 0
    !clear_status
    br clear_ok -> L_RPC_GOAL_CLR_TRUE, L_RPC_GOAL_CLR_FALSE

L_RPC_GOAL_CLR_TRUE:
    !clear_ok
    call @notify_thread_id_only(&state_ptr, &EV_GOAL_CLEARED, EV_GOAL_CLEARED_LEN, clear_thread_id)
    call @send_rpc_goal_clear(&req, &rpc_id_ptr, rpc_id_len, &state_ptr, clear_thread_id, 1)
    !clear_thread_id
    jmp L_RPC_DONE

L_RPC_GOAL_CLR_FALSE:
    !clear_ok
    call @send_rpc_goal_clear(&req, &rpc_id_ptr, rpc_id_len, &state_ptr, clear_thread_id, 0)
    !clear_thread_id
    jmp L_RPC_DONE

