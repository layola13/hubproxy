@ffi_wrapper json_writer_field_param_string_or_default(writer: ptr, &field_key: ptr, field_key_len: u64, &body: ptr, body_len: u64, &lookup_key: ptr, lookup_key_len: u64, &fallback: ptr, fallback_len: u64, emit_null_if_missing: u8) -> u32:
L_ENTRY:
    literal_ptr_slot = stack_alloc 8
    literal_len_slot = stack_alloc 8
    literal_status = call @sa_deno_plugin_jsonrpc_params_string_literal(&body, body_len, &lookup_key, lookup_key_len, &fallback, fallback_len, emit_null_if_missing, &literal_ptr_slot, &literal_len_slot)
    literal_ok = eq literal_status, 0
    br literal_ok -> L_JW_PARAM_LITERAL, L_JW_PARAM_FALLBACK

L_JW_PARAM_LITERAL:
    !literal_ok
    literal_ptr = load literal_ptr_slot+0 as ptr
    literal_len = load literal_len_slot+0 as u64
    literal_node = call @sa_json_parse(&literal_ptr, literal_len)
    has_node = ne literal_node, 0
    br has_node -> L_JW_PARAM_NODE, L_JW_PARAM_LITERAL_BAD

L_JW_PARAM_NODE:
    !has_node
    field_status = call @sa_json_writer_field_node(writer, &field_key, field_key_len, literal_node)
    node_free = call @sa_json_free(^literal_node)
    literal_free = call @sa_deno_plugin_free_buffer(literal_ptr, literal_len)
    !literal_free
    !node_free
    !field_status
    !literal_ptr
    !literal_len
    !literal_status
    !writer
    !field_key
    !field_key_len
    !body
    !body_len
    !lookup_key
    !lookup_key_len
    !fallback
    !fallback_len
    !emit_null_if_missing
    return 0

L_JW_PARAM_LITERAL_BAD:
    !has_node
    !literal_node
    literal_free_bad = call @sa_deno_plugin_free_buffer(literal_ptr, literal_len)
    !literal_free_bad
    !literal_ptr
    !literal_len
    !literal_status
    jmp L_JW_PARAM_FALLBACK_AFTER_LITERAL

L_JW_PARAM_FALLBACK:
    !literal_ok
    !literal_status
    jmp L_JW_PARAM_FALLBACK_AFTER_LITERAL

L_JW_PARAM_FALLBACK_AFTER_LITERAL:
    emit_null = eq emit_null_if_missing, 1
    br emit_null -> L_JW_PARAM_WRITE_NULL, L_JW_PARAM_WRITE_DEFAULT

L_JW_PARAM_WRITE_NULL:
    !emit_null
    null_status = call @sa_json_writer_field_null(writer, &field_key, field_key_len)
    !null_status
    !writer
    !field_key
    !field_key_len
    !body
    !body_len
    !lookup_key
    !lookup_key_len
    !fallback
