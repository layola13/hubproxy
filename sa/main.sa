    r_up_auth_key_dst = ptr_add r_up_auth_buf, BEARER_PREFIX_LEN
    r_up_auth_key_copy = call @sa_bytes_copy(&r_up_auth_key_dst, &r_api_key_ptr, r_api_key_len)
    !r_up_auth_key_copy
    !r_up_auth_key_dst
    r_up_auth_len = add r_api_key_len, BEARER_PREFIX_LEN
    r_has_base = ugt r_base_len, 0
    br r_has_base -> L_RESP_HAS_BASE_URL, L_RESP_NO_BASE_FALLBACK

L_RESP_NO_BASE_FALLBACK:
    !r_has_base
    r_nb_fb_model_ptr = load cfg_ptr+CFG_MODEL_PTR as ptr
