    call @send_rpc_goal_obj(&req, &rpc_id_ptr, rpc_id_len, &state_ptr, gg_thread_id, &goal_key_ptr, goal_key_len, goal_status, &goal_status_ptr, goal_status_len, budget_null, budget, used, created, updated, &obj_ptr, obj_len)
    !obj_ptr
    !obj_len
    !created
    !updated
    !goal_status
    !goal_key_ptr
    !goal_key_len
    !goal_status_ptr
    !goal_status_len
