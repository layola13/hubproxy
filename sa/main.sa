    clear_ok = eq clear_status, 0
    !clear_status
    br clear_ok -> L_RPC_GOAL_CLR_TRUE, L_RPC_GOAL_CLR_FALSE

L_RPC_GOAL_CLR_TRUE:
    !clear_ok
    has_clear_key = ugt clear_key_len, 0
