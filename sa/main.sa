L_RPC_MCP_OAUTH_LOGIN:
    !m_oauth_ok
    call @send_rpc_oauth_login(&req, &rpc_id_ptr, rpc_id_len, &cfg_ptr)
    jmp L_RPC_DONE

L_RPC_TRY_MOCK_EXPERIMENTAL:
    !m_oauth_ok
    m_mock_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_MOCK_EXPERIMENTAL, RPC_M_MOCK_EXPERIMENTAL_LEN)
    m_mock_ok = sge m_mock_idx, 0
    !m_mock_idx
    br m_mock_ok -> L_RPC_MOCK_EXPERIMENTAL, L_RPC_TRY_FS_READ_FINAL

L_RPC_MOCK_EXPERIMENTAL:
    !m_mock_ok
    call @send_rpc_mock_experimental(&req, &rpc_id_ptr, rpc_id_len, &rpc_body_ptr, rpc_body_len)
    jmp L_RPC_DONE

L_RPC_TRY_FS_READ_FINAL:
    !m_mock_ok
    m_fsr_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_FS_READ, RPC_M_FS_READ_LEN)
    m_fsr_ok = sge m_fsr_idx, 0
    !m_fsr_idx
    br m_fsr_ok -> L_RPC_FS_READ, L_RPC_TRY_FS_WRITE

L_RPC_FS_READ:
    !m_fsr_ok
    call @send_rpc_fs_read(&req, &rpc_id_ptr, rpc_id_len, &rpc_body_ptr, rpc_body_len)
    jmp L_RPC_DONE

L_RPC_TRY_FS_WRITE:
    !m_fsr_ok
    m_fsw_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_FS_WRITE, RPC_M_FS_WRITE_LEN)
    m_fsw_ok = sge m_fsw_idx, 0
    !m_fsw_idx
    br m_fsw_ok -> L_RPC_FS_WRITE, L_RPC_TRY_FS_MKDIR

L_RPC_FS_WRITE:
    !m_fsw_ok
    call @send_rpc_fs_write(&req, &rpc_id_ptr, rpc_id_len, &rpc_body_ptr, rpc_body_len)
    jmp L_RPC_DONE

L_RPC_TRY_FS_MKDIR:
    !m_fsw_ok
    m_fsm_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_FS_MKDIR, RPC_M_FS_MKDIR_LEN)
    m_fsm_ok = sge m_fsm_idx, 0
    !m_fsm_idx
    br m_fsm_ok -> L_RPC_FS_MKDIR, L_RPC_TRY_FS_READDIR

L_RPC_FS_MKDIR:
    !m_fsm_ok
    call @send_rpc_fs_mkdir(&req, &rpc_id_ptr, rpc_id_len, &rpc_body_ptr, rpc_body_len)
    jmp L_RPC_DONE

L_RPC_TRY_FS_READDIR:
    !m_fsm_ok
    m_fsrd_idx = call @sa_bytes_find(&rpc_body_ptr, rpc_body_len, &RPC_M_FS_READDIR, RPC_M_FS_READDIR_LEN)
    m_fsrd_ok = sge m_fsrd_idx, 0
    !m_fsrd_idx
    br m_fsrd_ok -> L_RPC_FS_READDIR, L_RPC_TRY_FS_METADATA

