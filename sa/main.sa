    r_plain_norm_body = call @normalize_responses_client_json_body(&r_plain_body_ptr, r_plain_body_len, &r_plain_norm_len_slot)
    r_plain_norm_len = load r_plain_norm_len_slot+0 as u64
    r_plain_resp_slot = stack_alloc 8
    r_plain_resp_status = call @sa_http_server_resp_new(req, r_up_status, &r_plain_resp_slot)
    r_plain_resp = load r_plain_resp_slot+0 as ptr
    r_plain_set_ct = call @sa_http_server_resp_set_content_type(r_plain_resp, &MIME_JSON, MIME_JSON_LEN)
    r_plain_send_back = call @sa_http_server_resp_send(r_plain_resp, &r_plain_norm_body, r_plain_norm_len)
    call @sa_http_server_resp_free(^r_plain_resp)
    call @sa_http_client_resp_free(^r_out_resp)
    call @sa_http_client_req_free(^r_out_req)
    call @sa_http_client_free(^r_client)
    !r_plain_body_status
    !r_plain_body_ptr
    !r_plain_body_len
    !r_plain_norm_body
    !r_plain_norm_len
    !r_plain_resp_status
    !r_plain_set_ct
    !r_plain_send_back
    !r_proxy_body_ptr
    !r_proxy_body_len
    !r_up_status
    !r_upstream_ptr
    !r_base_ptr
    !r_base_len
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    call @sa_http_server_req_free(^req)
    !state_ptr
    !cfg_ptr
    return 0

L_RESP_NON_SSE_HEADER:
    !r_ct_is_sse
    !r_ct_idx
    r_h_body_ptr_slot = stack_alloc 8
    r_h_body_len_slot = stack_alloc 8
    r_h_body_status = call @sa_http_client_resp_body_slice(r_out_resp, &r_h_body_ptr_slot, &r_h_body_len_slot)
    r_h_body_ptr = load r_h_body_ptr_slot+0 as ptr
    r_h_body_len = load r_h_body_len_slot+0 as u64
    r_h_norm_len_slot = stack_alloc 8
    r_h_norm_body = call @normalize_responses_client_json_body(&r_h_body_ptr, r_h_body_len, &r_h_norm_len_slot)
    r_h_norm_len = load r_h_norm_len_slot+0 as u64
    r_h_resp_slot = stack_alloc 8
    r_h_resp_status = call @sa_http_server_resp_new(req, r_up_status, &r_h_resp_slot)
    r_h_resp = load r_h_resp_slot+0 as ptr
    r_h_set_ct = call @sa_http_server_resp_set_content_type(r_h_resp, &r_ct_ptr, r_ct_len)
    r_h_send_back = call @sa_http_server_resp_send(r_h_resp, &r_h_norm_body, r_h_norm_len)
    call @sa_http_server_resp_free(^r_h_resp)
    call @sa_http_client_resp_free(^r_out_resp)
    call @sa_http_client_req_free(^r_out_req)
    call @sa_http_client_free(^r_client)
    !r_h_body_status
    !r_h_body_ptr
    !r_h_body_len
    !r_h_norm_body
    !r_h_norm_len
    !r_h_resp_status
    !r_h_set_ct
    !r_h_send_back
    !r_ct_ptr
    !r_ct_len
    !r_proxy_body_ptr
    !r_proxy_body_len
    !r_up_status
    !r_upstream_ptr
    !r_base_ptr
    !r_base_len
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    call @sa_http_server_req_free(^req)
    !state_ptr
    !cfg_ptr
    return 0

L_RESP_STREAM_START:
    !r_ct_is_sse
    !r_ct_idx
    !r_ct_ptr
    !r_ct_len
    r_stream_slot = stack_alloc 8
    r_stream_status = call @sa_http_server_resp_stream_new(req, r_up_status, &r_stream_slot)
    r_stream = load r_stream_slot+0 as ptr
    !r_up_status

    r_sse_body_ptr_slot = stack_alloc 8
    r_sse_body_len_slot = stack_alloc 8
    r_sse_body_status = call @sa_http_client_resp_body_slice(r_out_resp, &r_sse_body_ptr_slot, &r_sse_body_len_slot)
    r_sse_body_ptr = load r_sse_body_ptr_slot+0 as ptr
    r_sse_body_len = load r_sse_body_len_slot+0 as u64
    r_norm_len_slot = stack_alloc 8
    r_ctx_len_slot = stack_alloc 8
    r_ctx_body = call @build_response_request_context_body(&req, &state_ptr, &r_body_ptr, r_body_len, &r_ctx_len_slot)
    r_ctx_len = load r_ctx_len_slot+0 as u64
    r_norm_body = call @normalize_responses_client_sse_body(&r_sse_body_ptr, r_sse_body_len, &r_ctx_body, r_ctx_len, &r_norm_len_slot)
    r_norm_len = load r_norm_len_slot+0 as u64
    r_write_status = call @sa_http_server_resp_stream_write(r_stream, &r_norm_body, r_norm_len)
    r_flush_status = call @sa_http_server_resp_stream_flush(r_stream)
    !r_write_status
    !r_flush_status
    r_end_status = call @sa_http_server_resp_stream_end(r_stream)
    !r_end_status
    call @sa_http_client_resp_free(^r_out_resp)
    call @sa_http_client_req_free(^r_out_req)
    call @sa_http_client_free(^r_client)
    call @sa_http_server_resp_stream_free(^r_stream)
    !r_norm_body
    !r_norm_len
    !r_ctx_body
    !r_ctx_len
    !r_sse_body_status
    !r_sse_body_ptr
    !r_sse_body_len
    !r_proxy_body_ptr
    !r_proxy_body_len
    !r_upstream_ptr
    !r_base_ptr
    !r_base_len
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    call @sa_http_server_req_free(^req)
    !state_ptr
    !cfg_ptr
    return 0

// ============================================================
// /v1/models — Proxy to upstream models endpoint
// ============================================================
L_PROXY_MODELS:
    !is_models_ok
    call @sa_print_bytes(&LOG_MODELS, LOG_MODELS_LEN)
    models_empty_body = stack_alloc 1
    models_log_status = call @write_api_request_log(&req, &cfg_ptr, &path_ptr, path_len, &method_ptr, method_len, &models_empty_body, 0)
    !models_log_status

    m_chat_base_ptr = load cfg_ptr+CFG_CHAT_PTR as ptr
    m_chat_base_len = load cfg_ptr+CFG_CHAT_LEN as u64
    m_url_len_slot = stack_alloc 8
    m_chat_ptr = call @build_proxy_url(&m_chat_base_ptr, m_chat_base_len, &UP_MODELS_SUFFIX, UP_MODELS_SUFFIX_LEN, &m_url_len_slot)
    m_chat_len = load m_url_len_slot+0 as u64
    m_api_key_ptr = load cfg_ptr+CFG_KEY_PTR as ptr
    m_api_key_len = load cfg_ptr+CFG_KEY_LEN as u64
    m_up_auth_buf = stack_alloc UP_AUTH_BUF_SIZE
    m_up_auth_dst = ptr_add m_up_auth_buf, 0
    m_up_auth_prefix = call @sa_bytes_copy(&m_up_auth_dst, &BEARER_PREFIX, BEARER_PREFIX_LEN)
    !m_up_auth_prefix
    !m_up_auth_dst
    m_up_auth_key_dst = ptr_add m_up_auth_buf, BEARER_PREFIX_LEN
    m_up_auth_key_copy = call @sa_bytes_copy(&m_up_auth_key_dst, &m_api_key_ptr, m_api_key_len)
    !m_up_auth_key_copy
    !m_up_auth_key_dst
    m_up_auth_len = add m_api_key_len, BEARER_PREFIX_LEN

    m_client_slot = stack_alloc 8
    m_client_status = call @sa_http_client_new(1, &m_client_slot)
    m_client = load m_client_slot+0 as ptr

    m_req_slot = stack_alloc 8
    m_req_status = call @sa_http_client_req_new(m_client, 1, &m_chat_ptr, m_chat_len, &m_req_slot)
    m_req = load m_req_slot+0 as ptr

    call @sa_http_client_req_add_header(m_req, &HDR_AUTH, HDR_AUTH_LEN, &m_up_auth_buf, m_up_auth_len)
    call @sa_http_client_req_add_header(m_req, &HDR_X_API_KEY, HDR_X_API_KEY_LEN, &m_api_key_ptr, m_api_key_len)

    m_resp_slot = stack_alloc 8
    m_send_status = call @sa_http_client_req_send(m_req, &m_resp_slot)
    m_resp = load m_resp_slot+0 as ptr

    m_status = call @sa_http_client_resp_status(m_resp)
    m_ct_ptr_slot = stack_alloc 8
    m_ct_len_slot = stack_alloc 8
    store m_ct_ptr_slot+0, 0 as ptr
    store m_ct_len_slot+0, 0 as u64
    m_ct_status = call @sa_http_client_resp_get_header(m_resp, &HDR_CONTENT_TYPE, HDR_CONTENT_TYPE_LEN, &m_ct_ptr_slot, &m_ct_len_slot)
    m_ct_ptr = load m_ct_ptr_slot+0 as ptr
    m_ct_len = load m_ct_len_slot+0 as u64
    !m_ct_status
    m_body_ptr_slot = stack_alloc 8
    m_body_len_slot = stack_alloc 8
    m_body_status = call @sa_http_client_resp_body_slice(m_resp, &m_body_ptr_slot, &m_body_len_slot)
    m_body_ptr = load m_body_ptr_slot+0 as ptr
    m_body_len = load m_body_len_slot+0 as u64

    m_out_resp_slot = stack_alloc 8
    m_out_status = call @sa_http_server_resp_new(req, m_status, &m_out_resp_slot)
    m_out_resp = load m_out_resp_slot+0 as ptr
    m_ct_has_len = ugt m_ct_len, 0
    br m_ct_has_len -> L_MODELS_SEND_HEADER_CT, L_MODELS_SEND_DEFAULT_CT

L_MODELS_SEND_HEADER_CT:
    !m_ct_has_len
    m_set_ct = call @sa_http_server_resp_set_content_type(m_out_resp, &m_ct_ptr, m_ct_len)
    !m_set_ct
    jmp L_MODELS_SEND_BODY

L_MODELS_SEND_DEFAULT_CT:
    !m_ct_has_len
    m_set_default_ct = call @sa_http_server_resp_set_content_type(m_out_resp, &MIME_JSON, MIME_JSON_LEN)
    !m_set_default_ct
    jmp L_MODELS_SEND_BODY

L_MODELS_SEND_BODY:
    m_send_back = call @sa_http_server_resp_send(m_out_resp, &m_body_ptr, m_body_len)
    !m_send_back
    !m_out_status
    !m_body_status
    !m_body_ptr
    !m_body_len
    !m_ct_ptr
    !m_ct_len

    call @sa_http_server_resp_free(^m_out_resp)
    call @sa_http_client_resp_free(^m_resp)
    call @sa_http_client_req_free(^m_req)
    call @sa_http_client_free(^m_client)
    !m_chat_ptr
    !m_chat_base_ptr
    !m_chat_base_len
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    call @sa_http_server_req_free(^req)
    !state_ptr
    !cfg_ptr
    return 0

// ============================================================
// /rpc — JSON-RPC dispatch (20+ methods)
// ============================================================
L_HANDLE_RPC:
    !is_rpc_ok
    call @sa_print_bytes(&LOG_RPC, LOG_RPC_LEN)

    rpc_raw_ptr_slot = stack_alloc 8
    rpc_raw_len_slot = stack_alloc 8
    rpc_body_ptr_slot = stack_alloc 8
    rpc_body_len_slot = stack_alloc 8
    rpc_canon_buffer_slot = stack_alloc 8
    rpc_body_status = call @sa_http_server_req_get_body(req, &rpc_raw_ptr_slot, &rpc_raw_len_slot)
    rpc_raw_ptr = load rpc_raw_ptr_slot+0 as ptr
    rpc_raw_len = load rpc_raw_len_slot+0 as u64
    rpc_log_status = call @write_api_request_log(&req, &cfg_ptr, &path_ptr, path_len, &method_ptr, method_len, &rpc_raw_ptr, rpc_raw_len)
    !rpc_log_status
    rpc_canon_status = call @rpc_canonicalize_body(&rpc_raw_ptr, rpc_raw_len, &rpc_body_ptr_slot, &rpc_body_len_slot, &rpc_canon_buffer_slot)
    !rpc_canon_status
    rpc_body_ptr = load rpc_body_ptr_slot+0 as ptr
    rpc_body_len = load rpc_body_len_slot+0 as u64

    rpc_dispatch_status = call @handle_rpc_request(&req, &rpc_body_ptr, rpc_body_len, &state_ptr, &cfg_ptr)
    !rpc_dispatch_status
    rpc_canon_buffer = load rpc_canon_buffer_slot+0 as ptr
    has_rpc_canon_buffer = ne rpc_canon_buffer, 0
    br has_rpc_canon_buffer -> L_RPC_FREE_CANON_BODY, L_RPC_NO_CANON_BODY

L_RPC_FREE_CANON_BODY:
    !has_rpc_canon_buffer
    rpc_canon_free = call @sa_json_buffer_free(^rpc_canon_buffer)
    !rpc_canon_free
    jmp L_RPC_AFTER_CANON_BODY

L_RPC_NO_CANON_BODY:
    !has_rpc_canon_buffer
    !rpc_canon_buffer
    jmp L_RPC_AFTER_CANON_BODY

L_RPC_AFTER_CANON_BODY:
    !rpc_body_status
    !rpc_raw_ptr
    !rpc_raw_len
    !rpc_body_ptr
    !rpc_body_len
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    call @sa_http_server_req_free(^req)
    !state_ptr
    !cfg_ptr
    return 0

// ============================================================
// /events — SSE notification stream
// ============================================================
L_HANDLE_EVENTS:
    !is_events_ok
    call @sa_print_bytes(&LOG_EVENTS, LOG_EVENTS_LEN)

    ev_ctx = alloc EVENT_CTX_SIZE
    store ev_ctx+EVENT_CTX_REQ, req as ptr
    store ev_ctx+EVENT_CTX_STATE, state_ptr as ptr
    ev_spawn_status = call @spawn_event_stream(^ev_ctx)
    !ev_spawn_status
    !req
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    !state_ptr
    !cfg_ptr
    return 0

// ============================================================
// 404 Not Found
// ============================================================
L_NOT_FOUND:
    !is_events_ok
    nf_resp_slot = stack_alloc 8
    nf_status = call @sa_http_server_resp_new(req, 404, &nf_resp_slot)
    nf_resp = load nf_resp_slot+0 as ptr
    nf_send = call @sa_http_server_resp_send(nf_resp, &NOT_FOUND_JSON, NOT_FOUND_LEN)
    !nf_send
    !nf_status
    call @sa_http_server_resp_free(^nf_resp)
    !path_ptr
    !path_len
    !method_ptr
    !method_len
    !is_get
    !is_post
    call @sa_http_server_req_free(^req)
    !state_ptr
    !cfg_ptr
    return 0

@main() -> i32!:
L_ENTRY:
    call @sa_print_bytes(&LOG_INIT, LOG_INIT_LEN)

    // Phase 1: Load config from .env
    cfg_ptr = alloc CFG_SIZE
    cfg_status = call @cfg_load(&ENV_PATH, ENV_PATH_LEN, &cfg_ptr)
    cfg_ok = eq cfg_status, 0
    br cfg_ok -> L_CFG_OK_PRIMARY, L_CFG_TRY_CWD_ENV

L_CFG_TRY_CWD_ENV:
    !cfg_ok
    !cfg_status
    cfg_status2 = call @cfg_load(&ENV_PATH_CWD, ENV_PATH_CWD_LEN, &cfg_ptr)
    cfg_ok2 = eq cfg_status2, 0
    br cfg_ok2 -> L_CFG_OK_FROM_CWD, L_CFG_FAIL

L_CFG_OK_FROM_CWD:
    !cfg_ok2
    !cfg_status2
    jmp L_CFG_OK

L_CFG_FAIL:
    !cfg_ok2
    !cfg_status2
    !cfg_ptr
    return 1

L_CFG_OK_PRIMARY:
    !cfg_ok
    !cfg_status
    jmp L_CFG_OK

L_CFG_OK:
    // Ensure data directory exists
    data_dir_ptr = load cfg_ptr+CFG_DIR_PTR as ptr
    data_dir_len = load cfg_ptr+CFG_DIR_LEN as u64
    EXPAND DENO_MKDIR dir_status, data_dir_ptr, data_dir_len
    !dir_status

    // Phase 2: Initialize state
    state_ptr = alloc ST_TOTAL
    st_status = call @state_init(&state_ptr)
    !st_status

    // Phase 3: Start HTTP server
    port = call @cfg_get_port(&cfg_ptr)
    host_ptr_slot = stack_alloc 8
    host_len_slot = stack_alloc 8
    call @cfg_get_host(&cfg_ptr, &host_ptr_slot, &host_len_slot)
    host_ptr = load host_ptr_slot+0 as ptr
    host_len = load host_len_slot+0 as u64

    server_slot = stack_alloc 8
    srv_status = call @sa_http_server_new(&server_slot)
    server = load server_slot+0 as ptr

    start_status = call @sa_http_server_start(server, &host_ptr, host_len, port)
    !start_status
    !srv_status

    // Print listen address
    call @sa_print_bytes(&LOG_LISTEN, LOG_LISTEN_LEN)
    call @sa_print_bytes(&host_ptr, host_len)
    call @sa_print_bytes(&LISTEN_SUFFIX, LISTEN_SUFFIX_LEN)
    !host_ptr
    !host_len

    // Allocate request handling slot
    req_slot = stack_alloc 8

// ============================================================
// Main HTTP accept loop
// ============================================================
L_HTTP_LOOP:
    accept_status = call @sa_http_server_accept(server, &req_slot)
    req = load req_slot+0 as ptr
    !accept_status
    handle_status = call @handle_http_request(^req, &state_ptr, &cfg_ptr)
    !handle_status
    jmp L_HTTP_LOOP

L_EXIT:
    return 0

@import "sa_http_server.sai"
@import "sa_http_client.sai"
@import "src/strings.sa"
