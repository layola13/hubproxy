    mode_ok = eq mode_status, 0
    br mode_ok -> L_RPC_SET_TMODE_VALUE, L_RPC_SET_TMODE_FREE_NONE3

L_RPC_SET_TMODE_VALUE:
    !mode_ok
    mode_ptr = load mode_ptr_slot+0 as ptr
    mode_len = load mode_len_slot+0 as u64
    mode_code = call @state_turn_set_normalized_mode_text(&state_ptr, thread_id, turn_id, &mode_ptr, mode_len)
    root_free_value = call @sa_json_free(^root)
    !root_free_value
    !mode_ptr
    !mode_len
    !collab_node
    !params_node
    !state_ptr
    !thread_id
    !turn_id
    !body
    !body_len
    return mode_code

L_RPC_SET_TMODE_FREE_NONE3:
    !mode_ok
    !mode_status
    !collab_node
    !collab_status
    !params_node
    !params_status
    free_status_none3 = call @sa_json_free(^root)
    !free_status_none3
    !state_ptr
    !thread_id
    !turn_id
    !body
    !body_len
    return 0

L_RPC_SET_TMODE_FREE_NONE2:
    !collab_ok
    !collab_status
    !params_node
    !params_status
    free_status_none2 = call @sa_json_free(^root)
    !free_status_none2
    !state_ptr
    !thread_id
    !turn_id
    !body
    !body_len
    return 0

L_RPC_SET_TMODE_FREE_NONE:
    !params_ok
    !params_status
    free_status_none = call @sa_json_free(^root)
    !free_status_none
    !state_ptr
    !thread_id
    !turn_id
    !body
    !body_len
    return 0

L_RPC_SET_TMODE_NONE:
    !has_root
    !root
    !state_ptr
    !thread_id
    !turn_id
    !body
    !body_len
    return 0

@ffi_wrapper body_collaboration_mode_fallback(&body: ptr, body_len: u64) -> u8:
L_ENTRY:
    mode_code = call @bytes_has(&body, body_len, &BODY_MODE_CODE, BODY_MODE_CODE_LEN)
    kind_code = call @bytes_has(&body, body_len, &BODY_KIND_CODE, BODY_KIND_CODE_LEN)
    collab_code = call @bytes_has(&body, body_len, &BODY_COLLAB_CODE, BODY_COLLAB_CODE_LEN)
    default_text = call @bytes_has(&body, body_len, &BODY_COLLAB_DEFAULT_TEXT, BODY_COLLAB_DEFAULT_TEXT_LEN)
    code_text = call @bytes_has(&body, body_len, &BODY_COLLAB_CODE_TEXT, BODY_COLLAB_CODE_TEXT_LEN)
    code1 = or mode_code, kind_code
    code2 = or collab_code, default_text
    code3 = or code1, code2
    code_any = or code3, code_text
    is_code = ne code_any, 0
    br is_code -> L_BODY_MODE_CODE, L_BODY_MODE_GOAL_CHECK

L_BODY_MODE_CODE:
    !is_code
    !code_any
    !code3
    !code2
    !code1
    !code_text
    !default_text
    !collab_code
    !kind_code
    !mode_code
    !body
    !body_len
    return 3

L_BODY_MODE_GOAL_CHECK:
    !is_code
    !code_any
    !code3
    !code2
    !code1
    !code_text
    !default_text
    !collab_code
    !kind_code
    !mode_code
    goal_ctx = call @bytes_has(&body, body_len, &BODY_GOAL_CONTEXT, BODY_GOAL_CONTEXT_LEN)
    goal_text = call @bytes_has(&body, body_len, &BODY_GOAL_CONTEXT_TEXT, BODY_GOAL_CONTEXT_TEXT_LEN)
    mode_goal = call @bytes_has(&body, body_len, &BODY_MODE_GOAL, BODY_MODE_GOAL_LEN)
    kind_goal = call @bytes_has(&body, body_len, &BODY_KIND_GOAL, BODY_KIND_GOAL_LEN)
    collab_goal = call @bytes_has(&body, body_len, &BODY_COLLAB_GOAL, BODY_COLLAB_GOAL_LEN)
    any1 = or goal_ctx, goal_text
    any2 = or mode_goal, kind_goal
    any3 = or collab_goal, any2
    any12 = or any1, any2
    any = or any12, any3
    has_goal = ne any, 0
    br has_goal -> L_BODY_MODE_GOAL, L_BODY_MODE_PLAN_CHECK

L_BODY_MODE_GOAL:
    !has_goal
    !any
    !any12
    !any3
    !any2
    !any1
    !collab_goal
    !kind_goal
    !mode_goal
    !goal_text
    !goal_ctx
    !body
    !body_len
    return 2

L_BODY_MODE_PLAN_CHECK:
    !has_goal
    !any
    !any12
    !any3
    !any2
    !any1
    !collab_goal
    !kind_goal
    !mode_goal
    !goal_text
    !goal_ctx
    mode_plan = call @bytes_has(&body, body_len, &BODY_MODE_PLAN, BODY_MODE_PLAN_LEN)
    kind_plan = call @bytes_has(&body, body_len, &BODY_KIND_PLAN, BODY_KIND_PLAN_LEN)
    collab_plan = call @bytes_has(&body, body_len, &BODY_COLLAB_PLAN, BODY_COLLAB_PLAN_LEN)
    plan_text = call @bytes_has(&body, body_len, &BODY_PLAN_TEXT, BODY_PLAN_TEXT_LEN)
    plan1 = or mode_plan, kind_plan
    plan2 = or collab_plan, plan_text
    plan_any = or plan1, plan2
    is_plan = ne plan_any, 0
    br is_plan -> L_BODY_MODE_PLAN, L_BODY_MODE_NONE

L_BODY_MODE_PLAN:
    !is_plan
    !plan_any
    !plan2
    !plan1
    !plan_text
    !collab_plan
    !kind_plan
    !mode_plan
    !body
    !body_len
    return 1

L_BODY_MODE_NONE:
    !is_plan
    !plan_any
    !plan2
    !plan1
    !plan_text
    !collab_plan
    !kind_plan
    !mode_plan
    !body
    !body_len
    return 0

@ffi_wrapper body_allows_progress_continuation(&body: ptr, body_len: u64) -> u32:
L_ENTRY:
    exec_status = call @bytes_has(&body, body_len, &TOOL_NAME_EXEC_KEY, TOOL_NAME_EXEC_KEY_LEN)
    has_exec = eq exec_status, 1
    br has_exec -> L_CONT_MODE_CHECK, L_CONT_MODE_NO_EXEC

L_CONT_MODE_CHECK:
    !has_exec
    !exec_status
    mode = call @body_collaboration_mode(&body, body_len)
    is_goal = eq mode, 2
    is_code = eq mode, 3
    allowed = or is_goal, is_code
    has_allowed = ne allowed, 0
    br has_allowed -> L_CONT_MODE_YES, L_CONT_MODE_NO

L_CONT_MODE_YES:
    !has_allowed
    !allowed
    !is_code
    !is_goal
    !mode
    !body
    !body_len
    return 1

L_CONT_MODE_NO:
    !has_allowed
    !allowed
    !is_code
    !is_goal
    !mode
    !body
    !body_len
    return 0

L_CONT_MODE_NO_EXEC:
    !has_exec
    !exec_status
    !body
    !body_len
    return 0

@ffi_wrapper build_request_context_body(&body: ptr, body_len: u64, mode: u8, &out_len: ptr) -> ^ptr:
L_ENTRY:
    has_mode = ne mode, 0
    br has_mode -> L_CTX_PARSE_BODY, L_CTX_ORIGINAL

L_CTX_PARSE_BODY:
    !has_mode
    root = call @sa_json_parse(&body, body_len)
    has_root = ne root, 0
    br has_root -> L_CTX_CHECK_OBJECT, L_CTX_MODE_ONLY_NO_ROOT

L_CTX_MODE_ONLY_NO_ROOT:
    !has_root
    !root
    jmp L_CTX_MODE_ONLY

L_CTX_CHECK_OBJECT:
    !has_root
    root_kind = call @sa_json_kind(root)
    root_is_object = eq root_kind, SA_JSON_KIND_OBJECT
    !root_kind
    br root_is_object -> L_CTX_WRITER_INIT, L_CTX_FREE_MODE_ONLY

L_CTX_WRITER_INIT:
    !root_is_object
    writer_slot = stack_alloc 8
    buffer_slot = stack_alloc 8
    writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot)
    writer = load writer_slot+0 as ptr
    begin_status = call @sa_json_writer_begin_object(writer)
    count_slot = stack_alloc 8
    count_status = call @sa_json_value_count(root, &count_slot)
    count_ok = eq count_status, 0
    br count_ok -> L_CTX_LOOP_INIT, L_CTX_WRITE_MODE_FIELD_COUNT_BAD

L_CTX_WRITE_MODE_FIELD_COUNT_BAD:
    !count_ok
    !count_status
    jmp L_CTX_WRITE_MODE_FIELD

L_CTX_LOOP_INIT:
    !count_ok
    count = load count_slot+0 as u64
    index_slot = stack_alloc 8
    key_ptr_slot = stack_alloc 8
    key_len_slot = stack_alloc 8
    value_slot = stack_alloc 8
    store index_slot+0, 0 as u64
    jmp L_CTX_LOOP_COND

L_CTX_LOOP_COND:
    index = load index_slot+0 as u64
    has_next = ult index, count
    br has_next -> L_CTX_LOOP_BODY, L_CTX_LOOP_DONE

L_CTX_LOOP_BODY:
    !has_next
    key_status = call @sa_json_object_key_at(root, index, &key_ptr_slot, &key_len_slot)
    key_ok = eq key_status, 0
    br key_ok -> L_CTX_KEY, L_CTX_ADVANCE_BAD_KEY

L_CTX_KEY:
    !key_ok
    key_ptr = load key_ptr_slot+0 as ptr
    key_len = load key_len_slot+0 as u64
    is_collab_raw = call @sa_bytes_eq(&key_ptr, key_len, &FB_KEY_COLLAB_MODE_KIND, FB_KEY_COLLAB_MODE_KIND_LEN)
    is_collab = eq is_collab_raw, 1
    br is_collab -> L_CTX_SKIP_EXISTING_MODE, L_CTX_COPY_FIELD

L_CTX_COPY_FIELD:
    !is_collab
    !is_collab_raw
    value_status = call @sa_json_object_get(root, &key_ptr, key_len, &value_slot)
    value_ok = eq value_status, 0
    br value_ok -> L_CTX_WRITE_FIELD_NODE, L_CTX_ADVANCE_AFTER_VALUE

L_CTX_WRITE_FIELD_NODE:
    !value_ok
    value_node = load value_slot+0 as ptr
    field_status = call @sa_json_writer_field_node(writer, &key_ptr, key_len, value_node)
    value_free = call @sa_json_free(^value_node)
    !value_free
    !field_status
    !value_status
    jmp L_CTX_ADVANCE_AFTER_KEY

L_CTX_ADVANCE_AFTER_VALUE:
    !value_ok
    !value_status
    jmp L_CTX_ADVANCE_AFTER_KEY

L_CTX_SKIP_EXISTING_MODE:
    !is_collab
    !is_collab_raw
    jmp L_CTX_ADVANCE_AFTER_KEY

L_CTX_ADVANCE_BAD_KEY:
    !key_ok
    !key_status
    jmp L_CTX_ADVANCE

L_CTX_ADVANCE_AFTER_KEY:
    !key_ptr
    !key_len
    !key_status
    jmp L_CTX_ADVANCE

L_CTX_ADVANCE:
    next_index = add index, 1
    store index_slot+0, next_index as u64
    !next_index
    !index
    jmp L_CTX_LOOP_COND

L_CTX_LOOP_DONE:
    !has_next
    !index
    !count
    !count_status
    jmp L_CTX_WRITE_MODE_FIELD

L_CTX_WRITE_MODE_FIELD:
    is_plan2 = eq mode, 1
    br is_plan2 -> L_CTX_FIELD_PLAN, L_CTX_FIELD_GOAL_CHECK

L_CTX_FIELD_PLAN:
    !is_plan2
    mode_field_status_plan = call @sa_json_writer_field_string(writer, &FB_KEY_COLLAB_MODE_KIND, FB_KEY_COLLAB_MODE_KIND_LEN, &FB_VALUE_PLAN, FB_VALUE_PLAN_LEN)
    !mode_field_status_plan
    jmp L_CTX_FINISH_WRITER

L_CTX_FIELD_GOAL_CHECK:
    !is_plan2
    is_goal2 = eq mode, 2
    br is_goal2 -> L_CTX_FIELD_GOAL, L_CTX_FIELD_CODE_CHECK

L_CTX_FIELD_GOAL:
    !is_goal2
    mode_field_status_goal = call @sa_json_writer_field_string(writer, &FB_KEY_COLLAB_MODE_KIND, FB_KEY_COLLAB_MODE_KIND_LEN, &FB_VALUE_GOAL, FB_VALUE_GOAL_LEN)
    !mode_field_status_goal
    jmp L_CTX_FINISH_WRITER

L_CTX_FIELD_CODE_CHECK:
    !is_goal2
    is_code2 = eq mode, 3
    br is_code2 -> L_CTX_FIELD_CODE, L_CTX_FINISH_WRITER

L_CTX_FIELD_CODE:
    !is_code2
    mode_field_status_code = call @sa_json_writer_field_string(writer, &FB_KEY_COLLAB_MODE_KIND, FB_KEY_COLLAB_MODE_KIND_LEN, &FB_VALUE_CODE, FB_VALUE_CODE_LEN)
    !mode_field_status_code
    jmp L_CTX_FINISH_WRITER

L_CTX_FINISH_WRITER:
    end_status = call @sa_json_writer_end_object(writer)
    finish_status = call @sa_json_writer_finish(writer, &buffer_slot)
    buffer = load buffer_slot+0 as ptr
    data_ptr = call @sa_json_buffer_data(&buffer)
    data_len = call @sa_json_buffer_len(&buffer)
    out_json = alloc data_len
    copy_json = call @sa_bytes_copy(&out_json, &data_ptr, data_len)
    !copy_json
    store out_len+0, data_len as u64
    buffer_free = call @sa_json_buffer_free(^buffer)
    writer_free = call @sa_json_writer_free(^writer)
    root_free = call @sa_json_free(^root)
    !root_free
    !writer_free
    !buffer_free
    !data_ptr
    !data_len
    !end_status
    !finish_status
    !begin_status
    !writer_status
    !body
    !body_len
    !mode
    !out_len
    return out_json

L_CTX_FREE_MODE_ONLY:
    !root_is_object
    root_free_mode_only = call @sa_json_free(^root)
    !root_free_mode_only
    jmp L_CTX_MODE_ONLY

L_CTX_MODE_ONLY:
    writer_slot2 = stack_alloc 8
    buffer_slot2 = stack_alloc 8
    writer_status2 = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot2)
    writer2 = load writer_slot2+0 as ptr
    begin_status2 = call @sa_json_writer_begin_object(writer2)
    is_plan3 = eq mode, 1
    br is_plan3 -> L_CTX_MODE_ONLY_PLAN, L_CTX_MODE_ONLY_GOAL_CHECK

L_CTX_MODE_ONLY_PLAN:
    !is_plan3
    mode_only_plan = call @sa_json_writer_field_string(writer2, &FB_KEY_COLLAB_MODE_KIND, FB_KEY_COLLAB_MODE_KIND_LEN, &FB_VALUE_PLAN, FB_VALUE_PLAN_LEN)
    !mode_only_plan
    jmp L_CTX_MODE_ONLY_FINISH

L_CTX_MODE_ONLY_GOAL_CHECK:
    !is_plan3
    is_goal3 = eq mode, 2
    br is_goal3 -> L_CTX_MODE_ONLY_GOAL, L_CTX_MODE_ONLY_CODE_CHECK

L_CTX_MODE_ONLY_GOAL:
    !is_goal3
    mode_only_goal = call @sa_json_writer_field_string(writer2, &FB_KEY_COLLAB_MODE_KIND, FB_KEY_COLLAB_MODE_KIND_LEN, &FB_VALUE_GOAL, FB_VALUE_GOAL_LEN)
    !mode_only_goal
    jmp L_CTX_MODE_ONLY_FINISH

L_CTX_MODE_ONLY_CODE_CHECK:
    !is_goal3
    is_code3 = eq mode, 3
    br is_code3 -> L_CTX_MODE_ONLY_CODE, L_CTX_MODE_ONLY_FINISH

L_CTX_MODE_ONLY_CODE:
    !is_code3
    mode_only_code = call @sa_json_writer_field_string(writer2, &FB_KEY_COLLAB_MODE_KIND, FB_KEY_COLLAB_MODE_KIND_LEN, &FB_VALUE_CODE, FB_VALUE_CODE_LEN)
    !mode_only_code
    jmp L_CTX_MODE_ONLY_FINISH

L_CTX_MODE_ONLY_FINISH:
    end_status2 = call @sa_json_writer_end_object(writer2)
    finish_status2 = call @sa_json_writer_finish(writer2, &buffer_slot2)
    buffer2 = load buffer_slot2+0 as ptr
    data_ptr2 = call @sa_json_buffer_data(&buffer2)
    data_len2 = call @sa_json_buffer_len(&buffer2)
    out_json2 = alloc data_len2
    copy_json2 = call @sa_bytes_copy(&out_json2, &data_ptr2, data_len2)
    !copy_json2
    store out_len+0, data_len2 as u64
    buffer_free2 = call @sa_json_buffer_free(^buffer2)
    writer_free2 = call @sa_json_writer_free(^writer2)
    !writer_free2
    !buffer_free2
    !data_ptr2
    !data_len2
    !finish_status2
    !end_status2
    !begin_status2
    !writer_status2
    !body
    !body_len
    !mode
    !out_len
    return out_json2

L_CTX_ORIGINAL:
    !has_mode
    out = alloc body_len
    copy_status = call @sa_bytes_copy(&out, &body, body_len)
    !copy_status
    store out_len+0, body_len as u64
    !body
    !body_len
    !mode
    !out_len
    return out

@ffi_wrapper response_request_context_mode(&req: ptr, &state_ptr: ptr, &body: ptr, body_len: u64) -> u8:
L_ENTRY:
    body_mode = call @body_collaboration_mode(&body, body_len)
    thread_ptr_slot = stack_alloc 8
    thread_len_slot = stack_alloc 8
    turn_ptr_slot = stack_alloc 8
    turn_len_slot = stack_alloc 8
    store thread_ptr_slot+0, 0 as ptr
    store thread_len_slot+0, 0 as u64
    store turn_ptr_slot+0, 0 as ptr
    store turn_len_slot+0, 0 as u64
    thread_hdr_status = call @sa_http_server_req_get_header(req, &HDR_THREAD_ID, HDR_THREAD_ID_LEN, &thread_ptr_slot, &thread_len_slot)
    turn_hdr_status = call @sa_http_server_req_get_header(req, &HDR_TURN_ID, HDR_TURN_ID_LEN, &turn_ptr_slot, &turn_len_slot)
    thread_ptr = load thread_ptr_slot+0 as ptr
    thread_len = load thread_len_slot+0 as u64
    turn_ptr = load turn_ptr_slot+0 as ptr
    turn_len = load turn_len_slot+0 as u64
    !thread_hdr_status
    !turn_hdr_status
    has_thread = ne thread_ptr, 0
    br has_thread -> L_RESP_CTX_HAS_THREAD, L_RESP_CTX_BODY_MODE

L_RESP_CTX_HAS_THREAD:
    !has_thread
    has_turn = ne turn_ptr, 0
    br has_turn -> L_RESP_CTX_PARSE, L_RESP_CTX_BODY_MODE_AFTER_THREAD

L_RESP_CTX_PARSE:
    !has_turn
    parsed_turn = call @sa_bytes_to_u64(&turn_ptr, turn_len)
    turn_ok = sgt parsed_turn, 0
    br turn_ok -> L_RESP_CTX_RESOLVE_THREAD, L_RESP_CTX_BODY_MODE_AFTER_PARSE

L_RESP_CTX_RESOLVE_THREAD:
    !turn_ok
    thread_slot = call @state_thread_find_by_key(&state_ptr, &thread_ptr, thread_len)
    thread_found = ne thread_slot, 0
    br thread_found -> L_RESP_CTX_LOOKUP_KEY, L_RESP_CTX_PARSE_THREAD_NUMERIC

L_RESP_CTX_LOOKUP_KEY:
    !thread_found
    key_thread_id = load thread_slot+THR_ID as u64
    !thread_slot
    key_turn_id = bitcast parsed_turn as u64
    slot_key = call @state_turn_find(&state_ptr, key_thread_id, key_turn_id)
    missing_key = eq slot_key, 0
    br missing_key -> L_RESP_CTX_BODY_MODE_AFTER_LOOKUP_KEY, L_RESP_CTX_LOAD_MODE_KEY

L_RESP_CTX_PARSE_THREAD_NUMERIC:
    !thread_found
    !thread_slot
    parsed_thread = call @sa_bytes_to_u64(&thread_ptr, thread_len)
    thread_ok = sgt parsed_thread, 0
    br thread_ok -> L_RESP_CTX_LOOKUP_THREAD_NUMERIC, L_RESP_CTX_BODY_MODE_AFTER_PARSE_THREAD

L_RESP_CTX_LOOKUP_THREAD_NUMERIC:
    !thread_ok
    numeric_thread_id = bitcast parsed_thread as u64
    !parsed_thread
    numeric_turn_id = bitcast parsed_turn as u64
    slot_num = call @state_turn_find(&state_ptr, numeric_thread_id, numeric_turn_id)
    missing_num = eq slot_num, 0
    br missing_num -> L_RESP_CTX_BODY_MODE_AFTER_LOOKUP_NUM, L_RESP_CTX_LOAD_MODE_NUM

L_RESP_CTX_LOAD_MODE_KEY:
    !missing_key
    mode_key = load slot_key+TURN_MODE as u8
    has_mode_key = ne mode_key, 0
    br has_mode_key -> L_RESP_CTX_STATE_MODE_KEY, L_RESP_CTX_BODY_MODE_AFTER_STATE_ZERO_KEY

L_RESP_CTX_STATE_MODE_KEY:
    !has_mode_key
    !slot_key
    !key_thread_id
    !key_turn_id
    !parsed_turn
    !thread_ptr
    !thread_len
    !turn_ptr
    !turn_len
    !body_mode
    !body
    !body_len
    !state_ptr
    !req
    return mode_key

L_RESP_CTX_BODY_MODE_AFTER_STATE_ZERO_KEY:
    !has_mode_key
    !mode_key
    !slot_key
    jmp L_RESP_CTX_BODY_MODE_AFTER_IDS_KEY

L_RESP_CTX_BODY_MODE_AFTER_LOOKUP_KEY:
    !missing_key
    !slot_key
    jmp L_RESP_CTX_BODY_MODE_AFTER_IDS_KEY

L_RESP_CTX_BODY_MODE_AFTER_IDS_KEY:
    !key_thread_id
    !key_turn_id
    !parsed_turn
    jmp L_RESP_CTX_BODY_MODE_KEEP_PTRS

L_RESP_CTX_LOAD_MODE_NUM:
    !missing_num
    mode_num = load slot_num+TURN_MODE as u8
    has_mode_num = ne mode_num, 0
    br has_mode_num -> L_RESP_CTX_STATE_MODE_NUM, L_RESP_CTX_BODY_MODE_AFTER_STATE_ZERO_NUM

L_RESP_CTX_STATE_MODE_NUM:
    !has_mode_num
    !slot_num
    !numeric_thread_id
    !numeric_turn_id
    !parsed_turn
    !thread_ptr
    !thread_len
    !turn_ptr
    !turn_len
    !body_mode
    !body
    !body_len
    !state_ptr
    !req
    return mode_num

L_RESP_CTX_BODY_MODE_AFTER_STATE_ZERO_NUM:
    !has_mode_num
    !mode_num
    !slot_num
    jmp L_RESP_CTX_BODY_MODE_AFTER_IDS_NUM

L_RESP_CTX_BODY_MODE_AFTER_LOOKUP_NUM:
    !missing_num
    !slot_num
    jmp L_RESP_CTX_BODY_MODE_AFTER_IDS_NUM

L_RESP_CTX_BODY_MODE_AFTER_IDS_NUM:
    !numeric_thread_id
    !numeric_turn_id
    !parsed_turn
    jmp L_RESP_CTX_BODY_MODE_KEEP_PTRS

L_RESP_CTX_BODY_MODE_AFTER_PARSE:
    !turn_ok
    !parsed_turn
    jmp L_RESP_CTX_BODY_MODE_KEEP_PTRS

L_RESP_CTX_BODY_MODE_AFTER_PARSE_THREAD:
    !thread_ok
    !parsed_thread
    !parsed_turn
    jmp L_RESP_CTX_BODY_MODE_KEEP_PTRS

L_RESP_CTX_BODY_MODE_AFTER_THREAD:
    !has_turn
    jmp L_RESP_CTX_BODY_MODE_KEEP_PTRS

L_RESP_CTX_BODY_MODE:
    !has_thread
    jmp L_RESP_CTX_BODY_MODE_KEEP_PTRS

L_RESP_CTX_BODY_MODE_KEEP_PTRS:
    !thread_ptr
    !thread_len
    !turn_ptr
    !turn_len
    !body
    !body_len
    !state_ptr
    !req
    return body_mode

@ffi_wrapper build_response_request_context_body(&req: ptr, &state_ptr: ptr, &body: ptr, body_len: u64, &out_len: ptr) -> ^ptr:
L_ENTRY:
    mode = call @response_request_context_mode(&req, &state_ptr, &body, body_len)
    out = call @build_request_context_body(&body, body_len, mode, &out_len)
    !mode
    !req
    !state_ptr
    !body
    !body_len
    !out_len
    return out

@ffi_wrapper responses_sse_is_progress_message(&body: ptr, body_len: u64) -> u32:
L_ENTRY:
    final_cn = call @bytes_has(&body, body_len, &CHAT_FINAL_CN_DONE, CHAT_FINAL_CN_DONE_LEN)
    proposed = call @bytes_has(&body, body_len, &CHAT_PROPOSED_PLAN, CHAT_PROPOSED_PLAN_LEN)
    final_any = or final_cn, proposed
    is_final = ne final_any, 0
    br is_final -> L_RESP_PROGRESS_NO_FINAL, L_RESP_PROGRESS_MATCH

L_RESP_PROGRESS_MATCH:
    !is_final
    !final_any
    !proposed
    !final_cn
    en_let = call @bytes_has(&body, body_len, &CHAT_PROGRESS_EN_LET_ME, CHAT_PROGRESS_EN_LET_ME_LEN)
    en_check = call @bytes_has(&body, body_len, &CHAT_PROGRESS_EN_CHECK, CHAT_PROGRESS_EN_CHECK_LEN)
    en_inspect = call @bytes_has(&body, body_len, &CHAT_PROGRESS_EN_INSPECT, CHAT_PROGRESS_EN_INSPECT_LEN)
    en_read = call @bytes_has(&body, body_len, &CHAT_PROGRESS_EN_READ, CHAT_PROGRESS_EN_READ_LEN)
    en_tmp1 = or en_check, en_inspect
    en_tmp2 = or en_tmp1, en_read
    en_has_action = ne en_tmp2, 0
    en_progress_raw = and en_let, en_has_action
    cn_will = call @bytes_has(&body, body_len, &CHAT_PROGRESS_CN_WOHUI, CHAT_PROGRESS_CN_WOHUI_LEN)
    cn_continue = call @bytes_has(&body, body_len, &CHAT_PROGRESS_CN_JIXU, CHAT_PROGRESS_CN_JIXU_LEN)
    cn_read = call @bytes_has(&body, body_len, &CHAT_PROGRESS_CN_READ, CHAT_PROGRESS_CN_READ_LEN)
    cn_check = call @bytes_has(&body, body_len, &CHAT_PROGRESS_CN_CHECK, CHAT_PROGRESS_CN_CHECK_LEN)
    cn_run = call @bytes_has(&body, body_len, &CHAT_PROGRESS_CN_RUN, CHAT_PROGRESS_CN_RUN_LEN)
    cn_tmp_will = or cn_will, cn_continue
    cn_tmp_action1 = or cn_read, cn_check
    cn_tmp_action2 = or cn_tmp_action1, cn_run
    cn_has_action = ne cn_tmp_action2, 0
    cn_progress_raw = and cn_tmp_will, cn_has_action
    progress_any = or en_progress_raw, cn_progress_raw
    is_progress = ne progress_any, 0
    br is_progress -> L_RESP_PROGRESS_YES, L_RESP_PROGRESS_NO_MATCH

L_RESP_PROGRESS_YES:
    !is_progress
    !progress_any
    !cn_progress_raw
    !cn_has_action
    !cn_tmp_action2
    !cn_tmp_action1
    !cn_tmp_will
    !cn_run
    !cn_check
    !cn_read
    !cn_continue
    !cn_will
    !en_progress_raw
    !en_has_action
    !en_tmp2
    !en_tmp1
    !en_read
    !en_inspect
    !en_check
    !en_let
    !body
    !body_len
    return 1

L_RESP_PROGRESS_NO_MATCH:
    !is_progress
    !progress_any
    !cn_progress_raw
    !cn_has_action
    !cn_tmp_action2
    !cn_tmp_action1
    !cn_tmp_will
    !cn_run
    !cn_check
    !cn_read
    !cn_continue
    !cn_will
    !en_progress_raw
    !en_has_action
    !en_tmp2
    !en_tmp1
    !en_read
    !en_inspect
    !en_check
    !en_let
    !body
    !body_len
    return 0

L_RESP_PROGRESS_NO_FINAL:
    !is_final
    !final_any
    !proposed
    !final_cn
    !body
    !body_len
    return 0


@ffi_wrapper rpc_extract_array_after(&body: ptr, body_len: u64, &key: ptr, key_len: u64, &out_ptr: ptr, &out_len: ptr) -> u32:
L_ENTRY:
    idx = call @sa_bytes_find(&body, body_len, &key, key_len)
    found = sge idx, 0
    br found -> L_ARRAY_PREP, L_ARRAY_NOT_FOUND

L_ARRAY_PREP:
    !found
    val_off_i = add idx, key_len
    !idx
    val_off = bitcast val_off_i as u64
    remaining = sub body_len, val_off
    val_ptr = ptr_add body, val_off
    first = load val_ptr+0 as u8
    is_array = eq first, 91
    !first
    br is_array -> L_ARRAY_SCAN_INIT, L_ARRAY_BAD

L_ARRAY_SCAN_INIT:
    !is_array
    depth_slot = stack_alloc 8
    i_slot = stack_alloc 8
    in_str_slot = stack_alloc 8
    esc_slot = stack_alloc 8
    store depth_slot+0, 0 as u64
    store i_slot+0, 0 as u64
    store in_str_slot+0, 0 as u64
    store esc_slot+0, 0 as u64
    jmp L_ARRAY_SCAN_COND

L_ARRAY_SCAN_COND:
    i = load i_slot+0 as u64
    done = uge i, remaining
    br done -> L_ARRAY_BAD_FROM_SCAN, L_ARRAY_SCAN_BODY

L_ARRAY_SCAN_BODY:
    ch_ptr = ptr_add val_ptr, i
    ch = load ch_ptr+0 as u8
    esc = load esc_slot+0 as u64
    in_str = load in_str_slot+0 as u64
    is_escaped = eq esc, 1
    br is_escaped -> L_ARRAY_ESCAPED, L_ARRAY_NOT_ESCAPED

L_ARRAY_ESCAPED:
    !is_escaped
    store esc_slot+0, 0 as u64
    jmp L_ARRAY_NEXT

L_ARRAY_NOT_ESCAPED:
    !is_escaped
    is_in_str = eq in_str, 1
    br is_in_str -> L_ARRAY_IN_STRING, L_ARRAY_STRUCT

L_ARRAY_IN_STRING:
    !is_in_str
    is_backslash = eq ch, 92
    br is_backslash -> L_ARRAY_SET_ESC, L_ARRAY_CHECK_QUOTE_IN_STRING

L_ARRAY_SET_ESC:
    !is_backslash
    store esc_slot+0, 1 as u64
    jmp L_ARRAY_NEXT

L_ARRAY_CHECK_QUOTE_IN_STRING:
    !is_backslash
    is_quote = eq ch, 34
    br is_quote -> L_ARRAY_END_STRING, L_ARRAY_NEXT_FROM_STRING

L_ARRAY_END_STRING:
    !is_quote
    store in_str_slot+0, 0 as u64
    jmp L_ARRAY_NEXT

L_ARRAY_NEXT_FROM_STRING:
    !is_quote
    jmp L_ARRAY_NEXT

L_ARRAY_STRUCT:
    !is_in_str
    is_quote2 = eq ch, 34
    br is_quote2 -> L_ARRAY_START_STRING, L_ARRAY_CHECK_OPEN

L_ARRAY_START_STRING:
    !is_quote2
    store in_str_slot+0, 1 as u64
    jmp L_ARRAY_NEXT

L_ARRAY_CHECK_OPEN:
    !is_quote2
    is_open = eq ch, 91
    br is_open -> L_ARRAY_INC_DEPTH, L_ARRAY_CHECK_CLOSE

L_ARRAY_INC_DEPTH:
    !is_open
    depth = load depth_slot+0 as u64
    next_depth = add depth, 1
    store depth_slot+0, next_depth as u64
    !next_depth
    !depth
    jmp L_ARRAY_NEXT

L_ARRAY_CHECK_CLOSE:
    !is_open
    is_close = eq ch, 93
    br is_close -> L_ARRAY_DEC_OR_DONE, L_ARRAY_NEXT_FROM_STRUCT

L_ARRAY_DEC_OR_DONE:
    !is_close
    depth2 = load depth_slot+0 as u64
    is_outer = eq depth2, 1
    br is_outer -> L_ARRAY_FOUND_END, L_ARRAY_DEC_DEPTH

L_ARRAY_DEC_DEPTH:
    !is_outer
    next_depth2 = sub depth2, 1
    store depth_slot+0, next_depth2 as u64
    !next_depth2
    !depth2
    jmp L_ARRAY_NEXT

L_ARRAY_FOUND_END:
    !is_outer
    arr_len = add i, 1
    store out_ptr+0, val_ptr as ptr
    store out_len+0, arr_len as u64
    !arr_len
    !depth2
    !ch
    !ch_ptr
    !i
    !done
    !remaining
    !val_ptr
    !val_off
    !val_off_i
    !body
    !body_len
    !key
    !key_len
    !out_ptr
    !out_len
    return 1

L_ARRAY_NEXT_FROM_STRUCT:
    !is_close
    jmp L_ARRAY_NEXT

L_ARRAY_NEXT:
    !ch
    !ch_ptr
    !esc
    !in_str
    next_i = add i, 1
    store i_slot+0, next_i as u64
    !next_i
    !i
    !done
    jmp L_ARRAY_SCAN_COND

L_ARRAY_BAD_FROM_SCAN:
    !done
    !i
    !remaining
    !val_ptr
    !val_off
    !val_off_i
    !body
    !body_len
    !key
    !key_len
    !out_ptr
    !out_len
    return 0

L_ARRAY_BAD:
    !remaining
    !val_ptr
    !val_off
    !val_off_i
    !body
    !body_len
    !key
    !key_len
    !out_ptr
    !out_len
    return 0

L_ARRAY_NOT_FOUND:
    !found
    !idx
    !body
    !body_len
    !key
    !key_len
    !out_ptr
    !out_len
    return 0


@ffi_wrapper rpc_canonicalize_body(&body: ptr, body_len: u64, &out_ptr: ptr, &out_len: ptr, &out_buffer: ptr) -> u32:
L_ENTRY:
    root = call @sa_json_parse(&body, body_len)
    has_root = ne root, 0
    br has_root -> L_CANON_STRINGIFY, L_CANON_FALLBACK

L_CANON_STRINGIFY:
    !has_root
    buffer_slot = stack_alloc 8
    stringify_status = call @sa_json_stringify(root, &buffer_slot)
    stringify_ok = eq stringify_status, 0
    br stringify_ok -> L_CANON_OK, L_CANON_STRINGIFY_FAIL

L_CANON_OK:
    !stringify_ok
    buffer = load buffer_slot+0 as ptr
    data_ptr = call @sa_json_buffer_data(&buffer)
    data_len = call @sa_json_buffer_len(&buffer)
    store out_ptr+0, data_ptr as ptr
    store out_len+0, data_len as u64
    store out_buffer+0, buffer as ptr
    root_free = call @sa_json_free(^root)
    !root_free
    !data_ptr
    !data_len
    !buffer
    !stringify_status
    !body
    !body_len
    !out_ptr
    !out_len
    !out_buffer
    return 1

L_CANON_STRINGIFY_FAIL:
    !stringify_ok
    !stringify_status
    root_free_bad = call @sa_json_free(^root)
    !root_free_bad
    store out_ptr+0, body as ptr
    store out_len+0, body_len as u64
    store out_buffer+0, 0 as ptr
    !body
    !body_len
    !out_ptr
    !out_len
    !out_buffer
    return 0

L_CANON_FALLBACK:
    !has_root
    store out_ptr+0, body as ptr
    store out_len+0, body_len as u64
    store out_buffer+0, 0 as ptr
    !body
    !body_len
    !out_ptr
    !out_len
    !out_buffer
    return 0

@ffi_wrapper append_with_replacement(&buf: ptr, &src: ptr, src_len: u64, &needle: ptr, needle_len: u64, &replacement: ptr, replacement_len: u64) -> u32:
L_ENTRY:
    i_slot = stack_alloc 8
    store i_slot+0, 0 as u64
    jmp L_REPL_COND

L_REPL_COND:
    i = load i_slot+0 as u64
    done = uge i, src_len
    br done -> L_REPL_DONE, L_REPL_BODY

L_REPL_BODY:
    !done
    remaining = sub src_len, i
    can_match = uge remaining, needle_len
    br can_match -> L_REPL_CHECK, L_REPL_COPY_ONE

L_REPL_CHECK:
    !can_match
    cur_ptr = ptr_add src, i
    match_raw = call @sa_bytes_eq(&cur_ptr, needle_len, &needle, needle_len)
    is_match = eq match_raw, 1
    br is_match -> L_REPL_WRITE_REPLACEMENT, L_REPL_COPY_ONE_FROM_CHECK

L_REPL_WRITE_REPLACEMENT:
    !is_match
    !match_raw
    append_status = call @rpc_builder_append(&buf, &replacement, replacement_len)
    !append_status
    next_i = add i, needle_len
    store i_slot+0, next_i as u64
    !next_i
    !cur_ptr
    !remaining
    !i
    jmp L_REPL_COND

L_REPL_COPY_ONE_FROM_CHECK:
    !is_match
    !match_raw
    !cur_ptr
    jmp L_REPL_COPY_ONE_AFTER_CHECK

L_REPL_COPY_ONE:
    !can_match
    jmp L_REPL_COPY_ONE_AFTER_CHECK

L_REPL_COPY_ONE_AFTER_CHECK:
    ch_ptr = ptr_add src, i
    one_status = call @rpc_builder_append(&buf, &ch_ptr, 1)
    !one_status
    !ch_ptr
    next_one = add i, 1
    store i_slot+0, next_one as u64
    !next_one
    !remaining
    !i
    jmp L_REPL_COND

L_REPL_DONE:
    !done
    !i
    !buf
    !src
    !src_len
    !needle
    !needle_len
    !replacement
    !replacement_len
    return 0

@ffi_wrapper normalize_responses_client_json_body(&body: ptr, body_len: u64, &out_len: ptr) -> ^ptr:
L_ENTRY:
    norm_ptr_slot = stack_alloc 8
    norm_len_slot = stack_alloc 8
    norm_status = call @sa_deno_plugin_responses_json_normalize(&body, body_len, &norm_ptr_slot, &norm_len_slot)
    norm_ok = eq norm_status, 0
    br norm_ok -> L_RESP_JSON_STD_COPY, L_RESP_JSON_STD_COPY_ORIGINAL

L_RESP_JSON_STD_COPY:
    !norm_ok
    norm_ptr = load norm_ptr_slot+0 as ptr
    norm_len = load norm_len_slot+0 as u64
    out_std = alloc norm_len
    copy_status = call @sa_bytes_copy(&out_std, &norm_ptr, norm_len)
    !copy_status
    free_status = call @sa_deno_plugin_free_buffer(norm_ptr, norm_len)
    !free_status
    store out_len+0, norm_len as u64
    !norm_ptr
    !norm_len
    !norm_status
    !body
    !body_len
    !out_len
    return out_std

L_RESP_JSON_STD_COPY_ORIGINAL:
    !norm_ok
    !norm_status
    out_copy = alloc body_len
    copy_status2 = call @sa_bytes_copy(&out_copy, &body, body_len)
    !copy_status2
    store out_len+0, body_len as u64
    !body
    !body_len
    !out_len
    return out_copy

@ffi_wrapper normalize_chat_fallback_json_body(&body: ptr, body_len: u64, &req_body: ptr, req_body_len: u64, &out_len: ptr) -> ^ptr:
L_ENTRY:
    std_json_ptr_slot = stack_alloc 8
    std_json_len_slot = stack_alloc 8
    std_json_status = call @sa_deno_plugin_chat_json_to_responses(&body, body_len, &req_body, req_body_len, &std_json_ptr_slot, &std_json_len_slot)
    std_json_ok = eq std_json_status, 0
    br std_json_ok -> L_CHAT_JSON_STD_COPY, L_CHAT_JSON_STD_COPY_ORIGINAL

L_CHAT_JSON_STD_COPY:
    !std_json_ok
    std_json_ptr = load std_json_ptr_slot+0 as ptr
    std_json_len = load std_json_len_slot+0 as u64
    out_std_json = alloc std_json_len
    std_json_copy_status = call @sa_bytes_copy(&out_std_json, &std_json_ptr, std_json_len)
    !std_json_copy_status
    std_json_free_status = call @sa_deno_plugin_free_buffer(std_json_ptr, std_json_len)
    !std_json_free_status
    store out_len+0, std_json_len as u64
    !std_json_ptr
    !std_json_len
    !std_json_status
    !body
    !body_len
    !req_body
    !req_body_len
    !out_len
    return out_std_json

L_CHAT_JSON_STD_COPY_ORIGINAL:
    !std_json_ok
    !std_json_status
    out_std_json_orig = alloc body_len
    std_json_copy_orig_status = call @sa_bytes_copy(&out_std_json_orig, &body, body_len)
    !std_json_copy_orig_status
    store out_len+0, body_len as u64
    !body
    !body_len
    !req_body
    !req_body_len
    !out_len
    return out_std_json_orig

@ffi_wrapper normalize_responses_client_sse_body(&body: ptr, body_len: u64, &req_body: ptr, req_body_len: u64, &out_len: ptr) -> ^ptr:
L_ENTRY:
    norm_ptr_slot = stack_alloc 8
    norm_len_slot = stack_alloc 8
    norm_status = call @sa_deno_plugin_responses_sse_normalize(&body, body_len, &norm_ptr_slot, &norm_len_slot)
    norm_ok = eq norm_status, 0
    br norm_ok -> L_NATIVE_HAVE_NORM, L_NATIVE_COPY_ORIGINAL

L_NATIVE_HAVE_NORM:
    !norm_ok
    norm_ptr = load norm_ptr_slot+0 as ptr
    norm_len = load norm_len_slot+0 as u64
    allow_native_status = call @body_allows_progress_continuation(&req_body, req_body_len)
    allow_native = eq allow_native_status, 1
    br allow_native -> L_NATIVE_CONT_PROGRESS_CHECK, L_NATIVE_CONT_COPY_NO_ALLOW

L_NATIVE_COPY_ORIGINAL:
    !norm_ok
    !norm_status
    out_orig = alloc body_len
    copy_orig_status = call @sa_bytes_copy(&out_orig, &body, body_len)
    !copy_orig_status
    store out_len+0, body_len as u64
    !body
    !body_len
    !req_body
    !req_body_len
    !out_len
    return out_orig

L_NATIVE_CONT_PROGRESS_CHECK:
    !allow_native
    !allow_native_status
    native_progress_status = call @responses_sse_is_progress_message(&norm_ptr, norm_len)
    native_progress = eq native_progress_status, 1
    br native_progress -> L_NATIVE_CONT_REWRITE, L_NATIVE_CONT_COPY_AFTER_PROGRESS

L_NATIVE_CONT_REWRITE:
    !native_progress
    !native_progress_status
    pass5_capacity = add norm_len, RESP_NATIVE_CONT_BEFORE_COMPLETED_LEN
    pass5 = call @rpc_builder_new_capacity(pass5_capacity)
    p5_status = call @append_with_replacement(&pass5, &norm_ptr, norm_len, &RESP_EVENT_COMPLETED_PREFIX, RESP_EVENT_COMPLETED_PREFIX_LEN, &RESP_NATIVE_CONT_BEFORE_COMPLETED, RESP_NATIVE_CONT_BEFORE_COMPLETED_LEN)
    !p5_status
    p5_ptr = call @rpc_builder_data(&pass5)
    p5_len = call @rpc_builder_len(&pass5)
    out2 = alloc p5_len
    copy_status2 = call @sa_bytes_copy(&out2, &p5_ptr, p5_len)
    !copy_status2
    store out_len+0, p5_len as u64
    !p5_ptr
    !p5_len
    !pass5
    !pass5_capacity
    norm_free_status2 = call @sa_deno_plugin_free_buffer(norm_ptr, norm_len)
    !norm_free_status2
    !norm_ptr
    !norm_len
    !norm_status
    !body
    !body_len
    !req_body
    !req_body_len
    !out_len
    return out2

L_NATIVE_CONT_COPY_AFTER_PROGRESS:
    !native_progress
    !native_progress_status
    jmp L_NATIVE_CONT_COPY

L_NATIVE_CONT_COPY_NO_ALLOW:
    !allow_native
    !allow_native_status
    jmp L_NATIVE_CONT_COPY

L_NATIVE_CONT_COPY:
    out = alloc norm_len
    copy_status = call @sa_bytes_copy(&out, &norm_ptr, norm_len)
    !copy_status
    store out_len+0, norm_len as u64
    norm_free_status = call @sa_deno_plugin_free_buffer(norm_ptr, norm_len)
    !norm_free_status
    !norm_ptr
    !norm_len
    !norm_status
    !body
    !body_len
    !req_body
    !req_body_len
    !out_len
    return out

@ffi_wrapper chat_fallback_sse_to_responses_body(&body: ptr, body_len: u64, &req_body: ptr, req_body_len: u64, &out_len: ptr) -> ^ptr:
L_ENTRY:
    std_sse_ptr_slot = stack_alloc 8
    std_sse_len_slot = stack_alloc 8
    std_sse_status = call @sa_deno_plugin_chat_sse_to_responses(&body, body_len, &req_body, req_body_len, &std_sse_ptr_slot, &std_sse_len_slot)
    std_sse_ok = eq std_sse_status, 0
    br std_sse_ok -> L_CHAT_SSE_STD_COPY, L_CHAT_SSE_STD_COPY_ORIGINAL

L_CHAT_SSE_STD_COPY:
    !std_sse_ok
    std_sse_ptr = load std_sse_ptr_slot+0 as ptr
    std_sse_len = load std_sse_len_slot+0 as u64
    out_std = alloc std_sse_len
    std_copy_status = call @sa_bytes_copy(&out_std, &std_sse_ptr, std_sse_len)
    !std_copy_status
    std_free_status = call @sa_deno_plugin_free_buffer(std_sse_ptr, std_sse_len)
    !std_free_status
    store out_len+0, std_sse_len as u64
    !std_sse_ptr
    !std_sse_len
    !std_sse_status
    !body
    !body_len
    !req_body
    !req_body_len
    !out_len
    return out_std

L_CHAT_SSE_STD_COPY_ORIGINAL:
    !std_sse_ok
    !std_sse_status
    out_std_orig = alloc body_len
    std_copy_orig_status = call @sa_bytes_copy(&out_std_orig, &body, body_len)
    !std_copy_orig_status
    store out_len+0, body_len as u64
    !body
    !body_len
    !req_body
    !req_body_len
    !out_len
    return out_std_orig

@ffi_wrapper body_has_responses_tool_history(&body: ptr, body_len: u64) -> u32:
L_ENTRY:
    idx_fn = call @sa_bytes_find(&body, body_len, &RESP_TYPE_FUNCTION_CALL, RESP_TYPE_FUNCTION_CALL_LEN)
    has_fn = sge idx_fn, 0
    !idx_fn
    br has_fn -> L_TOOL_HIST_YES_FN, L_TOOL_HIST_CHECK_CUSTOM

L_TOOL_HIST_YES_FN:
    !has_fn
    !body
    !body_len
    return 1

L_TOOL_HIST_CHECK_CUSTOM:
    !has_fn
    idx_custom = call @sa_bytes_find(&body, body_len, &RESP_TYPE_CUSTOM_TOOL_CALL, RESP_TYPE_CUSTOM_TOOL_CALL_LEN)
    has_custom = sge idx_custom, 0
    !idx_custom
    br has_custom -> L_TOOL_HIST_YES_CUSTOM, L_TOOL_HIST_CHECK_SEARCH

L_TOOL_HIST_YES_CUSTOM:
    !has_custom
    !body
    !body_len
    return 1

L_TOOL_HIST_CHECK_SEARCH:
    !has_custom
    idx_search = call @sa_bytes_find(&body, body_len, &RESP_TYPE_TOOL_SEARCH_CALL, RESP_TYPE_TOOL_SEARCH_CALL_LEN)
    has_search = sge idx_search, 0
    !idx_search
    br has_search -> L_TOOL_HIST_YES_SEARCH, L_TOOL_HIST_CHECK_MCP

L_TOOL_HIST_YES_SEARCH:
    !has_search
    !body
    !body_len
    return 1

L_TOOL_HIST_CHECK_MCP:
    !has_search
    idx_mcp = call @sa_bytes_find(&body, body_len, &RESP_TYPE_MCP_TOOL_CALL, RESP_TYPE_MCP_TOOL_CALL_LEN)
    has_mcp = sge idx_mcp, 0
    !idx_mcp
    br has_mcp -> L_TOOL_HIST_YES_MCP, L_TOOL_HIST_CHECK_FN_OUT

L_TOOL_HIST_YES_MCP:
    !has_mcp
    !body
    !body_len
    return 1

L_TOOL_HIST_CHECK_FN_OUT:
    !has_mcp
    idx_fn_out = call @sa_bytes_find(&body, body_len, &RESP_TYPE_FUNCTION_OUTPUT, RESP_TYPE_FUNCTION_OUTPUT_LEN)
    has_fn_out = sge idx_fn_out, 0
    !idx_fn_out
    br has_fn_out -> L_TOOL_HIST_YES_FN_OUT, L_TOOL_HIST_CHECK_CUSTOM_OUT

L_TOOL_HIST_YES_FN_OUT:
    !has_fn_out
    !body
    !body_len
    return 1

L_TOOL_HIST_CHECK_CUSTOM_OUT:
    !has_fn_out
    idx_custom_out = call @sa_bytes_find(&body, body_len, &RESP_TYPE_CUSTOM_OUTPUT, RESP_TYPE_CUSTOM_OUTPUT_LEN)
    has_custom_out = sge idx_custom_out, 0
    !idx_custom_out
    br has_custom_out -> L_TOOL_HIST_YES_CUSTOM_OUT, L_TOOL_HIST_CHECK_SEARCH_OUT

L_TOOL_HIST_YES_CUSTOM_OUT:
    !has_custom_out
    !body
    !body_len
    return 1

L_TOOL_HIST_CHECK_SEARCH_OUT:
    !has_custom_out
    idx_search_out = call @sa_bytes_find(&body, body_len, &RESP_TYPE_TOOL_SEARCH_OUTPUT, RESP_TYPE_TOOL_SEARCH_OUTPUT_LEN)
    has_search_out = sge idx_search_out, 0
    !idx_search_out
    br has_search_out -> L_TOOL_HIST_YES_SEARCH_OUT, L_TOOL_HIST_CHECK_MCP_OUT

L_TOOL_HIST_YES_SEARCH_OUT:
    !has_search_out
    !body
    !body_len
    return 1

L_TOOL_HIST_CHECK_MCP_OUT:
    !has_search_out
    idx_mcp_out = call @sa_bytes_find(&body, body_len, &RESP_TYPE_MCP_OUTPUT, RESP_TYPE_MCP_OUTPUT_LEN)
    has_mcp_out = sge idx_mcp_out, 0
    !idx_mcp_out
    br has_mcp_out -> L_TOOL_HIST_YES_MCP_OUT, L_TOOL_HIST_NO

L_TOOL_HIST_YES_MCP_OUT:
    !has_mcp_out
    !body
    !body_len
    return 1

L_TOOL_HIST_NO:
    !has_mcp_out
    !body
    !body_len
    return 0

@ffi_wrapper body_is_unsafe_gemini_chat_fallback(&body: ptr, body_len: u64) -> u32:
L_ENTRY:
    is_gemini = call @body_is_gemini_responses_request(&body, body_len)
    gemini_ok = eq is_gemini, 1
    br gemini_ok -> L_UNSAFE_GEMINI_CHECK_TOOLS, L_UNSAFE_GEMINI_NO

L_UNSAFE_GEMINI_CHECK_TOOLS:
    !gemini_ok
    has_tools = call @body_has_responses_tool_history(&body, body_len)
    unsafe = eq has_tools, 1
    !has_tools
    !is_gemini
    !body
    !body_len
    return unsafe

L_UNSAFE_GEMINI_NO:
    !gemini_ok
    !is_gemini
    !body
    !body_len
    return 0


@ffi_wrapper json_writer_write_responses_tool_source(writer: ptr, tool_node: ptr, source_node: ptr, &prefix: ptr, prefix_len: u64) -> u32:
L_ENTRY:
    name_slot = stack_alloc 8
    name_status = call @sa_json_object_get(source_node, &FB_KEY_NAME, FB_KEY_NAME_LEN, &name_slot)
    name_ok = eq name_status, 0
    br name_ok -> L_JW_RESP_TOOL_NAME, L_JW_RESP_TOOL_NO_NAME

L_JW_RESP_TOOL_NAME:
    !name_ok
    name_node = load name_slot+0 as ptr
    name_kind = call @sa_json_kind(name_node)
    name_is_string = eq name_kind, SA_JSON_KIND_STRING
    !name_kind
    br name_is_string -> L_JW_RESP_TOOL_WRITE, L_JW_RESP_TOOL_NAME_BAD

L_JW_RESP_TOOL_WRITE:
    !name_is_string
    name_ptr = call @sa_json_string_ptr(name_node)
    name_len = call @sa_json_string_len(name_node)
    full_name_len_slot = stack_alloc 8
    full_name = call @build_concat_owned(&prefix, prefix_len, &name_ptr, name_len, &full_name_len_slot)
    full_name_len = load full_name_len_slot+0 as u64
    begin_status = call @sa_json_writer_begin_object(writer)
    type_status = call @sa_json_writer_field_string(writer, &FB_KEY_TYPE, FB_KEY_TYPE_LEN, &FB_TYPE_FUNCTION, FB_TYPE_FUNCTION_LEN)
    name_field_status = call @sa_json_writer_field_string(writer, &FB_KEY_NAME, FB_KEY_NAME_LEN, &full_name, full_name_len)
    !type_status
    !name_field_status
    desc_slot = stack_alloc 8
    desc_status = call @sa_json_object_get(source_node, &FB_KEY_DESCRIPTION, FB_KEY_DESCRIPTION_LEN, &desc_slot)
    desc_ok = eq desc_status, 0
    br desc_ok -> L_JW_RESP_TOOL_DESC, L_JW_RESP_TOOL_PARAMS_NO_DESC

L_JW_RESP_TOOL_DESC:
    !desc_ok
    desc_node = load desc_slot+0 as ptr
    desc_kind = call @sa_json_kind(desc_node)
    desc_is_string = eq desc_kind, SA_JSON_KIND_STRING
    !desc_kind
    br desc_is_string -> L_JW_RESP_TOOL_DESC_WRITE, L_JW_RESP_TOOL_DESC_FREE

L_JW_RESP_TOOL_DESC_WRITE:
    !desc_is_string
    desc_ptr = call @sa_json_string_ptr(desc_node)
    desc_len = call @sa_json_string_len(desc_node)
    desc_field_status = call @sa_json_writer_field_string(writer, &FB_KEY_DESCRIPTION, FB_KEY_DESCRIPTION_LEN, &desc_ptr, desc_len)
    !desc_field_status
    !desc_ptr
    !desc_len
    jmp L_JW_RESP_TOOL_DESC_FREE_AFTER

L_JW_RESP_TOOL_DESC_FREE:
    !desc_is_string
    jmp L_JW_RESP_TOOL_DESC_FREE_AFTER

L_JW_RESP_TOOL_DESC_FREE_AFTER:
    desc_free = call @sa_json_free(^desc_node)
    !desc_free
    !desc_status
    jmp L_JW_RESP_TOOL_PARAMS

L_JW_RESP_TOOL_PARAMS_NO_DESC:
    !desc_ok
    !desc_status
    jmp L_JW_RESP_TOOL_PARAMS

L_JW_RESP_TOOL_PARAMS:
    params_slot = stack_alloc 8
    params_status = call @sa_json_object_get(source_node, &FB_KEY_PARAMETERS, FB_KEY_PARAMETERS_LEN, &params_slot)
    params_ok = eq params_status, 0
    br params_ok -> L_JW_RESP_TOOL_PARAMS_WRITE, L_JW_RESP_TOOL_PARAMS_MISSING

L_JW_RESP_TOOL_PARAMS_WRITE:
    !params_ok
    params_node = load params_slot+0 as ptr
    params_field_status = call @sa_json_writer_field_node(writer, &FB_KEY_PARAMETERS, FB_KEY_PARAMETERS_LEN, params_node)
    params_free = call @sa_json_free(^params_node)
    !params_free
    !params_field_status
    !params_status
    jmp L_JW_RESP_TOOL_STRICT_SOURCE

L_JW_RESP_TOOL_PARAMS_MISSING:
    !params_ok
    !params_status
    jmp L_JW_RESP_TOOL_STRICT_SOURCE

L_JW_RESP_TOOL_STRICT_SOURCE:
    strict_slot = stack_alloc 1
    strict_tool_slot = stack_alloc 1
    strict_status = call @sa_json_object_get_bool(source_node, &FB_KEY_STRICT, FB_KEY_STRICT_LEN, &strict_slot)
    strict_ok = eq strict_status, 0
    br strict_ok -> L_JW_RESP_TOOL_STRICT_FROM_SOURCE, L_JW_RESP_TOOL_STRICT_FROM_TOOL_CHECK

L_JW_RESP_TOOL_STRICT_FROM_SOURCE:
    !strict_ok
    strict_value = load strict_slot+0 as u8
    strict_field_status = call @sa_json_writer_field_bool(writer, &FB_KEY_STRICT, FB_KEY_STRICT_LEN, strict_value)
    !strict_field_status
    !strict_value
    !strict_status
    jmp L_JW_RESP_TOOL_DONE

L_JW_RESP_TOOL_STRICT_FROM_TOOL_CHECK:
    !strict_ok
    !strict_status
    strict_tool_status = call @sa_json_object_get_bool(tool_node, &FB_KEY_STRICT, FB_KEY_STRICT_LEN, &strict_tool_slot)
    strict_tool_ok = eq strict_tool_status, 0
    br strict_tool_ok -> L_JW_RESP_TOOL_STRICT_FROM_TOOL, L_JW_RESP_TOOL_DONE_NO_STRICT

L_JW_RESP_TOOL_STRICT_FROM_TOOL:
    !strict_tool_ok
    strict_tool_value = load strict_tool_slot+0 as u8
    strict_tool_field_status = call @sa_json_writer_field_bool(writer, &FB_KEY_STRICT, FB_KEY_STRICT_LEN, strict_tool_value)
    !strict_tool_field_status
    !strict_tool_value
    !strict_tool_status
    jmp L_JW_RESP_TOOL_DONE

L_JW_RESP_TOOL_DONE_NO_STRICT:
    !strict_tool_ok
    !strict_tool_status
    jmp L_JW_RESP_TOOL_DONE

L_JW_RESP_TOOL_DONE:
    end_status = call @sa_json_writer_end_object(writer)
    name_free = call @sa_json_free(^name_node)
    !name_free
    !end_status
    !begin_status
    !full_name
    !full_name_len
    !name_ptr
    !name_len
    !name_status
    !writer
    !tool_node
    !source_node
    !prefix
    !prefix_len
    return 1

L_JW_RESP_TOOL_NAME_BAD:
    !name_is_string
    name_free_bad = call @sa_json_free(^name_node)
    !name_free_bad
    !name_status
    !writer
    !tool_node
    !source_node
    !prefix
    !prefix_len
    return 0

L_JW_RESP_TOOL_NO_NAME:
    !name_ok
    !name_status
    !writer
    !tool_node
    !source_node
    !prefix
    !prefix_len
    return 0

@ffi_wrapper json_writer_write_responses_tool(writer: ptr, tool_node: ptr, &prefix: ptr, prefix_len: u64) -> u32:
L_ENTRY:
    type_slot = stack_alloc 8
    type_status = call @sa_json_object_get(tool_node, &FB_KEY_TYPE, FB_KEY_TYPE_LEN, &type_slot)
    has_type = eq type_status, 0
    br has_type -> L_JW_RESP_TOOL_TYPE, L_JW_RESP_TOOL_AS_FUNCTION_NO_TYPE

L_JW_RESP_TOOL_TYPE:
    !has_type
    type_node = load type_slot+0 as ptr
    type_kind = call @sa_json_kind(type_node)
    type_is_string = eq type_kind, SA_JSON_KIND_STRING
    !type_kind
    br type_is_string -> L_JW_RESP_TOOL_TYPE_COMPARE, L_JW_RESP_TOOL_TYPE_BAD

L_JW_RESP_TOOL_TYPE_COMPARE:
    !type_is_string
    type_ptr = call @sa_json_string_ptr(type_node)
    type_len = call @sa_json_string_len(type_node)
    ns_raw = call @sa_bytes_eq(&type_ptr, type_len, &FB_TYPE_NAMESPACE, FB_TYPE_NAMESPACE_LEN)
    is_ns = eq ns_raw, 1
    !ns_raw
    br is_ns -> L_JW_RESP_TOOL_NAMESPACE, L_JW_RESP_TOOL_TYPE_FUNCTION_CHECK

L_JW_RESP_TOOL_NAMESPACE:
    !is_ns
    !type_ptr
    !type_len
    type_free_ns = call @sa_json_free(^type_node)
    !type_free_ns
    !type_status
    ns_written = call @json_writer_write_responses_namespace_tools(writer, tool_node)
    !writer
    !tool_node
    !prefix
    !prefix_len
    return ns_written

L_JW_RESP_TOOL_TYPE_FUNCTION_CHECK:
    !is_ns
    fn_raw = call @sa_bytes_eq(&type_ptr, type_len, &FB_TYPE_FUNCTION, FB_TYPE_FUNCTION_LEN)
    is_fn = eq fn_raw, 1
    !fn_raw
    br is_fn -> L_JW_RESP_TOOL_TYPE_FUNCTION, L_JW_RESP_TOOL_TYPE_SKIP

L_JW_RESP_TOOL_TYPE_FUNCTION:
    !is_fn
    !type_ptr
    !type_len
    type_free_fn = call @sa_json_free(^type_node)
    !type_free_fn
    !type_status
    jmp L_JW_RESP_TOOL_AS_FUNCTION

L_JW_RESP_TOOL_TYPE_SKIP:
    !is_fn
    !type_ptr
    !type_len
    type_free_skip = call @sa_json_free(^type_node)
    !type_free_skip
    !type_status
    !writer
    !tool_node
    !prefix
    !prefix_len
    return 0

L_JW_RESP_TOOL_TYPE_BAD:
    !type_is_string
    type_free_bad = call @sa_json_free(^type_node)
    !type_free_bad
    !type_status
    !writer
    !tool_node
    !prefix
    !prefix_len
    return 0

L_JW_RESP_TOOL_AS_FUNCTION_NO_TYPE:
    !has_type
    !type_status
    jmp L_JW_RESP_TOOL_AS_FUNCTION

L_JW_RESP_TOOL_AS_FUNCTION:
    fn_slot = stack_alloc 8
    fn_status = call @sa_json_object_get(tool_node, &FB_KEY_FUNCTION, FB_KEY_FUNCTION_LEN, &fn_slot)
    has_fn = eq fn_status, 0
    br has_fn -> L_JW_RESP_TOOL_FUNCTION_NODE, L_JW_RESP_TOOL_FLAT

L_JW_RESP_TOOL_FUNCTION_NODE:
    !has_fn
    fn_node = load fn_slot+0 as ptr
    wrote_fn = call @json_writer_write_responses_tool_source(writer, tool_node, fn_node, &prefix, prefix_len)
    fn_free = call @sa_json_free(^fn_node)
    !fn_free
    !fn_status
    !writer
    !tool_node
    !prefix
    !prefix_len
    return wrote_fn

L_JW_RESP_TOOL_FLAT:
    !has_fn
    wrote_flat = call @json_writer_write_responses_tool_source(writer, tool_node, tool_node, &prefix, prefix_len)
    !fn_status
    !writer
    !tool_node
    !prefix
    !prefix_len
    return wrote_flat

@ffi_wrapper json_writer_write_responses_namespace_tools(writer: ptr, ns_node: ptr) -> u32:
L_ENTRY:
    ns_name_slot = stack_alloc 8
    ns_name_status = call @sa_json_object_get(ns_node, &FB_KEY_NAME, FB_KEY_NAME_LEN, &ns_name_slot)
    ns_name_ok = eq ns_name_status, 0
    br ns_name_ok -> L_JW_RESP_NS_NAME, L_JW_RESP_NS_NO_NAME

L_JW_RESP_NS_NAME:
    !ns_name_ok
    ns_name_node = load ns_name_slot+0 as ptr
    ns_name_kind = call @sa_json_kind(ns_name_node)
    ns_name_is_string = eq ns_name_kind, SA_JSON_KIND_STRING
    !ns_name_kind
    br ns_name_is_string -> L_JW_RESP_NS_TOOLS, L_JW_RESP_NS_NAME_BAD

L_JW_RESP_NS_TOOLS:
    !ns_name_is_string
    ns_prefix = call @sa_json_string_ptr(ns_name_node)
    ns_prefix_len = call @sa_json_string_len(ns_name_node)
    ns_tools_slot = stack_alloc 8
    ns_tools_status = call @sa_json_object_get(ns_node, &FB_KEY_TOOLS, FB_KEY_TOOLS_LEN, &ns_tools_slot)
    ns_has_tools = eq ns_tools_status, 0
    br ns_has_tools -> L_JW_RESP_NS_LOOP_PREP, L_JW_RESP_NS_NO_TOOLS_FREE

L_JW_RESP_NS_LOOP_PREP:
    !ns_has_tools
    ns_tools_node = load ns_tools_slot+0 as ptr
    ns_count_slot = stack_alloc 8
    ns_count_status = call @sa_json_value_count(ns_tools_node, &ns_count_slot)
    ns_count_ok = eq ns_count_status, 0
    br ns_count_ok -> L_JW_RESP_NS_LOOP_INIT, L_JW_RESP_NS_TOOLS_FREE_EMPTY

L_JW_RESP_NS_LOOP_INIT:
    !ns_count_ok
    ns_count = load ns_count_slot+0 as u64
    ns_index_slot = stack_alloc 8
    ns_item_slot = stack_alloc 8
    wrote_slot = stack_alloc 8
    store ns_index_slot+0, 0 as u64
    store wrote_slot+0, 0 as u64
    jmp L_JW_RESP_NS_LOOP_COND

L_JW_RESP_NS_LOOP_COND:
    ns_index = load ns_index_slot+0 as u64
    ns_has_next = ult ns_index, ns_count
    br ns_has_next -> L_JW_RESP_NS_LOOP_BODY, L_JW_RESP_NS_LOOP_DONE

L_JW_RESP_NS_LOOP_BODY:
    !ns_has_next
    ns_item_status = call @sa_json_array_get(ns_tools_node, ns_index, &ns_item_slot)
    ns_item_ok = eq ns_item_status, 0
    br ns_item_ok -> L_JW_RESP_NS_ITEM, L_JW_RESP_NS_ITEM_NEXT

L_JW_RESP_NS_ITEM:
    !ns_item_ok
    ns_item_node = load ns_item_slot+0 as ptr
    ns_append = call @json_writer_write_responses_tool(writer, ns_item_node, &ns_prefix, ns_prefix_len)
    ns_append_ok = eq ns_append, 1
    br ns_append_ok -> L_JW_RESP_NS_MARK_WROTE, L_JW_RESP_NS_NO_MARK

L_JW_RESP_NS_MARK_WROTE:
    !ns_append_ok
    store wrote_slot+0, 1 as u64
    jmp L_JW_RESP_NS_ITEM_FREE

L_JW_RESP_NS_NO_MARK:
    !ns_append_ok
    jmp L_JW_RESP_NS_ITEM_FREE

L_JW_RESP_NS_ITEM_FREE:
    ns_item_free = call @sa_json_free(^ns_item_node)
    !ns_item_free
    !ns_append
    !ns_item_status
    jmp L_JW_RESP_NS_ITEM_ADVANCE

L_JW_RESP_NS_ITEM_NEXT:
    !ns_item_ok
    !ns_item_status
    jmp L_JW_RESP_NS_ITEM_ADVANCE

L_JW_RESP_NS_ITEM_ADVANCE:
    ns_next_index = add ns_index, 1
    store ns_index_slot+0, ns_next_index as u64
    !ns_next_index
    !ns_index
    jmp L_JW_RESP_NS_LOOP_COND

L_JW_RESP_NS_LOOP_DONE:
    !ns_has_next
    !ns_index
    wrote_any = load wrote_slot+0 as u64
    ns_tools_free = call @sa_json_free(^ns_tools_node)
    !ns_tools_free
    ns_name_free = call @sa_json_free(^ns_name_node)
    !ns_name_free
    !ns_prefix
    !ns_prefix_len
    !ns_count
    !ns_count_status
    !ns_tools_status
    !ns_name_status
    !writer
    !ns_node
    return wrote_any

L_JW_RESP_NS_TOOLS_FREE_EMPTY:
    !ns_count_ok
    ns_tools_free_empty = call @sa_json_free(^ns_tools_node)
    !ns_tools_free_empty
    ns_name_free_empty = call @sa_json_free(^ns_name_node)
    !ns_name_free_empty
    !ns_prefix
    !ns_prefix_len
    !ns_count_status
    !ns_tools_status
    !ns_name_status
    !writer
    !ns_node
    return 0

L_JW_RESP_NS_NO_TOOLS_FREE:
    !ns_has_tools
    ns_name_free_no_tools = call @sa_json_free(^ns_name_node)
    !ns_name_free_no_tools
    !ns_prefix
    !ns_prefix_len
    !ns_tools_status
    !ns_name_status
    !writer
    !ns_node
    return 0

L_JW_RESP_NS_NAME_BAD:
    !ns_name_is_string
    ns_name_free_bad = call @sa_json_free(^ns_name_node)
    !ns_name_free_bad
    !ns_name_status
    !writer
    !ns_node
    return 0

L_JW_RESP_NS_NO_NAME:
    !ns_name_ok
    !ns_name_status
    !writer
    !ns_node
    return 0

@ffi_wrapper json_writer_field_normalized_responses_tools(writer: ptr, tools_node: ptr) -> u32:
L_ENTRY:
    tmp_writer_slot = stack_alloc 8
    tmp_buffer_slot = stack_alloc 8
    tmp_writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &tmp_writer_slot)
    tmp_writer = load tmp_writer_slot+0 as ptr
    tmp_begin_status = call @sa_json_writer_begin_array(tmp_writer)
    count_slot = stack_alloc 8
    index_slot = stack_alloc 8
    item_slot = stack_alloc 8
    wrote_slot = stack_alloc 8
    empty_prefix = &EMPTY_TEXT
    store index_slot+0, 0 as u64
    store wrote_slot+0, 0 as u64
    count_status = call @sa_json_value_count(tools_node, &count_slot)
    count_ok = eq count_status, 0
    br count_ok -> L_JW_RESP_TOOLS_LOOP_INIT, L_JW_RESP_TOOLS_FINISH_EMPTY

L_JW_RESP_TOOLS_LOOP_INIT:
    !count_ok
    count = load count_slot+0 as u64
    jmp L_JW_RESP_TOOLS_LOOP_COND

L_JW_RESP_TOOLS_LOOP_COND:
    index = load index_slot+0 as u64
    has_next = ult index, count
    br has_next -> L_JW_RESP_TOOLS_LOOP_BODY, L_JW_RESP_TOOLS_LOOP_DONE

L_JW_RESP_TOOLS_LOOP_BODY:
    !has_next
    item_status = call @sa_json_array_get(tools_node, index, &item_slot)
    item_ok = eq item_status, 0
    br item_ok -> L_JW_RESP_TOOLS_ITEM, L_JW_RESP_TOOLS_ITEM_NEXT

L_JW_RESP_TOOLS_ITEM:
    !item_ok
    item_node = load item_slot+0 as ptr
    wrote = call @json_writer_write_responses_tool(tmp_writer, item_node, &empty_prefix, 0)
    wrote_ok = eq wrote, 1
    br wrote_ok -> L_JW_RESP_TOOLS_MARK_WROTE, L_JW_RESP_TOOLS_ITEM_FREE_NO_MARK

L_JW_RESP_TOOLS_MARK_WROTE:
    !wrote_ok
    store wrote_slot+0, 1 as u64
    jmp L_JW_RESP_TOOLS_ITEM_FREE

L_JW_RESP_TOOLS_ITEM_FREE_NO_MARK:
    !wrote_ok
    jmp L_JW_RESP_TOOLS_ITEM_FREE

L_JW_RESP_TOOLS_ITEM_FREE:
    item_free = call @sa_json_free(^item_node)
    !item_free
    !wrote
    !item_status
    jmp L_JW_RESP_TOOLS_ADVANCE

L_JW_RESP_TOOLS_ITEM_NEXT:
    !item_ok
    !item_status
    jmp L_JW_RESP_TOOLS_ADVANCE

L_JW_RESP_TOOLS_ADVANCE:
    next_index = add index, 1
    store index_slot+0, next_index as u64
    !next_index
    !index
    jmp L_JW_RESP_TOOLS_LOOP_COND

L_JW_RESP_TOOLS_LOOP_DONE:
    !has_next
    !index
    !count
    !count_status
    jmp L_JW_RESP_TOOLS_FINISH

L_JW_RESP_TOOLS_FINISH_EMPTY:
    !count_ok
    !count_status
    jmp L_JW_RESP_TOOLS_FINISH

L_JW_RESP_TOOLS_FINISH:
    wrote_any = load wrote_slot+0 as u64
    tmp_end_status = call @sa_json_writer_end_array(tmp_writer)
    tmp_finish_status = call @sa_json_writer_finish(tmp_writer, &tmp_buffer_slot)
    tmp_buffer = load tmp_buffer_slot+0 as ptr
    tmp_ptr = call @sa_json_buffer_data(&tmp_buffer)
    tmp_len = call @sa_json_buffer_len(&tmp_buffer)
    has_tools = ne wrote_any, 0
    br has_tools -> L_JW_RESP_TOOLS_FIELD_NODE, L_JW_RESP_TOOLS_FREE_EMPTY_NO_TOOLS

L_JW_RESP_TOOLS_FIELD_NODE:
    !has_tools
    tools_array_node = call @sa_json_parse(&tmp_ptr, tmp_len)
    has_tools_node = ne tools_array_node, 0
    br has_tools_node -> L_JW_RESP_TOOLS_FIELD_WRITE, L_JW_RESP_TOOLS_FREE_EMPTY_AFTER_NODE

L_JW_RESP_TOOLS_FIELD_WRITE:
    !has_tools_node
    field_status = call @sa_json_writer_field_node(writer, &FB_KEY_TOOLS, FB_KEY_TOOLS_LEN, tools_array_node)
    tools_node_free = call @sa_json_free(^tools_array_node)
    !tools_node_free
    tmp_buffer_free = call @sa_json_buffer_free(^tmp_buffer)
    tmp_writer_free = call @sa_json_writer_free(^tmp_writer)
    !tmp_writer_free
    !tmp_buffer_free
    !field_status
    !tmp_ptr
    !tmp_len
    !wrote_any
    !tmp_finish_status
    !tmp_end_status
    !tmp_begin_status
    !tmp_writer_status
    !writer
    !tools_node
    return 1

L_JW_RESP_TOOLS_FREE_EMPTY_AFTER_NODE:
    !has_tools_node
    !tools_array_node
    jmp L_JW_RESP_TOOLS_FREE_EMPTY

L_JW_RESP_TOOLS_FREE_EMPTY_NO_TOOLS:
    !has_tools
    jmp L_JW_RESP_TOOLS_FREE_EMPTY

L_JW_RESP_TOOLS_FREE_EMPTY:
    tmp_buffer_free_empty = call @sa_json_buffer_free(^tmp_buffer)
    tmp_writer_free_empty = call @sa_json_writer_free(^tmp_writer)
    !tmp_writer_free_empty
    !tmp_buffer_free_empty
    !tmp_ptr
    !tmp_len
    !wrote_any
    !tmp_finish_status
    !tmp_end_status
    !tmp_begin_status
    !tmp_writer_status
    !writer
    !tools_node
    return 0

@ffi_wrapper json_writer_write_chat_tool_source(writer: ptr, tool_node: ptr, source_node: ptr, &prefix: ptr, prefix_len: u64) -> u32:
L_ENTRY:
    name_slot = stack_alloc 8
    name_status = call @sa_json_object_get(source_node, &FB_KEY_NAME, FB_KEY_NAME_LEN, &name_slot)
    name_ok = eq name_status, 0
    br name_ok -> L_JW_CHAT_TOOL_NAME, L_JW_CHAT_TOOL_NO_NAME

L_JW_CHAT_TOOL_NAME:
    !name_ok
    name_node = load name_slot+0 as ptr
    name_kind = call @sa_json_kind(name_node)
    name_is_string = eq name_kind, SA_JSON_KIND_STRING
    !name_kind
    br name_is_string -> L_JW_CHAT_TOOL_WRITE, L_JW_CHAT_TOOL_NAME_BAD

L_JW_CHAT_TOOL_WRITE:
    !name_is_string
    name_ptr = call @sa_json_string_ptr(name_node)
    name_len = call @sa_json_string_len(name_node)
    full_name_len_slot = stack_alloc 8
    full_name = call @build_concat_owned(&prefix, prefix_len, &name_ptr, name_len, &full_name_len_slot)
    full_name_len = load full_name_len_slot+0 as u64
    begin_status = call @sa_json_writer_begin_object(writer)
    type_status = call @sa_json_writer_field_string(writer, &FB_KEY_TYPE, FB_KEY_TYPE_LEN, &FB_TYPE_FUNCTION, FB_TYPE_FUNCTION_LEN)
    fn_field_status = call @sa_json_writer_object_field(writer, &FB_KEY_FUNCTION, FB_KEY_FUNCTION_LEN)
    fn_begin_status = call @sa_json_writer_begin_object(writer)
    name_field_status = call @sa_json_writer_field_string(writer, &FB_KEY_NAME, FB_KEY_NAME_LEN, &full_name, full_name_len)
    !type_status
    !fn_field_status
    !fn_begin_status
    !name_field_status
    desc_slot = stack_alloc 8
    desc_status = call @sa_json_object_get(source_node, &FB_KEY_DESCRIPTION, FB_KEY_DESCRIPTION_LEN, &desc_slot)
    desc_ok = eq desc_status, 0
    br desc_ok -> L_JW_CHAT_TOOL_DESC, L_JW_CHAT_TOOL_PARAMS_NO_DESC

L_JW_CHAT_TOOL_DESC:
    !desc_ok
    desc_node = load desc_slot+0 as ptr
    desc_kind = call @sa_json_kind(desc_node)
    desc_is_string = eq desc_kind, SA_JSON_KIND_STRING
    !desc_kind
    br desc_is_string -> L_JW_CHAT_TOOL_DESC_WRITE, L_JW_CHAT_TOOL_DESC_FREE

L_JW_CHAT_TOOL_DESC_WRITE:
    !desc_is_string
    desc_ptr = call @sa_json_string_ptr(desc_node)
    desc_len = call @sa_json_string_len(desc_node)
    desc_field_status = call @sa_json_writer_field_string(writer, &FB_KEY_DESCRIPTION, FB_KEY_DESCRIPTION_LEN, &desc_ptr, desc_len)
    !desc_field_status
    !desc_ptr
    !desc_len
    jmp L_JW_CHAT_TOOL_DESC_FREE_AFTER

L_JW_CHAT_TOOL_DESC_FREE:
    !desc_is_string
    jmp L_JW_CHAT_TOOL_DESC_FREE_AFTER

L_JW_CHAT_TOOL_DESC_FREE_AFTER:
    desc_free = call @sa_json_free(^desc_node)
    !desc_free
    !desc_status
    jmp L_JW_CHAT_TOOL_PARAMS

L_JW_CHAT_TOOL_PARAMS_NO_DESC:
    !desc_ok
    !desc_status
    jmp L_JW_CHAT_TOOL_PARAMS

L_JW_CHAT_TOOL_PARAMS:
    params_slot = stack_alloc 8
    params_status = call @sa_json_object_get(source_node, &FB_KEY_PARAMETERS, FB_KEY_PARAMETERS_LEN, &params_slot)
    params_ok = eq params_status, 0
    br params_ok -> L_JW_CHAT_TOOL_PARAMS_WRITE, L_JW_CHAT_TOOL_PARAMS_MISSING

L_JW_CHAT_TOOL_PARAMS_WRITE:
    !params_ok
    params_node = load params_slot+0 as ptr
    params_field_status = call @sa_json_writer_field_node(writer, &FB_KEY_PARAMETERS, FB_KEY_PARAMETERS_LEN, params_node)
    params_free = call @sa_json_free(^params_node)
    !params_free
    !params_field_status
    !params_status
    jmp L_JW_CHAT_TOOL_STRICT_SOURCE

L_JW_CHAT_TOOL_PARAMS_MISSING:
    !params_ok
    !params_status
    jmp L_JW_CHAT_TOOL_STRICT_SOURCE

L_JW_CHAT_TOOL_STRICT_SOURCE:
    strict_slot = stack_alloc 1
    strict_tool_slot = stack_alloc 1
    strict_status = call @sa_json_object_get_bool(source_node, &FB_KEY_STRICT, FB_KEY_STRICT_LEN, &strict_slot)
    strict_ok = eq strict_status, 0
    br strict_ok -> L_JW_CHAT_TOOL_STRICT_FROM_SOURCE, L_JW_CHAT_TOOL_STRICT_FROM_TOOL_CHECK

L_JW_CHAT_TOOL_STRICT_FROM_SOURCE:
    !strict_ok
    strict_value = load strict_slot+0 as u8
    strict_field_status = call @sa_json_writer_field_bool(writer, &FB_KEY_STRICT, FB_KEY_STRICT_LEN, strict_value)
    !strict_field_status
    !strict_value
    !strict_status
    jmp L_JW_CHAT_TOOL_DONE

L_JW_CHAT_TOOL_STRICT_FROM_TOOL_CHECK:
    !strict_ok
    !strict_status
    strict_tool_status = call @sa_json_object_get_bool(tool_node, &FB_KEY_STRICT, FB_KEY_STRICT_LEN, &strict_tool_slot)
    strict_tool_ok = eq strict_tool_status, 0
    br strict_tool_ok -> L_JW_CHAT_TOOL_STRICT_FROM_TOOL, L_JW_CHAT_TOOL_DONE_NO_STRICT

L_JW_CHAT_TOOL_STRICT_FROM_TOOL:
    !strict_tool_ok
    strict_tool_value = load strict_tool_slot+0 as u8
    strict_tool_field_status = call @sa_json_writer_field_bool(writer, &FB_KEY_STRICT, FB_KEY_STRICT_LEN, strict_tool_value)
    !strict_tool_field_status
    !strict_tool_value
    !strict_tool_status
    jmp L_JW_CHAT_TOOL_DONE

L_JW_CHAT_TOOL_DONE_NO_STRICT:
    !strict_tool_ok
    !strict_tool_status
    jmp L_JW_CHAT_TOOL_DONE

L_JW_CHAT_TOOL_DONE:
    fn_end_status = call @sa_json_writer_end_object(writer)
    end_status = call @sa_json_writer_end_object(writer)
    name_free = call @sa_json_free(^name_node)
    !name_free
    !fn_end_status
    !end_status
    !begin_status
    !full_name
    !full_name_len
    !name_ptr
    !name_len
    !name_status
    !writer
    !tool_node
    !source_node
    !prefix
    !prefix_len
    return 1

L_JW_CHAT_TOOL_NAME_BAD:
    !name_is_string
    name_free_bad = call @sa_json_free(^name_node)
    !name_free_bad
    !name_status
    !writer
    !tool_node
    !source_node
    !prefix
    !prefix_len
    return 0

L_JW_CHAT_TOOL_NO_NAME:
    !name_ok
    !name_status
    !writer
    !tool_node
    !source_node
    !prefix
    !prefix_len
    return 0

@ffi_wrapper json_writer_write_chat_tool(writer: ptr, tool_node: ptr, &prefix: ptr, prefix_len: u64) -> u32:
L_ENTRY:
    type_slot = stack_alloc 8
    type_status = call @sa_json_object_get(tool_node, &FB_KEY_TYPE, FB_KEY_TYPE_LEN, &type_slot)
    has_type = eq type_status, 0
    br has_type -> L_JW_CHAT_TOOL_TYPE, L_JW_CHAT_TOOL_AS_FUNCTION_NO_TYPE

L_JW_CHAT_TOOL_TYPE:
    !has_type
    type_node = load type_slot+0 as ptr
    type_kind = call @sa_json_kind(type_node)
    type_is_string = eq type_kind, SA_JSON_KIND_STRING
    !type_kind
    br type_is_string -> L_JW_CHAT_TOOL_TYPE_COMPARE, L_JW_CHAT_TOOL_TYPE_BAD

L_JW_CHAT_TOOL_TYPE_COMPARE:
    !type_is_string
    type_ptr = call @sa_json_string_ptr(type_node)
    type_len = call @sa_json_string_len(type_node)
    ns_raw = call @sa_bytes_eq(&type_ptr, type_len, &FB_TYPE_NAMESPACE, FB_TYPE_NAMESPACE_LEN)
    is_ns = eq ns_raw, 1
    !ns_raw
    br is_ns -> L_JW_CHAT_TOOL_NAMESPACE, L_JW_CHAT_TOOL_TYPE_FUNCTION_CHECK

L_JW_CHAT_TOOL_NAMESPACE:
    !is_ns
    !type_ptr
    !type_len
    type_free_ns = call @sa_json_free(^type_node)
    !type_free_ns
    !type_status
    ns_written = call @json_writer_write_chat_namespace_tools(writer, tool_node)
    !writer
    !tool_node
    !prefix
    !prefix_len
    return ns_written

L_JW_CHAT_TOOL_TYPE_FUNCTION_CHECK:
    !is_ns
    fn_raw = call @sa_bytes_eq(&type_ptr, type_len, &FB_TYPE_FUNCTION, FB_TYPE_FUNCTION_LEN)
    is_fn = eq fn_raw, 1
    !fn_raw
    br is_fn -> L_JW_CHAT_TOOL_TYPE_FUNCTION, L_JW_CHAT_TOOL_TYPE_SKIP

L_JW_CHAT_TOOL_TYPE_FUNCTION:
    !is_fn
    !type_ptr
    !type_len
    type_free_fn = call @sa_json_free(^type_node)
    !type_free_fn
    !type_status
    jmp L_JW_CHAT_TOOL_AS_FUNCTION

L_JW_CHAT_TOOL_TYPE_SKIP:
    !is_fn
    !type_ptr
    !type_len
    type_free_skip = call @sa_json_free(^type_node)
    !type_free_skip
    !type_status
    !writer
    !tool_node
    !prefix
    !prefix_len
    return 0

L_JW_CHAT_TOOL_TYPE_BAD:
    !type_is_string
    type_free_bad = call @sa_json_free(^type_node)
    !type_free_bad
    !type_status
    !writer
    !tool_node
    !prefix
    !prefix_len
    return 0

L_JW_CHAT_TOOL_AS_FUNCTION_NO_TYPE:
    !has_type
    !type_status
    jmp L_JW_CHAT_TOOL_AS_FUNCTION

L_JW_CHAT_TOOL_AS_FUNCTION:
    fn_slot = stack_alloc 8
    fn_status = call @sa_json_object_get(tool_node, &FB_KEY_FUNCTION, FB_KEY_FUNCTION_LEN, &fn_slot)
    has_fn = eq fn_status, 0
    br has_fn -> L_JW_CHAT_TOOL_FUNCTION_NODE, L_JW_CHAT_TOOL_FLAT

L_JW_CHAT_TOOL_FUNCTION_NODE:
    !has_fn
    fn_node = load fn_slot+0 as ptr
    wrote_fn = call @json_writer_write_chat_tool_source(writer, tool_node, fn_node, &prefix, prefix_len)
    fn_free = call @sa_json_free(^fn_node)
    !fn_free
    !fn_status
    !writer
    !tool_node
    !prefix
    !prefix_len
    return wrote_fn

L_JW_CHAT_TOOL_FLAT:
    !has_fn
    wrote_flat = call @json_writer_write_chat_tool_source(writer, tool_node, tool_node, &prefix, prefix_len)
    !fn_status
    !writer
    !tool_node
    !prefix
    !prefix_len
    return wrote_flat

@ffi_wrapper json_writer_write_chat_namespace_tools(writer: ptr, ns_node: ptr) -> u32:
L_ENTRY:
    ns_name_slot = stack_alloc 8
    ns_name_status = call @sa_json_object_get(ns_node, &FB_KEY_NAME, FB_KEY_NAME_LEN, &ns_name_slot)
    ns_name_ok = eq ns_name_status, 0
    br ns_name_ok -> L_JW_CHAT_NS_NAME, L_JW_CHAT_NS_NO_NAME

L_JW_CHAT_NS_NAME:
    !ns_name_ok
    ns_name_node = load ns_name_slot+0 as ptr
    ns_name_kind = call @sa_json_kind(ns_name_node)
    ns_name_is_string = eq ns_name_kind, SA_JSON_KIND_STRING
    !ns_name_kind
    br ns_name_is_string -> L_JW_CHAT_NS_TOOLS, L_JW_CHAT_NS_NAME_BAD

L_JW_CHAT_NS_TOOLS:
    !ns_name_is_string
    ns_prefix = call @sa_json_string_ptr(ns_name_node)
    ns_prefix_len = call @sa_json_string_len(ns_name_node)
    ns_tools_slot = stack_alloc 8
    ns_tools_status = call @sa_json_object_get(ns_node, &FB_KEY_TOOLS, FB_KEY_TOOLS_LEN, &ns_tools_slot)
    ns_has_tools = eq ns_tools_status, 0
    br ns_has_tools -> L_JW_CHAT_NS_LOOP_PREP, L_JW_CHAT_NS_NO_TOOLS_FREE

L_JW_CHAT_NS_LOOP_PREP:
    !ns_has_tools
    ns_tools_node = load ns_tools_slot+0 as ptr
    ns_count_slot = stack_alloc 8
    ns_count_status = call @sa_json_value_count(ns_tools_node, &ns_count_slot)
    ns_count_ok = eq ns_count_status, 0
    br ns_count_ok -> L_JW_CHAT_NS_LOOP_INIT, L_JW_CHAT_NS_TOOLS_FREE_EMPTY

L_JW_CHAT_NS_LOOP_INIT:
    !ns_count_ok
    ns_count = load ns_count_slot+0 as u64
    ns_index_slot = stack_alloc 8
    ns_item_slot = stack_alloc 8
    wrote_slot = stack_alloc 8
    store ns_index_slot+0, 0 as u64
    store wrote_slot+0, 0 as u64
    jmp L_JW_CHAT_NS_LOOP_COND

L_JW_CHAT_NS_LOOP_COND:
    ns_index = load ns_index_slot+0 as u64
    ns_has_next = ult ns_index, ns_count
    br ns_has_next -> L_JW_CHAT_NS_LOOP_BODY, L_JW_CHAT_NS_LOOP_DONE

L_JW_CHAT_NS_LOOP_BODY:
    !ns_has_next
    ns_item_status = call @sa_json_array_get(ns_tools_node, ns_index, &ns_item_slot)
    ns_item_ok = eq ns_item_status, 0
    br ns_item_ok -> L_JW_CHAT_NS_ITEM, L_JW_CHAT_NS_ITEM_NEXT

L_JW_CHAT_NS_ITEM:
    !ns_item_ok
    ns_item_node = load ns_item_slot+0 as ptr
    ns_append = call @json_writer_write_chat_tool(writer, ns_item_node, &ns_prefix, ns_prefix_len)
    ns_append_ok = eq ns_append, 1
    br ns_append_ok -> L_JW_CHAT_NS_MARK_WROTE, L_JW_CHAT_NS_NO_MARK

L_JW_CHAT_NS_MARK_WROTE:
    !ns_append_ok
    store wrote_slot+0, 1 as u64
    jmp L_JW_CHAT_NS_ITEM_FREE

L_JW_CHAT_NS_NO_MARK:
    !ns_append_ok
    jmp L_JW_CHAT_NS_ITEM_FREE

L_JW_CHAT_NS_ITEM_FREE:
    ns_item_free = call @sa_json_free(^ns_item_node)
    !ns_item_free
    !ns_append
    !ns_item_status
    jmp L_JW_CHAT_NS_ITEM_ADVANCE

L_JW_CHAT_NS_ITEM_NEXT:
    !ns_item_ok
    !ns_item_status
    jmp L_JW_CHAT_NS_ITEM_ADVANCE

L_JW_CHAT_NS_ITEM_ADVANCE:
    ns_next_index = add ns_index, 1
    store ns_index_slot+0, ns_next_index as u64
    !ns_next_index
    !ns_index
    jmp L_JW_CHAT_NS_LOOP_COND

L_JW_CHAT_NS_LOOP_DONE:
    !ns_has_next
    !ns_index
    wrote_any = load wrote_slot+0 as u64
    ns_tools_free = call @sa_json_free(^ns_tools_node)
    !ns_tools_free
    ns_name_free = call @sa_json_free(^ns_name_node)
    !ns_name_free
    !ns_prefix
    !ns_prefix_len
    !ns_count
    !ns_count_status
    !ns_tools_status
    !ns_name_status
    !writer
    !ns_node
    return wrote_any

L_JW_CHAT_NS_TOOLS_FREE_EMPTY:
    !ns_count_ok
    ns_tools_free_empty = call @sa_json_free(^ns_tools_node)
    !ns_tools_free_empty
    ns_name_free_empty = call @sa_json_free(^ns_name_node)
    !ns_name_free_empty
    !ns_prefix
    !ns_prefix_len
    !ns_count_status
    !ns_tools_status
    !ns_name_status
    !writer
    !ns_node
    return 0

L_JW_CHAT_NS_NO_TOOLS_FREE:
    !ns_has_tools
    ns_name_free_no_tools = call @sa_json_free(^ns_name_node)
    !ns_name_free_no_tools
    !ns_prefix
    !ns_prefix_len
    !ns_tools_status
    !ns_name_status
    !writer
    !ns_node
    return 0

L_JW_CHAT_NS_NAME_BAD:
    !ns_name_is_string
    ns_name_free_bad = call @sa_json_free(^ns_name_node)
    !ns_name_free_bad
    !ns_name_status
    !writer
    !ns_node
    return 0

L_JW_CHAT_NS_NO_NAME:
    !ns_name_ok
    !ns_name_status
    !writer
    !ns_node
    return 0

@ffi_wrapper json_writer_field_normalized_chat_tools(writer: ptr, tools_node: ptr) -> u32:
L_ENTRY:
    tmp_writer_slot = stack_alloc 8
    tmp_buffer_slot = stack_alloc 8
    tmp_writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &tmp_writer_slot)
    tmp_writer = load tmp_writer_slot+0 as ptr
    tmp_begin_status = call @sa_json_writer_begin_array(tmp_writer)
    count_slot = stack_alloc 8
    index_slot = stack_alloc 8
    item_slot = stack_alloc 8
    wrote_slot = stack_alloc 8
    empty_prefix = &EMPTY_TEXT
    store index_slot+0, 0 as u64
    store wrote_slot+0, 0 as u64
    count_status = call @sa_json_value_count(tools_node, &count_slot)
    count_ok = eq count_status, 0
    br count_ok -> L_JW_CHAT_TOOLS_LOOP_INIT, L_JW_CHAT_TOOLS_FINISH_EMPTY

L_JW_CHAT_TOOLS_LOOP_INIT:
    !count_ok
    count = load count_slot+0 as u64
    jmp L_JW_CHAT_TOOLS_LOOP_COND

L_JW_CHAT_TOOLS_LOOP_COND:
    index = load index_slot+0 as u64
    has_next = ult index, count
    br has_next -> L_JW_CHAT_TOOLS_LOOP_BODY, L_JW_CHAT_TOOLS_LOOP_DONE

L_JW_CHAT_TOOLS_LOOP_BODY:
    !has_next
    item_status = call @sa_json_array_get(tools_node, index, &item_slot)
    item_ok = eq item_status, 0
    br item_ok -> L_JW_CHAT_TOOLS_ITEM, L_JW_CHAT_TOOLS_ITEM_NEXT

L_JW_CHAT_TOOLS_ITEM:
    !item_ok
    item_node = load item_slot+0 as ptr
    wrote = call @json_writer_write_chat_tool(tmp_writer, item_node, &empty_prefix, 0)
    wrote_ok = eq wrote, 1
    br wrote_ok -> L_JW_CHAT_TOOLS_MARK_WROTE, L_JW_CHAT_TOOLS_ITEM_FREE_NO_MARK

L_JW_CHAT_TOOLS_MARK_WROTE:
    !wrote_ok
    store wrote_slot+0, 1 as u64
    jmp L_JW_CHAT_TOOLS_ITEM_FREE

L_JW_CHAT_TOOLS_ITEM_FREE_NO_MARK:
    !wrote_ok
    jmp L_JW_CHAT_TOOLS_ITEM_FREE

L_JW_CHAT_TOOLS_ITEM_FREE:
    item_free = call @sa_json_free(^item_node)
    !item_free
    !wrote
    !item_status
    jmp L_JW_CHAT_TOOLS_ADVANCE

L_JW_CHAT_TOOLS_ITEM_NEXT:
    !item_ok
    !item_status
    jmp L_JW_CHAT_TOOLS_ADVANCE

L_JW_CHAT_TOOLS_ADVANCE:
    next_index = add index, 1
    store index_slot+0, next_index as u64
    !next_index
    !index
    jmp L_JW_CHAT_TOOLS_LOOP_COND

L_JW_CHAT_TOOLS_LOOP_DONE:
    !has_next
    !index
    !count
    !count_status
    jmp L_JW_CHAT_TOOLS_FINISH

L_JW_CHAT_TOOLS_FINISH_EMPTY:
    !count_ok
    !count_status
    jmp L_JW_CHAT_TOOLS_FINISH

L_JW_CHAT_TOOLS_FINISH:
    wrote_any = load wrote_slot+0 as u64
    tmp_end_status = call @sa_json_writer_end_array(tmp_writer)
    tmp_finish_status = call @sa_json_writer_finish(tmp_writer, &tmp_buffer_slot)
    tmp_buffer = load tmp_buffer_slot+0 as ptr
    tmp_ptr = call @sa_json_buffer_data(&tmp_buffer)
    tmp_len = call @sa_json_buffer_len(&tmp_buffer)
    has_tools = ne wrote_any, 0
    br has_tools -> L_JW_CHAT_TOOLS_FIELD_NODE, L_JW_CHAT_TOOLS_FREE_EMPTY_NO_TOOLS

L_JW_CHAT_TOOLS_FIELD_NODE:
    !has_tools
    tools_array_node = call @sa_json_parse(&tmp_ptr, tmp_len)
    has_tools_node = ne tools_array_node, 0
    br has_tools_node -> L_JW_CHAT_TOOLS_FIELD_WRITE, L_JW_CHAT_TOOLS_FREE_EMPTY_AFTER_NODE

L_JW_CHAT_TOOLS_FIELD_WRITE:
    !has_tools_node
    field_status = call @sa_json_writer_field_node(writer, &FB_KEY_TOOLS, FB_KEY_TOOLS_LEN, tools_array_node)
    tools_node_free = call @sa_json_free(^tools_array_node)
    !tools_node_free
    tmp_buffer_free = call @sa_json_buffer_free(^tmp_buffer)
    tmp_writer_free = call @sa_json_writer_free(^tmp_writer)
    !tmp_writer_free
    !tmp_buffer_free
    !field_status
    !tmp_ptr
    !tmp_len
    !wrote_any
    !tmp_finish_status
    !tmp_end_status
    !tmp_begin_status
    !tmp_writer_status
    !writer
    !tools_node
    return 1

L_JW_CHAT_TOOLS_FREE_EMPTY_AFTER_NODE:
    !has_tools_node
    !tools_array_node
    jmp L_JW_CHAT_TOOLS_FREE_EMPTY

L_JW_CHAT_TOOLS_FREE_EMPTY_NO_TOOLS:
    !has_tools
    jmp L_JW_CHAT_TOOLS_FREE_EMPTY

L_JW_CHAT_TOOLS_FREE_EMPTY:
    tmp_buffer_free_empty = call @sa_json_buffer_free(^tmp_buffer)
    tmp_writer_free_empty = call @sa_json_writer_free(^tmp_writer)
    !tmp_writer_free_empty
    !tmp_buffer_free_empty
    !tmp_ptr
    !tmp_len
    !wrote_any
    !tmp_finish_status
    !tmp_end_status
    !tmp_begin_status
    !tmp_writer_status
    !writer
    !tools_node
    return 0

@ffi_wrapper chat_proxy_is_tools_key(&key: ptr, key_len: u64) -> u32:
L_ENTRY:
    tools_raw = call @sa_bytes_eq(&key, key_len, &FB_KEY_TOOLS, FB_KEY_TOOLS_LEN)
    tools_ok = eq tools_raw, 1
    br tools_ok -> L_TOOLS_YES, L_TOOLS_NO

L_TOOLS_YES:
    !tools_ok
    !tools_raw
    !key
    !key_len
    return 1

L_TOOLS_NO:
    !tools_ok
    !tools_raw
    !key
    !key_len
    return 0

@ffi_wrapper chat_proxy_is_drop_key(&key: ptr, key_len: u64) -> u32:
L_ENTRY:
    store_raw = call @sa_bytes_eq(&key, key_len, &CHAT_DROP_STORE, CHAT_DROP_STORE_LEN)
    store_ok = eq store_raw, 1
    br store_ok -> L_DROP_STORE, L_DROP_PROMPT

L_DROP_STORE:
    !store_ok
    !store_raw
    !key
    !key_len
    return 1

L_DROP_PROMPT:
    !store_ok
    !store_raw
    prompt_raw = call @sa_bytes_eq(&key, key_len, &CHAT_DROP_PROMPT_CACHE_KEY, CHAT_DROP_PROMPT_CACHE_KEY_LEN)
    prompt_ok = eq prompt_raw, 1
    br prompt_ok -> L_DROP_PROMPT_YES, L_DROP_INCLUDE

L_DROP_PROMPT_YES:
    !prompt_ok
    !prompt_raw
    !key
    !key_len
    return 1

L_DROP_INCLUDE:
    !prompt_ok
    !prompt_raw
    include_raw = call @sa_bytes_eq(&key, key_len, &CHAT_DROP_INCLUDE, CHAT_DROP_INCLUDE_LEN)
    include_ok = eq include_raw, 1
    br include_ok -> L_DROP_INCLUDE_YES, L_DROP_REASONING

L_DROP_INCLUDE_YES:
    !include_ok
    !include_raw
    !key
    !key_len
    return 1

L_DROP_REASONING:
    !include_ok
    !include_raw
    reasoning_raw = call @sa_bytes_eq(&key, key_len, &CHAT_DROP_REASONING, CHAT_DROP_REASONING_LEN)
    reasoning_ok = eq reasoning_raw, 1
    br reasoning_ok -> L_DROP_REASONING_YES, L_DROP_NO

L_DROP_REASONING_YES:
    !reasoning_ok
    !reasoning_raw
    !key
    !key_len
    return 1

L_DROP_NO:
    !reasoning_ok
    !reasoning_raw
    !key
    !key_len
    return 0

@ffi_wrapper responses_gemini_is_drop_key(&key: ptr, key_len: u64) -> u32:
L_ENTRY:
    store_raw = call @sa_bytes_eq(&key, key_len, &CHAT_DROP_STORE, CHAT_DROP_STORE_LEN)
    store_ok = eq store_raw, 1
    br store_ok -> L_RESP_DROP_STORE, L_RESP_DROP_PROMPT

L_RESP_DROP_STORE:
    !store_ok
    !store_raw
    !key
    !key_len
    return 1

L_RESP_DROP_PROMPT:
    !store_ok
    !store_raw
    prompt_raw = call @sa_bytes_eq(&key, key_len, &CHAT_DROP_PROMPT_CACHE_KEY, CHAT_DROP_PROMPT_CACHE_KEY_LEN)
    prompt_ok = eq prompt_raw, 1
    br prompt_ok -> L_RESP_DROP_PROMPT_YES, L_RESP_DROP_NO

L_RESP_DROP_PROMPT_YES:
    !prompt_ok
    !prompt_raw
    !key
    !key_len
    return 1

L_RESP_DROP_NO:
    !prompt_ok
    !prompt_raw
    !key
    !key_len
    return 0

@ffi_wrapper json_string_is_gemini_model(&model_ptr: ptr, model_len: u64) -> u32:
L_ENTRY:
    exact_raw = call @sa_bytes_eq(&model_ptr, model_len, &GEMINI_MODEL, GEMINI_MODEL_LEN)
    exact_ok = eq exact_raw, 1
    br exact_ok -> L_GEMINI_YES_EXACT, L_GEMINI_CHECK_PREFIX

L_GEMINI_YES_EXACT:
    !exact_ok
    !exact_raw
    !model_ptr
    !model_len
    return 1

L_GEMINI_CHECK_PREFIX:
    !exact_ok
    !exact_raw
    can_short = uge model_len, GEMINI_PREFIX_LEN
    br can_short -> L_GEMINI_SHORT_PREFIX, L_GEMINI_CHECK_MODELS

L_GEMINI_SHORT_PREFIX:
    !can_short
    short_raw = call @sa_bytes_eq(&model_ptr, GEMINI_PREFIX_LEN, &GEMINI_PREFIX, GEMINI_PREFIX_LEN)
    short_ok = eq short_raw, 1
    br short_ok -> L_GEMINI_YES_SHORT, L_GEMINI_SHORT_NO

L_GEMINI_YES_SHORT:
    !short_ok
    !short_raw
    !model_ptr
    !model_len
    return 1

L_GEMINI_SHORT_NO:
    !short_ok
    !short_raw
    jmp L_GEMINI_CHECK_MODELS_AFTER_SHORT

L_GEMINI_CHECK_MODELS:
    !can_short
    jmp L_GEMINI_CHECK_MODELS_AFTER_SHORT

L_GEMINI_CHECK_MODELS_AFTER_SHORT:
    can_models = uge model_len, MODELS_GEMINI_PREFIX_LEN
    br can_models -> L_GEMINI_MODELS_PREFIX, L_GEMINI_NO

L_GEMINI_MODELS_PREFIX:
    !can_models
    models_raw = call @sa_bytes_eq(&model_ptr, MODELS_GEMINI_PREFIX_LEN, &MODELS_GEMINI_PREFIX, MODELS_GEMINI_PREFIX_LEN)
    models_ok = eq models_raw, 1
    br models_ok -> L_GEMINI_YES_MODELS, L_GEMINI_MODELS_NO

L_GEMINI_YES_MODELS:
    !models_ok
    !models_raw
    !model_ptr
    !model_len
    return 1

L_GEMINI_MODELS_NO:
    !models_ok
    !models_raw
    jmp L_GEMINI_NO_AFTER_MODELS

L_GEMINI_NO:
    !can_models
    jmp L_GEMINI_NO_AFTER_MODELS

L_GEMINI_NO_AFTER_MODELS:
    !model_ptr
    !model_len
    return 0

@ffi_wrapper body_is_gemini_responses_request(&body: ptr, body_len: u64) -> u32:
L_ENTRY:
    root = call @sa_json_parse(&body, body_len)
    has_root = ne root, 0
    br has_root -> L_BODY_GEMINI_ROOT, L_BODY_GEMINI_NO_ROOT

L_BODY_GEMINI_ROOT:
    !has_root
    model_slot = stack_alloc 8
    model_status = call @sa_json_object_get(root, &FB_KEY_MODEL, FB_KEY_MODEL_LEN, &model_slot)
    model_ok = eq model_status, 0
    br model_ok -> L_BODY_GEMINI_MODEL, L_BODY_GEMINI_NO_MODEL

L_BODY_GEMINI_MODEL:
    !model_ok
    model_node = load model_slot+0 as ptr
    model_kind = call @sa_json_kind(model_node)
    model_is_string = eq model_kind, SA_JSON_KIND_STRING
    !model_kind
    br model_is_string -> L_BODY_GEMINI_STRING, L_BODY_GEMINI_MODEL_BAD

L_BODY_GEMINI_STRING:
    !model_is_string
    model_ptr = call @sa_json_string_ptr(model_node)
    model_len = call @sa_json_string_len(model_node)
    is_gemini = call @json_string_is_gemini_model(&model_ptr, model_len)
    model_free = call @sa_json_free(^model_node)
    !model_free
    root_free = call @sa_json_free(^root)
    !root_free
    !model_status
    !body
    !body_len
    return is_gemini

L_BODY_GEMINI_MODEL_BAD:
    !model_is_string
    model_free_bad = call @sa_json_free(^model_node)
    !model_free_bad
    jmp L_BODY_GEMINI_NO_MODEL_AFTER

L_BODY_GEMINI_NO_MODEL:
    !model_ok
    jmp L_BODY_GEMINI_NO_MODEL_AFTER

L_BODY_GEMINI_NO_MODEL_AFTER:
    root_free_no_model = call @sa_json_free(^root)
    !root_free_no_model
    !model_status
    !body
    !body_len
    return 0

L_BODY_GEMINI_NO_ROOT:
    !has_root
    !body
    !body_len
    return 0

@ffi_wrapper build_responses_proxy_body(&body: ptr, body_len: u64, is_gemini: u32, &out_len: ptr) -> ^ptr:
L_ENTRY:
    root = call @sa_json_parse(&body, body_len)
    has_root = ne root, 0
    br has_root -> L_RESP_PROXY_ROOT, L_RESP_PROXY_COPY_ORIGINAL_NO_ROOT

L_RESP_PROXY_ROOT:
    !has_root
    root_kind = call @sa_json_kind(root)
    root_is_object = eq root_kind, SA_JSON_KIND_OBJECT
    !root_kind
    br root_is_object -> L_RESP_PROXY_WRITER_INIT, L_RESP_PROXY_ROOT_BAD_KIND

L_RESP_PROXY_WRITER_INIT:
    !root_is_object
    writer_slot = stack_alloc 8
    buffer_slot = stack_alloc 8
    count_slot = stack_alloc 8
    index_slot = stack_alloc 8
    key_ptr_slot = stack_alloc 8
    key_len_slot = stack_alloc 8
    tools_slot = stack_alloc 8
    value_slot = stack_alloc 8
    writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot)
    writer = load writer_slot+0 as ptr
    begin_status = call @sa_json_writer_begin_object(writer)
    count_status = call @sa_json_value_count(root, &count_slot)
    count_ok = eq count_status, 0
    br count_ok -> L_RESP_PROXY_LOOP_INIT, L_RESP_PROXY_COUNT_BAD

L_RESP_PROXY_COUNT_BAD:
    !count_ok
    !count_status
    end_status_bad_count = call @sa_json_writer_end_object(writer)
    finish_status_bad_count = call @sa_json_writer_finish(writer, &buffer_slot)
    buffer_bad_count = load buffer_slot+0 as ptr
    data_ptr_bad_count = call @sa_json_buffer_data(&buffer_bad_count)
    data_len_bad_count = call @sa_json_buffer_len(&buffer_bad_count)
    out_bad_count = alloc data_len_bad_count
    copy_bad_count = call @sa_bytes_copy(&out_bad_count, &data_ptr_bad_count, data_len_bad_count)
    !copy_bad_count
    store out_len+0, data_len_bad_count as u64
    buffer_free_bad_count = call @sa_json_buffer_free(^buffer_bad_count)
    writer_free_bad_count = call @sa_json_writer_free(^writer)
    root_free_bad_count = call @sa_json_free(^root)
    !root_free_bad_count
    !writer_free_bad_count
    !buffer_free_bad_count
    !data_ptr_bad_count
    !data_len_bad_count
    !finish_status_bad_count
    !end_status_bad_count
    !begin_status
    !writer_status
    !is_gemini
    !body
    !body_len
    !out_len
    return out_bad_count

L_RESP_PROXY_LOOP_INIT:
    !count_ok
    count = load count_slot+0 as u64
    store index_slot+0, 0 as u64
    jmp L_RESP_PROXY_LOOP_COND

L_RESP_PROXY_LOOP_COND:
    index = load index_slot+0 as u64
    has_next = ult index, count
    br has_next -> L_RESP_PROXY_LOOP_BODY, L_RESP_PROXY_DONE

L_RESP_PROXY_LOOP_BODY:
    !has_next
    key_status = call @sa_json_object_key_at(root, index, &key_ptr_slot, &key_len_slot)
    key_ok = eq key_status, 0
    br key_ok -> L_RESP_PROXY_KEY, L_RESP_PROXY_NEXT_BAD_KEY

L_RESP_PROXY_KEY:
    !key_ok
    key_ptr = load key_ptr_slot+0 as ptr
    key_len = load key_len_slot+0 as u64
    gemini_drop_enabled = eq is_gemini, 1
    br gemini_drop_enabled -> L_RESP_PROXY_CHECK_DROP_KEY, L_RESP_PROXY_KEEP_FIELD_NO_DROP

L_RESP_PROXY_CHECK_DROP_KEY:
    !gemini_drop_enabled
    is_drop = call @responses_gemini_is_drop_key(&key_ptr, key_len)
    drop_ok = eq is_drop, 1
    br drop_ok -> L_RESP_PROXY_SKIP_KEY, L_RESP_PROXY_COPY_FIELD

L_RESP_PROXY_KEEP_FIELD_NO_DROP:
    !gemini_drop_enabled
    jmp L_RESP_PROXY_CHECK_TOOLS_FIELD

L_RESP_PROXY_COPY_FIELD:
    !drop_ok
    !is_drop
    jmp L_RESP_PROXY_CHECK_TOOLS_FIELD

L_RESP_PROXY_CHECK_TOOLS_FIELD:
    is_tools = call @chat_proxy_is_tools_key(&key_ptr, key_len)
    tools_ok = eq is_tools, 1
    br tools_ok -> L_RESP_PROXY_TOOLS_FIELD, L_RESP_PROXY_COPY_NORMAL_FIELD

L_RESP_PROXY_TOOLS_FIELD:
    !tools_ok
    !is_tools
    tools_status = call @sa_json_object_get(root, &FB_KEY_TOOLS, FB_KEY_TOOLS_LEN, &tools_slot)
    tools_found = eq tools_status, 0
    br tools_found -> L_RESP_PROXY_TOOLS_NODE, L_RESP_PROXY_TOOLS_MISSING

L_RESP_PROXY_TOOLS_NODE:
    !tools_found
    tools_node = load tools_slot+0 as ptr
    tools_append = call @json_writer_field_normalized_responses_tools(writer, tools_node)
    tools_free = call @sa_json_free(^tools_node)
    !tools_free
    !tools_append
    !tools_status
    jmp L_RESP_PROXY_NEXT_KEY

L_RESP_PROXY_TOOLS_MISSING:
    !tools_found
    !tools_status
    jmp L_RESP_PROXY_NEXT_KEY

L_RESP_PROXY_COPY_NORMAL_FIELD:
    !tools_ok
    !is_tools
    value_status = call @sa_json_object_get(root, &key_ptr, key_len, &value_slot)
    value_ok = eq value_status, 0
    br value_ok -> L_RESP_PROXY_VALUE, L_RESP_PROXY_VALUE_MISSING

L_RESP_PROXY_VALUE:
    !value_ok
    value_node = load value_slot+0 as ptr
    field_status = call @sa_json_writer_field_node(writer, &key_ptr, key_len, value_node)
    value_free = call @sa_json_free(^value_node)
    !value_free
    !field_status
    !value_status
    jmp L_RESP_PROXY_NEXT_KEY

L_RESP_PROXY_VALUE_MISSING:
    !value_ok
    !value_status
    jmp L_RESP_PROXY_NEXT_KEY

L_RESP_PROXY_SKIP_KEY:
    !drop_ok
    !is_drop
    jmp L_RESP_PROXY_NEXT_KEY

L_RESP_PROXY_NEXT_BAD_KEY:
    !key_ok
    !key_status
    jmp L_RESP_PROXY_ADVANCE

L_RESP_PROXY_NEXT_KEY:
    !key_ptr
    !key_len
    !key_status
    jmp L_RESP_PROXY_ADVANCE

L_RESP_PROXY_ADVANCE:
    next_index = add index, 1
    store index_slot+0, next_index as u64
    !next_index
    !index
    jmp L_RESP_PROXY_LOOP_COND

L_RESP_PROXY_DONE:
    !has_next
    !index
    !count
    !count_status
    end_status = call @sa_json_writer_end_object(writer)
    finish_status = call @sa_json_writer_finish(writer, &buffer_slot)
    buffer = load buffer_slot+0 as ptr
    data_ptr = call @sa_json_buffer_data(&buffer)
    data_len = call @sa_json_buffer_len(&buffer)
    out = alloc data_len
    copy_status = call @sa_bytes_copy(&out, &data_ptr, data_len)
    !copy_status
    store out_len+0, data_len as u64
    buffer_free = call @sa_json_buffer_free(^buffer)
    writer_free = call @sa_json_writer_free(^writer)
    root_free = call @sa_json_free(^root)
    !root_free
    !writer_free
    !buffer_free
    !data_ptr
    !data_len
    !finish_status
    !end_status
    !begin_status
    !writer_status
    !is_gemini
    !body
    !body_len
    !out_len
    return out

L_RESP_PROXY_ROOT_BAD_KIND:
    !root_is_object
    root_free_bad = call @sa_json_free(^root)
    !root_free_bad
    !is_gemini
    out_bad = alloc body_len
    bad_copy_status = call @sa_bytes_copy(&out_bad, &body, body_len)
    !bad_copy_status
    store out_len+0, body_len as u64
    !body
    !body_len
    !out_len
    return out_bad

L_RESP_PROXY_COPY_ORIGINAL_NO_ROOT:
    !has_root
    !root
    out_orig = alloc body_len
    orig_copy_status = call @sa_bytes_copy(&out_orig, &body, body_len)
    !orig_copy_status
    store out_len+0, body_len as u64
    !is_gemini
    !body
    !body_len
    !out_len
    return out_orig


@ffi_wrapper build_chat_proxy_body(&body: ptr, body_len: u64, &out_len: ptr) -> ^ptr:
L_ENTRY:
    root = call @sa_json_parse(&body, body_len)
    has_root = ne root, 0
    br has_root -> L_CHAT_PROXY_ROOT, L_CHAT_PROXY_COPY_ORIGINAL

L_CHAT_PROXY_ROOT:
    !has_root
    root_kind = call @sa_json_kind(root)
    root_is_object = eq root_kind, SA_JSON_KIND_OBJECT
    !root_kind
    br root_is_object -> L_CHAT_PROXY_WRITER_INIT, L_CHAT_PROXY_ROOT_BAD_KIND

L_CHAT_PROXY_WRITER_INIT:
    !root_is_object
    writer_slot = stack_alloc 8
    buffer_slot = stack_alloc 8
    count_slot = stack_alloc 8
    index_slot = stack_alloc 8
    key_ptr_slot = stack_alloc 8
    key_len_slot = stack_alloc 8
    tools_slot = stack_alloc 8
    value_slot = stack_alloc 8
    writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot)
    writer = load writer_slot+0 as ptr
    begin_status = call @sa_json_writer_begin_object(writer)
    count_status = call @sa_json_value_count(root, &count_slot)
    count_ok = eq count_status, 0
    br count_ok -> L_CHAT_PROXY_LOOP_INIT, L_CHAT_PROXY_ROOT_BAD

L_CHAT_PROXY_LOOP_INIT:
    !count_ok
    count = load count_slot+0 as u64
    store index_slot+0, 0 as u64
    jmp L_CHAT_PROXY_LOOP_COND

L_CHAT_PROXY_LOOP_COND:
    index = load index_slot+0 as u64
    has_next = ult index, count
    br has_next -> L_CHAT_PROXY_LOOP_BODY, L_CHAT_PROXY_DONE

L_CHAT_PROXY_LOOP_BODY:
    !has_next
    key_status = call @sa_json_object_key_at(root, index, &key_ptr_slot, &key_len_slot)
    key_ok = eq key_status, 0
    br key_ok -> L_CHAT_PROXY_KEY, L_CHAT_PROXY_NEXT_BAD_KEY

L_CHAT_PROXY_KEY:
    !key_ok
    key_ptr = load key_ptr_slot+0 as ptr
    key_len = load key_len_slot+0 as u64
    is_drop = call @chat_proxy_is_drop_key(&key_ptr, key_len)
    drop_ok = eq is_drop, 1
    br drop_ok -> L_CHAT_PROXY_SKIP_KEY, L_CHAT_PROXY_CHECK_TOOLS

L_CHAT_PROXY_CHECK_TOOLS:
    !drop_ok
    !is_drop
    is_tools = call @chat_proxy_is_tools_key(&key_ptr, key_len)
    tools_ok = eq is_tools, 1
    br tools_ok -> L_CHAT_PROXY_TOOLS_FIELD, L_CHAT_PROXY_COPY_FIELD

L_CHAT_PROXY_TOOLS_FIELD:
    !tools_ok
    !is_tools
    tools_status = call @sa_json_object_get(root, &FB_KEY_TOOLS, FB_KEY_TOOLS_LEN, &tools_slot)
    tools_found = eq tools_status, 0
    br tools_found -> L_CHAT_PROXY_TOOLS_NODE, L_CHAT_PROXY_TOOLS_MISSING

L_CHAT_PROXY_TOOLS_NODE:
    !tools_found
    tools_node = load tools_slot+0 as ptr
    tools_append = call @json_writer_field_normalized_chat_tools(writer, tools_node)
    tools_free = call @sa_json_free(^tools_node)
    !tools_free
    !tools_append
    !tools_status
    jmp L_CHAT_PROXY_NEXT_KEY

L_CHAT_PROXY_TOOLS_MISSING:
    !tools_found
    !tools_status
    jmp L_CHAT_PROXY_NEXT_KEY

L_CHAT_PROXY_COPY_FIELD:
    !tools_ok
    !is_tools
    value_status = call @sa_json_object_get(root, &key_ptr, key_len, &value_slot)
    value_ok = eq value_status, 0
    br value_ok -> L_CHAT_PROXY_VALUE, L_CHAT_PROXY_VALUE_MISSING

L_CHAT_PROXY_VALUE:
    !value_ok
    value_node = load value_slot+0 as ptr
    field_status = call @sa_json_writer_field_node(writer, &key_ptr, key_len, value_node)
    value_free = call @sa_json_free(^value_node)
    !value_free
    !field_status
    !value_status
    jmp L_CHAT_PROXY_NEXT_KEY

L_CHAT_PROXY_VALUE_MISSING:
    !value_ok
    !value_status
    jmp L_CHAT_PROXY_NEXT_KEY

L_CHAT_PROXY_SKIP_KEY:
    !drop_ok
    !is_drop
    jmp L_CHAT_PROXY_NEXT_KEY

L_CHAT_PROXY_NEXT_BAD_KEY:
    !key_ok
    !key_status
    jmp L_CHAT_PROXY_ADVANCE

L_CHAT_PROXY_NEXT_KEY:
    !key_ptr
    !key_len
    !key_status
    jmp L_CHAT_PROXY_ADVANCE

L_CHAT_PROXY_ADVANCE:
    next_index = add index, 1
    store index_slot+0, next_index as u64
    !next_index
    !index
    jmp L_CHAT_PROXY_LOOP_COND

L_CHAT_PROXY_DONE:
    !has_next
    !index
    !count
    !count_status
    end_status = call @sa_json_writer_end_object(writer)
    finish_status = call @sa_json_writer_finish(writer, &buffer_slot)
    buffer = load buffer_slot+0 as ptr
    data_ptr = call @sa_json_buffer_data(&buffer)
    data_len = call @sa_json_buffer_len(&buffer)
    out = alloc data_len
    copy_status = call @sa_bytes_copy(&out, &data_ptr, data_len)
    !copy_status
    store out_len+0, data_len as u64
    buffer_free = call @sa_json_buffer_free(^buffer)
    writer_free = call @sa_json_writer_free(^writer)
    root_free = call @sa_json_free(^root)
    !root_free
    !writer_free
    !buffer_free
    !data_ptr
    !data_len
    !finish_status
    !end_status
    !begin_status
    !writer_status
    !body
    !body_len
    !out_len
    return out

L_CHAT_PROXY_ROOT_BAD:
    !count_ok
    writer_free_bad_count = call @sa_json_writer_free(^writer)
    !writer_free_bad_count
    root_free_bad = call @sa_json_free(^root)
    !root_free_bad
    !count_status
    !begin_status
    !writer_status
    out_bad = alloc body_len
    bad_copy_status = call @sa_bytes_copy(&out_bad, &body, body_len)
    !bad_copy_status
    store out_len+0, body_len as u64
    !body
    !body_len
    !out_len
    return out_bad

L_CHAT_PROXY_ROOT_BAD_KIND:
    !root_is_object
    root_free_bad_kind = call @sa_json_free(^root)
    !root_free_bad_kind
    out_bad_kind = alloc body_len
    bad_kind_copy_status = call @sa_bytes_copy(&out_bad_kind, &body, body_len)
    !bad_kind_copy_status
    store out_len+0, body_len as u64
    !body
    !body_len
    !out_len
    return out_bad_kind

L_CHAT_PROXY_COPY_ORIGINAL:
    !has_root
    !root
    out_orig = alloc body_len
    orig_copy_status = call @sa_bytes_copy(&out_orig, &body, body_len)
    !orig_copy_status
    store out_len+0, body_len as u64
    !body
    !body_len
    !out_len
    return out_orig


@ffi_wrapper build_chat_fallback_body(&body: ptr, body_len: u64, &model_ptr: ptr, model_len: u64, &out_len: ptr) -> ^ptr:
L_ENTRY:
    std_fb_ptr_slot = stack_alloc 8
    std_fb_len_slot = stack_alloc 8
    std_fb_status = call @sa_deno_plugin_responses_chat_fallback_request(&body, body_len, &model_ptr, model_len, 0, &std_fb_ptr_slot, &std_fb_len_slot)
    std_fb_ok = eq std_fb_status, 0
    br std_fb_ok -> L_CHAT_FB_STD_COPY, L_CHAT_FB_STD_FAIL

L_CHAT_FB_STD_COPY:
    !std_fb_ok
    std_fb_ptr = load std_fb_ptr_slot+0 as ptr
    std_fb_len = load std_fb_len_slot+0 as u64
    out_std_fb = alloc std_fb_len
    std_fb_copy_status = call @sa_bytes_copy(&out_std_fb, &std_fb_ptr, std_fb_len)
    !std_fb_copy_status
    std_fb_free_status = call @sa_deno_plugin_free_buffer(std_fb_ptr, std_fb_len)
    !std_fb_free_status
    store out_len+0, std_fb_len as u64
    !std_fb_ptr
    !std_fb_len
    !std_fb_status
    !body
    !body_len
    !model_ptr
    !model_len
    !out_len
    return out_std_fb

L_CHAT_FB_STD_FAIL:
    !std_fb_ok
    !std_fb_status
    store out_len+0, 0 as u64
    out_empty = alloc 1
    !body
    !body_len
    !model_ptr
    !model_len
    !out_len
    return out_empty

@ffi_wrapper b64_emit_char(&out: ptr, &out_i_slot: ptr, idx: u64) -> u32:
L_ENTRY:
    alphabet = &B64_ALPHABET
    char_ptr = ptr_add alphabet, idx
    ch = load char_ptr+0 as u8
    out_i = load out_i_slot+0 as u64
    dst = ptr_add out, out_i
    store dst+0, ch as u8
    next = add out_i, 1
    store out_i_slot+0, next as u64
    !next
    !dst
    !out_i
    !ch
    !char_ptr
    !alphabet
    !idx
    !out_i_slot
    !out
    return 0

@ffi_wrapper base64_encode_into(&src: ptr, src_len: u64, &out: ptr, &out_len_slot: ptr) -> u32:
L_ENTRY:
    i_slot = stack_alloc 8
    out_i_slot = stack_alloc 8
    has_b1_slot = stack_alloc 1
    has_b2_slot = stack_alloc 1
    store i_slot+0, 0 as u64
    store out_i_slot+0, 0 as u64
    jmp L_B64_COND

L_B64_COND:
    i = load i_slot+0 as u64
    done = uge i, src_len
    br done -> L_B64_DONE, L_B64_BODY

L_B64_BODY:
    !done
    p0 = ptr_add src, i
    b0u8 = load p0+0 as u8
    b0 = bitcast b0u8 as u64
    i1 = add i, 1
    has_b1 = ult i1, src_len
    store has_b1_slot+0, has_b1 as u8
    br has_b1 -> L_B64_LOAD_B1, L_B64_NO_B1

L_B64_LOAD_B1:
    !has_b1
    p1 = ptr_add src, i1
    b1u8 = load p1+0 as u8
    b1 = bitcast b1u8 as u64
    !b1u8
    !p1
    jmp L_B64_HAVE_B1

L_B64_NO_B1:
    !has_b1
    b1 = add 0, 0
    jmp L_B64_HAVE_B1

L_B64_HAVE_B1:
    i2 = add i, 2
    has_b2 = ult i2, src_len
    store has_b2_slot+0, has_b2 as u8
    br has_b2 -> L_B64_LOAD_B2, L_B64_NO_B2

L_B64_LOAD_B2:
    !has_b2
    p2 = ptr_add src, i2
    b2u8 = load p2+0 as u8
    b2 = bitcast b2u8 as u64
    !b2u8
    !p2
    jmp L_B64_ENCODE

L_B64_NO_B2:
    !has_b2
    b2 = add 0, 0
    jmp L_B64_ENCODE

L_B64_ENCODE:
    idx0 = udiv b0, 4
    b0_low = urem b0, 4
    b0_low_shift = mul b0_low, 16
    b1_hi = udiv b1, 16
    idx1 = add b0_low_shift, b1_hi
    b1_low = urem b1, 16
    b1_low_shift = mul b1_low, 4
    b2_hi = udiv b2, 64
    idx2 = add b1_low_shift, b2_hi
    idx3 = urem b2, 64
    call @b64_emit_char(&out, &out_i_slot, idx0)
    call @b64_emit_char(&out, &out_i_slot, idx1)
    has_b1_again = load has_b1_slot+0 as u8
    br has_b1_again -> L_B64_EMIT_2, L_B64_PAD_2

L_B64_EMIT_2:
    !has_b1_again
    call @b64_emit_char(&out, &out_i_slot, idx2)
    has_b2_again = load has_b2_slot+0 as u8
    br has_b2_again -> L_B64_EMIT_3, L_B64_PAD_3

L_B64_PAD_2:
    !has_b1_again
    out_i_a = load out_i_slot+0 as u64
    dst_a = ptr_add out, out_i_a
    store dst_a+0, 61 as u8
    next_a = add out_i_a, 1
    store out_i_slot+0, next_a as u64
    !next_a
    !dst_a
    !out_i_a
    out_i_b = load out_i_slot+0 as u64
    dst_b = ptr_add out, out_i_b
    store dst_b+0, 61 as u8
    next_b = add out_i_b, 1
    store out_i_slot+0, next_b as u64
    !next_b
    !dst_b
    !out_i_b
    jmp L_B64_NEXT

L_B64_EMIT_3:
    !has_b2_again
    call @b64_emit_char(&out, &out_i_slot, idx3)
    jmp L_B64_NEXT

L_B64_PAD_3:
    !has_b2_again
    out_i_c = load out_i_slot+0 as u64
    dst_c = ptr_add out, out_i_c
    store dst_c+0, 61 as u8
    next_c = add out_i_c, 1
    store out_i_slot+0, next_c as u64
    !next_c
    !dst_c
    !out_i_c
    jmp L_B64_NEXT

L_B64_NEXT:
    !idx0
    !b0_low
    !b0_low_shift
    !b1_hi
    !idx1
    !b1_low
    !b1_low_shift
    !b2_hi
    !idx2
    !idx3
    !b0u8
    !b0
    !b1
    !b2
    !p0
    !i1
    !i2
    next_i = add i, 3
    store i_slot+0, next_i as u64
    !next_i
    !i
    jmp L_B64_COND

L_B64_DONE:
    !done
    !i
    final_len = load out_i_slot+0 as u64
    store out_len_slot+0, final_len as u64
    !final_len
    !src
    !src_len
    !out
    !out_len_slot
    return 0

@ffi_wrapper rpc_extract_command_argv(&body: ptr, body_len: u64, &argv: ptr, &out_count: ptr) -> u32:
L_ENTRY:
    start_idx = call @sa_bytes_find(&body, body_len, &J_COMMAND_ARRAY_START, J_COMMAND_ARRAY_START_LEN)
    found = sge start_idx, 0
    br found -> L_CMD_PARSE_INIT, L_CMD_PARSE_NOT_FOUND

L_CMD_PARSE_INIT:
    !found
    start_off_i = add start_idx, J_COMMAND_ARRAY_START_LEN
    !start_idx
    start_off = bitcast start_off_i as u64
    cursor_slot = stack_alloc 8
    count_slot = stack_alloc 8
    store cursor_slot+0, start_off as u64
    store count_slot+0, 0 as u64
    !start_off
    !start_off_i
    jmp L_CMD_ARG_START

L_CMD_ARG_START:
    count = load count_slot+0 as u64
    too_many = uge count, CMD_ARGV_MAX
    br too_many -> L_CMD_DONE_MAX, L_CMD_FIND_END

L_CMD_FIND_END:
    !too_many
    cursor = load cursor_slot+0 as u64
    rem = sub body_len, cursor
    arg_ptr = ptr_add body, cursor
    end_idx = call @sa_bytes_find_byte(&arg_ptr, rem, 34)
    has_end = sge end_idx, 0
    br has_end -> L_CMD_STORE_ARG, L_CMD_DONE_NO_MORE

L_CMD_STORE_ARG:
    !has_end
    arg_len = bitcast end_idx as u64
    off = mul count, SaProcessArgv_SIZE
    entry = ptr_add argv, off
    store entry+SaProcessArgv_data, arg_ptr as ptr
    store entry+SaProcessArgv_len, arg_len as u64
    next_count = add count, 1
    store count_slot+0, next_count as u64
    after_quote = add cursor, arg_len
    next_after_quote = add after_quote, 1
    rem_after = sub body_len, next_after_quote
    sep_ptr = ptr_add body, next_after_quote
    sep_idx = call @sa_bytes_find(&sep_ptr, rem_after, &J_ARG_SEPARATOR, J_ARG_SEPARATOR_LEN)
    sep_here = eq sep_idx, 0
    br sep_here -> L_CMD_NEXT_ARG, L_CMD_DONE_AFTER_ARG

L_CMD_NEXT_ARG:
    !sep_here
    !sep_idx
    next_cursor = add next_after_quote, J_ARG_SEPARATOR_LEN
    store cursor_slot+0, next_cursor as u64
    !next_cursor
    !sep_ptr
    !rem_after
    !next_after_quote
    !after_quote
    !next_count
    !entry
    !off
    !arg_len
    !end_idx
    !arg_ptr
    !rem
    !cursor
    !count
    jmp L_CMD_ARG_START

L_CMD_DONE_AFTER_ARG:
    !sep_here
    !sep_idx
    !sep_ptr
    !rem_after
    !next_after_quote
    !after_quote
    !next_count
    !entry
    !off
    !arg_len
    !end_idx
    !arg_ptr
    !rem
    !cursor
    !count
    jmp L_CMD_DONE

L_CMD_DONE_NO_MORE:
    !has_end
    !end_idx
    !arg_ptr
    !rem
    !cursor
    !count
    jmp L_CMD_DONE

L_CMD_DONE_MAX:
    !too_many
    !count
    jmp L_CMD_DONE

L_CMD_DONE:
    final_count = load count_slot+0 as u64
    store out_count+0, final_count as u64
    ok = ugt final_count, 0
    br ok -> L_CMD_OK, L_CMD_BAD

L_CMD_OK:
    !ok
    !final_count
    !body
    !body_len
    !argv
    !out_count
    return 1

L_CMD_BAD:
    !ok
    !final_count
    !body
    !body_len
    !argv
    !out_count
    return 0

L_CMD_PARSE_NOT_FOUND:
    !found
    !start_idx
    !body
    !body_len
    !argv
    !out_count
    return 0

@ffi_wrapper notify_command_output(&state_ptr: ptr, &process_id_ptr: ptr, process_id_len: u64, &stream_ptr: ptr, stream_len: u64, &data_ptr: ptr, data_len: u64) -> u32:
L_ENTRY:
    has_data = ugt data_len, 0
    br has_data -> L_CMD_NOTIFY_DO, L_CMD_NOTIFY_SKIP

L_CMD_NOTIFY_DO:
    !has_data
    b64_buf = stack_alloc CMD_OUTPUT_BUF_SIZE
    b64_len_slot = stack_alloc 8
    b64_status = call @base64_encode_into(&data_ptr, data_len, &b64_buf, &b64_len_slot)
    !b64_status
    b64_len = load b64_len_slot+0 as u64
    writer_slot = stack_alloc 8
    writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot)
    writer = load writer_slot+0 as ptr
    begin_status = call @sa_json_writer_begin_object(writer)
    pid_status = call @sa_json_writer_field_string(writer, &JSON_KEY_PROCESS_ID, JSON_KEY_PROCESS_ID_LEN, &process_id_ptr, process_id_len)
    stream_status = call @sa_json_writer_field_string(writer, &JSON_KEY_STREAM, JSON_KEY_STREAM_LEN, &stream_ptr, stream_len)
    delta_status = call @sa_json_writer_field_string(writer, &JSON_KEY_DELTA_BASE64, JSON_KEY_DELTA_BASE64_LEN, &b64_buf, b64_len)
    cap_status = call @sa_json_writer_field_bool(writer, &JSON_KEY_CAP_REACHED, JSON_KEY_CAP_REACHED_LEN, 0)
    end_status = call @sa_json_writer_end_object(writer)
    call @notify_writer_params(&state_ptr, &EV_CMD_OUTPUT, EV_CMD_OUTPUT_LEN, writer)
    !end_status
    !cap_status
    !delta_status
    !stream_status
    !pid_status
    !begin_status
    !writer_status
    !b64_len
    !state_ptr
    !process_id_ptr
    !process_id_len
    !stream_ptr
    !stream_len
    !data_ptr
    !data_len
    return 0

L_CMD_NOTIFY_SKIP:
    !has_data
    !state_ptr
    !process_id_ptr
    !process_id_len
    !stream_ptr
    !stream_len
    !data_ptr
    !data_len
    return 0

@ffi_wrapper send_rpc_command_exec(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    argv = stack_alloc CMD_ARGV_BUF_SIZE
    count_slot = stack_alloc 8
    parse_ok = call @rpc_extract_command_argv(&body, body_len, &argv, &count_slot)
    has_command = eq parse_ok, 1
    !parse_ok
    br has_command -> L_CMD_EXEC_PROCESS_ID, L_CMD_EXEC_BAD_PARAMS

L_CMD_EXEC_PROCESS_ID:
    !has_command
    process_id_ptr_slot = stack_alloc 8
    process_id_len_slot = stack_alloc 8
    pid_status = call @rpc_extract_string_after(&body, body_len, &J_PROCESS_ID_KEY, J_PROCESS_ID_KEY_LEN, &process_id_ptr_slot, &process_id_len_slot)
    has_pid = eq pid_status, 1
    !pid_status
    br has_pid -> L_CMD_EXEC_WITH_PID, L_CMD_EXEC_DEFAULT_PID

L_CMD_EXEC_WITH_PID:
    !has_pid
    jmp L_CMD_EXEC_RUN

L_CMD_EXEC_DEFAULT_PID:
    !has_pid
    default_pid_ptr = &DEFAULT_PROCESS_ID
    store process_id_ptr_slot+0, default_pid_ptr as ptr
    store process_id_len_slot+0, DEFAULT_PROCESS_ID_LEN as u64
    !default_pid_ptr
    jmp L_CMD_EXEC_RUN

L_CMD_EXEC_RUN:
    process_id_ptr = load process_id_ptr_slot+0 as ptr
    process_id_len = load process_id_len_slot+0 as u64
    cwd_ptr_slot = stack_alloc 8
    cwd_len_slot = stack_alloc 8
    cwd_status = call @rpc_extract_string_after(&body, body_len, &J_CWD_KEY, J_CWD_KEY_LEN, &cwd_ptr_slot, &cwd_len_slot)
    has_cwd = eq cwd_status, 1
    !cwd_status
    br has_cwd -> L_CMD_EXEC_RUN_WITH_CWD_DIRECT, L_CMD_EXEC_DEFAULT_CWD

L_CMD_EXEC_DEFAULT_CWD:
    !has_cwd
    default_cwd_ptr = &DEFAULT_CWD
    store cwd_ptr_slot+0, default_cwd_ptr as ptr
    store cwd_len_slot+0, DEFAULT_CWD_LEN as u64
    !default_cwd_ptr
    jmp L_CMD_EXEC_RUN_AFTER_CWD

L_CMD_EXEC_RUN_WITH_CWD_DIRECT:
    !has_cwd
    jmp L_CMD_EXEC_RUN_AFTER_CWD

L_CMD_EXEC_RUN_AFTER_CWD:
    cwd_ptr = load cwd_ptr_slot+0 as ptr
    cwd_len = load cwd_len_slot+0 as u64
    count = load count_slot+0 as u64
    EXPAND DENO_COMMAND_RUN_CWD run_status, process_handle, argv, count, cwd_ptr, cwd_len
    run_ok = eq run_status, 0
    !run_status
    br run_ok -> L_CMD_EXEC_WAIT, L_CMD_EXEC_RUN_ERR

L_CMD_EXEC_WAIT:
    !run_ok
    EXPAND DENO_COMMAND_WAIT wait_status, exit_code_u32, process_handle
    wait_ok = eq wait_status, 0
    !wait_status
    br wait_ok -> L_CMD_EXEC_READ, L_CMD_EXEC_WAIT_ERR

L_CMD_EXEC_READ:
    !wait_ok
    stdout_buf = stack_alloc CMD_OUTPUT_BUF_SIZE
    stderr_buf = stack_alloc CMD_OUTPUT_BUF_SIZE
    EXPAND DENO_COMMAND_READ_STDOUT stdout_status, stdout_len, process_handle, stdout_buf, CMD_OUTPUT_BUF_SIZE
    EXPAND DENO_COMMAND_READ_STDERR stderr_status, stderr_len, process_handle, stderr_buf, CMD_OUTPUT_BUF_SIZE
    !stdout_status
    !stderr_status
    exit_code = zext exit_code_u32
    call @notify_command_output(&state_ptr, &process_id_ptr, process_id_len, &STREAM_STDOUT, STREAM_STDOUT_LEN, &stdout_buf, stdout_len)
    call @notify_command_output(&state_ptr, &process_id_ptr, process_id_len, &STREAM_STDERR, STREAM_STDERR_LEN, &stderr_buf, stderr_len)
    writer_slot = stack_alloc 8
    writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot)
    writer = load writer_slot+0 as ptr
    begin_status = call @sa_json_writer_begin_object(writer)
    exit_i64 = bitcast exit_code as i64
    exit_field = call @sa_json_writer_field_i64(writer, &JSON_KEY_EXIT_CODE, JSON_KEY_EXIT_CODE_LEN, exit_i64)
    stdout_field = call @sa_json_writer_field_string(writer, &JSON_KEY_STDOUT, JSON_KEY_STDOUT_LEN, &stdout_buf, stdout_len)
    stderr_field = call @sa_json_writer_field_string(writer, &JSON_KEY_STDERR, JSON_KEY_STDERR_LEN, &stderr_buf, stderr_len)
    end_status = call @sa_json_writer_end_object(writer)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !end_status
    !stderr_field
    !stdout_field
    !exit_field
    !exit_i64
    !begin_status
    !writer_status
    EXPAND DENO_COMMAND_CLOSE close_status, process_handle
    !close_status
    !exit_code_u32
    !exit_code
    !stdout_len
    !stderr_len
    !process_handle
    !count
    !cwd_ptr
    !cwd_len
    !process_id_ptr
    !process_id_len
    !body
    !body_len
    !state_ptr
    !req
    return 0

L_CMD_EXEC_RUN_ERR:
    !run_ok
    !process_handle
    !count
    !cwd_ptr
    !cwd_len
    !process_id_ptr
    !process_id_len
    call @send_error_with_id(&req, 500, &id_ptr, id_len, &J_ERR_FS, J_ERR_FS_LEN)
    !body
    !body_len
    !state_ptr
    !req
    return 0

L_CMD_EXEC_WAIT_ERR:
    !wait_ok
    !exit_code_u32
    EXPAND DENO_COMMAND_CLOSE close_status_err, process_handle
    !close_status_err
    !process_handle
    !count
    !cwd_ptr
    !cwd_len
    !process_id_ptr
    !process_id_len
    call @send_error_with_id(&req, 500, &id_ptr, id_len, &J_ERR_FS, J_ERR_FS_LEN)
    !body
    !body_len
    !state_ptr
    !req
    return 0

L_CMD_EXEC_BAD_PARAMS:
    !has_command
    call @send_error_with_id(&req, 400, &id_ptr, id_len, &J_ERR_INVALID_PARAMS, J_ERR_INVALID_PARAMS_LEN)
    !body
    !body_len
    !state_ptr
    !req
    return 0

@ffi_wrapper notify_process_output(&state_ptr: ptr, &handle_ptr: ptr, handle_len: u64, &stream_ptr: ptr, stream_len: u64, &data_ptr: ptr, data_len: u64) -> u32:
L_ENTRY:
    has_data = ugt data_len, 0
    br has_data -> L_PROC_NOTIFY_DO, L_PROC_NOTIFY_SKIP

L_PROC_NOTIFY_DO:
    !has_data
    b64_buf = stack_alloc CMD_OUTPUT_BUF_SIZE
    b64_len_slot = stack_alloc 8
    b64_status = call @base64_encode_into(&data_ptr, data_len, &b64_buf, &b64_len_slot)
    !b64_status
    b64_len = load b64_len_slot+0 as u64
    writer_slot = stack_alloc 8
    writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot)
    writer = load writer_slot+0 as ptr
    begin_status = call @sa_json_writer_begin_object(writer)
    handle_status = call @sa_json_writer_field_string(writer, &JSON_KEY_PROCESS_HANDLE, JSON_KEY_PROCESS_HANDLE_LEN, &handle_ptr, handle_len)
    stream_status = call @sa_json_writer_field_string(writer, &JSON_KEY_STREAM, JSON_KEY_STREAM_LEN, &stream_ptr, stream_len)
    delta_status = call @sa_json_writer_field_string(writer, &JSON_KEY_DELTA_BASE64, JSON_KEY_DELTA_BASE64_LEN, &b64_buf, b64_len)
    cap_status = call @sa_json_writer_field_bool(writer, &JSON_KEY_CAP_REACHED, JSON_KEY_CAP_REACHED_LEN, 0)
    end_status = call @sa_json_writer_end_object(writer)
    call @notify_writer_params(&state_ptr, &EV_PROCESS_OUTPUT, EV_PROCESS_OUTPUT_LEN, writer)
    !end_status
    !cap_status
    !delta_status
    !stream_status
    !handle_status
    !begin_status
    !writer_status
    !b64_len
    !state_ptr
    !handle_ptr
    !handle_len
    !stream_ptr
    !stream_len
    !data_ptr
    !data_len
    return 0

L_PROC_NOTIFY_SKIP:
    !has_data
    !state_ptr
    !handle_ptr
    !handle_len
    !stream_ptr
    !stream_len
    !data_ptr
    !data_len
    return 0

@ffi_wrapper notify_process_exited(&state_ptr: ptr, &handle_ptr: ptr, handle_len: u64, exit_code: u64, &stdout_ptr: ptr, stdout_len: u64, &stderr_ptr: ptr, stderr_len: u64) -> u32:
L_ENTRY:
    writer_slot = stack_alloc 8
    writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot)
    writer = load writer_slot+0 as ptr
    begin_status = call @sa_json_writer_begin_object(writer)
    handle_field = call @sa_json_writer_field_string(writer, &JSON_KEY_PROCESS_HANDLE, JSON_KEY_PROCESS_HANDLE_LEN, &handle_ptr, handle_len)
    exit_i64 = bitcast exit_code as i64
    exit_field = call @sa_json_writer_field_i64(writer, &JSON_KEY_EXIT_CODE, JSON_KEY_EXIT_CODE_LEN, exit_i64)
    stdout_field = call @sa_json_writer_field_string(writer, &JSON_KEY_STDOUT, JSON_KEY_STDOUT_LEN, &stdout_ptr, stdout_len)
    stdout_cap_field = call @sa_json_writer_field_bool(writer, &JSON_KEY_STDOUT_CAP, JSON_KEY_STDOUT_CAP_LEN, 0)
    stderr_field = call @sa_json_writer_field_string(writer, &JSON_KEY_STDERR, JSON_KEY_STDERR_LEN, &stderr_ptr, stderr_len)
    stderr_cap_field = call @sa_json_writer_field_bool(writer, &JSON_KEY_STDERR_CAP, JSON_KEY_STDERR_CAP_LEN, 0)
    end_status = call @sa_json_writer_end_object(writer)
    notify_status = call @notify_writer_params(&state_ptr, &EV_PROCESS_EXITED, EV_PROCESS_EXITED_LEN, writer)
    !notify_status
    !end_status
    !stderr_cap_field
    !stderr_field
    !stdout_cap_field
    !stdout_field
    !exit_field
    !exit_i64
    !handle_field
    !begin_status
    !writer_status
    !state_ptr
    !handle_ptr
    !handle_len
    !exit_code
    !stdout_ptr
    !stdout_len
    !stderr_ptr
    !stderr_len
    return 0

@ffi_wrapper send_rpc_process_spawn(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    argv = stack_alloc CMD_ARGV_BUF_SIZE
    count_slot = stack_alloc 8
    parse_ok = call @rpc_extract_command_argv(&body, body_len, &argv, &count_slot)
    has_command = eq parse_ok, 1
    !parse_ok
    br has_command -> L_PROC_HANDLE, L_PROC_DEFAULT_COMMAND

L_PROC_DEFAULT_COMMAND:
    !has_command
    default_arg_ptr = &DEFAULT_TRUE
    store argv+SaProcessArgv_data, default_arg_ptr as ptr
    store argv+SaProcessArgv_len, DEFAULT_TRUE_LEN as u64
    store count_slot+0, 1 as u64
    !default_arg_ptr
    jmp L_PROC_HANDLE_FROM_DEFAULT

L_PROC_HANDLE:
    !has_command

L_PROC_HANDLE_FROM_DEFAULT:
    handle_ptr_slot = stack_alloc 8
    handle_len_slot = stack_alloc 8
    handle_status = call @rpc_extract_string_after(&body, body_len, &J_PROCESS_HANDLE_KEY, J_PROCESS_HANDLE_KEY_LEN, &handle_ptr_slot, &handle_len_slot)
    has_handle = eq handle_status, 1
    !handle_status
    br has_handle -> L_PROC_RUN, L_PROC_DEFAULT_HANDLE

L_PROC_DEFAULT_HANDLE:
    !has_handle
    default_handle_ptr = &DEFAULT_PROCESS_HANDLE
    store handle_ptr_slot+0, default_handle_ptr as ptr
    store handle_len_slot+0, DEFAULT_PROCESS_HANDLE_LEN as u64
    !default_handle_ptr
    jmp L_PROC_RUN_FROM_DEFAULT

L_PROC_RUN:
    !has_handle

L_PROC_RUN_FROM_DEFAULT:
    handle_ptr = load handle_ptr_slot+0 as ptr
    handle_len = load handle_len_slot+0 as u64
    cwd_ptr_slot = stack_alloc 8
    cwd_len_slot = stack_alloc 8
    cwd_status = call @rpc_extract_string_after(&body, body_len, &J_CWD_KEY, J_CWD_KEY_LEN, &cwd_ptr_slot, &cwd_len_slot)
    has_cwd = eq cwd_status, 1
    !cwd_status
    br has_cwd -> L_PROC_RUN_WITH_CWD_DIRECT, L_PROC_DEFAULT_CWD

L_PROC_DEFAULT_CWD:
    !has_cwd
    default_cwd_ptr = &DEFAULT_CWD
    store cwd_ptr_slot+0, default_cwd_ptr as ptr
    store cwd_len_slot+0, DEFAULT_CWD_LEN as u64
    !default_cwd_ptr
    jmp L_PROC_RUN_AFTER_CWD

L_PROC_RUN_WITH_CWD_DIRECT:
    !has_cwd
    jmp L_PROC_RUN_AFTER_CWD

L_PROC_RUN_AFTER_CWD:
    cwd_ptr = load cwd_ptr_slot+0 as ptr
    cwd_len = load cwd_len_slot+0 as u64
    count = load count_slot+0 as u64
    EXPAND DENO_COMMAND_RUN_CWD run_status, process_handle, argv, count, cwd_ptr, cwd_len
    run_ok = eq run_status, 0
    !run_status
    br run_ok -> L_PROC_WAIT, L_PROC_RUN_ERR

L_PROC_WAIT:
    !run_ok
    EXPAND DENO_COMMAND_WAIT wait_status, exit_code_u32, process_handle
    wait_ok = eq wait_status, 0
    !wait_status
    br wait_ok -> L_PROC_READ, L_PROC_WAIT_ERR

L_PROC_READ:
    !wait_ok
    stdout_buf = stack_alloc CMD_OUTPUT_BUF_SIZE
    stderr_buf = stack_alloc CMD_OUTPUT_BUF_SIZE
    EXPAND DENO_COMMAND_READ_STDOUT stdout_status, stdout_len, process_handle, stdout_buf, CMD_OUTPUT_BUF_SIZE
    EXPAND DENO_COMMAND_READ_STDERR stderr_status, stderr_len, process_handle, stderr_buf, CMD_OUTPUT_BUF_SIZE
    !stdout_status
    !stderr_status
    exit_code = zext exit_code_u32
    proc_put_status = call @state_process_put(&state_ptr, &handle_ptr, handle_len)
    !proc_put_status
    call @notify_process_output(&state_ptr, &handle_ptr, handle_len, &STREAM_STDOUT, STREAM_STDOUT_LEN, &stdout_buf, stdout_len)
    call @notify_process_output(&state_ptr, &handle_ptr, handle_len, &STREAM_STDERR, STREAM_STDERR_LEN, &stderr_buf, stderr_len)
    call @notify_process_exited(&state_ptr, &handle_ptr, handle_len, exit_code, &stdout_buf, stdout_len, &stderr_buf, stderr_len)
    writer_slot = stack_alloc 8
    writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot)
    writer = load writer_slot+0 as ptr
    begin_status = call @sa_json_writer_begin_object(writer)
    handle_field = call @sa_json_writer_field_string(writer, &JSON_KEY_PROCESS_HANDLE, JSON_KEY_PROCESS_HANDLE_LEN, &handle_ptr, handle_len)
    end_status = call @sa_json_writer_end_object(writer)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !end_status
    !handle_field
    !begin_status
    !writer_status
    EXPAND DENO_COMMAND_CLOSE close_status, process_handle
    !close_status
    !exit_code_u32
    !exit_code
    !stdout_len
    !stderr_len
    !process_handle
    !count
    !cwd_ptr
    !cwd_len
    !handle_ptr
    !handle_len
    !body
    !body_len
    !state_ptr
    !req
    return 0

L_PROC_RUN_ERR:
    !run_ok
    !process_handle
    !count
    !cwd_ptr
    !cwd_len
    !handle_ptr
    !handle_len
    call @send_error_with_id(&req, 500, &id_ptr, id_len, &J_ERR_FS, J_ERR_FS_LEN)
    !body
    !body_len
    !state_ptr
    !req
    return 0

L_PROC_WAIT_ERR:
    !wait_ok
    !exit_code_u32
    EXPAND DENO_COMMAND_CLOSE close_status_err, process_handle
    !close_status_err
    !process_handle
    !count
    !cwd_ptr
    !cwd_len
    !handle_ptr
    !handle_len
    call @send_error_with_id(&req, 500, &id_ptr, id_len, &J_ERR_FS, J_ERR_FS_LEN)
    !body
    !body_len
    !state_ptr
    !req
    return 0

@ffi_wrapper send_rpc_process_kill(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    handle_ptr_slot = stack_alloc 8
    handle_len_slot = stack_alloc 8
    handle_status = call @rpc_extract_string_after(&body, body_len, &J_PROCESS_HANDLE_KEY, J_PROCESS_HANDLE_KEY_LEN, &handle_ptr_slot, &handle_len_slot)
    has_handle = eq handle_status, 1
    !handle_status
    br has_handle -> L_PK_DELETE, L_PK_FALSE

L_PK_DELETE:
    !has_handle
    handle_ptr = load handle_ptr_slot+0 as ptr
    handle_len = load handle_len_slot+0 as u64
    deleted = call @state_process_delete(&state_ptr, &handle_ptr, handle_len)
    is_deleted = eq deleted, 1
    !deleted
    br is_deleted -> L_PK_TRUE, L_PK_FALSE_WITH_HANDLE

L_PK_TRUE:
    !is_deleted
    call @send_rpc_bool_field_with_id(&req, &id_ptr, id_len, &JSON_KEY_OK, JSON_KEY_OK_LEN, 1)
    !handle_ptr
    !handle_len
    !body
    !body_len
    !state_ptr
    !req
    return 0

L_PK_FALSE_WITH_HANDLE:
    !is_deleted
    !handle_ptr
    !handle_len
    jmp L_PK_FALSE_FROM_HANDLE

L_PK_FALSE:
    !has_handle
    jmp L_PK_FALSE_FROM_HANDLE

L_PK_FALSE_FROM_HANDLE:
    call @send_rpc_bool_field_with_id(&req, &id_ptr, id_len, &JSON_KEY_OK, JSON_KEY_OK_LEN, 0)
    !body
    !body_len
    !state_ptr
    !req
    return 0

@ffi_wrapper send_rpc_fs_read(&req: ptr, &id_ptr: ptr, id_len: u64, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
