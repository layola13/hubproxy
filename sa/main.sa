@import "deno.sal"
@import "src/config.sa"
@import "src/state.sa"

@extern sa_fmt_u64_into(value: u64, base: u32, out: ptr, out_cap: u64, &out_len: ptr) -> i32
@extern pthread_spawn_detached(*entry: ptr, ^arg: ptr) -> i32
@extern sa_bytes_find(&hay: ptr, hay_len: u64, &needle: ptr, needle_len: u64) -> i64
@extern sa_bytes_find_byte(&hay: ptr, hay_len: u64, needle_byte: u8) -> i64

