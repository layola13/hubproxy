    primary_ok = eq primary_status, 0
    br primary_ok -> L_JW_PARAM_ALT_PRIMARY, L_JW_PARAM_ALT_USE_ALT_MISSING

L_JW_PARAM_ALT_PRIMARY:
    !primary_ok
    primary_ptr = load primary_ptr_slot+0 as ptr
    primary_len = load primary_len_slot+0 as u64
    primary_node = call @sa_json_parse(&primary_ptr, primary_len)
