L_JW_GOAL_BUDGET_VALUE:
    !is_null
    budget_status = call @sa_json_writer_field_i64(writer, &JSON_KEY_TOKEN_BUDGET, JSON_KEY_TOKEN_BUDGET_LEN, budget)
    !budget_status
    !writer
    !budget_null
    !budget
    return 0

@ffi_wrapper json_writer_field_u64_string(writer: ptr, &key: ptr, key_len: u64, value: u64) -> u32:
L_ENTRY:
    tmp = stack_alloc ID_BUF_SIZE
    len_slot = stack_alloc 8
    fmt_status = call @sa_fmt_u64_into(value, 10, tmp, ID_BUF_SIZE, &len_slot)
    !fmt_status
