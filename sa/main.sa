    !req
    return 0

L_FS_COPY_BAD_PARAMS2:
    !has_dst
    call @send_error_with_id(&req, 400, &id_ptr, id_len, &J_ERR_INVALID_PARAMS, J_ERR_INVALID_PARAMS_LEN)
    !body
    !body_len
    !req
    return 0

L_FS_COPY_DO:
    !has_dst
    src_ptr = load src_ptr_slot+0 as ptr
    src_len = load src_len_slot+0 as u64
    dst_ptr = load dst_ptr_slot+0 as ptr
    dst_len = load dst_len_slot+0 as u64
    EXPAND DENO_COPY_FILE copy_status, src_ptr, src_len, dst_ptr, dst_len
    copy_ok = eq copy_status, 0
    !copy_status
    br copy_ok -> L_FS_COPY_OK, L_FS_COPY_ERR

L_FS_COPY_OK:
    !copy_ok
    call @send_rpc_bool_field_with_id(&req, &id_ptr, id_len, &JSON_KEY_OK, JSON_KEY_OK_LEN, 1)
    !src_ptr
    !src_len
    !dst_ptr
    !dst_len
    !body
    !body_len
    !req
    return 0

L_FS_COPY_ERR:
    !copy_ok
    call @send_error_with_id(&req, 500, &id_ptr, id_len, &J_ERR_FS, J_ERR_FS_LEN)
    !src_ptr
    !src_len
    !dst_ptr
    !dst_len
    !body
    !body_len
    !req
    return 0

@ffi_wrapper send_rpc_thread_start_with_values(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, thread_id: u64, forked_from_id: u64, &provider_ptr: ptr, provider_len: u64, ephemeral: u8, &model_ptr: ptr, model_len: u64, &dir_ptr: ptr, dir_len: u64, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    slot = call @state_thread_find(&state_ptr, thread_id)
    preview_ptr = ptr_add slot, THR_PREVIEW
    preview_len = load slot+THR_PREVIEW_LEN as u64
    name_ptr = ptr_add slot, THR_NAME
    name_len = load slot+THR_NAME_LEN as u64
    name_set = load slot+THR_NAME_SET as u8
    writer_slot = stack_alloc 8
    writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot)
    writer = load writer_slot+0 as ptr
    begin_status = call @sa_json_writer_begin_object(writer)
    prefix_status = call @json_writer_write_thread_envelope_prefix(writer, &body, body_len, &model_ptr, model_len, &provider_ptr, provider_len, &dir_ptr, dir_len)
    thread_field_status = call @sa_json_writer_object_field(writer, &JSON_KEY_THREAD, JSON_KEY_THREAD_LEN)
    thread_status = call @json_writer_write_thread_object(writer, &state_ptr, thread_id, forked_from_id, &preview_ptr, preview_len, &provider_ptr, provider_len, ephemeral, &model_ptr, model_len, &dir_ptr, dir_len, &name_ptr, name_len, name_set, 1)
    end_status = call @sa_json_writer_end_object(writer)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !end_status
    !thread_status
    !thread_field_status
    !prefix_status
    !begin_status
    !writer_status
    !preview_ptr
    !preview_len
    !name_ptr
    !name_len
    !name_set
    !slot
    !provider_ptr
    !provider_len
    !ephemeral
    !model_ptr
    !model_len
    !dir_ptr
    !dir_len
    !body
    !body_len
    !forked_from_id
    !thread_id
    !state_ptr
    !req
    return 0

@ffi_wrapper send_rpc_thread_list(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr) -> u32:
L_ENTRY:
    writer_slot = stack_alloc 8
    writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot)
    writer = load writer_slot+0 as ptr
    ids = stack_alloc 2048
    count_slot = stack_alloc 8
    list_status = call @state_thread_list_active(&state_ptr, &ids, &count_slot)
    !list_status
    count = load count_slot+0 as u64
    begin_status = call @sa_json_writer_begin_object(writer)
    data_field_status = call @sa_json_writer_object_field(writer, &JSON_KEY_DATA, JSON_KEY_DATA_LEN)
    data_begin_status = call @sa_json_writer_begin_array(writer)
    i_slot = stack_alloc 8
    store i_slot+0, 0 as u64
    jmp L_TLIST_COND

L_TLIST_COND:
    i = load i_slot+0 as u64
    done = uge i, count
    br done -> L_TLIST_DONE, L_TLIST_BODY

L_TLIST_BODY:
    id_off = mul i, 8
    list_id_ptr = ptr_add ids, id_off
    tid = load list_id_ptr+0 as u64
    slot = call @state_thread_find(&state_ptr, tid)
    model_ptr = load slot+THR_MODEL_PTR as ptr
    model_len = load slot+THR_MODEL_LEN as u64
    dir_ptr = load slot+THR_DIR_PTR as ptr
    dir_len = load slot+THR_DIR_LEN as u64
    provider_ptr = load slot+THR_PROVIDER_PTR as ptr
    provider_len = load slot+THR_PROVIDER_LEN as u64
    ephemeral = load slot+THR_EPHEMERAL as u8
    preview_ptr = ptr_add slot, THR_PREVIEW
    preview_len = load slot+THR_PREVIEW_LEN as u64
    name_ptr = ptr_add slot, THR_NAME
    name_len = load slot+THR_NAME_LEN as u64
    name_set = load slot+THR_NAME_SET as u8
    forked_from_id = load slot+THR_FORKED_FROM_ID as u64
    write_status = call @json_writer_write_thread_object(writer, &state_ptr, tid, forked_from_id, &preview_ptr, preview_len, &provider_ptr, provider_len, ephemeral, &model_ptr, model_len, &dir_ptr, dir_len, &name_ptr, name_len, name_set, 1)
    !write_status
    !model_ptr
    !model_len
    !dir_ptr
    !dir_len
    !provider_ptr
    !provider_len
    !ephemeral
    !preview_ptr
    !preview_len
    !name_ptr
    !name_len
    !name_set
    !forked_from_id
    !slot
    !tid
    !list_id_ptr
    !id_off
    next = add i, 1
    store i_slot+0, next as u64
    !next
    !i
    !done
    jmp L_TLIST_COND

L_TLIST_DONE:
    !done
    !i
    data_end_status = call @sa_json_writer_end_array(writer)
    next_status = call @sa_json_writer_field_null(writer, &JSON_KEY_NEXT_CURSOR, JSON_KEY_NEXT_CURSOR_LEN)
    backwards_status = call @sa_json_writer_field_null(writer, &JSON_KEY_BACKWARDS_CURSOR, JSON_KEY_BACKWARDS_CURSOR_LEN)
    end_status = call @sa_json_writer_end_object(writer)
    !count
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !end_status
    !backwards_status
    !next_status
    !data_end_status
    !data_begin_status
    !data_field_status
    !begin_status
    !writer_status
    !state_ptr
    !req
    return 0

@ffi_wrapper send_rpc_thread_loaded_list(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr) -> u32:
L_ENTRY:
    writer_slot = stack_alloc 8
    writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot)
    writer = load writer_slot+0 as ptr
    ids = stack_alloc 2048
    count_slot = stack_alloc 8
    list_status = call @state_thread_list_active(&state_ptr, &ids, &count_slot)
    !list_status
    count = load count_slot+0 as u64
    begin_status = call @sa_json_writer_begin_object(writer)
    data_field_status = call @sa_json_writer_object_field(writer, &JSON_KEY_DATA, JSON_KEY_DATA_LEN)
    data_begin_status = call @sa_json_writer_begin_array(writer)
    i_slot = stack_alloc 8
    store i_slot+0, 0 as u64
    jmp L_TLOADED_COND

L_TLOADED_COND:
    i = load i_slot+0 as u64
    done = uge i, count
    br done -> L_TLOADED_DONE, L_TLOADED_BODY

L_TLOADED_BODY:
    id_off = mul i, 8
    list_id_ptr = ptr_add ids, id_off
    tid = load list_id_ptr+0 as u64
    write_status = call @json_writer_write_thread_id_string(writer, &state_ptr, tid)
    !write_status
    !tid
    !list_id_ptr
    !id_off
    next = add i, 1
    store i_slot+0, next as u64
    !next
    !i
    !done
    jmp L_TLOADED_COND

L_TLOADED_DONE:
    !done
    !i
    data_end_status = call @sa_json_writer_end_array(writer)
    next_status = call @sa_json_writer_field_null(writer, &JSON_KEY_NEXT_CURSOR, JSON_KEY_NEXT_CURSOR_LEN)
    end_status = call @sa_json_writer_end_object(writer)
    !count
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !end_status
    !next_status
    !data_end_status
    !data_begin_status
    !data_field_status
    !begin_status
    !writer_status
    !state_ptr
    !req
    return 0

@ffi_wrapper send_rpc_thread_read(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, thread_id: u64, include_turns: u8) -> u32:
L_ENTRY:
    slot = call @state_thread_find(&state_ptr, thread_id)
    missing = eq slot, 0
    br missing -> L_READ_NOT_FOUND, L_READ_FOUND

L_READ_FOUND:
    !missing
    model_ptr = load slot+THR_MODEL_PTR as ptr
    model_len = load slot+THR_MODEL_LEN as u64
    dir_ptr = load slot+THR_DIR_PTR as ptr
    dir_len = load slot+THR_DIR_LEN as u64
    provider_ptr = load slot+THR_PROVIDER_PTR as ptr
    provider_len = load slot+THR_PROVIDER_LEN as u64
    ephemeral = load slot+THR_EPHEMERAL as u8
    preview_ptr = ptr_add slot, THR_PREVIEW
    preview_len = load slot+THR_PREVIEW_LEN as u64
    name_ptr = ptr_add slot, THR_NAME
    name_len = load slot+THR_NAME_LEN as u64
    name_set = load slot+THR_NAME_SET as u8
    forked_from_id = load slot+THR_FORKED_FROM_ID as u64
    writer_slot = stack_alloc 8
    writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot)
    writer = load writer_slot+0 as ptr
    begin_status = call @sa_json_writer_begin_object(writer)
    thread_field_status = call @sa_json_writer_object_field(writer, &JSON_KEY_THREAD, JSON_KEY_THREAD_LEN)
    include_turns_ok = eq include_turns, 1
    br include_turns_ok -> L_READ_TURNS_INCLUDE, L_READ_TURNS_EMPTY

L_READ_TURNS_INCLUDE:
    !include_turns_ok
    thread_status_dynamic = call @json_writer_write_thread_object(writer, &state_ptr, thread_id, forked_from_id, &preview_ptr, preview_len, &provider_ptr, provider_len, ephemeral, &model_ptr, model_len, &dir_ptr, dir_len, &name_ptr, name_len, name_set, 2)
    !thread_status_dynamic
    jmp L_READ_SEND

L_READ_TURNS_EMPTY:
    !include_turns_ok
    thread_status_empty = call @json_writer_write_thread_object(writer, &state_ptr, thread_id, forked_from_id, &preview_ptr, preview_len, &provider_ptr, provider_len, ephemeral, &model_ptr, model_len, &dir_ptr, dir_len, &name_ptr, name_len, name_set, 1)
    !thread_status_empty
    jmp L_READ_SEND

L_READ_SEND:
    end_status = call @sa_json_writer_end_object(writer)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !end_status
    !thread_field_status
    !begin_status
    !writer_status
    !model_ptr
    !model_len
    !dir_ptr
    !dir_len
    !provider_ptr
    !provider_len
    !ephemeral
    !preview_ptr
    !preview_len
    !name_ptr
    !name_len
    !name_set
    !forked_from_id
    !slot
    !thread_id
    !state_ptr
    !req
    return 0

L_READ_NOT_FOUND:
    !missing
    !slot
    call @send_error_with_id(&req, 404, &id_ptr, id_len, &J_ERR_THREAD_NOT_FOUND, J_ERR_THREAD_NOT_FOUND_LEN)
    !thread_id
    !state_ptr
    !req
    return 0

