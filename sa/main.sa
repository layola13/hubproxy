@ffi_wrapper send_rpc_marketplace_upgrade(&req: ptr, &id_ptr: ptr, id_len: u64, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    name_ptr_slot = stack_alloc 8
    name_len_slot = stack_alloc 8
    status = call @rpc_extract_string_after(&body, body_len, &J_MARKETPLACE_NAME_KEY, J_MARKETPLACE_NAME_KEY_LEN, &name_ptr_slot, &name_len_slot)
    has_name = eq status, 1
    br has_name -> L_UPGRADE_WITH_NAME, L_UPGRADE_EMPTY

L_UPGRADE_WITH_NAME:
    !has_name
    name_ptr = load name_ptr_slot+0 as ptr
    name_len = load name_len_slot+0 as u64
    result = call @rpc_builder_new()
    call @rpc_builder_append(&result, &J_MARKETPLACE_UPGRADE_A, J_MARKETPLACE_UPGRADE_A_LEN)
    call @rpc_builder_append_json_string(&result, &name_ptr, name_len)
    call @rpc_builder_append(&result, &J_MARKETPLACE_UPGRADE_B, J_MARKETPLACE_UPGRADE_B_LEN)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result)
    !name_ptr
    !name_len
    !status
    !body
    !body_len
    !req
    return 0

L_UPGRADE_EMPTY:
    !has_name
    call @send_wrapped_const_with_id(&req, &id_ptr, id_len, &J_MARKETPLACE_UPGRADE_RESULT, J_MARKETPLACE_UPGRADE_RESULT_LEN)
    !status
    !body
    !body_len
    !req
    return 0

@ffi_wrapper send_rpc_initialize(&req: ptr, &id_ptr: ptr, id_len: u64) -> u32:
L_ENTRY:
    version_buf = call @sa_deno_version_deno()
    cwd_buf = call @sa_deno_cwd()
    family_buf = call @sa_deno_build_platform_family()
    os_buf = call @sa_deno_build_os()
    version_ptr = call @sa_fs_read_buffer_data(version_buf)
    version_len = call @sa_fs_read_buffer_len(version_buf)
    cwd_ptr = call @sa_fs_read_buffer_data(cwd_buf)
    cwd_len = call @sa_fs_read_buffer_len(cwd_buf)
    family_ptr = call @sa_fs_read_buffer_data(family_buf)
    family_len = call @sa_fs_read_buffer_len(family_buf)
    os_ptr = call @sa_fs_read_buffer_data(os_buf)
    os_len = call @sa_fs_read_buffer_len(os_buf)
    result = call @rpc_builder_new()
    call @rpc_builder_append(&result, &J_INIT_A, J_INIT_A_LEN)
    call @rpc_builder_append(&result, &version_ptr, version_len)
    call @rpc_builder_append(&result, &J_INIT_B, J_INIT_B_LEN)
    call @rpc_builder_append_json_string(&result, &cwd_ptr, cwd_len)
    call @rpc_builder_append(&result, &J_INIT_C, J_INIT_C_LEN)
    call @rpc_builder_append(&result, &family_ptr, family_len)
    call @rpc_builder_append(&result, &J_INIT_D, J_INIT_D_LEN)
    call @rpc_builder_append(&result, &os_ptr, os_len)
    call @rpc_builder_append(&result, &J_INIT_E, J_INIT_E_LEN)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result)
    version_free = call @sa_fs_read_buffer_free(^version_buf)
    cwd_free = call @sa_fs_read_buffer_free(^cwd_buf)
    family_free = call @sa_fs_read_buffer_free(^family_buf)
    os_free = call @sa_fs_read_buffer_free(^os_buf)
    !version_free
    !cwd_free
    !family_free
    !os_free
    !version_ptr
    !version_len
    !cwd_ptr
    !cwd_len
    !family_ptr
    !family_len
    !os_ptr
    !os_len
    !req
    return 0

