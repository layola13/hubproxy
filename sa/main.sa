L_JW_PARAM_ALT_NODE:
    !primary_has_node
    primary_kind = call @sa_json_kind(primary_node)
    primary_is_null = eq primary_kind, SA_JSON_KIND_NULL
    !primary_kind
    br primary_is_null -> L_JW_PARAM_ALT_USE_ALT_NULL, L_JW_PARAM_ALT_WRITE_PRIMARY

L_JW_PARAM_ALT_WRITE_PRIMARY:
    !primary_is_null
    field_status = call @sa_json_writer_field_node(writer, &field_key, field_key_len, primary_node)
    node_free = call @sa_json_free(^primary_node)
    primary_free = call @sa_deno_plugin_free_buffer(primary_ptr, primary_len)
    !primary_free
    !node_free
    !field_status
    !primary_ptr
    !primary_len
    !primary_status
    !writer
    !field_key
    !field_key_len
    !body
    !body_len
    !primary_key
    !primary_key_len
    !alt_key
    !alt_key_len
    !fallback
    !fallback_len
    return 0

L_JW_PARAM_ALT_USE_ALT_NULL:
    !primary_is_null
    node_free_null = call @sa_json_free(^primary_node)
    primary_free_null = call @sa_deno_plugin_free_buffer(primary_ptr, primary_len)
    !primary_free_null
    !node_free_null
    !primary_ptr
    !primary_len
    !primary_status
    alt_status = call @json_writer_field_param_string_or_default(writer, &field_key, field_key_len, &body, body_len, &alt_key, alt_key_len, &fallback, fallback_len, 0)
    !alt_status
    !writer
    !field_key
    !field_key_len
    !body
    !body_len
    !primary_key
    !primary_key_len
    !alt_key
    !alt_key_len
    !fallback
    !fallback_len
    return 0

L_JW_PARAM_ALT_USE_ALT_BAD:
    !primary_has_node
    !primary_node
    primary_free_bad = call @sa_deno_plugin_free_buffer(primary_ptr, primary_len)
    !primary_free_bad
    !primary_ptr
    !primary_len
    !primary_status
    alt_status_bad = call @json_writer_field_param_string_or_default(writer, &field_key, field_key_len, &body, body_len, &alt_key, alt_key_len, &fallback, fallback_len, 0)
    !alt_status_bad
    !writer
    !field_key
    !field_key_len
    !body
    !body_len
    !primary_key
    !primary_key_len
    !alt_key
    !alt_key_len
    !fallback
    !fallback_len
    return 0

L_JW_PARAM_ALT_USE_ALT_MISSING:
    !primary_ok
    !primary_status
    alt_status_missing = call @json_writer_field_param_string_or_default(writer, &field_key, field_key_len, &body, body_len, &alt_key, alt_key_len, &fallback, fallback_len, 0)
    !alt_status_missing
    !writer
    !field_key
    !field_key_len
    !body
    !body_len
    !primary_key
    !primary_key_len
    !alt_key
    !alt_key_len
    !fallback
    !fallback_len
    return 0

@ffi_wrapper send_error_with_id(&req: ptr, status: u16, &id_ptr: ptr, id_len: u64, &error_ptr: ptr, error_len: u64) -> u32:
L_ENTRY:
    code_slot = stack_alloc 8
    method_raw = call @sa_bytes_eq(&error_ptr, error_len, &J_ERR_NOT_FOUND, J_ERR_NOT_FOUND_LEN)
    method_ok = eq method_raw, 1
    br method_ok -> L_ERR_CODE_METHOD_DIRECT, L_ERR_CODE_CHECK_MCP_LIST

L_ERR_CODE_METHOD_DIRECT:
    !method_ok
    !method_raw
    jmp L_ERR_CODE_METHOD_SET

L_ERR_CODE_CHECK_MCP_LIST:
    !method_ok
    !method_raw
    mcp_list_raw = call @sa_bytes_eq(&error_ptr, error_len, &J_ERR_MCP_RESOURCE_LIST_UNSUPPORTED, J_ERR_MCP_RESOURCE_LIST_UNSUPPORTED_LEN)
    mcp_list_ok = eq mcp_list_raw, 1
    br mcp_list_ok -> L_ERR_CODE_METHOD_FROM_LIST, L_ERR_CODE_CHECK_MCP_TEMPLATES

L_ERR_CODE_METHOD_FROM_LIST:
    !mcp_list_ok
    !mcp_list_raw
    jmp L_ERR_CODE_METHOD_SET

L_ERR_CODE_CHECK_MCP_TEMPLATES:
    !mcp_list_ok
    !mcp_list_raw
    mcp_templates_raw = call @sa_bytes_eq(&error_ptr, error_len, &J_ERR_MCP_RESOURCE_TEMPLATES_UNSUPPORTED, J_ERR_MCP_RESOURCE_TEMPLATES_UNSUPPORTED_LEN)
    mcp_templates_ok = eq mcp_templates_raw, 1
    br mcp_templates_ok -> L_ERR_CODE_METHOD_FROM_TEMPLATES, L_ERR_CODE_CHECK_INVALID

L_ERR_CODE_METHOD_FROM_TEMPLATES:
    !mcp_templates_ok
    !mcp_templates_raw
    jmp L_ERR_CODE_METHOD_SET

L_ERR_CODE_CHECK_INVALID:
    !mcp_templates_ok
    !mcp_templates_raw
    is_bad_params = eq status, 400
    br is_bad_params -> L_ERR_CODE_INVALID, L_ERR_CODE_INTERNAL

L_ERR_CODE_METHOD_SET:
    method_code_u = sub 0, 32601
    method_code_i = bitcast method_code_u as i64
    store code_slot+0, method_code_i as i64
    !method_code_i
    !method_code_u
    jmp L_ERR_WRITE

L_ERR_CODE_INVALID:
    !is_bad_params
    invalid_code_u = sub 0, 32602
    invalid_code_i = bitcast invalid_code_u as i64
    store code_slot+0, invalid_code_i as i64
    !invalid_code_i
    !invalid_code_u
    jmp L_ERR_WRITE

L_ERR_CODE_INTERNAL:
    !is_bad_params
    internal_code_u = sub 0, 32000
    internal_code_i = bitcast internal_code_u as i64
    store code_slot+0, internal_code_i as i64
    !internal_code_i
    !internal_code_u
    jmp L_ERR_WRITE

L_ERR_WRITE:
    code = load code_slot+0 as i64
    writer_slot = stack_alloc 8
    buffer_slot = stack_alloc 8
    writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot)
    writer = load writer_slot+0 as ptr
    begin_status = call @sa_json_writer_begin_object(writer)
    code_status = call @sa_json_writer_field_i64(writer, &JSON_KEY_CODE, JSON_KEY_CODE_LEN, code)
    message_status = call @sa_json_writer_field_string(writer, &JSON_KEY_MESSAGE, JSON_KEY_MESSAGE_LEN, &error_ptr, error_len)
    end_status = call @sa_json_writer_end_object(writer)
    finish_status = call @sa_json_writer_finish(writer, &buffer_slot)
    buffer = load buffer_slot+0 as ptr
    payload_ptr = call @sa_json_buffer_data(&buffer)
    payload_len = call @sa_json_buffer_len(&buffer)
    send_status = call @send_jsonrpc_envelope_with_id(&req, status, &id_ptr, id_len, &payload_ptr, payload_len, 1)
    buffer_free = call @sa_json_buffer_free(^buffer)
    writer_free = call @sa_json_writer_free(^writer)
    !writer_free
    !buffer_free
    !payload_ptr
    !payload_len
    !finish_status
    !end_status
    !message_status
    !code_status
    !begin_status
    !writer_status
    !code
    !send_status
    !id_ptr
    !id_len
    !error_ptr
    !error_len
    !status
    !req
    return 0

@ffi_wrapper rpc_jsonrpc_lookup_key(&key: ptr, key_len: u64, &out_ptr: ptr, &out_len: ptr) -> u32:
L_ENTRY:
    has_len = ugt key_len, 0
    br has_len -> L_LOOKUP_FIRST, L_LOOKUP_RAW_EMPTY

L_LOOKUP_FIRST:
    first = load key+0 as u8
    is_quote = eq first, 34
    br is_quote -> L_LOOKUP_SCAN, L_LOOKUP_RAW_FIRST

L_LOOKUP_SCAN:
    !is_quote
    tail_ptr = ptr_add key, 1
    tail_len = sub key_len, 1
    end_idx = call @sa_bytes_find_byte(&tail_ptr, tail_len, 34)
    has_end = sge end_idx, 0
    br has_end -> L_LOOKUP_STRIP, L_LOOKUP_RAW_STRIP

L_LOOKUP_STRIP:
    !has_end
    store out_ptr+0, tail_ptr as ptr
    store out_len+0, end_idx as u64
    !end_idx
    !tail_ptr
    !tail_len
    !first
    !has_len
    !key
    !key_len
    !out_ptr
    !out_len
    return 1

L_LOOKUP_RAW_STRIP:
    !has_end
    !end_idx
    !tail_ptr
    !tail_len
    !first
    store out_ptr+0, key as ptr
    store out_len+0, key_len as u64
    !has_len
    !key
    !key_len
    !out_ptr
    !out_len
    return 0

L_LOOKUP_RAW_FIRST:
    !is_quote
    !first
    store out_ptr+0, key as ptr
    store out_len+0, key_len as u64
    !has_len
    !key
    !key_len
    !out_ptr
    !out_len
    return 0

L_LOOKUP_RAW_EMPTY:
    !has_len
    store out_ptr+0, key as ptr
    store out_len+0, key_len as u64
    !key
    !key_len
    !out_ptr
    !out_len
    return 0

@ffi_wrapper rpc_extract_u64_after(&body: ptr, body_len: u64, &key: ptr, key_len: u64, fallback: u64) -> u64:
L_ENTRY:
    str_ptr_slot = stack_alloc 8
    str_len_slot = stack_alloc 8
    status = call @rpc_extract_string_after(&body, body_len, &key, key_len, &str_ptr_slot, &str_len_slot)
    has_string = eq status, 1
    !status
    br has_string -> L_EXTRACT_STR, L_EXTRACT_NO_STRING

L_EXTRACT_STR:
    !has_string
    str_ptr = load str_ptr_slot+0 as ptr
    str_len = load str_len_slot+0 as u64
    parsed = call @sa_bytes_to_u64(&str_ptr, str_len)
    parsed_ok = sge parsed, 0
    br parsed_ok -> L_EXTRACT_STR_OK, L_EXTRACT_STR_FALLBACK

L_EXTRACT_STR_OK:
    !parsed_ok
    result = bitcast parsed as u64
    !parsed
    !str_ptr
    !str_len
    !body
    !body_len
    !key
    !key_len
    !fallback
    return result

L_EXTRACT_STR_FALLBACK:
    !parsed_ok
    !parsed
    !str_ptr
    !str_len
    jmp L_EXTRACT_DOM

L_EXTRACT_NO_STRING:
    !has_string
    jmp L_EXTRACT_DOM

L_EXTRACT_DOM:
    root = call @sa_json_parse(&body, body_len)
    has_root = ne root, 0
    br has_root -> L_EXTRACT_ROOT, L_EXTRACT_FALLBACK2

L_EXTRACT_ROOT:
    !has_root
    params_slot = stack_alloc 8
    params_status = call @sa_json_object_get(root, &FB_KEY_PARAMS, FB_KEY_PARAMS_LEN, &params_slot)
    params_ok = eq params_status, 0
    !params_status
    br params_ok -> L_EXTRACT_PARAMS, L_EXTRACT_FREE_ROOT

L_EXTRACT_PARAMS:
    !params_ok
    params_node = load params_slot+0 as ptr
    lookup_ptr_slot = stack_alloc 8
    lookup_len_slot = stack_alloc 8
    lookup_status = call @rpc_jsonrpc_lookup_key(&key, key_len, &lookup_ptr_slot, &lookup_len_slot)
    !lookup_status
    lookup_ptr = load lookup_ptr_slot+0 as ptr
    lookup_len = load lookup_len_slot+0 as u64
    value_slot = stack_alloc 8
    value_status = call @sa_json_object_get_i64(params_node, &lookup_ptr, lookup_len, &value_slot)
    value_ok = eq value_status, 0
    !value_status
    br value_ok -> L_EXTRACT_NUM, L_EXTRACT_NUM_MISSING

L_EXTRACT_NUM:
    !value_ok
    value_i64 = load value_slot+0 as i64
    value_nonneg = sge value_i64, 0
    br value_nonneg -> L_EXTRACT_NUM_OK, L_EXTRACT_NUM_STR_FALLBACK

L_EXTRACT_NUM_OK:
    !value_nonneg
    result = zext value_i64
    free_params = call @sa_json_free(^params_node)
    free_root = call @sa_json_free(^root)
    !free_params
    !free_root
    !value_i64
    !lookup_ptr
    !lookup_len
    !body
    !body_len
    !key
    !key_len
    !fallback
    return result

L_EXTRACT_NUM_STR_FALLBACK:
    !value_nonneg
    !value_i64
    free_params_bad = call @sa_json_free(^params_node)
    free_root_bad = call @sa_json_free(^root)
    !free_params_bad
    !free_root_bad
    !lookup_ptr
    !lookup_len
    !body
    !body_len
    !key
    !key_len
    return fallback

L_EXTRACT_NUM_MISSING:
    !value_ok
    !lookup_ptr
    !lookup_len
    free_params_missing = call @sa_json_free(^params_node)
    free_root_missing = call @sa_json_free(^root)
    !free_params_missing
    !free_root_missing
    !body
    !body_len
    !key
    !key_len
    return fallback

L_EXTRACT_FREE_ROOT:
    !params_ok
    free_root_only = call @sa_json_free(^root)
    !free_root_only
    !body
    !body_len
    !key
    !key_len
    return fallback

L_EXTRACT_FALLBACK2:
    !has_root
    !root
    !body
    !body_len
    !key
    !key_len
    return fallback

@ffi_wrapper rpc_extract_u64_number_after(&body: ptr, body_len: u64, &key: ptr, key_len: u64, fallback: u64) -> u64:
L_ENTRY:
    result = call @rpc_extract_u64_after(&body, body_len, &key, key_len, fallback)
    return result

@ffi_wrapper rpc_extract_i64_number_after(&body: ptr, body_len: u64, &key: ptr, key_len: u64, fallback: i64) -> i64:
L_ENTRY:
    root = call @sa_json_parse(&body, body_len)
    has_root = ne root, 0
    br has_root -> L_EXTRACT_I64_ROOT, L_EXTRACT_I64_FALLBACK

L_EXTRACT_I64_ROOT:
    !has_root
    params_slot = stack_alloc 8
    params_status = call @sa_json_object_get(root, &FB_KEY_PARAMS, FB_KEY_PARAMS_LEN, &params_slot)
    params_ok = eq params_status, 0
    !params_status
    br params_ok -> L_EXTRACT_I64_PARAMS, L_EXTRACT_I64_FREE_ROOT

L_EXTRACT_I64_PARAMS:
    !params_ok
    params_node = load params_slot+0 as ptr
    lookup_ptr_slot = stack_alloc 8
    lookup_len_slot = stack_alloc 8
    lookup_status = call @rpc_jsonrpc_lookup_key(&key, key_len, &lookup_ptr_slot, &lookup_len_slot)
    !lookup_status
    lookup_ptr = load lookup_ptr_slot+0 as ptr
    lookup_len = load lookup_len_slot+0 as u64
    value_slot = stack_alloc 8
    value_status = call @sa_json_object_get_i64(params_node, &lookup_ptr, lookup_len, &value_slot)
    value_ok = eq value_status, 0
    !value_status
    br value_ok -> L_EXTRACT_I64_NUM, L_EXTRACT_I64_MISSING

L_EXTRACT_I64_NUM:
    !value_ok
    value_i64 = load value_slot+0 as i64
    free_params = call @sa_json_free(^params_node)
    free_root = call @sa_json_free(^root)
    !free_params
    !free_root
    !lookup_ptr
    !lookup_len
    !body
    !body_len
    !key
    !key_len
    !fallback
    return value_i64

L_EXTRACT_I64_MISSING:
    !value_ok
    !lookup_ptr
    !lookup_len
    free_params_missing = call @sa_json_free(^params_node)
    free_root_missing = call @sa_json_free(^root)
    !free_params_missing
    !free_root_missing
    !body
    !body_len
    !key
    !key_len
    return fallback

L_EXTRACT_I64_FREE_ROOT:
    !params_ok
    free_root_only = call @sa_json_free(^root)
    !free_root_only
    !body
    !body_len
    !key
    !key_len
    return fallback

L_EXTRACT_I64_FALLBACK:
    !has_root
    !root
    !body
    !body_len
    !key
    !key_len
    return fallback

@ffi_wrapper rpc_extract_string_after(&body: ptr, body_len: u64, &key: ptr, key_len: u64, &out_ptr: ptr, &out_len: ptr) -> u32:
L_ENTRY:
    root = call @sa_json_parse(&body, body_len)
    has_root = ne root, 0
    br has_root -> L_STR_ROOT, L_STR_NOT_FOUND

L_STR_ROOT:
    !has_root
    params_slot = stack_alloc 8
    params_status = call @sa_json_object_get(root, &FB_KEY_PARAMS, FB_KEY_PARAMS_LEN, &params_slot)
    params_ok = eq params_status, 0
    !params_status
    br params_ok -> L_STR_PARAMS, L_STR_FREE_ROOT

L_STR_PARAMS:
    !params_ok
    params_node = load params_slot+0 as ptr
    lookup_ptr_slot = stack_alloc 8
    lookup_len_slot = stack_alloc 8
    lookup_status = call @rpc_jsonrpc_lookup_key(&key, key_len, &lookup_ptr_slot, &lookup_len_slot)
    !lookup_status
    lookup_ptr = load lookup_ptr_slot+0 as ptr
    lookup_len = load lookup_len_slot+0 as u64
    value_ptr_slot = stack_alloc 8
    value_len_slot = stack_alloc 8
    value_status = call @sa_json_object_get_string(params_node, &lookup_ptr, lookup_len, &value_ptr_slot, &value_len_slot)
    value_ok = eq value_status, 0
    !value_status
    br value_ok -> L_STR_COPY, L_STR_FREE_PARAMS

L_STR_COPY:
    !value_ok
    value_ptr = load value_ptr_slot+0 as ptr
    value_len = load value_len_slot+0 as u64
    is_empty = eq value_len, 0
    br is_empty -> L_STR_COPY_EMPTY, L_STR_COPY_NONEMPTY

L_STR_COPY_EMPTY:
    !is_empty
    out = alloc 1
    store out_ptr+0, out as ptr
    store out_len+0, 0 as u64
    free_params = call @sa_json_free(^params_node)
    free_root = call @sa_json_free(^root)
    !free_params
    !free_root
    !value_ptr
    !value_len
    !out
    !lookup_ptr
    !lookup_len
    !body
    !body_len
    !key
    !key_len
    !out_ptr
    !out_len
    return 1

L_STR_COPY_NONEMPTY:
    !is_empty
    out2 = alloc value_len
    copy_status = call @sa_bytes_copy(&out2, &value_ptr, value_len)
    !copy_status
    store out_ptr+0, out2 as ptr
    store out_len+0, value_len as u64
    free_params2 = call @sa_json_free(^params_node)
    free_root2 = call @sa_json_free(^root)
    !free_params2
    !free_root2
    !value_ptr
    !value_len
    !out2
    !lookup_ptr
    !lookup_len
    !body
    !body_len
    !key
    !key_len
    !out_ptr
    !out_len
    return 1

L_STR_FREE_PARAMS:
    !value_ok
    !lookup_ptr
    !lookup_len
    free_params_bad = call @sa_json_free(^params_node)
    free_root_bad = call @sa_json_free(^root)
    !free_params_bad
    !free_root_bad
    !body
    !body_len
    !key
    !key_len
    !out_ptr
    !out_len
    return 0

L_STR_FREE_ROOT:
    !params_ok
    free_root_only = call @sa_json_free(^root)
    !free_root_only
    !body
    !body_len
    !key
    !key_len
    !out_ptr
    !out_len
    return 0

L_STR_NOT_FOUND:
    !has_root
    !root
    !body
    !body_len
    !key
    !key_len
    !out_ptr
    !out_len
    return 0

@ffi_wrapper rpc_extract_string_or_default(&body: ptr, body_len: u64, &key: ptr, key_len: u64, &default_ptr: ptr, default_len: u64, &out_ptr: ptr, &out_len: ptr) -> u32:
L_ENTRY:
    tmp_ptr_slot = stack_alloc 8
    tmp_len_slot = stack_alloc 8
    status = call @rpc_extract_string_after(&body, body_len, &key, key_len, &tmp_ptr_slot, &tmp_len_slot)
    has_value = eq status, 1
    !status
    br has_value -> L_STR_DEF_BODY, L_STR_DEF_DEFAULT

L_STR_DEF_BODY:
    !has_value
    tmp_ptr = load tmp_ptr_slot+0 as ptr
    tmp_len = load tmp_len_slot+0 as u64
    store out_ptr+0, tmp_ptr as ptr
    store out_len+0, tmp_len as u64
    !tmp_ptr
    !tmp_len
    !body
    !body_len
    !key
    !key_len
    !default_ptr
    !default_len
    !out_ptr
    !out_len
    return 1

L_STR_DEF_DEFAULT:
    !has_value
    store out_ptr+0, default_ptr as ptr
    store out_len+0, default_len as u64
    !body
    !body_len
    !key
    !key_len
    !default_ptr
    !default_len
    !out_ptr
    !out_len
    return 0

@ffi_wrapper rpc_resolve_thread_id(&state_ptr: ptr, &body: ptr, body_len: u64, fallback: u64) -> u64:
L_ENTRY:
    key_ptr_slot = stack_alloc 8
    key_len_slot = stack_alloc 8
    key_status = call @rpc_extract_string_after(&body, body_len, &J_THREADID_KEY, J_THREADID_KEY_LEN, &key_ptr_slot, &key_len_slot)
    has_key = eq key_status, 1
    !key_status
    br has_key -> L_RESOLVE_THREAD_KEY, L_RESOLVE_THREAD_NUMERIC

L_RESOLVE_THREAD_KEY:
    !has_key
    key_ptr = load key_ptr_slot+0 as ptr
    key_len = load key_len_slot+0 as u64
    slot = call @state_thread_find_by_key(&state_ptr, &key_ptr, key_len)
    found = ne slot, 0
    br found -> L_RESOLVE_THREAD_FOUND, L_RESOLVE_THREAD_PARSE_STRING

L_RESOLVE_THREAD_FOUND:
    !found
    resolved = load slot+THR_ID as u64
    !slot
    !key_ptr
    !key_len
    !state_ptr
    !body
    !body_len
    !fallback
    return resolved

L_RESOLVE_THREAD_PARSE_STRING:
    !found
    !slot
    parsed = call @rpc_extract_u64_after(&body, body_len, &J_THREADID_KEY, J_THREADID_KEY_LEN, fallback)
    !key_ptr
    !key_len
    !state_ptr
    !body
    !body_len
    !fallback
    return parsed

L_RESOLVE_THREAD_NUMERIC:
    !has_key
    parsed2 = call @rpc_extract_u64_after(&body, body_len, &J_THREADID_KEY, J_THREADID_KEY_LEN, fallback)
    !state_ptr
    !body
    !body_len
    !fallback
    return parsed2

@ffi_wrapper bytes_has(&body: ptr, body_len: u64, &needle: ptr, needle_len: u64) -> u32:
L_ENTRY:
    idx = call @sa_bytes_find(&body, body_len, &needle, needle_len)
    found = sge idx, 0
    br found -> L_HAS_YES, L_HAS_NO

L_HAS_YES:
    !found
    !idx
    !body
    !body_len
    !needle
    !needle_len
    return 1

L_HAS_NO:
    !found
    !idx
    !body
    !body_len
    !needle
    !needle_len
    return 0

@ffi_wrapper body_collaboration_mode(&body: ptr, body_len: u64) -> u8:
L_ENTRY:
    mode_slot = stack_alloc 4
    infer_status = call @sa_deno_plugin_infer_collaboration_mode(&body, body_len, &mode_slot)
    infer_ok = eq infer_status, 0
    br infer_ok -> L_BODY_MODE_INFER_OK, L_BODY_MODE_FALLBACK_STATUS

L_BODY_MODE_INFER_OK:
    !infer_ok
    mode32 = load mode_slot+0 as u32
    has_mode = ne mode32, 0
    br has_mode -> L_BODY_MODE_INFER_RETURN, L_BODY_MODE_FALLBACK_MODE

L_BODY_MODE_INFER_RETURN:
    !has_mode
    store mode_slot+0, mode32 as u8
    mode8 = load mode_slot+0 as u8
    !mode32
    !infer_status
    !body
    !body_len
    return mode8

L_BODY_MODE_FALLBACK_MODE:
    !has_mode
    !mode32
    !infer_status
    fallback_mode = call @body_collaboration_mode_fallback(&body, body_len)
    !body
    !body_len
    return fallback_mode

L_BODY_MODE_FALLBACK_STATUS:
    !infer_ok
    !infer_status
    fallback_mode2 = call @body_collaboration_mode_fallback(&body, body_len)
    !body
    !body_len
    return fallback_mode2

@ffi_wrapper min_u64(a: u64, b: u64) -> u64:
L_ENTRY:
    a_le_b = ule a, b
    br a_le_b -> L_MIN_U64_A, L_MIN_U64_B

L_MIN_U64_A:
    !a_le_b
    !b
    return a

L_MIN_U64_B:
    !a_le_b
    !a
    return b

@ffi_wrapper ascii_is_trim_ws(byte: u8) -> u8:
L_ENTRY:
    is_space = eq byte, 32
    is_tab = eq byte, 9
    is_lf = eq byte, 10
    is_cr = eq byte, 13
    is_ff = eq byte, 12
    tmp1 = or is_space, is_tab
    tmp2 = or is_lf, is_cr
    tmp3 = or tmp1, tmp2
    out = or tmp3, is_ff
    !tmp3
    !tmp2
    !tmp1
    !is_ff
    !is_cr
    !is_lf
    !is_tab
    !is_space
    !byte
    return out

@ffi_wrapper ascii_lower_byte(byte: u8) -> u8:
L_ENTRY:
    ge_a = uge byte, 65
    le_z = ule byte, 90
    is_upper = and ge_a, le_z
    br is_upper -> L_ASCII_LOWER_UPPER, L_ASCII_LOWER_KEEP

L_ASCII_LOWER_UPPER:
    !is_upper
    lowered = add byte, 32
    !byte
    !ge_a
    !le_z
    return lowered

L_ASCII_LOWER_KEEP:
    !is_upper
    !ge_a
    !le_z
    return byte

@ffi_wrapper collaboration_mode_known_code(&mode_ptr: ptr, mode_len: u64) -> u8:
L_ENTRY:
    start_slot = stack_alloc 8
    end_slot = stack_alloc 8
    store start_slot+0, 0 as u64
    store end_slot+0, mode_len as u64
    jmp L_MODE_TRIM_START_COND

L_MODE_TRIM_START_COND:
    start = load start_slot+0 as u64
    has_start = ult start, mode_len
    br has_start -> L_MODE_TRIM_START_BODY, L_MODE_TRIM_START_EXHAUSTED

L_MODE_TRIM_START_EXHAUSTED:
    !has_start
    !start
    jmp L_MODE_TRIM_END_COND

L_MODE_TRIM_START_BODY:
    !has_start
    start_ptr = ptr_add mode_ptr, start
    start_byte = load start_ptr+0 as u8
    start_ws = call @ascii_is_trim_ws(start_byte)
    is_start_ws = ne start_ws, 0
    br is_start_ws -> L_MODE_TRIM_START_NEXT, L_MODE_TRIM_START_DONE

L_MODE_TRIM_START_NEXT:
    !is_start_ws
    !start_ws
    !start_byte
    !start_ptr
    next_start = add start, 1
    store start_slot+0, next_start as u64
    !next_start
    !start
    jmp L_MODE_TRIM_START_COND

L_MODE_TRIM_START_DONE:
    !is_start_ws
    !start_ws
    !start_byte
    !start_ptr
    !start
    jmp L_MODE_TRIM_END_COND

L_MODE_TRIM_END_COND:
    end = load end_slot+0 as u64
    start_for_end = load start_slot+0 as u64
    has_end = ugt end, start_for_end
    br has_end -> L_MODE_TRIM_END_BODY, L_MODE_TRIM_END_EXHAUSTED

L_MODE_TRIM_END_EXHAUSTED:
    !has_end
    !end
    !start_for_end
    jmp L_MODE_LEN_CHECK

L_MODE_TRIM_END_BODY:
    !has_end
    end_prev = sub end, 1
    end_ptr = ptr_add mode_ptr, end_prev
    end_byte = load end_ptr+0 as u8
    end_ws = call @ascii_is_trim_ws(end_byte)
    is_end_ws = ne end_ws, 0
    br is_end_ws -> L_MODE_TRIM_END_NEXT, L_MODE_TRIM_END_DONE

L_MODE_TRIM_END_NEXT:
    !is_end_ws
    !end_ws
    !end_byte
    !end_ptr
    store end_slot+0, end_prev as u64
    !end_prev
    !end
    !start_for_end
    jmp L_MODE_TRIM_END_COND

L_MODE_TRIM_END_DONE:
    !is_end_ws
    !end_ws
    !end_byte
    !end_ptr
    !end_prev
    !end
    !start_for_end
    jmp L_MODE_LEN_CHECK

L_MODE_LEN_CHECK:
    final_start = load start_slot+0 as u64
    final_end = load end_slot+0 as u64
    trimmed_len = sub final_end, final_start
    len_ok = eq trimmed_len, 4
    br len_ok -> L_MODE_LOAD_BYTES, L_MODE_NONE

L_MODE_LOAD_BYTES:
    !len_ok
    p0 = ptr_add mode_ptr, final_start
    idx1 = add final_start, 1
    idx2 = add final_start, 2
    idx3 = add final_start, 3
    p1 = ptr_add mode_ptr, idx1
    p2 = ptr_add mode_ptr, idx2
    p3 = ptr_add mode_ptr, idx3
    b0_raw = load p0+0 as u8
    b1_raw = load p1+0 as u8
    b2_raw = load p2+0 as u8
    b3_raw = load p3+0 as u8
    b0 = call @ascii_lower_byte(b0_raw)
    b1 = call @ascii_lower_byte(b1_raw)
    b2 = call @ascii_lower_byte(b2_raw)
    b3 = call @ascii_lower_byte(b3_raw)
    is_plan0 = eq b0, 112
    is_plan1 = eq b1, 108
    is_plan2 = eq b2, 97
    is_plan3 = eq b3, 110
    plan01 = and is_plan0, is_plan1
    plan23 = and is_plan2, is_plan3
    is_plan = and plan01, plan23
    br is_plan -> L_MODE_PLAN, L_MODE_GOAL_CHECK

L_MODE_PLAN:
    !is_plan
    !plan23
    !plan01
    !is_plan3
    !is_plan2
    !is_plan1
    !is_plan0
    !b3
    !b2
    !b1
    !b0
    !b3_raw
    !b2_raw
    !b1_raw
    !b0_raw
    !p3
    !p2
    !p1
    !p0
    !idx3
    !idx2
    !idx1
    !trimmed_len
    !final_end
    !final_start
    !mode_ptr
    !mode_len
    return 1

L_MODE_GOAL_CHECK:
    !is_plan
    !plan23
    !plan01
    !is_plan3
    !is_plan2
    !is_plan1
    !is_plan0
    is_goal0 = eq b0, 103
    is_goal1 = eq b1, 111
    is_goal2 = eq b2, 97
    is_goal3 = eq b3, 108
    goal01 = and is_goal0, is_goal1
    goal23 = and is_goal2, is_goal3
    is_goal = and goal01, goal23
    br is_goal -> L_MODE_GOAL, L_MODE_CODE_CHECK

L_MODE_GOAL:
    !is_goal
    !goal23
    !goal01
    !is_goal3
    !is_goal2
    !is_goal1
    !is_goal0
    !b3
    !b2
    !b1
    !b0
    !b3_raw
    !b2_raw
    !b1_raw
    !b0_raw
    !p3
    !p2
    !p1
    !p0
    !idx3
    !idx2
    !idx1
    !trimmed_len
    !final_end
    !final_start
    !mode_ptr
    !mode_len
    return 2

L_MODE_CODE_CHECK:
    !is_goal
    !goal23
    !goal01
    !is_goal3
    !is_goal2
    !is_goal1
    !is_goal0
    is_code0 = eq b0, 99
    is_code1 = eq b1, 111
    is_code2 = eq b2, 100
    is_code3 = eq b3, 101
    code01 = and is_code0, is_code1
    code23 = and is_code2, is_code3
    is_code = and code01, code23
    br is_code -> L_MODE_CODE, L_MODE_NONE_FROM_BYTES

L_MODE_CODE:
    !is_code
    !code23
    !code01
    !is_code3
    !is_code2
    !is_code1
    !is_code0
    !b3
    !b2
    !b1
    !b0
    !b3_raw
    !b2_raw
    !b1_raw
    !b0_raw
    !p3
    !p2
    !p1
    !p0
    !idx3
    !idx2
    !idx1
    !trimmed_len
    !final_end
    !final_start
    !mode_ptr
    !mode_len
    return 3

L_MODE_NONE_FROM_BYTES:
    !is_code
    !code23
    !code01
    !is_code3
    !is_code2
    !is_code1
    !is_code0
    !b3
    !b2
    !b1
    !b0
    !b3_raw
    !b2_raw
    !b1_raw
    !b0_raw
    !p3
    !p2
    !p1
    !p0
    !idx3
    !idx2
    !idx1
    jmp L_MODE_NONE_SHARED

L_MODE_NONE:
    !len_ok
    jmp L_MODE_NONE_SHARED

L_MODE_NONE_SHARED:
    !trimmed_len
    !final_end
    !final_start
    !mode_ptr
    !mode_len
    return 0

@ffi_wrapper state_turn_set_normalized_mode_text(&state_ptr: ptr, thread_id: u64, turn_id: u64, &mode_ptr: ptr, mode_len: u64) -> u8:
L_ENTRY:
    start_slot = stack_alloc 8
    end_slot = stack_alloc 8
    store start_slot+0, 0 as u64
    store end_slot+0, mode_len as u64
    jmp L_SET_MODE_TRIM_START_COND

L_SET_MODE_TRIM_START_COND:
    start = load start_slot+0 as u64
    has_start = ult start, mode_len
    br has_start -> L_SET_MODE_TRIM_START_BODY, L_SET_MODE_TRIM_START_EXHAUSTED

L_SET_MODE_TRIM_START_EXHAUSTED:
    !has_start
    !start
    jmp L_SET_MODE_TRIM_END_COND

L_SET_MODE_TRIM_START_BODY:
    !has_start
    start_ptr = ptr_add mode_ptr, start
    start_byte = load start_ptr+0 as u8
    start_ws = call @ascii_is_trim_ws(start_byte)
    is_start_ws = ne start_ws, 0
    br is_start_ws -> L_SET_MODE_TRIM_START_NEXT, L_SET_MODE_TRIM_START_DONE

L_SET_MODE_TRIM_START_NEXT:
    !is_start_ws
    !start_ws
    !start_byte
    !start_ptr
    next_start = add start, 1
    store start_slot+0, next_start as u64
    !next_start
    !start
    jmp L_SET_MODE_TRIM_START_COND

L_SET_MODE_TRIM_START_DONE:
    !is_start_ws
    !start_ws
    !start_byte
    !start_ptr
    !start
    jmp L_SET_MODE_TRIM_END_COND

L_SET_MODE_TRIM_END_COND:
    end = load end_slot+0 as u64
    start_for_end = load start_slot+0 as u64
    has_end = ugt end, start_for_end
    br has_end -> L_SET_MODE_TRIM_END_BODY, L_SET_MODE_TRIM_END_EXHAUSTED

L_SET_MODE_TRIM_END_EXHAUSTED:
    !has_end
    !end
    !start_for_end
    jmp L_SET_MODE_LEN_CHECK

L_SET_MODE_TRIM_END_BODY:
    !has_end
    end_prev = sub end, 1
    end_ptr = ptr_add mode_ptr, end_prev
    end_byte = load end_ptr+0 as u8
    end_ws = call @ascii_is_trim_ws(end_byte)
    is_end_ws = ne end_ws, 0
    br is_end_ws -> L_SET_MODE_TRIM_END_NEXT, L_SET_MODE_TRIM_END_DONE

L_SET_MODE_TRIM_END_NEXT:
    !is_end_ws
    !end_ws
    !end_byte
    !end_ptr
    store end_slot+0, end_prev as u64
    !end_prev
    !end
    !start_for_end
    jmp L_SET_MODE_TRIM_END_COND

L_SET_MODE_TRIM_END_DONE:
    !is_end_ws
    !end_ws
    !end_byte
    !end_ptr
    !end_prev
    !end
    !start_for_end
    jmp L_SET_MODE_LEN_CHECK

L_SET_MODE_LEN_CHECK:
    final_start = load start_slot+0 as u64
    final_end = load end_slot+0 as u64
    trimmed_len = sub final_end, final_start
    has_trimmed = ugt trimmed_len, 0
    br has_trimmed -> L_SET_MODE_ALLOC, L_SET_MODE_CLEAR

L_SET_MODE_CLEAR:
    !has_trimmed
    clear_status = call @state_turn_set_mode_text(&state_ptr, thread_id, turn_id, 0, &mode_ptr, 0)
    !clear_status
    !trimmed_len
    !final_end
    !final_start
    !mode_ptr
    !mode_len
    !thread_id
    !turn_id
    !state_ptr
    return 0

L_SET_MODE_ALLOC:
    !has_trimmed
    copy_len = call @min_u64(trimmed_len, TURN_MODE_CAP)
    norm_ptr = alloc copy_len
    i_slot = stack_alloc 8
    store i_slot+0, 0 as u64
    jmp L_SET_MODE_COPY_COND

L_SET_MODE_COPY_COND:
    i = load i_slot+0 as u64
    done = uge i, copy_len
    br done -> L_SET_MODE_SAVE, L_SET_MODE_COPY_BODY

L_SET_MODE_COPY_BODY:
    !done
    src_idx = add final_start, i
    src_ptr = ptr_add mode_ptr, src_idx
    raw = load src_ptr+0 as u8
    lowered = call @ascii_lower_byte(raw)
    dst_ptr = ptr_add norm_ptr, i
    store dst_ptr+0, lowered as u8
    next_i = add i, 1
    store i_slot+0, next_i as u64
    !next_i
    !dst_ptr
    !lowered
    !raw
    !src_ptr
    !src_idx
    !i
    jmp L_SET_MODE_COPY_COND

L_SET_MODE_SAVE:
    !done
    mode_code = call @collaboration_mode_known_code(&norm_ptr, copy_len)
    set_status = call @state_turn_set_mode_text(&state_ptr, thread_id, turn_id, mode_code, &norm_ptr, copy_len)
    !set_status
    !norm_ptr
    !copy_len
    !i
    !trimmed_len
    !final_end
    !final_start
    !mode_ptr
    !mode_len
    !thread_id
    !turn_id
    !state_ptr
    return mode_code

@ffi_wrapper rpc_turn_start_collaboration_mode(&body: ptr, body_len: u64) -> u8:
L_ENTRY:
    root = call @sa_json_parse(&body, body_len)
    has_root = ne root, 0
    br has_root -> L_RPC_TMODE_ROOT, L_RPC_TMODE_NONE

L_RPC_TMODE_ROOT:
    !has_root
    params_slot = stack_alloc 8
    params_status = call @sa_json_object_get(root, &FB_KEY_PARAMS, FB_KEY_PARAMS_LEN, &params_slot)
    params_ok = eq params_status, 0
    br params_ok -> L_RPC_TMODE_PARAMS, L_RPC_TMODE_FREE_NONE

L_RPC_TMODE_PARAMS:
    !params_ok
    params_node = load params_slot+0 as ptr
    collab_slot = stack_alloc 8
    collab_status = call @sa_json_object_get(params_node, &JSON_KEY_COLLABORATION_MODE, JSON_KEY_COLLABORATION_MODE_LEN, &collab_slot)
    collab_ok = eq collab_status, 0
    br collab_ok -> L_RPC_TMODE_COLLAB, L_RPC_TMODE_FREE_NONE2

L_RPC_TMODE_COLLAB:
    !collab_ok
    collab_node = load collab_slot+0 as ptr
    mode_ptr_slot = stack_alloc 8
    mode_len_slot = stack_alloc 8
    mode_status = call @sa_json_object_get_string(collab_node, &JSON_KEY_MODE, JSON_KEY_MODE_LEN, &mode_ptr_slot, &mode_len_slot)
    mode_ok = eq mode_status, 0
    br mode_ok -> L_RPC_TMODE_VALUE, L_RPC_TMODE_FREE_NONE3

L_RPC_TMODE_VALUE:
    !mode_ok
    mode_ptr = load mode_ptr_slot+0 as ptr
    mode_len = load mode_len_slot+0 as u64
    mode_code = call @collaboration_mode_known_code(&mode_ptr, mode_len)
    is_plan = eq mode_code, 1
    br is_plan -> L_RPC_TMODE_PLAN, L_RPC_TMODE_GOAL_CHECK

L_RPC_TMODE_PLAN:
    !is_plan
    !mode_code
    root_free_plan = call @sa_json_free(^root)
    !root_free_plan
    !mode_ptr
    !mode_len
    !collab_node
    !body
    !body_len
    return 1

L_RPC_TMODE_GOAL_CHECK:
    !is_plan
    is_goal = eq mode_code, 2
    br is_goal -> L_RPC_TMODE_GOAL, L_RPC_TMODE_CODE_CHECK

L_RPC_TMODE_GOAL:
    !is_goal
    !mode_code
    root_free_goal = call @sa_json_free(^root)
    !root_free_goal
    !mode_ptr
    !mode_len
    !collab_node
    !body
    !body_len
    return 2

L_RPC_TMODE_CODE_CHECK:
    !is_goal
    is_code = eq mode_code, 3
    br is_code -> L_RPC_TMODE_CODE, L_RPC_TMODE_FREE_NONE4

L_RPC_TMODE_CODE:
    !is_code
    !mode_code
    root_free_code = call @sa_json_free(^root)
    !root_free_code
    !mode_ptr
    !mode_len
    !collab_node
    !body
    !body_len
    return 3

L_RPC_TMODE_FREE_NONE4:
    !is_code
    !mode_code
    !mode_ptr
    !mode_len
    !mode_status
    !collab_node
    !collab_status
    !params_node
    !params_status
    free_status_none4 = call @sa_json_free(^root)
    !free_status_none4
    !body
    !body_len
    return 0

L_RPC_TMODE_FREE_NONE3:
    !mode_ok
    !mode_status
    !collab_node
    !collab_status
    !params_node
    !params_status
    free_status_none3 = call @sa_json_free(^root)
    !free_status_none3
    !body
    !body_len
    return 0

L_RPC_TMODE_FREE_NONE2:
    !collab_ok
    !collab_status
    !params_node
    !params_status
    free_status_none2 = call @sa_json_free(^root)
    !free_status_none2
    !body
    !body_len
    return 0

L_RPC_TMODE_FREE_NONE:
    !params_ok
    !params_status
    free_status_none = call @sa_json_free(^root)
    !free_status_none
    !body
    !body_len
    return 0

L_RPC_TMODE_NONE:
    !has_root
    !root
    !body
    !body_len
    return 0

@ffi_wrapper rpc_turn_start_set_collaboration_mode(&state_ptr: ptr, thread_id: u64, turn_id: u64, &body: ptr, body_len: u64) -> u8:
L_ENTRY:
    root = call @sa_json_parse(&body, body_len)
    has_root = ne root, 0
    br has_root -> L_RPC_SET_TMODE_ROOT, L_RPC_SET_TMODE_NONE

L_RPC_SET_TMODE_ROOT:
    !has_root
    params_slot = stack_alloc 8
    params_status = call @sa_json_object_get(root, &FB_KEY_PARAMS, FB_KEY_PARAMS_LEN, &params_slot)
    params_ok = eq params_status, 0
    br params_ok -> L_RPC_SET_TMODE_PARAMS, L_RPC_SET_TMODE_FREE_NONE

L_RPC_SET_TMODE_PARAMS:
