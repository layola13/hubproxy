@ffi_wrapper send_rpc_plugin_share_save(&req: ptr, &id_ptr: ptr, id_len: u64, &cfg_ptr: ptr) -> u32:
L_ENTRY:
    host_ptr = load cfg_ptr+CFG_HOST_PTR as ptr
    host_len = load cfg_ptr+CFG_HOST_LEN as u64
    port = load cfg_ptr+CFG_PORT as u16
    port_u64 = zext port
    uuid_ptr_slot = stack_alloc 8
    uuid_len_slot = stack_alloc 8
    uuid_status = call @sa_deno_plugin_random_uuid(&uuid_ptr_slot, &uuid_len_slot)
    uuid_ptr = load uuid_ptr_slot+0 as ptr
    uuid_len = load uuid_len_slot+0 as u64
    remote_len_slot = stack_alloc 8
    remote_ptr = call @build_concat_owned(&STRING_REMOTE_PREFIX, STRING_REMOTE_PREFIX_LEN, &uuid_ptr, uuid_len, &remote_len_slot)
    remote_len = load remote_len_slot+0 as u64
    port_buf = stack_alloc ID_BUF_SIZE
    port_len_slot = stack_alloc 8
    port_fmt_status = call @sa_fmt_u64_into(port_u64, 10, port_buf, ID_BUF_SIZE, &port_len_slot)
    port_len = load port_len_slot+0 as u64
    url_len_slot = stack_alloc 8
    url_ptr = call @build_http_url(&host_ptr, host_len, port_u64, &STRING_SHARE_SUFFIX, STRING_SHARE_SUFFIX_LEN, &url_len_slot)
    url_len = load url_len_slot+0 as u64
    writer_slot = stack_alloc 8
    writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot)
    writer = load writer_slot+0 as ptr
    begin_status = call @sa_json_writer_begin_object(writer)
    remote_status = call @sa_json_writer_field_string(writer, &JSON_KEY_REMOTE_PLUGIN_ID, JSON_KEY_REMOTE_PLUGIN_ID_LEN, &remote_ptr, remote_len)
    share_status = call @sa_json_writer_field_string(writer, &JSON_KEY_SHARE_URL, JSON_KEY_SHARE_URL_LEN, &url_ptr, url_len)
    disc_status = call @sa_json_writer_field_string(writer, &JSON_KEY_DISCOVERABILITY, JSON_KEY_DISCOVERABILITY_LEN, &JSON_VALUE_UNLISTED, JSON_VALUE_UNLISTED_LEN)
    end_status = call @sa_json_writer_end_object(writer)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    uuid_free_status = call @sa_deno_plugin_free_buffer(uuid_ptr, uuid_len)
    !uuid_free_status
    !end_status
    !disc_status
    !share_status
    !remote_status
    !begin_status
    !writer_status
    !url_ptr
    !url_len
    !port_len
    !port_fmt_status
    !port_u64
    !remote_ptr
    !remote_len
    !uuid_status
    !uuid_ptr
    !uuid_len
    !host_ptr
    !host_len
    !port
    !cfg_ptr
    !req
    return 0

@ffi_wrapper send_rpc_plugin_share_update_empty(&req: ptr, &id_ptr: ptr, id_len: u64) -> u32:
L_ENTRY:
    writer_slot = stack_alloc 8
    writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot)
    writer = load writer_slot+0 as ptr
    begin_status = call @sa_json_writer_begin_object(writer)
    disc_status = call @sa_json_writer_field_string(writer, &JSON_KEY_DISCOVERABILITY, JSON_KEY_DISCOVERABILITY_LEN, &JSON_VALUE_UNLISTED, JSON_VALUE_UNLISTED_LEN)
    principals_status = call @json_writer_field_empty_array(writer, &JSON_KEY_PRINCIPALS, JSON_KEY_PRINCIPALS_LEN)
    end_status = call @sa_json_writer_end_object(writer)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !end_status
    !principals_status
    !disc_status
    !begin_status
    !writer_status
    !req
    return 0

@ffi_wrapper send_rpc_plugin_share_update_node(&req: ptr, &id_ptr: ptr, id_len: u64, principals_node: ptr) -> u32:
L_ENTRY:
    writer_slot = stack_alloc 8
    writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot)
    writer = load writer_slot+0 as ptr
    begin_status = call @sa_json_writer_begin_object(writer)
    disc_status = call @sa_json_writer_field_string(writer, &JSON_KEY_DISCOVERABILITY, JSON_KEY_DISCOVERABILITY_LEN, &JSON_VALUE_UNLISTED, JSON_VALUE_UNLISTED_LEN)
    principals_status = call @sa_json_writer_field_node(writer, &JSON_KEY_PRINCIPALS, JSON_KEY_PRINCIPALS_LEN, principals_node)
    end_status = call @sa_json_writer_end_object(writer)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !end_status
    !principals_status
    !disc_status
    !begin_status
    !writer_status
    !principals_node
    !req
    return 0

@ffi_wrapper send_rpc_plugin_share_update_targets(&req: ptr, &id_ptr: ptr, id_len: u64, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    root = call @sa_json_parse(&body, body_len)
    has_root = ne root, 0
    br has_root -> L_SHARE_UPDATE_ROOT, L_SHARE_UPDATE_NO_ROOT

L_SHARE_UPDATE_ROOT:
    !has_root
    params_slot = stack_alloc 8
    params_status = call @sa_json_object_get(root, &FB_KEY_PARAMS, FB_KEY_PARAMS_LEN, &params_slot)
    params_ok = eq params_status, 0
    br params_ok -> L_SHARE_UPDATE_PARAMS, L_SHARE_UPDATE_NO_PARAMS

L_SHARE_UPDATE_PARAMS:
    !params_ok
    params_node = load params_slot+0 as ptr
    principals_slot = stack_alloc 8
    principals_status = call @sa_json_object_get(params_node, &FB_KEY_PRINCIPALS, FB_KEY_PRINCIPALS_LEN, &principals_slot)
    principals_ok = eq principals_status, 0
    br principals_ok -> L_SHARE_UPDATE_PRINCIPALS, L_SHARE_UPDATE_NO_PRINCIPALS

L_SHARE_UPDATE_PRINCIPALS:
    !principals_ok
    principals_node = load principals_slot+0 as ptr
    principals_kind = call @sa_json_kind(principals_node)
    principals_is_array = eq principals_kind, SA_JSON_KIND_ARRAY
    !principals_kind
    br principals_is_array -> L_SHARE_UPDATE_ARRAY, L_SHARE_UPDATE_NOT_ARRAY

L_SHARE_UPDATE_ARRAY:
    !principals_is_array
    call @send_rpc_plugin_share_update_node(&req, &id_ptr, id_len, principals_node)
    principals_free = call @sa_json_free(^principals_node)
    !principals_free
    params_free = call @sa_json_free(^params_node)
    !params_free
    root_free = call @sa_json_free(^root)
    !root_free
    !principals_status
    !params_status
    !body
    !body_len
    !req
    return 0

L_SHARE_UPDATE_NOT_ARRAY:
    !principals_is_array
    principals_free_bad = call @sa_json_free(^principals_node)
