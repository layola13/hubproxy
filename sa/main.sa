    item_status = call @json_writer_field_param_string_or_default(writer, &JSON_KEY_ITEM_ID, JSON_KEY_ITEM_ID_LEN, &body, body_len, &J_ITEMID_KEY, J_ITEMID_KEY_LEN, &EMPTY_TEXT, EMPTY_TEXT_LEN, 0)
    meta_end_status = call @sa_json_writer_end_object(writer)
