L_TID_NULLABLE_NULL:
    !has_value
    call @rpc_builder_append(&buf, &J_NULL, J_NULL_LEN)
    !buf
    !state_ptr
    !thread_id
    return 0

@ffi_wrapper rpc_builder_append_thread_git_info(&buf: ptr, &state_ptr: ptr, thread_id: u64) -> u32:
L_ENTRY:
    slot = call @state_thread_find(&state_ptr, thread_id)
    missing = eq slot, 0
    br missing -> L_GITINFO_NULL_MISSING, L_GITINFO_SLOT

L_GITINFO_SLOT:
    !missing
    git_set = load slot+THR_GIT_SET as u8
    has_git = eq git_set, 1
    br has_git -> L_GITINFO_VALUE, L_GITINFO_NULL_SLOT

L_GITINFO_VALUE:
    !has_git
    git_ptr = load slot+THR_GIT_PTR as ptr
    git_len = load slot+THR_GIT_LEN as u64
    has_len = ugt git_len, 0
    br has_len -> L_GITINFO_APPEND, L_GITINFO_VALUE_NULL

L_GITINFO_APPEND:
    !has_len
    call @rpc_builder_append(&buf, &git_ptr, git_len)
    !git_ptr
    !git_len
    !git_set
    !slot
    !buf
    !state_ptr
    !thread_id
    return 0

L_GITINFO_VALUE_NULL:
    !has_len
    call @rpc_builder_append(&buf, &J_NULL, J_NULL_LEN)
    !git_ptr
    !git_len
    !git_set
    !slot
    !buf
    !state_ptr
    !thread_id
    return 0

L_GITINFO_NULL_SLOT:
    !has_git
    call @rpc_builder_append(&buf, &J_NULL, J_NULL_LEN)
    !git_set
    !slot
    !buf
    !state_ptr
    !thread_id
    return 0

L_GITINFO_NULL_MISSING:
    !missing
    !slot
    call @rpc_builder_append(&buf, &J_NULL, J_NULL_LEN)
    !buf
    !state_ptr
    !thread_id
    return 0

@ffi_wrapper rpc_builder_append_bool(&buf: ptr, value: u8) -> u32:
L_ENTRY:
    is_true = eq value, 1
    br is_true -> L_BOOL_TRUE, L_BOOL_FALSE

L_BOOL_TRUE:
    !is_true
    call @rpc_builder_append(&buf, &DEFAULT_TRUE, DEFAULT_TRUE_LEN)
    !buf
    !value
    return 0

L_BOOL_FALSE:
    !is_true
    call @rpc_builder_append(&buf, &DEFAULT_FALSE, DEFAULT_FALSE_LEN)
    !buf
    !value
    return 0

@ffi_wrapper rpc_builder_append_thread_open(&buf: ptr, &state_ptr: ptr, tid: u64, forked_from_id: u64, &preview_ptr: ptr, preview_len: u64, &provider_ptr: ptr, provider_len: u64, ephemeral: u8, &model_ptr: ptr, model_len: u64, &dir_ptr: ptr, dir_len: u64, &name_ptr: ptr, name_len: u64, name_set: u8) -> u32:
L_ENTRY:
    call @rpc_builder_append(&buf, &J_THREAD_OBJ_A, J_THREAD_OBJ_A_LEN)
    call @rpc_builder_append_thread_id_inner(&buf, &state_ptr, tid)
    call @rpc_builder_append(&buf, &J_THREAD_OBJ_B, J_THREAD_OBJ_B_LEN)
    call @rpc_builder_append_thread_id_inner(&buf, &state_ptr, tid)
    call @rpc_builder_append(&buf, &J_THREAD_OBJ_C1A, J_THREAD_OBJ_C1A_LEN)
    call @rpc_builder_append_nullable_thread_id_string(&buf, &state_ptr, forked_from_id)
    call @rpc_builder_append(&buf, &J_THREAD_OBJ_C1B, J_THREAD_OBJ_C1B_LEN)
    call @rpc_builder_append(&buf, &preview_ptr, preview_len)
    call @rpc_builder_append(&buf, &J_THREAD_OBJ_EPHEMERAL, J_THREAD_OBJ_EPHEMERAL_LEN)
    call @rpc_builder_append_bool(&buf, ephemeral)
    call @rpc_builder_append(&buf, &J_THREAD_OBJ_PROVIDER, J_THREAD_OBJ_PROVIDER_LEN)
    call @rpc_builder_append(&buf, &provider_ptr, provider_len)
    call @rpc_builder_append(&buf, &J_THREAD_OBJ_MODEL, J_THREAD_OBJ_MODEL_LEN)
    call @rpc_builder_append(&buf, &model_ptr, model_len)
    now_i = call @sa_time_unix_s()
    now = bitcast now_i as u64
    call @rpc_builder_append(&buf, &J_THREAD_OBJ_D1, J_THREAD_OBJ_D1_LEN)
    call @rpc_builder_append_u64(&buf, now)
    call @rpc_builder_append(&buf, &J_THREAD_OBJ_D2, J_THREAD_OBJ_D2_LEN)
    call @rpc_builder_append_u64(&buf, now)
    call @rpc_builder_append(&buf, &J_THREAD_OBJ_D3, J_THREAD_OBJ_D3_LEN)
    call @rpc_builder_append(&buf, &dir_ptr, dir_len)
    call @rpc_builder_append(&buf, &J_THREAD_OBJ_E1, J_THREAD_OBJ_E1_LEN)
    call @rpc_builder_append_thread_git_info(&buf, &state_ptr, tid)
    call @rpc_builder_append(&buf, &J_THREAD_OBJ_E1B, J_THREAD_OBJ_E1B_LEN)
    call @rpc_builder_append_nullable_string(&buf, &name_ptr, name_len, name_set)
    !now_i
    !now
    !buf
    !state_ptr
    !tid
    !forked_from_id
    !preview_ptr
    !preview_len
    !provider_ptr
    !provider_len
    !ephemeral
    !model_ptr
    !model_len
    !dir_ptr
    !dir_len
    !name_ptr
    !name_len
    !name_set
    return 0

@ffi_wrapper rpc_builder_append_thread(&buf: ptr, &state_ptr: ptr, tid: u64, forked_from_id: u64, &preview_ptr: ptr, preview_len: u64, &provider_ptr: ptr, provider_len: u64, ephemeral: u8, &model_ptr: ptr, model_len: u64, &dir_ptr: ptr, dir_len: u64, &name_ptr: ptr, name_len: u64, name_set: u8) -> u32:
L_ENTRY:
    call @rpc_builder_append_thread_open(&buf, &state_ptr, tid, forked_from_id, &preview_ptr, preview_len, &provider_ptr, provider_len, ephemeral, &model_ptr, model_len, &dir_ptr, dir_len, &name_ptr, name_len, name_set)
    call @rpc_builder_append(&buf, &J_THREAD_OBJ_E2, J_THREAD_OBJ_E2_LEN)
    !buf
    !state_ptr
    !tid
    !forked_from_id
    !preview_ptr
    !preview_len
    !provider_ptr
    !provider_len
    !ephemeral
    !model_ptr
    !model_len
    !dir_ptr
    !dir_len
    !name_ptr
    !name_len
    !name_set
    return 0

@ffi_wrapper rpc_builder_append_mode_value(&buf: ptr, mode: u8) -> u32:
L_ENTRY:
    is_plan = eq mode, 1
    br is_plan -> L_APPEND_MODE_PLAN, L_APPEND_MODE_GOAL_CHECK

L_APPEND_MODE_PLAN:
    !is_plan
    call @rpc_builder_append(&buf, &J_MODE_PLAN_VALUE, J_MODE_PLAN_VALUE_LEN)
    !buf
    !mode
    return 0

L_APPEND_MODE_GOAL_CHECK:
    !is_plan
    is_goal = eq mode, 2
    br is_goal -> L_APPEND_MODE_GOAL, L_APPEND_MODE_CODE_CHECK

L_APPEND_MODE_GOAL:
    !is_goal
    call @rpc_builder_append(&buf, &J_MODE_GOAL_VALUE, J_MODE_GOAL_VALUE_LEN)
    !buf
    !mode
    return 0

L_APPEND_MODE_CODE_CHECK:
    !is_goal
    is_code = eq mode, 3
    br is_code -> L_APPEND_MODE_CODE, L_APPEND_MODE_NULL

L_APPEND_MODE_CODE:
    !is_code
    call @rpc_builder_append(&buf, &J_MODE_CODE_VALUE, J_MODE_CODE_VALUE_LEN)
    !buf
    !mode
    return 0

L_APPEND_MODE_NULL:
    !is_code
    call @rpc_builder_append(&buf, &J_NULL, J_NULL_LEN)
    !buf
    !mode
    return 0

@ffi_wrapper rpc_builder_append_turn_status_mode(&buf: ptr, turn_id: u64, status: u8, mode: u8) -> u32:
L_ENTRY:
    now_i = call @sa_time_unix_s()
    now = bitcast now_i as u64
    call @rpc_builder_append(&buf, &J_TURN_OBJ_A, J_TURN_OBJ_A_LEN)
    call @rpc_builder_append_u64(&buf, turn_id)
    call @rpc_builder_append(&buf, &J_TURN_OBJ_STATUS_A, J_TURN_OBJ_STATUS_A_LEN)
    is_interrupted = eq status, 2
    br is_interrupted -> L_TURN_STATUS_INTERRUPTED, L_TURN_STATUS_CHECK_DONE

L_TURN_STATUS_CHECK_DONE:
    !is_interrupted
    is_done = eq status, 0
    br is_done -> L_TURN_STATUS_COMPLETED, L_TURN_STATUS_IN_PROGRESS

L_TURN_STATUS_INTERRUPTED:
    !is_interrupted
    call @rpc_builder_append(&buf, &J_TURN_STATUS_INTERRUPTED, J_TURN_STATUS_INTERRUPTED_LEN)
    call @rpc_builder_append_turn_done_tail_mode(&buf, now, mode)
    !now_i
    !now
    !mode
    !buf
    !turn_id
    !status
    return 0

L_TURN_STATUS_COMPLETED:
    !is_done
    call @rpc_builder_append(&buf, &J_TURN_STATUS_COMPLETED, J_TURN_STATUS_COMPLETED_LEN)
    call @rpc_builder_append_turn_done_tail_mode(&buf, now, mode)
    !now_i
    !now
    !mode
    !buf
    !turn_id
    !status
    return 0

L_TURN_STATUS_IN_PROGRESS:
    !is_done
    call @rpc_builder_append(&buf, &J_TURN_STATUS_IN_PROGRESS, J_TURN_STATUS_IN_PROGRESS_LEN)
    call @rpc_builder_append_turn_open_tail_mode(&buf, now, mode)
    !now_i
    !now
    !mode
    !buf
    !turn_id
    !status
    return 0

@ffi_wrapper rpc_builder_append_turn_status_mode_items(&buf: ptr, turn_id: u64, status: u8, mode: u8, &items_ptr: ptr, items_len: u64) -> u32:
L_ENTRY:
    now_i = call @sa_time_unix_s()
    now = bitcast now_i as u64
    call @rpc_builder_append(&buf, &J_TURN_OBJ_A, J_TURN_OBJ_A_LEN)
    call @rpc_builder_append_u64(&buf, turn_id)
    has_items = ugt items_len, 0
    br has_items -> L_TURN_ITEMS_WITH_ITEMS, L_TURN_ITEMS_EMPTY

L_TURN_ITEMS_WITH_ITEMS:
    !has_items
    call @rpc_builder_append(&buf, &J_TURN_OBJ_ITEMS_A, J_TURN_OBJ_ITEMS_A_LEN)
    call @rpc_builder_append(&buf, &items_ptr, items_len)
    call @rpc_builder_append(&buf, &J_TURN_OBJ_ITEMS_B, J_TURN_OBJ_ITEMS_B_LEN)
    jmp L_TURN_ITEMS_STATUS

L_TURN_ITEMS_EMPTY:
    !has_items
    call @rpc_builder_append(&buf, &J_TURN_OBJ_STATUS_A, J_TURN_OBJ_STATUS_A_LEN)
    jmp L_TURN_ITEMS_STATUS

L_TURN_ITEMS_STATUS:
    is_interrupted = eq status, 2
    br is_interrupted -> L_TURN_ITEMS_INTERRUPTED, L_TURN_ITEMS_CHECK_DONE

L_TURN_ITEMS_CHECK_DONE:
    !is_interrupted
    is_done = eq status, 0
    br is_done -> L_TURN_ITEMS_COMPLETED, L_TURN_ITEMS_IN_PROGRESS

L_TURN_ITEMS_INTERRUPTED:
    !is_interrupted
    call @rpc_builder_append(&buf, &J_TURN_STATUS_INTERRUPTED, J_TURN_STATUS_INTERRUPTED_LEN)
    call @rpc_builder_append_turn_done_tail_mode(&buf, now, mode)
    !now_i
    !now
    !items_ptr
    !items_len
    !mode
    !buf
    !turn_id
    !status
    return 0

L_TURN_ITEMS_COMPLETED:
    !is_done
    call @rpc_builder_append(&buf, &J_TURN_STATUS_COMPLETED, J_TURN_STATUS_COMPLETED_LEN)
    call @rpc_builder_append_turn_done_tail_mode(&buf, now, mode)
    !now_i
    !now
    !items_ptr
    !items_len
    !mode
    !buf
    !turn_id
    !status
    return 0

L_TURN_ITEMS_IN_PROGRESS:
    !is_done
    call @rpc_builder_append(&buf, &J_TURN_STATUS_IN_PROGRESS, J_TURN_STATUS_IN_PROGRESS_LEN)
    call @rpc_builder_append_turn_open_tail_mode(&buf, now, mode)
    !now_i
    !now
    !items_ptr
    !items_len
    !mode
    !buf
    !turn_id
    !status
    return 0

@ffi_wrapper rpc_builder_append_turn_status(&buf: ptr, turn_id: u64, status: u8) -> u32:
L_ENTRY:
    call @rpc_builder_append_turn_status_mode(&buf, turn_id, status, 0)
    !buf
    !turn_id
    !status
    return 0

@ffi_wrapper rpc_builder_append_turn_open_tail_mode(&buf: ptr, timestamp: u64, mode: u8) -> u32:
L_ENTRY:
    call @rpc_builder_append(&buf, &J_TURN_OBJ_TIME_A, J_TURN_OBJ_TIME_A_LEN)
    call @rpc_builder_append_u64(&buf, timestamp)
    call @rpc_builder_append(&buf, &J_TURN_OBJ_TIME_B, J_TURN_OBJ_TIME_B_LEN)
    call @rpc_builder_append_u64(&buf, timestamp)
    call @rpc_builder_append(&buf, &J_TURN_OBJ_TIME_C, J_TURN_OBJ_TIME_C_LEN)
    call @rpc_builder_append_mode_value(&buf, mode)
    call @rpc_builder_append(&buf, &J_TURN_OBJ_TIME_D, J_TURN_OBJ_TIME_D_LEN)
    call @rpc_builder_append_u64(&buf, timestamp)
    call @rpc_builder_append(&buf, &J_TURN_OBJ_OPEN_D, J_TURN_OBJ_OPEN_D_LEN)
    !buf
    !timestamp
    !mode
    return 0

@ffi_wrapper rpc_builder_append_turn_done_tail_mode(&buf: ptr, timestamp: u64, mode: u8) -> u32:
L_ENTRY:
    call @rpc_builder_append(&buf, &J_TURN_OBJ_TIME_A, J_TURN_OBJ_TIME_A_LEN)
    call @rpc_builder_append_u64(&buf, timestamp)
    call @rpc_builder_append(&buf, &J_TURN_OBJ_TIME_B, J_TURN_OBJ_TIME_B_LEN)
    call @rpc_builder_append_u64(&buf, timestamp)
    call @rpc_builder_append(&buf, &J_TURN_OBJ_TIME_C, J_TURN_OBJ_TIME_C_LEN)
    call @rpc_builder_append_mode_value(&buf, mode)
    call @rpc_builder_append(&buf, &J_TURN_OBJ_TIME_D, J_TURN_OBJ_TIME_D_LEN)
    call @rpc_builder_append_u64(&buf, timestamp)
    call @rpc_builder_append(&buf, &J_TURN_OBJ_DONE_D, J_TURN_OBJ_DONE_D_LEN)
    call @rpc_builder_append_u64(&buf, timestamp)
    call @rpc_builder_append(&buf, &J_TURN_OBJ_DONE_E, J_TURN_OBJ_DONE_E_LEN)
    !buf
    !timestamp
    !mode
    return 0

@ffi_wrapper rpc_builder_append_turn_mode(&buf: ptr, turn_id: u64, mode: u8) -> u32:
L_ENTRY:
    call @rpc_builder_append_turn_status_mode(&buf, turn_id, 1, mode)
    !buf
    !turn_id
    !mode
    return 0

@ffi_wrapper rpc_builder_append_turn(&buf: ptr, turn_id: u64) -> u32:
L_ENTRY:
    call @rpc_builder_append_turn_status(&buf, turn_id, 1)
    !buf
    !turn_id
    return 0

@ffi_wrapper rpc_builder_append_goal_tail(&buf: ptr) -> u32:
L_ENTRY:
    now_i = call @sa_time_unix_s()
    now = bitcast now_i as u64
    call @rpc_builder_append(&buf, &J_GOAL_OBJ_D1, J_GOAL_OBJ_D1_LEN)
    call @rpc_builder_append_u64(&buf, now)
    call @rpc_builder_append(&buf, &J_GOAL_OBJ_D2, J_GOAL_OBJ_D2_LEN)
    call @rpc_builder_append_u64(&buf, now)
    call @rpc_builder_append(&buf, &J_GOAL_OBJ_D3, J_GOAL_OBJ_D3_LEN)
    !now_i
    !now
    !buf
    return 0

@ffi_wrapper notify_frame_begin(&buf: ptr, &event_ptr: ptr, event_len: u64) -> u32:
L_ENTRY:
    call @rpc_builder_append(&buf, &SSE_EVENT_PREFIX, SSE_EVENT_PREFIX_LEN)
    call @rpc_builder_append(&buf, &event_ptr, event_len)
    call @rpc_builder_append(&buf, &SSE_DATA_METHOD_A, SSE_DATA_METHOD_A_LEN)
    call @rpc_builder_append(&buf, &event_ptr, event_len)
    call @rpc_builder_append(&buf, &SSE_DATA_METHOD_B, SSE_DATA_METHOD_B_LEN)
    !buf
    !event_ptr
    !event_len
    return 0

@ffi_wrapper notify_push_frame(&state_ptr: ptr, ^frame: ptr) -> u32:
L_ENTRY:
    frame_ptr = call @rpc_builder_data(&frame)
    frame_len = call @rpc_builder_len(&frame)
    push_status = call @state_notify_push(&state_ptr, &frame_ptr, frame_len)
    !push_status
    !frame_ptr
    !frame_len
    !frame
    !state_ptr
    return 0

@ffi_wrapper notify_thread_started_with_values(&state_ptr: ptr, thread_id: u64, forked_from_id: u64, &provider_ptr: ptr, provider_len: u64, ephemeral: u8, &model_ptr: ptr, model_len: u64, &dir_ptr: ptr, dir_len: u64) -> u32:
L_ENTRY:
    frame = call @rpc_builder_new()
    call @notify_frame_begin(&frame, &EV_THREAD_STARTED, EV_THREAD_STARTED_LEN)
    call @rpc_builder_append(&frame, &J_EVT_THREAD_PARAMS_A, J_EVT_THREAD_PARAMS_A_LEN)
    call @rpc_builder_append_thread(&frame, &state_ptr, thread_id, forked_from_id, &EMPTY_TEXT, EMPTY_TEXT_LEN, &provider_ptr, provider_len, ephemeral, &model_ptr, model_len, &dir_ptr, dir_len, &EMPTY_TEXT, EMPTY_TEXT_LEN, 0)
    call @rpc_builder_append(&frame, &J_EVT_CLOSE, J_EVT_CLOSE_LEN)
    call @rpc_builder_append(&frame, &SSE_FRAME_END, SSE_FRAME_END_LEN)
    call @notify_push_frame(&state_ptr, ^frame)
    !provider_ptr
    !provider_len
    !ephemeral
    !model_ptr
    !model_len
    !dir_ptr
    !dir_len
    !forked_from_id
    !thread_id
    !state_ptr
    return 0

@ffi_wrapper notify_thread_status_idle(&state_ptr: ptr, thread_id: u64) -> u32:
L_ENTRY:
    frame = call @rpc_builder_new()
    call @notify_frame_begin(&frame, &EV_THREAD_STATUS, EV_THREAD_STATUS_LEN)
    call @rpc_builder_append(&frame, &J_EVT_THREAD_ID_A, J_EVT_THREAD_ID_A_LEN)
    call @rpc_builder_append_u64(&frame, thread_id)
    call @rpc_builder_append(&frame, &J_EVT_STATUS_IDLE_B, J_EVT_STATUS_IDLE_B_LEN)
    call @rpc_builder_append(&frame, &SSE_FRAME_END, SSE_FRAME_END_LEN)
    call @notify_push_frame(&state_ptr, ^frame)
    !thread_id
    !state_ptr
    return 0

@ffi_wrapper notify_thread_id_only(&state_ptr: ptr, &event_ptr: ptr, event_len: u64, thread_id: u64) -> u32:
L_ENTRY:
    frame = call @rpc_builder_new()
    call @notify_frame_begin(&frame, &event_ptr, event_len)
