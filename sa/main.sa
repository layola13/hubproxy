    call @send_rpc_realtime_thread(&req, &rpc_id_ptr, rpc_id_len, &rpc_body_ptr, rpc_body_len, &J_REALTIME_STOP_A, J_REALTIME_STOP_A_LEN, &J_REALTIME_STOP_B, J_REALTIME_STOP_B_LEN)
