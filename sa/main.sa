@ffi_wrapper send_rpc_account_read(&req: ptr, &id_ptr: ptr, id_len: u64, &cfg_ptr: ptr) -> u32:
L_ENTRY:
    plan_ptr = load cfg_ptr+CFG_PLAN_PTR as ptr
    plan_len = load cfg_ptr+CFG_PLAN_LEN as u64
    email_ptr = load cfg_ptr+CFG_EMAIL_PTR as ptr
    email_len = load cfg_ptr+CFG_EMAIL_LEN as u64
    selected_plan_ptr_slot = stack_alloc 8
    selected_plan_len_slot = stack_alloc 8
    selected_email_ptr_slot = stack_alloc 8
    selected_email_len_slot = stack_alloc 8
    has_plan = ugt plan_len, 0
    br has_plan -> L_ACCOUNT_SELECT_PLAN_CFG, L_ACCOUNT_SELECT_PLAN_DEFAULT

L_ACCOUNT_SELECT_PLAN_CFG:
    !has_plan
    store selected_plan_ptr_slot+0, plan_ptr as ptr
    store selected_plan_len_slot+0, plan_len as u64
    jmp L_ACCOUNT_AFTER_PLAN

L_ACCOUNT_SELECT_PLAN_DEFAULT:
    !has_plan
    default_plan_ptr = &DEFAULT_PLAN_PLUS
    store selected_plan_ptr_slot+0, default_plan_ptr as ptr
    store selected_plan_len_slot+0, DEFAULT_PLAN_PLUS_LEN as u64
    !default_plan_ptr
    jmp L_ACCOUNT_AFTER_PLAN

L_ACCOUNT_AFTER_PLAN:
    has_email = ugt email_len, 0
    br has_email -> L_ACCOUNT_SELECT_EMAIL_CFG, L_ACCOUNT_SELECT_EMAIL_DEFAULT

L_ACCOUNT_SELECT_EMAIL_CFG:
    !has_email
    store selected_email_ptr_slot+0, email_ptr as ptr
    store selected_email_len_slot+0, email_len as u64
    jmp L_ACCOUNT_WRITE

L_ACCOUNT_SELECT_EMAIL_DEFAULT:
    !has_email
    default_email_ptr = &J_ACCOUNT_DEFAULT_EMAIL
    store selected_email_ptr_slot+0, default_email_ptr as ptr
    store selected_email_len_slot+0, J_ACCOUNT_DEFAULT_EMAIL_LEN as u64
    !default_email_ptr
    jmp L_ACCOUNT_WRITE

L_ACCOUNT_WRITE:
    selected_plan_ptr = load selected_plan_ptr_slot+0 as ptr
    selected_plan_len = load selected_plan_len_slot+0 as u64
    selected_email_ptr = load selected_email_ptr_slot+0 as ptr
    selected_email_len = load selected_email_len_slot+0 as u64
    writer_slot = stack_alloc 8
    writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot)
    writer = load writer_slot+0 as ptr
    begin_status = call @sa_json_writer_begin_object(writer)
    account_field_status = call @sa_json_writer_object_field(writer, &JSON_KEY_ACCOUNT, JSON_KEY_ACCOUNT_LEN)
    account_begin_status = call @sa_json_writer_begin_object(writer)
    type_field_status = call @sa_json_writer_field_string(writer, &FB_KEY_TYPE, FB_KEY_TYPE_LEN, &JSON_VALUE_CHATGPT, JSON_VALUE_CHATGPT_LEN)
    email_field_status = call @sa_json_writer_field_string(writer, &JSON_KEY_EMAIL, JSON_KEY_EMAIL_LEN, &selected_email_ptr, selected_email_len)
    plan_field_status = call @sa_json_writer_field_string(writer, &JSON_KEY_PLAN_TYPE, JSON_KEY_PLAN_TYPE_LEN, &selected_plan_ptr, selected_plan_len)
    account_end_status = call @sa_json_writer_end_object(writer)
    auth_field_status = call @sa_json_writer_field_bool(writer, &JSON_KEY_REQUIRES_OPENAI_AUTH, JSON_KEY_REQUIRES_OPENAI_AUTH_LEN, 0)
    end_status = call @sa_json_writer_end_object(writer)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !end_status
    !auth_field_status
    !account_end_status
    !plan_field_status
    !email_field_status
    !type_field_status
    !account_begin_status
    !account_field_status
    !begin_status
    !writer_status
    !selected_email_ptr
    !selected_email_len
    !selected_plan_ptr
    !selected_plan_len
    !email_ptr
    !email_len
    !plan_ptr
    !plan_len
    !cfg_ptr
    !req
    return 0

@ffi_wrapper send_rpc_rate_limits(&req: ptr, &id_ptr: ptr, id_len: u64, &cfg_ptr: ptr) -> u32:
L_ENTRY:
    plan_ptr = load cfg_ptr+CFG_PLAN_PTR as ptr
    plan_len = load cfg_ptr+CFG_PLAN_LEN as u64
    selected_plan_ptr_slot = stack_alloc 8
    selected_plan_len_slot = stack_alloc 8
    has_plan = ugt plan_len, 0
    br has_plan -> L_RATE_SELECT_CFG, L_RATE_SELECT_DEFAULT

L_RATE_SELECT_CFG:
    !has_plan
    store selected_plan_ptr_slot+0, plan_ptr as ptr
    store selected_plan_len_slot+0, plan_len as u64
    jmp L_RATE_WRITE

L_RATE_SELECT_DEFAULT:
    !has_plan
    default_plan_ptr = &DEFAULT_PLAN_PLUS
    store selected_plan_ptr_slot+0, default_plan_ptr as ptr
    store selected_plan_len_slot+0, DEFAULT_PLAN_PLUS_LEN as u64
    !default_plan_ptr
    jmp L_RATE_WRITE

L_RATE_WRITE:
    selected_plan_ptr = load selected_plan_ptr_slot+0 as ptr
    selected_plan_len = load selected_plan_len_slot+0 as u64
    writer_slot = stack_alloc 8
    writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot)
    writer = load writer_slot+0 as ptr
    begin_status = call @sa_json_writer_begin_object(writer)
    rate_field_status = call @sa_json_writer_object_field(writer, &JSON_KEY_RATE_LIMITS, JSON_KEY_RATE_LIMITS_LEN)
    rate_begin_status = call @sa_json_writer_begin_object(writer)
    used_field_status = call @sa_json_writer_field_i64(writer, &JSON_KEY_USED_PERCENT, JSON_KEY_USED_PERCENT_LEN, 0)
    credits_field_status = call @sa_json_writer_field_null(writer, &JSON_KEY_CREDITS, JSON_KEY_CREDITS_LEN)
    limit_id_field_status = call @sa_json_writer_field_null(writer, &JSON_KEY_LIMIT_ID, JSON_KEY_LIMIT_ID_LEN)
    limit_name_field_status = call @sa_json_writer_field_null(writer, &JSON_KEY_LIMIT_NAME, JSON_KEY_LIMIT_NAME_LEN)
    plan_field_status = call @sa_json_writer_field_string(writer, &JSON_KEY_PLAN_TYPE, JSON_KEY_PLAN_TYPE_LEN, &selected_plan_ptr, selected_plan_len)
    primary_field_status = call @sa_json_writer_field_null(writer, &JSON_KEY_PRIMARY, JSON_KEY_PRIMARY_LEN)
    reached_field_status = call @sa_json_writer_field_null(writer, &JSON_KEY_RATE_LIMIT_REACHED_TYPE, JSON_KEY_RATE_LIMIT_REACHED_TYPE_LEN)
    secondary_field_status = call @sa_json_writer_field_null(writer, &JSON_KEY_SECONDARY, JSON_KEY_SECONDARY_LEN)
    rate_end_status = call @sa_json_writer_end_object(writer)
    by_limit_field_status = call @sa_json_writer_field_null(writer, &JSON_KEY_RATE_LIMITS_BY_LIMIT_ID, JSON_KEY_RATE_LIMITS_BY_LIMIT_ID_LEN)
    end_status = call @sa_json_writer_end_object(writer)
    call @send_wrapped_writer_with_id(&req, &id_ptr, id_len, writer)
    !end_status
    !by_limit_field_status
    !rate_end_status
    !secondary_field_status
    !reached_field_status
    !primary_field_status
    !plan_field_status
    !limit_name_field_status
    !limit_id_field_status
    !credits_field_status
    !used_field_status
    !rate_begin_status
    !rate_field_status
    !begin_status
    !writer_status
    !selected_plan_ptr
    !selected_plan_len
    !plan_ptr
    !plan_len
    !cfg_ptr
    !req
    return 0

