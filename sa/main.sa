L_ENTRY:
    cwd_ptr_slot = stack_alloc 8
    cwd_len_slot = stack_alloc 8
    cwd_status = call @sa_deno_plugin_cwd(&cwd_ptr_slot, &cwd_len_slot)
    cwd_ptr = load cwd_ptr_slot+0 as ptr
    cwd_len = load cwd_len_slot+0 as u64
    agents_path_len_slot = stack_alloc 8
    agents_path = call @build_concat_owned(&cwd_ptr, cwd_len, &STRING_AGENTS_PATH_SUFFIX, STRING_AGENTS_PATH_SUFFIX_LEN, &agents_path_len_slot)
    agents_path_len = load agents_path_len_slot+0 as u64
    env_path_len_slot = stack_alloc 8
    env_path = call @build_concat_owned(&cwd_ptr, cwd_len, &STRING_ENV_PATH_SUFFIX, STRING_ENV_PATH_SUFFIX_LEN, &env_path_len_slot)
    env_path_len = load env_path_len_slot+0 as u64
    writer_slot = stack_alloc 8
    writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot)
    writer = load writer_slot+0 as ptr
    begin_status = call @sa_json_writer_begin_object(writer)
    items_field_status = call @sa_json_writer_object_field(writer, &JSON_KEY_ITEMS, JSON_KEY_ITEMS_LEN)
    items_begin_status = call @sa_json_writer_begin_array(writer)
    agents_begin_status = call @sa_json_writer_begin_object(writer)
    agents_type_status = call @sa_json_writer_field_string(writer, &JSON_KEY_ITEM_TYPE, JSON_KEY_ITEM_TYPE_LEN, &JSON_VALUE_AGENTS_MD, JSON_VALUE_AGENTS_MD_LEN)
