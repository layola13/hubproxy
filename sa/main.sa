    !body
    !body_len
    return 0

@event_stream_worker(^ctx: ptr) -> i32:
L_EW_ENTRY:
    req = load ctx+EVENT_CTX_REQ as ptr
    state_ptr = load ctx+EVENT_CTX_STATE as ptr
    stream_slot = stack_alloc 8
    stream_status = call @sa_http_server_resp_stream_new(req, 200, &stream_slot)
    stream = load stream_slot+0 as ptr
    keepalive_write = call @sa_http_server_resp_stream_write(stream, &SSE_KEEPALIVE, SSE_KEEPALIVE_LEN)
    keepalive_flush = call @sa_http_server_resp_stream_flush(stream)
    keepalive_ok = eq keepalive_write, 0
    !keepalive_write
    !keepalive_flush
    !stream_status
    br keepalive_ok -> L_EW_INIT_OK, L_EW_END_INIT_CLOSED

L_EW_INIT_OK:
    !keepalive_ok
    frame_buf = stack_alloc NOTIFY_CAP
    frame_len_slot = stack_alloc 8
    cursor_slot = stack_alloc 8
    cursor_start = call @state_notify_cursor(&state_ptr)
    store cursor_slot+0, cursor_start as u64
    !cursor_start
    loop_slot = stack_alloc 8
    store loop_slot+0, 0 as u64
    jmp L_EW_LOOP_COND

L_EW_LOOP_COND:
    loop_i = load loop_slot+0 as u64
    done = uge loop_i, EVENT_WORKER_LOOPS
    br done -> L_EW_END, L_EW_POP

L_EW_POP:
    !done
    pop_status = call @state_notify_read(&state_ptr, &cursor_slot, &frame_buf, NOTIFY_CAP, &frame_len_slot)
    has_frame = eq pop_status, 1
    !pop_status
    br has_frame -> L_EW_WRITE_FRAME, L_EW_SLEEP

L_EW_WRITE_FRAME:
    !has_frame
    frame_len = load frame_len_slot+0 as u64
    frame_write = call @sa_http_server_resp_stream_write(stream, &frame_buf, frame_len)
    frame_flush = call @sa_http_server_resp_stream_flush(stream)
    frame_write_ok = eq frame_write, 0
    !frame_write
    !frame_flush
    !frame_len
    br frame_write_ok -> L_EW_WRITE_OK, L_EW_END_WRITE_CLOSED

L_EW_WRITE_OK:
    !frame_write_ok
    jmp L_EW_NEXT

L_EW_SLEEP:
    !has_frame
    idle_keepalive_write = call @sa_http_server_resp_stream_write(stream, &SSE_KEEPALIVE, SSE_KEEPALIVE_LEN)
    idle_keepalive_flush = call @sa_http_server_resp_stream_flush(stream)
    idle_keepalive_ok = eq idle_keepalive_write, 0
    !idle_keepalive_write
    !idle_keepalive_flush
    br idle_keepalive_ok -> L_EW_SLEEP_OK, L_EW_END_IDLE_CLOSED

L_EW_SLEEP_OK:
    !idle_keepalive_ok
    EXPAND DENO_SLEEP_MS sleep_status, 50
    !sleep_status
    jmp L_EW_NEXT

L_EW_NEXT:
    next_loop = add loop_i, 1
    store loop_slot+0, next_loop as u64
    !next_loop
    !loop_i
    jmp L_EW_LOOP_COND

L_EW_END:
    !done
    !loop_i
    end_status = call @sa_http_server_resp_stream_end(stream)
    !end_status
    call @sa_http_server_resp_stream_free(^stream)
    call @sa_http_server_req_free(^req)
    !state_ptr
    !ctx
    return 0

L_EW_END_INIT_CLOSED:
    !keepalive_ok
    call @sa_http_server_resp_stream_free(^stream)
    call @sa_http_server_req_free(^req)
    !state_ptr
    !ctx
    return 0

L_EW_END_WRITE_CLOSED:
    !frame_write_ok
    call @sa_http_server_resp_stream_free(^stream)
    call @sa_http_server_req_free(^req)
    !state_ptr
    !ctx
    return 0

L_EW_END_IDLE_CLOSED:
    !idle_keepalive_ok
    call @sa_http_server_resp_stream_free(^stream)
    call @sa_http_server_req_free(^req)
    !state_ptr
    !ctx
    return 0

@ffi_wrapper spawn_event_stream(^ctx: ptr) -> u32:
L_ENTRY:
    worker_vt = &EVENT_WORKER_VT
    worker_fn = load worker_vt+0 as ptr
    worker_raw = *worker_fn
    worker_safe = assume_safe worker_raw
    spawn_status = call @pthread_spawn_detached(*worker_safe, ^ctx)
    !worker_safe
    !worker_raw
    !worker_fn
    !worker_vt
    return spawn_status

@ffi_wrapper send_builder_response(&req: ptr, ^buf: ptr) -> u32:
L_ENTRY:
    json_ptr = call @rpc_builder_data(&buf)
    json_len = call @rpc_builder_len(&buf)
    call @send_rpc_json(&req, 200, &json_ptr, json_len)
    !json_ptr
    !json_len
    !buf
    !req
    return 0

@ffi_wrapper rpc_extract_id_token(&body: ptr, body_len: u64, &out_ptr: ptr, &out_len: ptr) -> u32:
L_ENTRY:
    idx = call @sa_bytes_find(&body, body_len, &J_ID_KEY, J_ID_KEY_LEN)
    found = sge idx, 0
    br found -> L_ID_PREP, L_ID_NOT_FOUND

L_ID_PREP:
    !found
    val_off_i = add idx, J_ID_KEY_LEN
    !idx
    val_off = bitcast val_off_i as u64
    remaining = sub body_len, val_off
    val_ptr = ptr_add body, val_off
    method_idx = call @sa_bytes_find(&val_ptr, remaining, &J_METHOD_KEY, J_METHOD_KEY_LEN)
    method_found = sge method_idx, 0
    br method_found -> L_ID_FOUND, L_ID_NO_METHOD

L_ID_FOUND:
    !method_found
    token_len = bitcast method_idx as u64
    store out_ptr+0, val_ptr as ptr
    store out_len+0, token_len as u64
    !token_len
    !method_idx
    !val_ptr
    !remaining
    !val_off
    !val_off_i
    !body
    !body_len
    !out_ptr
    !out_len
    return 1

L_ID_NO_METHOD:
    !method_found
    !method_idx
    !val_ptr
    !remaining
    !val_off
    !val_off_i
    !body
    !body_len
    store out_ptr+0, J_NULL_ID as ptr
    store out_len+0, J_NULL_ID_LEN as u64
    !out_ptr
    !out_len
    return 0

L_ID_NOT_FOUND:
    !found
    !idx
    !body
    !body_len
    store out_ptr+0, J_NULL_ID as ptr
    store out_len+0, J_NULL_ID_LEN as u64
    !out_ptr
    !out_len
    return 0

@ffi_wrapper send_jsonrpc_envelope_with_id(&req: ptr, status: u16, &id_ptr: ptr, id_len: u64, &payload_ptr: ptr, payload_len: u64, is_error: u8) -> u32:
L_ENTRY:
    writer_slot = stack_alloc 8
    buffer_slot = stack_alloc 8
    writer_status = call @sa_json_writer_new(SA_JSON_WHITESPACE_MINIFIED, 1, 0, 0, 0, &writer_slot)
    writer = load writer_slot+0 as ptr
    begin_status = call @sa_json_writer_begin_object(writer)
    jsonrpc_status = call @sa_json_writer_field_string(writer, &RPC_KEY_JSONRPC, RPC_KEY_JSONRPC_LEN, &RPC_VALUE_2_0, RPC_VALUE_2_0_LEN)
    !jsonrpc_status
    id_node = call @sa_json_parse(&id_ptr, id_len)
    id_has_node = ne id_node, 0
    br id_has_node -> L_JSONRPC_ID_NODE, L_JSONRPC_ID_NULL

L_JSONRPC_ID_NODE:
    !id_has_node
    id_field_status = call @sa_json_writer_field_node(writer, &RPC_KEY_ID, RPC_KEY_ID_LEN, id_node)
    id_free_status = call @sa_json_free(^id_node)
    !id_free_status
    !id_field_status
    jmp L_JSONRPC_PAYLOAD_PARSE

L_JSONRPC_ID_NULL:
    !id_has_node
    !id_node
    id_null_status = call @sa_json_writer_field_null(writer, &RPC_KEY_ID, RPC_KEY_ID_LEN)
    !id_null_status
    jmp L_JSONRPC_PAYLOAD_PARSE

L_JSONRPC_PAYLOAD_PARSE:
    payload_node = call @sa_json_parse(&payload_ptr, payload_len)
    payload_has_node = ne payload_node, 0
    br payload_has_node -> L_JSONRPC_PAYLOAD_NODE, L_JSONRPC_PAYLOAD_NULL

L_JSONRPC_PAYLOAD_NODE:
    !payload_has_node
    is_error_flag = eq is_error, 1
    br is_error_flag -> L_JSONRPC_ERROR_NODE, L_JSONRPC_RESULT_NODE

L_JSONRPC_RESULT_NODE:
    !is_error_flag
    payload_field_status = call @sa_json_writer_field_node(writer, &RPC_KEY_RESULT, RPC_KEY_RESULT_LEN, payload_node)
    payload_free_status = call @sa_json_free(^payload_node)
    !payload_free_status
    !payload_field_status
    jmp L_JSONRPC_FINISH

L_JSONRPC_ERROR_NODE:
    !is_error_flag
    payload_error_status = call @sa_json_writer_field_node(writer, &RPC_KEY_ERROR, RPC_KEY_ERROR_LEN, payload_node)
    payload_error_free_status = call @sa_json_free(^payload_node)
    !payload_error_free_status
    !payload_error_status
    jmp L_JSONRPC_FINISH

L_JSONRPC_PAYLOAD_NULL:
    !payload_has_node
    !payload_node
    is_error_null = eq is_error, 1
    br is_error_null -> L_JSONRPC_ERROR_NULL, L_JSONRPC_RESULT_NULL

L_JSONRPC_RESULT_NULL:
    !is_error_null
    payload_null_status = call @sa_json_writer_field_null(writer, &RPC_KEY_RESULT, RPC_KEY_RESULT_LEN)
    !payload_null_status
    jmp L_JSONRPC_FINISH

L_JSONRPC_ERROR_NULL:
    !is_error_null
    payload_error_null_status = call @sa_json_writer_field_null(writer, &RPC_KEY_ERROR, RPC_KEY_ERROR_LEN)
    !payload_error_null_status
    jmp L_JSONRPC_FINISH

L_JSONRPC_FINISH:
    end_status = call @sa_json_writer_end_object(writer)
    finish_status = call @sa_json_writer_finish(writer, &buffer_slot)
    buffer = load buffer_slot+0 as ptr
    json_ptr = call @sa_json_buffer_data(&buffer)
    json_len = call @sa_json_buffer_len(&buffer)
    send_status = call @send_rpc_json(&req, status, &json_ptr, json_len)
    buffer_free = call @sa_json_buffer_free(^buffer)
    writer_free = call @sa_json_writer_free(^writer)
    !writer_free
    !buffer_free
    !send_status
    !json_ptr
    !json_len
    !finish_status
    !end_status
    !begin_status
    !writer_status
    !id_ptr
    !id_len
    !payload_ptr
    !payload_len
    !is_error
    !status
    !req
    return 0

@ffi_wrapper send_wrapped_writer_with_id(&req: ptr, &id_ptr: ptr, id_len: u64, writer: ptr) -> u32:
L_ENTRY:
    buffer_slot = stack_alloc 8
    finish_status = call @sa_json_writer_finish(writer, &buffer_slot)
    buffer = load buffer_slot+0 as ptr
    result_ptr = call @sa_json_buffer_data(&buffer)
    result_len = call @sa_json_buffer_len(&buffer)
    send_status = call @send_jsonrpc_envelope_with_id(&req, 200, &id_ptr, id_len, &result_ptr, result_len, 0)
    buffer_free = call @sa_json_buffer_free(^buffer)
    writer_free = call @sa_json_writer_free(^writer)
    !writer_free
    !buffer_free
    !send_status
    !result_ptr
    !result_len
    !finish_status
    !id_ptr
    !id_len
    !req
    return 0

