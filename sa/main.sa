    has_path = eq path_status, 1
    !path_status
    br has_path -> L_FS_METADATA_DO, L_FS_METADATA_BAD_PARAMS

L_FS_METADATA_BAD_PARAMS:
    !has_path
    call @send_error_with_id(&req, 400, &id_ptr, id_len, &J_ERR_INVALID_PARAMS, J_ERR_INVALID_PARAMS_LEN)
    !body
    !body_len
    !req
    return 0

L_FS_METADATA_DO:
    !has_path
    path_ptr = load path_ptr_slot+0 as ptr
    path_len = load path_len_slot+0 as u64
    EXPAND DENO_LSTAT_JSON meta_status, meta_handle, path_ptr, path_len
    meta_ok = eq meta_status, 0
    !meta_status
    br meta_ok -> L_FS_METADATA_OK, L_FS_METADATA_ERR

L_FS_METADATA_ERR:
    !meta_ok
    !meta_handle
    !path_ptr
    !path_len
    call @send_error_with_id(&req, 500, &id_ptr, id_len, &J_ERR_FS, J_ERR_FS_LEN)
    !body
    !body_len
    !req
    return 0

L_FS_METADATA_OK:
    !meta_ok
    data_ptr = call @sa_fs_read_buffer_data(meta_handle)
    data_len = call @sa_fs_read_buffer_len(meta_handle)
    result = call @rpc_builder_new()
    call @rpc_builder_append(&result, &data_ptr, data_len)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result)
    !data_ptr
    !data_len
    free_status = call @sa_fs_read_buffer_free(^meta_handle)
    !free_status
    !path_ptr
    !path_len
    !body
    !body_len
    !req
    return 0

@ffi_wrapper send_rpc_fs_remove(&req: ptr, &id_ptr: ptr, id_len: u64, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    path_ptr_slot = stack_alloc 8
    path_len_slot = stack_alloc 8
    path_status = call @rpc_extract_string_after(&body, body_len, &J_PATH_KEY, J_PATH_KEY_LEN, &path_ptr_slot, &path_len_slot)
    has_path = eq path_status, 1
    !path_status
    br has_path -> L_FS_REMOVE_DO, L_FS_REMOVE_BAD_PARAMS

L_FS_REMOVE_BAD_PARAMS:
    !has_path
    call @send_error_with_id(&req, 400, &id_ptr, id_len, &J_ERR_INVALID_PARAMS, J_ERR_INVALID_PARAMS_LEN)
    !body
    !body_len
    !req
    return 0

L_FS_REMOVE_DO:
    !has_path
    path_ptr = load path_ptr_slot+0 as ptr
    path_len = load path_len_slot+0 as u64
    EXPAND DENO_REMOVE remove_status, path_ptr, path_len
    remove_ok = eq remove_status, 0
    !remove_status
    br remove_ok -> L_FS_REMOVE_OK, L_FS_REMOVE_ERR

L_FS_REMOVE_OK:
    !remove_ok
    call @send_wrapped_const_with_id(&req, &id_ptr, id_len, &J_FS_OK_TRUE, J_FS_OK_TRUE_LEN)
    !path_ptr
    !path_len
    !body
    !body_len
    !req
    return 0

L_FS_REMOVE_ERR:
    !remove_ok
    call @send_error_with_id(&req, 500, &id_ptr, id_len, &J_ERR_FS, J_ERR_FS_LEN)
    !path_ptr
    !path_len
    !body
    !body_len
    !req
    return 0

@ffi_wrapper send_rpc_fs_copy(&req: ptr, &id_ptr: ptr, id_len: u64, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    src_ptr_slot = stack_alloc 8
    src_len_slot = stack_alloc 8
    dst_ptr_slot = stack_alloc 8
    dst_len_slot = stack_alloc 8
    src_status = call @rpc_extract_string_after(&body, body_len, &J_SOURCE_PATH_KEY, J_SOURCE_PATH_KEY_LEN, &src_ptr_slot, &src_len_slot)
    has_src = eq src_status, 1
    !src_status
    br has_src -> L_FS_COPY_DEST, L_FS_COPY_BAD_PARAMS

L_FS_COPY_DEST:
    !has_src
    dst_status = call @rpc_extract_string_after(&body, body_len, &J_DESTINATION_PATH_KEY, J_DESTINATION_PATH_KEY_LEN, &dst_ptr_slot, &dst_len_slot)
    has_dst = eq dst_status, 1
    !dst_status
    br has_dst -> L_FS_COPY_DO, L_FS_COPY_BAD_PARAMS2

L_FS_COPY_BAD_PARAMS:
    !has_src
    call @send_error_with_id(&req, 400, &id_ptr, id_len, &J_ERR_INVALID_PARAMS, J_ERR_INVALID_PARAMS_LEN)
    !body
    !body_len
    !req
    return 0

L_FS_COPY_BAD_PARAMS2:
    !has_dst
    call @send_error_with_id(&req, 400, &id_ptr, id_len, &J_ERR_INVALID_PARAMS, J_ERR_INVALID_PARAMS_LEN)
    !body
    !body_len
    !req
    return 0

L_FS_COPY_DO:
    !has_dst
    src_ptr = load src_ptr_slot+0 as ptr
    src_len = load src_len_slot+0 as u64
    dst_ptr = load dst_ptr_slot+0 as ptr
    dst_len = load dst_len_slot+0 as u64
    EXPAND DENO_COPY_FILE copy_status, src_ptr, src_len, dst_ptr, dst_len
    copy_ok = eq copy_status, 0
    !copy_status
    br copy_ok -> L_FS_COPY_OK, L_FS_COPY_ERR

L_FS_COPY_OK:
    !copy_ok
    call @send_wrapped_const_with_id(&req, &id_ptr, id_len, &J_FS_OK_TRUE, J_FS_OK_TRUE_LEN)
    !src_ptr
    !src_len
    !dst_ptr
    !dst_len
    !body
    !body_len
    !req
    return 0

L_FS_COPY_ERR:
    !copy_ok
    call @send_error_with_id(&req, 500, &id_ptr, id_len, &J_ERR_FS, J_ERR_FS_LEN)
    !src_ptr
    !src_len
    !dst_ptr
    !dst_len
    !body
    !body_len
    !req
    return 0

@ffi_wrapper send_rpc_thread_start_with_values(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, thread_id: u64, forked_from_id: u64, &provider_ptr: ptr, provider_len: u64, ephemeral: u8, &model_ptr: ptr, model_len: u64, &dir_ptr: ptr, dir_len: u64, &body: ptr, body_len: u64) -> u32:
L_ENTRY:
    slot = call @state_thread_find(&state_ptr, thread_id)
    preview_ptr = ptr_add slot, THR_PREVIEW
    preview_len = load slot+THR_PREVIEW_LEN as u64
    name_ptr = ptr_add slot, THR_NAME
    name_len = load slot+THR_NAME_LEN as u64
    name_set = load slot+THR_NAME_SET as u8
    result = call @rpc_builder_new()
    call @rpc_builder_append(&result, &J_THREAD_START_A, J_THREAD_START_A_LEN)
    call @rpc_builder_append(&result, &model_ptr, model_len)
    call @rpc_builder_append(&result, &J_THREAD_START_PROVIDER, J_THREAD_START_PROVIDER_LEN)
    call @rpc_builder_append(&result, &provider_ptr, provider_len)
    call @rpc_builder_append(&result, &J_THREAD_START_CWD, J_THREAD_START_CWD_LEN)
    call @rpc_builder_append(&result, &dir_ptr, dir_len)
    call @rpc_builder_append_thread_envelope_tail(&result, &body, body_len)
    call @rpc_builder_append_thread(&result, &state_ptr, thread_id, forked_from_id, &preview_ptr, preview_len, &provider_ptr, provider_len, ephemeral, &model_ptr, model_len, &dir_ptr, dir_len, &name_ptr, name_len, name_set)
    call @rpc_builder_append(&result, &J_RPC_SUFFIX, J_RPC_SUFFIX_LEN)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result)
    !preview_ptr
    !preview_len
    !name_ptr
    !name_len
    !name_set
    !slot
    !provider_ptr
    !provider_len
    !ephemeral
    !model_ptr
    !model_len
    !dir_ptr
    !dir_len
    !body
    !body_len
    !forked_from_id
    !thread_id
    !state_ptr
    !req
    return 0

@ffi_wrapper send_rpc_thread_list(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr) -> u32:
L_ENTRY:
    result = call @rpc_builder_new()
    ids = stack_alloc 2048
    count_slot = stack_alloc 8
    list_status = call @state_thread_list_active(&state_ptr, &ids, &count_slot)
    !list_status
    count = load count_slot+0 as u64
    call @rpc_builder_append(&result, &J_THREAD_LIST_A, J_THREAD_LIST_A_LEN)
    i_slot = stack_alloc 8
    store i_slot+0, 0 as u64
    jmp L_TLIST_COND

L_TLIST_COND:
    i = load i_slot+0 as u64
    done = uge i, count
    br done -> L_TLIST_DONE, L_TLIST_BODY

L_TLIST_BODY:
    id_off = mul i, 8
    list_id_ptr = ptr_add ids, id_off
    tid = load list_id_ptr+0 as u64
    slot = call @state_thread_find(&state_ptr, tid)
    model_ptr = load slot+THR_MODEL_PTR as ptr
    model_len = load slot+THR_MODEL_LEN as u64
    dir_ptr = load slot+THR_DIR_PTR as ptr
    dir_len = load slot+THR_DIR_LEN as u64
    provider_ptr = load slot+THR_PROVIDER_PTR as ptr
    provider_len = load slot+THR_PROVIDER_LEN as u64
    ephemeral = load slot+THR_EPHEMERAL as u8
    preview_ptr = ptr_add slot, THR_PREVIEW
    preview_len = load slot+THR_PREVIEW_LEN as u64
    name_ptr = ptr_add slot, THR_NAME
    name_len = load slot+THR_NAME_LEN as u64
    name_set = load slot+THR_NAME_SET as u8
    forked_from_id = load slot+THR_FORKED_FROM_ID as u64
    is_first = eq i, 0
    br is_first -> L_TLIST_APPEND, L_TLIST_COMMA

L_TLIST_COMMA:
    !is_first
    call @rpc_builder_append(&result, &J_COMMA, J_COMMA_LEN)
    jmp L_TLIST_APPEND2

L_TLIST_APPEND:
    !is_first
    jmp L_TLIST_APPEND2

L_TLIST_APPEND2:
    call @rpc_builder_append_thread(&result, &state_ptr, tid, forked_from_id, &preview_ptr, preview_len, &provider_ptr, provider_len, ephemeral, &model_ptr, model_len, &dir_ptr, dir_len, &name_ptr, name_len, name_set)
    !model_ptr
    !model_len
    !dir_ptr
    !dir_len
    !provider_ptr
    !provider_len
    !ephemeral
    !preview_ptr
    !preview_len
    !name_ptr
    !name_len
    !name_set
    !forked_from_id
    !slot
    !tid
    !list_id_ptr
    !id_off
    next = add i, 1
    store i_slot+0, next as u64
    !next
    !i
    !done
    jmp L_TLIST_COND

L_TLIST_DONE:
    !done
    !i
    call @rpc_builder_append(&result, &J_THREAD_LIST_B, J_THREAD_LIST_B_LEN)
    !count
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result)
    !state_ptr
    !req
    return 0

@ffi_wrapper send_rpc_thread_loaded_list(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr) -> u32:
L_ENTRY:
    result = call @rpc_builder_new()
    ids = stack_alloc 2048
    count_slot = stack_alloc 8
    list_status = call @state_thread_list_active(&state_ptr, &ids, &count_slot)
    !list_status
    count = load count_slot+0 as u64
    call @rpc_builder_append(&result, &J_THREAD_LIST_A, J_THREAD_LIST_A_LEN)
    i_slot = stack_alloc 8
    store i_slot+0, 0 as u64
    jmp L_TLOADED_COND

L_TLOADED_COND:
    i = load i_slot+0 as u64
    done = uge i, count
    br done -> L_TLOADED_DONE, L_TLOADED_BODY

L_TLOADED_BODY:
    id_off = mul i, 8
    list_id_ptr = ptr_add ids, id_off
    tid = load list_id_ptr+0 as u64
    is_first = eq i, 0
    br is_first -> L_TLOADED_APPEND, L_TLOADED_COMMA

L_TLOADED_COMMA:
    !is_first
    call @rpc_builder_append(&result, &J_COMMA, J_COMMA_LEN)
    jmp L_TLOADED_APPEND2

L_TLOADED_APPEND:
    !is_first
    jmp L_TLOADED_APPEND2

L_TLOADED_APPEND2:
    call @rpc_builder_append_thread_id_string(&result, &state_ptr, tid)
    !tid
    !list_id_ptr
    !id_off
    next = add i, 1
    store i_slot+0, next as u64
    !next
    !i
    !done
    jmp L_TLOADED_COND

L_TLOADED_DONE:
    !done
    !i
    call @rpc_builder_append(&result, &J_LOADED_LIST_B, J_LOADED_LIST_B_LEN)
    !count
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result)
    !state_ptr
    !req
    return 0

@ffi_wrapper send_rpc_thread_read(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, thread_id: u64, include_turns: u8) -> u32:
L_ENTRY:
    slot = call @state_thread_find(&state_ptr, thread_id)
    missing = eq slot, 0
    br missing -> L_READ_NOT_FOUND, L_READ_FOUND

L_READ_FOUND:
    !missing
    model_ptr = load slot+THR_MODEL_PTR as ptr
    model_len = load slot+THR_MODEL_LEN as u64
    dir_ptr = load slot+THR_DIR_PTR as ptr
    dir_len = load slot+THR_DIR_LEN as u64
    provider_ptr = load slot+THR_PROVIDER_PTR as ptr
    provider_len = load slot+THR_PROVIDER_LEN as u64
    ephemeral = load slot+THR_EPHEMERAL as u8
    preview_ptr = ptr_add slot, THR_PREVIEW
    preview_len = load slot+THR_PREVIEW_LEN as u64
    name_ptr = ptr_add slot, THR_NAME
    name_len = load slot+THR_NAME_LEN as u64
    name_set = load slot+THR_NAME_SET as u8
    forked_from_id = load slot+THR_FORKED_FROM_ID as u64
    result = call @rpc_builder_new()
    call @rpc_builder_append(&result, &J_THREAD_READ_A, J_THREAD_READ_A_LEN)
    call @rpc_builder_append_thread_open(&result, &state_ptr, thread_id, forked_from_id, &preview_ptr, preview_len, &provider_ptr, provider_len, ephemeral, &model_ptr, model_len, &dir_ptr, dir_len, &name_ptr, name_len, name_set)
    include_turns_ok = eq include_turns, 1
    br include_turns_ok -> L_READ_TURNS_INCLUDE, L_READ_TURNS_EMPTY

L_READ_TURNS_INCLUDE:
    !include_turns_ok
    ids = stack_alloc 8192
    count_slot = stack_alloc 8
    list_status = call @state_turn_list(&state_ptr, thread_id, &ids, &count_slot)
    !list_status
    count = load count_slot+0 as u64
    call @rpc_builder_append(&result, &J_TURNS_FIELD_A, J_TURNS_FIELD_A_LEN)
    i_slot = stack_alloc 8
    store i_slot+0, 0 as u64
    jmp L_READ_TURNS_COND

L_READ_TURNS_COND:
    i = load i_slot+0 as u64
    done = uge i, count
    br done -> L_READ_TURNS_DONE, L_READ_TURNS_BODY

L_READ_TURNS_BODY:
    id_off = mul i, 8
    list_id_ptr = ptr_add ids, id_off
    turn_id = load list_id_ptr+0 as u64
    is_first = eq i, 0
    br is_first -> L_READ_TURNS_APPEND, L_READ_TURNS_COMMA

L_READ_TURNS_COMMA:
    !is_first
    call @rpc_builder_append(&result, &J_COMMA, J_COMMA_LEN)
    jmp L_READ_TURNS_APPEND2

L_READ_TURNS_APPEND:
    !is_first
    jmp L_READ_TURNS_APPEND2

L_READ_TURNS_APPEND2:
    turn_slot = call @state_turn_find(&state_ptr, thread_id, turn_id)
    turn_status = load turn_slot+TURN_STATUS as u8
    turn_mode = load turn_slot+TURN_MODE as u8
    turn_items_ptr = ptr_add turn_slot, TURN_ITEMS
    turn_items_len = load turn_slot+TURN_ITEMS_LEN as u64
    call @rpc_builder_append_turn_status_mode_items(&result, turn_id, turn_status, turn_mode, &turn_items_ptr, turn_items_len)
    !turn_items_ptr
    !turn_items_len
    !turn_mode
    !turn_status
    !turn_slot
    !turn_id
    !list_id_ptr
    !id_off
    next = add i, 1
    store i_slot+0, next as u64
    !next
    !i
    !done
    jmp L_READ_TURNS_COND

L_READ_TURNS_DONE:
    !done
    !i
    call @rpc_builder_append(&result, &J_TURNS_FIELD_B, J_TURNS_FIELD_B_LEN)
    call @rpc_builder_append(&result, &J_RPC_SUFFIX, J_RPC_SUFFIX_LEN)
    !count
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result)
    !model_ptr
    !model_len
    !dir_ptr
    !dir_len
    !provider_ptr
    !provider_len
    !ephemeral
    !preview_ptr
    !preview_len
    !name_ptr
    !name_len
    !name_set
    !forked_from_id
    !slot
    !thread_id
    !state_ptr
    !req
    return 0

L_READ_TURNS_EMPTY:
    !include_turns_ok
    call @rpc_builder_append(&result, &J_THREAD_OBJ_E2, J_THREAD_OBJ_E2_LEN)
    call @rpc_builder_append(&result, &J_RPC_SUFFIX, J_RPC_SUFFIX_LEN)
    call @send_wrapped_builder_response_with_id(&req, &id_ptr, id_len, ^result)
    !model_ptr
    !model_len
    !dir_ptr
    !dir_len
    !provider_ptr
    !provider_len
    !ephemeral
    !preview_ptr
    !preview_len
    !name_ptr
    !name_len
    !name_set
    !forked_from_id
    !slot
    !thread_id
    !state_ptr
    !req
    return 0

L_READ_NOT_FOUND:
    !missing
    !slot
    call @send_error_with_id(&req, 404, &id_ptr, id_len, &J_ERR_THREAD_NOT_FOUND, J_ERR_THREAD_NOT_FOUND_LEN)
    !thread_id
    !state_ptr
    !req
    return 0

@ffi_wrapper send_rpc_thread_resume(&req: ptr, &id_ptr: ptr, id_len: u64, &state_ptr: ptr, thread_id: u64, &body: ptr, body_len: u64) -> u32:
